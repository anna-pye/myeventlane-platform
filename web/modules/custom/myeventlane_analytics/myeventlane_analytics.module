<?php

/**
 * @file
 * Module file for MyEventLane Analytics.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function myeventlane_analytics_theme(): array {
  return [
    'myeventlane_analytics_dashboard' => [
      'variables' => [
        'analytics_model' => [],
        'summary_stats' => [],
        'event_analytics' => [],
      ],
      'template' => 'analytics-dashboard',
    ],
    'myeventlane_analytics_event' => [
      'variables' => [
        'event' => NULL,
        'workspace_back_url' => NULL,
        'vendor_analytics_home_url' => NULL,
        'export_pdf_url' => NULL,
        'export_excel_url' => NULL,
        'time_series' => [],
        'ticket_breakdown' => [],
        'sales_velocity' => [],
        'conversion_funnel' => [],
        'bottlenecks' => [],
        'total_revenue' => 0.0,
        'total_tickets' => 0,
      ],
      'template' => 'analytics-event',
    ],
    'myeventlane_trending_events' => [
      'variables' => [
        'events' => [],
      ],
      'template' => 'myeventlane-trending-events',
    ],
  ];
}
