/**
 * Implements hook_theme().
 */
function myeventlane_help_centre_theme(): array {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  $module_path = \Drupal::service('extension.list.module')->getPath('myeventlane_help_centre');

  return [
    'help_centre_home' => [
      'variables' => [
        'help_search' => [],
        'help_assistant' => NULL,
        'context' => NULL,
        'featured_articles' => [],
        'vendors' => [],
        'faq_listing' => [],
        'ia_sections' => [],
        'help_assistant_page_url' => '/help#mel-help-assistant',
        'contact_support_url' => '/help',
        'mel_support_layer' => NULL,
      ],
      'template' => 'help-centre-home',
      // Template ships with myeventlane_theme (see help_link pattern).
      'path' => $theme_path . '/templates/help',
    ],
    'help_centre_index' => [
      'variables' => [
        'heading' => NULL,
        'groups' => [],
        'is_vendor' => FALSE,
      ],
      'template' => 'help-centre-index',
    ],
    'help_centre_search' => [
      'variables' => [
        'search' => [],
        'results' => [],
      ],
      'template' => 'help-centre-search',
    ],
    'help_link' => [
      'variables' => [
        'text' => '',
        'url' => '',
        'aria_label' => NULL,
      ],
      'template' => 'components/help-link',
      'path' => $theme_path . '/templates',
    ],
    'contextual_help_card' => [
      'variables' => [
        'title' => '',
        'summary' => '',
        'url' => '',
        'read_more_label' => '',
        'secondary_url' => NULL,
        'secondary_label' => NULL,
        'context' => '',
        'audience' => '',
      ],
      'template' => 'components/contextual-help-card',
      'path' => $theme_path . '/templates',
    ],
    'mel_support_layer' => [
      'variables' => [
        'variant' => 'hub',
        'escalation' => [],
        'show_intro' => TRUE,
        'show_articles_jump' => TRUE,
        'strings' => [],
      ],
      'template' => 'components/mel-support-layer',
      'path' => $theme_path . '/templates',
    ],
    'mel_support_panel' => [
      'variables' => [
        'title' => '',
        'summary' => '',
        'url' => '',
        'analytics_key' => NULL,
        'mel_help_articles' => NULL,
      ],
      'template' => 'mel-support-panel',
      'path' => $module_path . '/templates',
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function myeventlane_help_centre_page_attachments(array &$attachments): void {
  \Drupal::service('myeventlane_help_centre.support_shell_page_attachments')->attachIfNeeded($attachments);
}

/**
 * Implements hook_action_info_alter().
 *
 * Ensures bulk documentation actions are registered when attribute discovery
 * or cached plugin definitions omit them (avoids PluginNotFoundException for
 * configured system.action entities).
 */
function myeventlane_help_centre_action_info_alter(array &$definitions): void {
  if (!isset($definitions['mel_help_documentation_publish'])) {
    $definitions['mel_help_documentation_publish'] = [
      'id' => 'mel_help_documentation_publish',
      'label' => new TranslatableMarkup('MEL: Publish documentation'),
      'type' => 'node',
      'class' => 'Drupal\myeventlane_help_centre\Plugin\Action\HelpArticleDocumentationPublishAction',
      'provider' => 'myeventlane_help_centre',
    ];
  }
  if (!isset($definitions['mel_help_documentation_archive'])) {
    $definitions['mel_help_documentation_archive'] = [
      'id' => 'mel_help_documentation_archive',
      'label' => new TranslatableMarkup('MEL: Archive documentation'),
      'type' => 'node',
      'class' => 'Drupal\myeventlane_help_centre\Plugin\Action\HelpArticleDocumentationArchiveAction',
      'provider' => 'myeventlane_help_centre',
    ];
  }
}

/**
 * Returns the contextual help resolver service.
 */
function _myeventlane_help_centre_resolver(): ContextualHelpResolver {
  return \Drupal::service('myeventlane_help_centre.contextual_help_resolver');
}

/**
 * Returns contextual help URLs keyed by integration point.
 *
 * Values are stored in config (myeventlane_help_centre.contextual_help) and may
 * be overridden per environment.
 *
 * @return array<string, array{text: string, url: string}>
 *   Map of context keys to label and internal path.
 */
function myeventlane_help_centre_get_context_map(): array {
  $rows = \Drupal::service('myeventlane_help_centre.contextual_help')->getMap();
  $out = [];
  foreach ($rows as $key => $row) {
    $out[$key] = [
      'text' => $row['text'],
      'url' => $row['path'],
    ];
  }
  return $out;
}

/**
 * Gets one contextual help link definition by key.
 *
 * @return array{text: string, url: string}|null
 *   The text and path, or NULL if unknown.
 */
function myeventlane_help_centre_get_link(string $key): ?array {
  $row = \Drupal::service('myeventlane_help_centre.contextual_help')->getLink($key);
  if ($row === NULL) {
    return NULL;
  }
  return [
    'text' => $row['text'],
    'url' => $row['path'],
  ];
}

/**
 * Builds a render array for the reusable help link component.
 *
 * @param string $text
 *   Link label.
 * @param string $url
 *   Internal path (e.g. /help/...) or absolute URL.
 *
 * @return array<string, mixed>
 *   Render array themed with help_link.
 */
function myeventlane_help_link(string $text, string $url): array {
  $url_object = str_starts_with($url, 'http://') || str_starts_with($url, 'https://')
    ? Url::fromUri($url)
    : Url::fromUserInput($url);

  return [
    '#theme' => 'help_link',
    '#text' => $text,
    '#url' => $url_object->toString(),
  ];
}

/**
 * Resolves canonical Help Centre hub URL for secondary links.
 */
function _myeventlane_help_centre_vendor_help_url(): string {
  try {
    return Url::fromRoute('myeventlane_help_centre.home')->toString();
  }
  catch (\Throwable) {
    return '/help';
  }
}

/**
 * Attaches resolved help article links to a mel_support_panel render array.
 *
 * @param array<string, mixed> $panel
 * @param array<string, mixed> $recommendation
 *   Engine output; may include `articles` as seed keys.
 */
function _myeventlane_help_centre_attach_support_panel_articles(array &$panel, array $recommendation, string $surface): void {
  $seedKeys = [];
  if (!empty($recommendation['articles']) && is_array($recommendation['articles'])) {
    foreach ($recommendation['articles'] as $key) {
      $key = trim((string) $key);
      if ($key !== '') {
        $seedKeys[] = $key;
      }
    }
  }
  if ($seedKeys === [] && !empty($panel['#analytics_key'])) {
    $engine = \Drupal::service('myeventlane_help.recommendation_engine');
    $seedKeys = $engine->getArticleSeedKeysForPanel((string) $panel['#analytics_key'], $surface);
  }
  if ($seedKeys === []) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $articles = [];
  foreach ($seedKeys as $articleKey) {
    $nodes = $storage->loadByProperties([
      'type' => 'help_article',
      'field_help_seed_key' => $articleKey,
      'status' => 1,
    ]);
    if ($nodes === []) {
      continue;
    }
    $node = reset($nodes);
    if ($node instanceof NodeInterface) {
      $articles[] = [
        'title' => $node->label(),
        'url' => $node->toUrl()->toString(),
      ];
      if (!isset($panel['#cache']['tags'])) {
        $panel['#cache']['tags'] = [];
      }
      $panel['#cache']['tags'][] = 'node:' . $node->id();
    }
  }

  if ($articles !== []) {
    $panel['#mel_help_articles'] = $articles;
  }

  if (!isset($panel['#cache']['contexts'])) {
    $panel['#cache']['contexts'] = [];
  }
  if (!in_array('route', $panel['#cache']['contexts'], TRUE)) {
    $panel['#cache']['contexts'][] = 'route';
  }
}

/**
 * Resolves customer support URL for Help Centre links.
 *
 * Escalation ticket routes require "view own escalation"; anonymous and most
 * signed-in attendees should land on the public Help Centre instead of 403.
 */
function _myeventlane_help_centre_contact_support_url(): string {
  $account = \Drupal::currentUser();
  if ($account->isAuthenticated() && $account->hasPermission('view own escalation')) {
    try {
      return Url::fromRoute('myeventlane_escalations_portal.customer_support_tickets')->toString();
    }
    catch (\Throwable) {
      try {
        return Url::fromRoute('myeventlane_escalations_portal.customer_support')->toString();
      }
      catch (\Throwable) {
        // Fall through to public help.
      }
    }
  }

  try {
    return Url::fromRoute('myeventlane_help_centre.home')->toString();
  }
  catch (\Throwable) {
    try {
      return Url::fromRoute('myeventlane_support.page')->toString();
    }
    catch (\Throwable) {
      return '/help';
    }
  }
}

/**
 * Implements hook_node_access().
 *
 * Enforces canonical field_audience on help_article and faq bundles.
 *
 * - public: visible to all (subject to other grants).
 * - vendor without public: authenticated users only.
 * - staff: users with administer escalations only.
 *
 * field_help_audience (taxonomy) is deprecated; access uses field_audience only.
 */
function myeventlane_help_centre_node_access(NodeInterface $node, string $op, AccountInterface $account): AccessResult {
  if ($op !== 'view' || !in_array($node->bundle(), ['help_article', 'faq'], TRUE)) {
    return AccessResult::neutral();
  }

  if ($account->hasPermission('bypass node access')) {
    return AccessResult::allowed()->cachePerPermissions();
  }

  if (!$node->hasField('field_audience')) {
    return AccessResult::neutral();
  }

  if ($node->get('field_audience')->isEmpty()) {
    return AccessResult::neutral();
  }

  $values = [];
  foreach ($node->get('field_audience') as $item) {
    $v = (string) $item->value;
    if ($v !== '') {
      $values[] = $v;
    }
  }

  $result = AccessResult::neutral();
  if (in_array('staff', $values, TRUE)) {
    $result = $account->hasPermission('administer escalations')
      ? AccessResult::allowed()
      : AccessResult::forbidden();
    return $result->cachePerPermissions()->addCacheableDependency($node);
  }

  if (in_array('vendor', $values, TRUE) && !in_array('public', $values, TRUE)) {
    if (!$account->isAuthenticated()) {
      return AccessResult::forbidden()
        ->cachePerUser()
        ->addCacheableDependency($node);
    }
  }

  return AccessResult::neutral()->addCacheableDependency($node);
}

/**
 * Implements hook_form_alter().
 */
function myeventlane_help_centre_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $wizard_map = [
    'event_wizard_basics_form' => 'event_wizard_basics',
    'event_wizard_when_where_form' => 'event_wizard_when_where',
    'event_wizard_details_form' => 'event_wizard_details',
    'event_wizard_tickets_form' => 'event_wizard_tickets',
    'event_wizard_publish_form' => 'event_wizard_publish',
    'event_wizard_review_form' => 'event_wizard_review',
    'mel_event_studio_form' => 'event_wizard_basics',
  ];
  if (isset($wizard_map[$form_id])) {
    $module_ok = \Drupal::moduleHandler()->moduleExists('myeventlane_event');
    if ($form_id === 'mel_event_studio_form') {
      $module_ok = \Drupal::moduleHandler()->moduleExists('myeventlane_event_studio');
    }
    if ($module_ok) {
      $card = _myeventlane_help_centre_resolver()->buildCard($wizard_map[$form_id], [
        'show_assistant_secondary' => TRUE,
      ]);
      if ($card !== []) {
        $form['mel_contextual_help_card'] = $card;
        $form['mel_contextual_help_card']['#weight'] = -30;
      }
    }
    return;
  }

  if ($form_id === 'myeventlane_refunds_vendor_refund_form') {
    $card = _myeventlane_help_centre_resolver()->buildCard('refunds_help', []);
    if ($card !== []) {
      $form['mel_contextual_help_card'] = $card;
      $form['mel_contextual_help_card']['#weight'] = -80;
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the event wizard Tickets step.
 */
function myeventlane_help_centre_form_event_wizard_tickets_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_event')) {
    return;
  }

  $eventCreate = myeventlane_help_centre_get_link('event_create');
  $rsvpPaid = myeventlane_help_centre_get_link('rsvp_vs_paid');
  if ($eventCreate || $rsvpPaid) {
    $form['mel_help_event_type_context'] = [
      '#type' => 'container',
      '#weight' => -12,
      '#attributes' => [
        'class' => ['mel-contextual-help', 'mel-contextual-help--wizard'],
      ],
    ];
    if ($eventCreate) {
      $form['mel_help_event_type_context']['event_create'] = myeventlane_help_link($eventCreate['text'], $eventCreate['url']);
    }
    if ($rsvpPaid) {
      $form['mel_help_event_type_context']['rsvp_vs_paid'] = myeventlane_help_link($rsvpPaid['text'], $rsvpPaid['url']);
    }
  }

  $ticketTypes = myeventlane_help_centre_get_link('ticket_types');
  if ($ticketTypes) {
    $form['mel_help_ticket_types_context'] = [
      '#type' => 'container',
      '#weight' => 5,
      '#attributes' => [
        'class' => ['mel-contextual-help', 'mel-contextual-help--wizard'],
      ],
      'link' => myeventlane_help_link($ticketTypes['text'], $ticketTypes['url']),
    ];
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the public ticket selection matrix.
 */
function myeventlane_help_centre_form_myeventlane_ticket_selection_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_commerce')) {
    return;
  }

  $card = _myeventlane_help_centre_resolver()->buildCard('checkout_booking', []);
  if ($card !== []) {
    $form['mel_help_ticket_matrix'] = [
      '#type' => 'container',
      '#weight' => -8,
      '#attributes' => [
        'class' => ['mel-contextual-help', 'mel-contextual-help--ticket-matrix'],
      ],
      'card' => $card,
    ];
    return;
  }

  $item = myeventlane_help_centre_get_link('ticket_types');
  if (!$item) {
    return;
  }

  $form['mel_help_ticket_matrix'] = [
    '#type' => 'container',
    '#weight' => -8,
    '#attributes' => [
      'class' => ['mel-contextual-help', 'mel-contextual-help--ticket-matrix'],
    ],
    'link' => myeventlane_help_link($item['text'], $item['url']),
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for the public RSVP form.
 */
function myeventlane_help_centre_form_myeventlane_rsvp_public_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_rsvp')) {
    return;
  }

  $item = myeventlane_help_centre_get_link('rsvp_after_submit');
  if (!$item) {
    return;
  }

  $form['mel_help_rsvp_after'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => [
      'class' => ['mel-contextual-help', 'mel-contextual-help--rsvp'],
    ],
    'link' => myeventlane_help_link($item['text'], $item['url']),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for commerce_checkout_form.
 */
function myeventlane_help_centre_preprocess_commerce_checkout_form(array &$variables): void {
  if (!\Drupal::moduleHandler()->moduleExists('commerce')) {
    return;
  }

  $step_id = $variables['form']['#step_id'] ?? NULL;
  $route_name = \Drupal::routeMatch()->getRouteName();
  $engine = \Drupal::service('myeventlane_help.recommendation_engine');
  if ($step_id !== 'complete') {
    $recommendation = $engine->getRecommendations($route_name, 'checkout');

    $builder = \Drupal::service('myeventlane_help_centre.support_panel_builder');
    if (!empty($recommendation['panel_key'])) {
      $panel = $builder->build((string) $recommendation['panel_key'], 'checkout', $route_name);
    }
    else {
      $panel = $builder->buildForRoute($route_name, 'checkout') ?? [];
    }
    if ($panel !== []) {
      _myeventlane_help_centre_attach_support_panel_articles($panel, $recommendation, 'checkout');
      $variables['mel_support_panel'] = $panel;
    }
  }

  $resolver = _myeventlane_help_centre_resolver();

  if ($step_id === 'complete') {
    $confirm = $resolver->buildCard('checkout_confirmation', []);
    if ($confirm !== []) {
      $variables['mel_contextual_help_checkout_confirmation'] = $confirm;
    }
  }
  else {
    $checkout = $resolver->buildCard('checkout_booking', []);
    if ($checkout !== []) {
      $variables['mel_contextual_help_checkout'] = $checkout;
    }
  }

  $has_inline_card = !empty($variables['mel_contextual_help_checkout'] ?? [])
    || !empty($variables['mel_support_panel'] ?? []);
  if (!$has_inline_card) {
    $item = myeventlane_help_centre_get_link('refunds_checkout');
    if ($item) {
      $variables['mel_help_checkout_refund'] = myeventlane_help_link($item['text'], $item['url']);
    }

    $guide = myeventlane_help_centre_get_link('checkout');
    if ($guide) {
      $variables['mel_help_checkout_guide'] = myeventlane_help_link($guide['text'], $guide['url']);
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('myeventlane_help_assistant')) {
    try {
      $url = Url::fromRoute('myeventlane_help_assistant.page');
      if ($url->access(\Drupal::currentUser())) {
        $variables['mel_help_checkout_assistant'] = [
          '#type' => 'link',
          '#title' => t('Need help? Open the Help Assistant'),
          '#url' => $url,
          '#attributes' => ['class' => ['mel-checkout-help-assistant-link', 'mel-util-link']],
        ];
      }
    }
    catch (\Throwable) {
    }
  }
}

/**
 * Implements hook_views_query_alter().
 */
function myeventlane_help_centre_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if ($view->id() !== 'mel_help_related_articles' || $view->current_display !== 'block_related') {
    return;
  }
  $nid = (int) ($view->args[0] ?? 0);
  if ($nid < 1) {
    return;
  }
  if (!method_exists($query, 'addWhere')) {
    return;
  }
  $query->addWhere(0, 'node_field_data.nid', $nid, '<>');
}

/**
 * Implements hook_views_pre_render().
 */
function myeventlane_help_centre_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if ($view->id() !== 'mel_docs_register') {
    return;
  }
  if (!in_array($view->current_display, ['page_register', 'page_review'], TRUE)) {
    return;
  }
  $view->element['#attached']['library'][] = 'myeventlane_help_centre/admin_docs';
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function myeventlane_help_centre_preprocess_views_view_field(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof \Drupal\views\ViewExecutable) {
    return;
  }
  if ($view->id() !== 'mel_docs_register' || $view->current_display !== 'page_review') {
    return;
  }
  $field = $variables['field'] ?? NULL;
  if (!$field || ($field->options['id'] ?? '') !== 'field_last_reviewed') {
    return;
  }
  $row = $variables['row'] ?? NULL;
  if (!$row instanceof \Drupal\views\ResultRow) {
    return;
  }
  $node = $row->_entity ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'help_article') {
    return;
  }
  $cutoff = strtotime('-180 days', (int) \Drupal::time()->getRequestTime());
  $overdue = TRUE;
  if ($node->hasField('field_last_reviewed') && !$node->get('field_last_reviewed')->isEmpty()) {
    $date = $node->get('field_last_reviewed')->date;
    if ($date) {
      $overdue = $date->getTimestamp() < $cutoff;
    }
  }
  if ($overdue) {
    $variables['output'] .= ' <span class="mel-docs-overdue-pill">' . t('Review due') . '</span>';
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_dashboard.
 */
function myeventlane_help_centre_preprocess_myeventlane_vendor_dashboard(array &$variables): void {
  $vendor_url = _myeventlane_help_centre_vendor_help_url();
  $card = _myeventlane_help_centre_resolver()->buildCard('vendor_dashboard_overview', [
    'override_secondary_url' => $vendor_url,
    'override_secondary_label' => (string) t('Browse vendor help'),
  ]);
  if ($card !== []) {
    $variables['mel_vendor_contextual_help'] = $card;
  }

  $item = myeventlane_help_centre_get_link('vendor_dashboard');
  if ($item) {
    $variables['mel_help_vendor_dashboard'] = myeventlane_help_link($item['text'], $item['url']);
  }

  $engine = \Drupal::service('myeventlane_help.recommendation_engine');
  $route_name = \Drupal::routeMatch()->getRouteName();
  $recommendation = $engine->getRecommendations($route_name, 'vendor_dashboard');

  $builder = \Drupal::service('myeventlane_help_centre.support_panel_builder');
  if (!empty($recommendation['panel_key'])) {
    $panel = $builder->build((string) $recommendation['panel_key'], 'vendor_dashboard', $route_name);
  }
  else {
    $panel = $builder->buildForRoute($route_name, 'vendor_dashboard') ?? [];
  }
  if ($panel !== []) {
    _myeventlane_help_centre_attach_support_panel_articles($panel, $recommendation, 'vendor_dashboard');
    $variables['mel_support_panel'] = $panel;
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_attendees_dashboard.
 */
function myeventlane_help_centre_preprocess_myeventlane_vendor_attendees_dashboard(array &$variables): void {
  $vendor_url = _myeventlane_help_centre_vendor_help_url();
  $card = _myeventlane_help_centre_resolver()->buildCard('vendor_dashboard_attendees', [
    'override_secondary_url' => $vendor_url,
    'override_secondary_label' => (string) t('Browse vendor help'),
  ]);
  if ($card !== []) {
    $variables['mel_vendor_contextual_help'] = $card;
  }
}

