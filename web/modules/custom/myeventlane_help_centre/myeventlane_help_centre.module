/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_event_orders.
 */
function myeventlane_help_centre_preprocess_myeventlane_vendor_event_orders(array &$variables): void {
  $vendor_url = _myeventlane_help_centre_vendor_help_url();
  $card = _myeventlane_help_centre_resolver()->buildCard('vendor_dashboard_orders', [
    'override_secondary_url' => $vendor_url,
    'override_secondary_label' => (string) t('Browse vendor help'),
  ]);
  if ($card !== []) {
    $variables['mel_vendor_contextual_help'] = $card;
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_mel_vendor_billing.
 */
function myeventlane_help_centre_preprocess_myeventlane_mel_vendor_billing(array &$variables): void {
  $vendor_url = _myeventlane_help_centre_vendor_help_url();
  $card = _myeventlane_help_centre_resolver()->buildCard('vendor_dashboard_payout', [
    'override_secondary_url' => $vendor_url,
    'override_secondary_label' => (string) t('Browse vendor help'),
  ]);
  if ($card !== []) {
    $variables['mel_vendor_contextual_help'] = $card;
  }
}

/**
 * Implements hook_preprocess_html().
 */
function myeventlane_help_centre_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() !== 'entity.node.canonical') {
    return;
  }
  $node = $route->getParameter('node');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'help_article') {
    return;
  }
  $variables['attributes']['class'][] = 'mel-page--help-article';
}

/**
 * Implements hook_entity_view().
 */
function myeventlane_help_centre_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, string $view_mode): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'help_article' || $view_mode !== 'full') {
    return;
  }
  \Drupal::service('myeventlane_help_centre.analytics')->logArticleView((int) $entity->id());
}

/**
 * Implements hook_preprocess_node().
 */
function myeventlane_help_centre_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  $viewMode = $variables['view_mode'] ?? '';
  if (!$node instanceof NodeInterface || $node->bundle() !== 'help_article' || $viewMode !== 'full') {
    return;
  }

  // Full-page article enhancements (module-level so vendor + public themes share).
  $variables['mel_help_related_articles'] = [
    '#type' => 'view',
    '#name' => 'mel_help_related_articles',
    '#display_id' => 'block_related',
    '#arguments' => [(int) $node->id()],
  ];
  $variables['mel_contact_support_url'] = _myeventlane_help_centre_contact_support_url();
  $contact_support_href = htmlspecialchars($variables['mel_contact_support_url'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
  $variables['mel_help_support_panel'] = [
    '#markup' => '<section class="mel-help-support-panel"><h2>' . t('Still need help?') . '</h2><p>' . t('If this article did not resolve it, contact support and include your booking or event details.') . '</p><p><a class="mel-help-support-panel__link" href="' . $contact_support_href . '">' . t('Contact support') . '</a></p></section>',
    '#cache' => [
      'contexts' => ['user.permissions'],
    ],
  ];
  $variables['mel_help_cta'] = NULL;
  if ($node->hasField('field_help_cta_label') && !$node->get('field_help_cta_label')->isEmpty() && $node->hasField('field_help_cta_link') && !$node->get('field_help_cta_link')->isEmpty()) {
    $label = (string) $node->get('field_help_cta_label')->value;
    $uri = (string) $node->get('field_help_cta_link')->uri;
    if ($label !== '' && $uri !== '') {
      $url = str_starts_with($uri, 'internal:') ? substr($uri, 9) : $uri;
      $variables['mel_help_cta'] = [
        'label' => $label,
        'url' => $url,
      ];
    }
  }

  $route = Url::fromRoute('myeventlane_help_centre.article_feedback', [
    'node' => (int) $node->id(),
  ])->toString();
  $variables['mel_help_feedback_endpoint'] = $route;
  $variables['mel_help_feedback_token'] = \Drupal::service('csrf_token')->get('myeventlane_help_feedback');

  $variables['#attached']['library'][] = 'myeventlane_help_centre/help_feedback';
}
