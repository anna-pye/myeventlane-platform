/**
 * Builds a generic Help Centre view definition with custom displays.
 *
 * @param array<int, string> $bundleFilters
 *   Node bundle IDs.
 * @param array<string, array<string, mixed>> $extraFilters
 *   Additional view filters keyed by machine key.
 * @param array<int, array<string, mixed>> $displays
 *   Additional displays to append after default display.
 */
function _myeventlane_help_centre_build_custom_view_definition(
  string $id,
  string $label,
  string $description,
  array $bundleFilters,
  array $extraFilters,
  array $displays,
): array {
  $defaultFilters = [
    'status' => [
      'id' => 'status',
      'table' => 'node_field_data',
      'field' => 'status',
      'entity_type' => 'node',
      'entity_field' => 'status',
      'plugin_id' => 'boolean',
      'value' => '1',
    ],
    'type' => [
      'id' => 'type',
      'table' => 'node_field_data',
      'field' => 'type',
      'plugin_id' => 'bundle',
      'value' => array_combine($bundleFilters, $bundleFilters),
    ],
  ] + $extraFilters;

  $definition = [
    'id' => $id,
    'label' => $label,
    'module' => 'views',
    'description' => $description,
    'tag' => 'myeventlane_help_centre',
    'base_table' => 'node_field_data',
    'base_field' => 'nid',
    'core' => '11.x',
    'display' => [
      'default' => [
        'id' => 'default',
        'display_title' => 'Default',
        'display_plugin' => 'default',
        'position' => 0,
        'display_options' => [
          'title' => $label,
          'access' => [
            'type' => 'perm',
            'options' => ['perm' => 'access content'],
          ],
          'cache' => [
            'type' => 'tag',
            'options' => [],
          ],
          'query' => [
            'type' => 'views_query',
            'options' => [],
          ],
          'exposed_form' => [
            'type' => 'basic',
            'options' => [],
          ],
          'pager' => [
            'type' => 'some',
            'options' => [
              'items_per_page' => 12,
              'offset' => 0,
            ],
          ],
          'style' => [
            'type' => 'default',
            'options' => [],
          ],
          'row' => [
            'type' => 'entity:node',
            'options' => ['view_mode' => 'teaser'],
          ],
          'fields' => [],
          'filters' => $defaultFilters,
          'sorts' => [
            'changed' => [
              'id' => 'changed',
              'table' => 'node_field_data',
              'field' => 'changed',
              'plugin_id' => 'date',
              'order' => 'DESC',
            ],
            'title' => [
              'id' => 'title',
              'table' => 'node_field_data',
              'field' => 'title',
              'plugin_id' => 'standard',
              'order' => 'ASC',
            ],
          ],
          'arguments' => [],
        ],
      ],
    ],
  ];

  foreach ($displays as $display) {
    $definition['display'][$display['id']] = $display;
  }

  return $definition;
}

/**
 * Upserts a Views config entity from definition data.
 */
function _myeventlane_help_centre_upsert_view(array $definition): void {
  $view = View::load($definition['id']);
  if (!$view) {
    $view = View::create($definition);
  }
  else {
    foreach ($definition as $key => $value) {
      $view->set($key, $value);
    }
  }
  $view->save();
}

/**
 * Returns a taxonomy term ID by vocabulary and term name.
 */
function _myeventlane_help_centre_term_id(string $vocabularyId, string $termName): int {
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
    'vid' => $vocabularyId,
    'name' => $termName,
  ]);
  if ($terms === []) {
    return 0;
  }
  $term = reset($terms);
  return $term instanceof Term ? (int) $term->id() : 0;
}

/**
 * Builds a taxonomy-target-id numeric filter configuration.
 */
function _myeventlane_help_centre_tid_filter(string $filterId, string $table, string $field, int $tid, string $vocabularyId = ''): array {
  if ($tid <= 0) {
    return [];
  }
  $value = [$tid => $tid];
  return [
    $filterId => [
      'id' => $filterId,
      'table' => $table,
      'field' => $field,
      'plugin_id' => 'taxonomy_index_tid',
      'operator' => 'or',
      'value' => $value,
      'reduce_duplicates' => FALSE,
      'type' => 'select',
      'vid' => $vocabularyId,
    ],
  ];
}

/**
 * Ensures a help_topic term exists by name and returns its term ID.
 */
function _myeventlane_help_centre_ensure_topic_term(string $name): int {
  if ($name === '') {
    return 0;
  }
  $termStorage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $existing = $termStorage->loadByProperties([
    'vid' => 'help_topic',
    'name' => $name,
  ]);
  if ($existing !== []) {
    $term = reset($existing);
    return $term instanceof Term ? (int) $term->id() : 0;
  }
  $term = Term::create([
    'vid' => 'help_topic',
    'name' => $name,
  ]);
  $term->save();
  return (int) $term->id();
}
