  _myeventlane_help_centre_ensure_field_instance('node', 'help_landing_page', 'field_help_audience', 'Help Audience', 'entity_reference', FALSE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => ['target_bundles' => ['help_audience' => 'help_audience']],
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'help_landing_page', 'field_featured_help', 'Featured Help', 'boolean', FALSE, []);

  _myeventlane_help_centre_ensure_field_instance('node', 'support_procedure', 'field_help_summary', 'Help Summary', 'string_long', FALSE, []);
  _myeventlane_help_centre_ensure_field_instance('node', 'support_procedure', 'body', 'Body', 'text_with_summary', TRUE, [
    'display_summary' => TRUE,
    'required_summary' => FALSE,
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'support_procedure', 'field_help_topic', 'Help Topic', 'entity_reference', TRUE, [
