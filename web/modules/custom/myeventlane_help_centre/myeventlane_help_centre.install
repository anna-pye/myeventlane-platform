  _myeventlane_help_centre_ensure_field_storage('node', 'field_featured_help', 'boolean', ['on_label' => 'Yes', 'off_label' => 'No'], 1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_related_help_articles', 'entity_reference', ['target_type' => 'node'], -1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_help_cta_label', 'string', ['max_length' => 255], 1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_help_cta_link', 'link', [], 1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_help_keywords', 'string_long', [], 1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_last_reviewed', 'datetime', ['datetime_type' => 'date'], 1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_content_owner', 'entity_reference', ['target_type' => 'user'], 1, TRUE);

  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'field_help_summary', 'Help Summary', 'string_long', FALSE, []);
  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'field_help_topic', 'Help Topic', 'entity_reference', TRUE, [
