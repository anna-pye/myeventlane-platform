/**
 * Extend editorial moderation workflow to Help Centre bundles.
 */
function myeventlane_help_centre_update_10011(): string {
  if (!\Drupal::moduleHandler()->moduleExists('content_moderation') || !\Drupal::moduleHandler()->moduleExists('workflows')) {
    return 'Skipped Help Centre moderation workflow update: required modules are not enabled.';
  }

  /** @var \Drupal\workflows\WorkflowInterface|null $workflow */
  $workflow = \Drupal::entityTypeManager()->getStorage('workflow')->load('editorial');
  if (!$workflow) {
    return 'Skipped Help Centre moderation workflow update: editorial workflow not found.';
  }

  $typeSettings = $workflow->get('type_settings');
  if (!is_array($typeSettings)) {
    $typeSettings = [];
  }
  $entityTypes = $typeSettings['entity_types']['node'] ?? [];
  if (!is_array($entityTypes)) {
    $entityTypes = [];
  }

  foreach (['help_article', 'help_landing_page', 'support_procedure'] as $bundle) {
    if (!in_array($bundle, $entityTypes, TRUE)) {
      $entityTypes[] = $bundle;
    }
  }
  sort($entityTypes);
  $typeSettings['entity_types']['node'] = $entityTypes;

  if (!empty($typeSettings['states']['review'])) {
    $typeSettings['states']['review']['label'] = 'In review';
  }

  $workflow->set('type_settings', $typeSettings);
  $workflow->save();

  return 'Extended editorial workflow for help_article, help_landing_page, and support_procedure.';
}

/**
 * Extend MEL Search API index to include Help Centre content.
 */
function myeventlane_help_centre_update_10012(): string {
  if (!\Drupal::moduleHandler()->moduleExists('search_api')) {
    return 'Skipped Help Centre search indexing update: Search API is not enabled.';
  }

  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('mel_content');
  if (!$index) {
    return 'Skipped Help Centre search indexing update: mel_content index not found.';
  }

  $datasourceSettings = $index->get('datasource_settings');
  $selectedBundles = $datasourceSettings['entity:node']['bundles']['selected'] ?? [];
  if (!is_array($selectedBundles)) {
    $selectedBundles = [];
  }
  foreach (['help_article', 'help_landing_page'] as $bundle) {
    if (!in_array($bundle, $selectedBundles, TRUE)) {
      $selectedBundles[] = $bundle;
    }
  }
  sort($selectedBundles);
  $datasourceSettings['entity:node']['bundles']['selected'] = $selectedBundles;
  $index->set('datasource_settings', $datasourceSettings);

  $fieldSettings = $index->get('field_settings');
  if (!is_array($fieldSettings)) {
    $fieldSettings = [];
  }
  $requiredFields = [
    'field_help_summary' => [
      'label' => 'Help summary',
      'type' => 'text',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_help_summary',
    ],
    'field_help_keywords' => [
      'label' => 'Help keywords',
      'type' => 'text',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_help_keywords',
    ],
    'field_help_topic' => [
      'label' => 'Help topic',
      'type' => 'string',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_help_topic',
    ],
    'field_help_article_type' => [
      'label' => 'Help article type',
      'type' => 'string',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_help_article_type',
    ],
    'field_help_audience' => [
      'label' => 'Help audience',
      'type' => 'string',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_help_audience',
    ],
  ];
  foreach ($requiredFields as $fieldId => $definition) {
    if (!isset($fieldSettings[$fieldId])) {
      $fieldSettings[$fieldId] = $definition;
    }
  }
  $index->set('field_settings', $fieldSettings);

  $index->save();
  return 'Updated mel_content Search API index for Help Centre content fields and bundles.';
}

/**
 * Create dedicated Help Centre Views for browse and search UX.
 */
function myeventlane_help_centre_update_10013(): string {
  return 'Help Centre Views are managed through exported config in this phase.';
}

/**
 * Migrate legacy FAQ nodes into help_article nodes.
 */
function myeventlane_help_centre_update_10020(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $nodeStorage = \Drupal::entityTypeManager()->getStorage('node');

  $faqTypeTerms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
    'vid' => 'help_article_type',
    'name' => 'FAQ',
  ]);
  if ($faqTypeTerms === []) {
    $faqTerm = Term::create([
      'vid' => 'help_article_type',
      'name' => 'FAQ',
    ]);
    $faqTerm->save();
  }
  else {
    $faqTerm = reset($faqTypeTerms);
  }
  $faqArticleTypeTid = $faqTerm instanceof Term ? (int) $faqTerm->id() : 0;

  $nids = $nodeStorage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'faq')
    ->execute();

  $migrated = 0;
  $skipped = 0;
  foreach ($nids as $nid) {
    $node = $nodeStorage->load($nid);
    if (!$node instanceof Node) {
      $skipped++;
      continue;
    }

    $topicTid = 0;
    if ($node->hasField('field_help_topic') && !$node->get('field_help_topic')->isEmpty()) {
      $topicTid = (int) $node->get('field_help_topic')->target_id;
    }
    elseif ($node->hasField('field_help_category') && !$node->get('field_help_category')->isEmpty()) {
      $legacyTerm = $node->get('field_help_category')->entity;
      if ($legacyTerm instanceof Term) {
        $topicTid = _myeventlane_help_centre_ensure_topic_term((string) $legacyTerm->label());
      }
    }

    if ($node->hasField('field_help_topic') && $topicTid <= 0) {
      $skipped++;
      continue;
    }

    $created = (int) $node->getCreatedTime();
    $changed = (int) $node->getChangedTime();
    $pathValues = $node->hasField('path') ? $node->get('path')->getValue() : [];

    $node->set('type', 'help_article');
    if ($faqArticleTypeTid > 0 && $node->hasField('field_help_article_type')) {
      $node->set('field_help_article_type', ['target_id' => $faqArticleTypeTid]);
    }
    if ($topicTid > 0 && $node->hasField('field_help_topic')) {
      $node->set('field_help_topic', ['target_id' => $topicTid]);
    }
    if ($node->hasField('field_help_summary') && $node->get('field_help_summary')->isEmpty() && $node->hasField('body') && !$node->get('body')->isEmpty()) {
      $summary = (string) $node->get('body')->summary;
      if ($summary !== '') {
        $node->set('field_help_summary', $summary);
      }
    }
    if ($node->hasField('path') && $pathValues !== []) {
      $node->set('path', $pathValues);
    }

    $node->setNewRevision(FALSE);
    $node->setCreatedTime($created);
    $node->setChangedTime($changed);
    $node->save();
    $migrated++;
  }

  $logger->notice('FAQ migration complete. Migrated: @migrated. Skipped: @skipped.', [
    '@migrated' => (string) $migrated,
    '@skipped' => (string) $skipped,
  ]);

  return sprintf(
    'Migrated %d FAQ nodes to help_article. Skipped %d nodes without topic mapping. FAQ content type retained as deprecated.',
    $migrated,
    $skipped,
  );
}

/**
 * Migrate legacy help_categories references to help_topic.
 */
function myeventlane_help_centre_update_10021(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $termStorage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $nodeStorage = \Drupal::entityTypeManager()->getStorage('node');

  $legacyTerms = $termStorage->loadByProperties(['vid' => 'help_categories']);
  $createdTopics = 0;
  foreach ($legacyTerms as $legacyTerm) {
    if (!$legacyTerm instanceof Term) {
      continue;
    }
    $topicTid = _myeventlane_help_centre_ensure_topic_term((string) $legacyTerm->label());
    if ($topicTid > 0) {
      $createdTopics++;
    }
  }

  $nids = $nodeStorage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'help_article')
    ->execute();
  $updated = 0;
  $skipped = 0;
  foreach ($nids as $nid) {
    $node = $nodeStorage->load($nid);
    if (!$node instanceof Node) {
      $skipped++;
      continue;
    }
    if (!$node->hasField('field_help_topic') || !$node->hasField('field_help_category')) {
      $skipped++;
      continue;
    }
    if (!$node->get('field_help_topic')->isEmpty()) {
      continue;
    }
    if ($node->get('field_help_category')->isEmpty()) {
      $skipped++;
      continue;
    }
    $legacyTerm = $node->get('field_help_category')->entity;
    if (!$legacyTerm instanceof Term) {
      $skipped++;
      continue;
    }
    $topicTid = _myeventlane_help_centre_ensure_topic_term((string) $legacyTerm->label());
    if ($topicTid <= 0) {
      $skipped++;
      continue;
    }
    $node->set('field_help_topic', ['target_id' => $topicTid]);
    $node->setNewRevision(FALSE);
    $node->save();
    $updated++;
  }

  $logger->notice('help_categories to help_topic migration complete. Updated nodes: @updated. Skipped: @skipped.', [
    '@updated' => (string) $updated,
    '@skipped' => (string) $skipped,
  ]);

  return sprintf(
    'Mapped legacy help_categories to help_topic. Updated %d help_article nodes and skipped %d.',
    $updated,
    $skipped,
  );
}

/**
 * Audit legacy Help Centre views for pending removal.
 */
function myeventlane_help_centre_update_10022(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $legacyViews = [
    'mel_help_articles_by_audience',
    'mel_help_category_listing',
    'mel_help_centre_homepage',
  ];
  $lines = [];
  foreach ($legacyViews as $viewId) {
    $view = \Drupal\views\Views::getView($viewId);
    if (!$view) {
      $lines[] = $viewId . ': missing';
      continue;
    }
    $displayId = array_key_exists('block_1', $view->storage->get('display')) ? 'block_1' : 'default';
    $view->setDisplay($displayId);
    $view->execute();
    $rows = count($view->result);
    $lines[] = sprintf('%s (%s) rows=%d', $viewId, $displayId, $rows);
  }
  $message = 'Legacy views audit: ' . implode('; ', $lines);
  $logger->notice($message);
  return $message;
}

/**
 * Create Help feedback and analytics tables for existing installs.
 */
function myeventlane_help_centre_update_10023(): string {
  $schema = \Drupal::database()->schema();
  $definitions = myeventlane_help_centre_schema();
  $created = [];
  foreach (['myeventlane_help_feedback', 'myeventlane_help_analytics'] as $table) {
    if ($schema->tableExists($table)) {
      continue;
    }
    if (!isset($definitions[$table])) {
      continue;
    }
    $schema->createTable($table, $definitions[$table]);
    $created[] = $table;
  }
  if ($created === []) {
    return 'Help feedback and analytics tables already existed.';
  }
  return 'Created tables: ' . implode(', ', $created) . '.';
}

/**
 * Improve Help search index relevance boosts.
 */
function myeventlane_help_centre_update_10024(): string {
  if (!\Drupal::moduleHandler()->moduleExists('search_api')) {
    return 'Skipped relevance update: Search API is not enabled.';
  }
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('mel_content');
  if (!$index) {
    return 'Skipped relevance update: mel_content index not found.';
  }

  $fieldSettings = $index->get('field_settings');
  if (!is_array($fieldSettings)) {
    $fieldSettings = [];
  }
  $boosts = [
    'title' => 8.0,
    'field_help_summary' => 5.0,
    'field_help_keywords' => 5.0,
    'body' => 2.0,
  ];
  foreach ($boosts as $fieldId => $boost) {
    if (!isset($fieldSettings[$fieldId])) {
      continue;
    }
    $fieldSettings[$fieldId]['boost'] = $boost;
  }
  if (!isset($fieldSettings['field_help_keywords'])) {
    $fieldSettings['field_help_keywords'] = [
      'label' => 'Help keywords',
      'datasource_id' => 'entity:node',
      'property_path' => 'field_help_keywords',
      'type' => 'text',
      'boost' => 5.0,
    ];
  }
  $index->set('field_settings', $fieldSettings);
  $index->save();

  return 'Applied Help search relevance boosts for title, summary, keywords, and body.';
}

/**
 * Phase 2.3: Align help article paths with contextual help map (ticket types + vendor).
 */
function myeventlane_help_centre_update_10025(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $messages = [];

  $ticket_article = $storage->loadByProperties([
    'type' => 'help_article',
    'title' => 'Understanding ticket types',
  ]);
  $node = $ticket_article ? reset($ticket_article) : NULL;
  if ($node instanceof Node && $node->hasField('path')) {
    $node->set('path', [
      'alias' => '/help/organisers/understanding-ticket-types',
      'pathauto' => 0,
    ]);
    $node->save();
    $messages[] = 'Updated alias for help article: Understanding ticket types.';
  }

  try {
    $seeder = new \Drupal\myeventlane_help_centre\Service\HelpContentSeeder(
      \Drupal::entityTypeManager(),
      \Drupal::service('logger.factory'),
    );
    $created = $seeder->seedHelpArticles();
    if ($created > 0) {
      $messages[] = sprintf('Seeded %d new help article(s).', $created);
    }
  }
  catch (\Throwable $exception) {
    \Drupal::logger('myeventlane_help_centre')->error('Phase 2.3 help article seed failed: @message', [
      '@message' => $exception->getMessage(),
    ]);
    return 'Phase 2.3: path alias may be updated; help article seed failed (see logs).';
  }

  return $messages !== [] ? implode(' ', $messages) : 'Phase 2.3: contextual help paths already aligned.';
}

/**
 * Widen analytics payload column for AI timing fields.
 */
function myeventlane_help_centre_update_10026(): string {
  $connection = \Drupal::database();
  $schema = $connection->schema();
  if (!$schema->tableExists('myeventlane_help_analytics')) {
    return 'Analytics table not found; skipped.';
  }
  $spec = [
    'type' => 'varchar',
    'length' => 512,
    'not null' => FALSE,
  ];
  $schema->changeField('myeventlane_help_analytics', 'query', 'query', $spec);

  return 'Help analytics query column widened to 512 characters.';
}

/**
 * Move help_landing_page URLs off /help/* so module routes control those paths.
 */
function myeventlane_help_centre_update_10027(): string {
  $map = [
    'Help Centre Home' => '/help/landing/home',
    'Attendee Help' => '/help/landing/attendees',
    'Organiser Help' => '/help/landing/organisers',
    'Vendor Help' => '/help/landing/vendors',
    'Policies and Trust' => '/help/landing/policies',
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $updated = 0;
  foreach ($map as $title => $alias) {
    $nodes = $storage->loadByProperties([
      'type' => 'help_landing_page',
      'title' => $title,
    ]);
    if ($nodes === []) {
      continue;
    }
    $node = reset($nodes);
    if (!$node instanceof Node || !$node->hasField('path')) {
      continue;
    }
    $node->set('path', [
      'alias' => $alias,
      'pathauto' => 0,
    ]);
    $node->save();
    $updated++;
  }

  return $updated > 0
    ? sprintf('Relocated %d landing page path(s) to /help/landing/* so /help and audience routes use HelpCentreController.', $updated)
    : 'No help_landing_page nodes matched; path relocation skipped.';
}

/**
 * Remove legacy /help/* aliases that blocked Help Centre routes (after 10027).
 */
function myeventlane_help_centre_update_10028(): string {
  $legacy = [
    '/help',
    '/help/attendees',
    '/help/organisers',
    '/help/vendors',
    '/help/policies',
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $ids = $storage->getQuery()
    ->condition('alias', $legacy, 'IN')
    ->accessCheck(FALSE)
    ->execute();
  if ($ids === []) {
    return 'No legacy landing aliases to remove.';
  }
  $entities = $storage->loadMultiple($ids);
  $storage->delete($entities);

  return sprintf('Removed %d legacy path alias(es) so /help and audience URLs use controllers.', count($entities));
}

/**
 * Executes Help Centre content seeding update logic.
 */
function _myeventlane_help_centre_seed_content_update(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');

  try {
    $seeder = new \Drupal\myeventlane_help_centre\Service\HelpContentSeeder(
      \Drupal::entityTypeManager(),
      \Drupal::service('logger.factory'),
    );
    $createdLandingPages = $seeder->seedLandingPages();
    $createdArticles = $seeder->seedHelpArticles();

    $logger->notice('Help Centre content seeded. Landing pages created: @pages. Articles created: @articles.', [
      '@pages' => (string) $createdLandingPages,
      '@articles' => (string) $createdArticles,
    ]);

    return sprintf(
      'Help Centre seeding complete. Created %d landing pages and %d help articles.',
      $createdLandingPages,
      $createdArticles,
    );
  }
  catch (\Throwable $exception) {
    $logger->error('Help Centre content seeding failed: @message', [
      '@message' => $exception->getMessage(),
    ]);
    throw new \RuntimeException('Help Centre content seeding failed. Check logs for details.', 0, $exception);
  }
}

/**
 * Ensures a taxonomy vocabulary exists.
 */
function _myeventlane_help_centre_ensure_vocabulary(string $vid, string $name, string $description): ?Vocabulary {
  $vocabulary = Vocabulary::load($vid);
  if (!$vocabulary) {
    $vocabulary = Vocabulary::create([
      'vid' => $vid,
      'name' => $name,
      'description' => $description,
      'weight' => 0,
    ]);
    $vocabulary->save();
  }
  else {
    $changed = FALSE;
    if ((string) $vocabulary->label() !== $name) {
      $vocabulary->set('name', $name);
      $changed = TRUE;
    }
    if ((string) $vocabulary->getDescription() !== $description) {
      $vocabulary->set('description', $description);
      $changed = TRUE;
    }
    if ($changed) {
      $vocabulary->save();
    }
  }

  return $vocabulary;
}

/**
 * Ensures taxonomy terms exist in a vocabulary.
 */
function _myeventlane_help_centre_ensure_terms(string $vid, array $termNames): int {
  $created = 0;
  $termStorage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($termNames as $name) {
    $existing = $termStorage->loadByProperties([
      'vid' => $vid,
      'name' => $name,
    ]);
    if (!empty($existing)) {
      continue;
    }
    $term = Term::create([
      'vid' => $vid,
      'name' => $name,
    ]);
    $term->save();
    $created++;
  }
  return $created;
}

/**
 * Ensures a field storage exists.
 */
function _myeventlane_help_centre_ensure_field_storage(string $entityType, string $fieldName, string $fieldType, array $settings, int $cardinality, bool $translatable): void {
  $fieldStorage = FieldStorageConfig::loadByName($entityType, $fieldName);
  if ($fieldStorage) {
    return;
  }

  $fieldStorage = FieldStorageConfig::create([
    'entity_type' => $entityType,
    'field_name' => $fieldName,
    'type' => $fieldType,
    'settings' => $settings,
    'cardinality' => $cardinality,
    'translatable' => $translatable,
  ]);
  $fieldStorage->save();
}

/**
 * Ensures a bundle field instance exists.
 */
function _myeventlane_help_centre_ensure_field_instance(string $entityType, string $bundle, string $fieldName, string $label, string $fieldType, bool $required, array $settings): void {
  $field = FieldConfig::loadByName($entityType, $bundle, $fieldName);
  if ($field) {
    return;
  }

  $field = FieldConfig::create([
    'entity_type' => $entityType,
    'bundle' => $bundle,
    'field_name' => $fieldName,
    'label' => $label,
    'field_type' => $fieldType,
    'required' => $required,
    'settings' => $settings,
  ]);
  $field->save();
}

