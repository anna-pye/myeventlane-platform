/**
 * Backfill taxonomy audience from legacy help article audience values.
 */
function myeventlane_help_centre_update_10006(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $fieldStorageDefinitions = \Drupal::service('entity_field.manager')
    ->getActiveFieldStorageDefinitions('node');

  if (!isset($fieldStorageDefinitions['field_help_audience']) || !isset($fieldStorageDefinitions['field_audience'])) {
    $logger->warning('Skipped help audience backfill because required fields are missing.');
    return 'Skipped audience backfill: required fields missing.';
  }

  $termStorage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $mappedTerms = [
    'public' => NULL,
    'vendor' => NULL,
    'staff' => NULL,
  ];
  $termMap = [
    'public' => 'Attendee',
    'vendor' => 'Vendor',
    'staff' => 'General',
  ];

  foreach ($termMap as $legacyAudience => $targetTermName) {
    $terms = $termStorage->loadByProperties([
      'vid' => 'help_audience',
      'name' => $targetTermName,
    ]);
    $term = $terms ? reset($terms) : NULL;
    if ($term instanceof Term) {
      $mappedTerms[$legacyAudience] = (int) $term->id();
    }
  }

  $nodeStorage = \Drupal::entityTypeManager()->getStorage('node');
  $batchSize = 100;
  $lastNid = 0;
  $scanned = 0;
  $updated = 0;
  $skipped = 0;
  $unmapped = 0;

  do {
    $query = $nodeStorage->getQuery()
      ->condition('type', 'help_article')
      ->condition('status', 1)
      ->condition('nid', $lastNid, '>')
      ->sort('nid', 'ASC')
      ->range(0, $batchSize)
      ->accessCheck(TRUE);

    $nids = $query->execute();
    if ($nids === []) {
      break;
    }

    $nodes = $nodeStorage->loadMultiple($nids);
    foreach ($nodes as $node) {
      $lastNid = max($lastNid, (int) $node->id());
      $scanned++;

      if ($node->get('field_help_audience')->isEmpty() === FALSE) {
        $skipped++;
        continue;
      }

      if ($node->get('field_audience')->isEmpty()) {
        $skipped++;
        continue;
      }

      $legacyValues = [];
      foreach ($node->get('field_audience')->getValue() as $item) {
        $value = (string) ($item['value'] ?? '');
        if ($value !== '') {
          $legacyValues[$value] = TRUE;
        }
      }

      if ($legacyValues === []) {
        $skipped++;
        continue;
      }

      $targetAudience = [];
      foreach (array_keys($legacyValues) as $legacyAudience) {
        if (!array_key_exists($legacyAudience, $mappedTerms) || $mappedTerms[$legacyAudience] === NULL) {
          $unmapped++;
          continue;
        }
        $targetAudience[(int) $mappedTerms[$legacyAudience]] = [
          'target_id' => (int) $mappedTerms[$legacyAudience],
        ];
      }

      if ($targetAudience === []) {
        $skipped++;
        continue;
      }

      $node->set('field_help_audience', array_values($targetAudience));
      $node->save();
      $updated++;
    }
  } while (count($nids) === $batchSize);

  $logger->notice('Help audience backfill complete. Scanned: @scanned, updated: @updated, skipped: @skipped, unmapped: @unmapped.', [
    '@scanned' => (string) $scanned,
    '@updated' => (string) $updated,
    '@skipped' => (string) $skipped,
    '@unmapped' => (string) $unmapped,
  ]);

  return sprintf(
    'Help audience backfill complete. Scanned %d, updated %d, skipped %d, unmapped %d.',
    $scanned,
    $updated,
    $skipped,
    $unmapped,
  );
}

/**
 * Ensure FAQ fields and displays are present and usable.
 */
function myeventlane_help_centre_update_10007(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $created = 0;
  $updated = 0;

  $faqType = NodeType::load('faq');
  if (!$faqType) {
    $faqType = NodeType::create([
      'type' => 'faq',
      'name' => 'FAQ',
      'description' => 'Frequently asked questions for Help Centre audiences.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ]);
    $faqType->save();
    $created++;
  }

  _myeventlane_help_centre_ensure_field_instance('node', 'faq', 'body', 'Answer', 'text_with_summary', TRUE, [
    'display_summary' => TRUE,
    'required_summary' => FALSE,
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'faq', 'field_help_audience', 'Audience', 'entity_reference', FALSE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => [
      'target_bundles' => ['help_audience' => 'help_audience'],
      'sort' => ['field' => 'name', 'direction' => 'asc'],
      'auto_create' => FALSE,
    ],
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'faq', 'field_help_category', 'Category', 'entity_reference', FALSE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => [
      'target_bundles' => ['help_categories' => 'help_categories'],
      'sort' => ['field' => 'name', 'direction' => 'asc'],
      'auto_create' => FALSE,
    ],
  ]);

  $formDisplay = EntityFormDisplay::load('node.faq.default');
  if (!$formDisplay) {
    $formDisplay = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'faq',
      'mode' => 'default',
      'status' => TRUE,
    ]);
    $created++;
  }
  $formComponents = [
    'title' => [
      'type' => 'string_textfield',
      'weight' => -5,
      'settings' => ['size' => 60, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
    'body' => [
      'type' => 'text_textarea_with_summary',
      'weight' => 0,
      'settings' => ['rows' => 9, 'summary_rows' => 3, 'show_summary' => TRUE, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
    'field_help_category' => [
      'type' => 'entity_reference_autocomplete',
      'weight' => 5,
      'settings' => ['match_operator' => 'CONTAINS', 'match_limit' => 10, 'size' => 60, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
    'field_help_audience' => [
      'type' => 'entity_reference_autocomplete_tags',
      'weight' => 6,
      'settings' => ['match_operator' => 'CONTAINS', 'match_limit' => 10, 'size' => 60, 'placeholder' => ''],
      'third_party_settings' => [],
    ],
  ];
  $formChanged = FALSE;
  foreach ($formComponents as $componentName => $componentConfig) {
    if ($formDisplay->getComponent($componentName) === NULL) {
      $formDisplay->setComponent($componentName, $componentConfig);
      $formChanged = TRUE;
    }
  }
  if ($formChanged) {
    $formDisplay->save();
    $updated++;
  }

  $viewDisplay = EntityViewDisplay::load('node.faq.default');
  if (!$viewDisplay) {
    $viewDisplay = EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'faq',
      'mode' => 'default',
      'status' => TRUE,
    ]);
    $created++;
  }
  $viewComponents = [
    'body' => [
      'type' => 'text_default',
      'label' => 'hidden',
      'weight' => 0,
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_help_category' => [
      'type' => 'entity_reference_label',
      'label' => 'above',
      'weight' => 1,
      'settings' => ['link' => FALSE],
      'third_party_settings' => [],
    ],
    'field_help_audience' => [
      'type' => 'entity_reference_label',
      'label' => 'above',
      'weight' => 2,
      'settings' => ['link' => FALSE],
      'third_party_settings' => [],
    ],
    'links' => [
      'settings' => [],
      'third_party_settings' => [],
      'weight' => 100,
      'region' => 'content',
    ],
  ];
  $viewChanged = FALSE;
  foreach ($viewComponents as $componentName => $componentConfig) {
    if ($viewDisplay->getComponent($componentName) === NULL) {
      $viewDisplay->setComponent($componentName, $componentConfig);
      $viewChanged = TRUE;
    }
  }
  if ($viewChanged) {
    $viewDisplay->save();
    $updated++;
  }

  $logger->notice('FAQ parity update complete. Created entities: @created. Updated displays: @updated.', [
    '@created' => (string) $created,
    '@updated' => (string) $updated,
  ]);

  return sprintf(
    'FAQ parity update complete. Created %d entities and updated %d displays.',
    $created,
    $updated,
  );
}

/**
 * Extend Help Centre browse views to include FAQ content safely.
 */
function myeventlane_help_centre_update_10008(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $updatedViews = 0;
  $viewIds = [
    'mel_help_centre_homepage',
    'mel_help_articles_by_audience',
    'mel_help_category_listing',
  ];

  foreach ($viewIds as $viewId) {
    $view = View::load($viewId);
    if (!$view) {
      continue;
    }

    $displays = $view->get('display');
    if (!isset($displays['default']['display_options']['filters']['type']['value'])) {
      continue;
    }

    $bundleFilter = $displays['default']['display_options']['filters']['type']['value'];
    if (!is_array($bundleFilter)) {
      $bundleFilter = [];
    }

    $changed = FALSE;
    if (!isset($bundleFilter['help_article'])) {
      $bundleFilter['help_article'] = 'help_article';
      $changed = TRUE;
    }
    if (!isset($bundleFilter['faq'])) {
      $bundleFilter['faq'] = 'faq';
      $changed = TRUE;
    }

    $sorts = $displays['default']['display_options']['sorts'] ?? [];
    if (!isset($sorts['type'])) {
      $sorts = [
        'type' => [
          'id' => 'type',
          'table' => 'node_field_data',
          'field' => 'type',
          'plugin_id' => 'standard',
          'order' => 'DESC',
        ],
      ] + $sorts;
      $changed = TRUE;
    }
    if (!isset($sorts['title'])) {
      $sorts['title'] = [
        'id' => 'title',
        'table' => 'node_field_data',
        'field' => 'title',
        'plugin_id' => 'standard',
        'order' => 'ASC',
      ];
      $changed = TRUE;
    }

    if (!$changed) {
      continue;
    }

    $displays['default']['display_options']['filters']['type']['value'] = $bundleFilter;
    $displays['default']['display_options']['sorts'] = $sorts;
    $view->set('display', $displays);

    $dependencies = $view->get('dependencies') ?? [];
    $dependencies['config'] = $dependencies['config'] ?? [];
    if (!in_array('node.type.faq', $dependencies['config'], TRUE)) {
      $dependencies['config'][] = 'node.type.faq';
      sort($dependencies['config']);
      $view->set('dependencies', $dependencies);
    }

    $view->save();
    $updatedViews++;
  }

  $logger->notice('Help browse views update complete. Updated views: @count.', [
    '@count' => (string) $updatedViews,
  ]);

  return sprintf('Updated %d Help Centre views to include FAQ content.', $updatedViews);
}

