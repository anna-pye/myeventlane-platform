/**
 * Implements hook_schema().
 */
function myeventlane_help_centre_schema(): array {
  $schema['myeventlane_help_feedback'] = [
    'description' => 'Stores help article helpful feedback submissions.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'node_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'helpful' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'session_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'node_id' => ['node_id'],
      'created' => ['created'],
    ],
  ];

  $schema['myeventlane_help_analytics'] = [
    'description' => 'Stores analytics events for Help Centre usage.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'event_type' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'node_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'query' => [
        'type' => 'varchar',
        'length' => 512,
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'event_type' => ['event_type'],
      'node_id' => ['node_id'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}

/**
 * Add 'staff' audience and create Staff Snippet Authoring Guide.
 */
function myeventlane_help_centre_update_10001(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');

  // Add 'staff' to field_audience allowed values.
  $config = \Drupal::configFactory()->getEditable('field.storage.node.field_audience');
  $settings = $config->get('settings') ?? [];
  $allowed = $settings['allowed_values'] ?? [];
  $has_staff = FALSE;
  foreach ($allowed as $item) {
    if (($item['value'] ?? '') === 'staff') {
      $has_staff = TRUE;
      break;
    }
  }
  if (!$has_staff) {
    $allowed[] = ['value' => 'staff', 'label' => 'Staff'];
    $settings['allowed_values'] = $allowed;
    $config->set('settings', $settings)->save();
    $logger->notice('Added "staff" to help article audience field.');
  }

  // Ensure Internal Governance category exists.
  $term = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties(['vid' => 'help_categories', 'name' => 'Internal Governance']);
  $term = $term ? reset($term) : NULL;

  if (!$term) {
    $term = Term::create([
      'vid' => 'help_categories',
      'name' => 'Internal Governance',
      'description' => 'Internal staff governance and communication standards.',
    ]);
    $term->save();
    $logger->notice('Created Internal Governance help category term.');
  }

  $tid = (int) $term->id();

  // Create Staff Snippet Authoring Guide if not exists.
  $nodes = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->loadByProperties([
      'type' => 'help_article',
      'title' => 'Staff Snippet Authoring Guide',
    ]);

  if (empty($nodes)) {
    $values = [
      'type' => 'help_article',
      'title' => 'Staff Snippet Authoring Guide',
      'status' => 1,
      'field_audience' => ['staff'],
      'field_help_category' => ['target_id' => $tid],
      'field_priority' => 1,
    ];
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $node = $storage->create($values);
    if ($node->hasField('body')) {
      $node->set('body', [
        'value' => '<p>This guide covers how to write effective reply snippets for staff playbooks.</p>'
          . '<h3>Tone</h3><p>Use a calm, neutral, professional tone. Be empathetic but avoid promises or guarantees.</p>'
          . '<h3>Word limit</h3><p>Keep snippets concise. Aim for 50–150 words per snippet where possible.</p>'
          . '<h3>Structure</h3><p>Use a clear format: Title on the first line, then body text. Use paragraphs for longer content.</p>',
        'format' => 'basic_html',
      ]);
    }
    $node->save();
    $logger->notice('Created Staff Snippet Authoring Guide help article.');
    return 'Added staff audience, Internal Governance category, and Staff Snippet Authoring Guide.';
  }

  return 'Staff audience and Internal Governance already configured.';
}

/**
 * Create footer menu if it does not exist (for existing installations).
 */
function myeventlane_help_centre_update_10002(): string {
  $storage = \Drupal::entityTypeManager()->getStorage('menu');
  if ($storage->load('footer') === NULL) {
    $menu = $storage->create([
      'id' => 'footer',
      'label' => 'Footer',
      'description' => 'Links displayed in the site footer (Help, Trust, etc.).',
    ]);
    $menu->save();
    return 'Created Footer menu for public navigation (Help, Trust links).';
  }
  return 'Footer menu already exists.';
}

/**
 * Ensure Help Centre vocabularies and taxonomy terms exist.
 */
function myeventlane_help_centre_update_10003(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');

  $audienceVocabulary = _myeventlane_help_centre_ensure_vocabulary(
    'help_audience',
    'Audience',
    'Audience segments for Help Centre content filtering.',
  );
  $categoryVocabulary = _myeventlane_help_centre_ensure_vocabulary(
    'help_categories',
    'Help Category',
    'Categories used to organize Help Centre content.',
  );

  if (!$audienceVocabulary || !$categoryVocabulary) {
    throw new \RuntimeException('Failed to ensure required Help Centre vocabularies.');
  }

  $audienceTerms = [
    'Attendee',
    'Organiser',
    'Vendor',
    'General',
  ];
  $helpCategoryTerms = [
    'Accounts',
    'Finding Events',
    'Buying Tickets',
    'Managing Tickets',
    'Refunds',
    'Event Day',
    'Creating Events',
    'Ticketing',
    'Payments',
    'Promotion',
    'Managing Attendees',
    'Vendors',
    'Policies',
    'Support',
  ];

  $createdAudience = _myeventlane_help_centre_ensure_terms('help_audience', $audienceTerms);
  $createdCategory = _myeventlane_help_centre_ensure_terms('help_categories', $helpCategoryTerms);

  $logger->notice('Help Centre taxonomy update complete. Audience terms created: @audience. Category terms created: @category.', [
    '@audience' => (string) $createdAudience,
    '@category' => (string) $createdCategory,
  ]);

  return 'Ensured help audience and help category vocabularies with baseline terms.';
}

/**
 * Ensure Help Centre content model is present.
 */
function myeventlane_help_centre_update_10004(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');

  // Ensure FAQ content type exists.
  $faqType = NodeType::load('faq');
  if (!$faqType) {
    $faqType = NodeType::create([
      'type' => 'faq',
      'name' => 'FAQ',
      'description' => 'Frequently asked questions for Help Centre audiences.',
      'new_revision' => TRUE,
      'preview_mode' => 1,
      'display_submitted' => FALSE,
    ]);
    $faqType->save();
    $logger->notice('Created FAQ content type.');
  }

  // Ensure required field storages.
  _myeventlane_help_centre_ensure_field_storage('node', 'field_help_audience', 'entity_reference', [
    'target_type' => 'taxonomy_term',
  ], -1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_help_category', 'entity_reference', [
    'target_type' => 'taxonomy_term',
  ], 1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_related_articles', 'entity_reference', [
    'target_type' => 'node',
  ], -1, TRUE);
  _myeventlane_help_centre_ensure_field_storage('node', 'field_last_updated', 'datetime', [
    'datetime_type' => 'date',
  ], 1, FALSE);

  // Ensure body field is present for both content types.
  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'body', 'Answer', 'text_with_summary', FALSE, [
    'display_summary' => TRUE,
    'required_summary' => FALSE,
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'faq', 'body', 'Answer', 'text_with_summary', TRUE, [
    'display_summary' => TRUE,
    'required_summary' => FALSE,
  ]);

  // Ensure help_article fields.
  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'field_help_audience', 'Audience', 'entity_reference', FALSE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => [
      'target_bundles' => ['help_audience' => 'help_audience'],
      'sort' => ['field' => 'name', 'direction' => 'asc'],
      'auto_create' => FALSE,
    ],
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'field_help_category', 'Category', 'entity_reference', TRUE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => [
      'target_bundles' => ['help_categories' => 'help_categories'],
      'sort' => ['field' => 'name', 'direction' => 'asc'],
      'auto_create' => FALSE,
    ],
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'field_related_articles', 'Related Articles', 'entity_reference', FALSE, [
    'handler' => 'default:node',
    'handler_settings' => [
      'target_bundles' => [
        'help_article' => 'help_article',
        'faq' => 'faq',
      ],
      'sort' => ['field' => '_none'],
      'auto_create' => FALSE,
    ],
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'help_article', 'field_last_updated', 'Last Updated', 'datetime', FALSE, []);

  // Ensure FAQ fields.
  _myeventlane_help_centre_ensure_field_instance('node', 'faq', 'field_help_audience', 'Audience', 'entity_reference', FALSE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => [
      'target_bundles' => ['help_audience' => 'help_audience'],
      'sort' => ['field' => 'name', 'direction' => 'asc'],
      'auto_create' => FALSE,
    ],
  ]);
  _myeventlane_help_centre_ensure_field_instance('node', 'faq', 'field_help_category', 'Category', 'entity_reference', FALSE, [
    'handler' => 'default:taxonomy_term',
    'handler_settings' => [
      'target_bundles' => ['help_categories' => 'help_categories'],
      'sort' => ['field' => 'name', 'direction' => 'asc'],
      'auto_create' => FALSE,
    ],
  ]);

  return 'Ensured Help Centre content types and required fields for help_article and faq.';
}

/**
 * Ensure baseline Help Centre views exist.
 */
function myeventlane_help_centre_update_10005(): string {
  $logger = \Drupal::logger('myeventlane_help_centre');
  $created = 0;

  if (!View::load('mel_help_centre_homepage')) {
    $view = View::create(_myeventlane_help_centre_build_view_definition(
      'mel_help_centre_homepage',
      'Help Centre Homepage',
      'Featured and popular help articles for homepage rendering.',
    ));
    $view->save();
    $created++;
  }

  if (!View::load('mel_help_articles_by_audience')) {
    $view = View::create(_myeventlane_help_centre_build_view_definition(
      'mel_help_articles_by_audience',
      'Help Articles by Audience',
      'Audience-filterable Help Centre article listing view.',
      TRUE,
    ));
    $view->save();
    $created++;
  }

  if (!View::load('mel_help_category_listing')) {
    $view = View::create(_myeventlane_help_centre_build_view_definition(
      'mel_help_category_listing',
      'Help Category Listing',
      'Category-filterable Help Centre article listing view.',
      FALSE,
      TRUE,
    ));
    $view->save();
    $created++;
  }

  $logger->notice('Help Centre views update complete. Created @count views.', ['@count' => (string) $created]);
  return 'Ensured core Help Centre views are available for homepage, audience, and category pages.';
}

