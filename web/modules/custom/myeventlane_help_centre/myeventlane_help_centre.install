  _myeventlane_help_centre_ensure_field_instance('node', 'support_procedure', 'field_last_reviewed', 'Last Reviewed', 'datetime', FALSE, []);
  _myeventlane_help_centre_ensure_field_instance('node', 'support_procedure', 'field_content_owner', 'Content Owner', 'entity_reference', FALSE, [
