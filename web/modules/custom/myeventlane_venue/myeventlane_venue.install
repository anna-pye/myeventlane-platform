<?php

/**
 * @file
 * Install, update, and uninstall functions for the myeventlane_venue module.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function myeventlane_venue_schema(): array {
  $schema['myeventlane_venue_overture_place'] = [
    'description' => 'Local, saveable Overture Maps venue suggestions.',
    'fields' => [
      'gers_id' => [
        'description' => 'Overture Global Entity Reference System identifier.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'name_normalized' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'address' => [
        'type' => 'varchar',
        'length' => 500,
        'not null' => FALSE,
      ],
      'locality' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'postcode' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
      ],
      'region' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
      ],
      'country' => [
        'type' => 'varchar',
        'length' => 2,
        'not null' => TRUE,
        'default' => 'AU',
      ],
      'latitude' => [
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 7,
        'not null' => TRUE,
      ],
      'longitude' => [
        'type' => 'numeric',
        'precision' => 11,
        'scale' => 7,
        'not null' => TRUE,
      ],
      'website' => [
        'type' => 'varchar',
        'length' => 2048,
        'not null' => FALSE,
      ],
      'phone' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
      'email' => [
        'type' => 'varchar',
        'length' => 254,
        'not null' => FALSE,
      ],
      'socials' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'confidence' => [
        'type' => 'numeric',
        'precision' => 5,
        'scale' => 4,
        'not null' => FALSE,
      ],
      'source_dataset' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'source_updated' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'imported' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['gers_id'],
    'indexes' => [
      'name_normalized' => [['name_normalized', 191]],
      'coordinates' => ['latitude', 'longitude'],
      'country' => ['country'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function myeventlane_venue_install(): void {
  \Drupal::logger('myeventlane_venue')->notice('MyEventLane Venue module installed.');
}

/**
 * Implements hook_uninstall().
 */
function myeventlane_venue_uninstall(): void {
  // Clean up configuration.
  \Drupal::configFactory()->getEditable('myeventlane_venue.settings')->delete();

  \Drupal::logger('myeventlane_venue')->notice('MyEventLane Venue module uninstalled.');
}

/**
 * Remove legacy location base fields and install new venue fields.
 *
 * The venue entity was refactored from a single-location model to a
 * multi-location architecture (VenueLocation entity). This update:
 * - Removes six legacy base fields (field_location, field_latitude,
 *   field_longitude, field_place_id, field_provider, field_vendor).
 * - Installs four new base fields (uid, visibility, share_token, description).
 * - Syncs the entity type definition (adds "owner" entity key, removes phantom
 *   data_table, updates storage class reference).
 */
function myeventlane_venue_update_10001(): void {
  $entity_type_id = 'myeventlane_venue';
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $logger = \Drupal::logger('myeventlane_venue');

  // Step 1: Remove legacy base fields that are no longer in the entity class.
  // These are the EXACT installed field names (verified via
  // entityLastInstalledSchemaRepository).
  $fields_to_remove = [
    'field_location',
    'field_latitude',
    'field_longitude',
    'field_place_id',
    'field_provider',
    'field_vendor',
  ];

  foreach ($fields_to_remove as $field_name) {
    $field_storage = $update_manager->getFieldStorageDefinition($field_name, $entity_type_id);
    if ($field_storage) {
      $update_manager->uninstallFieldStorageDefinition($field_storage);
      $logger->notice('Removed legacy base field @field from @entity.', [
        '@field' => $field_name,
        '@entity' => $entity_type_id,
      ]);
    }
  }

  // Step 2: Get the current entity type and field definitions from code.
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $field_definitions = \Drupal\myeventlane_venue\Entity\Venue::baseFieldDefinitions($entity_type);

  // Step 3: Install any base fields present in code but not yet in the DB.
  foreach ($field_definitions as $field_name => $field_definition) {
    $installed = $update_manager->getFieldStorageDefinition($field_name, $entity_type_id);
    if (!$installed) {
      $update_manager->installFieldStorageDefinition(
        $field_name,
        $entity_type_id,
        'myeventlane_venue',
        $field_definition,
      );
      $logger->notice('Installed new base field @field on @entity.', [
        '@field' => $field_name,
        '@entity' => $entity_type_id,
      ]);
    }
  }

  // Step 4: Sync the entity type definition directly.
  //
  // We cannot use $update_manager->updateEntityType() here because the
  // installed entity type has a phantom data_table ('myeventlane_venue_field_data')
  // and a different storage class ('VenueStorage'), which causes
  // SqlContentEntityStorageSchema::hasSharedTableStructureChange() to return
  // TRUE, triggering a "batch context required" exception.
  //
  // Since all actual schema changes (column additions/removals) are already
  // handled above, we can safely sync the entity type metadata (entity keys,
  // storage class, data_table) via the installed schema repository.
  /** @var \Drupal\Core\Entity\EntityLastInstalledSchemaRepositoryInterface $schema_repo */
  $schema_repo = \Drupal::service('entity.last_installed_schema.repository');
  $schema_repo->setLastInstalledDefinition($entity_type);
  $logger->notice('Synced entity type definition for @entity.', [
    '@entity' => $entity_type_id,
  ]);
}

/**
 * Adds Media Library venue images and migrates legacy direct-file images.
 */
function myeventlane_venue_update_10002(array &$sandbox): string {
  $entity_type_id = 'myeventlane_venue';
  $field_name = 'image_media';
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  if (!isset($sandbox['ids'])) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
    $definition = \Drupal\myeventlane_venue\Entity\Venue::baseFieldDefinitions($entity_type)[$field_name] ?? NULL;
    if ($definition === NULL) {
      throw new \RuntimeException('Venue image_media base field definition is missing.');
    }

    if (!$update_manager->getFieldStorageDefinition($field_name, $entity_type_id)) {
      $update_manager->installFieldStorageDefinition(
        $field_name,
        $entity_type_id,
        'myeventlane_venue',
        $definition,
      );
      \Drupal::entityTypeManager()->clearCachedDefinitions();
    }

    $venue_storage = \Drupal::entityTypeManager()->getStorage($entity_type_id);
    $sandbox['ids'] = array_values($venue_storage->getQuery()
      ->accessCheck(FALSE)
      ->sort('id')
      ->execute());
    $sandbox['index'] = 0;
    $sandbox['migrated'] = 0;
    $sandbox['reused'] = 0;
    $sandbox['created'] = 0;
    $sandbox['skipped'] = 0;
  }

  $ids = $sandbox['ids'];
  $total = count($ids);
  $limit = min($sandbox['index'] + 25, $total);
  $venue_storage = \Drupal::entityTypeManager()->getStorage($entity_type_id);
  $media_storage = \Drupal::entityTypeManager()->getStorage('media');

  while ($sandbox['index'] < $limit) {
    $venue_id = (int) $ids[$sandbox['index']];
    $venue = $venue_storage->load($venue_id);
    if ($venue === NULL
      || !$venue->hasField($field_name)
      || !$venue->get($field_name)->isEmpty()
      || !$venue->hasField('image')
      || $venue->get('image')->isEmpty()) {
      $sandbox['skipped']++;
      $sandbox['index']++;
      continue;
    }

    $legacy_item = $venue->get('image')->first();
    $file = $legacy_item?->entity;
    if (!$file instanceof \Drupal\file\FileInterface) {
      \Drupal::logger('myeventlane_venue')->warning(
        'Venue @venue legacy image could not be migrated because its file is missing.',
        ['@venue' => (string) $venue_id],
      );
      $sandbox['skipped']++;
      $sandbox['index']++;
      continue;
    }

    $owner_id = max(0, (int) $venue->getOwnerId());
    $existing = $media_storage->loadByProperties([
      'bundle' => 'image',
      'uid' => $owner_id,
      'field_media_image.target_id' => (int) $file->id(),
    ]);
    $media = $existing ? reset($existing) : NULL;

    if (!$media instanceof \Drupal\media\MediaInterface) {
      $alt = trim((string) ($legacy_item?->alt ?? ''));
      if ($alt === '') {
        $alt = (string) $venue->label();
      }
      $media = $media_storage->create([
        'bundle' => 'image',
        'uid' => $owner_id,
        'name' => $file->getFilename(),
        'field_media_image' => [
          'target_id' => (int) $file->id(),
          'alt' => $alt,
          'title' => (string) ($legacy_item?->title ?? ''),
        ],
      ]);
      $media->save();
      $sandbox['created']++;
    }
    else {
      $sandbox['reused']++;
    }

    $venue->set($field_name, ['target_id' => (int) $media->id()]);
    $venue->save();
    $sandbox['migrated']++;
    $sandbox['index']++;
  }

  $sandbox['#finished'] = $total === 0 ? 1 : $sandbox['index'] / $total;
  if ($sandbox['#finished'] < 1) {
    return sprintf('Migrated %d of %d venue records to Media Library images.', $sandbox['index'], $total);
  }

  return sprintf(
    'Venue image Media migration complete: %d migrated, %d Media created, %d reused, %d skipped.',
    $sandbox['migrated'],
    $sandbox['created'],
    $sandbox['reused'],
    $sandbox['skipped'],
  );
}

/**
 * Adds the Overture suggestion catalogue and venue enrichment provenance.
 */
function myeventlane_venue_update_10003(): string {
  $database_schema = \Drupal::database()->schema();
  $table = 'myeventlane_venue_overture_place';
  if (!$database_schema->tableExists($table)) {
    $module_schema = myeventlane_venue_schema();
    $database_schema->createTable($table, $module_schema[$table]);
  }

  $entity_type_id = 'myeventlane_venue';
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
  $definitions = \Drupal\myeventlane_venue\Entity\Venue::baseFieldDefinitions($entity_type);
  $field_names = [
    'enrichment_source',
    'enrichment_source_id',
    'enrichment_checked',
    'enrichment_accepted_fields',
    'organiser_verified',
  ];

  foreach ($field_names as $field_name) {
    if (!$update_manager->getFieldStorageDefinition($field_name, $entity_type_id)) {
      $update_manager->installFieldStorageDefinition(
        $field_name,
        $entity_type_id,
        'myeventlane_venue',
        $definitions[$field_name],
      );
    }
  }

  return 'Installed the Overture venue catalogue and organiser-reviewed enrichment fields.';
}

/**
 * Backfills venue profile addresses from their canonical primary locations.
 */
function myeventlane_venue_update_10004(array &$sandbox): string {
  $venue_storage = \Drupal::entityTypeManager()->getStorage('myeventlane_venue');
  if (!isset($sandbox['ids'])) {
    $sandbox['ids'] = array_values($venue_storage->getQuery()
      ->accessCheck(FALSE)
      ->sort('id')
      ->execute());
    $sandbox['index'] = 0;
    $sandbox['backfilled'] = 0;
  }

  $ids = $sandbox['ids'];
  $total = count($ids);
  $limit = min($sandbox['index'] + 50, $total);
  $venue_manager = \Drupal::service('myeventlane_venue.manager');

  while ($sandbox['index'] < $limit) {
    $venue = $venue_storage->load((int) $ids[$sandbox['index']]);
    if ($venue instanceof \Drupal\myeventlane_venue\Entity\Venue
      && $venue->get('primary_address')->isEmpty()) {
      $location = $venue_manager->getPrimaryLocation($venue);
      $address = $location?->getAddressText() ?? '';
      if (trim($address) !== '') {
        $venue->set('primary_address', trim($address));
        $venue->save();
        $sandbox['backfilled']++;
      }
    }
    $sandbox['index']++;
  }

  $sandbox['#finished'] = $total === 0 ? 1 : $sandbox['index'] / $total;
  if ($sandbox['#finished'] < 1) {
    return sprintf('Checked %d of %d venue profiles for primary addresses.', $sandbox['index'], $total);
  }

  return sprintf('Backfilled %d venue profile primary addresses.', $sandbox['backfilled']);
}
