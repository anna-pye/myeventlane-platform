<?php

/**
 * @file
 * Core services and utilities for MyEventLane platform.
 *
 * This module provides shared services used throughout the MyEventLane platform:
 * - myeventlane_core.date_formatter: Date formatting utilities for events.
 * - myeventlane_core.route_helper: Route lookup and URL generation helpers.
 */

declare(strict_types=1);

use Drupal\views\ViewExecutable;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Symfony\Component\Routing\RouteCollection;

/**
 * Implements hook_theme().
 */
function myeventlane_core_theme(): array {
  return [
    // Static templates still need an explicit variables array so ThemeManager
    // does not hit the render-element branch (Undefined array key "render element").
    'mel_403' => [
      'variables' => [],
      'template' => 'mel-403',
    ],
    'mel_404' => [
      'variables' => [],
      'template' => 'mel-404',
    ],
    'myeventlane_my_categories' => [
      'variables' => [
        'followed_categories' => [],
        'mel_category_follow_empty' => NULL,
        'mel_category_follow_section_no_new_events' => NULL,
      ],
      'template' => 'myeventlane-my-categories',
    ],
    'myeventlane_category_digest_email' => [
      'variables' => [
        'user' => NULL,
        'events_by_category' => [],
      ],
      'template' => 'myeventlane-category-digest-email',
    ],
    'customer_onboard_step' => [
      'variables' => [
        'step_number' => 1,
        'total_steps' => 4,
        'step_title' => NULL,
        'step_description' => NULL,
        'content' => NULL,
      ],
      'template' => 'customer-onboard-step',
    ],
    'myeventlane_studio_layout' => [
      'variables' => [
        'title' => NULL,
        'subtitle' => NULL,
        'left_nav' => NULL,
        'main' => NULL,
        'right_panel' => NULL,
      ],
      'template' => 'myeventlane-studio-layout',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function myeventlane_core_mail($key, &$message, $params): void {
  switch ($key) {
    case 'category_digest':
      $message['subject'] = $params['subject'] ?? t('Weekly Event Digest - New events in your categories');
      $message['body'][] = $params['body'] ?? '';
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      break;
  }
}

/**
 * Implements hook_cron().
 */
function myeventlane_core_cron(): void {
  \Drupal::service('myeventlane_core.category_digest_cron')->runSundayDigest();
}

/**
 * Implements hook_entity_access().
 *
 * Ensures administrators can access Commerce payment methods.
 */
function myeventlane_core_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  // Workspace access is server-enforced to isolate vendor staging areas.
  if ($entity->getEntityTypeId() === 'workspace') {
    if ($account->id() === 1 || $account->hasPermission('administer workspaces')) {
      return AccessResult::allowed()
        ->cachePerPermissions()
        ->addCacheContexts(['user.roles']);
    }

    if (in_array('vendor', $account->getRoles(), TRUE)) {
      $workspace_id = (string) $entity->id();
      $allowed_workspace_id = 'vendor_' . $account->id();
      $allowed_operations = ['view', 'update'];
      $is_allowed = ($workspace_id === $allowed_workspace_id) && in_array($operation, $allowed_operations, TRUE);
      return AccessResult::allowedIf($is_allowed)
        ->cachePerUser()
        ->addCacheContexts(['user.roles']);
    }

    return AccessResult::neutral()->addCacheContexts(['user.roles']);
  }

  // Only handle Commerce payment method entities.
  if ($entity->getEntityTypeId() !== 'commerce_payment_method') {
    return AccessResult::neutral();
  }

  // Administrators (UID 1 or has 'administer site configuration') always have access.
  if ($account->id() === 1 || $account->hasPermission('administer site configuration')) {
    return AccessResult::allowed()->cachePerPermissions();
  }

  // Let Commerce handle access for other users.
  return AccessResult::neutral();
}

/**
 * Implements hook_route_alter().
 */
function myeventlane_core_route_alter(RouteCollection $collection): void {
  foreach ($collection->all() as $name => $route) {
    $path = (string) $route->getPath();
    if (str_starts_with($path, '/admin/config/workflow/workspaces')) {
      $route->setRequirement('_custom_access', '\Drupal\myeventlane_core\Access\WorkspaceUiAccess::access');
    }
  }
}

/**
 * Implements hook_entity_type_alter().
 */
function myeventlane_core_entity_type_alter(array &$entity_types): void {
  $ignored_handler = 'Drupal\\workspaces\\Entity\\Handler\\IgnoredWorkspaceHandler';
  if (!class_exists($ignored_handler)) {
    return;
  }

  // Explicitly exclude transactional and operational entities from Workspaces.
  $excluded_entity_types = [
    'commerce_order',
    'commerce_order_item',
    'commerce_payment',
    'commerce_product_variation',
    'commerce_checkout_flow',
    'commerce_log',
    'myeventlane_ticket',
    'ticket_code',
    'mel_ticket_group',
    'mel_event_ticket_settings',
    'myeventlane_vendor_follow',
    'rsvp_submission',
  ];

  foreach ($excluded_entity_types as $entity_type_id) {
    if (($entity_types[$entity_type_id] ?? NULL) instanceof EntityTypeInterface) {
      $entity_types[$entity_type_id]->setHandlerClass('workspace', $ignored_handler);
    }
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Fixes Layout Builder entity view display dependency calculation issue.
 * Ensures view modes exist before saving to prevent null reference errors.
 *
 * This workaround fixes a core bug where calculateDependencies() calls
 * getConfigDependencyName() on a null view mode entity.
 */
function myeventlane_core_entity_presave(EntityInterface $entity): void {
  \Drupal::service('myeventlane_core.entity_view_display_presave')->presave($entity);
}

/**
 * Implements hook_views_post_execute().
 *
 * Log commerce_cart_form result count for debugging empty cart table.
 */
function myeventlane_core_views_post_execute(ViewExecutable $view): void {
  if ($view->id() !== 'commerce_cart_form') {
    return;
  }
  \Drupal::logger('myeventlane_core')->info('commerce_cart_form: args=@args result_count=@c', [
    '@args' => implode(',', array_map('strval', $view->args)),
    '@c' => count($view->result),
  ]);
}
