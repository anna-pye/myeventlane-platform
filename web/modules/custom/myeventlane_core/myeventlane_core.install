    ],
  ]);
  $view->save();
}

/**
 * Aligns admin review queue filters with live moderation state records.
 */
function myeventlane_core_update_9116(): void {
  $view = \Drupal::entityTypeManager()->getStorage('view')->load('mel_admin_review_queue');
  if (!$view) {
    return;
  }

  $display = $view->get('display');
  if (!is_array($display) || !isset($display['default']['display_options']['filters'])) {
    return;
  }

  // This filter can exclude valid latest review revisions in this setup.
  unset($display['default']['display_options']['filters']['latest_translation_affected_revision']);

  if (isset($display['default']['display_options']['filters']['moderation_state'])) {
    $display['default']['display_options']['filters']['moderation_state']['value'] = [
      'editorial-review' => 'editorial-review',
    ];
  }

  $view->set('display', $display);
  $view->save();
}

/**
 * Installs the vendor follow entity table on existing sites.
 */
function myeventlane_core_update_9117(): void {
  if (\Drupal::database()->schema()->tableExists('myeventlane_vendor_follow')) {
    return;
  }

  $entity_type = \Drupal::entityTypeManager()->getDefinition('myeventlane_vendor_follow');
  \Drupal::entityDefinitionUpdateManager()->installEntityType($entity_type);
}

/**
 * Creates the lightweight public analytics table on existing sites.
 */
function myeventlane_core_update_9118(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('myeventlane_public_analytics_event')) {
    return;
  }

  $module_schema = myeventlane_core_schema();
  $schema->createTable('myeventlane_public_analytics_event', $module_schema['myeventlane_public_analytics_event']);
}

/**
 * Points main menu Support at the public Help Centre hub (not /my/support).
 *
 * /my/support remains on the account menu; a restricted main-menu link was
 * hidden for anonymous users while Twig also rendered a hardcoded Support item.
 */
function myeventlane_core_update_9119(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $links = $storage->loadByProperties([
    'menu_name' => 'main',
    'title' => 'Support',
  ]);
  foreach ($links as $link) {
    $uri = $link->get('link')->uri ?? '';
    if ($uri === 'internal:/my/support' || str_ends_with((string) $uri, '/my/support')) {
      $link->set('link', ['uri' => 'internal:/help']);
      $link->save();
    }
  }
}

/**
 * Adds discovery attribution source to public analytics events.
 */
function myeventlane_core_update_9120(): void {
  $schema = \Drupal::database()->schema();
  $table = 'myeventlane_public_analytics_event';
  if (!$schema->tableExists($table)) {
    return;
  }

  if (!$schema->fieldExists($table, 'source')) {
    $schema->addField($table, 'source', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'Discovery attribution source for event_click rows.',
    ]);
  }

  if (!$schema->indexExists($table, 'event_type_source_timestamp')) {
    $module_schema = myeventlane_core_schema();
    $schema->addIndex(
      $table,
      'event_type_source_timestamp',
      ['event_type', 'source', 'timestamp'],
      $module_schema[$table],
    );
  }
}

/**
 * Reorders main navigation toward attendee-first marketplace IA (Option A).
 *
 * Target order: Home, Events, Calendar, Discover, Support, Organisers.
 * - Enables Views menu links for Events + Discover (/events/popular).
 * - Disables duplicate menu_link_content "Events" when present.
 * - Renames Vendors → Organisers, fixes organiser link, moves after Support.
 */
function myeventlane_core_update_9121(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');

  // Disable duplicate Events custom link; canonical Events comes from the view.
  $events_links = $storage->loadByProperties([
    'menu_name' => 'main',
    'title' => 'Events',
  ]);
  foreach ($events_links as $link) {
    $uri = (string) ($link->get('link')->uri ?? '');
    if ($uri === 'internal:/events' || str_ends_with($uri, '/events')) {
      $link->set('enabled', FALSE);
      $link->save();
    }
  }

  // Organisers: public directory parent (dropdown children added in theme preprocess).
  $organiser_links = $storage->loadByProperties(['menu_name' => 'main']);
  foreach ($organiser_links as $link) {
    $title = strtolower(trim((string) $link->getTitle()));
    if (!in_array($title, ['vendors', 'organisers'], TRUE)) {
      continue;
    }
    $link->set('title', 'Organisers');
    $link->set('link', ['uri' => 'internal:/organisers']);
    $link->set('weight', 4);
    $link->set('enabled', TRUE);
    $link->save();
  }

  $support_links = $storage->loadByProperties([
    'menu_name' => 'main',
    'title' => 'Support',
  ]);
  foreach ($support_links as $link) {
    $link->set('weight', 3);
    $link->save();
  }

  $home_links = $storage->loadByProperties([
    'menu_name' => 'main',
    'title' => 'Home',
  ]);
  foreach ($home_links as $link) {
    $link->set('weight', -10);
    $link->save();
  }
}
