<?php

/**
 * @file
 * MEL Event Studio — vendor event create/edit UI.
 */

use Drupal\Component\Utility\UrlHelper;
use Drupal\Core\Render\Element;
use Drupal\Core\Template\Attribute;
use Drupal\myeventlane_event_studio\EventStudioPreprocess;

/**
 * Implements hook_theme().
 *
 * Render-element theme on the form root so the template outputs a real <form>
 * (see template_preprocess_mel_event_studio). Wrapping the form in a page-level
 * #theme that only printed fragments produced zero <form> tags and broke save.
 */
function myeventlane_event_studio_theme($existing, $type, $theme, $path) {
  return [
    'mel_event_studio' => [
      'render element' => 'element',
      'template' => 'mel-event-studio',
    ],
  ];
}

/**
 * Implements hook_preprocess_html().
 *
 * Full-bleed Event Studio: body class scopes theme SCSS that relaxes global
 * layout containers (layout-container, Gin, off-canvas canvas, etc.).
 */
function myeventlane_event_studio_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $studio_routes = [
    'myeventlane_event_studio.create',
    'myeventlane_event_studio.edit',
  ];
  if (!in_array($route_name, $studio_routes, TRUE)) {
    return;
  }
  if (isset($variables['attributes']) && $variables['attributes'] instanceof Attribute) {
    $variables['attributes']->addClass('mel-event-studio-page');
  }
}

/**
 * Implements hook_preprocess_HOOK() for mel_event_studio.
 *
 * Mirrors \Drupal\Core\Form\FormPreprocess::preprocessForm() so action, method,
 * id, and accept-charset are on the opening <form> tag.
 */
function myeventlane_event_studio_preprocess_mel_event_studio(&$variables): void {
  $element = $variables['element'];
  if (isset($element['#action'])) {
    $element['#attributes']['action'] = UrlHelper::stripDangerousProtocols($element['#action']);
  }
  Element::setAttributes($element, ['method', 'id']);
  if (empty($element['#attributes']['accept-charset'])) {
    $element['#attributes']['accept-charset'] = 'UTF-8';
  }
  $variables['attributes'] = new Attribute($element['#attributes']);
  $variables['mode'] = $element['#mel_studio_mode'] ?? 'create';

  (new EventStudioPreprocess())->preprocess($variables);
}
