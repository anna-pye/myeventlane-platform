<?php

/**
 * @file
 * MEL Event Studio — vendor event create/edit UI.
 */

use Drupal\Component\Utility\UrlHelper;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_form_alter().
 *
 * Debug trace: log resolved #submit keys after all alters (Event Studio + wizard).
 */
function myeventlane_event_studio_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'user_login_form') {
    return;
  }
  if (!str_starts_with($form_id, 'mel_event_studio')) {
    return;
  }
  $root_submit = (isset($form['#submit']) && is_array($form['#submit'])) ? implode(', ', $form['#submit']) : '(not set on #submit; core may add defaults)';
  $action_submit = (isset($form['actions']['submit']['#submit']) && is_array($form['actions']['submit']['#submit']))
    ? implode(', ', $form['actions']['submit']['#submit'])
    : '(not set on button; may use form default / ::submitForm)';
  $root_validate = (isset($form['#validate']) && is_array($form['#validate'])) ? implode(', ', $form['#validate']) : '(not set)';
  \Drupal::logger('mel_debug')->notice('FORM_ALTER: @id | #validate: @v | #submit: @s | actions.submit #submit: @a', [
    '@id' => $form_id,
    '@v' => $root_validate,
    '@s' => $root_submit,
    '@a' => $action_submit,
  ]);
}

/**
 * Implements hook_theme().
 *
 * Render-element theme on the form root so the template outputs a real <form>
 * (see template_preprocess_mel_event_studio). Wrapping the form in a page-level
 * #theme that only printed fragments produced zero <form> tags and broke save.
 */
function myeventlane_event_studio_theme($existing, $type, $theme, $path) {
  return [
    'mel_event_studio' => [
      'render element' => 'element',
      'template' => 'mel-event-studio',
    ],
    'mel_event_studio_wizard_nav' => [
      'variables' => [
        'node' => NULL,
        'current_step' => '',
      ],
      'template' => 'mel-event-studio-wizard-nav',
    ],
    'mel_event_studio_wizard_preview' => [
      'variables' => [
        'node' => NULL,
      ],
      'template' => 'mel-event-studio-wizard-preview',
    ],
  ];
}

/**
 * Implements hook_preprocess_html().
 *
 * Full-bleed Event Studio: body class scopes theme SCSS that relaxes global
 * layout containers (layout-container, Gin, off-canvas canvas, etc.).
 */
function myeventlane_event_studio_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $studio_routes = [
    'myeventlane_event_studio.create',
    'myeventlane_event_studio.edit',
    'myeventlane_event_studio.edit_basic',
    'myeventlane_event_studio.edit_datetime',
    'myeventlane_event_studio.edit_tickets',
    'myeventlane_event_studio.edit_description',
    'myeventlane_event_studio.edit_preview',
    'myeventlane_event_studio.edit_publish',
  ];
  if (!in_array($route_name, $studio_routes, TRUE)) {
    return;
  }
  if (isset($variables['attributes']) && $variables['attributes'] instanceof Attribute) {
    $variables['attributes']->addClass('mel-event-studio-page');
  }
}

/**
 * Implements hook_preprocess_HOOK() for mel_event_studio.
 *
 * Mirrors \Drupal\Core\Form\FormPreprocess::preprocessForm() so action, method,
 * id, and accept-charset are on the opening <form> tag.
 */
function myeventlane_event_studio_preprocess_mel_event_studio(&$variables): void {
  $element = $variables['element'];
  if (isset($element['#action'])) {
    $element['#attributes']['action'] = UrlHelper::stripDangerousProtocols($element['#action']);
  }
  Element::setAttributes($element, ['method', 'id']);
  if (empty($element['#attributes']['accept-charset'])) {
    $element['#attributes']['accept-charset'] = 'UTF-8';
  }
  $variables['attributes'] = new Attribute($element['#attributes']);
  $variables['mode'] = $element['#mel_studio_mode'] ?? 'create';

  /** @var \Drupal\myeventlane_event_studio\EventStudioPreprocess $preprocess */
  $preprocess = \Drupal::service('myeventlane_event_studio.preprocess');
  $preprocess->preprocess($variables);
}
