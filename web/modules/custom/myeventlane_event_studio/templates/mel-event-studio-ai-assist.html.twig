{% set panel_id = 'mel-ai-assist-' ~ target ~ '-panel' %}
{% set status_id = 'mel-ai-assist-' ~ target ~ '-status' %}
{% set preview_id = 'mel-ai-assist-' ~ target ~ '-preview' %}
{% set meta_id = 'mel-ai-assist-' ~ target ~ '-meta' %}
{% set changes_id = 'mel-ai-assist-' ~ target ~ '-changes' %}

<div
  class="mel-ai-assist"
  data-mel-ai-assist
  data-mel-ai-target="{{ target }}"
  data-mel-ai-field-name="{{ field_name }}"
  data-mel-ai-section="{{ section }}"
  data-mel-ai-endpoint="{{ endpoint }}"
>
  <div class="mel-ai-assist__header">
    <p class="mel-ai-assist__prompt">{{ 'Need help writing this?'|t }}</p>
    <button
      type="button"
      class="mel-ai-assist__toggle"
      data-mel-ai-toggle
      aria-expanded="false"
      aria-controls="{{ panel_id }}"
    >
      <span aria-hidden="true">✨</span>
      <span>{{ button_label }}</span>
    </button>
  </div>

  <div id="{{ panel_id }}" class="mel-ai-assist__panel" data-mel-ai-panel hidden>
    <p class="mel-ai-assist__helper">{{ helper }}</p>

    <details class="mel-ai-assist__prompts">
      <summary class="mel-ai-assist__prompts-summary">{{ 'Choose a writing direction'|t }}</summary>
      {% for group, chips in chip_groups %}
        <fieldset class="mel-ai-assist__chips" data-mel-ai-chip-group="{{ group|lower }}">
          <legend class="mel-ai-assist__chips-label">{{ group|t }}</legend>
          <div class="mel-ai-assist__chip-scroll">
            {% for value, label in chips %}
              <button
                type="button"
                class="mel-ai-assist__chip"
                data-mel-ai-chip="{{ value }}"
                aria-pressed="false"
              >{{ label }}</button>
            {% endfor %}
          </div>
        </fieldset>
      {% endfor %}
    </details>

    <div class="mel-ai-assist__actions">
      <button type="button" class="mel-btn mel-btn--secondary mel-ai-assist__generate" data-mel-ai-generate>
        <span class="mel-ai-assist__button-spinner" aria-hidden="true"></span>
        {{ generate_label }}
      </button>
      <button type="button" class="mel-btn mel-btn--ghost mel-ai-assist__regenerate" data-mel-ai-regenerate hidden>
        {{ regenerate_label }}
      </button>
      <button type="button" class="mel-btn mel-btn--primary mel-ai-assist__insert" data-mel-ai-insert hidden>
        {{ insert_label }}
      </button>
    </div>

    <p id="{{ status_id }}" class="mel-ai-assist__status" data-mel-ai-status role="status" aria-live="polite"></p>

    <div class="mel-ai-assist__suggestion" data-mel-ai-suggestion hidden aria-live="polite" aria-describedby="{{ meta_id }} {{ changes_id }}">
      <p class="mel-ai-assist__suggestion-label">{{ 'Writing idea'|t }}</p>
      <div
        id="{{ preview_id }}"
        class="mel-ai-assist__preview"
        data-mel-ai-preview
        tabindex="-1"
      ></div>
      <p id="{{ meta_id }}" class="mel-ai-assist__meta" data-mel-ai-meta></p>
      <div id="{{ changes_id }}" class="mel-ai-assist__changes" data-mel-ai-changes hidden>
        <p class="mel-ai-assist__changes-title">{{ 'What changed'|t }}</p>
        <ul class="mel-ai-assist__changes-list" data-mel-ai-changes-list></ul>
      </div>
    </div>

    <div class="mel-ai-assist__guest-preview" data-mel-ai-guest-preview hidden>
      <p class="mel-ai-assist__guest-preview-kicker">{{ 'Previewing how guests may read this'|t }}</p>
      <article class="mel-ai-assist__guest-card">
        <div class="mel-ai-assist__guest-copy" data-mel-ai-guest-copy></div>
      </article>
      <ul class="mel-ai-assist__guest-cues" data-mel-ai-guest-cues></ul>
      <details class="mel-ai-assist__original" data-mel-ai-original hidden>
        <summary>{{ 'Original text'|t }}</summary>
        <p data-mel-ai-original-excerpt></p>
      </details>
    </div>
  </div>
</div>
