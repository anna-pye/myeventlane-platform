{#
/**
 * @file
 * Event Studio — guided wizard: strength score, preview + insights, nav, full-width form.
 *
 * Theme hook is applied to the form root (render element = element) so this
 * template includes a real <form> and Drupal hidden fields (build ID, token).
 */
#}
<form{{ attributes }}>
  {% if element.mel_contextual_help_card is defined %}
    {{ element.mel_contextual_help_card }}
  {% endif %}

  <div class="mel-event-studio mel-event-studio--{{ mode|default('create') }}" data-mel-studio-shell="1">
    {# Hidden Drupal values for AI tone/audience (synced with panel selects .mel-ai-tone / .mel-ai-audience). #}
    {{ element.mel.ai_settings }}
    <h1 class="mel-event-studio__page-title visually-hidden">
      {% if mode == 'create' %}
        {{ 'Create Event'|t }}
      {% else %}
        {{ 'Edit Event'|t }}
      {% endif %}
    </h1>

    <div class="mel-event-studio__progress">
      <div class="mel-event-strength">
        <div class="mel-event-strength__bar">
          <div id="mel-event-strength-fill" class="mel-event-strength__fill"></div>
        </div>
        <div class="mel-event-strength__meta">
          <span id="mel-event-strength-score">0%</span>
          <span id="mel-event-strength-label">{{ 'Needs work'|t }}</span>
        </div>
      </div>
    </div>

    {# TOP ZONE #}
    <div class="mel-studio-top">
      <div class="mel-studio-top__preview">
        <div class="mel-event-studio__top">
          <div class="mel-event-studio__preview">
            <div id="mel-preview-card">
              <article class="mel-preview-card">
                <div class="mel-preview-card__media" id="mel-preview-card-media">
                  <img class="mel-preview-card__img" id="mel-preview-card-img" src="" alt="" width="640" height="336" loading="lazy" hidden />
                  <div class="mel-preview-card__media-placeholder" id="mel-preview-card-placeholder">
                    <span aria-hidden="true"></span>
                  </div>
                </div>
                <div class="mel-preview-card__body">
                  <h3 class="mel-preview-card__title" id="mel-preview-title">—</h3>
                  <p class="mel-preview-card__meta">
                    <time class="mel-preview-card__time" id="mel-preview-schedule" datetime="">—</time>
                  </p>
                  <p class="mel-preview-card__location" id="mel-preview-location">—</p>
                  <p class="mel-preview-card__badge" id="mel-preview-tickets">—</p>
                  <p class="mel-preview-card__status" id="mel-preview-status">—</p>
                </div>
              </article>
            </div>
            <div class="mel-preview-hints" id="mel-preview-hints" aria-live="polite"></div>
          </div>

          <div class="mel-event-actions">
            {% if mel_event_actions.view %}
              <a href="{{ mel_event_actions.view }}" class="mel-btn mel-btn--ghost" target="_blank" rel="noopener noreferrer">{{ 'View page'|t }}</a>
            {% endif %}
            {% if mel_event_actions.booking %}
              <a href="{{ mel_event_actions.booking }}" class="mel-btn mel-btn--primary" target="_blank" rel="noopener noreferrer">{{ 'Booking page'|t }}</a>
            {% endif %}
            {% if mel_event_actions.scan %}
              <a href="{{ mel_event_actions.scan }}" class="mel-btn mel-btn--accent">{{ 'Scan tickets'|t }}</a>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="mel-studio-top__insights">
        <div class="mel-ai-controls" role="region" aria-label="{{ 'AI style for generation'|t }}">
          <div class="mel-ai-controls__row">
            <label class="mel-ai-controls__group">
              <span>{{ 'Tone'|t }}</span>
              <select class="mel-input mel-ai-tone" aria-label="{{ 'AI tone'|t }}">
                <option value="community">{{ 'Community'|t }}</option>
                <option value="fun">{{ 'Fun'|t }}</option>
                <option value="professional">{{ 'Professional'|t }}</option>
                <option value="urgent">{{ 'Urgent'|t }}</option>
                <option value="luxury">{{ 'Premium'|t }}</option>
              </select>
            </label>
            <label class="mel-ai-controls__group">
              <span>{{ 'Audience'|t }}</span>
              <select class="mel-input mel-ai-audience" aria-label="{{ 'AI audience'|t }}">
                <option value="general">{{ 'General'|t }}</option>
                <option value="lgbtq">{{ 'LGBTQIA+'|t }}</option>
                <option value="students">{{ 'Students'|t }}</option>
                <option value="professionals">{{ 'Professionals'|t }}</option>
                <option value="families">{{ 'Families'|t }}</option>
              </select>
            </label>
          </div>
        </div>

        <div class="mel-suggestions-card mel-insights-card">
          <h3 class="mel-aside-card__title">{{ 'What still needs attention'|t }}</h3>
          <div id="mel-insights-list" class="mel-insights-checklist" role="list" aria-live="polite"></div>
        </div>

        <div class="mel-publish-readiness-card mel-publish-card">
          <h3 class="mel-aside-card__title">{{ 'Publish readiness'|t }}</h3>
          <div id="mel-publish-readiness" class="mel-publish-readiness-body"></div>
        </div>

        <p class="mel-aside-footnote" id="mel-studio-form-state" role="status"></p>
      </div>
    </div>

    {# NAV #}
    <div class="mel-studio-nav mel-wizard-nav" id="mel-wizard-nav" role="tablist" aria-label="{{ 'Event steps'|t }}">
      <button type="button" data-step="basic" role="tab" aria-selected="true">{{ 'Basic'|t }}</button>
      <button type="button" data-step="schedule" role="tab" aria-selected="false">{{ 'Date'|t }}</button>
      <button type="button" data-step="location" role="tab" aria-selected="false">{{ 'Location'|t }}</button>
      <button type="button" data-step="tickets" role="tab" aria-selected="false">{{ 'Tickets'|t }}</button>
      <button type="button" data-step="advanced" role="tab" aria-selected="false">{{ 'Advanced'|t }}</button>
    </div>

    {# FORM ZONE — wizard + actions (single root <form> above; not a nested form). #}
    <div class="mel-studio-form-wrapper mel-event-studio__form-full mel-studio-main-full">
      <div class="mel-wizard">
        {# —— Basic —— #}
        <div class="mel-step" data-step="basic" role="tabpanel">
          <section class="mel-section mel-section--card mel-section--builder mel-section--basic" aria-labelledby="mel-basic-heading">
            <header class="mel-section__header">
              <h2 class="mel-section__title" id="mel-basic-heading">{{ 'Basic info'|t }}</h2>
              <p class="mel-section__hint">{{ 'Name your event, how it shows in listings, and your cover image.'|t }}</p>
            </header>

            <div class="mel-basic-section">
              <div class="mel-basic-title-with-ai">
                {{ element.mel.title }}
                <div class="mel-ai-autofill">
                  <button
                    type="button"
                    id="mel-ai-generate"
                    class="mel-btn mel-btn--secondary"
                    data-mel-ai-default-label="{{ '✨ Generate with AI'|t }}"
                  >
                    {{ '✨ Generate with AI'|t }}
                  </button>
                </div>
              </div>
              {{ element.mel.summary }}

              <div class="mel-form-group">
                {{ element.mel.field_category }}
              </div>
              <div class="mel-category-chips" id="mel-category-chips" aria-live="polite"></div>

              <div class="mel-identity-media">
                <p class="mel-subsection-label">{{ 'Cover image'|t }}</p>
                <div class="mel-cover-preview" id="mel-cover-preview" data-mel-cover-preview>
                  <img class="mel-cover-preview__img" id="mel-cover-preview-img" src="" alt="" width="1200" height="630" loading="lazy" hidden />
                  <div class="mel-cover-preview__empty" id="mel-cover-preview-empty">
                    <span class="mel-cover-preview__empty-icon" aria-hidden="true"></span>
                    <span class="mel-cover-preview__empty-text">{{ 'No cover yet — add an image for stronger discovery.'|t }}</span>
                  </div>
                </div>
                <div class="mel-identity-media__fields mel-form-grid">
                  {{ element.mel.field_event_image }}
                  {{ element.mel.field_event_image_alt }}
                </div>
              </div>

              <div class="mel-section">
                <h3>{{ 'About the event'|t }}</h3>
                {{ element.mel.body }}
                <div class="mel-ai-rewrite-actions">
                  <button type="button" id="mel-ai-rewrite-about" class="mel-btn mel-btn--secondary">{{ 'Rewrite About'|t }}</button>
                </div>
              </div>

              <div class="mel-section">
                <h3>{{ 'Highlights'|t }}</h3>
                {{ element.mel.event_highlights }}
              </div>

              <div class="mel-section">
                <h3>{{ 'What to expect'|t }}</h3>
                {{ element.mel.field_event_intro }}
                <div class="mel-ai-rewrite-actions">
                  <button type="button" id="mel-ai-rewrite-expect" class="mel-btn mel-btn--secondary">{{ 'Rewrite What to Expect'|t }}</button>
                </div>
              </div>
            </div>

            <div class="mel-step-actions">
              <button type="button" class="mel-btn mel-prev" disabled>{{ 'Back'|t }}</button>
              <button type="button" class="mel-btn mel-next">{{ 'Continue'|t }}</button>
            </div>
          </section>
        </div>

        {# —— Schedule —— #}
        <div class="mel-step" data-step="schedule" role="tabpanel">
          <section class="mel-section mel-section--card mel-section--builder mel-section--details" aria-labelledby="mel-details-heading">
            <header class="mel-section__header">
              <h2 class="mel-section__title" id="mel-details-heading">{{ 'Date & time'|t }}</h2>
              <p class="mel-section__hint">{{ 'When your event runs — used in search, reminders, and calendars.'|t }}</p>
            </header>

            <div class="mel-form-grid">
              {{ element.mel.start_date }}
              {{ element.mel.end_date }}
            </div>

            <div class="mel-step-actions">
              <button type="button" class="mel-btn mel-prev">{{ 'Back'|t }}</button>
              <button type="button" class="mel-btn mel-next">{{ 'Continue'|t }}</button>
            </div>
          </section>
        </div>

        {# —— Location —— #}
        <div class="mel-step" data-step="location" role="tabpanel">
          <section class="mel-section mel-section--card mel-section--builder mel-section--location" aria-labelledby="mel-location-heading">
            <header class="mel-section__header">
              <h2 class="mel-section__title" id="mel-location-heading">{{ 'Location'|t }}</h2>
              <p class="mel-section__hint">{{ 'Helps attendees plan with confidence.'|t }}</p>
            </header>

            {{ element.mel.venue_mode }}
            {{ element.mel.venue_saved }}
            {{ element.mel.venue_create_name }}
            {{ element.mel.location_search }}

            <div class="mel-location-display" id="mel-location-display" role="status" aria-live="polite">
              <p class="mel-location-display__label">{{ 'Selected address'|t }}</p>
              <p class="mel-location-display__value" id="mel-location-display-value">{{ 'Nothing selected yet — search or pick a venue above.'|t }}</p>
            </div>

            <div class="mel-location-map-placeholder" id="mel-location-map-placeholder" aria-hidden="true">
              <span class="mel-location-map-placeholder__pin" aria-hidden="true"></span>
              <span class="mel-location-map-placeholder__caption">{{ 'Map preview'|t }}</span>
            </div>

            <div class="mel-location-technical">
              {{ element.mel.field_location }}
              {{ element.mel.field_location_latitude }}
              {{ element.mel.field_location_longitude }}
            </div>

            <div class="mel-step-actions">
              <button type="button" class="mel-btn mel-prev">{{ 'Back'|t }}</button>
              <button type="button" class="mel-btn mel-next">{{ 'Continue'|t }}</button>
            </div>
          </section>
        </div>

        {# —— Tickets —— #}
        <div class="mel-step" data-step="tickets" role="tabpanel">
          <section class="mel-section mel-section--card mel-section--builder mel-section--tickets" aria-labelledby="mel-tickets-heading">
            <header class="mel-section__header">
              <h2 class="mel-section__title" id="mel-tickets-heading">{{ 'Tickets'|t }}</h2>
              <p class="mel-section__hint">{{ 'How people join — you can refine pricing and inventory in the Tickets workspace after save.'|t }}</p>
            </header>

            {{ element.mel.tickets_intro }}
            {{ element.mel.field_event_type }}
            {{ element.mel.studio_ticket_tiers }}
            {{ element.mel.studio_ticket_builder }}
            {{ element.mel.rsvp_capacity }}

            <div class="mel-ticket-paid-shell" id="mel-ticket-paid-shell" hidden>
              <div class="mel-ticket-fields-deck mel-form-grid">
                {{ element.mel.field_product_target }}
                {{ element.mel.field_ticket_types }}
              </div>
            </div>

            {{ element.mel.paid_ticket_panel }}
            {{ element.mel.external_url }}
            {{ element.mel.collect_attendee_questions }}
            {{ element.mel.enable_donations }}
            {{ element.mel.donation_amount }}
            {{ element.mel.donation_options }}
            {{ element.mel.donation_label }}
            {{ element.mel.ticket_summary }}

            <div class="mel-form-grid">
              {{ element.mel.field_sales_start }}
              {{ element.mel.field_sales_end }}
            </div>

            <div class="mel-step-actions">
              <button type="button" class="mel-btn mel-prev">{{ 'Back'|t }}</button>
              <button type="button" class="mel-btn mel-next">{{ 'Continue'|t }}</button>
            </div>
          </section>
        </div>

        {# —— Advanced —— #}
        <div class="mel-step" data-step="advanced" role="tabpanel">
          <details class="mel-advanced">
            <summary>{{ 'Advanced options'|t }}</summary>

            <section class="mel-section mel-section--card mel-section--builder mel-section--discovery" aria-labelledby="mel-discovery-heading">
              <header class="mel-section__header">
                <h2 class="mel-section__title" id="mel-discovery-heading">{{ 'Discovery'|t }}</h2>
                <p class="mel-section__hint">{{ 'Tags help people find your event.'|t }}</p>
              </header>
              {{ element.mel.field_tags }}
            </section>

            <section class="mel-section mel-section--card mel-section--builder mel-section--contact" aria-labelledby="mel-contact-heading">
              <header class="mel-section__header">
                <h2 class="mel-section__title" id="mel-contact-heading">{{ 'Organizer contact'|t }}</h2>
              </header>
              <div class="mel-form-grid">
                {{ element.mel.field_contact_email }}
                {{ element.mel.field_contact_phone }}
              </div>
            </section>

            <section class="mel-section mel-section--card mel-section--builder mel-section--policies" aria-labelledby="mel-policies-heading">
              <header class="mel-section__header">
                <h2 class="mel-section__title" id="mel-policies-heading">{{ 'Policies & audience'|t }}</h2>
              </header>
              <div class="mel-form-grid">
                {{ element.mel.field_age_policy }}
                {{ element.mel.field_age_policy_note }}
              </div>
              {{ element.mel.field_age_restriction }}
              {{ element.mel.field_refund_policy }}
            </section>

            <section class="mel-section mel-section--card mel-section--builder mel-section--accessibility" aria-labelledby="mel-a11y-heading">
              <header class="mel-section__header">
                <h2 class="mel-section__title" id="mel-a11y-heading">{{ 'Accessibility'|t }}</h2>
                <p class="mel-section__hint">{{ 'Features and practical details for attendees with access needs.'|t }}</p>
              </header>
              {{ element.mel.field_accessibility }}
              {{ element.mel.field_accessibility_contact }}
              {{ element.mel.field_accessibility_directions }}
              {{ element.mel.field_accessibility_entry }}
              {{ element.mel.field_accessibility_parking }}
            </section>
          </details>

          <section class="mel-section mel-section--card mel-section--builder mel-section--publish" aria-labelledby="mel-publish-heading">
            <header class="mel-section__header">
              <h2 class="mel-section__title" id="mel-publish-heading">{{ 'Publishing'|t }}</h2>
            </header>
            {{ element.mel.status }}
          </section>

          <div class="mel-step-actions">
            <button type="button" class="mel-btn mel-prev">{{ 'Back'|t }}</button>
            <button type="button" class="mel-btn mel-next">{{ 'Continue'|t }}</button>
          </div>
        </div>
      </div>

      {{ element.nid }}

      <div class="mel-event-studio__footer-actions mel-actions">
        {{ element.actions }}
      </div>
    </div>
  </div>

  <div id="mel-ai-diff-modal" class="mel-ai-diff-modal" hidden>
    <div class="mel-ai-diff-modal__overlay"></div>

    <div
      class="mel-ai-diff-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="mel-ai-diff-modal-title"
    >
      <h3 id="mel-ai-diff-modal-title">{{ 'Review AI changes'|t }}</h3>

      <div class="mel-ai-diff">
        <div class="mel-ai-diff__col">
          <h4>{{ 'Current'|t }}</h4>
          <div id="mel-ai-diff-current" class="mel-ai-diff__body"></div>
        </div>

        <div class="mel-ai-diff__col">
          <h4>{{ 'AI suggestion'|t }}</h4>
          <div id="mel-ai-diff-new" class="mel-ai-diff__body"></div>
        </div>
      </div>

      <div class="mel-ai-diff-modal__actions">
        <button type="button" id="mel-ai-diff-cancel" class="mel-btn">{{ 'Cancel'|t }}</button>
        <button type="button" id="mel-ai-diff-apply" class="mel-btn mel-btn--primary">{{ 'Apply changes'|t }}</button>
      </div>
    </div>
  </div>

  {{ element.form_build_id }}
  {% if element.form_token is defined %}
    {{ element.form_token }}
  {% endif %}
  {{ element.form_id }}
</form>
