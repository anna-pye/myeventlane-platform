{#
/**
 * @file
 * Event Studio — builder-style layout: identity, schedule, location, tickets, discovery, preview aside.
 *
 * Theme hook is applied to the form root (render element = element) so this
 * template includes a real <form> and Drupal hidden fields (build ID, token).
 */
#}
<form{{ attributes }}>
  {% if element.mel_contextual_help_card is defined %}
    {{ element.mel_contextual_help_card }}
  {% endif %}

  <div class="mel-event-studio mel-event-studio--{{ mode|default('create') }}" data-mel-studio-shell="1">
    <h1 class="mel-event-studio__page-title visually-hidden">
      {% if mode == 'create' %}
        {{ 'Create Event'|t }}
      {% else %}
        {{ 'Edit Event'|t }}
      {% endif %}
    </h1>

    <div class="mel-studio-layout">
      <div class="mel-studio-main">
        {# —— Event identity: title, summary, body, cover, category —— #}
        <section class="mel-section mel-section--card mel-section--builder mel-section--identity" aria-labelledby="mel-identity-heading">
          <header class="mel-section__header">
            <h2 class="mel-section__title" id="mel-identity-heading">{{ 'Event identity'|t }}</h2>
            <p class="mel-section__hint">{{ 'Name your event, tell the story, and choose how it shows up in search and social previews.'|t }}</p>
          </header>

          <div class="mel-identity-stack">
            {{ element.mel.title }}
            {{ element.mel.summary }}
            {{ element.mel.body }}
          </div>

          <div class="mel-identity-media">
            <p class="mel-subsection-label">{{ 'Cover image'|t }}</p>
            <div class="mel-cover-preview" id="mel-cover-preview" data-mel-cover-preview>
              <img class="mel-cover-preview__img" id="mel-cover-preview-img" src="" alt="" width="1200" height="630" loading="lazy" hidden />
              <div class="mel-cover-preview__empty" id="mel-cover-preview-empty">
                <span class="mel-cover-preview__empty-icon" aria-hidden="true"></span>
                <span class="mel-cover-preview__empty-text">{{ 'No cover yet — add an image for stronger discovery.'|t }}</span>
              </div>
            </div>
            <div class="mel-identity-media__fields">
              {{ element.mel.field_event_image }}
              {{ element.mel.field_event_image_alt }}
            </div>
          </div>

          <div class="mel-identity-category">
            <p class="mel-subsection-label">{{ 'Category'|t }}</p>
            {{ element.mel.field_category }}
            <div class="mel-category-chips" id="mel-category-chips" aria-live="polite"></div>
          </div>
        </section>

        <section class="mel-section mel-section--card mel-section--builder mel-section--datetime" aria-labelledby="mel-datetime-heading">
          <header class="mel-section__header">
            <h2 class="mel-section__title" id="mel-datetime-heading">{{ 'Date & time'|t }}</h2>
          </header>
          {{ element.mel.start_date }}
          {{ element.mel.end_date }}
        </section>

        <section class="mel-section mel-section--card mel-section--builder mel-section--location" aria-labelledby="mel-location-heading">
          <header class="mel-section__header">
            <h2 class="mel-section__title" id="mel-location-heading">{{ 'Location'|t }}</h2>
            <p class="mel-section__hint">{{ 'Choose a saved venue, create a new one, or use a one-off address.'|t }}</p>
          </header>

          {{ element.mel.venue_mode }}
          {{ element.mel.venue_saved }}
          {{ element.mel.venue_create_name }}
          {{ element.mel.location_search }}

          <div class="mel-location-display" id="mel-location-display" role="status" aria-live="polite">
            <p class="mel-location-display__label">{{ 'Selected address'|t }}</p>
            <p class="mel-location-display__value" id="mel-location-display-value">{{ 'Nothing selected yet — search or pick a venue above.'|t }}</p>
          </div>

          <div class="mel-location-map-placeholder" id="mel-location-map-placeholder" aria-hidden="true">
            <span class="mel-location-map-placeholder__pin" aria-hidden="true"></span>
            <span class="mel-location-map-placeholder__caption">{{ 'Map preview'|t }}</span>
          </div>

          <div class="mel-location-technical">
            {{ element.mel.field_location }}
            {{ element.mel.field_location_latitude }}
            {{ element.mel.field_location_longitude }}
          </div>
        </section>

        <section class="mel-section mel-section--card mel-section--builder mel-section--tickets" aria-labelledby="mel-tickets-heading">
          <header class="mel-section__header">
            <h2 class="mel-section__title" id="mel-tickets-heading">{{ 'Ticket setup'|t }}</h2>
            <p class="mel-section__hint">{{ 'How people join — you can refine pricing and inventory in the Tickets workspace after save.'|t }}</p>
          </header>

          {{ element.mel.tickets_intro }}
          {{ element.mel.field_event_type }}
          {{ element.mel.studio_ticket_tiers }}
          {{ element.mel.studio_ticket_builder }}
          {{ element.mel.rsvp_capacity }}

          <div class="mel-ticket-paid-shell" id="mel-ticket-paid-shell" hidden>
            <div class="mel-ticket-product-panel" id="mel-ticket-product-panel">
              <div class="mel-ticket-product-panel__empty" id="mel-ticket-product-empty">
                <p class="mel-ticket-product-panel__message" id="mel-ticket-product-empty-msg"></p>
                <a href="#" class="mel-btn mel-btn--secondary mel-ticket-product-panel__cta" id="mel-ticket-cta-tickets">
                  {{ 'Create ticket types'|t }}
                </a>
                <p class="mel-ticket-product-panel__hint">{{ 'Link a Commerce ticket product below, or build types in the workspace first.'|t }}</p>
              </div>
              <div class="mel-ticket-product-panel__ok" id="mel-ticket-product-ok" hidden>
                <p class="mel-ticket-product-panel__summary-label">{{ 'Linked product'|t }}</p>
                <p class="mel-ticket-product-panel__summary" id="mel-ticket-product-summary"></p>
                <p class="mel-ticket-product-panel__types" id="mel-ticket-types-summary"></p>
              </div>
            </div>
            <div class="mel-ticket-fields-deck">
              {{ element.mel.field_product_target }}
              {{ element.mel.field_ticket_types }}
            </div>
          </div>

          {{ element.mel.external_url }}
          {{ element.mel.collect_attendee_questions }}
          {{ element.mel.enable_donations }}
          {{ element.mel.donation_amount }}
          {{ element.mel.donation_options }}
          {{ element.mel.donation_label }}
          {{ element.mel.ticket_summary }}
        </section>

        <section class="mel-section mel-section--card mel-section--builder mel-section--discovery" aria-labelledby="mel-discovery-heading">
          <header class="mel-section__header">
            <h2 class="mel-section__title" id="mel-discovery-heading">{{ 'Discovery'|t }}</h2>
            <p class="mel-section__hint">{{ 'Tags add extra keywords beyond your main category.'|t }}</p>
          </header>
          {{ element.mel.field_tags }}
        </section>

        <section class="mel-section mel-section--card mel-section--builder mel-section--publish" aria-labelledby="mel-publish-heading">
          <header class="mel-section__header">
            <h2 class="mel-section__title" id="mel-publish-heading">{{ 'Publish'|t }}</h2>
          </header>
          {{ element.mel.status }}
        </section>

        {{ element.nid }}

        <div class="mel-actions">
          {{ element.actions }}
        </div>
      </div>

      <aside class="mel-studio-aside" aria-label="{{ 'Live preview and guidance'|t }}">
        <article class="mel-preview-card" id="mel-preview-card">
          <div class="mel-preview-card__media" id="mel-preview-card-media">
            <img class="mel-preview-card__img" id="mel-preview-card-img" src="" alt="" width="640" height="336" loading="lazy" hidden />
            <div class="mel-preview-card__media-placeholder" id="mel-preview-card-placeholder">
              <span aria-hidden="true"></span>
            </div>
          </div>
          <div class="mel-preview-card__body">
            <h3 class="mel-preview-card__title" id="mel-preview-title">—</h3>
            <p class="mel-preview-card__meta">
              <time class="mel-preview-card__time" id="mel-preview-schedule" datetime="">—</time>
            </p>
            <p class="mel-preview-card__location" id="mel-preview-location">—</p>
            <p class="mel-preview-card__badge" id="mel-preview-tickets">—</p>
            <p class="mel-preview-card__status" id="mel-preview-status">—</p>
          </div>
        </article>

        <div class="mel-aside-card mel-aside-card--insights">
          <h3 class="mel-aside-card__title">{{ 'Suggestions'|t }}</h3>
          <ul class="mel-insights-list" id="mel-insights-list" aria-live="polite"></ul>
        </div>

        <div class="mel-aside-card mel-aside-card--publish mel-aside-card--muted">
          <h3 class="mel-aside-card__title">{{ 'Publish readiness'|t }}</h3>
          <p class="mel-publish-readiness" id="mel-publish-readiness"></p>
        </div>

        <p class="mel-aside-footnote" id="mel-studio-form-state" role="status"></p>
      </aside>
    </div>
  </div>

  {{ element.form_build_id }}
  {% if element.form_token is defined %}
    {{ element.form_token }}
  {% endif %}
  {{ element.form_id }}
</form>
