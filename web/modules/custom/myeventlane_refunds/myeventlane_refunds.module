<?php

/**
 * @file
 * Module hooks for MyEventLane Refunds.
 */

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\myeventlane_refunds\Service\RefundRequestStorage;

/**
 * Implements hook_preprocess_HOOK() for myeventlane_order_detail.
 *
 * Adds buyer self-service refund eligibility and URL per event.
 */
function myeventlane_refunds_preprocess_myeventlane_order_detail(array &$variables): void {
  $order = $variables['order']['order'] ?? NULL;
  if (!$order) {
    return;
  }

  $currentUser = \Drupal::currentUser();
  if ($currentUser->isAnonymous()) {
    return;
  }

  $eligibility = \Drupal::service('myeventlane_refunds.buyer_eligibility');
  $requestStorage = \Drupal::service('myeventlane_refunds.refund_request_storage');
  $nodeStorage = \Drupal::entityTypeManager()->getStorage('node');
  $variables['order']['refund_actions'] = [];

  foreach ($variables['order']['events'] ?? [] as $key => $eventData) {
    $eventId = (int) ($eventData['id'] ?? 0);
    if (!$eventId) {
      continue;
    }

    $event = $nodeStorage->load($eventId);
    if (!$event) {
      continue;
    }

    $latestRequestRow = $requestStorage->loadLatestForBuyer(
      (int) $order->id(),
      $eventId,
      (int) $currentUser->id(),
    );
    $latestRequestStatus = is_array($latestRequestRow)
      ? (string) ($latestRequestRow['status'] ?? '')
      : '';
    $hasActiveRequest = in_array($latestRequestStatus, [
      RefundRequestStorage::STATUS_REQUESTED,
      RefundRequestStorage::STATUS_APPROVED,
    ], TRUE);
    $canRefund = !$hasActiveRequest && $eligibility->isEligible($order, $event, $currentUser);
    $variables['order']['events'][$key]['can_refund'] = $canRefund;
    $variables['order']['events'][$key]['refund_url'] = $canRefund
      ? Url::fromRoute('myeventlane_refunds.buyer_refund', [
        'commerce_order' => $order->id(),
      ], [
        'query' => ['event' => $eventId],
      ])->toString()
      : NULL;
    if (!$canRefund) {
      $variables['order']['events'][$key]['refund_ineligible_reason'] = $hasActiveRequest
        ? 'A refund request is already awaiting a final outcome.'
        : $eligibility->getIneligibilityReason($order, $event, $currentUser);
    }

    $latestRequest = $latestRequestStatus !== '' ? [
      'status' => $latestRequestStatus,
      'decision_reason' => $latestRequestStatus === RefundRequestStorage::STATUS_REJECTED
        ? trim((string) ($latestRequestRow['decision_reason'] ?? ''))
        : '',
    ] : NULL;

    $variables['order']['refund_actions'][] = [
      'event_id' => $eventId,
      'event_title' => $event->label(),
      'can_refund' => $canRefund,
      'refund_url' => $variables['order']['events'][$key]['refund_url'],
      'ineligible_reason' => $variables['order']['events'][$key]['refund_ineligible_reason'] ?? NULL,
      'latest_request' => $latestRequest,
    ];
  }
}

/**
 * Implements hook_theme().
 */
function myeventlane_refunds_theme($existing, $type, $theme, $path): array {
  return [
    'myeventlane_refunds_order_list' => [
      'variables' => [
        'orders' => [],
        'event' => NULL,
      ],
      'template' => 'myeventlane-refunds-order-list',
    ],
    'refund_status_badge' => [
      'variables' => [
        'status' => NULL,
      ],
      'template' => 'refund-status-badge',
    ],
    'mel_refund_analytics' => [
      'variables' => [
        'data' => [],
      ],
      'template' => 'mel-refund-analytics',
    ],
    'mel_refund_timeline' => [
      'variables' => [
        'items' => [],
        'variant' => 'default',
      ],
      'template' => 'mel-refund-timeline',
    ],
    'mel_vendor_refund_requests' => [
      'variables' => [
        'event' => NULL,
        'requests' => [],
        'help_url' => NULL,
        'orders_url' => NULL,
        'addon_orders_url' => NULL,
      ],
      'template' => 'mel-vendor-refund-requests',
    ],
  ];
}
