/**
 * Adds deterministic refund processing columns and backfills status state.
 */
function myeventlane_refunds_update_9009(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->tableExists('myeventlane_refund_log')) {
    return;
  }

  $fields = [
    'failure_reason' => [
      'type' => 'text',
      'not null' => FALSE,
      'description' => 'Why the refund failed, if known.',
    ],
    'updated' => [
      'type' => 'int',
      'not null' => FALSE,
      'description' => 'Unix timestamp when refund status was last updated.',
    ],
    'retry_count' => [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'How many automatic retry attempts have been scheduled.',
    ],
    'next_attempt_at' => [
      'type' => 'int',
      'not null' => FALSE,
      'description' => 'Unix timestamp when the next retry should run.',
    ],
    'retry_of' => [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Parent refund log ID when this row is a retry attempt.',
    ],
    'actual_refunded_cents' => [
      'type' => 'int',
      'not null' => TRUE,
      'default' => 0,
      'description' => 'Actual refunded amount in cents confirmed by processing.',
    ],
  ];

  foreach ($fields as $field_name => $spec) {
    if (!$schema->fieldExists('myeventlane_refund_log', $field_name)) {
      $schema->addField('myeventlane_refund_log', $field_name, $spec);
    }
  }

  $time = time();
  $rows = $database->select('myeventlane_refund_log', 'r')
    ->fields('r', ['id', 'completed', 'error_message', 'failure_reason', 'updated'])
    ->execute()
    ->fetchAllAssoc('id');

  foreach ($rows as $id => $row) {
    $status = !empty($row->completed)
      ? 'completed'
      : (!empty($row->error_message) ? 'failed' : 'processing');

    $fields_to_update = [
      'status' => $status,
    ];

    if (empty($row->failure_reason) && !empty($row->error_message)) {
      $fields_to_update['failure_reason'] = $row->error_message;
    }

    if (empty($row->updated)) {
      $fields_to_update['updated'] = $time;
    }

    $database->update('myeventlane_refund_log')
      ->fields($fields_to_update)
      ->condition('id', (int) $id)
      ->execute();
  }
}

/**
 * Adds retry and status indexes for deterministic refund processing.
 */
function myeventlane_refunds_update_9010(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->tableExists('myeventlane_refund_log')) {
    return;
  }

  $indexes = [
    'idx_refund_status_event' => ['event_id', 'status'],
    'idx_retry_schedule' => ['next_attempt_at'],
    'idx_retry_of' => ['retry_of'],
  ];

  foreach ($indexes as $name => $fields) {
    if ($schema->indexExists('myeventlane_refund_log', $name)) {
      continue;
    }

    try {
      $schema->addIndex('myeventlane_refund_log', $name, $fields, []);
    }
    catch (\Throwable) {
      // Ignore if the index already exists with a different database name.
    }
  }
}

/**
 * Adds immutable GST adjustment-note fields to confirmed refund records.
 */
function myeventlane_refunds_update_9011(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('myeventlane_refund_log')) {
    return;
  }

  $fields = [
    'adjustment_note_number' => ['type' => 'varchar', 'length' => 128, 'not null' => FALSE],
    'gst_adjustment_cents' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    'supplier_name_snapshot' => ['type' => 'varchar', 'length' => 255, 'not null' => FALSE],
    'supplier_abn_snapshot' => ['type' => 'varchar', 'length' => 14, 'not null' => FALSE],
    'adjustment_note_created' => ['type' => 'int', 'not null' => FALSE],
  ];
  foreach ($fields as $name => $spec) {
    if (!$schema->fieldExists('myeventlane_refund_log', $name)) {
      $schema->addField('myeventlane_refund_log', $name, $spec);
    }
  }
  if (!$schema->indexExists('myeventlane_refund_log', 'adjustment_note_number')) {
    $schema->addIndex(
      'myeventlane_refund_log',
      'adjustment_note_number',
      ['adjustment_note_number'],
      ['fields' => ['adjustment_note_number' => $fields['adjustment_note_number']]],
    );
  }
}

/**
 * Persists exact operational add-on quantities included in a refund.
 */
function myeventlane_refunds_update_9012(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('myeventlane_refund_log')
    || $schema->fieldExists('myeventlane_refund_log', 'operational_item_quantities_json')) {
    return;
  }
  $schema->addField('myeventlane_refund_log', 'operational_item_quantities_json', [
    'type' => 'text',
    'size' => 'big',
    'not null' => FALSE,
    'description' => 'JSON object of whole operational order item quantities explicitly included in the refund.',
  ]);
}
