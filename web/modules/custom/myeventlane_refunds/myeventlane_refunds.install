        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Scope: tickets_only, tickets_and_donation, or donation_only.',
      ],
      'amount_cents' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Refund amount in cents.',
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'aud',
        'description' => 'Currency code (ISO 4217).',
      ],
      'donation_refunded' => [
        'type' => 'int',
