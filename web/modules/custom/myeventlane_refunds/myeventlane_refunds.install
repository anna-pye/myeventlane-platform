/**
 * Add refund_request_id to myeventlane_refund_log and install messaging templates.
 */
function myeventlane_refunds_update_9001(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('myeventlane_refund_log', 'refund_request_id')) {
    $schema->addField('myeventlane_refund_log', 'refund_request_id', [
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => FALSE,
      'description' => 'Refund request ID when created from vendor approval.',
    ]);
  }

  myeventlane_refunds_install_messaging_templates();
}

/**
 * Implements hook_install().
 */
function myeventlane_refunds_install(): void {
  myeventlane_refunds_install_messaging_templates();
}

/**
 * Installs refund messaging templates if not present.
 */
function myeventlane_refunds_install_messaging_templates(): void {
  $templates = [
    'refund_requested_buyer' => [
      'subject' => 'Refund request received – {{ event_title }}',
      'preheader' => 'We received your refund request for {{ event_title }}.',
      'body' => <<<'HTML'
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
  <tr>
    <td style="padding:0 0 20px 0;">
      <h1 style="margin:0 0 8px 0;font-size:24px;line-height:1.25;font-weight:800;color:#293241;">We received your refund request</h1>
      <p style="margin:0;font-size:16px;line-height:1.55;color:#5c6370;">The organiser will review it and we’ll email you when the status changes.</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;background:#fef5ec;border-radius:12px;">
        <tr><td style="padding:16px 18px 6px;font-size:13px;line-height:1.4;color:#5c6370;text-transform:uppercase;letter-spacing:.08em;font-weight:700;">Event</td></tr>
        <tr><td style="padding:0 18px 12px;font-size:18px;line-height:1.35;color:#293241;font-weight:700;">{{ event_title }}</td></tr>
        <tr><td style="padding:0 18px 16px;font-size:15px;line-height:1.5;color:#293241;"><strong>Booking:</strong> {{ order_number }}<br><strong>Requested amount:</strong> {{ refunded_amount }}</td></tr>
      </table>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 0 20px 0;">
      <a href="{{ my_tickets_url }}" style="display:inline-block;background:#c24737;color:#ffffff !important;text-decoration:none;padding:13px 24px;border-radius:8px;font-weight:700;font-size:16px;line-height:1.25;">View booking details</a>
    </td>
  </tr>
</table>
HTML,
    ],
    'refund_requested_vendor' => [
      'subject' => 'Refund request pending – {{ event_title }}',
      'preheader' => 'A refund request for {{ event_title }} needs your review.',
      'body' => <<<'HTML'
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
  <tr>
    <td style="padding:0 0 20px 0;">
      <h1 style="margin:0 0 8px 0;font-size:24px;line-height:1.25;font-weight:800;color:#293241;">Refund request needs your review</h1>
      <p style="margin:0;font-size:16px;line-height:1.55;color:#5c6370;">A customer has requested a refund. Review the request before approving or declining it.</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;background:#fef5ec;border-radius:12px;">
        <tr><td style="padding:16px 18px 6px;font-size:13px;line-height:1.4;color:#5c6370;text-transform:uppercase;letter-spacing:.08em;font-weight:700;">Event</td></tr>
        <tr><td style="padding:0 18px 12px;font-size:18px;line-height:1.35;color:#293241;font-weight:700;">{{ event_title }}</td></tr>
        <tr><td style="padding:0 18px 16px;font-size:15px;line-height:1.5;color:#293241;"><strong>Order:</strong> {{ order_number }}<br><strong>Requested amount:</strong> {{ refunded_amount }}</td></tr>
      </table>
    </td>
  </tr>
  <tr><td style="padding:0 0 18px 0;font-size:14px;line-height:1.55;color:#5c6370;">You remain responsible for the refund decision for your event, subject to applicable law. If approved, the refunded money comes from your connected Stripe account.</td></tr>
  <tr>
    <td align="center" style="padding:0 0 20px 0;">
      <a href="{{ vendor_refund_requests_url }}" style="display:inline-block;background:#c24737;color:#ffffff !important;text-decoration:none;padding:13px 24px;border-radius:8px;font-weight:700;font-size:16px;line-height:1.25;">Review refund request</a>
    </td>
  </tr>
</table>
HTML,
    ],
    'refund_approved_buyer' => [
      'subject' => 'Refund approved – {{ event_title }}',
      'body' => 'Hi there,

Your refund for <strong>{{ event_title }}</strong> (Order {{ order_number }}) has been approved and is being processed.

Amount being refunded: {{ refunded_amount }}. After Stripe processes the refund, arrival timing depends on the original payment method and your financial institution.

<a href="{{ my_tickets_url }}">View your tickets</a>',
    ],
    'refund_approved_vendor' => [
      'subject' => 'Refund approved – {{ event_title }}',
      'body' => 'You approved the refund request for Order {{ order_number }} ({{ refunded_amount }}).

Stripe will process the refund from your connected Stripe account. Make sure sufficient funds are available and review any failure rather than promising a completion date.',
    ],
    'refund_rejected_buyer' => [
      'subject' => 'Refund request declined – {{ event_title }}',
      'body' => 'Hi there,

Your refund request for <strong>{{ event_title }}</strong> (Order {{ order_number }}) has been declined by the event organiser.

{% if rejection_reason %}
Reason: {{ rejection_reason }}
{% endif %}

This decision does not affect rights you may have under Australian Consumer Law. Contact the organiser first, or contact MyEventLane support if you cannot resolve the issue.

<a href="{{ my_tickets_url }}">View your tickets</a>',
    ],
    'refund_rejected_vendor' => [
      'subject' => 'Refund rejected – {{ event_title }}',
      'body' => 'You rejected the refund request for Order {{ order_number }}.

The buyer has been notified.',
    ],
    'refund_completed_buyer' => [
      'subject' => 'Refund completed – {{ event_title }}',
      'preheader' => 'Your {{ refunded_amount }} refund for {{ event_title }} is complete.',
      'body' => <<<'HTML'
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;">
  <tr>
    <td style="padding:0 0 20px 0;">
      <h1 style="margin:0 0 8px 0;font-size:24px;line-height:1.25;font-weight:800;color:#293241;">Your refund is complete</h1>
      <p style="margin:0;font-size:16px;line-height:1.55;color:#5c6370;">Stripe has sent the refund to your original payment method. Your bank or financial institution controls when it appears.</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 20px 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;background:#fef5ec;border-radius:12px;">
        <tr><td style="padding:16px 18px 6px;font-size:13px;line-height:1.4;color:#5c6370;text-transform:uppercase;letter-spacing:.08em;font-weight:700;">Refund summary</td></tr>
        <tr><td style="padding:0 18px 8px;font-size:18px;line-height:1.35;color:#293241;font-weight:700;">{{ event_title }}</td></tr>
        <tr><td style="padding:0 18px 16px;font-size:15px;line-height:1.55;color:#293241;"><strong>Booking:</strong> {{ order_number }}<br><strong>Amount refunded:</strong> {{ refunded_amount }}{% if tickets_cancelled and tickets_cancelled > 0 %}<br><strong>Ticket access:</strong> Cancelled for {{ tickets_cancelled }} attendee(s){% endif %}</td></tr>
      </table>
    </td>
  </tr>
  {% if adjustment_note_number %}
  <tr>
    <td style="padding:0 0 20px 0;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;background:#f7f7f8;border-left:4px solid #6b46ff;border-radius:8px;">
        <tr><td style="padding:14px 16px;font-size:14px;line-height:1.55;color:#293241;"><strong style="font-size:16px;">Adjustment note {{ adjustment_note_number }}</strong><br>Date: {{ adjustment_note_date }}<br>Supplier: {{ supplier_name }}{% if supplier_abn %}<br>ABN: {{ supplier_abn }}{% endif %}<br>Original invoice: {{ order_number }}<br>Reason: {{ adjustment_reason }}<br>GST adjustment: {{ gst_adjustment }}</td></tr>
      </table>
    </td>
  </tr>
  {% endif %}
  <tr>
    <td align="center" style="padding:0 0 24px 0;">
      <a href="{{ my_tickets_url }}" style="display:inline-block;background:#c24737;color:#ffffff !important;text-decoration:none;padding:13px 24px;border-radius:8px;font-weight:700;font-size:16px;line-height:1.25;">View refund details</a>
    </td>
  </tr>
</table>
HTML,
    ],
    'refund_completed_vendor' => [
      'subject' => 'Refund completed – {{ event_title }}',
      'body' => 'The refund for Order {{ order_number }} ({{ refunded_amount }}) has been completed.

Stripe processed the refund from your connected Stripe account. The customer has been notified.

{% if adjustment_note_number %}
Adjustment note: {{ adjustment_note_number }}
Date: {{ adjustment_note_date }}
Reason: {{ adjustment_reason }}
GST adjustment: {{ gst_adjustment }}
{% endif %}

{% if stripe_refund_id %}
Stripe refund reference: {{ stripe_refund_id }}
{% endif %}

{% if tickets_cancelled and tickets_cancelled > 0 %}
Ticket access has been cancelled for {{ tickets_cancelled }} attendee(s).
{% endif %}',
    ],
    'refund_completed_admin' => [
      'subject' => 'Refund completed (admin copy) – {{ event_title }}',
      'body' => 'A refund has completed for <strong>{{ event_title }}</strong>.

Order: {{ order_number }}
Amount: {{ refunded_amount }}

{% if stripe_refund_id %}
Stripe refund reference: {{ stripe_refund_id }}
{% endif %}

{% if tickets_cancelled and tickets_cancelled > 0 %}
Ticket access has been cancelled for {{ tickets_cancelled }} attendee(s).
{% endif %}',
    ],
    'refund_failed_buyer' => [
      'subject' => 'Refund delayed – {{ event_title }}',
      'body' => 'Hi there,

Your refund for <strong>{{ event_title }}</strong> (Order {{ order_number }}) could not be fully confirmed yet.

MyEventLane support can investigate the recorded refund state with the organiser. We\'ll email you again when there is a confirmed outcome.

Order reference: {{ order_number }}',
    ],
    'refund_failed_vendor' => [
      'subject' => 'Refund needs attention – {{ event_title }}',
      'body' => 'A refund for Order {{ order_number }} ({{ refunded_amount }}) requires review.

Reason: {{ error_message }}

Check your connected Stripe account, including whether sufficient funds are available, then retry or contact MyEventLane support with the order reference.',
    ],
    'refund_failed_admin' => [
      'subject' => 'Refund failure alert – {{ event_title }}',
      'body' => 'A refund process reported a failure and needs admin review.

Event: {{ event_title }}
Order: {{ order_number }}
Amount: {{ refunded_amount }}
Reason: {{ error_message }}

Check the MEL refund record and connected-account context. Stripe controls the payment and dispute outcome; staff must not promise to release funds or override Stripe.

{% if stripe_refund_id %}
Stripe refund reference: {{ stripe_refund_id }}
{% endif %}',
    ],
  ];

  $configFactory = \Drupal::configFactory();
  foreach ($templates as $key => $template) {
    $configName = "myeventlane_messaging.template.{$key}";
    if ($configFactory->get($configName)->isNew()) {
      $config = $configFactory->getEditable($configName);
      $config->set('enabled', TRUE);
      $config->set('subject', $template['subject']);
      if (isset($template['preheader'])) {
        $config->set('preheader', $template['preheader']);
      }
      $config->set('body_html', $template['body']);
      $config->set('utm', [
        'enable' => TRUE,
        'params' => [
          'utm_source' => 'email',
          'utm_medium' => 'transactional',
          'utm_campaign' => 'refund_' . $key,
        ],
      ]);
      $config->save();
    }
  }
}

/**
 * Ensure refund email templates exist (idempotent).
 */
function myeventlane_refunds_update_9003(): void {
  myeventlane_refunds_install_messaging_templates();
}

/**
 * Implements hook_uninstall().
 */
function myeventlane_refunds_uninstall(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('myeventlane_refund_log')) {
    $schema->dropTable('myeventlane_refund_log');
  }
  if ($schema->tableExists('myeventlane_refund_request')) {
    $schema->dropTable('myeventlane_refund_request');
  }
}

/**
 * Adds composite indexes for refund log and refund request tables.
 */
function myeventlane_refunds_update_9004(): void {
  $database = \Drupal::database();
  $schema = $database->schema();

  $tables = [
    'myeventlane_refund_log' => [
      'order_event' => ['order_id', 'event_id'],
    ],
    'myeventlane_refund_request' => [
      'order_event' => ['order_id', 'event_id'],
    ],
  ];

  foreach ($tables as $table => $indexes) {
    if (!$schema->tableExists($table)) {
      continue;
    }

    foreach ($indexes as $index_name => $fields) {

      // Drop malformed index if it exists.
      if ($schema->indexExists($table, $index_name)) {
        try {
          $schema->dropIndex($table, $index_name);
        }
        catch (\Throwable $e) {
          // Safe ignore.
        }
      }

      // Recreate composite index with explicit spec param.
      try {
        $schema->addIndex($table, $index_name, $fields, []);
      }
      catch (\Throwable $e) {
        // Ignore if already valid.
      }
    }
  }
}

/**
 * Ensure admin and failure refund templates exist.
 */
function myeventlane_refunds_update_9005(): void {
  myeventlane_refunds_install_messaging_templates();
}

/**
 * Ensure refund-completed templates include ticket cancellation messaging.
 */
function myeventlane_refunds_update_9006(): void {
  myeventlane_refunds_install_messaging_templates();

  $configFactory = \Drupal::configFactory();
  $updates = [
    'refund_completed_buyer' => 'Ticket access has been cancelled for {{ tickets_cancelled }} attendee(s).',
    'refund_completed_vendor' => 'Ticket access has been cancelled for {{ tickets_cancelled }} attendee(s).',
    'refund_completed_admin' => 'Ticket access has been cancelled for {{ tickets_cancelled }} attendee(s).',
  ];

  foreach ($updates as $templateKey => $line) {
    $configName = "myeventlane_messaging.template.{$templateKey}";
    $config = $configFactory->getEditable($configName);
    if ($config->isNew()) {
      continue;
    }

    $body = (string) ($config->get('body_html') ?? '');
    if ($body === '' || str_contains($body, 'tickets_cancelled')) {
      continue;
    }

    $body .= "\n\n{% if tickets_cancelled and tickets_cancelled > 0 %}\n{$line}\n{% endif %}";
    $config->set('body_html', $body)->save();
  }
}

