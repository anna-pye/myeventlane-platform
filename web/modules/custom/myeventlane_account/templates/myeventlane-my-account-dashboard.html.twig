{#
/**
 * @file
 * Customer My Account dashboard — attendee home (body only).
 *
 * Page shell (sidebar, workflow regions, header) comes from page--account.html.twig.
 * Booking rows and CTAs come from CustomerHubDataBuilder; hero from CustomerAccountHeroBuilder.
 */
#}

{% set hero = account_hero|default({}) %}

{% if hero is not empty %}
  {% include '@myeventlane_theme/account/mel-account-hero.html.twig' with {
    welcome: hero.welcome|default(''),
    headline: hero.headline|default(''),
    body: hero.body|default(''),
    primary_label: hero.primary_label|default(''),
    primary_url: hero.primary_url|default(''),
    secondary_label: hero.secondary_label|default(''),
    secondary_url: hero.secondary_url|default(''),
    next_booking: next_booking|default(hero.next_booking|default(null)),
    hub_user_id: hub_user_id|default(0),
    mode: hero.mode|default(''),
  } only %}
{% endif %}

{% if next_booking %}
  <section class="mel-my-account__section mel-dashboard__section mel-dashboard__section--next-booking" aria-labelledby="next-booking-title">
    <h2 id="next-booking-title" class="mel-my-account__section-title">{{ 'Next booking'|t }}</h2>
    {% include '@myeventlane_theme/account/mel-account-event-card.html.twig' with {
      event: next_booking,
      hub_user_id: hub_user_id|default(0),
      card_variant: 'next',
    } only %}
  </section>
{% endif %}

<section class="mel-my-account__section mel-dashboard__section" aria-labelledby="upcoming-bookings-title">
  <h2 id="upcoming-bookings-title" class="mel-my-account__section-title">{{ 'Upcoming bookings'|t }}</h2>
  {% if upcoming_bookings is not empty %}
    <div class="mel-my-account__cards">
      {% for event in upcoming_bookings %}
        {% include '@myeventlane_theme/account/mel-account-event-card.html.twig' with {
          event: event,
          hub_user_id: hub_user_id|default(0),
          card_variant: event.source == 'rsvp' ? 'rsvp' : 'ticket',
        } only %}
      {% endfor %}
    </div>
    <a href="{{ path('myeventlane_checkout_flow.my_tickets') }}" class="mel-my-account__view-all">{{ 'View all bookings'|t }}</a>
  {% elseif next_booking %}
    <p class="mel-my-account__empty mel-my-account__empty--inline">{{ 'This is your only upcoming booking right now.'|t }}</p>
  {% else %}
    {% if mel_account_dashboard_bookings_empty is defined and mel_account_dashboard_bookings_empty %}
      {{ mel_account_dashboard_bookings_empty }}
    {% endif %}
  {% endif %}
</section>

<section class="mel-my-account__section mel-dashboard__section mel-dashboard__section--notifications" aria-labelledby="notifications-preview-title">
  <h2 id="notifications-preview-title" class="mel-my-account__section-title">{{ 'Notifications'|t }}</h2>
  {% if notifications_preview is not empty %}
    <ul class="mel-dashboard-notifications">
      {% for row in notifications_preview %}
        <li class="mel-dashboard-notifications__item">
          {% if row.action is defined and row.action and row.action.url|default('') %}
            <a href="{{ row.action.url }}" class="mel-dashboard-notifications__link">
              <span class="mel-dashboard-notifications__title">{{ row.title }}</span>
              {% if row.message_preview %}
                <span class="mel-dashboard-notifications__preview">{{ row.message_preview }}</span>
              {% endif %}
            </a>
          {% else %}
            <div class="mel-dashboard-notifications__link mel-dashboard-notifications__link--static">
              <span class="mel-dashboard-notifications__title">{{ row.title }}</span>
              {% if row.message_preview %}
                <span class="mel-dashboard-notifications__preview">{{ row.message_preview }}</span>
              {% endif %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    {% if notifications_inbox_url %}
      <a href="{{ notifications_inbox_url }}" class="mel-my-account__view-all">{{ 'View all notifications'|t }}</a>
    {% endif %}
  {% else %}
    {% if mel_account_dashboard_notifications_empty is defined and mel_account_dashboard_notifications_empty %}
      {{ mel_account_dashboard_notifications_empty }}
    {% else %}
      <p class="mel-my-account__empty">{{ 'No new notifications right now.'|t }}</p>
      {% if notifications_inbox_url %}
        <a href="{{ notifications_inbox_url }}" class="mel-my-account__view-all">{{ 'Open notifications'|t }}</a>
      {% endif %}
    {% endif %}
  {% endif %}
</section>

<section class="mel-my-account__section mel-dashboard__section" aria-labelledby="past-bookings-title">
  <h2 id="past-bookings-title" class="mel-my-account__section-title">{{ 'Past bookings'|t }}</h2>
  {% if past_events is not empty %}
    <div class="mel-my-account__cards">
      {% for event in past_events %}
        {% set primary_review = show_review_cta and review_eligible[event.id] is defined and review_eligible[event.id] %}
        {% include '@myeventlane_theme/account/mel-account-event-card.html.twig' with {
          event: event,
          hub_user_id: hub_user_id|default(0),
          card_variant: 'past',
          show_review_cta: primary_review,
        } only %}
      {% endfor %}
    </div>
    <a href="{{ path('myeventlane_account.past_events') }}" class="mel-my-account__view-all">{{ 'View all past bookings'|t }}</a>
  {% else %}
    {% if mel_account_dashboard_past_empty is defined and mel_account_dashboard_past_empty %}
      {{ mel_account_dashboard_past_empty }}
    {% endif %}
  {% endif %}
</section>

{% if hub_quick_links is not empty %}
  <section class="mel-my-account__section mel-dashboard__section mel-dashboard__section--helpful" aria-labelledby="helpful-links-title">
    <h2 id="helpful-links-title" class="mel-my-account__section-title">{{ 'Helpful links'|t }}</h2>
    <ul class="mel-dashboard-helpful-links">
      {% for link in hub_quick_links %}
        {% if link.id not in ['my_events', 'logout'] %}
          <li>
            <a href="{{ link.url }}" class="mel-dashboard-helpful-links__link"{% if link.active|default(false) %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>
{% endif %}
