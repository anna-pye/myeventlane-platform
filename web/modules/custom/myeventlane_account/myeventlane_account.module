/**
 * Implements hook_preprocess_HOOK() for myeventlane_my_account_dashboard.
 */
function myeventlane_account_preprocess_myeventlane_my_account_dashboard(array &$variables): void {
  _myeventlane_account_add_header_vars($variables);
  if (\Drupal::hasService('myeventlane_account.account_links')) {
    $variables['hub_quick_links'] = \Drupal::service('myeventlane_account.account_links')->buildQuickActionItems();
  }
  else {
    $variables['hub_quick_links'] = [];
  }
  $variables['hub_discover_url'] = Url::fromRoute('<front>')->toString();
  try {
    $variables['hub_calendar_url'] = Url::fromRoute('view.events_calendar.page_calendar')->toString();
  }
  catch (\Throwable) {
    $variables['hub_calendar_url'] = Url::fromRoute('<front>')->toString();
  }

  if (\Drupal::moduleHandler()->moduleExists('myeventlane_notifications')
    && \Drupal::currentUser()->hasPermission('access myeventlane notifications')
    && \Drupal::hasService('myeventlane_notifications.user_inbox')
    && \Drupal::hasService('myeventlane_notifications.view_builder')) {
    try {
      $variables['notifications_inbox_url'] = Url::fromRoute('myeventlane_notifications.inbox', [], ['absolute' => FALSE])->toString();
      $uid = (int) \Drupal::currentUser()->id();
      /** @var \Drupal\myeventlane_notifications\Service\NotificationUserInboxService $inbox */
      $inbox = \Drupal::service('myeventlane_notifications.user_inbox');
      /** @var \Drupal\myeventlane_notifications\Service\NotificationViewBuilder $viewBuilder */
      $viewBuilder = \Drupal::service('myeventlane_notifications.view_builder');
      $ids = $inbox->getUnreadDeliveryIds($uid, 3, \Drupal\myeventlane_notifications\NotificationContext::publicBellContexts());
      $variables['notifications_preview'] = $viewBuilder->buildRowsForDeliveries($ids, $uid);
    }
    catch (\Throwable) {
      $variables['notifications_preview'] = [];
      $variables['notifications_inbox_url'] = '';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_my_account_past_events.
 */
function myeventlane_account_preprocess_myeventlane_my_account_past_events(array &$variables): void {
  _myeventlane_account_add_header_vars($variables);
  if (empty($variables['display_name'])) {
    $variables['display_name'] = \Drupal::currentUser()->getDisplayName();
  }
}

/**
 * Builds avatar + label data for account chrome (header dropdown, hub pages).
 *
 * Canonical image source: user.user.user_picture (Drupal core field).
 * Display name: field_display_name via DisplayNameResolver when available.
 *
 * @return array{url: string, initials: string, display_name: string, label: \Drupal\Core\StringTranslation\TranslatableMarkup|string}
 */
function _myeventlane_account_build_avatar_vars(?string $display_name_override = NULL): array {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return [
      'url' => '',
      'initials' => '',
      'display_name' => '',
      'label' => t('Account'),
    ];
  }

  if ($display_name_override !== NULL && $display_name_override !== '') {
    $display_name = $display_name_override;
  }
  elseif (\Drupal::hasService('myeventlane_core.display_name_resolver')) {
    $display_name = \Drupal::service('myeventlane_core.display_name_resolver')->getDisplayName($account);
  }
  else {
    $display_name = $account->getDisplayName();
  }

  $avatar_url = '';
  $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
  if ($user && $user->hasField('user_picture') && !$user->get('user_picture')->isEmpty()) {
    $file = $user->get('user_picture')->entity;
    if ($file instanceof FileInterface && $file->getFileUri()) {
      $uri = $file->getFileUri();
      $file_system = \Drupal::service('file_system');
      $real_path = $file_system->realpath($uri);
      if ($real_path && is_readable($real_path)) {
        $avatar_url = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
      }
    }
  }

  $initials = _myeventlane_account_get_initials($display_name);
  if ($initials === '' && $account->getAccountName() !== '') {
    $initials = _myeventlane_account_get_initials($account->getAccountName());
  }

  return [
    'url' => $avatar_url,
    'initials' => $initials,
    'display_name' => $display_name,
    'label' => $display_name,
  ];
}

/**
 * Adds logo and avatar variables for My Account header.
 */
function _myeventlane_account_add_header_vars(array &$variables): void {
  $extension_list = \Drupal::service('extension.list.theme');
  $theme_path = $extension_list->getPath('myeventlane_theme');
  $base_path = \Drupal::request()->getBasePath();
  $variables['logo_url'] = $base_path . '/' . $theme_path . '/images/logo.svg';

  $avatar = _myeventlane_account_build_avatar_vars($variables['display_name'] ?? NULL);
  $variables['avatar_url'] = $avatar['url'];
  $variables['avatar_initials'] = $avatar['initials'];
}

/**
 * Derives initials from display name (max 2 chars).
 */
function _myeventlane_account_get_initials(string $name): string {
  $name = trim($name);
  if ($name === '') {
    return '';
  }
  $words = preg_split('/\s+/', $name, 2);
  if (count($words) === 1) {
    return mb_strtoupper(mb_substr($words[0], 0, 2));
  }
  return mb_strtoupper(mb_substr($words[0], 0, 1) . mb_substr($words[1], 0, 1));
}

/**
 * Implements hook_menu_links_discovery_alter().
 *
 * Points "My account" in the account menu to our dashboard instead of /user.
 */
function myeventlane_account_menu_links_discovery_alter(array &$links): void {
  if (isset($links['user.page'])) {
    $links['user.page']['route_name'] = 'myeventlane_account.dashboard';
    $links['user.page']['route_parameters'] = [];
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 *
 * Adds page__account suggestion for customer account pages so they use
 * the account layout with sidebar.
 */
function myeventlane_account_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if (MelCustomerRouteCatalog::isAccountPageShellRoute($route)) {
    $suggestions[] = 'page__account';
  }
}

/**
 * Implements hook_preprocess_page() for page__account.
 *
 * Adds account sidebar variables for customer account pages.
 */
function myeventlane_account_preprocess_page__account(array &$variables): void {
  $variables['account_settings_compact_header'] = FALSE;
  $variables['account_header_actions'] = [];
  $variables['account_payment_method_notice'] = [];
  $account = \Drupal::currentUser();
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Route-specific H1 applies even when the viewer is anonymous (e.g. order detail
  // from email links) so the shell never renders "Welcome, @name!" with a null name.
  $heading = _myeventlane_account_page_heading($route_name);
  if ($heading !== NULL) {
    $variables['account_heading'] = $heading;
  }

  $description = _myeventlane_account_page_description($route_name);
  if ($description !== NULL) {
    $variables['account_page_description'] = $description;
  }

  if ($account->isAnonymous()) {
    return;
  }

  $variables['account_header_actions'] = _myeventlane_account_payment_method_header_actions($route_name, $account);
  $variables['account_payment_method_notice'] = _myeventlane_account_payment_method_notice($route_name, $account);

  $variables['account_settings_compact_header'] = in_array($route_name, [
    'myeventlane_account.settings',
    'myeventlane_account.settings_redirect',
  ], TRUE);

  $account_links_service = \Drupal::service('myeventlane_account.account_links');

  $variables['account_show_sidebar'] = TRUE;
  $all_links = $account_links_service->buildNavigationItems();
  $sidebar_links = array_values(array_filter($all_links, static function (array $link): bool {
    return !empty($link['show_in_sidebar']);
  }));
  $variables['account_links'] = $sidebar_links;
  if (\Drupal::hasService('myeventlane_core.display_name_resolver')) {
    $variables['display_name'] = \Drupal::service('myeventlane_core.display_name_resolver')->getDisplayName($account);
  }
  else {
    $variables['display_name'] = $account->getDisplayName();
  }

  $variables['account_show_header_logo'] = $route_name === 'myeventlane_account.dashboard';

  if (\Drupal::hasService('myeventlane_surface.navigation_manager')) {
    $variables['mel_account_shell_nav'] = [
      '#theme' => 'mel_shell_nav',
      '#links' => $sidebar_links,
      '#contract' => \Drupal::service('myeventlane_surface.navigation_manager')->getContract(),
    ];
  }

  _myeventlane_account_add_header_vars($variables);
}

/**
 * Explains the boundary between checkout cards and MEL Pro billing.
 */
function _myeventlane_account_payment_method_notice(?string $route_name, AccountInterface $account): array {
  if (!in_array($route_name, [
    'entity.commerce_payment_method.collection',
    'entity.commerce_payment_method.add_form',
    'entity.commerce_payment_method.edit_form',
    'entity.commerce_payment_method.delete_form',
  ], TRUE) || $account->isAnonymous()) {
    return [];
  }

  $notice = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['mel-account-payment-methods__scope-notice', 'mel-alert', 'mel-alert--info'],
      'role' => 'note',
    ],
    'title' => [
      '#markup' => '<strong>' . t('Checkout payment methods') . '</strong>',
    ],
    'message' => [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => t('Cards saved here belong to your general MyEventLane payment account. They do not change the card used for MEL Pro.'),
    ],
  ];

  if ($account->hasRole('vendor') || $account->hasRole('administrator')) {
    $notice['pro_link'] = [
      '#type' => 'link',
      '#title' => t('Manage MEL Pro billing'),
      '#url' => Url::fromRoute('myeventlane_pro.manage'),
      '#attributes' => [
        'class' => ['button', 'button--small'],
      ],
    ];
  }

  return $notice;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function myeventlane_account_form_commerce_payment_method_add_form_alter(array &$form, FormStateInterface $form_state): void {
  $gateway_id = (string) ($form_state->get('payment_gateway') ?? '');
  if ($gateway_id === '') {
    return;
  }

  $gateway = \Drupal::entityTypeManager()->getStorage('commerce_payment_gateway')->load($gateway_id);
  if (!$gateway instanceof PaymentGatewayInterface || $gateway->getPluginId() !== 'stripe') {
    return;
  }

  $configuration = $gateway->getPlugin()->getConfiguration();
  if (_myeventlane_account_stripe_gateway_has_client_key($configuration)) {
    return;
  }

  $form['payment_method_configuration_error'] = [
    '#type' => 'container',
    '#weight' => -100,
    '#attributes' => [
      'class' => ['mel-alert', 'mel-alert--error'],
      'role' => 'alert',
    ],
    'message' => [
      '#markup' => t('Adding a checkout payment method is temporarily unavailable. No card details have been collected. Please try again later or contact support.'),
    ],
  ];
  $form['actions']['submit_payment_method']['#disabled'] = TRUE;

  \Drupal::logger('myeventlane_account')->error('Saved payment-method form blocked because Stripe gateway @gateway has no publishable key.', [
    '@gateway' => $gateway_id,
  ]);
}

/**
 * Returns whether a Stripe gateway has the public client key Stripe.js needs.
 */
function _myeventlane_account_stripe_gateway_has_client_key(array $configuration): bool {
  return trim((string) ($configuration['publishable_key'] ?? '')) !== '';
}

/**
 * Builds route-specific actions for the saved payment-method account surface.
 */
function _myeventlane_account_payment_method_header_actions(?string $route_name, AccountInterface $account): array {
  if ($route_name !== 'entity.commerce_payment_method.collection' || $account->isAnonymous()) {
    return [];
  }

  return [
    'add_payment_method' => [
      '#type' => 'link',
      '#title' => t('Add payment method'),
      '#url' => Url::fromRoute('entity.commerce_payment_method.add_form', [
        'user' => $account->id(),
      ]),
      '#attributes' => [
        'class' => ['button', 'button--primary', 'mel-my-account__header-action'],
      ],
    ],
  ];
}

/**
 * Single H1 title per hub route (page shell); body templates must not repeat H1.
 */
function _myeventlane_account_page_heading(?string $route_name) {
  return match ($route_name) {
    'myeventlane_account.dashboard' => t('Dashboard'),
    'myeventlane_account.past_events' => t('Past bookings'),
    'myeventlane_account.settings', 'myeventlane_account.settings_redirect' => t('Settings'),
    'myeventlane_checkout_flow.my_tickets' => t('My bookings'),
    'myeventlane_checkout_flow.order_detail' => t('Your booking'),
    'myeventlane_checkout_flow.order_tax_invoice_pdf' => t('Payment receipt'),
    'view.mel_saved_events.page_1' => t('Saved events'),
    'myeventlane_account.followed_organisers' => t('Your organisers'),
    'myeventlane_notifications.inbox' => t('Notifications'),
    'myeventlane_notifications.preferences' => t('Notification preferences'),
    'myeventlane_core.my_categories' => t('Your communities'),
    'myeventlane_rsvp.user_list' => t('RSVPs'),
    'entity.commerce_payment_method.collection' => t('Saved payment methods'),
    'entity.commerce_payment_method.add_form' => t('Add a payment method'),
    'entity.commerce_payment_method.edit_form' => t('Update payment method'),
    'entity.commerce_payment_method.delete_form' => t('Remove payment method'),
    default => NULL,
  };
}

/**
 * Optional lede copy for hub routes (page shell); body templates must not repeat.
 */
function _myeventlane_account_page_description(?string $route_name) {
  return match ($route_name) {
    'myeventlane_account.past_events' => t('Events you have already attended.'),
    'myeventlane_account.settings', 'myeventlane_account.settings_redirect' => t('Personal details, sign-in security, and how we stay in touch.'),
    'myeventlane_checkout_flow.my_tickets' => t('Manage bookings, download tickets, and access your events.'),
    'myeventlane_checkout_flow.order_detail' => t('Booking details, tickets, and receipts for this booking.'),
    'myeventlane_account.dashboard' => t('Your upcoming plans, tickets and updates in one place.'),
    'view.mel_saved_events.page_1' => t('Events you want to revisit later.'),
    'myeventlane_account.followed_organisers' => t('See events from organisers you follow.'),
    'myeventlane_notifications.inbox' => t('Ticket confirmations and important updates, organised for you.'),
    'myeventlane_notifications.preferences' => t('Choose how and when we reach you.'),
    'myeventlane_core.my_categories' => t('Stay connected with the categories you follow.'),
    'myeventlane_rsvp.user_list' => t('Events you have RSVP’d to.'),
    'entity.commerce_payment_method.collection' => t('Manage payment methods saved securely with Stripe for eligible non-Pro payments.'),
    'entity.commerce_payment_method.add_form' => t('Save a payment method securely with Stripe. MyEventLane does not store your full card details.'),
    'entity.commerce_payment_method.edit_form' => t('Update the billing details associated with this saved payment method.'),
    'entity.commerce_payment_method.delete_form' => t('Review the payment method before removing it from your account.'),
    default => NULL,
  };
}

/**
 * Implements hook_preprocess_HOOK() for mel_notification_inbox.
 */
function myeventlane_account_preprocess_mel_notification_inbox(array &$variables): void {
  $variables['in_account_shell'] = TRUE;
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function myeventlane_account_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view === NULL || $view->id() !== 'mel_saved_events') {
    return;
  }
  if ($variables['attributes'] instanceof Attribute) {
    $variables['attributes']->addClass('mel-collection-page', 'mel-collection-page--saved-events');
  }
  else {
    $variables['attributes']['class'][] = 'mel-collection-page';
    $variables['attributes']['class'][] = 'mel-collection-page--saved-events';
  }
  $variables['#attached']['library'][] = 'flag/link_ajax';
}

/**
 * Implements hook_preprocess_HOOK() for views_view_unformatted.
 */
function myeventlane_account_preprocess_views_view_unformatted(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view === NULL || $view->id() !== 'mel_saved_events') {
    return;
  }

  /** @var \Drupal\myeventlane_account\Service\CustomerHubDataBuilder $builder */
  $builder = \Drupal::service('myeventlane_account.customer_hub_data_builder');
  $rows = [];
  foreach ($view->result as $delta => $row) {
    $entity = $row->_entity ?? NULL;
    if (!$entity instanceof NodeInterface || $entity->bundle() !== 'event') {
      $rows[$delta] = $variables['rows'][$delta] ?? ['#markup' => ''];
      continue;
    }
    $rows[$delta] = [
      '#theme' => 'mel_account_event_card',
      '#event' => $builder->buildHubEventFromNode($entity, 'saved'),
      '#card_variant' => 'saved',
      '#event_save_flag' => $builder->buildEventSaveFlagLink((int) $entity->id()),
      '#cache' => [
        'tags' => array_merge($entity->getCacheTags(), ['flag.flag.event_save']),
        'contexts' => ['user'],
      ],
    ];
  }
  $variables['rows'] = $rows;
}

/**
 * Replaces the account menu tree for authenticated users with canonical hub IA.
 */
function myeventlane_account_preprocess_menu__account(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'account') {
    return;
  }

  $variables['mel_account_avatar'] = _myeventlane_account_build_avatar_vars();

  $account = \Drupal::currentUser();
  if (!$account->isAuthenticated()) {
    return;
  }

  $nav = \Drupal::service('myeventlane_account.account_links')->buildNavigationItems();
  $items = [];
  foreach ($nav as $link) {
    $path = $link['url'];
    try {
      $url = Url::fromUserInput($path);
    }
    catch (\Throwable) {
      $url = Url::fromUri('internal:' . $path);
    }
    $items['mel-hub-' . $link['id']] = [
      'title' => $link['title'],
      'url' => $url,
      'in_active_trail' => !empty($link['active']),
      'attributes' => new Attribute(),
      'below' => [],
    ];
  }
  $variables['items'] = $items;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function myeventlane_account_form_user_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $is_customer_settings = ($route_name === 'myeventlane_account.settings');

  // Path aliases are an operator concern; hide only on the customer settings route.
  if ($is_customer_settings && isset($form['path'])) {
    $form['path']['#access'] = FALSE;
  }

  // Pronouns placeholder (helper text comes from field config).
  if (isset($form['field_pronouns']['widget'][0]['value'])) {
    $form['field_pronouns']['widget'][0]['value']['#attributes']['placeholder'] = 'e.g. they/them, she/her, he/him';
  }

  $form['#attributes']['class'][] = 'mel-account-user-form';

  if ($is_customer_settings) {
    $form['#attributes']['class'][] = 'mel-account-settings-form';
    _myeventlane_account_customer_settings_form_alter($form, $form_state);
    return;
  }

  foreach (['account', 'locale', 'timezone', 'contact'] as $group_key) {
    if (isset($form[$group_key]) && is_array($form[$group_key])) {
      $form[$group_key]['#attributes']['class'][] = 'mel-account-settings__group';
    }
  }
}

/**
 * Customer /my-settings/{user} only: section cards, labels, and privileged field suppression.
 *
 * Preserves user entity form submit/validate by keeping original #parents on moved elements.
 */
function _myeventlane_account_customer_settings_form_alter(array &$form, FormStateInterface $form_state): void {
  $is_first_use_setup = _myeventlane_account_is_first_use_setup($form, $form_state);

  if (isset($form['account']['roles'])) {
    $form['account']['roles']['#access'] = FALSE;
  }
  // Commerce store ownership is managed through Organiser Studio. It is an
  // internal relationship and must not leak into the customer settings UI.
  if (isset($form['field_vendor_store'])) {
    $form['field_vendor_store']['#access'] = FALSE;
  }

  if (isset($form['account']['name'])) {
    $form['account']['name']['#title'] = t('Sign-in username');
    $form['account']['name']['#description'] = t('Your unique username for signing in.');
    if ($is_first_use_setup) {
      $form['account']['name']['#access'] = FALSE;
    }
  }
  if (isset($form['account']['mail'])) {
    $form['account']['mail']['#title'] = $is_first_use_setup ? t('Sign-in email') : t('Email');
    $form['account']['mail']['#description'] = $is_first_use_setup
      ? t('Your verified email for signing in, bookings, and receipts.')
      : t('Used for bookings, receipts, and updates you opt into.');
    if ($is_first_use_setup) {
      $form['account']['mail']['#attributes']['readonly'] = 'readonly';
      $form['account']['mail']['#attributes']['aria-readonly'] = 'true';
    }
  }
  if (isset($form['account']['current_pass'])) {
    $form['account']['current_pass']['#description'] = t('Required when you change your email or password.');
  }
  if (isset($form['account']['pass'])) {
    $form['account']['pass']['#description'] = $form_state->get('user_pass_reset')
      ? t('Choose a strong password and enter it twice.')
      : t('Leave blank to keep your current password.');
  }

  $card_attr = ['class' => ['mel-account-settings__card', 'mel-account-settings__section']];

  $form['mel_settings_profile'] = [
    '#type' => 'container',
    '#attributes' => $card_attr + [
      'aria-labelledby' => 'mel-settings-profile-title',
      'data-mel-settings-card' => 'profile',
    ],
    '#weight' => -200,
  ];
  $form['mel_settings_profile']['_title'] = [
    '#type' => 'html_tag',
    '#tag' => 'h2',
    '#value' => t('Profile'),
    '#attributes' => [
      'id' => 'mel-settings-profile-title',
      'class' => ['mel-account-settings__heading'],
    ],
    '#weight' => -50,
  ];

  _myeventlane_account_group_entity_fields(
    $form,
    ['field_display_name', 'user_picture', 'field_pronouns', 'field_city'],
    'mel_settings_profile',
  );

  if ($is_first_use_setup && isset($form['field_display_name']['widget'][0]['value'])) {
    $form['field_display_name']['widget'][0]['value']['#required'] = TRUE;
  }

  $form['mel_settings_security'] = [
    '#type' => 'container',
    '#attributes' => $card_attr + [
      'aria-labelledby' => 'mel-settings-security-title',
      'data-mel-settings-card' => 'security',
    ],
    '#weight' => -190,
  ];
  $form['mel_settings_security']['_title'] = [
    '#type' => 'html_tag',
    '#tag' => 'h2',
    '#value' => t('Account & security'),
    '#attributes' => [
      'id' => 'mel-settings-security-title',
      'class' => ['mel-account-settings__heading'],
    ],
    '#weight' => -50,
  ];

  if ($form_state->get('user_pass_reset')) {
    $form['#attributes']['data-mel-password-setup'] = 'true';
    $form['mel_settings_security']['_password_setup_notice'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['mel-account-settings__setup-notice'],
        'role' => 'status',
      ],
      '#weight' => -40,
      'message' => [
        '#markup' => '<p>' . t('Choose and confirm your new password to continue. You do not need to enter a current password.') . '</p>',
      ],
    ];
  }

  if ($is_first_use_setup) {
    $form['#attributes']['data-mel-account-setup'] = 'true';
  }

  _myeventlane_account_group_nested_fields(
    $form,
    'account',
    ['mail', 'name', 'current_pass', 'pass'],
    'mel_settings_security',
  );

  _myeventlane_account_group_entity_fields(
    $form,
    ['social_auth'],
    'mel_settings_security',
  );

  try {
    $reset_url = Url::fromRoute('user.pass');
    $reset_link = Link::fromTextAndUrl(t('Email me a password reset link'), $reset_url)->toRenderable();
    $reset_link['#weight'] = 40;
    if (!isset($reset_link['#attributes']) || !is_array($reset_link['#attributes'])) {
      $reset_link['#attributes'] = [];
    }
    $reset_link['#attributes']['class'][] = 'mel-account-settings__inline-link';
    if (!$form_state->get('user_pass_reset')) {
      $form['mel_settings_security']['_reset_link'] = $reset_link;
    }
  }
  catch (\Throwable) {
  }

  $prefs_link = [];
  try {
    $prefs_link = [
      '#type' => 'link',
      '#title' => t('Open notification preferences'),
      '#url' => Url::fromRoute('myeventlane_notifications.preferences'),
      '#attributes' => ['class' => ['mel-account-settings__inline-link']],
      '#weight' => 30,
    ];
  }
  catch (\Throwable) {
  }

  if (isset($form['contact']) || $prefs_link !== []) {
    $form['mel_settings_notifications'] = [
      '#type' => 'container',
      '#attributes' => $card_attr + [
        'aria-labelledby' => 'mel-settings-notify-title',
        'data-mel-settings-card' => 'notifications',
      ],
      '#weight' => -180,
    ];
    $form['mel_settings_notifications']['_title'] = [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('Notifications'),
      '#attributes' => [
        'id' => 'mel-settings-notify-title',
        'class' => ['mel-account-settings__heading'],
      ],
      '#weight' => -50,
    ];

    if (isset($form['contact'])) {
      $element = $form['contact'];
      unset($form['contact']);
      $element['#parents'] = ['contact'];
      $form['mel_settings_notifications']['contact'] = $element;
    }

    if ($prefs_link !== []) {
      $form['mel_settings_notifications']['prefs_link'] = $prefs_link;
    }
  }

  $form['mel_settings_preferences'] = [
    '#type' => 'container',
    '#attributes' => $card_attr + [
      'aria-labelledby' => 'mel-settings-prefs-title',
      'data-mel-settings-card' => 'preferences',
    ],
    '#weight' => -170,
  ];
  $form['mel_settings_preferences']['_title'] = [
    '#type' => 'html_tag',
    '#tag' => 'h2',
    '#value' => t('Preferences'),
    '#attributes' => [
      'id' => 'mel-settings-prefs-title',
      'class' => ['mel-account-settings__heading'],
    ],
    '#weight' => -50,
  ];

  $form['mel_settings_preferences']['_region_note'] = [
    '#type' => 'html_tag',
    '#tag' => 'h3',
    '#value' => t('Language & region'),
    '#attributes' => ['class' => ['mel-account-settings__subheading']],
    '#weight' => -40,
  ];

  if (isset($form['language'])) {
    $element = $form['language'];
    unset($form['language']);
    $element['#parents'] = ['language'];
    $element['#type'] = 'container';
    unset($element['#title']);
    if (isset($element['preferred_admin_langcode'])) {
      $element['preferred_admin_langcode']['#access'] = FALSE;
    }
    if (isset($element['preferred_langcode'])) {
      $element['preferred_langcode']['#description'] = t('Emails and on-site wording follow this preference where available.');
    }
    $form['mel_settings_preferences']['language'] = $element;
  }

  if (isset($form['timezone'])) {
    $element = $form['timezone'];
    unset($form['timezone']);
    $element['#parents'] = ['timezone'];
    $element['#type'] = 'container';
    unset($element['#title']);
    if (isset($element['timezone']) && is_array($element['timezone'])) {
      $element['timezone']['#description'] = t('Event times and reminders use this zone.');
    }
    $form['mel_settings_preferences']['timezone'] = $element;
  }

  _myeventlane_account_group_entity_fields(
    $form,
    ['field_accessibility_preferences'],
    'mel_settings_preferences',
  );
  if (isset($form['field_accessibility_preferences']['#attributes']['class'])) {
    $classes = &$form['field_accessibility_preferences']['#attributes']['class'];
    $classes = is_array($classes) ? $classes : [$classes];
    $classes[] = 'mel-account-settings__accessibility';
  }
  elseif (isset($form['field_accessibility_preferences'])) {
    $form['field_accessibility_preferences']['#attributes']['class'] = ['mel-account-settings__accessibility'];
  }

  $prefs_more = _myeventlane_account_customer_settings_preference_links();
  if ($prefs_more !== []) {
    $form['mel_settings_preferences']['_discover'] = [
      '#type' => 'html_tag',
      '#tag' => 'h3',
      '#value' => t('Discover'),
      '#attributes' => ['class' => ['mel-account-settings__subheading']],
      '#weight' => 35,
    ];
    $form['mel_settings_preferences']['prefs_more'] = $prefs_more + ['#weight' => 36];
  }

  $support = _myeventlane_account_customer_settings_support_section();
  if ($support !== []) {
    $form['mel_settings_support'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['mel-account-settings__card', 'mel-account-settings__support'],
        'aria-labelledby' => 'mel-settings-support-title',
      ],
      '#weight' => -160,
    ];
    $form['mel_settings_support']['_title'] = [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('Support'),
      '#attributes' => [
        'id' => 'mel-settings-support-title',
        'class' => ['mel-account-settings__heading'],
      ],
      '#weight' => -50,
    ];
    $form['mel_settings_support']['body'] = $support + ['#weight' => 0];
  }

  if (isset($form['actions'])) {
    $form['actions']['#weight'] = 200;
    $form['actions']['#attributes']['class'][] = 'mel-account-settings__actions';
    $form['actions']['#attributes']['aria-live'] = 'polite';
    if ($is_first_use_setup && isset($form['actions']['submit'])) {
      $form['actions']['submit']['#value'] = t('Finish account setup');
    }
  }
}

/**
 * Whether this user form is the explicit first-use account setup journey.
 */
function _myeventlane_account_is_first_use_setup(array $form, FormStateInterface $form_state): bool {
  if (!$form_state->get('user_pass_reset')) {
    return FALSE;
  }

  $form_object = $form_state->getFormObject();
  if (!is_object($form_object) || !method_exists($form_object, 'getEntity')) {
    return FALSE;
  }
  $account = $form_object->getEntity();
  if (!$account instanceof \Drupal\user\UserInterface || $account->id() === NULL) {
    return FALSE;
  }

  $request = \Drupal::request();
  return $request->hasSession()
    && (string) $request->getSession()->get('mel_account_setup_uid') === (string) $account->id();
}

/**
 * Visually groups top-level entity fields without breaking value extraction.
 *
 * EntityFormDisplay expects configurable field widgets to remain at their
 * original top-level keys when it extracts submitted values. Drupal's #group
 * API renders those same elements inside the requested card while preserving
 * their form structure and #parents.
 *
 * @param array<string, mixed> $form
 *   The complete user entity form.
 * @param string[] $field_keys
 *   Top-level form element keys to group when present.
 * @param string $group
 *   The top-level container key that should render the elements.
 */
function _myeventlane_account_group_entity_fields(array &$form, array $field_keys, string $group): void {
  foreach ($field_keys as $key) {
    if (!isset($form[$key]) || !is_array($form[$key])) {
      continue;
    }

    $form[$key]['#group'] = $group;
  }
}

/**
 * Visually groups nested controls while preserving their submitted values.
 *
 * Drupal's user account container is not a tree, so controls such as mail and
 * name submit as top-level values. Moving them and assigning new #parents
 * changes those values to account[mail] and account[name], which prevents the
 * core user form from validating and saving the entity.
 *
 * @param array<string, mixed> $form
 *   The complete user entity form.
 * @param string $parent_key
 *   The original parent container key.
 * @param string[] $field_keys
 *   Child form element keys to group when present.
 * @param string $group
 *   The top-level container key that should render the elements.
 */
function _myeventlane_account_group_nested_fields(array &$form, string $parent_key, array $field_keys, string $group): void {
  foreach ($field_keys as $key) {
    if (!isset($form[$parent_key][$key]) || !is_array($form[$parent_key][$key])) {
      continue;
    }

    $form[$parent_key][$key]['#group'] = $group;
  }
}

/**
 * Quick links for preferences (categories, saved events).
 *
 * @return array<string, mixed>
 */
function _myeventlane_account_customer_settings_preference_links(): array {
  if (!\Drupal::hasService('myeventlane_account.account_links')) {
    return [];
  }
  /** @var \Drupal\myeventlane_account\Service\AccountLinksService $svc */
  $svc = \Drupal::service('myeventlane_account.account_links');
  $nav = $svc->buildNavigationItems();
  $by_id = [];
  foreach ($nav as $item) {
    $by_id[$item['id'] ?? ''] = $item;
  }
  $render_links = [];
  foreach ([
    'categories' => t('Manage categories'),
    'saved_events' => t('Saved events'),
    'followed_organisers' => t('Followed organisers'),
  ] as $id => $label) {
    if (empty($by_id[$id]['url'])) {
      continue;
    }
    try {
      $render_links[] = Link::fromTextAndUrl($label, Url::fromUserInput($by_id[$id]['url']))->toRenderable();
    }
    catch (\Throwable) {
    }
  }
  if ($render_links === []) {
    return [];
  }
  return [
    '#theme' => 'item_list',
    '#items' => $render_links,
    '#attributes' => ['class' => ['mel-account-settings__support-list', 'mel-account-settings__prefs-links']],
  ];
}

/**
 * Support links for the settings hub (help + tickets).
 *
 * @return array<string, mixed>
 */
function _myeventlane_account_customer_settings_support_section(): array {
  if (!\Drupal::hasService('myeventlane_account.account_links')) {
    return [];
  }
  $nav = \Drupal::service('myeventlane_account.account_links')->buildNavigationItems();
  $by_id = [];
  foreach ($nav as $item) {
    $by_id[$item['id'] ?? ''] = $item;
  }
  $render_links = [];
  if (!empty($by_id['support']['url'])) {
    try {
      $render_links[] = Link::fromTextAndUrl(t('Contact support'), Url::fromUserInput($by_id['support']['url']))->toRenderable();
    }
    catch (\Throwable) {
    }
  }
  try {
    $render_links[] = Link::fromTextAndUrl(t('Help centre'), Url::fromRoute('help.main'))->toRenderable();
  }
  catch (\Throwable) {
  }

  if ($render_links === []) {
    return [];
  }

  return [
    '#theme' => 'item_list',
    '#items' => $render_links,
    '#attributes' => ['class' => ['mel-account-settings__support-list']],
  ];
}
