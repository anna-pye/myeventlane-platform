<?php

declare(strict_types=1);

/**
 * @file
 * Ticket type entity hooks for MyEventLane.
 */

use Drupal\user\Entity\Role;

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function mel_ticket_mel_ticket_type_presave(\Drupal\mel_ticket\Entity\TicketType $entity): void {
  // Extra invariant: reusable tickets must not pin a single event on the ticket.
  if ($entity->isReusable() && !$entity->get('event')->isEmpty()) {
    $entity->set('event', NULL);
  }
}

/**
 * Implements hook_install().
 */
function mel_ticket_install(): void {
  foreach (['vendor', 'pro_organiser'] as $rid) {
    $role = Role::load($rid);
    if (!$role) {
      continue;
    }
    foreach ([
      'create mel_ticket_type entities',
      'edit own mel_ticket_type entities',
      'delete own mel_ticket_type entities',
      'reuse mel_ticket_type entities',
      'assign mel_ticket_type entities',
      'view mel_ticket_type entities',
    ] as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}
