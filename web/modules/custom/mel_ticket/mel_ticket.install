/**
 * Deletes ticket_type_config paragraph entities so config import can remove the type.
 *
 * Run `drush updb` then `drush cim`. Clears event field_ticket_types (if still
 * paragraph-based) then deletes all paragraph entities. Ticket data is discarded.
 */
function mel_ticket_update_9003(): string {
  if (!\Drupal::entityTypeManager()->hasDefinition('paragraph')) {
    return 'Paragraphs module not enabled; nothing to purge.';
  }

  $field = FieldConfig::loadByName('node', 'event', 'field_ticket_types');
  $events_cleared = 0;
  if ($field && $field->getType() === 'entity_reference_revisions') {
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $query = $node_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'event')
      ->exists('field_ticket_types')
      ->execute();
    foreach ($node_storage->loadMultiple($query) as $node) {
      $node->set('field_ticket_types', []);
      $node->save();
      $events_cleared++;
    }
  }

  $para_storage = \Drupal::entityTypeManager()->getStorage('paragraph');
  $ids = $para_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'ticket_type_config')
    ->execute();
  $para_count = 0;
  if ($ids) {
    $entities = $para_storage->loadMultiple($ids);
    $para_storage->delete($entities);
    $para_count = count($entities);
  }

  $total = $events_cleared + $para_count;
  return $total > 0
    ? sprintf('Purged %d ticket_type_config paragraph(s) and cleared %d event(s). Run `drush cim`.', $para_count, $events_cleared)
    : 'No ticket_type_config paragraphs found. Run `drush cim`.';
}
