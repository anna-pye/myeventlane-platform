<?php

declare(strict_types=1);

/**
 * @file
 * Install and update hooks for MEL Ticket.
 */

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function mel_ticket_install(): void {
  mel_ticket_grant_default_role_permissions();
}

/**
 * Grants ticket permissions to vendor-facing roles when present.
 */
function mel_ticket_grant_default_role_permissions(): void {
  foreach (['vendor', 'mel_pro'] as $rid) {
    $role = Role::load($rid);
    if (!$role) {
      continue;
    }
    foreach ([
      'create mel_ticket_type entities',
      'edit own mel_ticket_type entities',
      'delete own mel_ticket_type entities',
      'reuse mel_ticket_type entities',
      'assign mel_ticket_type entities',
      'view mel_ticket_type entities',
    ] as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}

/**
 * Drops legacy paragraph-based field_ticket_types storage on node.
 *
 * Drupal cannot change field storage type in place. After this runs, import
 * config (drush cim) to create entity_reference → mel_ticket_type storage.
 */
function mel_ticket_update_9001(): string {
  $storage = FieldStorageConfig::loadByName('node', 'field_ticket_types');
  if (!$storage) {
    return 'No node.field_ticket_types storage; nothing to remove. Run cim if the field is still missing.';
  }

  if ($storage->getType() === 'entity_reference' && $storage->getSetting('target_type') === 'mel_ticket_type') {
    return 'node.field_ticket_types already targets mel_ticket_type.';
  }

  if ($storage->getType() !== 'entity_reference_revisions') {
    return sprintf(
      'node.field_ticket_types has type %s (expected entity_reference_revisions for migration). Remove or rename it manually before running cim.',
      $storage->getType()
    );
  }

  $field = FieldConfig::load('node.event.field_ticket_types');
  if ($field) {
    $field->delete();
  }

  $storage = FieldStorageConfig::loadByName('node', 'field_ticket_types');
  if ($storage) {
    $storage->delete();
  }

  return 'Removed legacy paragraph field_ticket_types on node. Run `drush cim` to add the mel_ticket_type reference field.';
}

/**
 * Adds template_source (clone lineage) to ticket types.
 */
function mel_ticket_update_9002(): string {
  $entity_type = \Drupal::entityTypeManager()->getDefinition('mel_ticket_type');
  $field = \Drupal\mel_ticket\Entity\TicketType::baseFieldDefinitions($entity_type)['template_source'];
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'template_source',
    'mel_ticket_type',
    'mel_ticket',
    $field
  );
  return 'Installed mel_ticket_type.template_source for wizard template cloning.';
}

/**
 * Adds visibility, waitlist, and group-sale fields on ticket types.
 */
function mel_ticket_update_9004(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('mel_ticket_type');
  $fields = \Drupal\mel_ticket\Entity\TicketType::baseFieldDefinitions($entity_type);
  $names = [
    'visibility_mode',
    'hidden_label',
    'waitlist_enabled',
    'waitlist_capacity',
    'auto_promote_waitlist',
    'group_sale_mode',
    'group_min_size',
    'group_bundle_size',
  ];
  $installed = [];
  foreach ($names as $name) {
    if (!isset($fields[$name])) {
      continue;
    }
    try {
      $update_manager->installFieldStorageDefinition(
        $name,
        'mel_ticket_type',
        'mel_ticket',
        $fields[$name]
      );
      $installed[] = $name;
    }
    catch (\Throwable $e) {
      \Drupal::logger('mel_ticket')->warning(
        'Could not install field @field on mel_ticket_type: @message',
        ['@field' => $name, '@message' => $e->getMessage()]
      );
    }
  }
  return $installed === []
    ? 'No new mel_ticket_type fields installed (may already exist).'
    : 'Installed mel_ticket_type fields: ' . implode(', ', $installed);
}

/**
 * Installs tier waitlist entry entity storage.
 */
function mel_ticket_update_9005(): string {
  $table = 'mel_ticket_waitlist_entry';
  if (\Drupal::database()->schema()->tableExists($table)) {
    return 'mel_ticket_waitlist_entry table already exists.';
  }
  $definition = \Drupal::entityTypeManager()->getDefinition('mel_ticket_waitlist_entry', FALSE);
  if (!$definition) {
    return 'mel_ticket_waitlist_entry entity type not found; rebuild caches and re-run updates.';
  }
  \Drupal::entityDefinitionUpdateManager()->installEntityType($definition);
  return 'Installed mel_ticket_waitlist_entry entity type.';
}

/**
 * Ensures waitlist table exists (retry after entity discovery / cache).
 */
function mel_ticket_update_9006(): string {
  $table = 'mel_ticket_waitlist_entry';
  if (\Drupal::database()->schema()->tableExists($table)) {
    return 'mel_ticket_waitlist_entry table already exists.';
  }
  \Drupal::entityTypeManager()->clearCachedDefinitions();
  $definition = \Drupal::entityTypeManager()->getDefinition('mel_ticket_waitlist_entry', FALSE);
  if (!$definition) {
    return 'mel_ticket_waitlist_entry still not defined after cache clear; run drush cr then drush updb again.';
  }
  \Drupal::entityDefinitionUpdateManager()->installEntityType($definition);
  return \Drupal::database()->schema()->tableExists($table)
    ? 'Installed mel_ticket_waitlist_entry entity type (9006).'
    : 'installEntityType ran but table is still missing; check logs and database permissions.';
}

/**
 * Adds mail_hash to waitlist entries for privacy-safe email matching.
 */
function mel_ticket_update_9007(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('mel_ticket_waitlist_entry', FALSE);
  if (!$entity_type) {
    return 'mel_ticket_waitlist_entry entity type not found; rebuild caches and re-run updates.';
  }
  $fields = \Drupal\mel_ticket\Entity\TicketWaitlistEntry::baseFieldDefinitions($entity_type);
  if (!isset($fields['mail_hash'])) {
    return 'mail_hash field definition missing; skipped.';
  }
  try {
    $update_manager->installFieldStorageDefinition(
      'mail_hash',
      'mel_ticket_waitlist_entry',
      'mel_ticket',
      $fields['mail_hash']
    );
  }
  catch (\Throwable $e) {
    \Drupal::logger('mel_ticket')->warning(
      'mel_ticket_update_9007 installFieldStorageDefinition: @message',
      ['@message' => $e->getMessage()]
    );
  }

  $storage = \Drupal::entityTypeManager()->getStorage('mel_ticket_waitlist_entry');
  if (!\Drupal::database()->schema()->tableExists($storage->getEntityType()->getBaseTable())) {
    return 'Waitlist table missing; mail_hash not backfilled.';
  }
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();
  if (!$ids) {
    return 'Installed mail_hash on mel_ticket_waitlist_entry (no rows to backfill).';
  }
  $updated = 0;
  foreach ($storage->loadMultiple($ids) as $entry) {
    if (!$entry instanceof \Drupal\mel_ticket\Entity\TicketWaitlistEntry) {
      continue;
    }
    if (!$entry->get('mail_hash')->isEmpty()) {
      continue;
    }
    if ($entry->get('mail')->isEmpty()) {
      continue;
    }
    $mail = trim((string) $entry->get('mail')->value);
    if ($mail === '') {
      continue;
    }
    $entry->set('mail_hash', hash('sha256', mb_strtolower($mail)));
    $entry->save();
    $updated++;
  }

  return sprintf('Installed mail_hash on mel_ticket_waitlist_entry; backfilled %d row(s).', $updated);
}

