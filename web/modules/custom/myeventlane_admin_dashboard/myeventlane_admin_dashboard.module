<?php

/**
 * @file
 * Primary module hooks for MyEventLane Admin Dashboard module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function myeventlane_admin_dashboard_theme(): array {
  return [
    'admin_dashboard' => [
      'variables' => [
        'event_count' => 0,
        'vendor_count' => 0,
        'user_count' => 0,
        'recent_events' => [],
        'quick_links' => [],
        'support_console_url' => NULL,
        'revenue_kpis' => [],
        'recent_transactions' => [],
        'top_events' => [],
        'platform_metrics' => [],
        'sidebar_metrics' => [],
        'detailed_analytics' => [],
        'vendor_activity' => [],
        'event_breakdown' => [],
        'vendor_breakdown' => [],
        'customer_activity' => [],
        'escalation_summary' => [],
      ],
      'template' => 'admin-dashboard',
    ],
    'platform_control_centre' => [
      'variables' => [
        'kpi_tiles' => NULL,
        'alerts' => NULL,
        'trend' => NULL,
        'recent_activity' => NULL,
        'links' => NULL,
      ],
      'template' => 'platform-control-centre',
    ],
    'platform_control_centre__kpi_tiles' => [
      'variables' => [
        'kpis' => [],
      ],
      'template' => 'platform-control-centre--kpi-tiles',
    ],
    'platform_control_centre__alerts' => [
      'variables' => [
        'alerts' => [],
      ],
      'template' => 'platform-control-centre--alerts',
    ],
    'platform_control_centre__trend' => [
      'variables' => [
        'trend' => ['months' => [], 'max_revenue' => 0.0, 'empty' => TRUE],
      ],
      'template' => 'platform-control-centre--trend',
    ],
    'platform_control_centre__recent_activity' => [
      'variables' => [
        'activity' => [
          'escalations' => [],
          'orders' => [],
          'escalations_empty' => TRUE,
          'orders_empty' => TRUE,
        ],
      ],
      'template' => 'platform-control-centre--recent-activity',
    ],
  ];
}
