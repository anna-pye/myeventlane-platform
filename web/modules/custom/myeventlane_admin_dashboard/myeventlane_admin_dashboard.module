<?php

/**
 * @file
 * Primary module hooks for MyEventLane Admin Dashboard module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\RefinableCacheableDependencyInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;
use Drupal\Core\Template\Attribute;
use Drupal\node\NodeInterface;
use Symfony\Component\Routing\Exception\RouteNotFoundException;

/**
 * Returns TRUE when the route should show Platform Control Centre chrome.
 */
function _myeventlane_admin_dashboard_is_pcc_route(?string $route_name): bool {
  if ($route_name === NULL || $route_name === '') {
    return FALSE;
  }
  $pcc_routes = [
    'myeventlane_admin_dashboard.platform_control',
    'myeventlane_admin_dashboard.platform_studio',
    'myeventlane_admin_dashboard.financials',
    'myeventlane_admin_dashboard.vendors',
    'myeventlane_admin_dashboard.orders',
    'myeventlane_admin_dashboard.payouts',
    'myeventlane_admin_dashboard.reports',
    'myeventlane_admin_dashboard.payout_batches',
    'myeventlane_admin_dashboard.payout_batch_view',
    'entity.escalation.collection',
    'entity.escalation.canonical',
    'entity.escalation.add_form',
    'entity.escalation.edit_form',
    'myeventlane_support_console.dashboard',
  ];
  return in_array($route_name, $pcc_routes, TRUE)
    || str_starts_with($route_name, 'myeventlane_reporting.admin');
}

/**
 * Implements hook_preprocess_html().
 */
function myeventlane_admin_dashboard_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (!_myeventlane_admin_dashboard_is_pcc_route($route_name)) {
    return;
  }
  if (isset($variables['attributes']) && $variables['attributes'] instanceof Attribute) {
    $variables['attributes']->addClass('mel-admin-layout--pcc');
  }
}

/**
 * Implements hook_preprocess_page().
 */
function myeventlane_admin_dashboard_preprocess_page(&$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (!_myeventlane_admin_dashboard_is_pcc_route($route_name)) {
    return;
  }
  if (!isset($variables['page']['pre_content']) || !is_array($variables['page']['pre_content'])) {
    $variables['page']['pre_content'] = [];
  }
  $variables['page']['pre_content']['mel_pcc_utility_bar'] = [
    '#theme' => 'mel_pcc_utility_bar',
    '#weight' => -100,
    '#main_site_url' => Url::fromRoute('<front>')->toString(),
    '#vendor_dashboard_url' => Url::fromRoute('myeventlane_vendor.console.dashboard')->toString(),
    '#platform_control_url' => Url::fromRoute('myeventlane_admin_dashboard.platform_control')->toString(),
    '#cache' => [
      'contexts' => ['route', 'user.permissions'],
    ],
  ];
}

