<?php

declare(strict_types=1);

/**
 * @file
 * MEL Guide: contextual discovery companion for visitors and customers.
 */

use Drupal\Core\Template\Attribute;

/**
 * Implements hook_theme().
 */
function mel_guide_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'mel_guide' => [
      'variables' => [
        'state' => 'wave',
        'message' => '',
        'image_url' => '',
        'image_alt' => '',
        'actions' => [],
        'position' => 'bottom_right',
      ],
      'template' => 'mel-guide',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for mel_guide.
 */
function mel_guide_preprocess_mel_guide(array &$variables): void {
  $position = $variables['position'] ?? 'bottom_right';
  if (!in_array($position, ['bottom_right', 'bottom_left'], TRUE)) {
    $position = 'bottom_right';
  }

  $variables['attributes'] = new Attribute([
    'class' => [
      'mel-guide',
      'mel-guide--' . $variables['state'],
      'mel-guide--' . $position,
    ],
    'data-mel-guide' => '',
    'data-mel-guide-state' => $variables['state'],
    'role' => 'complementary',
    'aria-label' => t('MEL guide'),
  ]);

  $variables['bubble_attributes'] = new Attribute([
    'class' => ['mel-guide__bubble'],
    'id' => 'mel-guide-bubble',
    'role' => 'status',
    'aria-live' => 'polite',
  ]);
}
