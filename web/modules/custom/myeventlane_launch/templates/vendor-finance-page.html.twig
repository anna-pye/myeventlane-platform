<section class="mel-dashboard-section">
  <header class="mel-section-heading">
    <h2 class="mel-section-heading__title">{{ 'Finance summary'|t }}</h2>
    {% if summary.vendor_name %}
      <p class="mel-section-heading__subtitle">{{ 'Current vendor: @vendor'|t({'@vendor': summary.vendor_name}) }}</p>
    {% endif %}
  </header>

  <div class="mel-kpi-grid">
    <article class="mel-kpi-card">
      <h3>{{ 'Tickets sold'|t }}</h3>
      <p>{{ summary.tickets_sold|default(0) }}</p>
    </article>
    <article class="mel-kpi-card">
      <h3>{{ 'Gross revenue'|t }}</h3>
      <p>{{ summary.gross_revenue_formatted|default('$0.00') }}</p>
    </article>
    <article class="mel-kpi-card">
      <h3>{{ 'MEL platform fee'|t }}</h3>
      <p>{{ summary.mel_platform_fee_formatted|default('$0.00') }}</p>
    </article>
    <article class="mel-kpi-card">
      <h3>{{ 'Stripe processing fee'|t }}</h3>
      <p>{{ summary.stripe_processing_fee_formatted|default('$0.00') }}</p>
    </article>
    <article class="mel-kpi-card">
      <h3>{{ 'Net payout'|t }}</h3>
      <p>{{ summary.net_payout_formatted|default('$0.00') }}</p>
    </article>
  </div>
</section>
