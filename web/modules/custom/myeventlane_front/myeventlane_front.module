<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function myeventlane_front_theme($existing, $type, $theme, $path): array {
  return [
    'myeventlane_front_sitemap' => [
      'variables' => [
        'sections' => [],
      ],
      'template' => 'myeventlane-front-sitemap',
      'path' => $path . '/templates',
    ],
    'myeventlane_home_hero' => [
      'variables' => [
        'pills' => NULL,
        'featured_events' => NULL,
        'hero_image_url' => NULL,
        'hero_image_url_mobile' => NULL,
        'hero_hide_on_mobile' => FALSE,
        'hero_alt' => '',
        'search_events_url' => NULL,
        'search_site_url' => NULL,
      ],
      'template' => 'myeventlane-home-hero',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function myeventlane_front_preprocess_myeventlane_home_hero(array &$variables): void {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  $variables['directory'] = base_path() . $theme_path;
}

/**
 * Implements hook_views_query_alter().
 *
 * Homepage hero exclusivity and cross-rail deduplication (front page only).
 */
function myeventlane_front_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if (!\Drupal::hasService('myeventlane_front.homepage_merchandising_query_alter')) {
    return;
  }

  /** @var \Drupal\myeventlane_front\Service\HomepageMerchandisingQueryAlter $alter */
  $alter = \Drupal::service('myeventlane_front.homepage_merchandising_query_alter');
  $alter->alter($view, $query);
}

/**
 * Implements hook_views_pre_render().
 *
 * Applies optional homepage rail diversity without query rewrites.
 */
function myeventlane_front_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if (!\Drupal::hasService('myeventlane_front.homepage_rail_diversity')) {
    return;
  }

  /** @var \Drupal\myeventlane_front\Service\HomepageRailDiversityFilter $filter */
  $filter = \Drupal::service('myeventlane_front.homepage_rail_diversity');
  $filter->filter($view);
}
