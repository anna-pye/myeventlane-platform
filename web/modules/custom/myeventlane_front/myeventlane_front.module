<?php

/**
 * @file
 */

declare(strict_types=1);

use Drupal\node\NodeInterface;

/**
 * Implements hook_theme().
 */
function myeventlane_front_theme($existing, $type, $theme, $path): array {
  return [
    'myeventlane_organiser_hub' => [
      'variables' => [
        'page' => [],
      ],
      'template' => 'myeventlane-organiser-hub',
      'path' => $path . '/templates',
    ],
    'myeventlane_blog_landing' => [
      'variables' => [
        'page' => [],
      ],
      'template' => 'myeventlane-blog-landing',
      'path' => $path . '/templates',
    ],
    'myeventlane_blog_filtered' => [
      'variables' => [
        'view' => NULL,
        'filters' => [],
      ],
      'template' => 'myeventlane-blog-filtered',
      'path' => $path . '/templates',
    ],
    'myeventlane_front_sitemap' => [
      'variables' => [
        'sections' => [],
      ],
      'template' => 'myeventlane-front-sitemap',
      'path' => $path . '/templates',
    ],
    'myeventlane_home_hero' => [
      'variables' => [
        'pills' => NULL,
        'featured_events' => NULL,
        'hero_image_url' => NULL,
        'hero_image_url_mobile' => NULL,
        'hero_hide_on_mobile' => FALSE,
        'hero_alt' => '',
        'search_events_url' => NULL,
        'search_site_url' => NULL,
      ],
      'template' => 'myeventlane-home-hero',
      'path' => $path . '/templates',
    ],
  ];
}

/**
 * Builds a public theme asset URL with a filemtime cache buster.
 *
 * Theme hero JPEGs/PNGs are served with long-lived cache headers; appending
 * ?v=mtime ensures browsers fetch replacements after the file on disk changes.
 */
function _myeventlane_front_theme_asset_url(string $relative_path): ?string {
  $full_path = DRUPAL_ROOT . '/' . $relative_path;
  if (!is_readable($full_path)) {
    return NULL;
  }
  return base_path() . $relative_path . '?v=' . filemtime($full_path);
}

/**
 * Resolves theme-packaged homepage hero image URLs.
 *
 * @return array{desktop: ?string, mobile: ?string, alt: string}
 *   Desktop/mobile absolute URLs and default alt text.
 */
function _myeventlane_front_home_hero_theme_urls(): array {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  $desktop = NULL;
  $mobile = NULL;

  $desktop_candidates = [
    $theme_path . '/images/mel/hero/mel-hero-home-community.jpg',
    $theme_path . '/images/mel/hero/mel-hero-home.png',
  ];
  foreach ($desktop_candidates as $relative) {
    $desktop = _myeventlane_front_theme_asset_url($relative);
    if ($desktop !== NULL) {
      break;
    }
  }

  $mobile_candidates = [
    $theme_path . '/images/mel/hero/mel-hero-home-community.jpg',
    $theme_path . '/images/mel/hero/mel-hero-home.png',
  ];
  foreach ($mobile_candidates as $relative) {
    $mobile = _myeventlane_front_theme_asset_url($relative);
    if ($mobile !== NULL) {
      break;
    }
  }
  if ($mobile === NULL && $desktop !== NULL) {
    $mobile = $desktop;
  }

  return [
    'desktop' => $desktop,
    'mobile' => $mobile,
    'alt' => (string) t('Community festival with live music, markets, and families enjoying local events.'),
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function myeventlane_front_preprocess_myeventlane_home_hero(array &$variables): void {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  $variables['directory'] = base_path() . $theme_path;

  if (($variables['hero_image_url_mobile'] ?? NULL) === NULL && !empty($variables['hero_image_url'])) {
    $variables['hero_image_url_mobile'] = $variables['hero_image_url'];
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Homepage hero exclusivity and cross-rail deduplication (front page only).
 */
function myeventlane_front_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if (\Drupal::hasService('myeventlane_front.blog_audience_filter')) {
    /** @var \Drupal\myeventlane_front\Service\BlogAudienceFilterService $blogAudience */
    $blogAudience = \Drupal::service('myeventlane_front.blog_audience_filter');
    $blogAudience->alterMelBlogView($view, $query);
  }

  if (!\Drupal::hasService('myeventlane_front.homepage_merchandising_query_alter')) {
    return;
  }

  /** @var \Drupal\myeventlane_front\Service\HomepageMerchandisingQueryAlter $alter */
  $alter = \Drupal::service('myeventlane_front.homepage_merchandising_query_alter');
  $alter->alter($view, $query);
}

/**
 * Implements hook_views_pre_render().
 *
 * Applies optional homepage rail diversity without query rewrites.
 */
function myeventlane_front_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if ($view->id() === 'upcoming_events'
    && ($view->current_display ?? '') === 'page_popular'
    && !empty($view->result)
    && !empty($view->mel_community_favourites_rank)
    && is_array($view->mel_community_favourites_rank)) {
    $rank = $view->mel_community_favourites_rank;
    usort($view->result, static function ($a, $b) use ($rank): int {
      $id_a = isset($a->_entity) ? (int) $a->_entity->id() : PHP_INT_MAX;
      $id_b = isset($b->_entity) ? (int) $b->_entity->id() : PHP_INT_MAX;
      return ($rank[$id_a] ?? PHP_INT_MAX) <=> ($rank[$id_b] ?? PHP_INT_MAX);
    });
  }

  if (!\Drupal::hasService('myeventlane_front.homepage_rail_diversity')) {
    return;
  }

  /** @var \Drupal\myeventlane_front\Service\HomepageRailDiversityFilter $filter */
  $filter = \Drupal::service('myeventlane_front.homepage_rail_diversity');
  $filter->filter($view);
}

/**
 * Implements hook_preprocess_node().
 */
function myeventlane_front_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  $viewMode = (string) ($variables['view_mode'] ?? '');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'blog_post') {
    return;
  }

  if ($viewMode === 'teaser') {
    if (!\Drupal::hasService('myeventlane_front.organiser_hub_editorial')) {
      return;
    }
    /** @var \Drupal\myeventlane_front\Service\OrganiserHubEditorialService $editorial */
    $editorial = \Drupal::service('myeventlane_front.organiser_hub_editorial');
    $badge = $editorial->buildBlogCardBadge($node);
    if ($badge !== NULL) {
      $variables['mel_blog_badge'] = $badge;
    }
    $readingTime = $editorial->estimateReadingTime($node);
    if ($readingTime !== NULL) {
      $variables['mel_blog_reading_time'] = $readingTime;
    }
    return;
  }

  if ($viewMode !== 'full') {
    return;
  }
  if (!\Drupal::hasService('myeventlane_front.blog_article_presentation')) {
    return;
  }

  /** @var \Drupal\myeventlane_front\Service\BlogArticlePresentationService $presentation */
  $presentation = \Drupal::service('myeventlane_front.blog_article_presentation');
  $built = $presentation->build($node);
  foreach ($built as $key => $value) {
    if ($key === '#cache' || !is_string($key) || !(str_starts_with($key, 'mel_blog_') || $key === 'mel_blog_is_playbook')) {
      continue;
    }
    $variables[$key] = $value;
  }
  if (isset($built['#cache']) && is_array($built['#cache'])) {
    $variables['#cache']['tags'] = array_values(array_unique(array_merge(
      $variables['#cache']['tags'] ?? [],
      $built['#cache']['tags'] ?? [],
    )));
    $variables['#cache']['contexts'] = array_values(array_unique(array_merge(
      $variables['#cache']['contexts'] ?? [],
      $built['#cache']['contexts'] ?? [],
    )));
  }
}

/**
 * Implements hook_page_attachments().
 */
function myeventlane_front_page_attachments(array &$attachments): void {
  $routeMatch = \Drupal::routeMatch();
  $node = $routeMatch->getParameter('node');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'blog_post' || !$node->isPublished()) {
    return;
  }
  if (!\Drupal::hasService('myeventlane_front.blog_structured_data')) {
    return;
  }

  /** @var \Drupal\myeventlane_front\Service\BlogStructuredDataBuilder $builder */
  $builder = \Drupal::service('myeventlane_front.blog_structured_data');
  foreach ($builder->build($node) as $index => $schema) {
    $encoded = json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    if (!is_string($encoded)) {
      continue;
    }
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'script',
        '#attributes' => ['type' => 'application/ld+json'],
        '#value' => $encoded,
      ],
      'myeventlane_front_blog_schema_' . $node->id() . '_' . $index,
    ];
  }
}
