{#
/**
 * @file
 * Home hero block — full-bleed community artwork with discovery overlay.
 *
 * Variables:
 * - hero_image_url: Optional URL from Page Visuals Manager (desktop).
 * - hero_image_url_mobile: Optional URL for mobile viewports.
 * - hero_hide_on_mobile: Boolean; when TRUE, hide hero on mobile.
 * - hero_alt: Alt text for hero image.
 * - pills: Category pills render array (myeventlane_category_pills block).
 * - search_events_url: Events browse URL for keyword-only search.
 * - search_site_url: Site search URL when a location is entered.
 */
#}

<section class="mel-home-hero" aria-labelledby="mel-home-hero-title">
  <div class="mel-home-hero__banner{% if hero_hide_on_mobile|default(false) %} mel-home-hero__banner--hide-mobile-art{% endif %}">
  {% if hero_image_url %}
    <div class="mel-home-hero__media" aria-hidden="true">
      {% if hero_image_url_mobile|default(null) and not hero_hide_on_mobile|default(false) %}
        <picture>
          <source media="(max-width: 767px)" srcset="{{ hero_image_url_mobile }}">
          <img
            class="mel-home-hero__media-img"
            src="{{ hero_image_url }}"
            alt=""
            width="1024"
            height="682"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      {% else %}
        <img
          class="mel-home-hero__media-img"
          src="{{ hero_image_url }}"
          alt=""
          width="1024"
          height="682"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      {% endif %}
    </div>
  {% elseif featured_events %}
    <div class="mel-home-hero__media mel-home-hero__media--rotator" aria-hidden="true">
      <div class="mel-home-hero__feature-rotator" data-mel-home-hero-rotator aria-label="{{ 'Community spotlight highlights'|t }}">
        {{ featured_events }}
      </div>
    </div>
  {% else %}
    <div class="mel-home-hero__media mel-home-hero__media--placeholder" aria-hidden="true"></div>
  {% endif %}

    <div class="mel-home-hero__scrim" aria-hidden="true"></div>

    <div class="mel-home-hero__banner-inner mel-container mel-container--wide">
      <div class="mel-home-hero__copy">
        <h1 id="mel-home-hero-title" class="mel-home-hero__title">
          {{ 'Discover events. Connect people. Celebrate'|t }}
          <span class="mel-home-hero__accent">{{ 'community.'|t }}</span>
        </h1>
        <p class="mel-home-hero__text">
          {{ 'Find events, join activities, and create memories in your community.'|t }}
        </p>
      </div>

      <div class="mel-home-hero__search-shell">
        <form
          class="mel-home-hero__search"
          role="search"
          action="{{ search_events_url|default(path('view.upcoming_events.page_events')) }}"
          method="get"
          data-events-url="{{ search_events_url|default(path('view.upcoming_events.page_events')) }}"
          data-search-url="{{ search_site_url|default(path('mel_search.view')) }}"
        >
          <div class="mel-home-hero__search-fields">
            <div class="mel-home-hero__search-field mel-home-hero__search-field--query">
              <label class="visually-hidden" for="mel-home-search">{{ 'Search events'|t }}</label>
              <span class="mel-home-hero__search-icon mel-home-hero__search-icon--query" aria-hidden="true"></span>
              <input
                id="mel-home-search"
                class="mel-home-hero__search-input mel-home-hero__search-input--query"
                name="search"
                type="search"
                placeholder="{{ 'Search events, locations or categories'|t }}"
                autocomplete="off"
              />
            </div>
            <span class="mel-home-hero__search-divider" aria-hidden="true"></span>
            <div class="mel-home-hero__search-field mel-home-hero__search-field--location">
              <label class="visually-hidden" for="mel-home-search-location">{{ 'Location'|t }}</label>
              <span class="mel-home-hero__search-icon mel-home-hero__search-icon--location" aria-hidden="true"></span>
              <input
                id="mel-home-search-location"
                class="mel-home-hero__search-input mel-home-hero__search-input--location"
                name="location"
                type="text"
                placeholder="{{ 'Near me'|t }}"
                autocomplete="address-level2"
              />
            </div>
          </div>
          <button type="submit" class="mel-home-hero__search-submit">
            <span class="mel-home-hero__search-submit-label">{{ 'Search Events'|t }}</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  {% if pills %}
    <div class="mel-home-hero__categories-bar">
      <div class="mel-home-hero__categories-inner mel-container mel-container--wide">
        <nav class="mel-home-hero__categories" aria-label="{{ 'Browse by category'|t }}">
          <a class="mel-home-hero__category-card mel-home-hero__category-card--all" href="{{ path('view.upcoming_events.page_events') }}">
            <span class="mel-home-hero__category-icon mel-home-hero__category-icon--all" aria-hidden="true">
              {% include '@myeventlane_theme/includes/mel-event-ui-icons.html.twig' with {
                icon: 'calendar',
                class: 'mel-home-hero__category-glyph',
                size: 24
              } only %}
            </span>
            <span class="mel-home-hero__category-label">{{ 'All Events'|t }}</span>
          </a>
          <div class="mel-home-hero__categories-scroll">
            {{ pills }}
          </div>
          <a class="mel-home-hero__view-all" href="{{ path('view.upcoming_events.page_events') }}">
            {{ 'View all'|t }}<span aria-hidden="true"> ›</span>
          </a>
        </nav>
      </div>
    </div>
  {% endif %}
</section>
