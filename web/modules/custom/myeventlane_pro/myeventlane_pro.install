    $spec = [
      'fields' => [
        'status' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'scheduled',
        ],
        'scheduled_at' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
      ],
      'indexes' => [
        'status_scheduled_at' => ['status', 'scheduled_at'],
      ],
    ];
    $schema->addIndex(
      $table,
      'status_scheduled_at',
      ['status', 'scheduled_at'],
      $spec,
    );
  }

  $cf = \Drupal::configFactory();
  $templates = [
    'pro_subscription_payment_failed_day_0' => [
      'subject' => 'Payment failed for your Pro subscription',
      'preheader' => 'Update your card to keep Pro features active.',
      'body_html' => '<p>Hi {{ first_name|default(\'there\') }},</p><p>We could not process your latest Pro subscription payment.</p><p>Please update your payment method now to keep Pro active without interruption.</p><p>You still have a grace period before access changes.</p>',
      'campaign' => 'pro_payment_failed_day_0',
    ],
    'pro_subscription_payment_failed_day_3' => [
      'subject' => 'Reminder: your Pro payment is still due',
      'preheader' => 'Please update your payment method to avoid suspension.',
      'body_html' => '<p>Hi {{ first_name|default(\'there\') }},</p><p>This is a reminder that your Pro subscription payment is still outstanding.</p><p>Update your payment method as soon as possible to prevent service interruption.</p><p>We are still holding your Pro access during grace period.</p>',
      'campaign' => 'pro_payment_failed_day_3',
    ],
    'pro_subscription_payment_failed_day_6' => [
      'subject' => 'Final warning: Pro access will be suspended',
      'preheader' => 'Your Pro grace period is ending soon.',
      'body_html' => '<p>Hi {{ first_name|default(\'there\') }},</p><p>Your Pro subscription payment is still unpaid.</p><p>This is the final warning before Pro access is suspended at the end of grace period.</p><p>Update your payment method immediately to prevent entitlement removal.</p>',
      'campaign' => 'pro_payment_failed_day_6',
    ],
  ];

  foreach ($templates as $template => $definition) {
    $config = $cf->getEditable("myeventlane_messaging.template.{$template}");
    if ($config->get('enabled')) {
      continue;
    }
    $config->setData([
      'enabled' => TRUE,
      'subject' => $definition['subject'],
      'preheader' => $definition['preheader'],
      'body_html' => $definition['body_html'],
      'utm' => [
        'enable' => TRUE,
        'params' => [
          'utm_source' => 'email',
          'utm_medium' => 'lifecycle',
          'utm_campaign' => $definition['campaign'],
        ],
      ],
    ])->save();
  }
}

/**
 * Ensures Pro boost sync queue exists for store-by-store entitlement refresh.
 */
function myeventlane_pro_update_10009(): void {
  $etm = \Drupal::entityTypeManager();
  if (!$etm->hasDefinition('advancedqueue_queue')) {
    return;
  }

  $queueStorage = $etm->getStorage('advancedqueue_queue');
  if ($queueStorage->load('pro_boost_sync')) {
    return;
  }

  $queueStorage->create([
    'id' => 'pro_boost_sync',
    'label' => 'Pro Boost Sync',
    'backend' => 'database',
    'backend_configuration' => ['lease_time' => 300],
    'processor' => 'cron',
    'processing_time' => 120,
    'threshold' => ['state' => 'failure', 'limit' => 500],
    'locked' => FALSE,
  ])->save();
}

/**
 * Re-ensures Pro boost sync queue exists on upgraded sites.
 */
function myeventlane_pro_update_10010(): void {
  $etm = \Drupal::entityTypeManager();
  if (!$etm->hasDefinition('advancedqueue_queue')) {
    return;
  }

  $queueStorage = $etm->getStorage('advancedqueue_queue');
  if ($queueStorage->load('pro_boost_sync')) {
    return;
  }

  $queueStorage->create([
    'id' => 'pro_boost_sync',
    'label' => 'Pro Boost Sync',
    'backend' => 'database',
    'backend_configuration' => ['lease_time' => 300],
    'processor' => 'cron',
    'processing_time' => 120,
    'threshold' => ['state' => 'failure', 'limit' => 500],
    'locked' => FALSE,
  ])->save();
}

/**
 * Installs the field_is_pro_support base field on the escalation entity.
 *
 * Shared by hook_install() and update_10002().
 */
function _myeventlane_pro_install_escalation_pro_field(): void {
  $field = BaseFieldDefinition::create('boolean')
    ->setLabel(new TranslatableMarkup('Pro Support'))
    ->setDescription(new TranslatableMarkup('Whether this escalation was submitted by a Pro subscriber.'))
    ->setDefaultValue(FALSE)
    ->setDisplayOptions('view', [
      'label' => 'inline',
      'type' => 'boolean',
      'weight' => 15,
      'settings' => [
        'format' => 'yes-no',
      ],
    ])
    ->setDisplayConfigurable('view', TRUE);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition(
      'field_is_pro_support',
      'escalation',
      'myeventlane_pro',
      $field,
    );

  \Drupal::logger('myeventlane_pro')->notice('Installed field_is_pro_support on escalation entity.');
}
