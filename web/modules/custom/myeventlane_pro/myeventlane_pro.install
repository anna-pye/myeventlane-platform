/**
 * Create renewal reminder table and ensure required indexes/templates.
 */
function myeventlane_pro_update_10007(): void {
  $schema = Database::getConnection()->schema();
  $table = 'myeventlane_pro_renewal_notifications';

  if (!$schema->tableExists($table)) {
    $schema->createTable($table, [
      'description' => 'Tracks Pro renewal reminder scheduling and sends.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'subscription_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'scheduled_at' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'sent_at' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => FALSE,
        ],
        'status' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'scheduled',
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'subscription_scheduled' => ['subscription_id', 'scheduled_at'],
      ],
      'indexes' => [
        'status_scheduled_at' => ['status', 'scheduled_at'],
        'subscription_id' => ['subscription_id'],
      ],
    ]);
  }
  elseif (!$schema->indexExists($table, 'status_scheduled_at')) {
    $spec = [
      'fields' => [
        'status' => [
          'type' => 'varchar',
          'length' => 32,
          'not null' => TRUE,
          'default' => 'scheduled',
        ],
        'scheduled_at' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
      ],
      'indexes' => [
        'status_scheduled_at' => ['status', 'scheduled_at'],
      ],
    ];
    $schema->addIndex(
      $table,
      'status_scheduled_at',
      ['status', 'scheduled_at'],
      $spec,
    );
  }

  $config = \Drupal::configFactory()->getEditable('myeventlane_messaging.template.pro_subscription_renewal_reminder');
  if (!$config->get('enabled')) {
    $config->setData([
      'enabled' => TRUE,
      'subject' => 'Your Pro plan renews in 3 days',
      'preheader' => 'Review your upcoming renewal and recent Pro performance.',
      'body_html' => '<p>Hi {{ first_name|default(\'there\') }},</p><p>Your Pro subscription renews on <strong>{{ next_billing_date }}</strong>.</p><p>Last month, Pro recovered <strong>${{ last_month_recovered_revenue }}</strong> in revenue for your business.</p><p>Your recent ROI multiple is <strong>{{ roi_multiple }}x</strong>.</p><p>If your card details changed, please update your payment method now to avoid interruption.</p>',
      'utm' => [
        'enable' => TRUE,
        'params' => [
          'utm_source' => 'email',
          'utm_medium' => 'lifecycle',
          'utm_campaign' => 'pro_renewal_reminder',
        ],
      ],
    ])->save();
  }
}

