  $schema = Database::getConnection()->schema();
  if ($schema->tableExists('myeventlane_pro_abandoned_cart')) {
    return;
  }

  $schema->createTable('myeventlane_pro_abandoned_cart', [
    'description' => 'Tracking rows for Pro abandoned cart reminder workflow.',
