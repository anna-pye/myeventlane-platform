{#
/**
 * @file
 * MEL Pro overview and upgrade page.
 */
#}
<div class="mel-pro-overview">
  <header class="mel-pro-overview__hero">
    <div class="mel-pro-overview__hero-copy">
      <p class="mel-pro-overview__eyebrow"><span class="mel-pro-badge">PRO</span> {{ 'For regular organisers'|t }}</p>
      <h1 class="mel-pro-overview__title">{{ 'Grow your events without losing the personal touch.'|t }}</h1>
      <p class="mel-pro-overview__subtitle">{{ 'MEL Pro adds deeper insight, reusable communications and stronger organiser branding to the tools you already use.'|t }}</p>
      {% if not is_pro and subscribe_form %}
        <div class="mel-pro-overview__hero-cta" id="mel-pro-upgrade">
          {{ subscribe_form }}
          {% if trial_eligible %}
            <p>{{ '30-day trial, then @price per month. Cancel at the end of any billing period.'|t({'@price': pro_price}) }}</p>
          {% else %}
            <p>{{ '@price per month from today. Cancel at the end of any billing period.'|t({'@price': pro_price}) }}</p>
          {% endif %}
        </div>
      {% elseif is_pro and manage_url %}
        <a href="{{ manage_url }}" class="mel-button mel-button--primary">{{ 'Manage MEL Pro'|t }}</a>
      {% endif %}
    </div>
    <aside class="mel-pro-overview__decision-card" aria-label="{{ 'MEL Pro plan summary'|t }}">
      <span>{{ 'MEL Pro'|t }}</span>
      <strong>{{ pro_price }}<small>{{ '/month'|t }}</small></strong>
      <p>{{ 'One monthly plan for your organiser account.'|t }}</p>
      <ul>
        <li>{{ 'Advanced organiser analytics'|t }}</li>
        <li>{{ 'Reusable branded emails'|t }}</li>
        <li>{{ 'Organiser branding controls'|t }}</li>
      </ul>
    </aside>
  </header>

  {% if is_pro and status_card %}
    <div class="mel-pro-overview__status-card">{{ status_card }}</div>
  {% endif %}

  <section class="mel-pro-overview__section" aria-labelledby="mel-pro-benefits-heading">
    <p class="mel-pro-overview__eyebrow">{{ 'What Pro helps you do'|t }}</p>
    <h2 id="mel-pro-benefits-heading">{{ 'Understand, communicate and grow'|t }}</h2>
    <div class="mel-pro-pillars">
      <article class="mel-pro-pillar">
        <span class="mel-pro-pillar__number">01</span>
        <h3 class="mel-pro-pillar__title">{{ 'Understand what works'|t }}</h3>
        <p>{{ 'Go beyond the free analytics pulse with deeper event and conversion insight.'|t }}</p>
        <ul class="mel-pro-pillar__features">
          <li>{{ 'Advanced analytics'|t }}</li>
          <li>{{ 'Event performance detail'|t }}</li>
          <li>{{ 'Exportable reporting'|t }}</li>
        </ul>
      </article>
      <article class="mel-pro-pillar">
        <span class="mel-pro-pillar__number">02</span>
        <h3 class="mel-pro-pillar__title">{{ 'Bring people back'|t }}</h3>
        <p>{{ 'Save time with reusable messaging while keeping each invitation personal.'|t }}</p>
        <ul class="mel-pro-pillar__features">
          <li>{{ 'Pro email templates'|t }}</li>
          <li>{{ 'Branded email presentation'|t }}</li>
          <li>{{ 'Abandoned cart recovery'|t }}</li>
        </ul>
      </article>
      <article class="mel-pro-pillar">
        <span class="mel-pro-pillar__number">03</span>
        <h3 class="mel-pro-pillar__title">{{ 'Show up consistently'|t }}</h3>
        <p>{{ 'Give your events a recognisable organiser identity across guest touchpoints.'|t }}</p>
        <ul class="mel-pro-pillar__features">
          <li>{{ 'Organiser branding controls'|t }}</li>
          <li>{{ 'Custom email footer'|t }}</li>
          <li>{{ 'Faster setup with event cloning'|t }}</li>
        </ul>
      </article>
    </div>
  </section>

  {% if not is_pro and subscribe_form %}
    <section class="mel-pro-overview__closing" aria-labelledby="mel-pro-closing-heading">
      <div>
        <p class="mel-pro-overview__eyebrow">{{ 'Ready when you are'|t }}</p>
        <h2 id="mel-pro-closing-heading">{{ 'Make your next event easier to grow.'|t }}</h2>
        <p>{{ 'Upgrade your organiser account now, or come back when you are running events more regularly.'|t }}</p>
      </div>
      <div class="mel-pro-overview__closing-action">
        <a class="mel-button mel-button--primary" href="#mel-pro-upgrade">{{ 'Upgrade to MEL Pro'|t }}</a>
        <a href="{{ path('myeventlane_pro.support') }}">{{ 'Learn how Pro works'|t }}</a>
      </div>
    </section>
  {% endif %}
</div>
