{#
/**
 * @file
 * Template for the Pro subscription manage / billing page.
 *
 * Variables:
 * - subscription_status: Status label (e.g. "Active").
 * - started_date: Formatted start date string.
 * - next_billing_date: Formatted next billing date string or NULL.
 * - cancel_url: URL to the cancel confirmation form.
 * - roi_summary: ROI summary array or NULL.
 * - pro_status: Billing status array from ProSubscriptionStatusService.
 * - plan_label: Human-readable plan name.
 * - billing_schedule_label: e.g. Monthly.
 * - billing_portal_enabled: Whether Stripe portal is enabled in config.
 * - billing_portal_url: Route URL to start portal redirect.
 * - billing_support_url: Optional support link.
 */
#}
{% set status = pro_status|default({}) %}

<div class="mel-pro-manage">

  <div class="mel-pro-manage__header">
    <span class="mel-pro-badge">PRO</span>
    <h1 class="mel-pro-manage__title">{{ 'Billing & subscription'|t }}</h1>
  </div>

  {% if status.is_in_grace|default(false) %}
    <div class="mel-pro-warning messages messages--warning">
      {{ 'Your Pro features are at risk. Please update your payment method.'|t }}
    </div>
  {% endif %}

  {% if grace_days_remaining is not null %}
    <div class="messages messages--warning">
      {{ 'Your payment failed. You have @days days remaining before Pro is suspended.'|t({'@days': grace_days_remaining}) }}
    </div>
  {% endif %}

  {% if renewal_in_days is not null %}
    <div class="messages messages--status">
      {{ 'Your Pro renews in @days days.'|t({'@days': renewal_in_days}) }}
    </div>
  {% endif %}

  <div class="mel-billing-status mel-billing-status--{{ status.state|default('inactive') }}">
    <strong>{{ status.status_label|default('') }}</strong>
    <p>{{ status.status_message|default('') }}</p>
    {% if status.is_in_grace|default(false) and status.grace_expires_label %}
      <div class="mel-billing-warning">
        {{ 'Update your payment method before @date'|t({'@date': status.grace_expires_label}) }}
      </div>
    {% endif %}
  </div>

  <div class="mel-pro-manage__card mel-card">
    <div class="mel-pro-manage__details">

      <div class="mel-pro-manage__row">
        <span class="mel-pro-manage__label">{{ 'Plan'|t }}</span>
        <span class="mel-pro-manage__value">{{ plan_label|default('MEL Pro') }} — {{ billing_schedule_label|default('') }}</span>
      </div>

      <div class="mel-pro-manage__row">
        <span class="mel-pro-manage__label">{{ 'Status'|t }}</span>
        <span class="mel-pro-manage__value mel-pro-manage__value--status">
          <span class="mel-badge mel-badge--success">{{ subscription_status }}</span>
        </span>
      </div>

      {% if started_date %}
        <div class="mel-pro-manage__row">
          <span class="mel-pro-manage__label">{{ 'Started'|t }}</span>
          <span class="mel-pro-manage__value">{{ started_date }}</span>
        </div>
      {% endif %}

      {% if next_billing_date %}
        <div class="mel-pro-manage__row">
          <span class="mel-pro-manage__label">{{ 'Next billing date'|t }}</span>
          <span class="mel-pro-manage__value">{{ next_billing_date }}</span>
        </div>
      {% endif %}

      {% if roi_summary %}
        <div class="mel-pro-manage__row">
          <span class="mel-pro-manage__label">{{ 'ROI this month'|t }}</span>
          <span class="mel-pro-manage__value">{{ 'Pro paid for itself @times times this month.'|t({'@times': roi_summary.roi_multiple|number_format(2)}) }}</span>
        </div>
      {% endif %}

    </div>

    <div class="mel-pro-manage__actions mel-billing-actions">
      {% if billing_portal_enabled and billing_portal_url %}
        <a href="{{ billing_portal_url }}" class="mel-button">{{ 'Manage payment method'|t }}</a>
      {% else %}
        <p class="mel-pro-manage__fallback">{{ 'Billing management online is not available yet. Contact support to update your payment method.'|t }}</p>
        {% if billing_support_url %}
          <a href="{{ billing_support_url }}" class="mel-button mel-button--secondary">{{ 'Contact support'|t }}</a>
        {% endif %}
      {% endif %}

      <a href="{{ path('myeventlane_vendor.console.dashboard') }}" class="mel-button mel-button--secondary">{{ 'Back to Dashboard'|t }}</a>
      {% if cancel_url %}
        <a href="{{ cancel_url }}" class="mel-button mel-button--secondary">{{ 'Cancel subscription'|t }}</a>
      {% endif %}
    </div>
  </div>

</div>
