{#
/**
 * @file
 * MEL Pro subscription home for organisers.
 */
#}
{% set status = pro_status|default({}) %}

<div class="mel-pro-manage">
  <header class="mel-pro-manage__hero">
    <div>
      <p class="mel-pro-manage__eyebrow"><span class="mel-pro-badge">PRO</span> {{ 'Your organiser plan'|t }}</p>
      <h1 class="mel-pro-manage__title">{{ 'MEL Pro'|t }}</h1>
      <p class="mel-pro-manage__intro">{{ 'More insight, stronger branding and reusable messaging tools for organisers who run events regularly.'|t }}</p>
    </div>
    <div class="mel-pro-manage__status mel-pro-manage__status--{{ status.state|default('inactive') }}">
      <span>{{ status.status_label|default(subscription_status) }}</span>
      <p>{{ status.status_message|default('') }}</p>
    </div>
  </header>

  {% if status.is_in_grace|default(false) or grace_days_remaining is not null %}
    <section class="mel-pro-manage__notice mel-pro-manage__notice--warning" role="alert">
      <strong>{{ 'Your payment needs attention'|t }}</strong>
      {% if grace_days_remaining is not null %}
        <p>{{ 'You have @days days remaining before Pro access is suspended.'|t({'@days': grace_days_remaining}) }}</p>
      {% else %}
        <p>{{ 'Update your payment method to keep your Pro tools available.'|t }}</p>
      {% endif %}
    </section>
  {% elseif renewal_in_days is not null %}
    <p class="mel-pro-manage__renewal">{{ 'Your plan renews in @days days.'|t({'@days': renewal_in_days}) }}</p>
  {% endif %}

  <div class="mel-pro-manage__grid">
    <section class="mel-pro-manage__card mel-card" aria-labelledby="mel-pro-included-heading">
      <p class="mel-pro-manage__eyebrow">{{ 'Included with your plan'|t }}</p>
      <h2 id="mel-pro-included-heading">{{ 'Your Pro toolkit'|t }}</h2>
      <p>{{ 'Use these tools when you are ready to understand your audience, strengthen your brand and invite people back.'|t }}</p>
      <div class="mel-pro-manage__benefits">
        <a class="mel-pro-manage__benefit" href="{{ path('myeventlane_analytics.dashboard') }}">
          <strong>{{ 'Deeper analytics'|t }}</strong>
          <span>{{ 'See event performance and more detailed organiser insights.'|t }}</span>
        </a>
        <a class="mel-pro-manage__benefit" href="{{ path('myeventlane_vendor.console.messages') }}">
          <strong>{{ 'Pro email templates'|t }}</strong>
          <span>{{ 'Create reusable branded messaging for your guests.'|t }}</span>
        </a>
        <a class="mel-pro-manage__benefit" href="{{ path('myeventlane_vendor.console.marketing') }}">
          <strong>{{ 'Marketing and branding tools'|t }}</strong>
          <span>{{ 'Keep your organiser identity consistent as you promote events.'|t }}</span>
        </a>
      </div>
    </section>

    <section class="mel-pro-manage__card mel-card" aria-labelledby="mel-pro-plan-heading">
      <p class="mel-pro-manage__eyebrow">{{ 'Subscription details'|t }}</p>
      <h2 id="mel-pro-plan-heading">{{ plan_label|default('MEL Pro') }}</h2>
      <dl class="mel-pro-manage__details">
        <div class="mel-pro-manage__row">
          <dt>{{ 'Billing'|t }}</dt>
          <dd>{{ billing_schedule_label|default('Monthly'|t) }}</dd>
        </div>
        <div class="mel-pro-manage__row">
          <dt>{{ 'Status'|t }}</dt>
          <dd><span class="mel-badge mel-badge--success">{{ subscription_status }}</span></dd>
        </div>
        {% if started_date %}
          <div class="mel-pro-manage__row"><dt>{{ 'Started'|t }}</dt><dd>{{ started_date }}</dd></div>
        {% endif %}
        {% if next_billing_date %}
          <div class="mel-pro-manage__row"><dt>{{ 'Next billing date'|t }}</dt><dd>{{ next_billing_date }}</dd></div>
        {% endif %}
      </dl>

      {% if roi_summary %}
        <div class="mel-pro-manage__value-note">
          <strong>{{ 'Value this month'|t }}</strong>
          {% if roi_summary.roi_multiple > 0 %}
            <p>{{ 'Pro recovery tools have returned @times times the monthly plan cost.'|t({'@times': roi_summary.roi_multiple|number_format(1)}) }}</p>
          {% else %}
            <p>{{ 'No recovered revenue has been attributed to Pro tools yet this month.'|t }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="mel-pro-manage__actions">
        {% if billing_portal_enabled and billing_portal_url %}
          <a href="{{ billing_portal_url }}" class="mel-button mel-button--primary">{{ 'Manage billing'|t }}</a>
        {% else %}
          <p class="mel-pro-manage__fallback">{{ 'Need to change your payment method or billing details? Our support team can help.'|t }}</p>
          <a href="{{ billing_support_url|default('/vendor/support') }}" class="mel-button mel-button--primary">{{ 'Contact support'|t }}</a>
        {% endif %}
        {% if cancel_url %}
          <div class="mel-pro-manage__cancel">
            <a href="{{ cancel_url }}" class="mel-button mel-button--secondary mel-pro-manage__cancel-button">{{ 'Cancel at period end'|t }}</a>
            <span>
              {% if next_billing_date %}
                {{ 'Your Pro access will continue until @date.'|t({'@date': next_billing_date}) }}
              {% else %}
                {{ 'Your Pro access will continue until the end of your current paid period.'|t }}
              {% endif %}
            </span>
          </div>
        {% endif %}
      </div>
    </section>
  </div>

  <aside class="mel-pro-manage__help">
    <div>
      <strong>{{ 'Not sure which Pro tool to use next?'|t }}</strong>
      <p>{{ 'Start with Analytics to see what is working, then use Messages or Marketing to invite your audience back.'|t }}</p>
    </div>
    <a href="/vendor/support" class="mel-button mel-button--secondary">{{ 'Ask for help'|t }}</a>
  </aside>
</div>
