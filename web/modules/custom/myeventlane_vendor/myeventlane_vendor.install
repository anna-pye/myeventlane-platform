          '@message' => $e->getMessage(),
        ]);
        $messages[] = "ERROR storage {$field_name}: " . $e->getMessage();
        continue;
      }
    }
    else {
      $messages[] = "Storage exists: {$field_name}";
    }

    $field = \Drupal\field\Entity\FieldConfig::loadByName('myeventlane_vendor', 'myeventlane_vendor', $field_name);

    if (!$field) {
      try {
        $field = \Drupal\field\Entity\FieldConfig::create($config['field']);
        $field->save();
        $messages[] = "Created instance: {$field_name}";
      }
      catch (\Exception $e) {
        \Drupal::logger('myeventlane_vendor')->error('Failed to create field instance @field: @message', [
          '@field' => $field_name,
          '@message' => $e->getMessage(),
        ]);
        $messages[] = "ERROR instance {$field_name}: " . $e->getMessage();
      }
    }
    else {
      $messages[] = "Instance exists: {$field_name}";
    }
  }

  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  \Drupal::entityTypeManager()->clearCachedDefinitions();

  return implode(' | ', $messages);
}

/**
 * Install nudges_enabled base field on vendor entity.
 *
 * Adds a boolean opt-in field so vendors can enable educational nudges on
 * their dashboard. Default value is 0 (disabled).
 */
function myeventlane_vendor_update_10014(): string {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  // Check if the field storage already exists.
  $existing = $entity_definition_update_manager->getFieldStorageDefinition('nudges_enabled', 'myeventlane_vendor');
  if ($existing) {
    return 'nudges_enabled field already installed — skipped.';
  }

  // Retrieve the field definition from the entity class.
  $entity_type = \Drupal::entityTypeManager()->getDefinition('myeventlane_vendor');
  $base_field_definitions = Vendor::baseFieldDefinitions($entity_type);

  if (!isset($base_field_definitions['nudges_enabled'])) {
    throw new \RuntimeException('nudges_enabled base field definition not found in Vendor::baseFieldDefinitions().');
  }

  $entity_definition_update_manager->installFieldStorageDefinition(
    'nudges_enabled',
    'myeventlane_vendor',
    'myeventlane_vendor',
    $base_field_definitions['nudges_enabled'],
  );

  // Clear cached field definitions so Drupal picks up the new column.
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  \Drupal::entityTypeManager()->clearCachedDefinitions();

  return 'Installed nudges_enabled base field on vendor entity.';
}

