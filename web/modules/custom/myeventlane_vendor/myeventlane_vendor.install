/**
 * Registers Pro analytics permission rollout notes.
 */
function myeventlane_vendor_update_10017(): string {
  \Drupal::logger('myeventlane_vendor')->notice('Permission "use pro financial analytics" added. No automatic role grants were applied; Pro access is enforced per vendor via VendorSubscriptionService.');
