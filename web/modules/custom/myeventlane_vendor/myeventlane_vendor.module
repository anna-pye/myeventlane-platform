declare(strict_types=1);

/**
 * @file
 * Primary module file for MyEventLane Vendor.
 */

use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\myeventlane_vendor\Entity\Vendor;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;
use Symfony\Component\Routing\Exception\RouteNotFoundException;

/**
 * Implements hook_user_login().
 */
function myeventlane_vendor_user_login(UserInterface $account): void {
  \Drupal::service('myeventlane_vendor.vendor_store_subscriber')->ensureLinkedStoreForVendorUser($account);
}

/**
 * Implements hook_theme().
 */
function myeventlane_vendor_theme($existing, $type, $theme, $path): array {
  $main_theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  $vendor_theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_vendor_theme');
  return [
    'myeventlane_vendor_list' => [
      'variables' => ['vendors' => NULL],
      'template' => 'myeventlane-vendor-list',
    ],
    'myeventlane_vendor_detail' => [
      'variables' => ['vendor' => NULL],
      'template' => 'myeventlane-vendor-detail',
    ],
    // Vendor public profile page template.
    'entity__myeventlane_vendor__full' => [
      'variables' => [
        'entity' => NULL,
        'view_mode' => 'full',
        'content' => [],
        'label' => '',
        'vendor_id' => NULL,
        'banner' => NULL,
        'logo' => NULL,
        'tagline' => '',
        'description' => NULL,
        'contact' => [],
        'events' => [],
        'is_authenticated' => FALSE,
        'is_following' => FALSE,
        'follower_count' => 0,
        'follow_url' => NULL,
        'attributes' => NULL,
        'title_attributes' => NULL,
      ],
      'template' => 'entity--myeventlane-vendor--full',
      'path' => \Drupal::service('extension.list.theme')->getPath('myeventlane_theme') . '/templates',
    ],
    'myeventlane_vendor_analytics' => [
      'variables' => [
        'vendor' => NULL,
        'analytics' => [],
        'events' => [],
      ],
      'template' => 'myeventlane-vendor-analytics',
    ],
    'myeventlane_manage_event' => [
      'variables' => [
        'event' => NULL,
        'steps' => [],
        'current_step' => NULL,
        'content' => NULL,
        'placeholder_shell' => FALSE,
      ],
      'template' => 'myeventlane-manage-event',
    ],
    'myeventlane_manage_series_instances_content' => [
      'variables' => [
        'instance_rows' => [],
        'generate_url' => NULL,
        'empty' => TRUE,
      ],
      'template' => 'myeventlane-manage-series-instances-content',
    ],
    'vendor_onboard_step' => [
      'render element' => 'form',
      'template' => 'vendor-onboard-step',
    ],
    'myeventlane_vendor_console_page' => [
      'variables' => [
        'title' => NULL,
        'header_actions' => [],
        'tabs' => [],
        'body' => NULL,
        'content' => NULL,
        'workspace' => NULL,
      ],
      'template' => 'vendor-console-page',
      'preprocess functions' => [
        'myeventlane_vendor.vendor_console_page_preprocess:preprocess',
      ],
    ],
    // Celebration page at /vendor/onboard/complete (no ?auto=1).
    'vendor_onboard_complete_celebration' => [
      'variables' => [
        'create_event_url' => NULL,
        'dashboard_url' => NULL,
      ],
      'template' => 'vendor-onboard-complete-celebration',
    ],
    // "Complete your organiser setup" page when onboarding incomplete at gateway.
    'create_event_gateway_complete_setup' => [
      'variables' => [
        'title' => '',
        'incomplete_stages' => [],
        'next_route' => NULL,
        'next_url' => NULL,
        'auto_url' => NULL,
      ],
      'template' => 'create-event-gateway-complete-setup',
    ],
    // Used in onboarding flash/CTA contexts. Must be available even when the
    // vendor theme is not the active theme to avoid theme hook warnings.
    'myeventlane_vendor_onboarding_panel' => [
      'variables' => [
        'stage_label' => NULL,
        'flags' => [],
        'next_action' => ['route_name' => NULL, 'title' => ''],
        'vendor' => NULL,
      ],
      'template' => 'components/vendor-onboarding-panel',
      'path' => \Drupal::service('extension.list.theme')->getPath('myeventlane_vendor_theme') . '/templates',
    ],
    'myeventlane_vendor_events_grid' => [
      'variables' => [
        'events' => [],
        'vendor_event_index_model' => NULL,
      ],
      'template' => 'myeventlane-vendor-events-grid',
      'path' => $vendor_theme_path . '/templates',
    ],
    'myeventlane_vendor_help_panel' => [
      'variables' => [
        'data' => [
          'global' => [
            'revenue' => 0,
            'events_total' => 0,
            'events_published' => 0,
            'conversion_hint' => '',
          ],
          'event' => NULL,
        ],
        'show_boost' => FALSE,
      ],
      'template' => 'vendor/help-panel',
    ],
  ];
}

/**
 * Implements hook_entity_base_field_info().
 */
function myeventlane_vendor_entity_base_field_info(EntityTypeInterface $entity_type): array {
  if ($entity_type->id() !== 'myeventlane_vendor') {
    return [];
  }

  $fields = [];
  $fields['is_pro'] = BaseFieldDefinition::create('boolean')
    ->setLabel(t('Pro vendor'))
    ->setDescription(t('Marks whether this vendor has an active Pro subscription.'))
    ->setDefaultValue(FALSE)
    ->setDisplayOptions('form', [
      'type' => 'boolean_checkbox',
      'weight' => 96,
    ])
    ->setDisplayConfigurable('form', TRUE)
    ->setDisplayConfigurable('view', FALSE);

  return $fields;
}

/**
 * Alters resolved Pro state for a vendor.
 */
function myeventlane_vendor_is_pro_vendor_alter(bool &$is_pro, int $vendor_id): void {
  // Intentionally empty. Billing integrations can alter $is_pro here.
}

/**
 * Implements hook_entity_insert().
 */
function myeventlane_vendor_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof Vendor) {
    \Drupal::service('myeventlane_vendor.vendor_store_subscriber')
      ->onVendorInsertFromHook($entity);
  }
}

/**
 * Implements hook_form_alter().
 *
 * IMPORTANT:
 * - NEVER touch login, register, or password forms.
 * - NEVER override #action globally.
 */
function myeventlane_vendor_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {

  // 🚫 Absolutely never alter authentication forms.
  if (in_array($form_id, [
    'user_login_form',
    'user_login_block_form',
    'user_register_form',
    'user_pass',
    'user_pass_reset',
  ], TRUE)) {
    return;
  }

  // Onboarding profile step uses dedicated VendorOnboardProfileForm (not entity form).
  // Only vendor-domain cosmetic/UX changes are allowed for vendor entity forms.
  if (!\Drupal::service('myeventlane_core.domain_detector')->isVendorDomain()) {
    return;
  }
}

/**
 * Implements hook_form_user_register_form_alter().
 */
function myeventlane_vendor_form_user_register_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  $is_vendor = \Drupal::request()->query->get('vendor') === '1';
  $form_state->set('is_vendor_registration', $is_vendor);

  if ($is_vendor && isset($form['actions']['submit'])) {
    $form['actions']['submit']['#submit'][] =
      '_myeventlane_vendor_redirect_to_onboard';
  }
}

/**
 * Redirect vendor registrations to onboarding.
 */
function _myeventlane_vendor_redirect_to_onboard(
  array $form,
  FormStateInterface $form_state,
): void {
  if ($form_state->get('is_vendor_registration')) {
    $form_state->setRedirect('myeventlane_vendor.onboard.profile');
  }
}

/**
 * Helper: Get vendor IDs associated with a user.
 */
function _myeventlane_vendor_get_user_vendors(int $uid): array {
  $storage = \Drupal::entityTypeManager()->getStorage('myeventlane_vendor');

  $ids = array_merge(
    $storage->getQuery()->condition('uid', $uid)->execute() ?: [],
    $storage->getQuery()->condition('field_vendor_users', $uid)->execute() ?: []
  );

  return array_values(array_unique(array_map('intval', $ids)));
}

/**
 * Implements hook_page_attachments_alter().
 */
function myeventlane_vendor_page_attachments_alter(array &$attachments): void {
  $route = \Drupal::routeMatch()->getRouteName();

  if ($route && str_starts_with($route, 'myeventlane_vendor.')) {
    $attachments['#attached']['library'][] =
      'myeventlane_vendor/hide_admin_sidebar';
  }

  if ($route && (
    str_starts_with((string) $route, 'myeventlane_vendor.') ||
    str_starts_with((string) $route, 'myeventlane_event_studio.') ||
    str_starts_with((string) $route, 'myeventlane_dashboard.')
  )) {
    $attachments['#attached']['library'][] = 'myeventlane_vendor/stripe_connect_cta';
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * - vendor_card view mode: PHP-built thumbnail, removal dialog payload, tickets
 *   URL for organiser bulk list on /vendor/events.
 */
function myeventlane_vendor_preprocess_node(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'vendor_card') {
    return;
  }

  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'event') {
    return;
  }

  /** @var \Drupal\myeventlane_vendor\Service\VendorEventRemovalService $removal */
  $removal = \Drupal::service('myeventlane_vendor.vendor_event_removal');
  $account = \Drupal::currentUser();
  $variables['mel_event_card_image'] = $removal->buildEventThumbnailData($node);
  $variables['mel_event_removal'] = $removal->buildRemovalUiPayload($node, $account);
  $variables['mel_event_tickets_url'] = _myeventlane_vendor_vendor_card_tickets_url($node, $account);

  if (isset($variables['content']['field_event_image'])) {
    unset($variables['content']['field_event_image']);
  }
}

/**
 * Builds tickets deep-link URL for vendor_card when route access allows.
 */
function _myeventlane_vendor_vendor_card_tickets_url(NodeInterface $node, AccountInterface $account): ?string {
  $route_name = 'myeventlane_vendor.console.event_tickets';
  $route_provider = \Drupal::service('router.route_provider');
  try {
    $route_provider->getRouteByName($route_name);
  }
  catch (RouteNotFoundException) {
    return NULL;
  }

  $params = ['event' => (int) $node->id()];
  try {
    /** @var \Drupal\Core\Access\AccessManagerInterface $access */
    $access = \Drupal::service('access_manager');
    $result = $access->checkNamedRoute($route_name, $params, $account, TRUE);
    if (!$result instanceof AccessResultInterface || !$result->isAllowed()) {
      return NULL;
    }
  }
  catch (\Throwable) {
    return NULL;
  }

  try {
    return Url::fromRoute($route_name, $params)->toString();
  }
  catch (\Throwable) {
    return NULL;
  }
}

/**
 * Submit handler: publish event.
 */
function _myeventlane_vendor_publish_event(
  array &$form,
  FormStateInterface $form_state,
): void {
  $entity = $form_state->getFormObject()->getEntity();

  if ($entity instanceof NodeInterface) {
    $entity->setPublished();
    \Drupal::messenger()->addStatus(t('Event published.'));
    $form_state->setRedirect('myeventlane_vendor.console.events');
  }
}

/**
 * Submit handler: save draft.
 */
function _myeventlane_vendor_save_draft(
  array &$form,
  FormStateInterface $form_state,
): void {
  $entity = $form_state->getFormObject()->getEntity();

  if ($entity instanceof NodeInterface) {
    $entity->setUnpublished();
    \Drupal::messenger()->addStatus(t('Draft saved.'));
    $form_state->setRedirect('myeventlane_vendor.console.events');
  }
}
