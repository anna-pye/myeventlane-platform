{#
/**
 * @file
 * Read-only card body for one mel_ticket_type (actions stay in the form tree).
 */
#}
{% if status_badges is not empty %}
  <ul class="mel-ticket-status-badges" aria-label="{{ 'Status'|t }}">
    {% for badge in status_badges %}
      <li><span class="{{ badge.class }}">{{ badge.label }}</span></li>
    {% endfor %}
  </ul>
{% endif %}

<div class="mel-ticket-header">
  <div>
    <strong>{{ label }}</strong>
    <div class="mel-ticket-kind">{{ kind_label }}</div>
  </div>
  <span class="mel-ticket-price">{{ price_display }}</span>
</div>

<div class="mel-ticket-meta">
  <span>{{ 'Capacity:'|t }} {{ capacity_display }}</span>
  <span>{{ 'Sales window:'|t }} {{ sales_label }}</span>
</div>

{% if sales_summary %}
  <div class="mel-ticket-sales-summary" role="status">
    {{ sales_summary }}
  </div>
{% endif %}
