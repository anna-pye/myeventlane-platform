{#
/**
 * @file
 * Vendor directory list template.
 *
 * Variables:
 * - vendors: Array of prepared vendor card data.
 */
#}
<div class="mel-vendor-directory">
  {% if vendors is not empty %}
    <div class="mel-vendor-grid">
      {% for vendor in vendors %}
        {% include '@myeventlane_theme/components/vendor-card.html.twig' with vendor %}
      {% endfor %}
    </div>

    {{ pager }}
  {% else %}
    <div class="mel-vendor-directory__empty mel-empty mel-empty--vendors" role="status">
      <h2 class="mel-empty__title">{{ 'No organisers listed yet'|t }}</h2>
      <p class="mel-empty__text">{{ 'When organisers publish on MyEventLane, they appear here. You can still browse events on the marketplace.'|t }}</p>
      <p class="mel-empty__next">
        <a class="mel-btn mel-btn--primary" href="{{ path('view.upcoming_events.page_events') }}">{{ 'Browse events'|t }}</a>
        <a class="mel-btn mel-btn--secondary" href="{{ path('myeventlane_vendor.create_event_gateway') }}">{{ 'Become an organiser'|t }}</a>
      </p>
    </div>
  {% endif %}
</div>
