    return;
  }
  if (!is_array($raw)) {
    $raw = [];
  }
  $variables['attributes'] = new \Drupal\Core\Template\Attribute($raw);
}

/**
 * Implements hook_element_info_alter().
 */
function myeventlane_surface_element_info_alter(array &$info): void {
  if (!isset($info['form'])) {
    return;
  }
  $info['form']['#pre_render'][] = [Drupal\myeventlane_surface\MelFormRootPreRenderBridge::class, 'preRender'];
}

/**
 * Implements hook_preprocess_HOOK() for mel_surface_customer_profile_settings.
 */
function myeventlane_surface_preprocess_mel_surface_customer_profile_settings(array &$variables): void {
  if (!\Drupal::hasService('myeventlane_surface.form_manager')) {
    return;
  }
  /** @var \Drupal\myeventlane_surface\MelFormManager $manager */
  $manager = \Drupal::service('myeventlane_surface.form_manager');
  if ($manager->shouldGovernForms()) {
    $variables['mel_form_classification'] = $manager->getClassification()->value;
  }
}

