/**
 * Implements hook_preprocess_HOOK() for mel_intelligence_panel.
 */
function myeventlane_surface_preprocess_mel_intelligence_panel(array &$variables): void {
  $raw = $variables['attributes'] ?? [];
  if ($raw instanceof \Drupal\Core\Template\Attribute) {
    return;
  }
  if (!is_array($raw)) {
    $raw = [];
  }
  $variables['attributes'] = new \Drupal\Core\Template\Attribute($raw);
}

/**
 * Implements hook_preprocess_HOOK() for mel_observability_panel.
 */
function myeventlane_surface_preprocess_mel_observability_panel(array &$variables): void {
  $raw = $variables['attributes'] ?? [];
