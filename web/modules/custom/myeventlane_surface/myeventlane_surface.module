/**
 * Implements hook_preprocess_HOOK() for myeventlane_order_detail.
 *
 * Adds governed order-state vocabulary for customer presentation (MELStateSystem).
 */
function myeventlane_surface_preprocess_myeventlane_order_detail(array &$variables): void {
  if (!isset($variables['order']) || !is_array($variables['order'])) {
    return;
  }
  $order_entity = $variables['order']['order'] ?? NULL;
  if (!is_object($order_entity) || !method_exists($order_entity, 'getState')) {
    return;
  }
  if (!\Drupal::hasService('myeventlane_surface.state_readiness_helper')) {
    return;
  }
  /** @var \Drupal\myeventlane_core\MelReadinessHelper $helper */
  $helper = \Drupal::service('myeventlane_surface.state_readiness_helper');
  $variables['order']['state_customer_presentation'] = $helper->customerCommerceOrderStateLabel(
    (string) $order_entity->getState()->getId(),
    (string) $order_entity->getState()->getLabel()
  );
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_my_tickets.
 */
function myeventlane_surface_preprocess_myeventlane_my_tickets(array &$variables): void {
  if (!\Drupal::hasService('myeventlane_surface.state_readiness_helper')) {
    return;
  }
  /** @var \Drupal\myeventlane_core\MelReadinessHelper $helper */
  $helper = \Drupal::service('myeventlane_surface.state_readiness_helper');
  foreach (['upcoming_orders', 'past_orders'] as $delta_key) {
    if (!isset($variables[$delta_key]) || !is_array($variables[$delta_key])) {
      continue;
    }
    foreach ($variables[$delta_key] as &$row) {
      if (!is_array($row) || !isset($row['order'])) {
        continue;
      }
      $order_entity = $row['order'];
      if (!is_object($order_entity) || !method_exists($order_entity, 'getState')) {
        continue;
      }
      $row['state_customer_presentation'] = $helper->customerCommerceOrderStateLabel(
        (string) $order_entity->getState()->getId(),
        (string) $order_entity->getState()->getLabel()
      );
    }
    unset($row);
  }

  $upcoming = $variables['upcoming_orders'] ?? [];
  $past = $variables['past_orders'] ?? [];
  if (is_array($upcoming) && is_array($past) && $upcoming === [] && $past === [] && \Drupal::hasService('myeventlane_surface.governed_operational_templates')) {
    /** @var \Drupal\myeventlane_core\GovernedOperationalTemplates $templates */
    $templates = \Drupal::service('myeventlane_surface.governed_operational_templates');
    $variables['mel_my_tickets_empty'] = $templates->myTicketsOverviewEmpty();
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_my_categories.
 */
function myeventlane_surface_preprocess_myeventlane_my_categories(array &$variables): void {
  if (!\Drupal::hasService('myeventlane_surface.governed_operational_templates')) {
    return;
  }
  /** @var \Drupal\myeventlane_core\GovernedOperationalTemplates $templates */
  $templates = \Drupal::service('myeventlane_surface.governed_operational_templates');
  $followed = $variables['followed_categories'] ?? [];
  if (is_array($followed) && $followed === []) {
    $variables['mel_category_follow_empty'] = $templates->categoryFollowEmpty();
    return;
  }
  if (is_array($followed) && $followed !== []) {
    // Reused under each followed category when the weekly digest has no rows.
    $variables['mel_category_follow_section_no_new_events'] = $templates->categoryFollowWeeklyQuietEmpty();
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_analytics_dashboard.
 */
function myeventlane_surface_preprocess_myeventlane_analytics_dashboard(array &$variables): void {
  $model = $variables['analytics_model'] ?? [];
  if (!is_array($model)) {
    return;
  }
  $events = $model['events'] ?? [];
  if (!is_array($events) || $events !== []) {
    return;
  }
  if (!\Drupal::hasService('myeventlane_surface.governed_operational_templates')) {
    return;
  }
  /** @var \Drupal\myeventlane_core\GovernedOperationalTemplates $templates */
  $templates = \Drupal::service('myeventlane_surface.governed_operational_templates');
  $empty = $model['empty_state'] ?? [];
  $empty = is_array($empty) ? $empty : [];
  $has_legacy_copy = ($empty['title'] ?? '') !== '' || ($empty['message'] ?? '') !== '';
  $variables['mel_analytics_events_empty'] = $has_legacy_copy
    ? $templates->analyticsEventsEmptyFromLegacy($empty)
    : $templates->vendorAnalyticsNoEventRowsEmpty();
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_attendees_dashboard.
 */
function myeventlane_surface_preprocess_myeventlane_vendor_attendees_dashboard(array &$variables): void {
  $cards = $variables['mel_cards'] ?? [];
  $events = $variables['events'] ?? [];
  if (!is_array($cards) || !is_array($events)) {
    return;
  }
  // Mirror myeventlane-vendor-attendees-dashboard.html.twig: empty only when
  // there are no mel_cards and no legacy event rows.
  if ($cards !== [] || $events !== []) {
    return;
  }
  if (!\Drupal::hasService('myeventlane_surface.governed_operational_templates')) {
    return;
  }
  /** @var \Drupal\myeventlane_core\GovernedOperationalTemplates $templates */
  $templates = \Drupal::service('myeventlane_surface.governed_operational_templates');
  $variables['mel_vendor_attendees_dashboard_empty'] = $templates->vendorAttendeesDashboardEmpty();
}

/**
 * Implements hook_block_build_alter().
 */
function myeventlane_surface_block_build_alter(array &$build, \Drupal\Core\Block\BlockPluginInterface $block): void {
  \Drupal::service('myeventlane_surface.block_governor')->alter($build, $block);
}
