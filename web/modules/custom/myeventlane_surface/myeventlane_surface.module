/**
 * Registers universal preprocess for MELDataPresentationSystem theme hooks.
 *
 * @param array<string, mixed> $theme_registry
 */
function myeventlane_surface_theme_registry_alter(array &$theme_registry): void {
  foreach (_myeventlane_surface_data_presentation_theme_hooks() as $hook) {
    if (isset($theme_registry[$hook])) {
      $theme_registry[$hook]['preprocess functions'][] = 'myeventlane_surface_preprocess_mel_data_presentation';
    }
  }
  foreach (_myeventlane_surface_interaction_theme_hooks() as $hook) {
    if (isset($theme_registry[$hook])) {
      $theme_registry[$hook]['preprocess functions'][] = 'myeventlane_surface_preprocess_mel_interaction';
    }
  }
}

/**
 * @return list<string>
 */
function _myeventlane_surface_interaction_theme_hooks(): array {
  return [
    'mel_modal',
    'mel_modal_header',
    'mel_modal_body',
    'mel_modal_actions',
    'mel_modal_confirmation',
    'mel_drawer',
    'mel_toast',
    'mel_inline_notice',
    'mel_confirmation_banner',
    'mel_warning_banner',
    'mel_error_banner',
    'mel_processing_banner',
    'mel_saving_state',
    'mel_processing_state',
    'mel_retry_state',
    'mel_empty_loading',
    'mel_disclosure',
    'mel_expandable_section',
    'mel_advanced_settings',
    'mel_collapsible_panel',
  ];
}

/**
 * @param array<string, mixed> $variables
 */
function myeventlane_surface_preprocess_mel_interaction(array &$variables): void {
  $hook = (string) ($variables['theme_hook_original'] ?? '');
  if ($hook === '' || !\Drupal::hasService('myeventlane_surface.interaction_preprocess')) {
    return;
  }
  \Drupal::service('myeventlane_surface.interaction_preprocess')->preprocessForHook($hook, $variables);
}

function _myeventlane_surface_data_presentation_theme_hooks(): array {
  return [
    'mel_data_table',
    'mel_table_toolbar',
    'mel_table_empty',
    'mel_table_pagination',
    'mel_table_actions',
    'mel_table_status',
    'mel_metric_card',
    'mel_metric_grid',
    'mel_stat_panel',
    'mel_summary_bar',
    'mel_analytics_frame',
    'mel_activity_feed',
    'mel_activity_item',
    'mel_timeline',
    'mel_event_log',
    'mel_export_panel',
    'mel_export_notice',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for MEL data presentation themes.
 *
 * @param array<string, mixed> $variables
 */
function myeventlane_surface_preprocess_mel_data_presentation(array &$variables): void {
  $hook = (string) ($variables['theme_hook_original'] ?? '');
  if ($hook === '' || !\Drupal::hasService('myeventlane_surface.data_presentation_preprocess')) {
    return;
  }
  \Drupal::service('myeventlane_surface.data_presentation_preprocess')->preprocessForHook($hook, $variables);
}

/**
 * Dispatches MEL component preprocess normalisation.
 *
 * @param array<string, mixed> $variables
 */
function _myeventlane_surface_component_preprocess(string $hook, array &$variables): void {
  if (!\Drupal::hasService('myeventlane_surface.component_preprocess')) {
    return;
  }
  \Drupal::service('myeventlane_surface.component_preprocess')->preprocessForHook($hook, $variables);
}

/**
 * Implements hook_preprocess_HOOK() for MEL component theme hooks.
 */
function myeventlane_surface_preprocess_mel_card(array &$variables): void {
  _myeventlane_surface_component_preprocess('mel_card', $variables);
}

/**
 * Implements hook_preprocess_HOOK() for MEL component theme hooks.
 */
function myeventlane_surface_preprocess_mel_card_section(array &$variables): void {
  _myeventlane_surface_component_preprocess('mel_card_section', $variables);
}

