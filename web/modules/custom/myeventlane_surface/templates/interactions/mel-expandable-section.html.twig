{#
/**
 * @file
 * Expandable section — same interaction contract as mel_disclosure with layout modifier.
 */
#}
<section{{ attributes }}>
  <button{{ toggle_attributes }}>
    {% if toggle_content %}
      {{ toggle_content }}
    {% elseif toggle_label %}
      {{ toggle_label }}
    {% endif %}
  </button>
  <div{{ panel_attributes }}{% if not expanded %} hidden{% endif %}>
    {{ panel_content }}
  </div>
</section>
