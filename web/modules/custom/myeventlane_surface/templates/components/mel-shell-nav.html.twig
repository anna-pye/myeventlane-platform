{#
/**
 * @file
 * Canonical shell navigation list — classes from MELNavigationManager contract.
 */
#}
<nav{{ attributes }}>
  <div class="{{ nav_inner_classes|join(' ') }}">
    <ul class="{{ list_classes|join(' ') }}">
      {% for link in links %}
        <li class="{{ item_classes|join(' ') }}">
          <a href="{{ link.url }}" class="{{ link_classes|join(' ') }}{% if link.active %} {{ active_link_class }}{% endif %}"
            {% if link.active %} aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</nav>
