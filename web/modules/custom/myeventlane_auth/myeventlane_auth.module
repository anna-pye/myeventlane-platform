<?php

declare(strict_types=1);

/**
 * @file
 * MyEventLane SSO (OAuth2-style) for cross-subdomain authentication.
 */

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\user\UserInterface;
use Drupal\Core\Site\Settings;
use Drupal\myeventlane_auth\EventSubscriber\AccountSetupFlowSubscriber;
use Drupal\myeventlane_auth\EventSubscriber\MelPostLoginSessionRedirectSubscriber;
use Drupal\myeventlane_auth\Service\IdentityIntentResolver;
use Symfony\Component\HttpFoundation\ParameterBag;
use Symfony\Component\HttpFoundation\Request;

/**
 * Implements hook_cron().
 */
function myeventlane_auth_cron(): void {
  /** @var \Drupal\Core\Database\Connection $db */
  $db = \Drupal::database();
  $now = \Drupal::time()->getRequestTime();

  $db->delete('mel_auth_authorization_code')
    ->condition('expires', $now, '<')
    ->execute();

  $db->delete('mel_auth_refresh_token')
    ->condition('revoked', 1)
    ->condition('expires', $now - (90 * 24 * 60 * 60), '<')
    ->execute();
}

/**
 * Implements hook_mail_alter().
 *
 * Registration and password recovery share Drupal's one-time-login route. Add
 * an explicit presentation marker only to first-use registration emails.
 */
function myeventlane_auth_mail_alter(array &$message): void {
  if (
    ($message['module'] ?? '') !== 'user'
    || !in_array($message['key'] ?? '', [
      'register_admin_created',
      'register_no_approval_required',
    ], TRUE)
  ) {
    return;
  }

  $body = is_array($message['body'] ?? NULL)
    ? implode("\n", $message['body'])
    : (string) ($message['body'] ?? '');
  preg_match_all('~https?://[^\s<]+~i', $body, $matches);
  $urls = $matches[0] ?? [];
  $setup_url = rtrim((string) ($urls[0] ?? ''), '.,;:!?)');
  if ($setup_url === '') {
    return;
  }
  if (!str_contains($setup_url, 'mel_flow=account_setup')) {
    $setup_url .= str_contains($setup_url, '?') ? '&mel_flow=account_setup' : '?mel_flow=account_setup';
  }

  $site_name = (string) Drupal::config('system.site')->get('name');
  $site_name = $site_name !== '' ? $site_name : 'MyEventLane';
  $account = $message['params']['account'] ?? NULL;
  $display_name = $account instanceof AccountInterface
    ? $account->getDisplayName()
    : '';
  $intro = ($message['key'] ?? '') === 'register_admin_created'
    ? t('A MyEventLane administrator has created your account.')
    : t('Thank you for joining @site.', ['@site' => $site_name]);

  $message['subject'] = (string) t('Set up your @site account', ['@site' => $site_name]);
  $message['body'] = [implode("\n\n", array_filter([
    $display_name !== '' ? $display_name . ',' : '',
    (string) $intro . ' ' . (string) t('Use this secure link to choose your password and finish setting up your account:'),
    $setup_url,
    (string) t('This setup link can only be used once.'),
    (string) t('After setting your password, you can log in at @url.', [
      '@url' => Url::fromRoute('user.login', [], ['absolute' => TRUE])->toString(),
    ]),
    (string) t('-- MyEventLane team'),
  ]))];
  $message['params']['mel_account_setup'] = TRUE;
  $message['params']['account_setup_url'] = $setup_url;
}

/**
 * Resolves raw MEL intent for the login request (GET or POST).
 *
 * Priority: mel_intent (query/POST), intent (query/POST), then destination
 * (query/POST): path /create-event or /create-event/… maps to create_event (not
 * /create-event-copy, etc.); also inspects query strings inside destination.
 *
 * Used by the login form hidden field and hook_user_login() so behavior stays
 * in one place.
 */
function myeventlane_auth_resolve_mel_intent_for_login_request(Request $request): string {
  foreach ([
    [$request->query, 'mel_intent'],
    [$request->request, 'mel_intent'],
    [$request->query, 'intent'],
    [$request->request, 'intent'],
  ] as $pair) {
    [$bag, $key] = $pair;
    $raw = $bag->get($key);
    if (is_string($raw) && $raw !== '') {
      return $raw;
    }
  }

  foreach ([$request->query->get('destination'), $request->request->get('destination')] as $dest) {
    if (!is_string($dest) || $dest === '') {
      continue;
    }
    if (myeventlane_auth_destination_is_user_reset_path($dest)) {
      continue;
    }
    $from_dest = myeventlane_auth_resolve_intent_from_destination_value($dest, $request);
    if ($from_dest !== '') {
      return $from_dest;
    }
  }

  return '';
}

/**
 * Copies mel_intent, intent, and destination from the request query for auth links.
 *
 * Used so Gin Login’s login ↔ register links keep the same query as the page
 * (e.g. create-event handoff). Does not duplicate intent resolution.
 */
function myeventlane_auth_auth_preservation_query_from_request(Request $request): array {
  $query = [];
  foreach (['mel_intent', 'intent', 'destination'] as $key) {
    $v = $request->query->get($key);
    if (is_string($v) && $v !== '') {
      $query[$key] = $v;
    }
  }
  return $query;
}

/**
 * Build query for login↔register links when carrying auth handoff.
 *
 * Starts with a raw copy of the request query (see
 * myeventlane_auth_auth_preservation_query_from_request()).
 * When the resolved MEL intent is create_event, adds a canonical
 * top-level mel_intent + /create-event destination so the register and post-login
 * request stack always sees the same values IdentityIntentResolver reads from the
 * query, even when the login URL used a nested /mel/auth/continue destination.
 */
function myeventlane_auth_auth_entry_preserved_query(Request $request): array {
  $query = myeventlane_auth_auth_preservation_query_from_request($request);
  /** @var \Drupal\myeventlane_auth\Service\IdentityIntentResolver $resolver */
  $resolver = \Drupal::service('myeventlane_auth.identity_intent_resolver');
  $raw = myeventlane_auth_resolve_mel_intent_for_login_request($request);
  if ($resolver->normalizeIntent($raw) !== IdentityIntentResolver::INTENT_CREATE_EVENT) {
    return $query;
  }
  $query['mel_intent'] = IdentityIntentResolver::INTENT_CREATE_EVENT;
  $query['destination'] = '/create-event';
  return $query;
}

/**
 * Whether an internal path is the create-event route or a subpath (not a false prefix).
 *
 * Matches /create-event and /create-event/…; does not match /create-event-copy,
 * /create-eventuality, etc.
 */
function myeventlane_auth_path_implies_create_event_route(string $path_only): bool {
  return $path_only === '/create-event' || str_starts_with($path_only, '/create-event/');
}

/**
 * Whether the route is part of Drupal core password reset / one-time login flow.
 *
 * Matches user.reset, user.reset.login, user.reset.form, and any future user.reset.*.
 */
function myeventlane_auth_route_is_password_reset_flow(?string $route_name): bool {
  return is_string($route_name) && str_starts_with($route_name, 'user.reset');
}

/**
 * Whether query or POST parameters indicate core password reset / one-time login handoff.
 *
 * Aligns with myeventlane_auth_destination_is_user_reset_path() used by the login
 * form alter when stripping reset destinations from GET and POST.
 */
function myeventlane_auth_parameter_bag_indicates_password_reset_flow(ParameterBag $bag): bool {
  if ($bag->has('pass-reset-token')) {
    return TRUE;
  }
  $destination = $bag->get('destination');
  return is_string($destination)
    && $destination !== ''
    && myeventlane_auth_destination_is_user_reset_path($destination);
}

/**
 * Whether the request is part of core password reset (route, token, or destination).
 *
 * Covers the post-login step: /user/{uid}/edit?pass-reset-token=… where the route
 * is no longer user.reset.* but MEL must not run post-login routing.
 *
 * Inspects both the query string and the POST body (e.g. user login form submit)
 * so MEL cannot stage a hub redirect when a reset destination only appears in POST.
 */
function myeventlane_auth_is_password_reset_flow(Request $request): bool {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (myeventlane_auth_route_is_password_reset_flow($route_name)) {
    return TRUE;
  }
  foreach ([$request->query, $request->request] as $bag) {
    if (myeventlane_auth_parameter_bag_indicates_password_reset_flow($bag)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Whether a destination value points at password reset (must not drive mel_intent).
 */
function myeventlane_auth_destination_is_user_reset_path(string $dest): bool {
  $dest = trim(urldecode($dest));
  if ($dest === '') {
    return FALSE;
  }
  $lower = strtolower($dest);
  // One-time login handoff: /user/{uid}/edit?pass-reset-token=… (must not post-login redirect).
  if (str_contains($lower, 'pass-reset-token')) {
    return TRUE;
  }
  $path_part = $dest;
  if (preg_match('#^https?://#i', $dest)) {
    $parsed = parse_url($dest);
    if ($parsed === FALSE) {
      return FALSE;
    }
    $path_part = $parsed['path'] ?? '';
  }
  elseif (str_contains($dest, '?')) {
    $parts = explode('?', $dest, 2);
    $path_part = $parts[0];
  }
  return str_contains($path_part, '/user/reset');
}

/**
 * Derives intent from a destination parameter value, including nested URLs.
 *
 * Handles e.g. destination=/mel/auth/continue?destination=/create-event&mel_intent=create_event
 * (Create Event → auth continue handoff) where intent lives in the inner query string.
 */
function myeventlane_auth_resolve_intent_from_destination_value(string $dest, Request $request, int $depth = 0): string {
  if ($depth > 5) {
    return '';
  }

  $dest = trim(urldecode($dest));
  if ($dest === '') {
    return '';
  }

  if (myeventlane_auth_destination_is_user_reset_path($dest)) {
    return '';
  }

  $path_part = $dest;
  $query_string = '';
  if (preg_match('#^https?://#i', $dest)) {
    $parsed = parse_url($dest);
    if ($parsed === FALSE) {
      return '';
    }
    $path_part = $parsed['path'] ?? '';
    $query_string = $parsed['query'] ?? '';
  }
  elseif (str_contains($dest, '?')) {
    $parts = explode('?', $dest, 2);
    $path_part = $parts[0];
    $query_string = $parts[1] ?? '';
  }

  $path_only = $path_part;
  $base = $request->getBasePath();
  if ($base !== '' && str_starts_with($path_only, $base)) {
    $path_only = substr($path_only, strlen($base)) ?: '/';
  }
  if ($path_only !== '' && !str_starts_with($path_only, '/')) {
    $path_only = '/' . $path_only;
  }
  if ($path_only !== '' && myeventlane_auth_path_implies_create_event_route($path_only)) {
    return 'create_event';
  }

  if ($query_string !== '') {
    parse_str($query_string, $q);
    foreach (['mel_intent', 'intent'] as $key) {
      if (!empty($q[$key]) && is_string($q[$key]) && trim($q[$key]) !== '') {
        return trim($q[$key]);
      }
    }
    if (!empty($q['destination']) && is_string($q['destination'])) {
      return myeventlane_auth_resolve_intent_from_destination_value($q['destination'], $request, $depth + 1);
    }
  }

  return '';
}

/**
 * Whether the registration page should show create-event–specific messaging.
 *
 * Uses myeventlane_auth_resolve_mel_intent_for_login_request() and
 * IdentityIntentResolver (no PostLoginRouter duplication).
 */
function myeventlane_auth_register_page_is_create_event_flow(Request $request): bool {
  $raw = myeventlane_auth_resolve_mel_intent_for_login_request($request);
  /** @var \Drupal\myeventlane_auth\Service\IdentityIntentResolver $resolver */
  $resolver = \Drupal::service('myeventlane_auth.identity_intent_resolver');
  return $resolver->normalizeIntent($raw) === IdentityIntentResolver::INTENT_CREATE_EVENT;
}

/**
 * Implements hook_form_user_register_form_alter().
 *
 * Minimal signup UI: hide optional components (presentation only). Runs for any
 * theme, including Gin Login on /user/register.
 */
function myeventlane_auth_form_user_register_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $is_public_registration = !\Drupal::currentUser()->hasPermission('administer users');
  $is_vendor_registration = \Drupal::request()->query->get('vendor') === '1'
    || str_contains((string) \Drupal::request()->query->get('destination', ''), '/vendor/onboard');

  foreach ([
    'user_picture',
    'contact',
    'timezone',
    'path',
    'language',
    'vendor_profiles',
  ] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  if ($is_public_registration) {
    $form_state->set('is_public_registration', TRUE);
    if ($is_vendor_registration) {
      $form_state->set('is_vendor_registration', TRUE);
    }
    if (isset($form['account']['name'])) {
      $form['account']['name']['#access'] = FALSE;
    }
    elseif (isset($form['name'])) {
      $form['name']['#access'] = FALSE;
    }
    // Must run before RegisterForm::validateForm() copies values and entity validates.
    $form['#validate'] ??= [];
    array_unshift($form['#validate'], 'myeventlane_auth_public_register_prepare_identity');
    $existing_vendor_cache = $form['#cache']['contexts'] ?? [];
    $form['#cache']['contexts'] = array_values(array_unique(array_merge($existing_vendor_cache, [
      'url.query_args:vendor',
      'url.query_args:destination',
    ])));

    $form['mel_registration_privacy'] = [
      '#type' => 'container',
      '#weight' => -20,
      '#attributes' => [
        'class' => ['mel-registration-privacy'],
        'role' => 'note',
      ],
      'message' => [
        '#type' => 'html_tag',
        '#tag' => 'p',
        '#value' => t('Your account details stay private. Public community profiles are optional and can be created later. We’ll email you a secure link to verify your address and choose a password.'),
      ],
    ];

    if ($is_vendor_registration) {
      $form['mel_intent'] = [
        '#type' => 'hidden',
        '#value' => IdentityIntentResolver::INTENT_CREATE_EVENT,
      ];
      $form['actions']['submit']['#submit'] ??= [];
      if (!in_array('myeventlane_auth_user_register_form_post_save_redirect', $form['actions']['submit']['#submit'], TRUE)) {
        $form['actions']['submit']['#submit'][] = 'myeventlane_auth_user_register_form_post_save_redirect';
      }
    }
  }
  foreach (['field_marketing', 'field_vendor'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  if (\Drupal::routeMatch()->getRouteName() !== 'user.register') {
    return;
  }

  $request = \Drupal::request();

  // Gin Login: "Log in" link defaults to user.login with no query — preserve handoff.
  if (isset($form['more-links']['login_link']['#url'])) {
    $preserve_login = myeventlane_auth_auth_entry_preserved_query($request);
    if ($preserve_login !== []) {
      $form['more-links']['login_link']['#url'] = Url::fromRoute('user.login', [], ['query' => $preserve_login]);
      $existing_ctx = $form['#cache']['contexts'] ?? [];
      $form['#cache']['contexts'] = array_values(array_unique(array_merge($existing_ctx, [
        'url.query_args:destination',
        'url.query_args:mel_intent',
        'url.query_args:intent',
      ])));
    }
  }

  if (!myeventlane_auth_register_page_is_create_event_flow($request)) {
    return;
  }

  $resolved_for_log = myeventlane_auth_resolve_mel_intent_for_login_request($request);
  $dest_for_log = $request->query->get('destination');
  // Temporary: remove after create-event signup→/mel/post-login handoff is verified in logs.
  \Drupal::logger('myeventlane_auth')->info('MEL auth handoff: register GET create-event context resolved_intent=@intent destination=@dest', [
    '@intent' => $resolved_for_log,
    '@dest' => is_string($dest_for_log) ? $dest_for_log : '',
  ]);

  $raw_intent = $resolved_for_log;
  if ($raw_intent === '') {
    $raw_intent = IdentityIntentResolver::INTENT_CREATE_EVENT;
  }

  $form['mel_intent'] = [
    '#type' => 'hidden',
    '#value' => $raw_intent,
  ];

  // Temporary: remove after create-event signup→/mel/post-login handoff is verified in logs.
  \Drupal::logger('myeventlane_auth')->info('MEL auth handoff: register form mel_intent hidden added value=@v', [
    '@v' => $raw_intent,
  ]);

  $existing_cache = $form['#cache']['contexts'] ?? [];
  $form['#cache']['contexts'] = array_values(array_unique(array_merge($existing_cache, [
    'url.query_args:destination',
    'url.query_args:mel_intent',
    'url.query_args:intent',
  ])));

  $form['actions']['submit']['#submit'][] = 'myeventlane_auth_user_register_form_post_save_redirect';
}

/**
 * Presents first-use registration links as account setup, not password reset.
 */
function myeventlane_auth_form_user_pass_reset_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
  if (
    \Drupal::request()->getSession()->get(AccountSetupFlowSubscriber::SESSION_KEY) !== (string) \Drupal::routeMatch()->getParameter('uid')
    || $form_id !== 'user_pass_reset'
  ) {
    return;
  }

  $form['#title'] = t('Set up your account');
  $form['message'] = [
    '#markup' => '<p>' . t('Welcome to MyEventLane. Continue to choose your password and finish setting up your account.') . '</p>',
  ];
  $form['help'] = [
    '#markup' => '<p>' . t('For your security, this setup link can only be used once.') . '</p>',
  ];
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('Continue');
  }
  $form['#attributes']['class'][] = 'mel-account-setup-form';
}

/**
 * Implements hook_preprocess_ginlogin().
 *
 * Applies account-setup language and release-owned image fallbacks to the Gin
 * Login shell. Admin-managed images remain authoritative while they exist.
 */
function myeventlane_auth_preprocess_ginlogin(array &$variables): void {
  $request = \Drupal::request();
  $uid = (string) \Drupal::routeMatch()->getParameter('uid');
  if (
    \Drupal::routeMatch()->getRouteName() === 'user.reset.form'
    && $request->getSession()->get(AccountSetupFlowSubscriber::SESSION_KEY) === $uid
  ) {
    $variables['title'] = t('Set up your account');
    $variables['mel_account_setup'] = TRUE;
  }

  $config = \Drupal::config('gin_login.settings');
  $base = rtrim($request->getSchemeAndHttpHost() . $request->getBasePath(), '/');
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');

  $logo_uri = (string) $config->get('logo.path');
  if (!$config->get('logo.use_default') && $logo_uri !== '' && !file_exists($logo_uri)) {
    $variables['icon_path'] = $base . '/' . $theme_path . '/images/myeventlane-logo.png';
  }

  $brand_uri = (string) $config->get('brand_image.path');
  if (!$config->get('brand_image.use_default') && $brand_uri !== '' && !file_exists($brand_uri)) {
    $variables['brand_image'] = [
      '#theme' => 'image',
      '#uri' => $base . '/' . $theme_path . '/images/mel/mel-mascot-round.png',
      '#attributes' => [
        'loading' => 'lazy',
        'alt' => '',
      ],
    ];
  }
}

/**
 * Implements hook_gin_login_route_definitions_alter().
 */
function myeventlane_auth_gin_login_route_definitions_alter(array &$route_definitions): void {
  foreach ($route_definitions as &$definition) {
    $definition['preprocess functions'][] = 'myeventlane_auth_preprocess_ginlogin';
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function myeventlane_auth_theme_registry_alter(array &$theme_registry): void {
  if (!isset($theme_registry['page__user__password'])) {
    return;
  }
  $theme_registry['page__user__password']['template'] = 'page--user--password-mel';
  $theme_registry['page__user__password']['path'] = \Drupal::service('extension.list.module')
    ->getPath('myeventlane_auth') . '/templates';
}

/**
 * Prepares private identity fields for public self-registration.
 */
function myeventlane_auth_public_register_prepare_identity(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->get('is_public_registration')) {
    return;
  }

  /** @var \Drupal\myeventlane_auth\Service\PublicRegistrationUsernameGenerator $generator */
  $generator = \Drupal::service('myeventlane_auth.public_registration_username_generator');
  $username = $generator->generate();
  $form_state->setValue('name', $username);

  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $account = $form_object->getEntity();
  if (!$account instanceof UserInterface) {
    return;
  }
  $account->setUsername($username);
  if ($account->hasField('field_display_name') && $account->get('field_display_name')->isEmpty()) {
    $account->set('field_display_name', t('Member'));
  }
}

/**
 * Submit handler: after self-registration with create_event intent, send the user
 * to organiser profile onboarding; destination is /create-event for after completion.
 *
 * verify_mail: pending intent is stored; first real login is still handled by PostLoginRouter.
 *
 * When user.settings:verify_mail is TRUE, RegisterForm::save() does not call
 * user_login_finalize(); the user is not authenticated in this request. In that
 * case we store pending_mel_intent in user.data for the new account; hook_user_login()
 * and PostLoginRouter merge it on first login (see IdentityIntentResolver::USER_DATA_PENDING_MEL_INTENT).
 */
function myeventlane_auth_user_register_form_post_save_redirect(array &$form, FormStateInterface $form_state): void {
  if ($form_state->getValue('administer_users')) {
    return;
  }

  /** @var \Drupal\myeventlane_auth\Service\IdentityIntentResolver $resolver */
  $resolver = \Drupal::service('myeventlane_auth.identity_intent_resolver');
  $raw = $form_state->getValue('mel_intent');
  if (!is_string($raw) || $raw === '') {
    $raw = myeventlane_auth_resolve_mel_intent_for_login_request(\Drupal::request());
  }
  if ($resolver->normalizeIntent($raw) !== IdentityIntentResolver::INTENT_CREATE_EVENT) {
    return;
  }

  if (!\Drupal::currentUser()->isAuthenticated()) {
    $uid = (int) $form_state->getValue('uid');
    if ($uid <= 0) {
      $account = $form_state->get('user');
      if ($account instanceof UserInterface) {
        $uid = (int) $account->id();
      }
    }
    if ($uid > 0) {
      /** @var \Drupal\user\UserDataInterface $user_data */
      $user_data = \Drupal::service('user.data');
      $user_data->set(
        'myeventlane_auth',
        $uid,
        IdentityIntentResolver::USER_DATA_PENDING_MEL_INTENT,
        IdentityIntentResolver::INTENT_CREATE_EVENT,
      );
      \Drupal::logger('myeventlane_auth')->notice(
        'MEL auth handoff: stored pending_mel_intent create_event uid=@uid (verify_mail; login deferred)',
        ['@uid' => (string) $uid],
      );
    }
    else {
      \Drupal::logger('myeventlane_auth')->warning(
        'MEL auth handoff: create_event registration could not resolve uid for pending_mel_intent.',
      );
    }
    return;
  }

  $form_state->setRedirect('myeventlane_vendor.onboard.profile', [], [
    'query' => [
      'destination' => '/create-event',
    ],
  ]);

  $target_preview = Url::fromRoute('myeventlane_vendor.onboard.profile', [], [
    'query' => [
      'destination' => '/create-event',
    ],
  ])->toString();
  // Temporary: remove after create-event signup→/mel/post-login handoff is verified in logs.
  \Drupal::logger('myeventlane_auth')->info(
    'MEL auth handoff: registration post-save redirect uid=@uid target=@target',
    [
      '@uid' => (string) \Drupal::currentUser()->id(),
      '@target' => $target_preview,
    ],
  );
}

/**
 * Implements hook_form_user_form_alter().
 *
 * One-time password reset: optional handoff to the create-event gateway when MEL
 * intent is create_event (request, hidden field, or pending user data).
 */
function myeventlane_auth_form_user_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id !== 'user_form') {
    return;
  }
  if ($form_state->get('user_pass_reset')) {
    $raw_intent = myeventlane_auth_resolve_mel_intent_for_login_request(\Drupal::request());
    if (is_string($raw_intent) && $raw_intent !== '') {
      $form['mel_intent'] = [
        '#type' => 'hidden',
        '#value' => $raw_intent,
        '#weight' => -20,
      ];
    }
    $form['actions']['submit']['#submit'][] = 'myeventlane_auth_reset_redirect_submit';
  }
}

/**
 * Submit after user one-time password set: hand off to create-event gateway when intended.
 */
function myeventlane_auth_reset_redirect_submit(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->get('user_pass_reset')) {
    return;
  }
  $raw = $form_state->getValue('mel_intent');
  if (!is_string($raw) || $raw === '') {
    $raw = myeventlane_auth_resolve_mel_intent_for_login_request(\Drupal::request());
  }
  if (!is_string($raw) || $raw === '') {
    $form_object = $form_state->getFormObject();
    if ($form_object instanceof EntityFormInterface) {
      $entity = $form_object->getEntity();
      if ($entity instanceof UserInterface) {
        /** @var \Drupal\user\UserDataInterface $user_data */
        $user_data = \Drupal::service('user.data');
        $pending = $user_data->get(
          'myeventlane_auth',
          (int) $entity->id(),
          IdentityIntentResolver::USER_DATA_PENDING_MEL_INTENT,
        );
        if (is_string($pending) && $pending !== '') {
          $raw = $pending;
        }
      }
    }
  }
  if (!is_string($raw)) {
    $raw = '';
  }
  /** @var \Drupal\myeventlane_auth\Service\IdentityIntentResolver $resolver */
  $resolver = \Drupal::service('myeventlane_auth.identity_intent_resolver');
  if ($resolver->normalizeIntent($raw) !== IdentityIntentResolver::INTENT_CREATE_EVENT) {
    return;
  }
  $form_state->setRedirect(
    'myeventlane_event_studio.create',
    [],
    [
      'query' => [
        'mel_intent' => IdentityIntentResolver::INTENT_CREATE_EVENT,
      ],
    ],
  );
}

/**
 * Implements hook_form_user_login_form_alter().
 *
 * - Carries mel_intent through POST /user/login (hub + PostLoginRouter).
 * - When normalized intent is create_event, adds in-form messaging + CSS.
 *   Implemented here (not only in the front theme) so Gin Login (Gin/Claro)
 *   still shows the callout: https://www.drupal.org/project/gin_login
 */
function myeventlane_auth_form_user_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $request = \Drupal::request();
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Do not alter the login form when the request is part of core password reset.
  if (myeventlane_auth_route_is_password_reset_flow($route_name)) {
    return;
  }

  $destination = $request->query->get('destination');
  if (
    is_string($destination) &&
    $destination !== '' &&
    myeventlane_auth_destination_is_user_reset_path($destination)
  ) {
    if ($route_name === 'user.login') {
      $request->query->remove('destination');
      if (isset($form['destination'])) {
        unset($form['destination']);
      }
      \Drupal::logger('myeventlane_auth')->notice('Reset destination stripped on login route only.');
    }
  }

  if ($route_name === 'user.login') {
    $post_destination = $request->request->get('destination');
    if (
      is_string($post_destination) &&
      $post_destination !== '' &&
      myeventlane_auth_destination_is_user_reset_path($post_destination)
    ) {
      $request->request->remove('destination');
      if (isset($form['destination'])) {
        unset($form['destination']);
      }
    }
  }

  $raw_intent = myeventlane_auth_resolve_mel_intent_for_login_request($request);

  if ($raw_intent !== '') {
    $form['mel_intent'] = [
      '#type' => 'hidden',
      '#value' => $raw_intent,
      '#weight' => -50,
    ];
  }

  // Gin Login: "Create new account" defaults to user.register with no query — preserve handoff.
  if (isset($form['more-links']['register_button']['#url'])) {
    $preserve_register = myeventlane_auth_auth_entry_preserved_query($request);
    if ($preserve_register !== []) {
      $form['more-links']['register_button']['#url'] = Url::fromRoute('user.register', [], ['query' => $preserve_register]);
      $existing_login_cache = $form['#cache']['contexts'] ?? [];
      $form['#cache']['contexts'] = array_values(array_unique(array_merge($existing_login_cache, [
        'url.query_args:destination',
        'url.query_args:mel_intent',
        'url.query_args:intent',
      ])));
      $register_href = $form['more-links']['register_button']['#url']->toString();
      // Temporary: remove after create-event→register→post-login is verified in logs.
      \Drupal::logger('myeventlane_auth')->info('MEL auth handoff: login register link @href (query @q)', [
        '@href' => $register_href,
        '@q' => json_encode($preserve_register, JSON_UNESCAPED_SLASHES),
      ]);
    }
  }

  /** @var \Drupal\myeventlane_auth\Service\IdentityIntentResolver $resolver */
  $resolver = \Drupal::service('myeventlane_auth.identity_intent_resolver');
  if ($resolver->normalizeIntent($raw_intent) !== IdentityIntentResolver::INTENT_CREATE_EVENT) {
    return;
  }

  // Use Form API elements (container + html_tag), not inline_template — the latter
  // is not a form element and can fail to render inside $form.
  $intent_cache_contexts = [
    'url.query_args:destination',
    'url.query_args:mel_intent',
    'url.query_args:intent',
  ];

  $form['mel_login_create_event_info'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['mel-login-intent'],
      'role' => 'region',
      'aria-labelledby' => 'mel-login-intent-title',
    ],
    '#weight' => -60,
    '#attached' => [
      'library' => ['myeventlane_auth/login_create_event_intent'],
    ],
    '#cache' => [
      'contexts' => $intent_cache_contexts,
    ],
    'title' => [
      '#type' => 'html_tag',
      '#tag' => 'strong',
      '#attributes' => ['id' => 'mel-login-intent-title'],
      '#value' => t('✨ Create your event'),
    ],
    'body' => [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => t('Log in or sign up to start your event — we’ll guide you through the rest.'),
    ],
  ];

  $existing = $form['#cache']['contexts'] ?? [];
  $form['#cache']['contexts'] = array_values(array_unique(array_merge($existing, $intent_cache_contexts)));
}

/**
 * Implements hook_user_login().
 *
 * Stages destination + intent for post-login hub redirect (session commit safe).
 */
function myeventlane_auth_user_login(UserInterface $account): void {
  $request = \Drupal::request();
  if ($request->hasSession()) {
    $session = $request->getSession();
    if ($session->get(AccountSetupFlowSubscriber::SESSION_KEY) === (string) $account->id()) {
      $session->remove(AccountSetupFlowSubscriber::SESSION_KEY);
    }
  }
  if (myeventlane_auth_is_password_reset_flow($request)) {
    \Drupal::logger('myeventlane_auth')->notice('Skipping MEL post-login routing for password reset flow.');
    return;
  }

  \Drupal::logger('myeventlane_auth')->notice('Audit: login success uid=@uid.', [
    '@uid' => (string) $account->id(),
  ]);

  if (!$request->hasSession()) {
    return;
  }

  $session = $request->getSession();

  $raw_dest = NULL;
  foreach ([$request->query->get('destination'), $request->request->get('destination')] as $candidate) {
    if (is_string($candidate) && $candidate !== '') {
      $raw_dest = $candidate;
      break;
    }
  }
  if ($raw_dest === NULL) {
    $raw_dest = '/user/' . $account->id();
  }

  $intent = myeventlane_auth_resolve_mel_intent_for_login_request($request);

  /** @var \Drupal\myeventlane_auth\Service\IdentityIntentResolver $resolver */
  $resolver = \Drupal::service('myeventlane_auth.identity_intent_resolver');
  if ($resolver->normalizeIntent($intent) === IdentityIntentResolver::INTENT_BROWSE) {
    /** @var \Drupal\user\UserDataInterface $user_data */
    $user_data = \Drupal::service('user.data');
    $pending = $user_data->get(
      'myeventlane_auth',
      (int) $account->id(),
      IdentityIntentResolver::USER_DATA_PENDING_MEL_INTENT,
    );
    if ($pending === IdentityIntentResolver::INTENT_CREATE_EVENT) {
      $intent = IdentityIntentResolver::INTENT_CREATE_EVENT;
    }
  }

  $internal = myeventlane_auth_destination_to_internal_path($request, $raw_dest);
  if ($internal === NULL || myeventlane_auth_should_skip_mel_hub_wrap($internal)) {
    $session->save();
    return;
  }

  $session->set(MelPostLoginSessionRedirectSubscriber::SESSION_KEY, [
    'destination' => $internal,
    'intent' => $intent,
  ]);
  if ($resolver->normalizeIntent($intent) === IdentityIntentResolver::INTENT_CREATE_EVENT) {
    /** @var \Drupal\user\UserDataInterface $user_data */
    $user_data = \Drupal::service('user.data');
    $user_data->delete(
      'myeventlane_auth',
      (int) $account->id(),
      IdentityIntentResolver::USER_DATA_PENDING_MEL_INTENT,
    );
  }
  $session->save();
}

/**
 * Maps a login destination to an internal path for the current host.
 */
function myeventlane_auth_destination_to_internal_path(Request $request, string $destination): ?string {
  $destination = trim($destination);
  if ($destination === '' || $destination === '/') {
    return '/';
  }
  if (str_starts_with($destination, '//')) {
    return NULL;
  }
  if (preg_match('#^https?://#i', $destination)) {
    $parts = parse_url($destination);
    if ($parts === FALSE) {
      return NULL;
    }
    $scheme = $parts['scheme'] ?? '';
    if ($scheme !== '' && !in_array($scheme, ['http', 'https'], TRUE)) {
      return NULL;
    }
    if (isset($parts['host']) && strcasecmp((string) $parts['host'], $request->getHost()) !== 0) {
      return NULL;
    }
    $path = $parts['path'] ?? '/';
    $base = $request->getBasePath();
    if ($base !== '' && str_starts_with($path, $base)) {
      $path = substr($path, strlen($base)) ?: '/';
    }
    if ($path === '') {
      $path = '/';
    }
    if (!str_starts_with($path, '/')) {
      return NULL;
    }
    $query = isset($parts['query']) && is_string($parts['query']) ? '?' . $parts['query'] : '';
    return $path . $query;
  }
  if (str_starts_with($destination, '/')) {
    return $destination;
  }
  return NULL;
}

/**
 * Paths that must not be wrapped to the MEL post-login hub.
 */
function myeventlane_auth_should_skip_mel_hub_wrap(string $internal_path): bool {
  $path_only = strtok($internal_path, '?') ?: $internal_path;
  if ($path_only === '/mel/post-login') {
    return TRUE;
  }
  if ($path_only === '/mel/auth/continue') {
    return TRUE;
  }
  if (str_starts_with($path_only, '/admin')) {
    return TRUE;
  }
  if (str_starts_with($path_only, '/system/')) {
    return TRUE;
  }
  if (str_starts_with($path_only, '/batch')) {
    return TRUE;
  }
  return FALSE;
}

/**
 * Implements hook_user_logout().
 */
function myeventlane_auth_user_logout(AccountInterface $account): void {
  if ($account->isAuthenticated()) {
    \Drupal::logger('myeventlane_auth')->notice('Audit: logout uid=@uid.', [
      '@uid' => (string) $account->id(),
    ]);
  }
}

/**
 * Implements hook_entity_insert().
 */
function myeventlane_auth_entity_insert(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'rsvp_submission') {
    return;
  }
  $uid = (int) ($entity->getOwnerId() ?? 0);
  if ($uid <= 0) {
    return;
  }
  if (!\Drupal::hasService('myeventlane_auth.customer_identity_bridge')) {
    return;
  }
  \Drupal::service('myeventlane_auth.customer_identity_bridge')->onAuthenticatedRsvpUid($uid);
}

/**
 * Returns the configured signing secret for access JWTs.
 *
 * Prefer settings.php (never commit secrets):
 *
 * @code
 * $settings['myeventlane_auth']['signing_key'] = 'use-long-random-string';
 * @endcode
 */
function myeventlane_auth_signing_key(): string {
  $from_settings = Settings::get('myeventlane_auth.signing_key', '');
  if (is_string($from_settings) && $from_settings !== '') {
    return $from_settings;
  }
  $nested = Settings::get('myeventlane_auth', []);
  if (is_array($nested) && !empty($nested['signing_key']) && is_string($nested['signing_key'])) {
    return $nested['signing_key'];
  }
  return '';
}
