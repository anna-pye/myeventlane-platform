<?php

declare(strict_types=1);

/**
 * @file
 * MyEventLane SSO (OAuth2-style) for cross-subdomain authentication.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\user\UserInterface;
use Drupal\Core\Site\Settings;

/**
 * Implements hook_cron().
 */
function myeventlane_auth_cron(): void {
  /** @var \Drupal\Core\Database\Connection $db */
  $db = \Drupal::database();
  $now = \Drupal::time()->getRequestTime();

  $db->delete('mel_auth_authorization_code')
    ->condition('expires', $now, '<')
    ->execute();

  $db->delete('mel_auth_refresh_token')
    ->condition('revoked', 1)
    ->condition('expires', $now - (90 * 24 * 60 * 60), '<')
    ->execute();
}

/**
 * Implements hook_user_login().
 */
function myeventlane_auth_user_login(UserInterface $account): void {
  \Drupal::logger('myeventlane_auth')->notice('Audit: login success uid=@uid.', [
    '@uid' => (string) $account->id(),
  ]);
}

/**
 * Implements hook_user_logout().
 */
function myeventlane_auth_user_logout(AccountInterface $account): void {
  if ($account->isAuthenticated()) {
    \Drupal::logger('myeventlane_auth')->notice('Audit: logout uid=@uid.', [
      '@uid' => (string) $account->id(),
    ]);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function myeventlane_auth_form_user_login_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  $form['#validate'][] = 'myeventlane_auth_user_login_form_validate_audit';
}

/**
 * Logs failed credential checks (runs after core validators).
 */
function myeventlane_auth_user_login_form_validate_audit(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->get('uid')) {
    \Drupal::logger('myeventlane_auth')->warning('Audit: login failed (credentials or flood).');
  }
}

/**
 * Returns the configured signing secret for access JWTs.
 *
 * Prefer settings.php (never commit secrets):
 *
 * @code
 * $settings['myeventlane_auth']['signing_key'] = 'use-long-random-string';
 * @endcode
 */
function myeventlane_auth_signing_key(): string {
  $from_settings = Settings::get('myeventlane_auth.signing_key', '');
  if (is_string($from_settings) && $from_settings !== '') {
    return $from_settings;
  }
  $nested = Settings::get('myeventlane_auth', []);
  if (is_array($nested) && !empty($nested['signing_key']) && is_string($nested['signing_key'])) {
    return $nested['signing_key'];
  }
  return '';
}
