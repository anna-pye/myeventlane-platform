<?php

declare(strict_types=1);

/**
 * @file
 * MyEventLane SSO (OAuth2-style) for cross-subdomain authentication.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\user\UserInterface;
use Drupal\Core\Site\Settings;
use Drupal\myeventlane_auth\EventSubscriber\MelPostLoginSessionRedirectSubscriber;
use Symfony\Component\HttpFoundation\Request;

/**
 * Implements hook_cron().
 */
function myeventlane_auth_cron(): void {
  /** @var \Drupal\Core\Database\Connection $db */
  $db = \Drupal::database();
  $now = \Drupal::time()->getRequestTime();

  $db->delete('mel_auth_authorization_code')
    ->condition('expires', $now, '<')
    ->execute();

  $db->delete('mel_auth_refresh_token')
    ->condition('revoked', 1)
    ->condition('expires', $now - (90 * 24 * 60 * 60), '<')
    ->execute();
}

/**
 * Implements hook_user_login().
 *
 * Stages destination + intent for post-login hub redirect (session commit safe).
 * Does not alter the login form or POST handling.
 */
function myeventlane_auth_user_login(UserInterface $account): void {
  \Drupal::logger('myeventlane_auth')->notice('Audit: login success uid=@uid.', [
    '@uid' => (string) $account->id(),
  ]);

  $request = \Drupal::request();
  if (!$request->hasSession()) {
    return;
  }
  $session = $request->getSession();

  $raw_dest = NULL;
  foreach ([$request->query->get('destination'), $request->request->get('destination')] as $candidate) {
    if (is_string($candidate) && $candidate !== '') {
      $raw_dest = $candidate;
      break;
    }
  }
  if ($raw_dest === NULL) {
    $raw_dest = '/user/' . $account->id();
  }

  $intent = '';
  foreach ([
    $request->query->get('mel_intent'),
    $request->request->get('mel_intent'),
    $request->query->get('intent'),
    $request->request->get('intent'),
  ] as $candidate) {
    if (is_string($candidate) && $candidate !== '') {
      $intent = $candidate;
      break;
    }
  }

  $internal = myeventlane_auth_destination_to_internal_path($request, $raw_dest);
  if ($internal === NULL || myeventlane_auth_should_skip_mel_hub_wrap($internal)) {
    $session->save();
    return;
  }

  $session->set(MelPostLoginSessionRedirectSubscriber::SESSION_KEY, [
    'destination' => $internal,
    'intent' => $intent,
  ]);
  $session->save();
}

/**
 * Maps a login destination to an internal path for the current host.
 */
function myeventlane_auth_destination_to_internal_path(Request $request, string $destination): ?string {
  $destination = trim($destination);
  if ($destination === '' || $destination === '/') {
    return '/';
  }
  if (str_starts_with($destination, '//')) {
    return NULL;
  }
  if (preg_match('#^https?://#i', $destination)) {
    $parts = parse_url($destination);
    if ($parts === FALSE) {
      return NULL;
    }
    $scheme = $parts['scheme'] ?? '';
    if ($scheme !== '' && !in_array($scheme, ['http', 'https'], TRUE)) {
      return NULL;
    }
    if (isset($parts['host']) && strcasecmp((string) $parts['host'], $request->getHost()) !== 0) {
      return NULL;
    }
    $path = $parts['path'] ?? '/';
    $base = $request->getBasePath();
    if ($base !== '' && str_starts_with($path, $base)) {
      $path = substr($path, strlen($base)) ?: '/';
    }
    if ($path === '') {
      $path = '/';
    }
    if (!str_starts_with($path, '/')) {
      return NULL;
    }
    $query = isset($parts['query']) && is_string($parts['query']) ? '?' . $parts['query'] : '';
    return $path . $query;
  }
  if (str_starts_with($destination, '/')) {
    return $destination;
  }
  return NULL;
}

/**
 * Paths that must not be wrapped to the MEL post-login hub.
 */
function myeventlane_auth_should_skip_mel_hub_wrap(string $internal_path): bool {
  $path_only = strtok($internal_path, '?') ?: $internal_path;
  if ($path_only === '/mel/post-login') {
    return TRUE;
  }
  if ($path_only === '/mel/auth/continue') {
    return TRUE;
  }
  if (str_starts_with($path_only, '/admin')) {
    return TRUE;
  }
  if (str_starts_with($path_only, '/system/')) {
    return TRUE;
  }
  if (str_starts_with($path_only, '/batch')) {
    return TRUE;
  }
  return FALSE;
}

/**
 * Implements hook_user_logout().
 */
function myeventlane_auth_user_logout(AccountInterface $account): void {
  if ($account->isAuthenticated()) {
    \Drupal::logger('myeventlane_auth')->notice('Audit: logout uid=@uid.', [
      '@uid' => (string) $account->id(),
    ]);
  }
}

/**
 * Implements hook_entity_insert().
 */
function myeventlane_auth_entity_insert(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'rsvp_submission') {
    return;
  }
  $uid = (int) ($entity->getOwnerId() ?? 0);
  if ($uid <= 0) {
    return;
  }
  if (!\Drupal::hasService('myeventlane_auth.customer_identity_bridge')) {
    return;
  }
  \Drupal::service('myeventlane_auth.customer_identity_bridge')->onAuthenticatedRsvpUid($uid);
}

/**
 * Returns the configured signing secret for access JWTs.
 *
 * Prefer settings.php (never commit secrets):
 *
 * @code
 * $settings['myeventlane_auth']['signing_key'] = 'use-long-random-string';
 * @endcode
 */
function myeventlane_auth_signing_key(): string {
  $from_settings = Settings::get('myeventlane_auth.signing_key', '');
  if (is_string($from_settings) && $from_settings !== '') {
    return $from_settings;
  }
  $nested = Settings::get('myeventlane_auth', []);
  if (is_array($nested) && !empty($nested['signing_key']) && is_string($nested['signing_key'])) {
    return $nested['signing_key'];
  }
  return '';
}
