<?php

/**
 * @file
 * Hooks for the MyEventLane Help Centre AI module.
 */

declare(strict_types=1);

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for help_centre_index.
 *
 * Adds "Ask a question" link to the unified Help Assistant when enabled.
 */
function myeventlane_help_centre_ai_preprocess_help_centre_index(array &$variables): void {
  if (!empty($variables['is_vendor'])) {
    return;
  }
  if (\Drupal::moduleHandler()->moduleExists('myeventlane_help_assistant')) {
    $settings = \Drupal::config('myeventlane_help_assistant.settings');
    if ((bool) $settings->get('enabled')) {
      try {
        $variables['ask_url'] = Url::fromRoute('myeventlane_help_centre.home', [], ['fragment' => 'mel-help-assistant'])->toString();
        return;
      }
      catch (\Throwable) {
      }
    }
  }
  $variables['ask_url'] = '/help';
}
