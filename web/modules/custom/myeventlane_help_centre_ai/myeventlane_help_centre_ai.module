<?php

/**
 * @file
 * Hooks for the MyEventLane Help Centre AI module.
 */

declare(strict_types=1);

use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for help_centre_index.
 *
 * Adds "Ask a question" link to public help centre only.
 */
function myeventlane_help_centre_ai_preprocess_help_centre_index(array &$variables): void {
  if (!empty($variables['is_vendor'])) {
    return;
  }
  $variables['ask_url'] = Url::fromRoute('myeventlane_help_centre_ai.ask')->toString();
}

/**
 * Implements hook_theme().
 */
function myeventlane_help_centre_ai_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'help_centre_ai' => [
      'variables' => [
        'form' => [],
        'support_url' => '',
      ],
      'template' => 'help-centre-ai',
    ],
  ];
}
