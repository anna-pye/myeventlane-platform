<?php

/**
 * @file
 * Install and update hooks for MyEventLane Legal.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Add legal fields to user entity.
 */
function _myeventlane_legal_add_user_fields(): void {
  $fields = [
    'field_customer_terms_version' => [
      'type' => 'string',
      'label' => 'Customer terms version',
      'description' => 'Version of the customer terms accepted during registration.',
      'cardinality' => 1,
      'storage_uuid' => '10543371-2a36-453d-ae38-25a76f18c4a8',
      'field_uuid' => 'd2a932cd-f11a-464c-a55a-0e42326490b8',
    ],
    'field_customer_terms_accepted_at' => [
      'type' => 'timestamp',
      'label' => 'Customer terms accepted at',
      'description' => 'Time the customer terms were accepted during registration.',
      'cardinality' => 1,
      'storage_uuid' => '25aa516e-feb0-4333-bf40-3a58b2f808a6',
      'field_uuid' => 'efeed30e-6380-44cc-9c8f-d6142fb78a24',
    ],
    'field_privacy_version' => [
      'type' => 'string',
      'label' => 'Privacy policy version',
      'description' => 'Version of the privacy policy acknowledged during registration.',
      'cardinality' => 1,
      'storage_uuid' => '9d658435-a9eb-4819-9eeb-d2925adcc2c1',
      'field_uuid' => '310e7df5-7346-4a55-8700-7a2d6ecd5e8c',
    ],
    'field_privacy_accepted_at' => [
      'type' => 'timestamp',
      'label' => 'Privacy policy acknowledged at',
      'description' => 'Time the privacy policy was acknowledged during registration.',
      'cardinality' => 1,
      'storage_uuid' => 'c07e3349-258b-4b7a-817e-515e4ad2b679',
      'field_uuid' => '82276025-37c3-4b7e-9b63-a2a2055f1741',
    ],
    'field_marketing_opt_in' => [
      'type' => 'boolean',
      'label' => 'Event news preference',
      'description' => 'Whether the customer opted in to updates, tips and event news during registration.',
      'cardinality' => 1,
      'storage_uuid' => '02a86c97-2ecf-4d50-ac25-ca53c9058364',
      'field_uuid' => 'e244fb90-6d79-4b53-9619-d65042a9100d',
    ],
    'field_marketing_opt_in_at' => [
      'type' => 'timestamp',
      'label' => 'Event news opt-in at',
      'description' => 'Time the customer opted in to updates, tips and event news.',
      'cardinality' => 1,
      'storage_uuid' => '8a0486c4-b265-4d98-b7ae-957165211ff4',
      'field_uuid' => '246170d4-c0af-4b73-bdc7-ddbbbdcdfa9f',
    ],
    'field_marketing_choice_at' => [
      'type' => 'timestamp',
      'label' => 'Event news preference recorded at',
      'description' => 'Time the customer made their event news choice during registration.',
      'cardinality' => 1,
      'storage_uuid' => '81b3df24-ea25-4510-a54f-35058721f3b8',
      'field_uuid' => 'f310e7a4-40f4-47a0-8984-445cebd6c8c3',
    ],
  ];

  foreach ($fields as $field_name => $info) {
    if (!FieldStorageConfig::loadByName('user', $field_name)) {
      FieldStorageConfig::create([
        'uuid' => $info['storage_uuid'] ?? NULL,
        'field_name' => $field_name,
        'entity_type' => 'user',
        'type' => $info['type'],
        'cardinality' => $info['cardinality'],
      ])->save();
    }
    if (!FieldConfig::loadByName('user', 'user', $field_name)) {
      FieldConfig::create([
        'uuid' => $info['field_uuid'] ?? NULL,
        'field_name' => $field_name,
        'entity_type' => 'user',
        'bundle' => 'user',
        'label' => $info['label'],
        'description' => $info['description'] ?? '',
        'translatable' => FALSE,
        'settings' => $field_name === 'field_marketing_opt_in'
          ? ['on_label' => 'Opted in', 'off_label' => 'Declined']
          : [],
      ])->save();
    }
  }
}

/**
 * Add legal fields to rsvp_submission entity.
 */
function _myeventlane_legal_add_rsvp_fields(): void {
  if (!\Drupal::entityTypeManager()->hasDefinition('rsvp_submission')) {
    return;
  }

  $fields = [
    'field_customer_terms_version' => ['type' => 'string', 'label' => 'Customer terms version'],
    'field_customer_terms_accepted_at' => ['type' => 'timestamp', 'label' => 'Customer terms accepted at'],
    'field_privacy_version' => ['type' => 'string', 'label' => 'Privacy version'],
    'field_privacy_accepted_at' => ['type' => 'timestamp', 'label' => 'Privacy accepted at'],
    'field_marketing_opt_in' => ['type' => 'boolean', 'label' => 'Marketing opt-in'],
    'field_marketing_opt_in_at' => ['type' => 'timestamp', 'label' => 'Marketing opt-in at'],
  ];

  foreach ($fields as $field_name => $info) {
    if (!FieldStorageConfig::loadByName('rsvp_submission', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'rsvp_submission',
        'type' => $info['type'],
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('rsvp_submission', 'rsvp_submission', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'rsvp_submission',
        'bundle' => 'rsvp_submission',
        'label' => $info['label'],
      ])->save();
    }
  }
}

/**
 * Add legal fields to commerce_order.
 */
function _myeventlane_legal_add_commerce_order_fields(): void {
  if (!\Drupal::entityTypeManager()->hasDefinition('commerce_order')) {
    return;
  }

  $fields = [
    'field_legal_consent_given' => ['type' => 'boolean', 'label' => 'Legal consent given'],
    'field_legal_consent_timestamp' => ['type' => 'timestamp', 'label' => 'Legal consent timestamp'],
    'field_customer_terms_version' => ['type' => 'string', 'label' => 'Customer terms version'],
    'field_customer_terms_accepted_at' => ['type' => 'timestamp', 'label' => 'Customer terms accepted at'],
    'field_privacy_version' => ['type' => 'string', 'label' => 'Privacy version'],
    'field_privacy_accepted_at' => ['type' => 'timestamp', 'label' => 'Privacy accepted at'],
  ];

  foreach ($fields as $field_name => $info) {
    if (!FieldStorageConfig::loadByName('commerce_order', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'commerce_order',
        'type' => $info['type'],
        'cardinality' => 1,
      ])->save();
    }
    if (!FieldConfig::loadByName('commerce_order', 'default', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'commerce_order',
        'bundle' => 'default',
        'label' => $info['label'],
      ])->save();
    }
  }
}

