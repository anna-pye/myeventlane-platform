}

/**
 * Implements hook_install().
 */
function myeventlane_legal_install(): void {
  _myeventlane_legal_add_user_fields();
  _myeventlane_legal_add_rsvp_fields();
  _myeventlane_legal_add_commerce_order_fields();
  _myeventlane_legal_add_vendor_fields();
}

/**
 * Implements hook_update_N().
 */
function myeventlane_legal_update_9001(): string {
  _myeventlane_legal_add_user_fields();
  _myeventlane_legal_add_rsvp_fields();
  _myeventlane_legal_add_commerce_order_fields();
  _myeventlane_legal_add_vendor_fields();
  drupal_flush_all_caches();
  return 'Added legal compliance fields to user, rsvp_submission, commerce_order, and myeventlane_vendor.';
}

/**
 * Add APP 5 collection notices and refund policy URL to legal config.
 */
function myeventlane_legal_update_9002(): string {
  $config = \Drupal::configFactory()->getEditable('myeventlane_legal.settings');
  $defaults = [
    'refund_policy_url' => 'https://myeventlane.com/refund-policy',
    'collection_notice_rsvp' => 'We collect your name and email to process your RSVP, send confirmation, and manage your booking. Our Privacy Policy explains how we use and protect your information.',
    'collection_notice_checkout' => 'We collect your contact details to process your order, send tickets and receipts, and manage your booking. Our Privacy Policy explains how we use and protect your information.',
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
  return 'Added refund_policy_url and APP 5 collection notices to legal settings.';
}

/**
 * Create policy pages and align legal config URLs to relative paths.
 *
 * Creates/updates nodes at /terms, /vendor-terms, /privacy, /refund-policy,
 * /cookie-policy. Sets config URLs to these paths. Note: /cookies is occupied
 * by CookiePolicyController (preferences page); Cookie Policy node uses
 * /cookie-policy.
 */
function myeventlane_legal_update_9003(): string {
  _myeventlane_legal_create_policy_pages();
  $config = \Drupal::configFactory()->getEditable('myeventlane_legal.settings');
  $config
    ->set('customer_terms_url', '/terms')
    ->set('vendor_terms_url', '/vendor-terms')
    ->set('privacy_url', '/privacy')
    ->set('refund_policy_url', '/refund-policy')
    ->set('cookie_policy_url', '/cookie-policy')
    ->save();
  drupal_flush_all_caches();
  return 'Policy pages created/updated and legal config URLs aligned.';
}

/**
 * Creates or updates policy page nodes.
 */
function _myeventlane_legal_create_policy_pages(): void {
  $node_type = \Drupal::entityTypeManager()->getStorage('node_type')->load('page');
  if (!$node_type) {
    return;
  }
  $policies = \Drupal\myeventlane_legal\Service\LegalPolicyPageContent::getDefinitions(
    \Drupal::configFactory()
  );
  $pa_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($policies as $alias => $definition) {
    $title = $definition['title'];
    $body = $definition['body'];
    $node = NULL;
    foreach ($pa_storage->loadByProperties(['alias' => $alias]) as $pa) {
      if (preg_match('#^/node/(\d+)$#', $pa->getPath(), $m)) {
        $node = $node_storage->load($m[1]);
        break;
      }
    }
    if ($node) {
      $node->set('title', $title);
      $node->set('body', ['value' => $body, 'format' => 'basic_html']);
      $node->setPublished();
      $node->save();
    }
    else {
      $node = \Drupal\node\Entity\Node::create([
        'type' => 'page',
        'title' => $title,
        'body' => ['value' => $body, 'format' => 'basic_html'],
        'status' => 1,
        'uid' => 1,
      ]);
      $node->save();
      \Drupal\path_alias\Entity\PathAlias::create([
        'path' => '/node/' . $node->id(),
        'alias' => $alias,
        'langcode' => \Drupal\Core\Language\LanguageInterface::LANGCODE_NOT_SPECIFIED,
      ])->save();
    }
  }
}

/**
 * Ensure vendor terms fields exist.
 *
 * 9001 may have run before myeventlane_vendor was available. This update
 * ensures the vendor terms fields are created if missing.
 */
function myeventlane_legal_update_9004(): string {
  _myeventlane_legal_add_vendor_fields();
  drupal_flush_all_caches();
  return 'Ensured vendor terms fields exist on myeventlane_vendor.';
}

/**
 * Add field_last_updated to Basic Page (node.page) for policy/legal pages.
 *
 * Machine name: field_last_updated
 * Type: Date
 * Display format: "F j, Y"
 * Label: Hidden on view
 */
function myeventlane_legal_update_9005(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $field_storage_storage = $entity_type_manager->getStorage('field_storage_config');
  $field_config_storage = $entity_type_manager->getStorage('field_config');

  if (!FieldStorageConfig::loadByName('node', 'field_last_updated')) {
    $field_storage_storage->create([
      'field_name' => 'field_last_updated',
      'entity_type' => 'node',
      'type' => 'datetime',
      'module' => 'datetime',
      'settings' => ['datetime_type' => 'date'],
      'cardinality' => 1,
    ])->save();
  }

  if (!FieldConfig::loadByName('node', 'page', 'field_last_updated')) {
    $field_config_storage->create([
      'field_name' => 'field_last_updated',
      'entity_type' => 'node',
      'bundle' => 'page',
      'label' => 'Last updated',
    ])->save();
  }

  // Add to form display.
  $form_display = $entity_type_manager->getStorage('entity_form_display')->load('node.page.default');
  if ($form_display && !$form_display->getComponent('field_last_updated')) {
    $form_display->setComponent('field_last_updated', [
      'type' => 'datetime_default',
      'weight' => 10,
      'region' => 'content',
      'settings' => [],
    ])->save();
  }

  // Add to view display with label hidden and format "F j, Y".
  $view_display = $entity_type_manager->getStorage('entity_view_display')->load('node.page.default');
  if ($view_display && !$view_display->getComponent('field_last_updated')) {
    $view_display->setComponent('field_last_updated', [
      'type' => 'datetime_custom',
      'label' => 'hidden',
      'weight' => 5,
      'region' => 'content',
      'settings' => [
        'date_format' => 'F j, Y',
        'timezone_override' => '',
      ],
    ])->save();
  }

  drupal_flush_all_caches();
  return 'Added field_last_updated to Basic Page content type.';
}

/**
 * Add legal_consent_event entity and consent audit system.
 *
 * Creates the immutable consent audit entity type and table.
 * The admin view (legal_consent_events) is in config/install and will be
 * created on fresh install; for existing sites, import via config:import.
 */
function myeventlane_legal_update_9006(): string {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('legal_consent_event');
  if ($entity_type) {
    $entity_definition_update_manager->installEntityType($entity_type);
  }

  drupal_flush_all_caches();
  return 'Added legal_consent_event entity for immutable consent audit.';
}

/**
 * Add event_id field to legal_consent_event for RSVP event context.
 */
function myeventlane_legal_update_9007(): string {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $installed = $entity_definition_update_manager->getFieldStorageDefinition('event_id', 'legal_consent_event');
  if ($installed === NULL) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition('legal_consent_event');
    $class = $entity_type->getClass();
    $base_fields = $class::baseFieldDefinitions($entity_type);
    if (isset($base_fields['event_id'])) {
      $entity_definition_update_manager->installFieldStorageDefinition(
        'event_id',
        'legal_consent_event',
        'myeventlane_legal',
        $base_fields['event_id']
      );
    }
  }
  drupal_flush_all_caches();
  return 'Added event_id field to legal_consent_event for RSVP event context.';
}

/**
 * Trust foundation: policy structures, refund consolidation, legal URL alignment.
 */
function myeventlane_legal_update_9008(): string {
  _myeventlane_legal_create_policy_pages();
  _myeventlane_legal_retire_refund_policy_page();

  $config = \Drupal::configFactory()->getEditable('myeventlane_legal.settings');
  $config
    ->set('customer_terms_url', '/terms')
    ->set('vendor_terms_url', '/vendor-terms')
    ->set('privacy_url', '/privacy')
    ->set('refund_policy_url', '/help/policies/refund-policy')
    ->set('cookie_policy_url', '/cookie-policy')
    ->save();

  drupal_flush_all_caches();
  return 'Updated legal policy page structures, retired /refund-policy node alias, and aligned legal config URLs.';
}

/**
 * Removes the duplicate /refund-policy basic page so the redirect route can serve.
 */
function _myeventlane_legal_retire_refund_policy_page(): void {
  $pa_storage = \Drupal::entityTypeManager()->getStorage('path_alias');
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');
  foreach ($pa_storage->loadByProperties(['alias' => '/refund-policy']) as $pathAlias) {
    if (preg_match('#^/node/(\d+)$#', $pathAlias->getPath(), $matches)) {
      $node = $node_storage->load($matches[1]);
      if ($node instanceof \Drupal\node\NodeInterface) {
        $node->setUnpublished();
        $node->save();
      }
    }
    $pathAlias->delete();
  }
}

/**
 * Expands launch-ready privacy, terms, and cookie policy page content.
 */
function myeventlane_legal_update_9009(): string {
  _myeventlane_legal_create_policy_pages();
  drupal_flush_all_caches();
  return 'Expanded launch-ready privacy, terms, and cookie policy page content.';
}

/**
 * Align customer and organiser terms with direct-charge seller responsibility.
 */
function myeventlane_legal_update_9010(): string {
  _myeventlane_legal_create_policy_pages();
  drupal_flush_all_caches();
  return 'Aligned customer and organiser terms with the direct-charge payment model.';
}

/**
 * Add GST registration responsibilities to customer and organiser terms.
 */
function myeventlane_legal_update_9011(): string {
  _myeventlane_legal_create_policy_pages();

  $config = \Drupal::configFactory()->getEditable('myeventlane_legal.settings');
  if (version_compare((string) $config->get('customer_terms_version'), '1.1', '<')) {
    $config->set('customer_terms_version', '1.1');
  }
  if (version_compare((string) $config->get('vendor_terms_version'), '1.1', '<')) {
    $config->set('vendor_terms_version', '1.1');
  }
  $config->save();

  drupal_flush_all_caches();
  return 'Added GST registration wording to customer and organiser terms and advanced both terms versions to 1.1.';
}

/**
 * Restore registration consent fields as deployment-managed configuration.
 */
function myeventlane_legal_update_9012(): string {
  $displayNames = [
    'core.entity_form_display.user.user.default',
    'core.entity_form_display.user.user.register',
    'core.entity_view_display.user.user.compact',
    'core.entity_view_display.user.user.default',
  ];
  $configFactory = \Drupal::configFactory();
  $displaySnapshots = [];
  foreach ($displayNames as $displayName) {
    $displaySnapshots[$displayName] = $configFactory->get($displayName)->getRawData();
  }

  _myeventlane_legal_add_user_fields();

  // Field creation asks Entity Display to register every currently hidden user
  // field, which creates unrelated display-config drift. Restore the exact
  // pre-update displays; absent components remain hidden by Drupal.
  foreach ($displaySnapshots as $displayName => $displayData) {
    if ($displayData !== []) {
      $configFactory->getEditable($displayName)->setData($displayData)->save(TRUE);
    }
  }
  drupal_flush_all_caches();
  return 'Restored user registration consent fields, including the marketing preference timestamp.';
}
