<?php

/**
 * @file
 * MyEventLane Legal: terms, privacy, cookie consent.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
function myeventlane_legal_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'user_register_form') {
    \Drupal::service('myeventlane_legal.registration_alter')->alterForm($form, $form_state);
  }
  if ($form_id === 'myeventlane_rsvp_public_form') {
    \Drupal::service('myeventlane_legal.rsvp_alter')->alterRsvpPublicForm($form, $form_state);
  }
  if ($form_id === 'myeventlane_commerce_rsvp_booking_form') {
    \Drupal::service('myeventlane_legal.rsvp_alter')->alterRsvpBookingForm($form, $form_state);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for myeventlane_rsvp_public_form.
 *
 * Combined form alters merge hook_form_alter() and hook_form_FORM_ID_alter() per
 * module. This second pass re-applies guarantees after any other module's
 * generic hook_form_alter that might run later in the same combined list.
 */
function myeventlane_legal_form_myeventlane_rsvp_public_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service('myeventlane_legal.rsvp_alter')->enforceLegalConsentNonCoreRequired($form);
}

/**
 * Implements hook_form_FORM_ID_alter() for myeventlane_commerce_rsvp_booking_form.
 *
 * @see myeventlane_legal_form_myeventlane_rsvp_public_form_alter()
 */
function myeventlane_legal_form_myeventlane_commerce_rsvp_booking_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  \Drupal::service('myeventlane_legal.rsvp_alter')->enforceLegalConsentNonCoreRequired($form);
}

/**
 * Implements hook_entity_presave().
 *
 * Applies runtime RSVP legal consent attached before save (see RsvpSubmissionManager).
 */
function myeventlane_legal_entity_presave(\Drupal\Core\Entity\EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'rsvp_submission') {
    return;
  }
  $consent = $entity->_myeventlaneLegalConsent ?? NULL;
  if (empty($consent) || !is_array($consent)) {
    return;
  }

  \Drupal::service('myeventlane_legal.consent_helper')->applyConsentToEntity($entity, $consent);
  $entity->_myeventlaneLegalConsent = NULL;
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches cookie consent library to all pages so the banner can appear
 * when consent has not been given.
 */
function myeventlane_legal_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'myeventlane_legal/cookie_consent';
  $attachments['#attached']['drupalSettings']['myeventlane_legal'] = [
    'preferences_url' => '/cookies/preferences',
    'cookie_policy_url' => '/cookies',
  ];
}
