<?php

/**
 * @file
 * Install, update and uninstall hooks for MyEventLane Commerce.
 */

/**
 * Implements hook_schema().
 */
function myeventlane_commerce_schema(): array {
  $schema['myeventlane_commerce_ticket_hold'] = [
    'description' => 'Provisional cart holds for finite ticket-tier inventory.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'reservation_key' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'order_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'event_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'tier_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'variation_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'quantity' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'counts_toward_capacity' => [
        'type' => 'int',
        'size' => 'tiny',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 1,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'expires' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'reservation_key' => ['reservation_key'],
    ],
    'indexes' => [
      'event_tier_expires' => [
        'event_id',
        'tier_id',
        'counts_toward_capacity',
        'expires',
      ],
      'order_event' => ['order_id', 'event_id'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_update_N().
 */
function myeventlane_commerce_update_10001(): void {
  // Valid baseline update hook for Drupal 11 upgrade paths.
  // Intentionally no schema changes.
  \Drupal::logger('myeventlane_commerce')->notice('Ran update 10001.');
}

/**
 * Disable Commerce core order receipt; MyEventLane uses myeventlane_messaging.
 */
function myeventlane_commerce_update_10002(): void {
  $config = \Drupal::configFactory()->getEditable('commerce_order.commerce_order_type.default');
  if ($config->isNew()) {
    return;
  }
  $config->set('sendReceipt', FALSE);
  $config->set('receiptSubject', '');
  $config->save();
}

/**
 * Add per-order MEL donation storage to default Commerce orders.
 */
function myeventlane_commerce_update_10003(): void {
  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('commerce_order', 'field_mel_donation')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_mel_donation',
      'entity_type' => 'commerce_order',
      'type' => 'decimal',
      'settings' => [
        'precision' => 10,
        'scale' => 2,
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }

  if (!\Drupal\field\Entity\FieldConfig::loadByName('commerce_order', 'default', 'field_mel_donation')) {
    \Drupal\field\Entity\FieldConfig::create([
      'field_name' => 'field_mel_donation',
      'entity_type' => 'commerce_order',
      'bundle' => 'default',
      'label' => 'MEL donation',
      'description' => 'Per-order organiser contribution added from the booking form.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => [
        'min' => NULL,
        'max' => NULL,
        'prefix' => '$',
        'suffix' => '',
      ],
    ])->save();
  }
}

/**
 * Operational merchandise Commerce bundles + field_mel_operational_product.
 */
function myeventlane_commerce_update_10004(): string {
  $mh = \Drupal::moduleHandler();
  if (!$mh->moduleExists('commerce_product') || !$mh->moduleExists('field')) {
    return 'Skipped operational merchandise architecture: commerce_product or field not enabled.';
  }

  $etm = \Drupal::entityTypeManager();
  $cvt_storage = $etm->getStorage('commerce_product_variation_type');
  $variation_pairs = [
    'operational_merchandise_var' => 'Operational merchandise variation',
    'operational_bundle_var' => 'Operational bundle variation',
    'hospitality_package_var' => 'Hospitality package variation',
    'timed_collection_var' => 'Timed collection variation',
  ];
  foreach ($variation_pairs as $vid => $label) {
    if (!$cvt_storage->load($vid)) {
      $cvt_storage->create([
        'id' => $vid,
        'label' => $label,
        'orderItemType' => 'default',
        'generateTitle' => TRUE,
        'locked' => FALSE,
        'traits' => [],
      ])->save();
    }
  }

  $pt_storage = $etm->getStorage('commerce_product_type');
  $product_types = [
    [
      'id' => 'operational_merchandise',
      'label' => 'Operational merchandise',
      'description' => 'MEL operational merchandise products (pickup semantics; Commerce remains authoritative for catalog and pricing).',
      'variation' => 'operational_merchandise_var',
    ],
    [
      'id' => 'operational_bundle',
      'label' => 'Operational bundle',
      'description' => 'Grouped operational commerce packages (VIP + drink, ticket + merch, etc.).',
      'variation' => 'operational_bundle_var',
    ],
    [
      'id' => 'hospitality_package',
      'label' => 'Hospitality package',
      'description' => 'Hospitality access products with operational messaging only.',
      'variation' => 'hospitality_package_var',
    ],
    [
      'id' => 'timed_collection_product',
      'label' => 'Timed collection product',
      'description' => 'Timed collection window products (operational guidance only).',
      'variation' => 'timed_collection_var',
    ],
  ];
  foreach ($product_types as $def) {
    if (!$pt_storage->load($def['id'])) {
      $pt_storage->create([
        'id' => $def['id'],
        'label' => $def['label'],
        'description' => $def['description'],
        'variationTypes' => [$def['variation']],
        'multipleVariations' => TRUE,
        'injectVariationFields' => TRUE,
        'locked' => FALSE,
        'traits' => [],
      ])->save();
    }
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('commerce_product', 'field_mel_operational_product')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_mel_operational_product',
      'entity_type' => 'commerce_product',
      'type' => 'string_long',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }

  foreach (array_column($product_types, 'id') as $bundle) {
    if (!\Drupal\field\Entity\FieldConfig::loadByName('commerce_product', $bundle, 'field_mel_operational_product')) {
      \Drupal\field\Entity\FieldConfig::create([
        'field_name' => 'field_mel_operational_product',
        'entity_type' => 'commerce_product',
        'bundle' => $bundle,
        'label' => 'MEL operational product',
        'description' => 'JSON document keyed mel_operational_product (authoring + projections).',
        'required' => FALSE,
        'translatable' => FALSE,
      ])->save();
    }
  }

  $event_storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('commerce_product', 'field_event');
  if ($event_storage instanceof \Drupal\field\Entity\FieldStorageConfig) {
    foreach (array_column($product_types, 'id') as $bundle) {
      if (\Drupal\field\Entity\FieldConfig::loadByName('commerce_product', $bundle, 'field_event')) {
        continue;
      }
      \Drupal\field\Entity\FieldConfig::create([
        'field_storage' => $event_storage,
        'bundle' => $bundle,
        'label' => 'Event',
        'description' => 'Link this operational product to an event for vendor authoring and customer projections.',
        'required' => FALSE,
        'translatable' => FALSE,
      ])->save();
    }
  }

  return 'Installed MEL operational merchandise product types, variation types, and field_mel_operational_product.';
}

/**
 * Adds durable cart holds for finite ticket-tier inventory.
 */
function myeventlane_commerce_update_10005(): string {
  $table = 'myeventlane_commerce_ticket_hold';
  $schema_handler = \Drupal::database()->schema();
  if ($schema_handler->tableExists($table)) {
    return 'The ticket-tier cart hold table already exists.';
  }

  $schema = myeventlane_commerce_schema();
  $schema_handler->createTable($table, $schema[$table]);
  return 'Created the ticket-tier cart hold table.';
}
