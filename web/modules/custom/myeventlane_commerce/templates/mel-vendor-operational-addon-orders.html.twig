{#
/**
 * @file
 * Vendor preparation and collection workflow for paid event extras.
 *
 * @see \Drupal\myeventlane_commerce\Service\VendorOperationalAddonOrderBuilder
 */
#}
{% set doc = document|default({}) %}
<div class="mel-live-operations mel-vendor-console-stack mel-studio-orders mel-sales-ops">
<section class="mel-live-ops__panel mel-orders-console mel-vendor-addon-orders" aria-labelledby="mel-addon-orders-title">
  <header class="mel-studio-orders__heading">
    <div>
      <p class="mel-studio-orders__eyebrow">{{ 'Sales and bookings'|t }}</p>
      <h2 id="mel-addon-orders-title" class="mel-live-ops__panel-title">{{ 'Add-on orders'|t }}</h2>
      <p class="mel-studio-orders__intro">{{ 'See merchandise and extras guests have bought, grouped so your team can prepare them accurately.'|t }}</p>
    </div>
    <a class="mel-sales-ops__help-link" href="{{ help_url }}">{{ 'How to manage event sales'|t }}</a>
  </header>

  <nav class="mel-sales-ops__nav" aria-label="{{ 'Event sales tools'|t }}">
    <a class="mel-sales-ops__nav-item" href="{{ orders_url }}"><strong>{{ 'Orders'|t }}</strong><small>{{ 'Purchasers, tickets and totals.'|t }}</small></a>
    <span class="mel-sales-ops__nav-item is-active" aria-current="page"><strong>{{ 'Add-on orders'|t }}</strong><small>{{ 'Items to prepare or collect.'|t }}</small></span>
    {% if refunds_url %}
      <a class="mel-sales-ops__nav-item" href="{{ refunds_url }}"><strong>{{ 'Refunds'|t }}</strong><small>{{ 'Review buyer requests safely.'|t }}</small></a>
    {% endif %}
  </nav>

  <aside class="mel-sales-ops__guide" aria-label="{{ 'How to use add-on orders'|t }}">
    <div><strong>{{ 'Check quantities'|t }}</strong><span>{{ 'Confirm each item and option before the event.'|t }}</span></div>
    <div><strong>{{ 'Prepare by group'|t }}</strong><span>{{ 'Use the collection headings and notes to organise fulfilment.'|t }}</span></div>
    <div><strong>{{ 'Open the order'|t }}</strong><span>{{ 'Use the full order when you need purchaser or attendee details.'|t }}</span></div>
  </aside>
  {% if doc.page_intro %}
    <p class="mel-vendor-addon-orders__intro">{{ doc.page_intro }}</p>
  {% endif %}
  {% if doc.vendor_prepare_hint %}
    <p class="mel-vendor-addon-orders__prepare-hint">{{ doc.vendor_prepare_hint }}</p>
  {% endif %}
  <p class="mel-vendor-addon-orders__recovery"><a href="{{ manual_recovery_url }}">{{ 'Use manual recovery'|t }}</a> <span>{{ 'For a missing or unscannable customer pass. A reason is required and logged.'|t }}</span></p>

  {% if doc.empty %}
    <div class="mel-vendor-addon-orders__empty mel-empty">
        <h3>{{ 'No add-on orders yet'|t }}</h3>
        <p class="mel-vendor-addon-orders__empty-text">{{ doc.empty_message|default('') }}</p>
        <p>{{ 'Add merchandise, parking, meals or other extras in Event Studio. Purchases will appear here automatically.'|t }}</p>
        <a class="mel-button mel-button--secondary" href="{{ extras_url }}">{{ 'Manage merchandise & add-ons'|t }}</a>
    </div>
  {% else %}
    {% set totals = doc.totals|default({}) %}
    <div class="mel-vendor-addon-orders__summary mel-card mel-mb-4">
      <div class="mel-card-body">
        <h2 class="mel-vendor-addon-orders__summary-title">{{ 'Summary'|t }}</h2>
        <ul class="mel-vendor-addon-orders__stat-grid">
          <li class="mel-vendor-addon-orders__stat">
            <span class="mel-vendor-addon-orders__stat-label">{{ 'Orders with add-ons'|t }}</span>
            <span class="mel-vendor-addon-orders__stat-value">{{ totals.order_count|default(0) }}</span>
            <small>{{ 'Completed orders containing at least one event extra.'|t }}</small>
          </li>
          <li class="mel-vendor-addon-orders__stat">
            <span class="mel-vendor-addon-orders__stat-label">{{ 'Add-on line items'|t }}</span>
            <span class="mel-vendor-addon-orders__stat-value">{{ totals.item_count|default(0) }}</span>
            <small>{{ 'Separate add-on lines to prepare or fulfil.'|t }}</small>
          </li>
        </ul>
        {% set gc = totals.group_counts|default({}) %}
        {% if gc is iterable %}
          <ul class="mel-vendor-addon-orders__group-counts">
            {% for key, count in gc %}
              {% if count > 0 %}
                <li><span class="mel-vendor-addon-orders__chip">{{ key|replace({'_': ' '})|title }}: {{ count }}</span></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>

    <div class="mel-vendor-addon-orders__list">
      {% for order in doc.orders %}
        <article class="mel-vendor-addon-orders__order mel-card mel-mb-3">
          <div class="mel-card-body">
            <header class="mel-vendor-addon-orders__order-head">
              <div>
                <h3 class="mel-vendor-addon-orders__order-title">{{ order.order_number|default('') }}</h3>
                <p class="mel-vendor-addon-orders__order-meta">
                  {% if order.placed_display %}
                    <span>{{ 'Placed'|t }}: {{ order.placed_display }}</span>
                  {% endif %}
                </p>
              </div>
              <div class="mel-vendor-addon-orders__customer">
                <span class="mel-vendor-addon-orders__customer-label">{{ order.customer_display_label|default('') }}</span>
                {% if order.order_url %}<a href="{{ order.order_url }}">{{ 'Open full order'|t }}</a>{% endif %}
              </div>
            </header>

            {% for gkey, group in order.groups %}
              <section class="mel-vendor-addon-orders__group" aria-labelledby="mel-vendor-addon-group-{{ order.order_id }}-{{ gkey }}">
                <h4 id="mel-vendor-addon-group-{{ order.order_id }}-{{ gkey }}" class="mel-vendor-addon-orders__group-title">{{ group.label|default(gkey) }}</h4>
                <ul class="mel-vendor-addon-orders__lines">
                  {% for line in group.lines %}
                    <li class="mel-vendor-addon-orders__line">
                      {% if line.thumbnail_url|default('') %}
                        <img class="mel-vendor-addon-orders__thumb" src="{{ line.thumbnail_url }}" alt="{{ line.thumbnail_alt|default(line.product_label|default('')) }}" loading="lazy" width="56" height="56" />
                      {% endif %}
                      <div class="mel-vendor-addon-orders__line-body">
                        <div class="mel-vendor-addon-orders__line-main">
                          <span class="mel-vendor-addon-orders__line-product">{{ line.product_label|default('') }}</span>
                          {% if line.size_label|default('') %}
                            <span class="mel-vendor-addon-orders__line-size">{{ 'Size @size'|t({'@size': line.size_label}) }}</span>
                          {% elseif line.variation_label %}
                            <span class="mel-vendor-addon-orders__line-variation">{{ line.variation_label }}</span>
                          {% endif %}
                          <span class="mel-vendor-addon-orders__line-qty">× {{ line.quantity|default(0) }}</span>
                          {% if line.payment_status_label|default('') %}
                            <span class="mel-vendor-addon-orders__line-paid">{{ line.payment_status_label }}</span>
                          {% endif %}
                        </div>
                        {% if line.pickup_note|default('') %}
                          <p class="mel-vendor-addon-orders__line-pickup">{{ line.pickup_note }}</p>
                        {% elseif line.short_description|default('') %}
                          <p class="mel-vendor-addon-orders__line-summary">{{ line.short_description }}</p>
                        {% elseif line.operational_summary %}
                          <p class="mel-vendor-addon-orders__line-summary">{{ line.operational_summary }}</p>
                        {% endif %}
                      {% if line.chips is defined and line.chips|length > 0 %}
                        <ul class="mel-vendor-addon-orders__chips">
                          {% for chip in line.chips %}
                            <li><span class="mel-vendor-addon-orders__chip mel-vendor-addon-orders__chip--{{ chip.tone|default('muted') }}">{{ chip.label }}</span></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                      {% if line.entitlements|default([])|length > 0 %}
                        <ul class="mel-vendor-addon-orders__passes" aria-label="{{ 'Collection passes'|t }}">
                          {% for entitlement in line.entitlements %}
                            <li class="mel-vendor-addon-orders__pass">
                              <span class="mel-vendor-addon-orders__pass-code">{{ entitlement.code_label }}</span>
                              <span class="mel-vendor-addon-orders__chip mel-vendor-addon-orders__chip--{{ entitlement.status == 'ready' ? 'success' : 'muted' }}">{{ entitlement.status_label }}</span>
                              {% if entitlement.transition_url|default('') %}
                                <a class="mel-button mel-button--secondary mel-button--small" href="{{ entitlement.transition_url }}">{{ entitlement.next_label }}</a>
                              {% endif %}
                            </li>
                          {% endfor %}
                        </ul>
                      {% else %}
                        <p class="mel-vendor-addon-orders__pass-missing">{{ 'Pass pending payment confirmation or issuance.'|t }}</p>
                      {% endif %}
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </section>
            {% endfor %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>
</div>
