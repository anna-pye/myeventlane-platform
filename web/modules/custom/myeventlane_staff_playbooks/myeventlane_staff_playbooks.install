<?php

/**
 * @file
 * Install and update functions for the MyEventLane Staff Playbooks module.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldStorageConfig;

/**
 * Migrate field_playbook_sort_order to field_priority.
 *
 * If the module was previously installed with field_playbook_sort_order,
 * this update copies values to field_priority and removes the old field.
 */
function myeventlane_staff_playbooks_update_10001(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $logger = \Drupal::logger('myeventlane_staff_playbooks');

  $old_field = 'field_playbook_sort_order';
  $new_field = 'field_priority';

  $field_storage_new = $update_manager->getFieldStorageDefinition($new_field, 'node');
  $field_storage_old = $update_manager->getFieldStorageDefinition($old_field, 'node');

  if (!$field_storage_old) {
    return 'field_playbook_sort_order was not installed; no migration needed.';
  }

  // Install field_priority from module config if missing.
  if (!$field_storage_new) {
    $extension_path = \Drupal::service('extension.path.resolver')->getPath('module', 'myeventlane_staff_playbooks');
    $config_factory = \Drupal::configFactory();

    foreach (['field.storage.node.field_priority', 'field.field.node.staff_playbook.field_priority'] as $config_name) {
      $parts = explode('.', $config_name);
      $file = $extension_path . '/config/install/' . implode('.', $parts) . '.yml';
      if (is_readable($file)) {
        $data = \Drupal\Component\Serialization\Yaml::decode(file_get_contents($file));
        if ($data) {
          $config_factory->getEditable($config_name)->setData($data)->save();
        }
      }
    }
    $field_storage_new = $update_manager->getFieldStorageDefinition($new_field, 'node');
  }

  if (!$field_storage_new) {
    return 'Could not install field_priority; run config import or reinstall module.';
  }

  $storage = $entity_type_manager->getStorage('node');
  $query = $storage->getQuery()->accessCheck(FALSE)
    ->condition('type', 'staff_playbook')
    ->exists($old_field);

  $nids = $query->execute();
  foreach ($nids as $nid) {
    $node = $storage->load($nid);
    if (!$node || !$node->hasField($old_field) || $node->get($old_field)->isEmpty()) {
      continue;
    }
    $value = (int) $node->get($old_field)->value;
    if ($node->hasField($new_field)) {
      $node->set($new_field, $value);
      $node->save();
    }
  }

  if (!empty($nids)) {
    $logger->notice('Migrated @count staff playbook(s) from field_playbook_sort_order to field_priority.', [
      '@count' => count($nids),
    ]);
  }

  $update_manager->uninstallFieldStorageDefinition($field_storage_old);
  $logger->notice('Removed field_playbook_sort_order from node.');

  return 'Migrated staff playbooks to field_priority.';
}

/**
 * Add inline help to field_reply_snippets description.
 *
 * Appends tone rules, word limit suggestion, and structure format.
 * Safely appends only if not already present.
 */
function myeventlane_staff_playbooks_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('field.field.node.staff_playbook.field_reply_snippets');
  $current = (string) $config->get('description');

  $append = ' Tone: calm, neutral, professional. Word limit: aim for 50–150 words per snippet. Structure: title on first line, then body text.';

  if (str_contains($current, 'Tone: calm, neutral, professional')) {
    return 'field_reply_snippets description already contains inline help.';
  }

  $config->set('description', $current . $append)->save();
  \Drupal::logger('myeventlane_staff_playbooks')->notice('Added inline help to field_reply_snippets description.');

  return 'Added tone, word limit, and structure help to reply snippets field.';
}

/**
 * Remove field_playbook_sort_order from form/view displays.
 *
 * Update 10001 uninstalled the field but did not update entity_form_display
 * and entity_view_display configs. Those still reference the removed field,
 * causing "field needs to be installed" status errors.
 */
function myeventlane_staff_playbooks_update_10003(): string {
  $config_factory = \Drupal::configFactory();
  $logger = \Drupal::logger('myeventlane_staff_playbooks');
  $old_field = 'field_playbook_sort_order';
  $new_field = 'field_priority';

  foreach (
    [
      'core.entity_form_display.node.staff_playbook.default',
      'core.entity_view_display.node.staff_playbook.default',
    ] as $config_name
  ) {
    $config = $config_factory->getEditable($config_name);
    if ($config->isNew()) {
      continue;
    }
    $content = $config->get('content') ?? [];

    if (isset($content[$old_field])) {
      unset($content[$old_field]);
    }

    if (!isset($content[$new_field])) {
      $content[$new_field] = $config_name === 'core.entity_form_display.node.staff_playbook.default'
        ? [
          'type' => 'number',
          'weight' => 6,
          'region' => 'content',
          'settings' => ['placeholder' => ''],
          'third_party_settings' => [],
        ]
        : [
          'type' => 'number_integer',
          'weight' => 6,
          'region' => 'content',
          'settings' => [
            'thousand_separator' => '',
            'prefix_suffix' => TRUE,
          ],
          'third_party_settings' => [],
        ];
    }

    $config->set('content', $content)->save();
  }

  $logger->notice('Removed field_playbook_sort_order from staff_playbook displays.');

  return 'Cleaned field_playbook_sort_order from form/view displays.';
}

/**
 * Import extended staff_playbook field config when missing (from module install).
 *
 * Canonical copies live in config/sync for full-site exports; this update helps
 * environments that run database updates before configuration import.
 */
function myeventlane_staff_playbooks_update_10004(): string {
  $extension_path = \Drupal::service('extension.path.resolver')->getPath('module', 'myeventlane_staff_playbooks');
  $config_factory = \Drupal::configFactory();
  $configs = [
    'field.storage.node.field_internal_only',
    'field.field.node.staff_playbook.field_internal_only',
    'field.storage.node.field_playbook_category',
    'field.field.node.staff_playbook.field_playbook_category',
    'field.storage.node.field_playbook_urgency',
    'field.field.node.staff_playbook.field_playbook_urgency',
    'field.storage.node.field_ai_summary',
    'field.field.node.staff_playbook.field_ai_summary',
  ];
  $imported = 0;
  foreach ($configs as $config_name) {
    if (!$config_factory->get($config_name)->isNew()) {
      continue;
    }
    $file = $extension_path . '/config/install/' . $config_name . '.yml';
    if (!is_readable($file)) {
      continue;
    }
    $raw = file_get_contents($file);
    if ($raw === FALSE) {
      continue;
    }
    $data = \Drupal\Component\Serialization\Yaml::decode($raw);
    if (!is_array($data)) {
      continue;
    }
    $config_factory->getEditable($config_name)->setData($data)->save();
    $imported++;
  }

  return $imported > 0
    ? sprintf('Imported %d staff_playbook field config file(s) from module install.', $imported)
    : 'Staff playbook extended fields already present; no config import from module was needed.';
}

/**
 * Create dedicated field SQL tables when config exists but schema was never installed.
 *
 * Config import alone can leave FieldStorageConfig entities without matching
 * node__field_* tables, which breaks Views and node loads.
 */
function myeventlane_staff_playbooks_update_10005(): string {
  $connection = \Drupal::database();
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $logger = \Drupal::logger('myeventlane_staff_playbooks');

  $field_names = [
    'field_internal_only',
    'field_playbook_category',
    'field_playbook_urgency',
    'field_ai_summary',
  ];
  $repaired = [];

  foreach ($field_names as $field_name) {
    $data_table = 'node__' . $field_name;
    if ($connection->schema()->tableExists($data_table)) {
      continue;
    }

    $storage = FieldStorageConfig::load('node.' . $field_name);
    if (!$storage instanceof FieldStorageConfig) {
      $logger->warning('Skipping field schema repair for @field: FieldStorageConfig not found.', ['@field' => $field_name]);
      continue;
    }

    try {
      $update_manager->installFieldStorageDefinition(
        $storage->getName(),
        $storage->getTargetEntityTypeId(),
        $storage->getProvider(),
        $storage,
      );
      $repaired[] = $field_name;
    }
    catch (\Throwable $e) {
      $logger->error('Failed to install database schema for @field: @message', [
        '@field' => $field_name,
        '@message' => $e->getMessage(),
      ]);
      throw $e;
    }
  }

  return $repaired !== []
    ? sprintf('Created missing SQL tables for field storage(s): %s.', implode(', ', $repaired))
    : 'Staff playbook field data tables already present; no schema repair needed.';
}
