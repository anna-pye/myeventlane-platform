/**
 * Adds projection checkpoint storage.
 */
function myeventlane_domain_events_update_11001(): void {
  $schema = myeventlane_domain_events_schema();
  if (!isset($schema['myeventlane_domain_projection_checkpoint'])) {
    return;
  }

  $database_schema = \Drupal::database()->schema();
  if (!$database_schema->tableExists('myeventlane_domain_projection_checkpoint')) {
    $database_schema->createTable(
      'myeventlane_domain_projection_checkpoint',
      $schema['myeventlane_domain_projection_checkpoint']
    );
  }
}

