<?php

/**
 * @file
 * Module hooks for MyEventLane Checkout Flow.
 *
 * MEL LANGUAGE STANDARD:
 * - Australian English
 * - "Attendee" not "Customer"
 * - "Organiser" not "Vendor"
 * - Friendly, non-corporate tone
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;

/**
 * Implements hook_form_FORM_ID_alter() for commerce_checkout_flow_mel_event_checkout.
 */
function myeventlane_checkout_flow_form_commerce_checkout_flow_mel_event_checkout_alter(array &$form, FormStateInterface $form_state): void {
  $step_id = $form['#step_id'] ?? NULL;
  if ($step_id !== 'checkout') {
    return;
  }
  // Force commerce-checkout-form--with-sidebar.html.twig for our guided layout.
  $form['#theme'] = array_merge(
    ['commerce_checkout_form__with_sidebar'],
    (array) ($form['#theme'] ?? ['commerce_checkout_form'])
  );
  // Add "Back to cart" link when there is no previous checkout step.
  if (isset($form['actions']['next'])) {
    $back_link = Link::fromTextAndUrl(
      t('Back to cart'),
      Url::fromRoute('commerce_cart.page'),
      ['attributes' => ['class' => ['link--previous', 'mel-checkout-back']]]
    );
    $form['actions']['next']['#suffix'] = $back_link->toString();
  }

  /** @var \Drupal\myeventlane_checkout_flow\Service\CheckoutUxAttacher $attacher */
  $attacher = \Drupal::service('myeventlane_checkout_flow.checkout_ux_attacher');
  $attacher->attach($form);
}

/**
 * Implements hook_theme().
 */
function myeventlane_checkout_flow_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'myeventlane_my_tickets' => [
      'variables' => [
        'title' => NULL,
        'upcoming_orders' => [],
        'past_orders' => [],
      ],
      'template' => 'myeventlane-my-tickets',
    ],
    'myeventlane_order_detail' => [
      'variables' => [
        'title' => NULL,
        'order' => NULL,
      ],
      'template' => 'myeventlane-order-detail',
    ],
    'myeventlane_vendor_attendees_dashboard' => [
      'variables' => [
        'title' => NULL,
        'events' => [],
      ],
      'template' => 'myeventlane-vendor-attendees-dashboard',
    ],
    'myeventlane_vendor_event_attendees' => [
      'variables' => [
        'title' => NULL,
        'event' => NULL,
        'attendees' => [],
        'stats' => [],
      ],
      'template' => 'myeventlane-vendor-event-attendees',
    ],
    'myeventlane_vendor_checkin' => [
      'variables' => [
        'title' => NULL,
        'event' => NULL,
        'attendees' => [],
        'search' => '',
      ],
      'template' => 'myeventlane-vendor-checkin',
    ],
  ];
}
