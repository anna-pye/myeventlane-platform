{#
/**
 * @file
 * My Tickets — customer language; shell provides page H1.
 */
#}
<div class="mel-my-tickets">
  <div class="mel-page-header">
    <p class="mel-page-description">
      {{ 'Your bookings, calendar files, and event access in one place.'|t }}
    </p>
  </div>

  {% if upcoming_orders|length > 0 %}
    <div class="mel-section mel-mt-6">
      <h2 class="mel-section-title">{{ 'Upcoming'|t }}</h2>
      <div class="mel-order-cards">
        {% for order_data in upcoming_orders %}
          <div class="mel-card mel-order-card mel-mt-4">
            <div class="mel-card-body">
              {% if order_data.events|length > 0 %}
                <div class="mel-order-events">
                  {% for event in order_data.events %}
                    <h3 class="mel-event-title">
                      <a href="{{ event.url }}" class="mel-link">{{ event.title }}</a>
                    </h3>
                    {% if event.start_date %}
                      <div class="mel-event-meta">
                        <span class="mel-event-date">{{ event.start_date }}</span>
                        {% if event.start_time %}
                          <span class="mel-event-time">{{ event.start_time }}</span>
                        {% endif %}
                        {% if event.location %}
                          <span class="mel-event-location">{{ event.location }}</span>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="mel-order-info mel-mt-4">
                <div class="mel-order-meta">
                  <span class="mel-order-number">
                    <strong>{{ 'Booking'|t }}:</strong> {{ order_data.order_number }}
                  </span>
                  <span class="mel-order-date">
                    <strong>{{ 'Purchased'|t }}:</strong> {{ order_data.placed_date }}
                  </span>
                  <span class="mel-order-status">
                    <strong>{{ 'Status'|t }}:</strong> {{ order_data.state_customer_presentation|default(order_data.state) }}
                  </span>
                </div>
                <div class="mel-order-total mel-mt-2">
                  <strong>{{ 'Amount paid'|t }}:</strong> ${{ order_data.total_price|number_format(2) }}
                </div>
              </div>

              {% if order_data.mel_customer_operational_experience %}
                <div class="mel-my-tickets-operational mel-mt-3">
                  {{ order_data.mel_customer_operational_experience }}
                </div>
              {% endif %}

              {% if order_data.mel_operational_fulfillment_execution_customer %}
                <div class="mel-my-tickets-fulfillment-execution mel-mt-3" role="region" aria-label="{{ 'On-site fulfillment'|t }}">
                  {{ order_data.mel_operational_fulfillment_execution_customer }}
                </div>
              {% endif %}

              {% if order_data.mel_operational_purchase_composition %}
                <div class="mel-my-tickets-operational-composition mel-mt-3" role="region" aria-label="{{ 'Operational packages'|t }}">
                  {{ order_data.mel_operational_purchase_composition }}
                </div>
              {% endif %}

              {% if order_data.mel_operational_checkout %}
                <div class="mel-my-tickets-operational-checkout mel-mt-3" role="region" aria-label="{{ 'Operational checkout plan'|t }}">
                  {{ order_data.mel_operational_checkout }}
                </div>
              {% endif %}

              {% if order_data.operational_addon_guidance %}
                <div class="mel-my-tickets-addon-guidance mel-mt-3" role="region" aria-label="{{ 'Your add-ons'|t }}">
                  {{ order_data.operational_addon_guidance }}
                </div>
              {% endif %}

              <div class="mel-order-actions mel-mt-4">
                <a href="{{ url('myeventlane_checkout_flow.order_detail', {'commerce_order': order_data.order_id}) }}"
                   class="mel-button mel-button--primary">
                  {{ 'View booking'|t }}
                </a>
                {% if order_data.events|length > 0 %}
                  {% for event in order_data.events %}
                    <a href="{{ event.ics_url }}"
                       class="mel-button mel-button--secondary"
                       download>
                      {{ 'Add to calendar'|t }}
                    </a>
                  {% endfor %}
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if past_orders|length > 0 %}
    <div class="mel-section mel-mt-6">
      <details class="mel-past-events"{{ upcoming_orders|length == 0 ? ' open' : '' }}>
        <summary class="mel-section-title">{{ 'Past'|t }} ({{ past_orders|length }})</summary>
        <div class="mel-order-cards mel-mt-4">
          {% for order_data in past_orders %}
            <div class="mel-card mel-order-card mel-mt-4">
              <div class="mel-card-body">
                {% if order_data.events|length > 0 %}
                  <div class="mel-order-events">
                    {% for event in order_data.events %}
                      <h3 class="mel-event-title">
                        <a href="{{ event.url }}" class="mel-link">{{ event.title }}</a>
                      </h3>
                      {% if event.start_date %}
                        <div class="mel-event-meta">
                          <span class="mel-event-date">{{ event.start_date }}</span>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="mel-order-info mel-mt-4">
                  <div class="mel-order-meta">
                    <span class="mel-order-number">
                      <strong>{{ 'Booking'|t }}:</strong> {{ order_data.order_number }}
                    </span>
                    <span class="mel-order-date">
                      <strong>{{ 'Purchased'|t }}:</strong> {{ order_data.placed_date }}
                    </span>
                  </div>
                </div>

                {% if order_data.mel_customer_operational_experience %}
                  <div class="mel-my-tickets-operational mel-mt-3">
                    {{ order_data.mel_customer_operational_experience }}
                  </div>
                {% endif %}

                {% if order_data.mel_operational_fulfillment_execution_customer %}
                  <div class="mel-my-tickets-fulfillment-execution mel-mt-3" role="region" aria-label="{{ 'On-site fulfillment'|t }}">
                    {{ order_data.mel_operational_fulfillment_execution_customer }}
                  </div>
                {% endif %}

                {% if order_data.mel_operational_purchase_composition %}
                  <div class="mel-my-tickets-operational-composition mel-mt-3" role="region" aria-label="{{ 'Operational packages'|t }}">
                    {{ order_data.mel_operational_purchase_composition }}
                  </div>
                {% endif %}

                {% if order_data.mel_operational_checkout %}
                  <div class="mel-my-tickets-operational-checkout mel-mt-3" role="region" aria-label="{{ 'Operational checkout plan'|t }}">
                    {{ order_data.mel_operational_checkout }}
                  </div>
                {% endif %}

                {% if order_data.operational_addon_guidance %}
                  <div class="mel-my-tickets-addon-guidance mel-mt-3" role="region" aria-label="{{ 'Your add-ons'|t }}">
                    {{ order_data.operational_addon_guidance }}
                  </div>
                {% endif %}

                <div class="mel-order-actions mel-mt-4">
                  <a href="{{ url('myeventlane_checkout_flow.order_detail', {'commerce_order': order_data.order_id}) }}"
                     class="mel-button mel-button--secondary">
                    {{ 'View booking'|t }}
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </details>
    </div>
  {% endif %}

  {% if upcoming_orders|length == 0 and past_orders|length == 0 %}
    {% if mel_my_tickets_empty is defined and mel_my_tickets_empty %}
      <div class="mel-section mel-mt-6">
        {{ mel_my_tickets_empty }}
      </div>
    {% endif %}
  {% endif %}
</div>
