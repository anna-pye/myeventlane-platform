{#
/**
 * @file
 * Vendor Door Mode — full-screen operational scanning chrome.
 *
 * Variables: event, event_id, validate_url, door_context,
 * csrf_token, operations_url — passed through controller.
 */
#}
<div class="mel-vendor-door mel-live-operations" data-mel-vendor-door>

  <header class="mel-vendor-door__top">
    <div class="mel-vendor-door__top-row">
      <a class="mel-vendor-door__back" href="{{ operations_url|default('#') }}">{{ 'Leave door mode'|t }}</a>
      {% if door_context.last_sync_iso|default('') is not empty %}
        <span class="mel-vendor-door__sync-chip">
          {{ 'Synced'|t }}
          ·
          <time datetime="{{ door_context.last_sync_iso }}">{{ door_context.last_sync_formatted|default('') }}</time>
        </span>
      {% endif %}
    </div>

    {% if event %}
      <h1 class="mel-vendor-door__event-heading">{{ event.label() }}</h1>
    {% else %}
      <h1 class="mel-vendor-door__event-heading">{{ 'Door check-in'|t }}</h1>
    {% endif %}

    {% if door_context.count_line %}
      <div class="mel-vendor-door__live-count" aria-live="polite">
        <span class="mel-vendor-door__live-dot" aria-hidden="true"></span>
        <span class="mel-vendor-door__live-strong">{{ door_context.live_indicator }}</span>
        <span>{{ door_context.count_line }}</span>
      </div>
      <div class="mel-vendor-door__mini-metrics" aria-label="{{ 'Check-in completeness'|t }}">
        <span>{{ door_context.checked_in }}/{{ door_context.total }} {{ 'in'|t }}</span>
        <span class="mel-vendor-door__divider" aria-hidden="true">/</span>
        <span>{{ door_context.rate_percent|default(0) }}% {{ 'rate'|t }}</span>
      </div>
    {% endif %}
  </header>

  <main class="mel-vendor-door__main">
    <section class="mel-vendor-door__scanner-shell" aria-labelledby="mel-vendor-door-scan-heading">
      <div class="mel-vendor-door__scanner-heading" id="mel-vendor-door-scan-intro">
        <h2 id="mel-vendor-door-scan-heading">{{ 'Ticket scanner'|t }}</h2>
        <p>{{ 'Centre the QR inside the glowing frame — we confirm each ticket quietly.'|t }}</p>
      </div>

      <div class="mel-vendor-door__camera-frame" data-mel-door-camera-shell>
        <div class="mel-vendor-door__camera-grid" aria-hidden="true"></div>
        <div class="mel-vendor-door__camera-glow" aria-hidden="true"></div>
        <div id="mel-vendor-door-camera" class="mel-vendor-door__camera" hidden></div>
        <button type="button" class="mel-btn mel-btn--primary mel-vendor-door__mega-cta" data-mel-door-start-scan aria-describedby="mel-vendor-door-scan-intro">
          {{ 'Start scanning'|t }}
        </button>
        <button type="button" class="mel-btn mel-btn--secondary mel-vendor-door__torch-control" data-mel-door-torch hidden aria-pressed="false" aria-label="{{ 'Toggle camera light'|t }}">
          {{ 'Light on'|t }}
        </button>
      </div>
    </section>

    <section class="mel-vendor-door__manual-card" aria-labelledby="mel-door-manual-title">
      <div class="mel-vendor-door__manual-intro">
        <h2 id="mel-door-manual-title">{{ 'Type a code instead'|t }}</h2>
        <p>{{ 'Same rules as scanning — paste a long token or enter a short ticket code if the camera is unavailable.'|t }}</p>
      </div>

      <div class="mel-checkin mel-vendor-door__manual-fields" data-mel-door-checkin>
        <label class="mel-vendor-door__field-label" for="checkin-input">{{ 'Ticket code'|t }}</label>
        <input
          type="text"
          id="checkin-input"
          class="mel-vendor-door__field-input mel-checkin__input"
          autocomplete="off"
          autocapitalize="characters"
          enterkeyhint="go"
          inputmode="text"
          placeholder="{{ 'Long QR token or short purchase code'|t }}"
        />

        <div
          id="checkin-result"
          class="mel-door-result-card mel-vendor-door__result-card"
          role="status"
          aria-live="polite"
          hidden
          data-state=""
        >
          <div class="mel-door-result-card__icon-row" aria-hidden="true"></div>
          <p data-mel-door-result-title class="mel-door-result-card__title"></p>
          <p data-mel-door-result-meta class="mel-door-result-card__meta"></p>
          <p data-mel-door-result-detail class="mel-door-result-card__detail"></p>
          <div class="mel-door-result-card__badges" data-mel-door-result-badges hidden></div>
        </div>

        <div id="checkin-candidates" class="mel-door-candidate-stack mel-vendor-door__candidate-stack" role="presentation" hidden></div>

        <p class="mel-vendor-door__manual-hint">{{ 'You can switch between scanning and typing any time.'|t }}</p>
      </div>
    </section>

  </main>

  <div class="mel-vendor-door__sticky-scan" aria-label="{{ 'Primary scan action'|t }}">
    <button type="button" class="mel-btn mel-btn--primary mel-vendor-door__sticky-btn" data-mel-door-sticky-scan>
      {{ 'Scan QR'|t }}
    </button>
  </div>
</div>
