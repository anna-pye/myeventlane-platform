{#
/**
 * @file
 * Digital event pass — primary attendee experience.
 *
 * Hierarchy: Event → QR (hero) → Ticket → Wallet/PDF → Readiness accordion → Purchase.
 * Operational models: UniversalTicketViewModelBuilder.
 * ACE pass: ticket.pass. Readiness: order.readiness (collapsed; reuse only).
 */
#}

{% set readiness = order.readiness|default({}) %}

<div class="mel-order-detail mel-order-detail--wallet">
  <div class="mel-order-detail__nav">
    <a href="{{ url('myeventlane_checkout_flow.my_tickets') }}" class="mel-link mel-back-link mel-order-detail__back">
      {{ '← Back to bookings'|t }}
    </a>
  </div>

  {% if order.ticket_models|default([])|length > 0 %}
  <div class="mel-order-detail__passes" aria-label="{{ 'Your Digital Passes'|t }}">
    {% for ticket in order.ticket_models %}
      {% set pass = ticket.pass|default({}) %}
      {% set event = pass.event|default(null) %}
      {% set status_key = pass.status_key|default('ticket_ready') %}
      {% set labels = pass.labels|default({}) %}
      <article class="mel-ticket-pass mel-ticket-pass--{{ status_key }}" aria-labelledby="mel-pass-title-{{ loop.index }}">

        {# ---- Event (compact) ---- #}
        <header class="mel-ticket-pass__header">
          <div class="mel-ticket-pass__event">
            {% if event and event.title %}
              <p class="mel-ticket-pass__eyebrow">{{ 'Digital Pass'|t }}</p>
              <h2 class="mel-ticket-pass__event-title" id="mel-pass-title-{{ loop.index }}">
                {% if event.url %}
                  <a href="{{ event.url }}" class="mel-link">{{ event.title }}</a>
                {% else %}
                  {{ event.title }}
                {% endif %}
              </h2>
              <dl class="mel-ticket-pass__event-meta">
                {% if event.start_date %}
                  <div class="mel-ticket-pass__meta-row">
                    <dt>{{ 'Date'|t }}</dt>
                    <dd>{{ event.start_date }}</dd>
                  </div>
                {% endif %}
                {% if event.start_time %}
                  <div class="mel-ticket-pass__meta-row">
                    <dt>{{ 'Time'|t }}</dt>
                    <dd>{{ event.start_time }}{% if event.end_time %} – {{ event.end_time }}{% endif %}</dd>
                  </div>
                {% endif %}
                {% if event.location %}
                  <div class="mel-ticket-pass__meta-row">
                    <dt>{{ 'Venue'|t }}</dt>
                    <dd>{{ event.location }}</dd>
                  </div>
                {% endif %}
              </dl>
            {% else %}
              <p class="mel-ticket-pass__eyebrow">{{ 'Digital Pass'|t }}</p>
              <h2 class="mel-ticket-pass__event-title" id="mel-pass-title-{{ loop.index }}">{{ ticket.ticket.entitlement_label }}</h2>
            {% endif %}
          </div>
          <span
            class="mel-badge mel-badge--{% if status_key == 'ticket_ready' %}success{% elseif status_key in ['cancelled', 'expired'] %}neutral{% elseif status_key == 'checked_in' %}info{% else %}info{% endif %} mel-ticket-pass__status"
            role="status"
            aria-label="{{ 'Ticket status: @status'|t({'@status': pass.status_label|default(ticket.ticket.status_label)}) }}"
          >
            {{ pass.status_label|default(ticket.ticket.status_label) }}
          </span>
        </header>

        {# ---- Large QR (hero) ---- #}
        {% if ticket.qr.data_uri %}
          <section
            class="mel-ticket-pass__qr mel-ticket-pass__qr--hero"
            id="{% if loop.first %}mel-pass-entry{% else %}mel-pass-entry-{{ loop.index }}{% endif %}"
            aria-labelledby="mel-pass-qr-{{ loop.index }}"
          >
            <h3 class="visually-hidden" id="mel-pass-qr-{{ loop.index }}">{{ 'Entry QR code'|t }}</h3>
            <img
              src="{{ ticket.qr.data_uri }}"
              alt="{{ 'QR code for entry. Ticket code @code. Show this screen at the door.'|t({'@code': ticket.ticket.code|default('')}) }}"
              width="280"
              height="280"
              decoding="async"
            >
            <p class="mel-ticket-pass__qr-hint">{{ pass.next_step|default('Show this QR code at entry when you arrive.'|t) }}</p>
            <p class="mel-ticket-pass__qr-a11y">{{ 'If the QR code cannot be scanned, give staff your ticket code: @code'|t({'@code': ticket.ticket.code|default('')}) }}</p>
          </section>
        {% elseif ticket.qr.unavailable|default(false) %}
          <div
            class="mel-ticket-pass__qr-unavailable"
            id="{% if loop.first %}mel-pass-entry{% else %}mel-pass-entry-{{ loop.index }}{% endif %}"
            role="status"
          >
            <p class="mel-ticket-pass__qr-unavailable-title">{{ 'QR code temporarily unavailable'|t }}</p>
            <p class="mel-ticket-pass__qr-unavailable-body">{{ 'Your booking remains valid. Please contact support if this issue persists.'|t }}</p>
            {% if ticket.ticket.code %}
              <p class="mel-ticket-pass__qr-a11y">{{ 'Ticket code: @code'|t({'@code': ticket.ticket.code}) }}</p>
            {% endif %}
          </div>
        {% endif %}

        {# ---- Ticket meta ---- #}
        <section class="mel-ticket-pass__ticket" aria-labelledby="mel-pass-ticket-{{ loop.index }}">
          <h3 class="mel-ticket-pass__section-title" id="mel-pass-ticket-{{ loop.index }}">{{ 'Ticket'|t }}</h3>
          <dl class="mel-ticket-pass__ticket-meta">
            {% if ticket.holder.name or ticket.holder.email %}
              <div class="mel-ticket-pass__meta-row">
                <dt>{{ 'Ticket holder'|t }}</dt>
                <dd>
                  {{ ticket.holder.name|default('') }}
                  {% if ticket.holder.email %}
                    <span class="mel-ticket-pass__email">{{ ticket.holder.email }}</span>
                  {% endif %}
                </dd>
              </div>
            {% endif %}
            <div class="mel-ticket-pass__meta-row">
              <dt>{{ 'Ticket type'|t }}</dt>
              <dd>{{ ticket.ticket.entitlement_label }}</dd>
            </div>
            <div class="mel-ticket-pass__meta-row">
              <dt>{{ 'Status'|t }}</dt>
              <dd>{{ pass.status_label|default(ticket.ticket.status_label) }}</dd>
            </div>
            {% if pass.booking_number %}
              <div class="mel-ticket-pass__meta-row">
                <dt>{{ 'Booking number'|t }}</dt>
                <dd><code class="mel-ticket-pass__booking-number">{{ pass.booking_number }}</code></dd>
              </div>
            {% endif %}
            {% if ticket.ticket.code %}
              <div class="mel-ticket-pass__meta-row">
                <dt>{{ 'Ticket code'|t }}</dt>
                <dd><code class="mel-ticket-pass__ticket-code">{{ ticket.ticket.code }}</code></dd>
              </div>
            {% endif %}
          </dl>
        </section>

        {# ---- Wallet + PDF (then secondary) ----
           Official Add to Apple/Google Wallet badge SVGs must be installed at
           myeventlane_wallet/assets/web/ (see assets/web/README.md). Until then,
           accessible text CTAs are shown — never invent platform badges. #}
        <div class="mel-ticket-pass__actions" aria-label="{{ 'Pass actions'|t }}">
          {% if ticket.actions.wallet.apple.url|default('') %}
            {# Official SVG badge preferred when assets/web/add-to-apple-wallet.svg is present. #}
            <a href="{{ ticket.actions.wallet.apple.url }}" class="mel-button mel-button--secondary mel-ticket-pass__wallet mel-ticket-pass__wallet--apple" download>
              {{ 'Add to Apple Wallet'|t }}
            </a>
          {% endif %}
          {% if ticket.actions.wallet.google.url|default('') %}
            {# Official SVG badge preferred when assets/web/add-to-google-wallet.svg is present. #}
            <a href="{{ ticket.actions.wallet.google.url }}" class="mel-button mel-button--secondary mel-ticket-pass__wallet mel-ticket-pass__wallet--google" rel="noopener noreferrer">
              {{ 'Add to Google Wallet'|t }}
            </a>
          {% endif %}
          {% if ticket.actions.pdf.download.url %}
            <a href="{{ ticket.actions.pdf.download.url }}" class="mel-button {% if ticket.actions.wallet.apple.url|default('') or ticket.actions.wallet.google.url|default('') %}mel-button--secondary{% else %}mel-button--primary{% endif %} mel-ticket-pass__pdf">
              {{ labels.download_ticket|default('Download ticket'|t) }}
            </a>
          {% endif %}
        </div>

        {% if (event and event.ics_url) or (event and event.url) %}
          <div class="mel-ticket-pass__secondary-actions">
            {% if event and event.ics_url %}
              <a href="{{ event.ics_url }}" class="mel-link" download>
                {{ labels.add_to_calendar|default('Add to calendar'|t) }}
              </a>
            {% endif %}
            {% if event and event.url %}
              <a href="{{ event.url }}" class="mel-link">
                {{ labels.view_event|default('View event'|t) }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if ticket.scanner.message and status_key != 'ticket_ready' %}
          <p class="mel-ticket-pass__scan-note" role="status">{{ ticket.scanner.message }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
  {% endif %}

  {# ---- Event Readiness (collapsed accordion; existing data only) ---- #}
  {% if readiness.primary_action|default(null) or readiness.detail_items|default([])|length > 0 %}
      <details class="mel-event-readiness mel-event-readiness--accordion" id="mel-event-readiness">
        <summary class="mel-event-readiness__summary">
          <span class="mel-event-readiness__summary-label">{{ readiness.summary|default('Need more information?'|t) }}</span>
          <span class="mel-event-readiness__summary-hint">{{ readiness.heading|default('Event readiness'|t) }}</span>
        </summary>
        <div class="mel-event-readiness__panel">
          {% if readiness.state_label %}
            <p class="mel-event-readiness__state-line" role="status">
              <span class="visually-hidden">{{ 'Booking status'|t }}:</span>
              {{ readiness.state_label }}
            </p>
          {% endif %}
          {% if readiness.intro %}
            <p class="mel-event-readiness__intro">{{ readiness.intro }}</p>
          {% endif %}
          {% if readiness.primary_action and readiness.primary_action.url and readiness.primary_action.label %}
            <div class="mel-event-readiness__primary">
              <a
                href="{{ readiness.primary_action.url }}"
                class="mel-button mel-button--primary mel-event-readiness__primary-action"
                {% if readiness.primary_action.url starts with 'http' %}rel="noopener noreferrer" target="_blank"{% endif %}
              >{{ readiness.primary_action.label }}</a>
            </div>
          {% endif %}
          {% if readiness.detail_items|default([])|length > 0 %}
            <h3 class="visually-hidden" id="mel-event-readiness-checklist">{{ readiness.checklist_heading|default('Your checklist'|t) }}</h3>
            <ul class="mel-event-readiness__checklist" aria-labelledby="mel-event-readiness-checklist">
              {% for item in readiness.detail_items %}
                <li class="mel-event-readiness__item mel-event-readiness__item--ready">
                  <span class="mel-event-readiness__check" aria-hidden="true">✓</span>
                  <div class="mel-event-readiness__item-body">
                    <span class="mel-event-readiness__item-label">{{ item.label }}</span>
                    {% if item.detail %}
                      <span class="mel-event-readiness__item-detail">
                        {% if item.url %}
                          <a
                            href="{{ item.url }}"
                            class="mel-link"
                            {% if item.url starts with 'http' %}rel="noopener noreferrer" target="_blank"{% endif %}
                          >{{ item.detail }}</a>
                        {% else %}
                          {{ item.detail }}
                        {% endif %}
                      </span>
                    {% elseif item.url %}
                      <a
                        href="{{ item.url }}"
                        class="mel-link mel-event-readiness__item-link"
                        {% if item.url starts with 'http' %}rel="noopener noreferrer" target="_blank"{% endif %}
                      >{{ item.label }}</a>
                    {% endif %}
                  </div>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if readiness.reminder_note %}
            <p class="mel-event-readiness__reminder" role="note">{{ readiness.reminder_note }}</p>
          {% endif %}
        </div>
      </details>
  {% elseif order.help is defined %}
    {# Fallback help when readiness payload absent (legacy). #}
    <aside class="mel-order-detail__help" aria-labelledby="mel-order-help-heading">
      <h2 class="mel-order-detail__help-title" id="mel-order-help-heading">{{ 'Need help?'|t }}</h2>
      <ul class="mel-order-detail__help-list">
        {% if order.help.refund_url %}
          <li><a href="{{ order.help.refund_url }}" class="mel-link">{{ 'Refund policy'|t }}</a></li>
        {% endif %}
        {% if order.help.help_centre_url %}
          <li><a href="{{ order.help.help_centre_url }}" class="mel-link">{{ 'Help Centre'|t }}</a></li>
        {% endif %}
        {% if order.events|first and order.events|first.url %}
          <li><a href="{{ order.events|first.url }}" class="mel-link">{{ 'Event page for organiser details'|t }}</a></li>
        {% endif %}
      </ul>
    </aside>
  {% endif %}

  {% if operational_addon_guidance %}
    <div class="mel-order-detail-addon-guidance mel-section mel-mt-4" role="region" aria-label="{{ 'Your add-ons'|t }}">
      {{ operational_addon_guidance }}
    </div>
  {% endif %}

  {% if order.events|length > 0 and order.ticket_models|default([])|length == 0 %}
    <div class="mel-section mel-mt-6">
      <h2 class="mel-section-title">{{ 'Your events'|t }}</h2>
      {% for event in order.events %}
        <div class="mel-card mel-event-card mel-mt-4">
          <div class="mel-card-body">
            <h3 class="mel-event-title">
              <a href="{{ event.url }}" class="mel-link">{{ event.title }}</a>
            </h3>
            <div class="mel-event-actions mel-mt-4">
              <a href="{{ event.ics_url }}" class="mel-button mel-button--primary" download>{{ 'Add to calendar'|t }}</a>
              <a href="{{ event.url }}" class="mel-button mel-button--secondary">{{ 'View event page'|t }}</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% if order.ticket_models|default([])|length == 0 and order.ticket_items|length > 0 %}
    <div class="mel-section mel-mt-6">
      <h2 class="mel-section-title">{{ 'Tickets'|t }}</h2>
      <div class="mel-card mel-mt-4">
        <div class="mel-card-body">
          {% for ticket in order.ticket_items %}
            <div class="mel-ticket-item mel-mt-4{% if not loop.first %} mel-pt-4 mel-border-top{% endif %}">
              <strong>{{ ticket.title }}</strong>
              <div class="mel-ticket-meta mel-mt-2">
                <span>{{ 'Quantity'|t }}: {{ ticket.quantity }}</span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if order.donation_total > 0 %}
    <div class="mel-section mel-mt-6">
      <div class="mel-card mel-card-highlight">
        <div class="mel-card-body">
          <h3 class="mel-donation-title">{{ 'Your contribution'|t }}</h3>
          <p class="mel-donation-amount mel-mt-2">
            <strong>{{ 'Amount'|t }}:</strong> ${{ order.donation_total|number_format(2) }}
          </p>
        </div>
      </div>
    </div>
  {% endif %}

  {# ---- Purchase details (collapsed; secondary) ---- #}
  <details class="mel-order-detail__purchase" id="mel-order-purchase">
    <summary class="mel-order-detail__purchase-summary">{{ 'Purchase details'|t }}</summary>
    <div class="mel-order-detail__purchase-body">
      <p class="mel-order-detail__reference">
        <strong>{{ 'Booking reference'|t }}:</strong> {{ order.order_number|default(title) }}
      </p>
      <p>
        <strong>{{ 'Purchased'|t }}:</strong> {{ order.placed_date }}
      </p>
      <p>
        <strong>{{ 'Confirmation'|t }}:</strong> {{ order.state_customer_presentation|default(order.state) }}
      </p>
      <p>
        <strong>{{ 'Amount paid'|t }}:</strong> ${{ order.total_price|number_format(2) }}
      </p>
      {% if order.total_price > 0 %}
        <p class="mel-mt-3">
          <a href="{{ url('myeventlane_checkout_flow.order_tax_invoice_pdf', {'commerce_order': order.order_id}) }}" class="mel-button mel-button--secondary">
            {{ 'Download payment receipt (PDF)'|t }}
          </a>
        </p>
      {% endif %}
    </div>
  </details>

  <div class="mel-order-actions">
    <a href="{{ url('myeventlane_checkout_flow.my_tickets') }}" class="mel-button mel-button--secondary">
      {{ 'Back to bookings'|t }}
    </a>
  </div>
</div>
