{#
/**
 * @file
 * Template for vendor Attendees & Sales dashboard.
 *
 * Available variables:
 * - title: Page title
 * - events: (legacy) Array of event data - kept for backward compatibility
 * - mel_cards: Array of event card data keyed by event ID
 * - mel_kpis: { events, tickets_sold, revenue, upcoming }
 * - operational_summaries: Per-event operational totals from
 *   MelAttendeeOperationsPresenter (id, title, url, totals).
 * - mel_vendor_attendees_dashboard_empty: Governed empty render (mel_empty_state).
 */
#}

<div class="mel-attendees-page mel-vendor-attendees-dashboard mel-attendee-operations">
  <div class="mel-page-header">
    <h1 class="mel-page-title">{{ title }}</h1>
    <p class="mel-page-description">
      {{ 'View attendees and sales for your events.'|t }}
    </p>
  </div>

  {% if mel_vendor_contextual_help is defined and mel_vendor_contextual_help %}
    <div class="mel-contextual-help mel-contextual-help--vendor-console">
      {{ mel_vendor_contextual_help }}
    </div>
  {% endif %}

  {% if mel_stats_unavailable %}
    <section class="mel-card mel-mt-6" role="status" aria-labelledby="mel-attendee-stats-unavailable-title">
      <div class="mel-card-body">
        <h2 id="mel-attendee-stats-unavailable-title">{{ 'Attendee overview temporarily unavailable'|t }}</h2>
        <p>{{ 'Your event and attendee records are safe. Refresh the page shortly, or open an event workspace to manage that event directly.'|t }}</p>
        <a href="{{ path('myeventlane_vendor.console.events') }}" class="mel-btn mel-btn--secondary">{{ 'Choose an event'|t }}</a>
      </div>
    </section>
  {% elseif mel_cards is not empty %}
    <div class="mel-attendees-kpi-bar">
      <div class="mel-attendees-kpi-bar__kpi">
        <span class="mel-attendees-kpi-bar__label">{{ 'Events'|t }}</span>
        <span class="mel-attendees-kpi-bar__value">{{ mel_kpis.events }}</span>
      </div>
      <div class="mel-attendees-kpi-bar__kpi">
        <span class="mel-attendees-kpi-bar__label">{{ 'Tickets Sold'|t }}</span>
        <span class="mel-attendees-kpi-bar__value">{{ mel_kpis.tickets_sold }}</span>
      </div>
      <div class="mel-attendees-kpi-bar__kpi">
        <span class="mel-attendees-kpi-bar__label">{{ 'Revenue'|t }}</span>
        <span class="mel-attendees-kpi-bar__value">${{ mel_kpis.revenue }}</span>
      </div>
      <div class="mel-attendees-kpi-bar__kpi">
        <span class="mel-attendees-kpi-bar__label">{{ 'Upcoming'|t }}</span>
        <span class="mel-attendees-kpi-bar__value">{{ mel_kpis.upcoming }}</span>
      </div>
    </div>

    <div class="mel-attendees-event-cards">
      {% for event_id, mel in mel_cards %}
        {% include '@myeventlane_checkout_flow/components/mel-attendees-event-card.html.twig' with {
          mel: mel
        } only %}
      {% endfor %}
    </div>

    {% if operational_summaries is defined and operational_summaries is not empty %}
      <section class="mel-attendee-operations__summaries" aria-labelledby="mel-attendee-ops-summary-heading">
        <h2 id="mel-attendee-ops-summary-heading" class="mel-attendee-operations__summaries-heading">
          {{ 'Operational readiness'|t }}
        </h2>
        <ul class="mel-attendee-operations__summary-list">
          {% for summary in operational_summaries %}
            <li class="mel-attendee-operations__summary-item">
              <a class="mel-attendee-operations__summary-link" href="{{ summary.url }}">
                <span class="mel-attendee-operations__summary-title">{{ summary.title }}</span>
                <span class="mel-attendee-operations__summary-totals">
                  <span class="mel-attendee-operations__chip mel-attendee-operations__chip--registered">
                    {{ '@n registered'|t({'@n': summary.totals.active}) }}
                  </span>
                  <span class="mel-attendee-operations__chip mel-attendee-operations__chip--checked-in">
                    {{ '@n checked in'|t({'@n': summary.totals.checked_in}) }}
                  </span>
                  {% if summary.totals.pending > 0 %}
                    <span class="mel-attendee-operations__chip mel-attendee-operations__chip--pending">
                      {{ '@n pending'|t({'@n': summary.totals.pending}) }}
                    </span>
                  {% endif %}
                  {% if summary.totals.refunded > 0 %}
                    <span class="mel-attendee-operations__chip mel-attendee-operations__chip--refunded">
                      {{ '@n refunded'|t({'@n': summary.totals.refunded}) }}
                    </span>
                  {% endif %}
                  {% if summary.totals.invalid > 0 %}
                    <span class="mel-attendee-operations__chip mel-attendee-operations__chip--invalid">
                      {{ '@n need attention'|t({'@n': summary.totals.invalid}) }}
                    </span>
                  {% endif %}
                </span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  {% elseif events is not empty %}
    {# Fallback when mel_cards not provided (e.g. before cache clear) #}
    <div class="mel-events-list mel-mt-6">
      {% for event_data in events %}
        <div class="mel-card mel-event-card mel-mt-4">
          <div class="mel-card-body">
            <div class="mel-event-header">
              <h2 class="mel-event-title">
                <a href="{{ event_data.url }}" class="mel-link">{{ event_data.title }}</a>
              </h2>
              {% if event_data.start_date %}
                <div class="mel-event-date">📅 {{ event_data.start_date }}</div>
              {% endif %}
            </div>
            <div class="mel-event-stats mel-mt-4">
              <div class="mel-stat-row">
                <div class="mel-stat-item">
                  <div class="mel-stat-label">{{ 'Tickets Sold'|t }}</div>
                  <div class="mel-stat-value">{{ event_data.tickets_sold }}</div>
                </div>
                <div class="mel-stat-item">
                  <div class="mel-stat-label">{{ 'Attendees'|t }}</div>
                  <div class="mel-stat-value">{{ event_data.attendee_count }}</div>
                </div>
                <div class="mel-stat-item">
                  <div class="mel-stat-label">{{ 'Revenue'|t }}</div>
                  <div class="mel-stat-value">${{ event_data.revenue|number_format(2) }}</div>
                </div>
              </div>
            </div>
            <div class="mel-event-actions mel-mt-4">
              <a href="{{ url('myeventlane_event_attendees.vendor_operations_door', {'node': event_data.id}) }}" class="mel-btn mel-btn-primary">✓ {{ 'Check In'|t }}</a>
              <a href="{{ url('myeventlane_event_attendees.vendor_list', {'node': event_data.id}) }}" class="mel-btn mel-btn-secondary">{{ 'View Attendees'|t }}</a>
              <a href="{{ url('myeventlane_views.attendee_csv', [], {'query': {'download_csv': event_data.id}}) }}" class="mel-btn mel-btn-secondary" target="_blank">📥 {{ 'Export CSV'|t }}</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    {% if mel_vendor_attendees_dashboard_empty is defined and mel_vendor_attendees_dashboard_empty %}
      <div class="mel-mt-6">
        {{ mel_vendor_attendees_dashboard_empty }}
      </div>
    {% endif %}
  {% endif %}
</div>
