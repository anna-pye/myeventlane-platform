{#
/**
 * @file
 * Notification bell shell; list + badge updated via mel-notifications-ui.js.
 */
#}
<div class="mel-notif-bell" data-mel-notif-bell data-mel-bell-context="{{ bell_context }}">
  <button type="button"
          class="mel-notif-bell__trigger"
          data-mel-notif-bell-trigger
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="mel-notif-bell-panel"
          aria-label="{{ 'Notifications'|t }}">
    <span class="mel-notif-bell__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      </svg>
    </span>
    {% if bell_context == 'business' %}
      <span class="mel-notif-bell__trigger-label">{{ 'Updates'|t }}</span>
    {% endif %}
    <span class="mel-notif-bell__badge mel-notif-bell__badge--empty"
          data-mel-notif-bell-badge
          aria-live="polite"
          aria-label="{{ 'Unread notifications'|t }}">0</span>
  </button>

  <div class="mel-notif-bell__panel"
       id="mel-notif-bell-panel"
       data-mel-notif-bell-panel
       role="dialog"
       aria-modal="false"
       aria-label="{{ 'Recent notifications'|t }}"
       tabindex="-1"
       hidden>
    <div class="mel-notif-bell__panel-head">
      <span class="mel-notif-bell__panel-title">{{ bell_context == 'business' ? 'Organiser updates'|t : 'Notifications'|t }}</span>
      <button type="button" class="mel-notif-bell__mark-all" data-mel-notif-mark-all hidden>
        {{ 'Mark all read'|t }}
      </button>
    </div>
    <div class="mel-notif-bell__panel-body"
         data-mel-notif-bell-list
         aria-label="{{ 'Unread notifications'|t }}">
      <p class="mel-notif-bell__loading">{{ 'Loading…'|t }}</p>
    </div>
    <div class="mel-notif-bell__panel-foot">
      <a href="{{ inbox_url }}" class="mel-notif-bell__inbox-link">{{ bell_context == 'business' ? 'Open Action Centre'|t : 'View inbox'|t }}</a>
      {% if settings_url %}
        <a href="{{ settings_url }}" class="mel-notif-bell__settings-link">{{ 'Notification settings'|t }}</a>
      {% endif %}
    </div>
  </div>
</div>
