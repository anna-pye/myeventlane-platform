<?php

/**
 * @file
 * MyEventLane RSVP module hooks.
 */

declare(strict_types=1);

use Drupal\Core\Block\BlockPluginInterface;
use Drupal\Core\Render\Markup;

/**
 * Implements hook_mail().
 *
 * Handles RSVP confirmation emails with ticket PDF attachments.
 */
function myeventlane_rsvp_mail($key, &$message, $params) {
  switch ($key) {
    case 'rsvp_confirmation':
      $message['subject'] = t('Your RSVP Confirmation for @event', [
        '@event' => $params['event_title'] ?? 'the event',
      ]);

      if (!empty($params['override_body_html']) && is_string($params['override_body_html'])) {
        $message['body'] = [Markup::create($params['override_body_html'])];
      }
      else {

        // Build email body.
        $body = [];
        $body[] = t('Hi @name,', ['@name' => $params['name'] ?? 'there']);
        $body[] = '';
        $body[] = t("You're confirmed for @event!", [
          '@event' => $params['event_title'] ?? 'the event',
        ]);
        $body[] = '';

        if (!empty($params['event_date'])) {
          $body[] = t('Date: @date', ['@date' => $params['event_date']]);
        }
        if (!empty($params['event_location'])) {
          $body[] = t('Location: @location', ['@location' => $params['event_location']]);
        }
        $guests = max(1, (int) ($params['guests'] ?? 1));
        $body[] = t("You've reserved @count spot(s).", ['@count' => $guests]);

        $body[] = '';
        $body[] = t('Your ticket is attached to this email. You can also add this event to your calendar using the attached file.');
        $body[] = '';
        $body[] = t('See you there!');

        $message['body'] = $body;
      }

      // Handle attachments (ticket PDF and ICS).
      if (!empty($params['attachments']) && is_array($params['attachments'])) {
        if (!isset($message['params'])) {
          $message['params'] = [];
        }
        if (!isset($message['params']['attachments'])) {
          $message['params']['attachments'] = [];
        }

        foreach ($params['attachments'] as $attachment) {
          if (isset($attachment['filename']) && isset($attachment['content'])) {
            $message['params']['attachments'][] = [
              'filecontent' => $attachment['content'],
              'filename' => $attachment['filename'],
              'filemime' => $attachment['mime'] ?? 'application/octet-stream',
            ];
          }
        }
      }
      break;

    case 'rsvp_vendor_copy':
      $message['subject'] = t('New RSVP for @event', [
        '@event' => $params['event_title'] ?? 'your event',
      ]);

      $body = [];
      $body[] = t('A new RSVP has been received for @event.', [
        '@event' => $params['event_title'] ?? 'your event',
      ]);
      $body[] = '';
      $body[] = t('Attendee: @name (@email)', [
        '@name' => $params['name'] ?? 'Guest',
        '@email' => $params['email'] ?? '',
      ]);

      $message['body'] = $body;
      break;
  }
}

/**
 * Implements hook_block_build_alter().
 *
 * Belt-and-suspenders: the RSVP block must not render on the unified book page
 * (BookController already embeds RsvpPublicForm). Duplicate forms break POST.
 */
function myeventlane_rsvp_block_build_alter(array &$build, BlockPluginInterface $block): void {
  if ($block->getPluginId() !== 'mel_rsvp_form_block') {
    return;
  }
  $route = \Drupal::routeMatch()->getRouteName();
  $path = \Drupal::service('path.current')->getPath();
  if ($route === 'myeventlane_commerce.event_book' || preg_match('#^/event/\d+/book/?$#', $path) === 1) {
    $build = [
      '#markup' => '',
      '#cache' => [
        'contexts' => ['route', 'url.path'],
      ],
    ];
  }
}

/**
 * Implements hook_theme().
 */
function myeventlane_rsvp_theme($existing, $type, $theme, $path): array {
  return [
    'myeventlane_rsvp_account_rsvps' => [
      'variables' => [
        'rows' => [],
      ],
      'template' => 'myeventlane-rsvp-account-rsvps',
      'path' => $path . '/templates',
    ],
    'mel_rsvp_thankyou' => [
      'variables' => [
        'event' => NULL,
        'submission' => NULL,
        'attendee_name' => NULL,
        'attendee_email' => NULL,
        'donation' => NULL,
        'guests' => 1,
        'event_url' => NULL,
        'checkout_url' => NULL,
        'is_payment_pending' => FALSE,
        'donation_order_id' => NULL,
        'donation_checkout_url' => NULL,
        'donation_completed' => FALSE,
        'donation_pending' => FALSE,
        'can_add_post_rsvp_contribution' => FALSE,
        'cancel_url' => NULL,
        'mel_continuity' => NULL,
      ],
      'template' => 'mel-rsvp-thankyou',
      'path' => $path . '/templates',
    ],
  ];
}
