{#
/**
 * RSVP thank-you — customer continuity from mel_continuity (MEL governance).
 *
 * Theme override (thin delegate): myeventlane_theme/templates/rsvp/mel-rsvp-thankyou.html.twig
 */
#}
{% set mc = mel_continuity|default({}) %}

<div class="mel-rsvp-thankyou">
  <div class="mel-card mel-card--confirmation" role="region" aria-labelledby="mel-rsvp-confirm-heading">
    <h1 id="mel-rsvp-confirm-heading" class="mel-title">{{ mc.headline|default("You're going") }} <span aria-hidden="true">🎉</span></h1>

    <p class="mel-subtitle">{{ mc.subtitle|default('') }}</p>

    {% if mc.status_line is defined and mc.status_line %}
      <p class="mel-meta"{% if mc.donation_band is defined and mc.donation_band and mc.donation_band.type == 'pending' %} aria-live="polite"{% endif %}>
        {{ mc.status_line }}
      </p>
    {% endif %}

    {% for line in mc.meta_lines|default([]) %}
      <p class="mel-meta">{{ line }}</p>
    {% endfor %}

    {% set donation_checkout_href = donation_checkout_url|default(checkout_url)|default(mc.donation_band.checkout_url|default('')) %}
    {% if mc.donation_band is defined and mc.donation_band %}
      {% if mc.donation_band.type == 'pending' %}
        <section class="mel-donation-cta mel-donation-cta--pending" aria-labelledby="mel-rsvp-donation-pending-title">
          <div class="mel-donation-cta__icon" aria-hidden="true">💛</div>
          <h2 id="mel-rsvp-donation-pending-title" class="mel-donation-cta__title">{{ mc.donation_band.title }}</h2>
          <p class="mel-donation-cta__body">{{ mc.donation_band.body }}</p>
          <div class="mel-donation-progress">
            <div class="mel-donation-progress__bar"></div>
            <div class="mel-donation-progress__label">{{ mc.donation_band.progress_label }}</div>
          </div>
          {% if donation_checkout_href %}
            <div class="mel-donation-cta__actions">
              <a href="{{ donation_checkout_href }}" class="mel-btn mel-btn--primary">
                {{ mc.donation_band.contribution_button_label|default('Complete your contribution'|t) }}
              </a>
            </div>
            <p class="mel-donation-cta__reassurance">{{ mc.donation_band.reassurance }}</p>
          {% elseif donation > 0 and donation_pending %}
            <p class="mel-donation-cta__reassurance">{{ 'Your RSVP is confirmed. Donation checkout is temporarily unavailable — refresh this page or contact the organiser.'|t }}</p>
          {% endif %}
        </section>
      {% elseif mc.donation_band.type == 'complete' %}
        <section class="mel-donation-cta mel-donation-cta--complete">
          <h2 class="mel-donation-cta__title">{{ mc.donation_band.title }}</h2>
          <p class="mel-donation-cta__body">{{ mc.donation_band.body }}</p>
          <span class="mel-donation-cta__badge">{{ mc.donation_band.badge }}</span>
        </section>
      {% elseif mc.donation_band.type == 'upsell' %}
        <section class="mel-donation-cta mel-donation-cta--upsell">
          <h2 class="mel-donation-cta__title">{{ mc.donation_band.title }}</h2>
          <p class="mel-donation-cta__body">{{ mc.donation_band.body }}</p>
        </section>
      {% endif %}
    {% endif %}

    <div class="mel-actions mel-continuity-actions" data-mel-continuity-actions="rsvp_thankyou">
      {% for action in mc.continuity_actions|default([]) %}
        {% set btn_class = 'mel-btn mel-btn--secondary' %}
        {% if action.variant == 'primary' %}
          {% set btn_class = 'mel-btn mel-btn--primary' %}
        {% elseif action.variant == 'danger' %}
          {% set btn_class = 'mel-btn mel-btn--danger' %}
        {% endif %}
        <a href="{{ action.url }}" class="{{ btn_class }}"{% if action.download %} download{% endif %} data-mel-continuity-key="{{ action.key }}">
          {{ action.label }}
        </a>
      {% endfor %}
    </div>
  </div>
</div>
