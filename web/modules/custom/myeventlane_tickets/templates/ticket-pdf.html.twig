<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <title>{{ event_title|default('Event pass'|t) }}</title>
  <style>
    body {
      font-family: Helvetica, Arial, sans-serif;
      padding: 28px 20px;
      margin: 0;
      color: #2a2a2a;
      background: #f7f5f8;
    }
    .ticket {
      border: 2px solid {{ brand_accent_color|default('#6b46ff') }};
      border-radius: 18px;
      padding: 28px 24px;
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
    }
    .ticket-logo {
      text-align: center;
      margin-bottom: 20px;
    }
    .ticket-logo img {
      max-height: 50px;
      max-width: 200px;
    }
    .ticket-eyebrow {
      margin: 0 0 6px;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #888;
    }
    h1 {
      margin: 0 0 12px;
      font-size: 26px;
      line-height: 1.25;
      color: #222;
    }
    .ticket-event-meta {
      margin: 0 0 18px;
      padding-bottom: 16px;
      border-bottom: 1px dashed #e3e0e8;
    }
    .ticket-event-meta p {
      margin: 4px 0;
      color: #555;
      font-size: 14px;
    }
    .ticket-section-title {
      margin: 0 0 8px;
      font-size: 11px;
      font-weight: bold;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #888;
    }
    .code {
      font-size: 22px;
      font-weight: bold;
      color: {{ brand_accent_color|default('#6b46ff') }};
      margin: 8px 0 16px;
      letter-spacing: 0.02em;
    }
    .qr {
      margin: 20px 0;
      text-align: center;
      padding: 16px;
      background: #fafafa;
      border-radius: 12px;
    }
    .qr img {
      width: 200px;
      height: 200px;
      border: 1px solid #eee;
      border-radius: 8px;
      padding: 8px;
      background: #fff;
    }
    .qr-hint {
      margin: 12px 0 0;
      font-size: 13px;
      color: #555;
    }
    p {
      margin: 8px 0;
      color: #555;
      font-size: 14px;
    }
    .ticket-footer {
      margin-top: 22px;
      padding-top: 14px;
      border-top: 1px solid #eee;
      font-size: 11px;
      color: #999;
      text-align: center;
    }
    .mel-watermark {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid #eee;
      font-size: 10px;
      color: #bbb;
      text-align: center;
    }
    .ticket-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: bold;
      color: #fff;
      margin-right: 6px;
      margin-bottom: 4px;
    }
    .badge-entitlement { background: #6c63ff; }
    .badge-status { background: #2196f3; }
    .badge-fulfilment { background: #ff9800; }
    .badge-expiry { background: #e53935; }
    .ticket-meta {
      margin: 12px 0;
      font-size: 12px;
      color: #888;
    }
    .ticket-meta strong {
      color: #555;
    }
  </style>
</head>
<body>
  <div class="ticket">
    {% if brand_logo_url %}
      <div class="ticket-logo">
        <img src="{{ brand_logo_url }}" alt="{{ brand_vendor_name|default('') }}">
      </div>
    {% endif %}

    <p class="ticket-eyebrow">{{ 'Event pass'|t }}</p>
    <h1>{{ event_title }}</h1>

    <div class="ticket-event-meta">
      {% if event_start %}
        <p><strong>{{ 'When'|t }}:</strong> {{ event_start|date("d M Y, g:ia") }}</p>
      {% endif %}
      {% if location %}
        <p><strong>{{ 'Venue'|t }}:</strong> {{ location }}</p>
      {% endif %}
      {% if is_canonical and vendor_display.label|default('') %}
        <p><strong>{{ 'Organised by'|t }}:</strong> {{ vendor_display.label }}</p>
      {% endif %}
    </div>

    <p class="ticket-section-title">{{ 'Ticket'|t }}</p>

    {% if is_canonical and entitlement_type and entitlement_type != 'ticket' %}
      <p><strong>{{ entitlement_label }}</strong></p>
    {% endif %}

    {% if show_ticket_code %}
      <div class="code">
        {{ 'Ticket code'|t }}: {{ code }}
      </div>
    {% endif %}

    {% if include_qr_code and qr_data_uri %}
      <div class="qr">
        <img src="{{ qr_data_uri }}" alt="{{ 'Ticket QR code for entry'|t }}">
        <p class="qr-hint">{{ 'Show this code at entry'|t }}</p>
      </div>
    {% endif %}

    {% if holder %}
      <p><strong>{{ 'Ticket holder'|t }}:</strong> {{ holder }}</p>
    {% endif %}

    {% if not legacy and ticket %}
      {% if ticket.holder_email.value %}
        <p><strong>{{ 'Email'|t }}:</strong> {{ ticket.holder_email.value }}</p>
      {% endif %}
    {% endif %}

    {% if is_canonical and ticket_status_label %}
      <p><strong>{{ 'Status'|t }}:</strong> {{ ticket_status_label }}</p>
    {% endif %}

    {% if is_canonical and badges is not empty %}
      <div style="margin: 12px 0;">
        {% for badge in badges %}
          <span class="ticket-badge badge-{{ badge.type }}">{{ badge.label }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {% if is_canonical and fulfilment %}
      {% if fulfilment.status != 'pending' %}
        <div class="ticket-meta">
          <strong>{{ 'Fulfilment'|t }}:</strong> {{ fulfilment.status_label }}
        </div>
      {% endif %}
      {% if fulfilment.collect_location %}
        <div class="ticket-meta">
          <strong>{{ 'Collect at'|t }}:</strong> {{ fulfilment.collect_location }}
        </div>
      {% endif %}
      {% if fulfilment.vehicle_registration %}
        <div class="ticket-meta">
          <strong>{{ 'Vehicle'|t }}:</strong> {{ fulfilment.vehicle_registration }}
        </div>
      {% endif %}
    {% endif %}

    {% if is_canonical and expiry and expiry.expired %}
      <div class="ticket-meta" style="color: #e53935;">
        <strong>{{ 'This entitlement has expired.'|t }}</strong>
      </div>
    {% endif %}

    {% if is_canonical and redemption and redemption.multi_use %}
      <div class="ticket-meta">
        <strong>{{ 'Redemptions'|t }}:</strong> {{ redemption.count }}/{{ redemption.limit }}
      </div>
    {% endif %}

    {% if brand_footer_text %}
      <div class="ticket-footer">{{ brand_footer_text }}</div>
    {% endif %}

    {% if not is_pro_branded %}
      <div class="mel-watermark">{{ 'Powered by MyEventLane'|t }}</div>
    {% endif %}
  </div>
</body>
</html>
