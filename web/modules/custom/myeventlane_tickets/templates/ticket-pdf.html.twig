<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body {
      font-family: Helvetica, Arial, sans-serif;
      padding: 24px;
      margin: 0;
    }
    .ticket {
      border: 2px solid {{ brand_accent_color|default('#f26d5b') }};
      border-radius: 16px;
      padding: 24px;
      max-width: 600px;
      margin: 0 auto;
    }
    .ticket-logo {
      text-align: center;
      margin-bottom: 16px;
    }
    .ticket-logo img {
      max-height: 50px;
      max-width: 200px;
    }
    .code {
      font-size: 28px;
      font-weight: bold;
      color: {{ brand_accent_color|default('#f26d5b') }};
      margin: 16px 0;
    }
    .qr {
      margin: 18px 0;
      text-align: center;
    }
    .qr img {
      width: 180px;
      height: 180px;
      border: 1px solid #eee;
      border-radius: 8px;
      padding: 6px;
      background: #fff;
    }
    h1 {
      margin-top: 0;
      color: #333;
    }
    p {
      margin: 8px 0;
      color: #666;
    }
    .ticket-footer {
      margin-top: 20px;
      padding-top: 12px;
      border-top: 1px solid #eee;
      font-size: 11px;
      color: #999;
      text-align: center;
    }
    .mel-watermark {
      margin-top: 20px;
      padding-top: 12px;
      border-top: 1px solid #eee;
      font-size: 10px;
      color: #bbb;
      text-align: center;
    }
    .ticket-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: bold;
      color: #fff;
      margin-right: 6px;
      margin-bottom: 4px;
    }
    .badge-entitlement { background: #6c63ff; }
    .badge-status { background: #2196f3; }
    .badge-fulfilment { background: #ff9800; }
    .badge-expiry { background: #e53935; }
    .ticket-meta {
      margin: 12px 0;
      font-size: 12px;
      color: #888;
    }
    .ticket-meta strong {
      color: #555;
    }
  </style>
</head>
<body>
  <div class="ticket">
    {% if brand_logo_url %}
      <div class="ticket-logo">
        <img src="{{ brand_logo_url }}" alt="{{ brand_vendor_name|default('') }}">
      </div>
    {% endif %}

    <h1>{{ event_title }}</h1>
    {% if event_start %}
      <p>{{ event_start|date("d M Y, g:ia") }}</p>
    {% endif %}
    {% if location %}
      <p>{{ location }}</p>
    {% endif %}

    {% if is_canonical and entitlement_type and entitlement_type != 'ticket' %}
      <p><strong>{{ entitlement_label }}</strong></p>
    {% endif %}

    {% if show_ticket_code %}
      <div class="code">
        Ticket Code: {{ code }}
      </div>
    {% endif %}

    {% if include_qr_code and qr_data_uri %}
      <div class="qr">
        <img src="{{ qr_data_uri }}" alt="Ticket QR code">
      </div>
    {% endif %}

    {% if holder %}
      <p><strong>Ticket Holder:</strong> {{ holder }}</p>
    {% endif %}

    {% if not legacy and ticket %}
      {% if ticket.holder_email.value %}
        <p><strong>Email:</strong> {{ ticket.holder_email.value }}</p>
      {% endif %}
    {% endif %}

    {% if is_canonical and badges is not empty %}
      <div style="margin: 12px 0;">
        {% for badge in badges %}
          <span class="ticket-badge badge-{{ badge.type }}">{{ badge.label }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {% if is_canonical and fulfilment %}
      {% if fulfilment.status != 'pending' %}
        <div class="ticket-meta">
          <strong>Fulfilment:</strong> {{ fulfilment.status_label }}
        </div>
      {% endif %}
      {% if fulfilment.collect_location %}
        <div class="ticket-meta">
          <strong>Collect at:</strong> {{ fulfilment.collect_location }}
        </div>
      {% endif %}
      {% if fulfilment.vehicle_registration %}
        <div class="ticket-meta">
          <strong>Vehicle:</strong> {{ fulfilment.vehicle_registration }}
        </div>
      {% endif %}
    {% endif %}

    {% if is_canonical and expiry and expiry.expired %}
      <div class="ticket-meta" style="color: #e53935;">
        <strong>This entitlement has expired.</strong>
      </div>
    {% endif %}

    {% if is_canonical and redemption and redemption.multi_use %}
      <div class="ticket-meta">
        <strong>Redemptions:</strong> {{ redemption.count }}/{{ redemption.limit }}
      </div>
    {% endif %}

    {% if brand_footer_text %}
      <div class="ticket-footer">{{ brand_footer_text }}</div>
    {% endif %}

    {% if not is_pro_branded %}
      <div class="mel-watermark">Powered by MyEventLane</div>
    {% endif %}
  </div>
</body>
</html>
