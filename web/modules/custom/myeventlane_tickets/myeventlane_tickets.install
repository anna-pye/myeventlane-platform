<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * @file
 * Install, update and uninstall functions for the myeventlane_tickets module.
 */

use Drupal\myeventlane_tickets\Entity\Ticket;
use Drupal\Core\Entity\Sql\SqlContentEntityStorage;

/**
 * Implements hook_install().
 */
function myeventlane_tickets_install(): void {
  // Entity schema is created automatically by Drupal based on the Ticket
  // content entity definition. This hook ensures the entity type is properly
  // registered and tables are created.
  \Drupal::logger('myeventlane_tickets')->notice('MyEventLane Tickets module installed. Entity schema created automatically.');
}

/**
 * Ensures the myeventlane_ticket entity tables are created.
 */
function myeventlane_tickets_update_8001(): string {
  $entity_type_manager = \Drupal::entityTypeManager();

  // Get the entity type definition.
  $entity_type = $entity_type_manager->getDefinition('myeventlane_ticket');
  if (!$entity_type) {
    return 'Ticket entity type not found.';
  }

  // Get the storage handler.
  $storage = $entity_type_manager->getStorage('myeventlane_ticket');

  // Check if tables exist by trying to query them.
  $database = \Drupal::database();
  $table_name = $entity_type->getBaseTable();
  $data_table_name = $entity_type->getDataTable();

  $tables_exist = TRUE;
  try {
    $database->query("SELECT 1 FROM {{$table_name}} LIMIT 1")->fetchField();
    if ($data_table_name) {
      $database->query("SELECT 1 FROM {{$data_table_name}} LIMIT 1")->fetchField();
    }
  }
  catch (\Exception $e) {
    $tables_exist = FALSE;
  }

  if (!$tables_exist && $storage instanceof SqlContentEntityStorage) {
    // Force table creation by getting the schema.
    $schema_handler = $storage->getTableMapping();
    // Accessing the storage will trigger table creation on first use.
    // Create a dummy entity to force table creation.
    try {
      $test_entity = $storage->create([]);
      // Don't save it, just creating it should trigger schema creation.
    }
    catch (\Exception $e) {
      // If creation fails, try to manually create tables using the schema.
      $schema = $storage->getSchema();
      $schema->onEntityTypeCreate($entity_type);
    }
  }

  return 'Ticket entity tables created.';
}

/**
 * Properly installs the myeventlane_ticket entity type and tables.
 */
function myeventlane_tickets_update_8002(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  // Get the entity type definition.
  $entity_type = $entity_type_manager->getDefinition('myeventlane_ticket', FALSE);
  if (!$entity_type) {
    return 'Ticket entity type not found.';
  }

  // Check if tables exist.
  $database = \Drupal::database();
  $table_name = $entity_type->getBaseTable();

  try {
    $database->query("SELECT 1 FROM {{$table_name}} LIMIT 1")->fetchField();
    return 'Ticket entity tables already exist.';
  }
  catch (\Exception $e) {
    // Tables don't exist, install the entity type.
    try {
      $update_manager->installEntityType($entity_type);
      return 'Ticket entity type and tables installed.';
    }
    catch (\Exception $install_exception) {
      // If installEntityType fails, try installing field storage definitions.
      $field_definitions = Ticket::baseFieldDefinitions($entity_type);
      foreach ($field_definitions as $field_name => $field_definition) {
        try {
          $update_manager->installFieldStorageDefinition($field_name, 'myeventlane_ticket', 'myeventlane_tickets', $field_definition);
        }
        catch (\Exception $field_exception) {
          // Field might already exist, skip.
        }
      }
      return 'Ticket entity field storage definitions installed.';
    }
  }
}

/**
 * Implements hook_schema_alter().
 */
function myeventlane_tickets_schema_alter(array &$schema): void {
  // Ensure ticket_code is unique and indexed.
  if (isset($schema['myeventlane_ticket'])) {
    $schema['myeventlane_ticket']['unique keys']['myeventlane_ticket__ticket_code'] = ['ticket_code'];
    $schema['myeventlane_ticket']['indexes']['myeventlane_ticket__event'] = ['event_id'];
    $schema['myeventlane_ticket']['indexes']['myeventlane_ticket__order'] = ['order_id'];
    $schema['myeventlane_ticket']['indexes']['myeventlane_ticket__order_item'] = ['order_item_id'];
    $schema['myeventlane_ticket']['indexes']['myeventlane_ticket__holder_email'] = ['holder_email'];
  }
}

/**
 * Install new ticketing content entity types added after initial install.
 */
function myeventlane_tickets_update_8003(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $update_manager = \Drupal::entityDefinitionUpdateManager();

  $change_list = $update_manager->getChangeList();
  $entity_type_ids = [
    'mel_purchase_surface',
    'mel_event_ticket_settings',
    'mel_ticket_group',
    'mel_access_code',
  ];

  $installed = [];
  foreach ($entity_type_ids as $entity_type_id) {
    if (empty($change_list[$entity_type_id]['entity_type'])) {
      continue;
    }

    $definition = $entity_type_manager->getDefinition($entity_type_id, FALSE);
    if (!$definition) {
      \Drupal::logger('myeventlane_tickets')->error('Could not load entity type definition for @entity_type_id during update 8003.', [
        '@entity_type_id' => $entity_type_id,
      ]);
      throw new \RuntimeException(sprintf('Entity type definition not found: %s', $entity_type_id));
    }

    try {
      $update_manager->installEntityType($definition);
      $installed[] = $entity_type_id;
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_tickets')->error('Failed to install entity type @entity_type_id during update 8003: @message', [
        '@entity_type_id' => $entity_type_id,
        '@message' => $e->getMessage(),
      ]);
      throw $e;
    }
  }

  if (empty($installed)) {
    return 'No new ticketing entity types required installation.';
  }

  return 'Installed ticketing entity types: ' . implode(', ', $installed) . '.';
}

/**
 * Adds checked_in_by field storage to myeventlane_ticket if missing.
 */
function myeventlane_tickets_update_8004(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('myeventlane_ticket');

  if ($update_manager->getFieldStorageDefinition('checked_in_by', 'myeventlane_ticket')) {
    return 'checked_in_by field storage already exists.';
  }

  $definitions = Ticket::baseFieldDefinitions($entity_type);
  if (empty($definitions['checked_in_by'])) {
    throw new \RuntimeException('Could not load checked_in_by field definition for myeventlane_ticket.');
  }

  $update_manager->installFieldStorageDefinition(
    'checked_in_by',
    'myeventlane_ticket',
    'myeventlane_tickets',
    $definitions['checked_in_by']
  );

  return 'Installed checked_in_by field storage on myeventlane_ticket.';
}

/**
 * Creates table for ticket check-in attempt logs.
 */
function myeventlane_tickets_update_8005(): string {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('myeventlane_ticket_checkin_log')) {
    return 'Ticket check-in log table already exists.';
  }

  $table = [
    'description' => 'Ticket check-in attempts and outcomes for analytics and reconciliation.',
    'fields' => [
      'id' => [
        'description' => 'Primary ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'event_nid' => [
        'description' => 'Event node id from route context.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'ticket_id' => [
        'description' => 'Ticket entity id when resolved.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'ticket_code_hash' => [
        'description' => 'SHA-256 hash of ticket code (never raw code).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'payload_hash' => [
        'description' => 'SHA-256 hash of incoming payload string.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'ticket_label_masked' => [
        'description' => 'Masked ticket code for support diagnostics.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'scanned_at' => [
        'description' => 'Unix timestamp when attempt was processed by server.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'scanned_by_uid' => [
        'description' => 'User who submitted scan (nullable).',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'device_id' => [
        'description' => 'Client-side scanner device identifier.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'mode' => [
        'description' => 'Submission mode: online or offline.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'online',
      ],
      'result' => [
        'description' => 'Check-in outcome token.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'message' => [
        'description' => 'Safe short message for support and dashboard.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'synced' => [
        'description' => '1 when server has processed queued record.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 1,
      ],
      'ip' => [
        'description' => 'Requester IP address (nullable).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'event_scanned_at' => ['event_nid', 'scanned_at'],
      'event_result' => ['event_nid', 'result'],
      'ticket_id' => ['ticket_id'],
      'device_id' => ['device_id'],
    ],
  ];

  $schema->createTable('myeventlane_ticket_checkin_log', $table);
  return 'Created table myeventlane_ticket_checkin_log.';
}

/**
 * Adds allowed_ticket_types to mel_access_code for tier-scoped unlock.
 */
function myeventlane_tickets_update_8006(): string {
  if (!\Drupal::entityTypeManager()->hasDefinition('mel_access_code')) {
    return 'mel_access_code not defined.';
  }
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('mel_access_code');
  $fields = \Drupal\myeventlane_tickets\Entity\AccessCode::baseFieldDefinitions($entity_type);
  if (!isset($fields['allowed_ticket_types'])) {
    return 'allowed_ticket_types field definition missing.';
  }
  try {
    $update_manager->installFieldStorageDefinition(
      'allowed_ticket_types',
      'mel_access_code',
      'myeventlane_tickets',
      $fields['allowed_ticket_types']
    );
    return 'Installed mel_access_code.allowed_ticket_types.';
  }
  catch (\Throwable $e) {
    return 'allowed_ticket_types may already exist: ' . $e->getMessage();
  }
}

/**
 * Adds universal entitlement fields to existing myeventlane_ticket rows.
 */
function myeventlane_tickets_update_8007(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('myeventlane_ticket', FALSE);
  if (!$entity_type) {
    return 'myeventlane_ticket entity type not found; rebuild caches and re-run updates.';
  }

  $definitions = Ticket::baseFieldDefinitions($entity_type);
  $field_names = [
    'entitlement_type',
    'redemption_limit',
    'redemption_count',
    'fulfilment_status',
    'collect_window',
    'collect_location',
    'vehicle_registration',
    'vendor_reference',
    'expires_at',
    'metadata_json',
  ];

  $installed = [];
  $already_installed = [];
  foreach ($field_names as $field_name) {
    if ($update_manager->getFieldStorageDefinition($field_name, 'myeventlane_ticket')) {
      $already_installed[] = $field_name;
      continue;
    }
    if (!isset($definitions[$field_name])) {
      \Drupal::logger('myeventlane_tickets')->error('Universal entitlement field @field is missing from Ticket::baseFieldDefinitions().', [
        '@field' => $field_name,
      ]);
      continue;
    }

    try {
      $update_manager->installFieldStorageDefinition(
        $field_name,
        'myeventlane_ticket',
        'myeventlane_tickets',
        $definitions[$field_name],
      );
      $installed[] = $field_name;
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_tickets')->error('Failed to install myeventlane_ticket.@field: @message', [
        '@field' => $field_name,
        '@message' => $e->getMessage(),
      ]);
      throw $e;
    }
  }

  if ($installed === []) {
    return 'Universal entitlement ticket fields already installed: ' . implode(', ', $already_installed);
  }

  return 'Installed universal entitlement ticket fields: ' . implode(', ', $installed);
}

/**
 * Installs append-only redemption log entity storage.
 */
function myeventlane_tickets_update_8008(): string {
  $entity_type_manager = \Drupal::entityTypeManager();
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager->clearCachedDefinitions();

  $definition = $entity_type_manager->getDefinition('mel_redemption_log', FALSE);
  if (!$definition) {
    return 'mel_redemption_log entity type not found; rebuild caches and re-run updates.';
  }

  $base_table = $definition->getBaseTable();
  if ($base_table && \Drupal::database()->schema()->tableExists($base_table)) {
    return 'mel_redemption_log storage already exists.';
  }

  try {
    $update_manager->installEntityType($definition);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_tickets')->error('Failed to install mel_redemption_log entity type: @message', [
      '@message' => $e->getMessage(),
    ]);
    throw $e;
  }

  return 'Installed mel_redemption_log entity type.';
}

/**
 * Removes QR signing secret from exportable ticket settings configuration.
 */
function myeventlane_tickets_update_8009(): string {
  $config = \Drupal::configFactory()->getEditable('myeventlane_tickets.settings');
  if (!array_key_exists('qr_secret', $config->getRawData())) {
    return 'QR signing secret already absent from myeventlane_tickets.settings.';
  }

  $config->clear('qr_secret')->save();
  return 'Removed qr_secret from myeventlane_tickets.settings; configure MEL_QR_SECRET or $settings[\'myeventlane_qr_secret\'] instead.';
}

/**
 * Ensures empty qr_secret keys are removed after update 8009 edge case.
 */
function myeventlane_tickets_update_8010(): string {
  $config = \Drupal::configFactory()->getEditable('myeventlane_tickets.settings');
  if (!array_key_exists('qr_secret', $config->getRawData())) {
    return 'QR signing secret key already absent from myeventlane_tickets.settings.';
  }

  $config->clear('qr_secret')->save();
  return 'Removed lingering qr_secret key from myeventlane_tickets.settings.';
}
