    'myeventlane_donation_platform' => [
      'variables' => [
        'form' => NULL,
      ],
      'template' => 'myeventlane-donation-platform',
    ],
    'myeventlane_donation_report' => [
      'variables' => [
        'platform_stats' => [],
        'rsvp_stats' => [],
        'total_platform' => 0,
        'total_rsvp' => 0,
        'count_platform' => 0,
        'count_rsvp' => 0,
        'export_url' => '',
        'unattributed_url' => '',
        'mel_billing_url' => '',
        'vendor_pct_pledge_rows' => [],
      ],
      'template' => 'myeventlane-donation-report',
    ],
    'myeventlane_donation_vendor_list' => [
      'variables' => [
        'events' => [],
        'total_donations' => 0,
        'total_count' => 0,
        'average_donation' => 0,
      ],
      'template' => 'myeventlane-donation-vendor-list',
    ],
    'myeventlane_mel_vendor_billing' => [
      'variables' => [
        'summary' => [],
        'invoices' => [],
        'billing_prefs' => [],
        'save_payment_url' => '',
        'remove_payment_url' => '',
      ],
      'template' => 'myeventlane-mel-vendor-billing',
    ],
    'myeventlane_mel_save_payment_method' => [
      'variables' => [
        'client_secret' => '',
        'publishable_key' => '',
        'return_url' => '',
        'billing_url' => '',
      ],
      'template' => 'myeventlane-mel-save-payment-method',
    ],
    'myeventlane_mel_vendor_invoice' => [
      'variables' => [
        'invoice' => [],
        'lines' => [],
        'pay_url' => NULL,
      ],
      'template' => 'myeventlane-mel-vendor-invoice',
    ],
    'myeventlane_mel_billing_admin' => [
      'variables' => [
        'overview' => [],
        'generate_form' => NULL,
        'donation_report_url' => '',
      ],
      'template' => 'myeventlane-mel-billing-admin',
    ],
    'myeventlane_mel_vendor_billing_dashboard_strip' => [
      'variables' => [
        'summary' => [],
        'billing_url' => '',
      ],
      'template' => 'myeventlane-mel-vendor-billing-dashboard-strip',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_dashboard.
 */
function myeventlane_donations_preprocess_myeventlane_vendor_dashboard(&$variables): void {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_donations')) {
    return;
  }
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route !== 'myeventlane_vendor.console.dashboard') {
    return;
  }
  $uid = (int) \Drupal::currentUser()->id();
  if ($uid <= 0) {
    return;
  }
  try {
    /** @var \Drupal\myeventlane_donations\Service\VendorContributionInvoiceService $svc */
    $svc = \Drupal::service('myeventlane_donations.vendor_contribution_invoice');
  }
  catch (\Throwable) {
    return;
  }
  $vendorId = $svc->resolveVendorIdForUser($uid);
  if ($vendorId === NULL) {
    return;
  }
  $summary = $svc->getVendorDashboardSummary($vendorId);
  try {
    $billing_url = Url::fromRoute('myeventlane_donations.vendor_mel_billing')->toString();
  }
  catch (\Throwable) {
    $billing_url = '';
  }
  if ($billing_url === '') {
    return;
  }
  $variables['mel_contribution_billing_strip'] = [
    '#theme' => 'myeventlane_mel_vendor_billing_dashboard_strip',
    '#summary' => $summary,
    '#billing_url' => $billing_url,
    '#attached' => [
      'library' => ['myeventlane_donations/mel-vendor-billing'],
    ],
  ];
}

/**
 * Implements hook_entity_access().
 *
 * Allows anonymous users to access their own draft orders (carts) during checkout.
 * This is necessary for RSVP donations where anonymous users need to complete checkout.
 */
function myeventlane_donations_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  // Only process commerce_order entities.
  if ($entity->getEntityTypeId() !== 'commerce_order') {
    return AccessResult::neutral();
  }

  // Only allow 'view' and 'update' operations for draft orders.
  if (!in_array($operation, ['view', 'update'], TRUE)) {
    return AccessResult::neutral();
  }

  /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
  $order = $entity;

  // Allow access if:
  // 1. Order is in draft state (cart)
  // 2. User is anonymous (UID 0) and order belongs to anonymous (UID 0)
  // 3. OR user owns the order.
  if ($order->getState()->getId() === 'draft') {
    $orderUid = (int) $order->getCustomerId();
    $accountUid = (int) $account->id();

    // Anonymous users can access anonymous draft orders.
    if ($accountUid === 0 && $orderUid === 0) {
      return AccessResult::allowed()
        ->cachePerUser()
        ->addCacheableDependency($order);
    }

    // Authenticated users can access their own draft orders.
    if ($accountUid > 0 && $orderUid === $accountUid) {
      return AccessResult::allowed()
        ->cachePerUser()
        ->addCacheableDependency($order);
    }
  }

  // For non-draft orders, let Commerce handle access normally.
  return AccessResult::neutral();
}

/**
 * Implements hook_myeventlane_refund_completed().
 *
 * Re-syncs MEL percentage pledge accruals after ticket refunds complete.
 */
function myeventlane_donations_myeventlane_refund_completed(OrderInterface $order, NodeInterface $event, array $log): void {
  if (($log['status'] ?? '') !== 'completed') {
    return;
  }
  $orderId = (int) ($log['order_id'] ?? 0);
  $eventId = (int) ($log['event_id'] ?? 0);
  if ($orderId < 1 || $eventId < 1) {
    return;
  }
  \Drupal::service('myeventlane_donations.vendor_mel_pct_contribution')->recalculateForOrderAndEvent($orderId, $eventId);
}

/**
 * Implements hook_form_alter().
 *
 * Redirects rsvp_donation orders to the RSVP thank-you page after checkout
 * completion, so the confirmation and email flow run correctly.
 */
function myeventlane_donations_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (!isset($form['#id']) || !str_contains((string) $form['#id'], 'commerce-checkout')) {
    return;
  }

  $form['#submit'][] = 'myeventlane_donations_rsvp_donation_checkout_redirect';
}

/**
 * Submit handler: redirect rsvp_donation orders to thank-you after completion.
 */
function myeventlane_donations_rsvp_donation_checkout_redirect(array &$form, FormStateInterface $form_state): void {
  $redirect = $form_state->getRedirect();
  if (!$redirect instanceof \Drupal\Core\Url) {
    return;
  }

  if ($redirect->getRouteName() !== 'commerce_checkout.form') {
    return;
  }

  $route_params = $redirect->getRouteParameters();
  $step = $route_params['step'] ?? NULL;
  if ($step !== 'complete') {
    return;
  }

  $order_id = (int) ($route_params['commerce_order'] ?? 0);
  if ($order_id <= 0) {
    return;
  }

  $order = \Drupal::entityTypeManager()->getStorage('commerce_order')->load($order_id);
  if (!$order || $order->bundle() !== 'rsvp_donation') {
    return;
  }

  if ($order->getState()->getId() === 'draft') {
    return;
  }

  $event_id = NULL;
  foreach ($order->getItems() as $item) {
    if ($item->bundle() !== 'rsvp_donation') {
      continue;
    }
    if ($item->hasField('field_target_event') && !$item->get('field_target_event')->isEmpty()) {
      $event_id = (int) $item->get('field_target_event')->target_id;
      break;
    }
    if ($item->hasField('field_attendee_data') && !$item->get('field_attendee_data')->isEmpty()) {
      $data = json_decode((string) $item->get('field_attendee_data')->value, TRUE);
      if (!empty($data['event_id'])) {
        $event_id = (int) $data['event_id'];
        break;
      }
    }
  }

  if ($event_id && \Drupal::moduleHandler()->moduleExists('myeventlane_rsvp')) {
    $form_state->setRedirect('myeventlane_rsvp.thankyou', [
      'event' => $event_id,
    ], [
      'query' => ['order' => $order_id],
    ]);
  }
}
