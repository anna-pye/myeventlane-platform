      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'invoice_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'commerce_order_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'amount_cents' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'currency_code' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'aud',
