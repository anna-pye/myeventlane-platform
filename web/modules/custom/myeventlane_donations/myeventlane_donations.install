        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'order_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Commerce order ID (ticket order).',
      ],
      'event_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Event node ID.',
      ],
      'vendor_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Vendor entity ID at accrual time.',
      ],
      'pct_rate' => [
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 4,
        'not null' => TRUE,
        'description' => 'Pledge percent (e.g. 5.0000 for 5%).',
      ],
      'gross_base_cents' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Ticket subtotal cents for this event on the order before refund attribution.',
      ],
      'net_ticket_cents' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Net ticket cents after ticket refund attribution.',
      ],
      'amount_cents' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Accrued contribution in minor units.',
      ],
      'currency_code' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'aud',
        'description' => 'ISO 4217 currency (lowercase).',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'accrued',
        'description' => 'accrued or void.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Created timestamp.',
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Last change timestamp.',
      ],
      'invoice_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Vendor MEL contribution invoice (NULL until billed).',
      ],
      'billing_status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'unbilled',
