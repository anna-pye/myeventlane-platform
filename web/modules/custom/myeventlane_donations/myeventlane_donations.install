/**
 * Creates Commerce order types and order item types for donations.
 */
function myeventlane_donations_install(): void {
  // Create platform donation order type.
  if (!OrderType::load('platform_donation')) {
    $orderType = OrderType::create([
      'id' => 'platform_donation',
      'label' => 'Platform Donation',
      'workflow' => 'order_default',
      'numberPattern' => 'order_default',
      'refresh_mode' => 'customer',
      'refresh_frequency' => 0,
      'sendReceipt' => TRUE,
      'receiptBcc' => '',
      'receiptSubject' => 'Thank you for your donation to MyEventLane',
    ]);
    $orderType->save();
  }

  // Create platform donation order item type.
  if (!OrderItemType::load('platform_donation')) {
    $orderItemType = OrderItemType::create([
      'id' => 'platform_donation',
      'label' => 'Platform Donation',
      'purchasableEntityType' => NULL,
      'orderType' => 'platform_donation',
    ]);
    $orderItemType->save();
  }

  // Create RSVP donation order type.
  if (!OrderType::load('rsvp_donation')) {
    $orderType = OrderType::create([
      'id' => 'rsvp_donation',
      'label' => 'RSVP Donation',
      'workflow' => 'order_default',
      'numberPattern' => 'order_default',
      'refresh_mode' => 'customer',
      'refresh_frequency' => 0,
      'sendReceipt' => TRUE,
      'receiptBcc' => '',
      'receiptSubject' => 'Thank you for your donation',
    ]);
    $orderType->save();
  }

  // Create RSVP donation order item type.
  if (!OrderItemType::load('rsvp_donation')) {
    $orderItemType = OrderItemType::create([
      'id' => 'rsvp_donation',
      'label' => 'RSVP Donation',
      'purchasableEntityType' => NULL,
      'orderType' => 'rsvp_donation',
    ]);
    $orderItemType->save();
  }
}

/**
 * Removes Commerce order types and order item types.
 */
function myeventlane_donations_uninstall(): void {
  // Delete order item types first (they reference order types).
  $orderItemTypes = ['platform_donation', 'rsvp_donation'];
  foreach ($orderItemTypes as $id) {
    $orderItemType = OrderItemType::load($id);
    if ($orderItemType) {
      $orderItemType->delete();
    }
  }

  // Delete order types.
  $orderTypes = ['platform_donation', 'rsvp_donation'];
  foreach ($orderTypes as $id) {
    $orderType = OrderType::load($id);
    if ($orderType) {
      $orderType->delete();
    }
  }
}


/**
 * Ensures field_target_event is attached to rsvp_donation order item type.
 *
 * The field config lives in myeventlane_schema config/install but only runs
 * on fresh install. This hook ensures existing sites get the field.
 */
function myeventlane_donations_update_9001(array &$sandbox): void {
  if (isset($sandbox['_field_attached'])) {
    myeventlane_donations_update_9001_verification($sandbox);
    return;
  }

  $field_config_storage = \Drupal::entityTypeManager()->getStorage('field_config');
  $existing = $field_config_storage->load('commerce_order_item.rsvp_donation.field_target_event');

  if ($existing) {
    $sandbox['_field_attached'] = TRUE;
    myeventlane_donations_update_9001_verification($sandbox);
    return;
  }

  // Ensure field storage exists using the FieldStorageConfig entity API.
  /** @var \Drupal\field\FieldStorageConfigStorage $field_storage_storage */
  $field_storage_storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  /** @var \Drupal\field\Entity\FieldStorageConfig|null $field_storage */
  $field_storage = $field_storage_storage->load('commerce_order_item.field_target_event');

  if (!$field_storage) {
    // Create an entity_reference field storage for commerce_order_item -> node (event).
    // Do NOT write raw YAML into active config.
    $field_storage = \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_target_event',
      'entity_type' => 'commerce_order_item',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => [
        'target_type' => 'node',
      ],
      'translatable' => FALSE,
      'locked' => FALSE,
      'persist_with_no_fields' => FALSE,
      // Keep ownership consistent with the canonical schema module if present.
      // This avoids config drift between fresh installs (optional config) and updates.
      'module' => \Drupal::moduleHandler()->moduleExists('myeventlane_schema') ? 'myeventlane_schema' : 'myeventlane_donations',
    ]);
    $field_storage->save();
  }

  // Attach field to rsvp_donation bundle via entity API.
  // Ensure handler targets the event bundle.
  \Drupal\field\Entity\FieldConfig::create([
    'field_name' => 'field_target_event',
    'entity_type' => 'commerce_order_item',
    'bundle' => 'rsvp_donation',
    'label' => 'Target event',
    'required' => FALSE,
    'settings' => [
      'handler' => 'default:node',
      'handler_settings' => [
        'target_bundles' => [
          'event' => 'event',
        ],
      ],
    ],
  ])->save();

  drupal_flush_all_caches();

  $sandbox['_field_attached'] = TRUE;
  myeventlane_donations_update_9001_verification($sandbox);
}

/**
 * Verification pass: log counts of rsvp_donation items by attribution status.
 *
 * Does NOT backfill or guess event attribution for historic items.
 */
function myeventlane_donations_update_9001_verification(array &$sandbox): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $logger = \Drupal::logger('myeventlane_donations');
  $storage = $entity_type_manager->getStorage('commerce_order_item');

  if (!isset($sandbox['ids'])) {
    $sandbox['ids'] = array_values($storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'rsvp_donation')
      ->execute());
    $sandbox['total'] = count($sandbox['ids']);
    $sandbox['processed'] = 0;
    $sandbox['with_event'] = 0;
    $sandbox['missing_event'] = 0;
    $sandbox['no_field'] = 0;
  }

  if ($sandbox['total'] === 0) {
    $logger->info('RSVP donation verification: 0 rsvp_donation order items found.');
    $sandbox['#finished'] = 1;
    return;
  }

  $batch_size = 50;
  $slice = array_slice($sandbox['ids'], $sandbox['processed'], $batch_size);

  if (!$slice) {
    $logger->info('RSVP donation verification: total=@total, with field_target_event=@with, missing=@missing, field not attached=@no_field', [
      '@total' => $sandbox['total'],
      '@with' => $sandbox['with_event'],
      '@missing' => $sandbox['missing_event'],
      '@no_field' => $sandbox['no_field'],
    ]);
    $sandbox['#finished'] = 1;
    return;
  }

  /** @var \Drupal\commerce_order\Entity\OrderItemInterface[] $items */
  $items = $storage->loadMultiple($slice);

  foreach ($items as $item) {
    if (!$item->hasField('field_target_event')) {
      $sandbox['no_field']++;
      if ($sandbox['no_field'] === 1) {
        $logger->warning('RSVP donation order item @id has no field_target_event attached. Run config import (drush cim) then updb.', [
          '@id' => $item->id(),
        ]);
      }
      continue;
    }

    if ($item->get('field_target_event')->isEmpty()) {
      $sandbox['missing_event']++;
    }
    else {
      $sandbox['with_event']++;
    }
  }

  $sandbox['processed'] += count($slice);
  $sandbox['#finished'] = min(1, $sandbox['processed'] / max(1, $sandbox['total']));

  if ($sandbox['#finished'] >= 1) {
    $logger->info('RSVP donation verification: total=@total, with field_target_event=@with, missing=@missing, field not attached=@no_field', [
      '@total' => $sandbox['total'],
      '@with' => $sandbox['with_event'],
      '@missing' => $sandbox['missing_event'],
      '@no_field' => $sandbox['no_field'],
    ]);
  }
}

/**
 * Ensure RSVP donation checkout works: assign checkout flow and access permission.
 *
 * - Assigns mel_event_checkout to rsvp_donation order type so donation checkout
 *   uses the same flow as ticket purchases.
 * - Ensures anonymous users have 'access checkout' so they can complete RSVP
 *   donations. Commerce grants this on install, but config sync may have
 *   overridden it.
 */
function myeventlane_donations_update_9002(): void {
  // Assign mel_event_checkout to rsvp_donation order type.
  $order_type = OrderType::load('rsvp_donation');
  if ($order_type) {
    $flow_id = 'default';
    if (\Drupal::entityTypeManager()->getStorage('commerce_checkout_flow')->load('mel_event_checkout')) {
      $flow_id = 'mel_event_checkout';
    }
    $order_type->setThirdPartySetting('commerce_checkout', 'checkout_flow', $flow_id);
    $order_type->save();
  }

  // Ensure anonymous can access checkout (required for RSVP donation flow).
  user_role_grant_permissions(AccountInterface::ANONYMOUS_ROLE, ['access checkout']);

  drupal_flush_all_caches();
}

/**
 * Creates mel_vendor_pct_contribution table for percentage pledge accruals.
 */
function myeventlane_donations_update_9003(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('mel_vendor_pct_contribution')) {
    $table = myeventlane_donations_schema()['mel_vendor_pct_contribution'];
    $schema->createTable('mel_vendor_pct_contribution', $table);
  }
}

/**
 * Phase 3: vendor MEL % invoices, billing columns on accrual rows, payment log.
 */
function myeventlane_donations_update_9004(): void {
  $schema = \Drupal::database()->schema();
  $full = myeventlane_donations_schema();

  if ($schema->tableExists('mel_vendor_pct_contribution')) {
    if (!$schema->fieldExists('mel_vendor_pct_contribution', 'invoice_id')) {
      $schema->addField('mel_vendor_pct_contribution', 'invoice_id', [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Vendor MEL contribution invoice (NULL until billed).',
      ]);
    }
    if (!$schema->fieldExists('mel_vendor_pct_contribution', 'billing_status')) {
      $schema->addField('mel_vendor_pct_contribution', 'billing_status', [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'unbilled',
        'description' => 'unbilled, billed, or paid.',
      ]);
    }
    $pct_spec = $full['mel_vendor_pct_contribution'];
    if (!$schema->indexExists('mel_vendor_pct_contribution', 'invoice_id')) {
      $schema->addIndex('mel_vendor_pct_contribution', 'invoice_id', ['invoice_id'], $pct_spec);
    }
    if (!$schema->indexExists('mel_vendor_pct_contribution', 'vendor_billing')) {
      $schema->addIndex('mel_vendor_pct_contribution', 'vendor_billing', ['vendor_id', 'billing_status'], $pct_spec);
    }
  }

  if (!$schema->tableExists('mel_vendor_invoice')) {
    $schema->createTable('mel_vendor_invoice', $full['mel_vendor_invoice']);
  }
  if (!$schema->tableExists('mel_vendor_invoice_payment')) {
    $schema->createTable('mel_vendor_invoice_payment', $full['mel_vendor_invoice_payment']);
  }
}