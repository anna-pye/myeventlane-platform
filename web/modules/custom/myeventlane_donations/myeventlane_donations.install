    'unique keys' => [
      'order_event' => ['order_id', 'event_id'],
    ],
    'indexes' => [
      'event_id' => ['event_id'],
      'vendor_id' => ['vendor_id'],
      'invoice_id' => ['invoice_id'],
      'vendor_billing' => ['vendor_id', 'billing_status'],
    ],
  ];

  $schema['mel_vendor_invoice'] = [
    'description' => 'Vendor MEL percentage contribution invoices (accrual settlement).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'vendor_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'total_amount_cents' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'currency_code' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'aud',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'issued',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
      'due_date' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'paid_amount_cents' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Sum of successful platform_donation payments.',
      ],
      'period_start' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'period_end' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
