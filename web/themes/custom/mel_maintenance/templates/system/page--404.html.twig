{#
/**
 * @file
 * Branded 404 page for MyEventLane (mel_maintenance theme).
 *
 * Self-contained layout (no regions). Suggestion: page__404.
 * This file is used only when mel_maintenance is the active theme; the default
 * site theme ships the same markup under templates/page--404.html.twig.
 * Document shell and asset placeholders: @see html.html.twig
 *
 * @ingroup themeable
 */
#}
{{ attach_library('mel_maintenance/errors') }}
{% set mel_brand = 'MyEventLane'|t %}

<div class="mel-err mel-err--404" data-mel-error-page>
  <div class="mel-err__bg" aria-hidden="true">
    <span class="mel-err__orb mel-err__orb--1"></span>
    <span class="mel-err__orb mel-err__orb--2"></span>
    <span class="mel-err__orb mel-err__orb--3"></span>
  </div>

  <a href="#mel-err-main" class="mel-err__skip-link">
    {{ 'Skip to error message'|t }}
  </a>

  <header class="mel-err__header" role="banner">
    <div class="mel-err__brand mel-err__panel">
      <img class="mel-err__logo-img" src="{{ base_path }}{{ directory }}/logo.svg" width="56" height="56" alt="{{ mel_brand }}"/>
      <div class="mel-err__brand-text">
        <p class="mel-err__brand-name">{{ mel_brand }}</p>
      </div>
    </div>
  </header>

  <main id="mel-err-main" class="mel-err__main" role="main" tabindex="-1">
    <div class="mel-err__hero">
      <div class="mel-err__badge" aria-hidden="true">404</div>

      <div class="mel-err__mascot-wrap">
        <div class="mel-err__mascot" role="img" aria-label="{{ 'MyEventLane mascot looking curious'|t }}">
          <div class="mel-err__mascot-glow" aria-hidden="true"></div>
          <div class="mel-err__mascot-body" aria-hidden="true">
            <div class="mel-err__mascot-lanyard"></div>
            <div class="mel-err__mascot-head">
              <div class="mel-err__mascot-hair"></div>
              <div class="mel-err__mascot-face">
                <span class="mel-err__mascot-eye mel-err__mascot-eye--l"></span>
                <span class="mel-err__mascot-eye mel-err__mascot-eye--r"></span>
                <span class="mel-err__mascot-smile"></span>
              </div>
            </div>
            <div class="mel-err__mascot-torso">
              <span class="mel-err__mascot-badge mel-err__mascot-badge--a"></span>
              <span class="mel-err__mascot-badge mel-err__mascot-badge--b"></span>
            </div>
          </div>
        </div>
      </div>

      <section class="mel-err__intro mel-err__panel" aria-labelledby="mel-err-404-title">
        <h1 id="mel-err-404-title" class="mel-err__title">{{ 'Oops! This event wandered off.'|t }}</h1>
        <p class="mel-err__lede">
          {{ 'The page you're looking for may have been moved, removed, or never existed.'|t }}
        </p>
        <ul class="mel-err__actions">
          <li>
            <a class="mel-err__btn mel-err__btn--primary" href="{{ front_page }}">{{ 'Back to homepage'|t }}</a>
          </li>
          <li>
            <a class="mel-err__btn mel-err__btn--secondary" href="{{ path('view.upcoming_events.page_events') }}">{{ 'Browse events'|t }}</a>
          </li>
        </ul>
      </section>
    </div>
  </main>

  <footer class="mel-err__footer" role="contentinfo">
    <div class="mel-err__footer-inner mel-err__panel">
      <p class="mel-err__footer-line">
        <strong>{{ mel_brand }}</strong>
        — {{ 'Premium events, calm checkout, organiser-first tools.'|t }}
      </p>
      <p class="mel-err__footer-copy">© {{ "now"|date("Y") }} {{ mel_brand }}. {{ 'All rights reserved.'|t }}</p>
    </div>
  </footer>
</div>
