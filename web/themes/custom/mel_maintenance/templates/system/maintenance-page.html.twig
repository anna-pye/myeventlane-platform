{#
/**
 * @file
 * Dependency-light maintenance page for MyEventLane.
 */
#}
{{ attach_library('mel_maintenance/maintenance') }}
{% set mel_brand = site_name ?: 'MyEventLane' %}
{% set maintenance_title = title ?: 'MyEventLane is briefly unavailable'|t %}

<div class="mel-mm" data-mel-maintenance>
  <a href="#mel-maintenance-message" class="mel-mm__skip-link">{{ 'Skip to maintenance message'|t }}</a>
  <main class="mel-mm__main">
    <header class="mel-mm__brand">
      {# Release-owned logo avoids stale managed-file references in maintenance. #}
      <img class="mel-mm__logo" src="{{ base_path }}{{ directory }}/logo.svg" width="176" height="48" alt="{{ mel_brand }}">
      {% if site_slogan %}
        <p class="mel-mm__tagline">{{ site_slogan }}</p>
      {% endif %}
    </header>

    <section id="mel-maintenance-message" class="mel-mm__panel" tabindex="-1">
      <p class="mel-mm__eyebrow">{{ 'A short pause'|t }}</p>
      <h1 class="mel-mm__title">{{ maintenance_title }}</h1>
      <p class="mel-mm__lede">
        {{ 'We are applying an update and expect to be back shortly. Thanks for your patience.'|t }}
      </p>
      <div class="mel-mm__message">
        {{ page.highlighted }}
        {{ page.content }}
      </div>
      <a class="mel-mm__button" href="{{ path('<front>') }}">{{ 'Try again'|t }}</a>
    </section>

    <p class="mel-mm__help">
      {{ 'If you need your ticket now, use the link in your confirmation email.'|t }}
    </p>
  </main>
  <footer class="mel-mm__footer">© {{ "now"|date("Y") }} {{ mel_brand }}</footer>
</div>
