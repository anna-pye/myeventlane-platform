<?php

/**
 * @file
 * Theme hooks for MyEventLane.
 *
 * MEL LANGUAGE STANDARD:
 * - Australian English
 * - "Attendee" not "Customer"
 * - "Organiser" not "Vendor"
 * - Friendly, non-corporate tone
 */

use Drupal\Component\Render\PlainTextOutput;
use Drupal\Component\Utility\Html;
use Drupal\Component\Utility\Unicode;
use Drupal\Core\Render\Element;
use Drupal\Core\Routing\RouteNotFoundException;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\taxonomy\TermInterface;
use Drupal\file\Entity\File;
use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\commerce_price\Price;
use Drupal\commerce_product\Entity\ProductInterface;
use Drupal\commerce_product\Entity\ProductVariationInterface;
use Drupal\mel_ticket\Entity\TicketTypeInterface;
use Drupal\node\NodeInterface;
use Drupal\myeventlane_event\Service\EventCtaResolver;

/**
 * Implements hook_preprocess().
 *
 * Applies MEL language standardisation (Australian English + terminology) to
 * display text in template variables. Skips URLs, paths, and technical keys
 * to avoid breaking links or machine names.
 */
function myeventlane_theme_preprocess(array &$variables, string $hook): void {
  $active_theme = \Drupal::theme()->getActiveTheme()->getName();
  if ($active_theme !== 'myeventlane_theme' && $active_theme !== 'myeventlane_vendor_theme') {
    return;
  }
  if (!\Drupal::hasService('myeventlane_core.language_style')) {
    return;
  }

  // Form templates carry Drupal render arrays and Attribute data; do not run the
  // generic string walker here. Walking those trees has caused
  // InvalidArgumentException for keys like data-drupal-selector (must live under
  // #attributes only). Form strings already go through t().
  if (str_starts_with($hook, 'form')) {
    return;
  }

  /** @var \Drupal\myeventlane_core\Service\LanguageStyleService $service */
  $service = \Drupal::service('myeventlane_core.language_style');
  _myeventlane_theme_apply_language_style($variables, $service);
}

/**
 * Recursively applies language style to display strings; skips URLs and tech keys.
 *
 * Skips render array properties (keys starting with #) to avoid corrupting
 * #cache, #attached, #attributes, etc. e.g. "user.permissions" must not become
 * "member.permissions" in cache contexts.
 */
function _myeventlane_theme_apply_language_style(array &$items, $service): void {
  foreach ($items as $key => &$value) {
    if (is_string($key) && str_starts_with($key, '#')) {
      continue;
    }
    if (is_array($value)) {
      // Do not recurse into Drupal form render arrays (e.g. login, ticket selection).
      // Walking them can corrupt structure; non-# keys like data-drupal-selector must
      // only exist under #attributes, not as render children.
      if (($key === 'element' || $key === 'form') && isset($value['#form_id'])) {
        continue;
      }
      _myeventlane_theme_apply_language_style($value, $service);
    }
    elseif (is_string($value) && !$service->shouldSkipKey($key) && !$service->looksLikeUrl($value)) {
      $value = $service->replace($value);
    }
  }
}

/**
 * Implements hook_theme().
 */
function myeventlane_theme_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'mel_post_login_hub' => [
      'variables' => [
        'hub' => [],
      ],
      'template' => 'mel-post-login-hub',
    ],
    'mel_checkout_order_summary_grouped' => [
      'variables' => [
        'grouped_items' => [],
        'order_total' => '',
      ],
      'template' => 'commerce/mel-checkout-order-summary-grouped',
    ],
    'site_header' => [
      'variables' => [
        'branding' => [],
        'primary_menu' => [],
        'organiser_context' => [],
        'cart' => [],
        'notification_bell' => [],
        'user_menu' => [],
        'mobile_drawer' => [],
        'is_checkout' => FALSE,
        'create_event_url' => '/create-event',
      ],
      'template' => 'components/site-header/site-header',
    ],
    'mobile_drawer' => [
      'variables' => [
        'drawer_menu' => [],
        'drawer_organiser' => [],
        'create_event_url' => '/create-event',
        'mel_cart_url' => '/cart',
        'mel_cart_item_count' => 0,
        'mel_cart_count_text' => '',
        'mel_checkout_url' => '',
      ],
      'template' => 'components/mobile-drawer/mobile-drawer',
    ],
  ];
}

/**
 * Implements hook_preprocess_site_header().
 *
 * Populates site header variables: branding, primary_menu, organiser_context,
 * cart, user_menu, mobile_drawer, is_checkout.
 */
function myeventlane_theme_preprocess_site_header(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['is_checkout'] = strpos((string) $route, 'commerce_checkout') === 0;

  $extension_list = \Drupal::service('extension.list.theme');
  $theme_path = $extension_list->getPath('myeventlane_theme');
  $base_path = base_path();

  // Branding: logo link.
  $logo_path = $base_path . $theme_path . '/images/logo.svg';
  $variables['branding'] = [
    '#type' => 'link',
    '#title' => [
      '#type' => 'html_tag',
      '#tag' => 'img',
      '#attributes' => [
        'src' => $logo_path,
        'alt' => t('Home'),
        'width' => 32,
        'height' => 32,
        'class' => ['site-header__logo'],
      ],
    ],
    '#url' => Url::fromRoute('<front>'),
    '#attributes' => ['class' => ['site-header__brand-link']],
  ];

  // Primary menu.
  $block_manager = \Drupal::service('plugin.manager.block');
  try {
    $main_menu = $block_manager->createInstance('system_menu_block:main', []);
    if ($main_menu->access(\Drupal::currentUser())) {
      $build = $main_menu->build();
      $variables['primary_menu'] = !empty($build) ? $build : [];
    }
    else {
      $variables['primary_menu'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['primary_menu'] = [];
  }

  // Organiser context block.
  // When user has organiser role, organiser links (Dashboard, My events, etc.)
  // are injected into the account dropdown via hook_preprocess_menu__account.
  // We hide organiser_context in the header to avoid duplication.
  try {
    $organiser_block = $block_manager->createInstance('myeventlane_organiser_context', []);
    if ($organiser_block->access(\Drupal::currentUser())) {
      $build = $organiser_block->build();
      if (\Drupal::currentUser()->hasPermission('access vendor dashboard') && !empty($build)) {
        $variables['organiser_context'] = [];
      }
      else {
        $variables['organiser_context'] = !empty($build) ? $build : [];
      }
    }
    else {
      $variables['organiser_context'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['organiser_context'] = [];
  }

  // Cart block.
  try {
    $cart_block = $block_manager->createInstance('commerce_cart', []);
    if ($cart_block->access(\Drupal::currentUser())) {
      $build = $cart_block->build();
      $variables['cart'] = !empty($build) ? $build : [];
    }
    else {
      $variables['cart'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['cart'] = [];
  }

  // Notification bell: built by myeventlane_notifications_preprocess_site_header().

  // User menu.
  try {
    $account_menu = $block_manager->createInstance('system_menu_block:account', []);
    if ($account_menu->access(\Drupal::currentUser())) {
      $build = $account_menu->build();
      $variables['user_menu'] = !empty($build) ? $build : [];
    }
    else {
      $variables['user_menu'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['user_menu'] = [];
  }

  // Create Event CTA URL (gateway handles vendor check / onboarding).
  try {
    $variables['create_event_url'] = Url::fromRoute('myeventlane_vendor.create_event_gateway')->toString();
  }
  catch (\Exception $e) {
    $variables['create_event_url'] = '/create-event';
  }

  // Mobile drawer (only when not checkout).
  if (!$variables['is_checkout']) {
    $variables['mobile_drawer'] = [
      '#theme' => 'mobile_drawer',
      '#drawer_menu' => $variables['primary_menu'],
      '#drawer_organiser' => $variables['organiser_context'],
      '#cache' => [
        'contexts' => ['cart'],
      ],
    ];
  }
  else {
    $variables['mobile_drawer'] = [];
  }
}

/**
 * Implements hook_preprocess_menu__account().
 */
function myeventlane_theme_preprocess_menu__account(array &$variables): void {
}

/**
 * Implements hook_preprocess_menu__main().
 *
 * Transforms the "Vendors" menu item into a dropdown with child links.
 * Shows "Vendor Dashboard" for vendors, "Become a Vendor" for non-vendors.
 */
function myeventlane_theme_preprocess_menu__main(array &$variables): void {
  if (empty($variables['items'])) {
    return;
  }

  $current_user = \Drupal::currentUser();
  $is_vendor = $current_user->hasPermission('access vendor dashboard');

  // Find and transform the Vendors menu item.
  foreach ($variables['items'] as $key => &$item) {
    $title = (string) ($item['title'] ?? '');
      if (strtolower($title) === 'vendors' || strtolower($title) === 'organisers') {
      // Create child items for the dropdown.
      $item['below'] = [
        'browse_organisers' => [
          'title' => t('Browse organisers'),
          'url' => Url::fromRoute('myeventlane_vendor.public_list'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ],
      ];

      // Show "Organiser dashboard" for organisers, "Become an organiser" for non-organisers.
      if ($is_vendor) {
        $item['below']['organiser_dashboard'] = [
          'title' => t('Organiser dashboard'),
          'url' => Url::fromRoute('myeventlane_vendor.console.dashboard'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ];
      }
      else {
        $item['below']['become_organiser'] = [
          'title' => t('Become an organiser'),
          'url' => Url::fromRoute('myeventlane_vendor.onboard'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ];
      }

      // Mark as expanded so the template knows it has children.
      $item['is_expanded'] = TRUE;
      $item['is_collapsed'] = FALSE;

      // Make the parent link just a label (no navigation).
      $item['url'] = Url::fromRoute('<none>');
      break;
    }
  }
}

/**
 * Implements hook_preprocess_mobile_drawer().
 *
 * Ensures drawer_menu and drawer_organiser are render arrays.
 */
function myeventlane_theme_preprocess_mobile_drawer(array &$variables): void {
  $variables['drawer_menu'] = $variables['drawer_menu'] ?? [];
  $variables['drawer_organiser'] = $variables['drawer_organiser'] ?? [];
  try {
    $variables['create_event_url'] = Url::fromRoute('myeventlane_vendor.create_event_gateway')->toString();
  }
  catch (\Throwable) {
    $variables['create_event_url'] = '/create-event';
  }

  $variables['mel_cart_url'] = '/cart';
  $variables['mel_cart_item_count'] = 0;
  $variables['mel_cart_count_text'] = (string) \Drupal::translation()->formatPlural(0, '@count item', '@count items', ['@count' => 0]);
  $variables['mel_checkout_url'] = '';

  try {
    $variables['mel_cart_url'] = Url::fromRoute('commerce_cart.page')->toString();
  }
  catch (\Throwable) {
    // Route missing in non-Commerce environments.
  }

  if (\Drupal::moduleHandler()->moduleExists('commerce_cart')) {
    try {
      $cart_qty = 0;
      foreach (\Drupal::service('commerce_cart.cart_provider')->getCarts() as $cart) {
        foreach ($cart->getItems() as $item) {
          $cart_qty += (int) $item->getQuantity();
        }
      }
      $variables['mel_cart_item_count'] = $cart_qty;
      $variables['mel_cart_count_text'] = (string) \Drupal::translation()->formatPlural(
        $cart_qty,
        '@count item',
        '@count items',
        ['@count' => $cart_qty]
      );
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->error('Mobile drawer cart count failed: @message', ['@message' => $e->getMessage()]);
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('commerce_checkout')) {
    try {
      $checkout_url = Url::fromRoute('commerce_checkout.checkout');
      if ($checkout_url->access(\Drupal::currentUser())) {
        $variables['mel_checkout_url'] = $checkout_url->toString();
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->warning('Mobile drawer checkout URL: @message', ['@message' => $e->getMessage()]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for commerce_cart_block.
 */
function myeventlane_theme_preprocess_commerce_cart_block(array &$variables): void {
  $variables['mel_checkout_url'] = '';
  if (!\Drupal::moduleHandler()->moduleExists('commerce_checkout')) {
    return;
  }
  try {
    $checkout_url = Url::fromRoute('commerce_checkout.checkout');
    if ($checkout_url->access(\Drupal::currentUser())) {
      $variables['mel_checkout_url'] = $checkout_url->toString();
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->warning('Cart block checkout URL: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Implements hook_preprocess_HOOK() for commerce_checkout_pane.
 *
 * Adds a single shell class for governed checkout SCSS (no markup fork).
 */
function myeventlane_theme_preprocess_commerce_checkout_pane(array &$variables): void {
  if (!isset($variables['elements']) || !is_array($variables['elements'])) {
    return;
  }
  if (!isset($variables['elements']['#attributes']['class'])) {
    $variables['elements']['#attributes']['class'] = [];
  }
  elseif (!is_array($variables['elements']['#attributes']['class'])) {
    $variables['elements']['#attributes']['class'] = [$variables['elements']['#attributes']['class']];
  }
  $variables['elements']['#attributes']['class'][] = 'mel-checkout-pane-shell';
}

/**
 * Implements hook_preprocess_region__header().
 *
 * Passes vendor status to the header region template.
 */
function myeventlane_theme_preprocess_region__header(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $variables['is_vendor'] = $current_user->hasPermission('access vendor dashboard');
}

/**
 * Implements hook_theme_suggestions_form_alter().
 *
 * Adds form__{form_id} suggestion so form--{form-id}.html.twig templates
 * (e.g. form--myeventlane-rsvp-public-form.html.twig) are used.
 */
function myeventlane_theme_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  $form_id = $element['#form_id'] ?? NULL;
  if (is_string($form_id) && $form_id !== '') {
    $suggestions[] = 'form__' . $form_id;
  }
  if ($form_id === 'user_form') {
    $token = \Drupal::request()->query->get('pass-reset-token');
    if (is_string($token) && $token !== '') {
      $suggestions[] = 'form__user_profile_form';
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK() for commerce_checkout_form.
 */
function myeventlane_theme_theme_suggestions_commerce_checkout_form(array $variables): array {
  $suggestions = [];
  $form = $variables['form'] ?? [];
  $step_id = $form['#step_id'] ?? NULL;
  if ($step_id === 'complete') {
    // Complete + visible sidebar: use commerce_checkout_form__with_sidebar only (Commerce + below).
    // Avoid competing __complete vs __with_sidebar suggestions on the same step.
    if (!isset($form['sidebar']) || !Element::isVisibleElement($form['sidebar'])) {
      $suggestions[] = 'commerce_checkout_form__complete';
    }
    return $suggestions;
  }
  if ($step_id !== NULL
    && isset($form['sidebar'])
    && Element::isVisibleElement($form['sidebar'])) {
    $suggestions[] = 'commerce_checkout_form__with_sidebar';
  }
  return $suggestions;
}

/**
 * Loads the commerce order from the current route (checkout pages).
 */
function _myeventlane_theme_commerce_order_from_route(): ?OrderInterface {
  $order_param = \Drupal::routeMatch()->getParameter('commerce_order');
  if ($order_param !== NULL && is_scalar($order_param) && is_numeric((string) $order_param)) {
    $loaded = \Drupal::entityTypeManager()
      ->getStorage('commerce_order')
      ->load((string) $order_param);
    return $loaded instanceof OrderInterface ? $loaded : NULL;
  }
  return $order_param instanceof OrderInterface ? $order_param : NULL;
}

/**
 * Whether the order is a natural free-RSVP checkout (list-price $0 tickets only).
 *
 * Distinguishes true RSVP products from orders that reach $0 via promotions
 * (e.g. 100% off a paid variation), where "Confirm RSVP" would mislead.
 */
function _myeventlane_theme_order_is_natural_zero_price_rsvp(OrderInterface $order): bool {
  $has_ticket_variation = FALSE;
  foreach ($order->getItems() as $item) {
    if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
      continue;
    }
    $purchased = $item->getPurchasedEntity();
    if (!$purchased instanceof ProductVariationInterface) {
      continue;
    }
    $has_ticket_variation = TRUE;
    $list_price = $purchased->getPrice();
    if ($list_price === NULL || !$list_price->isZero()) {
      return FALSE;
    }
  }
  return $has_ticket_variation;
}

/**
 * Implements hook_preprocess_HOOK() for commerce_checkout_form.
 */
function myeventlane_theme_preprocess_commerce_checkout_form(array &$variables): void {
  $step_id = $variables['form']['#step_id'] ?? NULL;

  if (($step_id ?? '') !== 'complete') {
    $order_param = _myeventlane_theme_commerce_order_from_route();
    if ($order_param instanceof OrderInterface) {
      $total_price = $order_param->getTotalPrice();
      // Primary CTA from order total + variation list prices (avoids stale labels when
      // payment pane is AJAX-hidden; RSVP label only for inherently free tickets).
      $form = &$variables['form'];
      if (isset($form['actions']['next']) && $total_price !== NULL) {
        if ($total_price->isZero()) {
          if (_myeventlane_theme_order_is_natural_zero_price_rsvp($order_param)) {
            $form['actions']['next']['#value'] = t('Confirm RSVP');
          }
          else {
            $form['actions']['next']['#value'] = t('Complete order');
          }
        }
        else {
          $form['actions']['next']['#value'] = t('Pay now');
        }
      }
    }
  }

  if ($step_id === 'complete') {
    $form = &$variables['form'];
    // Resolve order: route param, sidebar pane, or view arguments.
    $order = \Drupal::routeMatch()->getParameter('commerce_order')
      ?? $form['#order_entity']
      ?? ($form['sidebar']['order_summary']['#order_entity'] ?? NULL);
    // order_summary pane uses a view when configured; order ID is in #arguments.
    if (!$order && isset($form['sidebar']['order_summary']['summary']['#arguments'][0])) {
      $order = $form['sidebar']['order_summary']['summary']['#arguments'][0];
    }
    if ($order && is_numeric($order)) {
      $order = \Drupal::entityTypeManager()
        ->getStorage('commerce_order')
        ->load($order);
    }
    if ($order && $order instanceof \Drupal\commerce_order\Entity\OrderInterface) {
      $variables['order_entity'] = $order;
      $variables['order_totals'] = \Drupal::service('commerce_order.order_total_summary')
        ->buildTotals($order);
      // Build attendee names per order item (avoids referencedEntities() in Twig sandbox).
      $order_items_attendees = [];
      foreach ($order->getItems() as $item) {
        if (!$item->hasField('field_ticket_holder') || $item->get('field_ticket_holder')->isEmpty()) {
          continue;
        }
        $attendees = [];
        foreach ($item->get('field_ticket_holder')->referencedEntities() as $holder) {
          $first = $holder->hasField('field_first_name') && !$holder->get('field_first_name')->isEmpty()
            ? trim((string) $holder->get('field_first_name')->value) : '';
          $last = $holder->hasField('field_last_name') && !$holder->get('field_last_name')->isEmpty()
            ? trim((string) $holder->get('field_last_name')->value) : '';
          $email = $holder->hasField('field_email') && !$holder->get('field_email')->isEmpty()
            ? trim((string) $holder->get('field_email')->value) : '';
          $attendees[] = [
            'first_name' => $first,
            'last_name' => $last,
            'email' => $email,
          ];
        }
        if (!empty($attendees)) {
          $order_items_attendees[(int) $item->id()] = $attendees;
        }
      }
      $variables['order_items_attendees'] = $order_items_attendees;

      // Event image URLs for confirmation cards (avoids Twig sandbox restriction on first()).
      $file_url_generator = \Drupal::service('file_url_generator');
      $mel_event_image_urls = [];
      foreach ($order->getItems() as $item) {
        if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
          continue;
        }
        $event = NULL;
        if ($item->hasField('field_target_event') && !$item->get('field_target_event')->isEmpty()) {
          $event = $item->get('field_target_event')->entity;
        }
        if (!$event) {
          $pe = $item->getPurchasedEntity();
          if ($pe && $pe->hasField('field_event') && !$pe->get('field_event')->isEmpty()) {
            $event = $pe->get('field_event')->entity;
          }
        }
        if (!$event && $item->getPurchasedEntity()) {
          $product = $item->getPurchasedEntity()->getProduct();
          if ($product && $product->hasField('field_event') && !$product->get('field_event')->isEmpty()) {
            $event = $product->get('field_event')->entity;
          }
        }
        if ($event && $event->hasField('field_event_image') && !$event->get('field_event_image')->isEmpty()) {
          $event_id = (int) $event->id();
          if (!isset($mel_event_image_urls[$event_id])) {
            $files = $event->get('field_event_image')->referencedEntities();
            $file = !empty($files) ? reset($files) : NULL;
            if ($file) {
              $mel_event_image_urls[$event_id] = $file_url_generator->generateAbsoluteString($file->getFileUri());
            }
          }
        }
      }
      $variables['mel_event_image_urls'] = $mel_event_image_urls;

      // Help centre URL for confirmation support block (canonical hub only).
      try {
        $variables['mel_help_centre_url'] = Url::fromRoute('myeventlane_help_centre.home')->toString();
      }
      catch (RouteNotFoundException $e) {
        $variables['mel_help_centre_url'] = '/help';
      }

      // Calendar links, event URL, logged-in for Level 2 confirmation UX.
      $first_event = _myeventlane_theme_get_first_event_from_order($order);
      $variables['mel_calendar_links'] = $first_event ? _myeventlane_theme_build_calendar_links($first_event) : [];
      $variables['mel_event_url'] = $first_event
        ? $first_event->toUrl('canonical', ['absolute' => TRUE])->toString()
        : '';
      $variables['mel_logged_in'] = \Drupal::currentUser()->isAuthenticated();

      // Paid vs free/zero-total: honest labels on confirmation (Twig-safe booleans/strings).
      $total_price = $order->getTotalPrice();
      $variables['mel_confirm_paid'] = $total_price instanceof Price && !$total_price->isZero();

      $ticket_like_count = 0;
      foreach ($order->getItems() as $item) {
        if (!in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
          $ticket_like_count++;
        }
      }
      $variables['mel_confirmation_has_tickets'] = $ticket_like_count > 0;

      $donation_sum = NULL;
      foreach ($order->getItems() as $item) {
        if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation'], TRUE)) {
          $tp = $item->getTotalPrice();
          if ($tp instanceof Price && !$tp->isZero()) {
            $donation_sum = $donation_sum === NULL ? $tp : $donation_sum->add($tp);
          }
        }
      }
      $variables['mel_donation_total_formatted'] = NULL;
      if ($donation_sum instanceof Price && !$donation_sum->isZero()) {
        /** @var \Drupal\commerce_price\CurrencyFormatter $currency_formatter */
        $currency_formatter = \Drupal::service('commerce_price.currency_formatter');
        $variables['mel_donation_total_formatted'] = $currency_formatter->format(
          $donation_sum->getNumber(),
          $donation_sum->getCurrencyCode()
        );
      }

      // Attach copy-link JS when share block is present.
      if ($variables['mel_event_url']) {
        $variables['#attached']['library'][] = 'myeventlane_theme/mel_confirmation';
      }
    }
  }
}

/**
 * Extracts the first event node from an order.
 *
 * @param \Drupal\commerce_order\Entity\OrderInterface $order
 *   The order entity.
 *
 * @return \Drupal\node\NodeInterface|null
 *   The first event node, or NULL.
 */
function _myeventlane_theme_get_first_event_from_order($order) {
  foreach ($order->getItems() as $item) {
    if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
      continue;
    }
    $event = NULL;
    if ($item->hasField('field_target_event') && !$item->get('field_target_event')->isEmpty()) {
      $event = $item->get('field_target_event')->entity;
    }
    if (!$event) {
      $pe = $item->getPurchasedEntity();
      if ($pe && $pe->hasField('field_event') && !$pe->get('field_event')->isEmpty()) {
        $event = $pe->get('field_event')->entity;
      }
    }
    if (!$event && $item->getPurchasedEntity()) {
      $product = $item->getPurchasedEntity()->getProduct();
      if ($product && $product->hasField('field_event') && !$product->get('field_event')->isEmpty()) {
        $event = $product->get('field_event')->entity;
      }
    }
    if ($event && $event instanceof NodeInterface && $event->bundle() === 'event') {
      return $event;
    }
  }
  return NULL;
}

/**
 * Builds calendar links (Apple, Google, Outlook) for an event.
 *
 * Mirrors EventSerializer logic; uses existing ICS route for Apple.
 *
 * @param \Drupal\node\NodeInterface $event
 *   The event node.
 *
 * @return array{apple?: string, google?: string, outlook?: string}
 *   Calendar link URLs.
 */
function _myeventlane_theme_build_calendar_links(NodeInterface $event): array {
  $links = [];

  $ics_url = Url::fromRoute('myeventlane_rsvp.ics_download', ['node' => $event->id()], ['absolute' => TRUE]);
  $links['ics'] = $ics_url->toString();
  $links['apple'] = $links['ics'];

  if (!$event->hasField('field_event_start') || $event->get('field_event_start')->isEmpty()) {
    return $links;
  }

  $title = rawurlencode($event->label());
  $start = gmdate('Ymd\THis\Z', strtotime($event->get('field_event_start')->value));
  $end = $event->hasField('field_event_end') && !$event->get('field_event_end')->isEmpty()
    ? gmdate('Ymd\THis\Z', strtotime($event->get('field_event_end')->value))
    : $start;

  $details = '';
  if ($event->hasField('body') && !$event->get('body')->isEmpty()) {
    $details = rawurlencode(strip_tags($event->get('body')->summary ?? $event->get('body')->value ?? ''));
  }

  $location = '';
  if ($event->hasField('field_location') && !$event->get('field_location')->isEmpty()) {
    $address = $event->get('field_location')->first();
    if ($address) {
      $parts = array_filter([
        $address->get('address_line1')->value ?? NULL,
        $address->get('locality')->value ?? NULL,
        $address->get('administrative_area')->value ?? NULL,
        $address->get('postal_code')->value ?? NULL,
      ]);
      $location = rawurlencode(implode(', ', $parts));
    }
  }

  $links['google'] = "https://calendar.google.com/calendar/render?action=TEMPLATE" .
    "&text=$title&dates={$start}/{$end}&details=$details&location=$location";

  $start_outlook = gmdate('Y-m-d\TH:i:s\Z', strtotime($event->get('field_event_start')->value));
  $end_outlook = $event->hasField('field_event_end') && !$event->get('field_event_end')->isEmpty()
    ? gmdate('Y-m-d\TH:i:s\Z', strtotime($event->get('field_event_end')->value))
    : $start_outlook;
  $links['outlook'] = "https://outlook.live.com/calendar/0/deeplink/compose?subject={$title}&startdt={$start_outlook}&enddt={$end_outlook}";

  return $links;
}

/**
 * Implements hook_preprocess_html().
 */
function myeventlane_theme_preprocess_html(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match ? $route_match->getRouteName() : '';

  if (is_string($route_name) && $route_name !== '') {
    // Scope all Commerce cart/checkout/order-detail styling.
    if (str_starts_with($route_name, 'commerce_cart.') || str_starts_with($route_name, 'commerce_checkout.') || $route_name === 'entity.commerce_order.user_view') {
      $variables['attributes']['class'][] = 'mel-commerce';
    }

    if (str_starts_with($route_name, 'commerce_cart.')) {
      $variables['attributes']['class'][] = 'mel-commerce-cart';
    }

    if (str_starts_with($route_name, 'commerce_checkout.')) {
      $variables['attributes']['class'][] = 'mel-commerce-checkout';
    }

    if ($route_name === 'entity.commerce_order.user_view') {
      $variables['attributes']['class'][] = 'mel-commerce-order-detail';
    }
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 *
 * When the site front page is a node (e.g. system.site page.front = /home),
 * core adds page__node__* suggestions that are more specific than page__front,
 * so page--front.html.twig is never selected. MEL homepage markup lives only in
 * page--front.html.twig — strip node-based page suggestions on the front route
 * and ensure page__front wins.
 */
function myeventlane_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  // Full calendar view: ensure page--calendar + preprocess_page__calendar run (path-based
  // suggestions can miss this display; without it calendar_events stays unset).
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'myeventlane_auth.post_login') {
    $suggestions[] = 'page__mel_post_login';
  }
  if ($route === 'user.login') {
    $suggestions[] = 'page__user_login';
  }
  if ($route === 'user.register') {
    $suggestions[] = 'page__user_register';
  }
  if ($route === 'view.events_calendar.page_calendar') {
    $suggestions[] = 'page__calendar';
  }

  if (!\Drupal::service('path.matcher')->isFrontPage()) {
    return;
  }
  $suggestions = array_values(array_filter($suggestions, static function (string $suggestion): bool {
    if ($suggestion === 'page__front') {
      return FALSE;
    }
    return !str_starts_with($suggestion, 'page__node');
  }));
  $suggestions[] = 'page__front';
}

/**
 * Implements hook_preprocess_page().
 *
 * Adds cart block to header if not already placed.
 */
function myeventlane_theme_preprocess_page(array &$variables): void {
  // Add logo path for header.
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  $variables['logo_path'] = base_path() . $theme_path . '/images/logo.svg';
  
  // Ensure directory variable is available for all templates (especially homepage hero).
  if (!isset($variables['directory'])) {
    $variables['directory'] = base_path() . $theme_path;
  }

  // Footer: dynamic categories (only if > 3 published events) + organiser detection.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tree = $term_storage->loadTree('categories', 0, 10, TRUE);
  $categories = [];
  foreach ($tree as $term) {
    $count = \Drupal::entityQuery('node')
      ->condition('type', 'event')
      ->condition('status', 1)
      ->condition('field_category', $term->id())
      ->accessCheck(FALSE)
      ->count()
      ->execute();
    if ($count > 3) {
      $categories[] = [
        'title' => $term->label(),
        'url' => Url::fromRoute('view.upcoming_events.page_category', ['arg_0' => $term->id()])->toString(),
      ];
    }
  }
  $variables['mel_footer_categories'] = $categories;
  $variables['mel_is_organiser'] = \Drupal::currentUser()->hasPermission('access vendor dashboard');
  
  // Check if vendor settings route exists for header menu.
  $route_exists = FALSE;

  try {
    \Drupal::service('router.route_provider')
      ->getRouteByName('myeventlane_vendor.console.settings');
    $route_exists = TRUE;
  }
  catch (RouteNotFoundException $e) {
    $route_exists = FALSE;
  }

  $variables['mel_vendor_settings_route_exists'] = $route_exists;

  // mel_header_categories for listing pages (events, search, category).
  $route = \Drupal::routeMatch()->getRouteName();
  $listing_routes = [
    'view.upcoming_events.page_events',
    'view.upcoming_events.page_category',
    'view.upcoming_events.page_today',
    'view.upcoming_events.page_this_weekend',
    'view.upcoming_events.page_free',
    'mel_search.view',
  ];
  if (in_array($route, $listing_routes, TRUE) && empty($variables['mel_header_categories'])) {
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $terms = $term_storage->loadByProperties(['vid' => 'categories']);
    $categories = [];
    foreach ($terms as $term) {
      $slug = _myeventlane_theme_get_category_slug($term);
      $categories[] = [
        'tid' => $term->id(),
        'name' => $term->label(),
        'label' => $term->label(),
        'url' => Url::fromRoute('view.upcoming_events.page_category', ['arg_0' => $term->id()])->toString(),
        'slug' => $slug,
      ];
    }
    $variables['mel_header_categories'] = $categories;
  }

  // Active category pill for discovery headers (matches route to chip).
  $variables['mel_active_category_tid'] = NULL;
  if ($route === 'view.upcoming_events.page_category') {
    $arg = \Drupal::routeMatch()->getParameter('arg_0');
    if ($arg !== NULL && $arg !== '') {
      $variables['mel_active_category_tid'] = (string) $arg;
    }
  }
  elseif ($route === 'entity.taxonomy_term.canonical') {
    $taxonomy_term = \Drupal::routeMatch()->getParameter('taxonomy_term');
    if ($taxonomy_term instanceof TermInterface && $taxonomy_term->bundle() === 'categories') {
      $variables['mel_active_category_tid'] = (string) $taxonomy_term->id();
    }
  }

  // Hero image for listing pages (category, search, events).
  // Prefer Page Visuals Manager (myeventlane_page_visuals) when available.
  if (isset($variables['page_visual']['image_url']) && $variables['page_visual']['image_url']) {
    $variables['mel_hero_image_url'] = $variables['page_visual']['image_url'];
    $variables['mel_hero_image_url_mobile'] = $variables['page_visual']['image_url_mobile'] ?? NULL;
    $variables['mel_hero_hide_on_mobile'] = $variables['page_visual']['hide_on_mobile'] ?? FALSE;
  }
  elseif (empty($variables['mel_hero_image_url'])) {
    $variables['mel_hero_image_url'] = _myeventlane_theme_get_listing_hero_url($route);
    $variables['mel_hero_image_url_mobile'] = NULL;
    $variables['mel_hero_hide_on_mobile'] = FALSE;
  }

  // Site header: compact global header (desktop + mobile).
  $variables['site_header'] = [
    '#theme' => 'site_header',
    '#attached' => [
      'library' => ['myeventlane_theme/account-dropdown'],
    ],
  ];
  
  // Ensure header region blocks are available even if region template isn't used.
  // Initialize header array if not set.
  if (!isset($variables['page']['header'])) {
    $variables['page']['header'] = [];
  }
  
  // Load main menu block manually since page.html.twig includes header template directly
  // without rendering {{ page.header }} first, so blocks aren't automatically added.
  if (empty($variables['page']['header']['main_menu']) && empty($variables['page']['header']['myeventlane_theme_main_menu'])) {
    try {
      $block_storage = \Drupal::entityTypeManager()->getStorage('block');
      $block = $block_storage->load('myeventlane_theme_main_menu');
      if ($block && $block->status() && $block->getRegion() === 'header') {
        $block_plugin = $block->getPlugin();
        $current_user = \Drupal::currentUser();
        if ($block_plugin->access($current_user)) {
          $build = $block_plugin->build();
          if (!empty($build) && is_array($build)) {
            // Ensure the build array is renderable
            $variables['page']['header']['main_menu'] = $build;
          }
        }
      }
    }
    catch (\Exception $e) {
      // Block load/build failed, log and continue
      \Drupal::logger('myeventlane_theme')->warning('Failed to load main menu block: @message', ['@message' => $e->getMessage()]);
    }
  }
  
  // Map main menu block to expected variable name if it exists with block ID key.
  // This handles the case where Drupal renders the region normally.
  if (!empty($variables['page']['header']['myeventlane_theme_main_menu']) && empty($variables['page']['header']['main_menu'])) {
    $variables['page']['header']['main_menu'] = $variables['page']['header']['myeventlane_theme_main_menu'];
  }
  
  // Add cart block to header if not already present
  if (empty($variables['page']['header']['cart_block'])) {
    try {
      $block_manager = \Drupal::service('plugin.manager.block');
      $cart_block = $block_manager->createInstance('commerce_cart', []);
      if ($cart_block && $cart_block->access(\Drupal::currentUser())) {
        $build = $cart_block->build();
        if (!empty($build)) {
          $variables['page']['header']['cart_block'] = $build;
        }
      }
    } catch (\Exception $e) {
      // Cart block not available, continue without it
    }
  }
  
  // Front page specific processing
  // Check if this is the front page.
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    // Load category terms.
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $terms = $term_storage->loadByProperties(['vid' => 'categories']);
    
    $categories = [];
    foreach ($terms as $term) {
      $slug = _myeventlane_theme_get_category_slug($term);
      $categories[] = [
        'tid' => $term->id(),
        'name' => $term->label(),
        'label' => $term->label(),
        'url' => '/events/category/' . $term->id(),
        'slug' => $slug,
      ];
    }
    
    $variables['event_categories'] = $categories;

    // Hero popular_tags: { name, url } for taxonomy terms.
    $popular_tags = [];
    foreach ($categories as $c) {
      $popular_tags[] = [
        'name' => $c['name'],
        'url' => Url::fromRoute('view.upcoming_events.page_category', ['arg_0' => $c['tid']])->toString(),
      ];
    }
    $variables['popular_tags'] = $popular_tags;

    // Add calendar data for mini calendar
    $variables['calendar'] = _myeventlane_theme_get_calendar_data();

    // Homepage event rails: rendered via drupal_view() in page--front.html.twig.
    // Category pills: drupal_block('myeventlane_category_pills') in page--front.html.twig.
    // Region emptiness: Twig `{% if page.host_cta %}` is true for empty regions; use children count.
    $variables['mel_home_use_host_cta_region'] = FALSE;
    if (isset($variables['page']['host_cta']) && is_array($variables['page']['host_cta'])) {
      $variables['mel_home_use_host_cta_region'] = count(Element::children($variables['page']['host_cta'])) > 0;
    }
    $variables['mel_home_use_bottom_cta_region'] = FALSE;
    if (isset($variables['page']['bottom_cta']) && is_array($variables['page']['bottom_cta'])) {
      $variables['mel_home_use_bottom_cta_region'] = count(Element::children($variables['page']['bottom_cta'])) > 0;
    }
  }
  
  // MyEventLane Illustration System: Category-aware hero swaps.
  // Category pages MUST use category banners from /images/mel/categories/.
  // Homepage MUST ALWAYS use journey hero images.
  // Category pages NEVER show journey hero (only fallback if banner missing).
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  $extension_list = \Drupal::service('extension.list.theme');
  $theme_path = $extension_list->getPath('myeventlane_theme');
  $is_front_page = \Drupal::service('path.matcher')->isFrontPage();
  
  $category_slug = NULL;
  $category_term = NULL;
  
  // Detect category context: taxonomy.term route ONLY.
  // Do NOT detect via views or query params - use route only.
  if ($route_name === 'entity.taxonomy_term.canonical') {
    $term = $route_match->getParameter('taxonomy_term');
    if ($term && $term->bundle() === 'categories') {
      $category_term = $term;
      // Get category slug using helper function (handles field_mel_slug or fallback to sanitized name).
      $category_slug = _myeventlane_theme_get_category_slug($term);
    }
  }
  
  // Build hero URLs based on page type.
  $hero_desktop_url = NULL;
  $hero_mobile_url = NULL;
  $base_url = base_path();
  
  // Category pages: Use category banner directly from /images/mel/categories/.
  // Category pages override hero - homepage never overridden.
  if ($category_slug && !$is_front_page) {
    // Map category slug to match actual banner file names.
    // File names: mel-category-arts.png, mel-category-lgbtqia.png, etc.
    $slug_to_filename_map = [
      'lgbtqi' => 'lgbtqia',  // LGBTQI+ term → lgbtqia file
      'food-drink' => 'food', // Food & Drink term → food file
      // All other slugs should match: music, workshop, arts, community, markets, family
    ];
    
    $banner_slug = $slug_to_filename_map[$category_slug] ?? $category_slug;
    
    // Category page: Use category banner as hero.
    // Desktop: images/mel/categories/mel-category-{slug}.png
    $banner_desktop_relative = $theme_path . '/images/mel/categories/mel-category-' . $banner_slug . '.png';
    $banner_desktop_path = DRUPAL_ROOT . '/' . $banner_desktop_relative;
    
    if (file_exists($banner_desktop_path)) {
      $hero_desktop_url = $base_url . $banner_desktop_relative;
    }
    
    // Mobile: Same category banner (acceptable per requirements).
    // If a mobile-specific version exists later, it can be added.
    if ($hero_desktop_url) {
      $hero_mobile_url = $hero_desktop_url;
    }
    
    // Fallback: If category banner doesn't exist, use journey hero, then mel-hero-home.
    if (!$hero_desktop_url) {
      $journey_desktop_relative = $theme_path . '/images/mel/hero/mel-hero-journey-desktop.png';
      $journey_desktop_path = DRUPAL_ROOT . '/' . $journey_desktop_relative;
      $journey_mobile_relative = $theme_path . '/images/mel/hero/mel-hero-journey-mobile.png';
      $journey_mobile_path = DRUPAL_ROOT . '/' . $journey_mobile_relative;
      $home_relative = $theme_path . '/images/mel/hero/mel-hero-home.png';
      $home_path = DRUPAL_ROOT . '/' . $home_relative;

      if (file_exists($journey_desktop_path)) {
        $hero_desktop_url = $base_url . $journey_desktop_relative;
      }
      elseif (file_exists($home_path)) {
        $hero_desktop_url = $base_url . $home_relative;
      }
      if (file_exists($journey_mobile_path)) {
        $hero_mobile_url = $base_url . $journey_mobile_relative;
      }
      elseif ($hero_desktop_url) {
        $hero_mobile_url = $hero_desktop_url;
      }
    }
  }
  
  // Homepage: Use journey hero images, fallback to mel-hero-home.png.
  // Homepage never uses category banners.
  if ($is_front_page) {
    $journey_desktop_relative = $theme_path . '/images/mel/hero/mel-hero-journey-desktop.png';
    $journey_desktop_path = DRUPAL_ROOT . '/' . $journey_desktop_relative;
    $journey_mobile_relative = $theme_path . '/images/mel/hero/mel-hero-journey-mobile.png';
    $journey_mobile_path = DRUPAL_ROOT . '/' . $journey_mobile_relative;
    $home_relative = $theme_path . '/images/mel/hero/mel-hero-home.png';
    $home_path = DRUPAL_ROOT . '/' . $home_relative;

    if (file_exists($journey_desktop_path)) {
      $hero_desktop_url = $base_url . $journey_desktop_relative;
    }
    elseif (file_exists($home_path)) {
      $hero_desktop_url = $base_url . $home_relative;
    }
    if (file_exists($journey_mobile_path)) {
      $hero_mobile_url = $base_url . $journey_mobile_relative;
    }
    elseif ($hero_desktop_url) {
      $hero_mobile_url = $hero_desktop_url;
    }
  }
  
  // Ensure directory variable is available for hero fallback in templates.
  if (!isset($variables['directory'])) {
    $variables['directory'] = base_path() . $theme_path;
  }
  
  // Set variables for Twig templates.
  $variables['mel_hero_desktop_url'] = $hero_desktop_url;
  $variables['mel_hero_mobile_url'] = $hero_mobile_url;
  $variables['mel_category_slug'] = $category_slug;

  // Status messages: when Highlighted has no blocks (config not imported, etc.),
  // page.highlighted is empty and users see no success/errors (e.g. /contact).
  // Build the same system block programmatically as a fallback only in that case.
  $page_render = $variables['page'] ?? [];
  $highlighted = $page_render['highlighted'] ?? [];
  $highlighted_has_blocks = is_array($highlighted) && count(Element::children($highlighted)) > 0;
  if (!$highlighted_has_blocks) {
    try {
      $block_manager = \Drupal::service('plugin.manager.block');
      $messages_block = $block_manager->createInstance('system_messages_block', []);
      if ($messages_block->access(\Drupal::currentUser())) {
        $messages_build = $messages_block->build();
        if (!empty($messages_build)) {
          $variables['mel_fallback_messages'] = $messages_build;
        }
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->error('Fallback status messages could not be built: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }
}

/**
 * Helper function to generate calendar data.
 */
function _myeventlane_theme_get_calendar_data($year = NULL, $month = NULL): array {
  $year = $year ?: date('Y');
  $month = $month ?: date('n');
  
  $first_day = mktime(0, 0, 0, $month, 1, $year);
  $days_in_month = date('t', $first_day);
  $start_day = date('w', $first_day); // 0 = Sunday
  
  // Get events for this month
  $start_date = date('Y-m-01', $first_day);
  $end_date = date('Y-m-t', $first_day);
  
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'event')
    ->condition('status', 1)
    ->condition('field_event_start', $start_date, '>=')
    ->condition('field_event_start', $end_date . 'T23:59:59', '<=')
    ->accessCheck(TRUE);
  
  $nids = $query->execute();
  $events_by_day = [];
  
  if (!empty($nids)) {
    $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
    foreach ($nodes as $node) {
      $event_date = $node->get('field_event_start')->value;
      $day = (int) date('j', strtotime($event_date));
      if (!isset($events_by_day[$day])) {
        $events_by_day[$day] = [];
      }
      $events_by_day[$day][] = [
        'title' => $node->label(),
        'url' => $node->toUrl()->toString(),
      ];
    }
  }
  
  return [
    'year' => $year,
    'month' => $month,
    'month_name' => date('F', $first_day),
    'days_in_month' => $days_in_month,
    'start_day' => $start_day,
    'today' => (int) date('j'),
    'is_current_month' => ($year == date('Y') && $month == date('n')),
    'events_by_day' => $events_by_day,
  ];
}

/**
 * Implements hook_preprocess_page() for category pages.
 *
 * Adds category info and all categories for the hero section.
 */
function myeventlane_theme_preprocess_page__events__category(array &$variables): void {
  // Get the category term ID from the URL.
  $tid = \Drupal::routeMatch()->getParameter('arg_0');
  
  if ($tid) {
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
    if ($term) {
      $variables['current_category'] = [
        'tid' => $term->id(),
        'name' => $term->label(),
      ];
    }
  }
  
  // Load all categories for the hero chips.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadByProperties(['vid' => 'categories']);
  
  $categories = [];
  foreach ($terms as $term) {
    $slug = _myeventlane_theme_get_category_slug($term);
    $categories[] = [
      'tid' => $term->id(),
      'name' => $term->label(),
      'label' => $term->label(),
      'url' => Url::fromRoute('view.upcoming_events.page_category', ['arg_0' => $term->id()])->toString(),
      'slug' => $slug,
    ];
  }
  
  $variables['event_categories'] = $categories;
  // Also set as mel_header_categories if used by page header component.
  $variables['mel_header_categories'] = $categories;
}

/**
 * Implements hook_preprocess_page() for calendar page.
 */
function myeventlane_theme_preprocess_page__calendar(array &$variables): void {
  // Load all published events for the calendar.
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'event')
    ->condition('status', 1)
    ->accessCheck(TRUE);

  $nids = $query->execute();
  $events = [];

  if (!empty($nids)) {
    $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
    
    // Category colors.
    $category_colors = [
      'music' => '#7c5cff',
      'sports' => '#ff6f61',
      'food' => '#ffd46f',
      'arts' => '#4ecdc4',
      'business' => '#1a1a2e',
      'community' => '#ff6f61',
      'education' => '#4ecdc4',
      'charity' => '#ff6f61',
    ];

    foreach ($nodes as $node) {
      $start = $node->get('field_event_start')->value;
      $end = $node->hasField('field_event_end') ? $node->get('field_event_end')->value : NULL;
      
      // Get category color.
      $color = '#7c5cff';
      if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
        $category = $node->get('field_category')->entity;
        if ($category) {
          $cat_name = strtolower($category->label());
          $color = $category_colors[$cat_name] ?? '#7c5cff';
        }
      }

      if ($start) {
        $events[] = [
          'title' => $node->label(),
          'start' => $start,
          'end' => $end,
          'url' => $node->toUrl()->toString(),
          'color' => $color,
        ];
      }
    }
  }

  $variables['calendar_events'] = $events;
}

/**
 * Implements hook_library_info_alter().
 *
 * Dynamically rewrites the 'global-styling' library to point to the current
 * Vite-built CSS files defined in the manifest. This allows hashed filenames
 * generated by Vite (e.g. main.BMgQme3h.css) to be used automatically.
 */
function myeventlane_theme_library_info_alter(array &$libraries, string $extension): void {
  // Only alter this theme's own libraries.
  if ($extension !== 'myeventlane_theme') {
    return;
  }

  $manifest = _myeventlane_theme_vite_manifest();
  if (!$manifest || !is_array($manifest) || $manifest === []) {
    \Drupal::logger('myeventlane_theme')->error('MEL ERROR: Vite manifest missing. Assets not built.');
    return;
  }

  $theme_handler = \Drupal::service('extension.list.theme');
  $relative_theme_path = $theme_handler->getPath('myeventlane_theme');
  $theme_fs = DRUPAL_ROOT . '/' . $relative_theme_path . '/';

  $log_missing_asset = static function (string $relative_path) : void {
    \Drupal::logger('myeventlane_theme')->error('MEL ERROR: Vite manifest references missing file: @path', [
      '@path' => $relative_path,
    ]);
  };

  // Global bundle (main) entry: src/js/main.js → css + js.
  // Keep both legacy aliases in sync to avoid stale hardcoded dist/main.js paths.
  $main = $manifest['js/main.js'] ?? NULL;
  if (is_array($main)) {
    $global_libraries = ['global-styling', 'myeventlane-global'];
    foreach ($global_libraries as $library_name) {
      if (!isset($libraries[$library_name])) {
        continue;
      }
      // CSS.
      if (!empty($main['css'][0]) && is_string($main['css'][0])) {
        $css = ltrim($main['css'][0], '/');
        $relative = 'dist/' . $css;
        if (!is_file($theme_fs . $relative)) {
          $log_missing_asset($relative);
        }
        $libraries[$library_name]['css']['theme'] = [
          $relative => [],
        ];
      }
      // JS.
      if (!empty($main['file']) && is_string($main['file'])) {
        $js = ltrim($main['file'], '/');
        $relative = 'dist/' . $js;
        if (!is_file($theme_fs . $relative)) {
          $log_missing_asset($relative);
        }
        $libraries[$library_name]['js'] = [
          $relative => [],
        ];
      }
    }
  }

  // Front CSS entry: src/scss/front.scss → dist/css/front.css (or hashed).
  if (isset($libraries['front']['css']['theme']) || isset($libraries['mel-listing-header']['css']['theme'])) {
    $front = $manifest['scss/front.scss'] ?? NULL;
    if (is_array($front) && !empty($front['file']) && is_string($front['file'])) {
      $css = ltrim($front['file'], '/');
      $relative = 'dist/' . $css;
      if (!is_file($theme_fs . $relative)) {
        $log_missing_asset($relative);
      }
      if (isset($libraries['front']['css']['theme'])) {
        $libraries['front']['css']['theme'] = [
          $relative => [],
        ];
      }
      if (isset($libraries['mel-listing-header']['css']['theme'])) {
        $libraries['mel-listing-header']['css']['theme'] = [
          $relative => [],
        ];
      }
    }
  }

  // Account dropdown entry (legacy): src/js/account-dropdown.js.
  if (isset($libraries['account-dropdown'])) {
    $entry = $manifest['js/account-dropdown.js'] ?? NULL;
    if (is_array($entry) && !empty($entry['file']) && is_string($entry['file'])) {
      $js = ltrim($entry['file'], '/');
      $relative = 'dist/' . $js;
      if (!is_file($theme_fs . $relative)) {
        $log_missing_asset($relative);
      }
      $libraries['account-dropdown']['js'] = [
        $relative => [],
      ];
    }
  }
}

/**
 * Loads Vite manifest.json as an array.
 *
 * @return array|null
 *   The decoded manifest, or NULL if missing/invalid.
 */
function _myeventlane_theme_vite_manifest(): ?array {
  static $cached = NULL;
  if ($cached !== NULL) {
    return $cached;
  }

  $theme_handler = \Drupal::service('extension.list.theme');
  $relative_theme_path = $theme_handler->getPath('myeventlane_theme');
  $manifest_path = DRUPAL_ROOT . '/' . $relative_theme_path . '/dist/.vite/manifest.json';

  if (!is_file($manifest_path)) {
    return $cached = NULL;
  }

  $json = @file_get_contents($manifest_path);
  if (!$json) {
    return $cached = NULL;
  }

  $manifest = json_decode($json, TRUE);
  return $cached = is_array($manifest) ? $manifest : NULL;
}

/**
 * Build render array for the event_save flag link (AJAX) for an event node.
 *
 * Uses Flag's flag.link_builder lazy builder (not twig_tweak::drupal_entity,
 * which only renders config/view of entities, not the flag action link).
 */
function _myeventlane_theme_event_event_save_flag_link($node): ?array {
  if (!is_object($node) || !method_exists($node, 'bundle') || $node->bundle() !== 'event' || !\Drupal::moduleHandler()->moduleExists('flag') || !\Drupal::hasService('flag.link_builder') || !\Drupal::hasService('flag')) {
    return NULL;
  }
  /** @var \Drupal\flag\FlagService $flagService */
  $flagService = \Drupal::service('flag');
  $flag = $flagService->getFlagById('event_save');
  if (!$flag) {
    return NULL;
  }
  if (!in_array('event', $flag->getBundles(), TRUE) && !empty($flag->getBundles())) {
    return NULL;
  }
  $nid = (int) $node->id();
  $build = [
    '#lazy_builder' => [
      'flag.link_builder:build',
      [
        'node',
        (string) $nid,
        'event_save',
        'default',
      ],
    ],
    // Keep placeholder rendering enabled so Flag builds per-request state/tokens
    // safely instead of risking cached stale action links.
    '#create_placeholder' => TRUE,
  ];
  return $build;
}

/**
 * Implements hook_preprocess_node().
 *
 * Adds classes and context for event form pages.
 * Adds MyEventLane illustration system variables for event nodes.
 * For event card view modes, prepares variables for mel-event-card component.
 */
function myeventlane_theme_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  $view_mode = $variables['view_mode'] ?? 'full';

  // Help article variables: myeventlane_help_centre_preprocess_node() (all themes).

  // Check if this is an event node.
  if ($node && $node->bundle() === 'event') {
    $eventDomainStateResolver = \Drupal::hasService('myeventlane_core.event_state_resolver')
      ? \Drupal::service('myeventlane_core.event_state_resolver')
      : NULL;
    // For form view mode, suggest the form template
    if ($view_mode === 'form' || (isset($variables['form']) && $variables['form'])) {
      $variables['attributes']['class'][] = 'mel-node-form';
      $variables['attributes']['class'][] = 'mel-node-form--event';
      // Suggest the form template
      $variables['theme_hook_suggestions'][] = 'node__event__form';
    }

    // MyEventLane Illustration System: Compute image URL, category slug, and placeholder URL.
    $file_url_generator = \Drupal::service('file_url_generator');
    $extension_list = \Drupal::service('extension.list.theme');
    $theme_path = $extension_list->getPath('myeventlane_theme');
    $base_path = base_path();

    // Ensure directory variable is available to node templates/components.
    // Many templates include components with `only`, which drops outer-scope
    // variables; by setting it here we can pass it explicitly when needed.
    if (!isset($variables['directory'])) {
      $variables['directory'] = $base_path . $theme_path;
    }

    // Event Intelligence Layer: one calm label per event (placeholder tier; replace with metrics later).
    $variables['mel_signal'] = NULL;
    $mel_state = (string) ($variables['mel_event_state'] ?? '');
    $event_ui_signal = is_array($variables['event_ui'] ?? NULL) ? $variables['event_ui'] : [];
    $signal_sold_out = !empty($event_ui_signal['is_sold_out']);
    $signal_hide = ($mel_state === 'cancelled')
      || ($mel_state === 'sold_out')
      || $signal_sold_out;
    if (!$signal_hide) {
      $mel_signals = [
        (string) t('Popular'),
        (string) t('Trending'),
        (string) t('Just added'),
      ];
      $mel_signal_idx = (int) $node->id() % count($mel_signals);
      $variables['mel_signal'] = $mel_signals[$mel_signal_idx];
    }

    // 1. Compute event image URL if it exists.
    $event_image_url = NULL;
    $event_image_uri = NULL;
    if ($node->hasField('field_event_image') && !$node->get('field_event_image')->isEmpty()) {
      $event_files = $node->get('field_event_image')->referencedEntities();
      $image_entity = !empty($event_files) ? reset($event_files) : NULL;
      if ($image_entity) {
        $event_image_uri = $image_entity->getFileUri();
        $event_image_url = $file_url_generator->generateAbsoluteString($event_image_uri);
      }
    }
    $variables['mel_event_image_url'] = $event_image_url;

    // 2. Determine category slug from first category term and add category info for pills.
    // Handle multi-value field (cardinality: -1) by getting first referenced entity.
    $category_slug = 'default';
    $category_label = NULL;
    $category_url = NULL;
    $category_term = NULL;
    if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
      $category_field = $node->get('field_category');
      // For multi-value fields, use referencedEntities() and get first one
      $referenced_entities = $category_field->referencedEntities();
      if (!empty($referenced_entities)) {
        $category_term = reset($referenced_entities);
        if ($category_term instanceof \Drupal\taxonomy\Entity\Term) {
          $category_slug = _myeventlane_theme_get_category_slug($category_term);
          $category_label = $category_term->label();
          $category_url = Url::fromRoute('view.upcoming_events.page_category', [
            'arg_0' => (string) $category_term->id(),
          ])->toString();
        }
      }
    }
    
    // Normalize lgbtqi+ variants to lgbtqia for consistency
    if (in_array($category_slug, ['lgbtqi', 'lgbtq', 'lgbtqi+', 'lgbtqia+'], TRUE)) {
      $category_slug = 'lgbtqia';
    }
    
    $variables['mel_category_slug'] = $category_slug;
    $variables['mel_category_label'] = $category_label;
    $variables['mel_category_url'] = $category_url;

    // 3. Build placeholder URL: {theme}/images/mel/placeholders/mel-placeholder-{slug}.png or .svg
    // Check if placeholder file exists, otherwise fallback to default; support .svg when .png missing
    $placeholder_filename = 'mel-placeholder-' . $category_slug . '.png';
    $placeholder_relative_path = $theme_path . '/images/mel/placeholders/' . $placeholder_filename;
    $placeholder_file_path = DRUPAL_ROOT . '/' . $placeholder_relative_path;

    if (!file_exists($placeholder_file_path)) {
      $placeholder_filename = 'mel-placeholder-' . $category_slug . '.svg';
      $placeholder_relative_path = $theme_path . '/images/mel/placeholders/' . $placeholder_filename;
      $placeholder_file_path = DRUPAL_ROOT . '/' . $placeholder_relative_path;
    }
    if (!file_exists($placeholder_file_path)) {
      $placeholder_filename = 'mel-placeholder-default.png';
      $placeholder_relative_path = $theme_path . '/images/mel/placeholders/' . $placeholder_filename;
      $placeholder_file_path = DRUPAL_ROOT . '/' . $placeholder_relative_path;
    }
    if (!file_exists($placeholder_file_path)) {
      $placeholder_filename = 'mel-placeholder-default.svg';
      $placeholder_relative_path = $theme_path . '/images/mel/placeholders/' . $placeholder_filename;
      $placeholder_file_path = DRUPAL_ROOT . '/' . $placeholder_relative_path;
    }

    $placeholder_url = NULL;
    if (file_exists($placeholder_file_path)) {
      $placeholder_url = $base_path . $placeholder_relative_path;
    }
    $variables['mel_placeholder_image_url'] = $placeholder_url;
    $variables['mel_fallback_image_url'] = $placeholder_url;

    // 4. For card view modes, prepare variables for mel-event-card component
    $card_view_modes = [
      'card',
      'event_card',
      'teaser',
      'teaser_tonight',
      'teaser_featured',
      'event_card_poster',
      'event_card_compact',
      'event_home_card',
    ];
    if (in_array($view_mode, $card_view_modes, TRUE)) {
      // Listing cards: real image only; missing image uses CSS gradient (no text-bearing assets).
      $card_image_url = $event_image_url;
      $is_placeholder = !$event_image_url;
      if ($event_image_uri) {
        $style_storage = \Drupal::entityTypeManager()->getStorage('image_style');
        $styled_modes = [
          'teaser',
          'teaser_tonight',
          'event_card',
          'teaser_featured',
          'event_card_compact',
          'event_home_card',
          'event_card_poster',
        ];
        if (in_array($view_mode, $styled_modes, TRUE)) {
          $style_id = ($view_mode === 'teaser_featured' || $view_mode === 'event_card_poster')
            ? 'mel_event_card_featured'
            : 'mel_event_card_standard';
          $image_style = $style_storage->load($style_id);
          if ($image_style) {
            $card_image_url = $image_style->buildUrl($event_image_uri);
            if (!isset($variables['#cache']['tags'])) {
              $variables['#cache']['tags'] = [];
            }
            $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'], $image_style->getCacheTags());
          }
        }
      }
      else {
        $card_image_url = NULL;
      }
      $variables['mel_card_image_url'] = $card_image_url;
      $variables['mel_card_is_placeholder'] = $is_placeholder;

      // Note: Offset classes are now handled via CSS :nth-child selectors
      // in _mel-lane-cards.scss for reliability across Views and contexts.
      // No need to set mel_lane_offset_class - CSS handles the pattern.

      // Category pill classes
      $pill_classes = 'mel-category-pill mel-category-pill--' . $category_slug . ' mel-category-pill--sm';
      $variables['mel_category_pill_classes'] = $pill_classes;
      $variables['mel_category_name'] = $category_label;
      $variables['mel_category_slug'] = $category_slug;

      // Badge text: FREE, price, or "Tickets" (internal; external omits).
      $variables['mel_card_badge_text'] = _myeventlane_theme_get_event_badge_text($node);

      $card_type = 'none';
      if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
        $et = $node->get('field_event_type')->value;
        if (in_array($et, ['rsvp', 'paid', 'both', 'external'], TRUE)) {
          $card_type = $et;
        }
      }
      $variables['card_type'] = $card_type;

      $state = (string) ($variables['mel_event_state'] ?? '');
      $cta_type = (string) ($variables['cta_type'] ?? 'none');
      $variables['card_status_primary'] = _myeventlane_theme_event_card_status_primary($node, $variables['mel_card_badge_text'], $state, $cta_type);
      $variables['card_status_secondary'] = NULL;
      if ($state === 'scheduled' && $cta_type === EventCtaResolver::CTA_PAID) {
        $ec_sched = $variables['event_cta'] ?? [];
        $variables['card_status_secondary'] = trim((string) ($ec_sched['label'] ?? ''));
      }
      $event_ui = is_array($variables['event_ui'] ?? NULL) ? $variables['event_ui'] : NULL;
      if ($event_ui !== NULL && $event_ui !== []) {
        if (empty($event_ui['show_cta'])) {
          $variables['card_cta_label'] = '';
        }
        else {
          $variables['card_cta_label'] = trim((string) ($event_ui['cta_label'] ?? ''));
        }
      }
      else {
        $ec = $variables['event_cta'] ?? [];
        $cta_label = trim((string) ($ec['label'] ?? ''));
        if ($state === 'scheduled' && $cta_type === EventCtaResolver::CTA_PAID) {
          $cta_label = (string) t('View details');
        }
        elseif (in_array($state, ['cancelled', 'ended'], TRUE)) {
          $cta_label = (string) t('View details');
        }
        elseif ($cta_label === '') {
          $cta_label = (string) t('View details');
        }
        $variables['card_cta_label'] = $cta_label;
      }

      $badge_for_modifier = $variables['mel_card_badge_text'];
      $variables['card_status_modifier'] = match (TRUE) {
        in_array($state, ['cancelled'], TRUE) => 'cancelled',
        $state === 'ended' => 'ended',
        $state === 'sold_out' => 'sold-out',
        $state === 'scheduled' && $cta_type === EventCtaResolver::CTA_PAID => 'scheduled',
        $card_type === 'external' => 'external',
        $badge_for_modifier === 'FREE' => 'free',
        is_string($badge_for_modifier) && str_starts_with($badge_for_modifier, '$') => 'paid',
        default => 'default',
      };

      $domain_state_for_badge = $variables['event_domain_state'] ?? NULL;
      if (is_array($domain_state_for_badge) && !empty($domain_state_for_badge['is_boosted'])) {
        $variables['is_promoted'] = TRUE;
      }
      else {
        $variables['is_promoted'] = $eventDomainStateResolver
          ? $eventDomainStateResolver->isEventBoosted($node)
          : ($node->hasField('field_promoted') && !$node->get('field_promoted')->isEmpty() && (bool) $node->get('field_promoted')->value);
      }

      // Poster cards: compact overlay pill (Free / Tickets / $$).
      $variables['mel_poster_price_pill'] = NULL;
      if ($view_mode === 'event_card_poster') {
        $pill = _myeventlane_theme_get_event_poster_price_pill($node);
        $variables['mel_poster_price_pill'] = match ($pill) {
          'Free' => (string) t('Free'),
          'Tickets' => (string) t('Tickets'),
          '$$' => '$$',
          default => NULL,
        };
      }

      // Card URL
      $variables['mel_card_url'] = $node->toUrl()->toString();

      // Date/time (when)
      $when_text = NULL;
      if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
        $start_value = $node->get('field_event_start')->value;
        if ($start_value) {
          $start_timestamp = strtotime($start_value);
          if ($start_timestamp) {
            // Format: "D j M, g:ia" e.g. "Sat 15 Mar, 7:00pm"
            $when_text = date('D j M, g:ia', $start_timestamp);
          }
        }
      }
      $variables['mel_card_when'] = $when_text;

      // Discovery cards: venue / locality only (no street dump).
      $variables['mel_card_where'] = _myeventlane_theme_event_card_location_label($node);

      // card_* variables for event-card and teaser templates (they use card_* not mel_*).
      $variables['card_url'] = $variables['mel_card_url'];
      $variables['card_title'] = $node->label();
      $variables['card_image_url'] = $variables['mel_card_image_url'];
      $variables['card_image_alt'] = $node->label();
      $variables['card_time_range'] = $when_text;
      $variables['card_location'] = $variables['mel_card_where'];
      $variables['card_price_label'] = $variables['mel_card_badge_text'] ?? '';

      if ($category_label !== NULL && $category_url !== NULL) {
        $variables['card_category'] = ['label' => $category_label, 'url' => $category_url];
      }
      else {
        $variables['card_category'] = NULL;
      }

      $card_day = NULL;
      $card_month = NULL;
      if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
        $start_value = $node->get('field_event_start')->value;
        if ($start_value && ($ts = strtotime($start_value))) {
          $card_day = (string) (int) date('j', $ts);
          $card_month = date('M', $ts);
        }
      }
      $variables['card_day'] = $card_day;
      $variables['card_month'] = $card_month;

      $variables['card_is_low_stock'] = FALSE;
      $variables['card_attendance'] = NULL;
      if (\Drupal::hasService('myeventlane_capacity.service')) {
        /** @var \Drupal\myeventlane_capacity\Service\EventCapacityServiceInterface $capacity */
        $capacity = \Drupal::service('myeventlane_capacity.service');
        $total_cap = $capacity->getCapacityTotal($node);
        $remaining = $capacity->getRemaining($node);
        if ($total_cap !== NULL && $remaining !== NULL && $remaining > 0) {
          $threshold = max(3, (int) floor($total_cap * 0.15));
          if ($remaining <= $threshold) {
            $variables['card_is_low_stock'] = TRUE;
          }
        }
      }
      if (\Drupal::hasService('myeventlane_domain_events.read_model.event_metrics')) {
        $read_model = \Drupal::service('myeventlane_domain_events.read_model.event_metrics');
        $metrics = $read_model->getEventMetrics((int) $node->id());
        $going = (int) ($metrics['tickets_sold'] ?? 0) + (int) ($metrics['rsvp_count'] ?? 0);
        if ($going >= 8) {
          $variables['card_attendance'] = $going;
        }
        if (!isset($variables['#cache']['tags'])) {
          $variables['#cache']['tags'] = [];
        }
        $variables['#cache']['tags'][] = sprintf('event_metrics:%d', (int) $node->id());
      }

      $event_flag = _myeventlane_theme_event_event_save_flag_link($node);
      $variables['event_flag_event_save'] = $event_flag;
      if ($event_flag) {
        if (!isset($variables['#cache']['contexts'])) {
          $variables['#cache']['contexts'] = [];
        }
        $variables['#cache']['contexts'][] = 'user';
      }

      // Add cache contexts/tags
      if (!isset($variables['#cache']['contexts'])) {
        $variables['#cache']['contexts'] = [];
      }
      $variables['#cache']['contexts'][] = 'route';
      if (!isset($variables['#cache']['tags'])) {
        $variables['#cache']['tags'] = [];
      }
      // Add taxonomy term cache tag if category exists
      if ($category_term ?? NULL) {
        $variables['#cache']['tags'][] = 'taxonomy_term:' . $category_term->id();
      }
    }

    if ($view_mode === 'full' && $node?->bundle() === 'event') {
      $variables['mel_event_selling_fast'] = FALSE;
      if (\Drupal::hasService('myeventlane_capacity.service')) {
        $capacity = \Drupal::service('myeventlane_capacity.service');
        $total_cap = $capacity->getCapacityTotal($node);
        $remaining = $capacity->getRemaining($node);
        if ($total_cap !== NULL && $remaining !== NULL && $remaining > 0) {
          $threshold = max(3, (int) floor($total_cap * 0.15));
          if ($remaining <= $threshold) {
            $variables['mel_event_selling_fast'] = TRUE;
          }
        }
      }
      $event_flag = _myeventlane_theme_event_event_save_flag_link($node);
      $variables['event_flag_event_save'] = $event_flag;
      if ($event_flag) {
        if (!isset($variables['#cache']['contexts'])) {
          $variables['#cache']['contexts'] = [];
        }
        $variables['#cache']['contexts'][] = 'user';
      }
    }
  }
}

/**
 * Single-line location for discovery cards (no street line fallback).
 *
 * Order: referenced venue entity label, field_venue_name, then locality (+ admin)
 * from field_location only.
 */
function _myeventlane_theme_event_card_location_label(NodeInterface $node): ?string {
  if ($node->bundle() !== 'event') {
    return NULL;
  }
  if ($node->hasField('field_venue') && !$node->get('field_venue')->isEmpty()) {
    $venue_entity = $node->get('field_venue')->entity;
    if ($venue_entity) {
      $name = trim((string) $venue_entity->label());
      if ($name !== '') {
        return $name;
      }
    }
  }
  if ($node->hasField('field_venue_name') && !$node->get('field_venue_name')->isEmpty()) {
    $name = trim((string) $node->get('field_venue_name')->value);
    if ($name !== '') {
      return $name;
    }
  }
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $location_item = $node->get('field_location')->first();
    if ($location_item) {
      $locality = $location_item->get('locality')->getValue();
      $administrative_area = $location_item->get('administrative_area')->getValue();
      if ($locality) {
        $where_text = $locality;
        if ($administrative_area) {
          $where_text .= ', ' . $administrative_area;
        }
        return $where_text;
      }
    }
  }
  return NULL;
}

/**
 * Primary status line for public event cards (price / availability), plain text.
 */
function _myeventlane_theme_event_card_status_primary(NodeInterface $node, ?string $badge_text, string $state, string $cta_type): ?string {
  if (in_array($state, ['cancelled'], TRUE)) {
    return (string) t('Cancelled');
  }
  if ($state === 'ended') {
    return (string) t('Ended');
  }
  if ($state === 'sold_out') {
    return (string) t('Sold out');
  }
  if ($state === 'scheduled' && $cta_type === EventCtaResolver::CTA_PAID) {
    return (string) t('On sale soon');
  }
  $event_type = NULL;
  if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
    $event_type = $node->get('field_event_type')->value;
  }
  if ($event_type === 'external') {
    return (string) t('External ticketing');
  }
  if ($badge_text === 'FREE') {
    return (string) t('Free · RSVP');
  }
  if (is_string($badge_text) && str_starts_with($badge_text, '$')) {
    return $badge_text;
  }
  if ($badge_text === 'Tickets') {
    return (string) t('Paid tickets');
  }
  return NULL;
}

/**
 * Helper function to compute event badge text from event type and price.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The event node.
 *
 * @return string|null
 *   Badge text: "FREE", "$XX.XX", "Tickets", or NULL.
 */
function _myeventlane_theme_get_event_badge_text(\Drupal\node\NodeInterface $node): ?string {
  if ($node->bundle() !== 'event') {
    return NULL;
  }

  $event_type = NULL;
  if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
    $event_type = $node->get('field_event_type')->value;
  }

  if ($event_type === 'external') {
    return NULL;
  }

  // RSVP or "both" with free price → "FREE"
  if ($event_type === 'rsvp') {
    return 'FREE';
  }

  // Check if product exists and get price
  $domain = \Drupal::hasService('myeventlane_core.event_state_resolver')
    ? \Drupal::service('myeventlane_core.event_state_resolver')
    : NULL;
  $product = NULL;
  if ($domain?->hasProductTarget($node)) {
    $product = $node->get('field_product_target')->entity;
  }

  if ($product) {
    $default_variation = $product->getDefaultVariation();
    if ($default_variation && $default_variation->hasField('price') && !$default_variation->get('price')->isEmpty()) {
      $price = $default_variation->getPrice();
      if ($price) {
        $price_number = $price->getNumber();
        // If price is 0 and event type is "both", still show FREE for clarity
        if ($price_number === '0' && ($event_type === 'both' || $event_type === 'rsvp')) {
          return 'FREE';
        }
        // If price > 0, format and return
        if ($price_number > 0) {
          return '$' . number_format($price_number, 2);
        }
      }
    }
  }

  // Paid or "both" without price info → "Tickets"
  if (in_array($event_type, ['paid', 'both'], TRUE)) {
    return 'Tickets';
  }

  return NULL;
}

/**
 * Short poster-card price label for image overlay (Free / Tickets / $$).
 *
 * Maps the same rules as _myeventlane_theme_get_event_badge_text() without
 * exposing exact dollar amounts on the grid.
 *
 * @param \Drupal\node\NodeInterface $node
 *   The event node.
 *
 * @return string|null
 *   One of: "Free", "Tickets", "$$", or NULL when no label applies.
 */
function _myeventlane_theme_get_event_poster_price_pill(\Drupal\node\NodeInterface $node): ?string {
  $badge = _myeventlane_theme_get_event_badge_text($node);
  if ($badge === NULL) {
    return NULL;
  }
  if ($badge === 'FREE') {
    return 'Free';
  }
  if ($badge === 'Tickets') {
    return 'Tickets';
  }
  if (is_string($badge) && str_starts_with($badge, '$')) {
    return '$$';
  }
  return NULL;
}

/**
 * Implements hook_preprocess_views_view_fields().
 *
 * Adds directory path for MyEventLane illustration system in views.
 * Sets mel_is_event_view flag and prepares variables for event card component.
 */
function myeventlane_theme_preprocess_views_view_fields(array &$variables): void {
  // Add theme directory path for image placeholders.
  if (!isset($variables['directory'])) {
    $extension_list = \Drupal::service('extension.list.theme');
    $theme_path = $extension_list->getPath('myeventlane_theme');
    $base_path = base_path();
    $variables['directory'] = $base_path . $theme_path;
  }

  // Detect if this is an event view by checking view ID and fields
  $view = $variables['view'] ?? NULL;
  $is_event_view = FALSE;
  if ($view) {
    $view_id = $view->id();
    // Check if view ID contains "event" or if fields contain event-specific fields
    if (strpos($view_id, 'event') !== FALSE) {
      $is_event_view = TRUE;
    }
    // Also check if fields contain event-specific field names
    elseif (isset($variables['fields'])) {
      $field_keys = array_keys($variables['fields']);
      $event_fields = ['field_event', 'field_category', 'field_event_start', 'field_venue_name'];
      foreach ($event_fields as $event_field) {
        if (in_array($event_field, $field_keys, TRUE)) {
          $is_event_view = TRUE;
          break;
        }
      }
    }
  }
  $variables['mel_is_event_view'] = $is_event_view;
}

/**
 * Implements hook_preprocess_taxonomy_term().
 *
 * Adds MyEventLane illustration system variables for category terms.
 * Computes category banner URL using file_url_generator and checks file existence.
 * Adds all categories with slugs for header pills.
 */
function myeventlane_theme_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'];
  
  // Only process category terms.
  if ($term && $term->bundle() === 'categories') {
    // Get category slug from field_mel_slug.
    $category_slug = NULL;
    if ($term->hasField('field_mel_slug') && !$term->get('field_mel_slug')->isEmpty()) {
      $slug_value = $term->get('field_mel_slug')->value;
      if (!empty($slug_value)) {
        $category_slug = $slug_value;
      }
    }
    
    $variables['mel_category_slug'] = $category_slug;
    
    // Banner URL: prefer term's field_category_image (uploaded in term edit form).
    $banner_url = NULL;
    if ($term->hasField('field_category_image') && !$term->get('field_category_image')->isEmpty()) {
      $term_files = $term->get('field_category_image')->referencedEntities();
      $file = !empty($term_files) ? reset($term_files) : NULL;
      if ($file) {
        $file_url_generator = \Drupal::service('file_url_generator');
        $banner_url = $file_url_generator->generateAbsoluteString($file->getFileUri());
      }
    }
    // Fallback: Page Visuals Manager (route entity.taxonomy_term.canonical or view.upcoming_events.page_category).
    if (!$banner_url && \Drupal::hasService('myeventlane.page_visual_resolver')) {
      $resolver = \Drupal::service('myeventlane.page_visual_resolver');
      $page_visual = $resolver->resolveForRoute(\Drupal::routeMatch());
      if ($page_visual !== NULL && !empty($page_visual['image_url'])) {
        $banner_url = $page_visual['image_url'];
        $variables['mel_hero_image_url_mobile'] = $page_visual['image_url_mobile'] ?? NULL;
        $variables['mel_hero_hide_on_mobile'] = $page_visual['hide_on_mobile'] ?? FALSE;
      }
    }
    // Fallback: theme file images/mel/categories/mel-category-{slug}.png
    if (!$banner_url && $category_slug) {
      $extension_list = \Drupal::service('extension.list.theme');
      $theme_path = $extension_list->getPath('myeventlane_theme');
      $slug_map = ['lgbtqi' => 'lgbtqia', 'food-drink' => 'food'];
      $file_slug = $slug_map[$category_slug] ?? $category_slug;
      $banner_relative_path = $theme_path . '/images/mel/categories/mel-category-' . $file_slug . '.png';
      if (file_exists(DRUPAL_ROOT . '/' . $banner_relative_path)) {
        $banner_url = base_path() . $banner_relative_path;
      }
    }
    
    $variables['mel_category_banner_url'] = $banner_url;
    $variables['mel_hero_image_url'] = $banner_url;
    if (empty($variables['mel_hero_image_url_mobile'])) {
      $variables['mel_hero_image_url_mobile'] = NULL;
    }
    if (!isset($variables['mel_hero_hide_on_mobile'])) {
      $variables['mel_hero_hide_on_mobile'] = FALSE;
    }
    
    // Load all categories with slugs for header pills.
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $all_terms = $term_storage->loadByProperties(['vid' => 'categories']);
    
    $categories = [];
    foreach ($all_terms as $cat_term) {
      $slug = _myeventlane_theme_get_category_slug($cat_term);
      $categories[] = [
        'tid' => $cat_term->id(),
        'name' => $cat_term->label(),
        'label' => $cat_term->label(),
        'url' => Url::fromRoute('view.upcoming_events.page_category', ['arg_0' => $cat_term->id()])->toString(),
        'slug' => $slug,
      ];
    }
    
    $variables['mel_header_categories'] = $categories;
    // Same term as the page: highlight this category in mel-page-header (term template scope).
    $variables['mel_active_category_tid'] = (string) $term->id();
  }
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Injects category banner into views headers on taxonomy term pages.
 */
function myeventlane_theme_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];

  // Ensure directory is available for empty state images.
  if (!isset($variables['directory'])) {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
    $variables['directory'] = base_path() . $theme_path;
  }

  if (
    $view->id() === 'upcoming_events'
    && in_array($view->current_display, ['page_category', 'page_today', 'page_this_weekend', 'page_free'], TRUE)
  ) {
    $args = $view->args ?? [];
    if ($view->current_display === 'page_category' && !empty($args[0])) {
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($args[0]);
      if ($term instanceof TermInterface) {
        $variables['mel_browse_category_name'] = $term->label();
        $variables['term'] = $term;
      }
    }
    $variables['mel_chip_listing_fragment'] = (bool) \Drupal::request()->attributes->get('mel_chip_listing_fragment');
  }

  if ($view->id() === 'upcoming_events' && in_array($view->current_display, ['page_events', 'page_category', 'page_today', 'page_this_weekend', 'page_free'], TRUE)) {
    $request = \Drupal::request();
    $query_all = $request->query->all();
    $active = FALSE;
    foreach (['category', 'search', 'event_type', 'accessibility'] as $key) {
      if (!array_key_exists($key, $query_all)) {
        continue;
      }
      $val = $query_all[$key];
      if (is_array($val)) {
        $filtered = array_filter($val, static function ($item): bool {
          return $item !== NULL && $item !== '';
        });
        if ($filtered !== []) {
          $active = TRUE;
          break;
        }
      }
      elseif ($val !== NULL && $val !== '') {
        $active = TRUE;
        break;
      }
    }
    $variables['mel_browse_active_filters'] = $active;
    $total = $view->total_rows;
    if ($total === NULL) {
      $result = $view->result ?? [];
      $total = is_countable($result) ? count($result) : 0;
    }
    $variables['mel_browse_result_count'] = (int) $total;
  }

  // Only process views on taxonomy term pages.
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  
  if ($route_name === 'entity.taxonomy_term.canonical') {
    // Get the taxonomy term from route.
    $term = $route_match->getParameter('taxonomy_term');
    
    if ($term && $term->bundle() === 'categories') {
      // Get category slug from field_mel_slug.
      $category_slug = NULL;
      if ($term->hasField('field_mel_slug') && !$term->get('field_mel_slug')->isEmpty()) {
        $slug_value = $term->get('field_mel_slug')->value;
        if (!empty($slug_value)) {
          $category_slug = $slug_value;
        }
      }
      
      $variables['mel_category_slug'] = $category_slug;
      
      // Build banner URL if slug exists and file exists.
      $banner_url = NULL;
      if ($category_slug) {
        $extension_list = \Drupal::service('extension.list.theme');
        $theme_path = $extension_list->getPath('myeventlane_theme');
        $banner_relative_path = $theme_path . '/images/mel/categories/mel-category-' . $category_slug . '.png';
        $banner_file_path = DRUPAL_ROOT . '/' . $banner_relative_path;
        
        // Check if file exists before generating URL.
        if (file_exists($banner_file_path)) {
          // For theme files, construct URL manually (not file entities, so can't use file_url_generator).
          $banner_url = base_path() . $banner_relative_path;
        }
      }
      
      $variables['mel_category_banner_url'] = $banner_url;
    }
  }
}

/**
 * Implements hook_preprocess_views_exposed_form().
 *
 * Supplies the hero title for the MEL Help Search exposed form layout.
 */
function myeventlane_theme_preprocess_views_exposed_form(array &$variables): void {
  $form = $variables['form'];
  $expected_id = Html::cleanCssIdentifier('views_exposed_form-mel_help_search-block_search');
  if (($form['#id'] ?? '') === $expected_id) {
    $variables['mel_help_search_page_title'] = _myeventlane_theme_mel_help_search_page_title();
  }
}

/**
 * Returns the main heading for the mel_help_search view (search vs category).
 */
function _myeventlane_theme_mel_help_search_page_title(): string {
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  if ($route_name === 'myeventlane_help_centre.search') {
    return (string) t('Search help');
  }
  if ($route_name === 'myeventlane_help_centre.category_index') {
    $category = $route_match->getParameter('category');
    if ($category instanceof TermInterface) {
      return $category->label();
    }
  }
  return (string) t('Help');
}

/**
 * Venue name line for event full hero (entity reference, then free-text name).
 *
 * Does not fall back to address/locality so the hero stays a venue title, not a
 * geo summary (the meta card handles full location).
 */
function _myeventlane_theme_event_hero_venue_name(NodeInterface $node): ?string {
  if ($node->bundle() !== 'event') {
    return NULL;
  }
  if ($node->hasField('field_venue') && !$node->get('field_venue')->isEmpty()) {
    $venue_entity = $node->get('field_venue')->entity;
    if ($venue_entity) {
      $name = trim((string) $venue_entity->label());
      if ($name !== '') {
        return $name;
      }
    }
  }
  if ($node->hasField('field_venue_name') && !$node->get('field_venue_name')->isEmpty()) {
    $name = trim((string) $node->get('field_venue_name')->value);
    return $name !== '' ? $name : NULL;
  }
  return NULL;
}

/**
 * Resolved public state label for the event full hero overlay.
 *
 * Uses the same resolved state as listings (@see myeventlane_event_preprocess_node).
 */
function _myeventlane_theme_event_hero_status_public(string $state): ?TranslatableMarkup {
  return match ($state) {
    'ended' => new TranslatableMarkup('Ended'),
    'cancelled' => new TranslatableMarkup('Cancelled'),
    'sold_out' => new TranslatableMarkup('Sold out'),
    'archived' => new TranslatableMarkup('Archived'),
    default => NULL,
  };
}

/**
 * Single-line primary location label for event cards and summaries.
 *
 * Order: referenced venue entity label, field_venue_name, then locality (or line1)
 * from field_location.
 */
function _myeventlane_theme_event_primary_location_label(NodeInterface $node): ?string {
  if ($node->bundle() !== 'event') {
    return NULL;
  }
  if ($node->hasField('field_venue') && !$node->get('field_venue')->isEmpty()) {
    $venue_entity = $node->get('field_venue')->entity;
    if ($venue_entity) {
      $name = trim((string) $venue_entity->label());
      if ($name !== '') {
        return $name;
      }
    }
  }
  if ($node->hasField('field_venue_name') && !$node->get('field_venue_name')->isEmpty()) {
    $name = trim((string) $node->get('field_venue_name')->value);
    if ($name !== '') {
      return $name;
    }
  }
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $location_item = $node->get('field_location')->first();
    if ($location_item) {
      $locality = $location_item->get('locality')->getValue();
      $administrative_area = $location_item->get('administrative_area')->getValue();
      if ($locality) {
        $where_text = $locality;
        if ($administrative_area) {
          $where_text .= ', ' . $administrative_area;
        }
        return $where_text;
      }
      $line1 = $location_item->get('address_line1')->getValue();
      if ($line1) {
        return trim((string) $line1);
      }
    }
  }
  return NULL;
}

/**
 * Helper function to get category slug from taxonomy term.
 *
 * @param \Drupal\taxonomy\TermInterface|null $term
 *   The taxonomy term entity, or NULL.
 *
 * @return string
 *   The category slug (from field_mel_slug or sanitized term name), or 'default'.
 *   Normalizes lgbtqi+ variants to 'lgbtqia'.
 */
function _myeventlane_theme_get_category_slug(?TermInterface $term): string {
  if (!$term || $term->bundle() !== 'categories') {
    return 'default';
  }
  
  // First priority: field_mel_slug (preferred).
  $slug = 'default';
  if ($term->hasField('field_mel_slug') && !$term->get('field_mel_slug')->isEmpty()) {
    $slug_value = $term->get('field_mel_slug')->value;
    if (!empty($slug_value)) {
      $slug = trim(strtolower($slug_value));
    }
  }
  else {
    // Fallback: sanitize term name.
    $name = $term->label();
    $slug = strtolower($name);
    // Replace & with "and", replace non-alphanumeric with hyphen
    $slug = str_replace('&', 'and', $slug);
    $slug = preg_replace('/[^a-z0-9]+/', '-', $slug);
    $slug = trim($slug, '-');
  }
  
  // Normalize lgbtqi+ variants to lgbtqia
  if (in_array($slug, ['lgbtqi', 'lgbtq', 'lgbtqi+', 'lgbtqia+', 'lgbtq+'], TRUE)) {
    $slug = 'lgbtqia';
  }
  
  return !empty($slug) ? $slug : 'default';
}

/**
 * Returns hero image URL for listing pages (category, search, events).
 *
 * @param string|null $route
 *   The current route name.
 *
 * @return string|null
 *   Absolute URL to hero image, or NULL if none.
 */
function _myeventlane_theme_get_listing_hero_url(?string $route): ?string {
  $extension_list = \Drupal::service('extension.list.theme');
  $theme_path = $extension_list->getPath('myeventlane_theme');
  $base_path = base_path();

  // Category page: prefer term's field_category_image, else theme file.
  if ($route === 'view.upcoming_events.page_category') {
    $tid = \Drupal::routeMatch()->getParameter('arg_0');
    if ($tid) {
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
      if ($term && $term->bundle() === 'categories') {
        if ($term->hasField('field_category_image') && !$term->get('field_category_image')->isEmpty()) {
          $cat_files = $term->get('field_category_image')->referencedEntities();
          $file = !empty($cat_files) ? reset($cat_files) : NULL;
          if ($file) {
            $file_url_generator = \Drupal::service('file_url_generator');
            return $file_url_generator->generateAbsoluteString($file->getFileUri());
          }
        }
        $slug = _myeventlane_theme_get_category_slug($term);
        $slug_map = ['lgbtqi' => 'lgbtqia', 'food-drink' => 'food'];
        $file_slug = $slug_map[$slug] ?? $slug;
        $rel = $theme_path . '/images/mel/categories/mel-category-' . $file_slug . '.png';
        if (file_exists(DRUPAL_ROOT . '/' . $rel)) {
          return $base_path . $rel;
        }
      }
    }
  }

  // Search page: images/mel/hero/mel-hero-search.png
  if ($route === 'mel_search.view') {
    $rel = $theme_path . '/images/mel/hero/mel-hero-search.png';
    if (file_exists(DRUPAL_ROOT . '/' . $rel)) {
      return $base_path . $rel;
    }
  }

  // Events page: images/mel/hero/mel-hero-events.png
  if ($route === 'view.upcoming_events.page_events') {
    $rel = $theme_path . '/images/mel/hero/mel-hero-events.png';
    if (file_exists(DRUPAL_ROOT . '/' . $rel)) {
      return $base_path . $rel;
    }
  }

  // Taxonomy term canonical: prefer term's field_category_image, else theme file.
  if ($route === 'entity.taxonomy_term.canonical') {
    $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
    if ($term && $term->bundle() === 'categories') {
      if ($term->hasField('field_category_image') && !$term->get('field_category_image')->isEmpty()) {
        $canon_files = $term->get('field_category_image')->referencedEntities();
        $file = !empty($canon_files) ? reset($canon_files) : NULL;
        if ($file) {
          $file_url_generator = \Drupal::service('file_url_generator');
          return $file_url_generator->generateAbsoluteString($file->getFileUri());
        }
      }
      $slug = _myeventlane_theme_get_category_slug($term);
      $slug_map = ['lgbtqi' => 'lgbtqia', 'food-drink' => 'food'];
      $file_slug = $slug_map[$slug] ?? $slug;
      $rel = $theme_path . '/images/mel/categories/mel-category-' . $file_slug . '.png';
      if (file_exists(DRUPAL_ROOT . '/' . $rel)) {
        return $base_path . $rel;
      }
    }
  }

  return NULL;
}

/**
 * Implements hook_preprocess_myeventlane_search_results().
 */
function myeventlane_theme_preprocess_myeventlane_search_results(array &$variables): void {
  if (!isset($variables['directory'])) {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
    $variables['directory'] = base_path() . $theme_path;
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_category_pills theme.
 *
 * Adds category slugs to category pills block template variables.
 */
function myeventlane_theme_preprocess_myeventlane_category_pills(array &$variables): void {
  $categories = $variables['categories'] ?? [];
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  
  // Add slug to each category item.
  foreach ($categories as $key => $category) {
    $tid = $category['tid'] ?? NULL;
    if ($tid) {
      $term = $term_storage->load($tid);
      if ($term instanceof TermInterface) {
        $slug = _myeventlane_theme_get_category_slug($term);
        $variables['categories'][$key]['slug'] = $slug;
      }
      else {
        $variables['categories'][$key]['slug'] = 'default';
      }
    }
    else {
      $variables['categories'][$key]['slug'] = 'default';
    }
  }
}

/**
 * Implements hook_preprocess_user().
 *
 * Adds classes and context for user forms (login, register, password, edit).
 */
function myeventlane_theme_preprocess_user(array &$variables): void {
  $user = $variables['user'];
  $view_mode = $variables['view_mode'] ?? 'full';

  if ($view_mode === 'register') {
    $variables['mel_register_create_event_context'] = FALSE;
    if (\Drupal::moduleHandler()->moduleExists('myeventlane_auth')) {
      $variables['mel_register_create_event_context'] = myeventlane_auth_register_page_is_create_event_flow(\Drupal::request());
    }
    $variables['#cache']['contexts'][] = 'url.query_args:destination';
    $variables['#cache']['contexts'][] = 'url.query_args:mel_intent';
    $variables['#cache']['contexts'][] = 'url.query_args:intent';
    $variables['attributes']['class'][] = 'mel-user-form';
    $variables['attributes']['class'][] = 'mel-user-form--register';
    return;
  }

  // Only process form view modes.
  if ($view_mode !== 'form' && $view_mode !== 'default') {
    return;
  }

  $variables['attributes']['class'][] = 'mel-user-form';
}

/**
 * Implements hook_preprocess_entity().
 *
 * Adds classes and context for vendor entity forms.
 */
function myeventlane_theme_preprocess_entity(array &$variables): void {
  $entity = $variables['entity'];
  $view_mode = $variables['view_mode'] ?? 'full';

  // Only process form view modes.
  if ($view_mode !== 'form' && $view_mode !== 'default') {
    return;
  }

  // Check if this is a vendor entity form.
  if ($entity && $entity->getEntityTypeId() === 'myeventlane_vendor') {
    $variables['attributes']['class'][] = 'mel-entity-form';
    $variables['attributes']['class'][] = 'mel-entity-form--vendor';
  }
}

/**
 * Implements hook_form_alter().
 *
 * Adds classes and ensures proper styling for public-facing forms.
 */
function myeventlane_theme_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  // Only apply to front-end theme, not admin theme.
  $theme = \Drupal::theme()->getActiveTheme()->getName();
  if ($theme !== 'myeventlane_theme') {
    return;
  }

  // Checkout: sidebar panes skip commerce_checkout_pane theme; add shell class
  // so governed SCSS applies (presentation only, no pane logic changes).
  if (str_starts_with($form_id, 'commerce_checkout_flow_') && isset($form['sidebar']) && is_array($form['sidebar'])) {
    foreach (Element::children($form['sidebar']) as $key) {
      if (!isset($form['sidebar'][$key]['#attributes']['class'])) {
        $form['sidebar'][$key]['#attributes']['class'] = [];
      }
      elseif (!is_array($form['sidebar'][$key]['#attributes']['class'])) {
        $form['sidebar'][$key]['#attributes']['class'] = [$form['sidebar'][$key]['#attributes']['class']];
      }
      $form['sidebar'][$key]['#attributes']['class'][] = 'mel-checkout-pane-shell';
    }
  }

  // Checkout: grand total above primary submit — lives in $form['actions'] so it rebuilds with AJAX.
  if (str_starts_with($form_id, 'commerce_checkout_flow_')
    && isset($form['actions'])
    && (($form['#step_id'] ?? '') !== 'complete')
    && !isset($form['actions']['mel_cta_total'])) {
    $order = _myeventlane_theme_commerce_order_from_route();
    if ($order instanceof OrderInterface) {
      /** @var \Drupal\commerce_order\OrderTotalSummaryInterface $order_total_summary */
      $order_total_summary = \Drupal::service('commerce_order.order_total_summary');
      $totals_build = $order_total_summary->buildTotals($order);
      $summary_total = $totals_build['total'] ?? NULL;
      if ($summary_total !== NULL) {
        /** @var \Drupal\commerce_price\CurrencyFormatter $currency_formatter */
        $currency_formatter = \Drupal::service('commerce_price.currency_formatter');
        $formatted_total = $currency_formatter->format(
          $summary_total->getNumber(),
          $summary_total->getCurrencyCode()
        );
        $label = $summary_total->isZero() ? t('Total') : t("You'll pay");
        $form['actions']['mel_cta_total'] = [
          '#type' => 'inline_template',
          '#template' => '<div id="mel-checkout-total-wrapper" class="mel-checkout-total-inline mel-checkout-cta__total" aria-live="polite"><span class="mel-checkout-total-inline__label mel-checkout-cta__total-label">{{ label }}</span><span class="mel-checkout-total-inline__value mel-checkout-cta__total-value">{{ total }}</span></div>',
          '#context' => [
            'label' => $label,
            'total' => $formatted_total,
          ],
          '#weight' => -45,
        ];
        $form['actions']['mel_cta_total']['#cache']['tags'] = $order->getCacheTags();
        $form['actions']['mel_cta_total']['#cache']['contexts'] = $order->getCacheContexts();
      }
    }
  }

  // Event node forms.
  if (in_array($form_id, ['node_event_form', 'node_event_edit_form'])) {
    $form['#attributes']['class'][] = 'mel-form';
    $form['#attributes']['class'][] = 'mel-form--event';
    
    // Ensure Drupal's form behaviors are attached for #states API
    $form['#attached']['library'][] = 'core/drupal.form';
    $form['#attached']['library'][] = 'core/drupal.states';
    
    // Attach Conditional Fields library if module is enabled
    // This ensures conditional fields work for both admin and vendor forms
    if (\Drupal::moduleHandler()->moduleExists('conditional_fields')) {
      $form['#attached']['library'][] = 'conditional_fields/conditional_fields';
    }
    
    // Attach custom event form enhancements
    $form['#attached']['library'][] = 'myeventlane_theme/event-form';
    
    // Disable Honeypot flood control for event forms (vendors need to save drafts)
    if (isset($form['#attributes']['data-honeypot-time'])) {
      unset($form['#attributes']['data-honeypot-time']);
    }
    
    // Add form token to prevent duplicate submissions without flood control
    if (!isset($form['form_token'])) {
      $form['form_token'] = [
        '#type' => 'token',
        '#default_value' => \Drupal::csrfToken()->get('node_event_form'),
      ];
    }
    
    // Wrap the entire form in our styled container
    // IMPORTANT: Only wrap the form, don't modify field structure to preserve #states API
    $is_edit = ($form_id === 'node_event_edit_form');
    $title = $is_edit ? t('Edit Event') : t('Create New Event');
    $intro = $is_edit 
      ? t('Update your event details below. Changes will be saved when you submit the form.')
      : t('Share your event with the MyEventLane community. Fill out each section below to get started.');
    
    // Get node if editing
    $node = NULL;
    if (isset($form['#entity']) && $form['#entity']) {
      $node = $form['#entity'];
    } elseif ($form_state->getFormObject() && method_exists($form_state->getFormObject(), 'getEntity')) {
      $node = $form_state->getFormObject()->getEntity();
    }
    
    $breadcrumb = '';
    if ($is_edit && $node && !$node->isNew()) {
      $url = $node->toUrl()->toString();
      $breadcrumb = '<nav class="mel-breadcrumb" aria-label="Breadcrumb"><a href="' . $url . '">' . $node->label() . '</a><span class="mel-breadcrumb-separator">/</span><span>Edit</span></nav>';
    }
    
    // Wrap form with styling - this doesn't break #states API as it's outside the form structure
    $form['#prefix'] = '<div class="mel-page-wrapper mel-page-wrapper--form"><div class="mel-container mel-container--form"><div class="mel-form-page-header">' . $breadcrumb . '<h1 class="mel-page-title">' . $title . '</h1><p class="mel-page-intro">' . $intro . '</p></div>';
    $form['#suffix'] = '</div></div>';
    
    // Add wrapper class to form itself
    $form['#attributes']['class'][] = 'mel-event-form-wrapper';
  }

  // User register form.
  if ($form_id === 'user_register_form') {
    $form['#attributes']['class'][] = 'mel-form';
    $form['#attributes']['class'][] = 'mel-form--register';
    $form['#attributes']['class'][] = 'user-register-form';
    $form['#attached']['library'][] = 'myeventlane_theme/auth_pages';
    if (isset($form['actions']['submit'])) {
      if (!isset($form['actions']['submit']['#attributes']['class'])) {
        $form['actions']['submit']['#attributes']['class'] = [];
      }
      elseif (!is_array($form['actions']['submit']['#attributes']['class'])) {
        $form['actions']['submit']['#attributes']['class'] = [$form['actions']['submit']['#attributes']['class']];
      }
      foreach (['mel-btn', 'mel-btn-primary', 'mel-auth-submit'] as $class) {
        $form['actions']['submit']['#attributes']['class'][] = $class;
      }
    }
  }

  // User password reset form.
  if ($form_id === 'user_pass') {
    $form['#attributes']['class'][] = 'mel-form';
    $form['#attributes']['class'][] = 'mel-form--password';
    $form['#attached']['library'][] = 'myeventlane_theme/auth_pages';
  }

  // User edit form.
  if ($form_id === 'user_form') {
    $form['#attributes']['class'][] = 'mel-form';
    $form['#attributes']['class'][] = 'mel-form--user-edit';
    $pass_reset = \Drupal::request()->query->get('pass-reset-token');
    if (is_string($pass_reset) && $pass_reset !== '') {
      $form['#attached']['library'][] = 'myeventlane_theme/auth_pages';
    }
  }

  // Vendor entity forms.
  if (strpos($form_id, 'myeventlane_vendor') === 0) {
    $form['#attributes']['class'][] = 'mel-form';
    $form['#attributes']['class'][] = 'mel-form--vendor';
  }

  // Contact module (entity message forms on /contact): MEL buttons + message UX.
  if (str_starts_with($form_id, 'contact_message_')) {
    if (isset($form['message']) && is_array($form['message'])) {
      if (!isset($form['message']['#attributes']) || !is_array($form['message']['#attributes'])) {
        $form['message']['#attributes'] = [];
      }
      $attrs = &$form['message']['#attributes'];
      if (!isset($attrs['class'])) {
        $attrs['class'] = [];
      }
      elseif (!is_array($attrs['class'])) {
        $attrs['class'] = [$attrs['class']];
      }
      $attrs['class'][] = 'mel-textarea';
      if (empty($attrs['placeholder'])) {
        $attrs['placeholder'] = (string) t('Include your event name, what you expected, and any error text or screenshots if relevant…');
      }
    }
    foreach (['submit' => ['mel-btn', 'mel-btn-primary', 'mel-btn--contact-coral'], 'preview' => ['mel-btn', 'mel-btn-secondary', 'mel-btn--contact-preview']] as $key => $classes) {
      if (!isset($form['actions'][$key]) || !is_array($form['actions'][$key])) {
        continue;
      }
      $el = &$form['actions'][$key];
      if (!isset($el['#attributes']) || !is_array($el['#attributes'])) {
        $el['#attributes'] = [];
      }
      if (!isset($el['#attributes']['class'])) {
        $el['#attributes']['class'] = [];
      }
      elseif (!is_array($el['#attributes']['class'])) {
        $el['#attributes']['class'] = [$el['#attributes']['class']];
      }
      foreach ($classes as $class) {
        $el['#attributes']['class'][] = $class;
      }
    }
  }
}

/**
 * Preprocess variables for event nodes only.
 */
/**
 * Preprocess event nodes to resolve hero image safely.
 */
function myeventlane_theme_preprocess_node__event(array &$variables): void {
  $node = $variables['node'] ?? NULL;

  if (!$node instanceof NodeInterface) {
    return;
  }

  $file_url_generator = \Drupal::service('file_url_generator');
  $image_url = NULL;

  // 1. Event image field.
  if ($node->hasField('field_event_image') && !$node->get('field_event_image')->isEmpty()) {
    $files = $node->get('field_event_image')->referencedEntities();
    $file = !empty($files) ? reset($files) : NULL;
    if ($file instanceof File) {
      $image_url = $file_url_generator->generateAbsoluteString($file->getFileUri());
    }
  }

  // 2. Category fallback (taxonomy image).
  if (!$image_url && $node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $category_field = $node->get('field_category');
    $referenced_entities = $category_field->referencedEntities();
    if (!empty($referenced_entities)) {
      $term = reset($referenced_entities);
      if ($term && $term->hasField('field_category_image') && !$term->get('field_category_image')->isEmpty()) {
        $category_files = $term->get('field_category_image')->referencedEntities();
        $file = !empty($category_files) ? reset($category_files) : NULL;
        if ($file instanceof File) {
          $image_url = $file_url_generator->generateAbsoluteString($file->getFileUri());
        }
      }
    }
  }

  // 3. Hard fallback only when placeholder file exists (use base_path for subdir installs).
  if (!$image_url) {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
    foreach (['mel-placeholder-default.png', 'mel-placeholder-default.svg'] as $f) {
      $fallback_rel = $theme_path . '/images/mel/placeholders/' . $f;
      $fallback_path = DRUPAL_ROOT . '/' . $fallback_rel;
      if (file_exists($fallback_path)) {
        $image_url = base_path() . $fallback_rel;
        break;
      }
    }
  }

  $variables['image_src'] = $image_url;
  $variables['mel_has_hero_image'] = (bool) $image_url;

  // Location: primary label = venue entity, then field_venue_name, then field_location summary.
  $variables['mel_venue'] = _myeventlane_theme_event_primary_location_label($node);

  // Address: use getValue() array so locality/address_line1 are reliable.
  $address_parts = [];
  $variables['mel_suburb'] = NULL;
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $loc = $node->get('field_location')->first();
    if ($loc && method_exists($loc, 'getValue')) {
      $raw = $loc->getValue();
      if (is_array($raw)) {
        $order = ['address_line1', 'address_line2', 'locality', 'administrative_area', 'postal_code', 'country_code'];
        foreach ($order as $key) {
          if (!empty($raw[$key]) && trim((string) $raw[$key]) !== '') {
            $address_parts[] = trim((string) $raw[$key]);
            if ($key === 'locality') {
              $variables['mel_suburb'] = trim((string) $raw[$key]);
            }
          }
        }
        // Fallback: if no ordered parts, use any non-empty address key so we never drop data.
        if (empty($address_parts)) {
          $address_keys = [
            'address_line1', 'address_line2', 'locality', 'dependent_locality',
            'administrative_area', 'postal_code', 'sorting_code', 'organization',
          ];
          foreach ($address_keys as $key) {
            if (!empty($raw[$key]) && trim((string) $raw[$key]) !== '') {
              $address_parts[] = trim((string) $raw[$key]);
              if ($key === 'locality') {
                $variables['mel_suburb'] = trim((string) $raw[$key]);
              }
            }
          }
        }
      }
    }
  }
  $variables['mel_address'] = !empty($address_parts) ? implode(', ', $address_parts) : NULL;

  // Category label/slug for hero badge and Event Info card (first category term).
  $variables['mel_category_label'] = NULL;
  $variables['mel_category_slug'] = 'default';
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $refs = $node->get('field_category')->referencedEntities();
    if (!empty($refs)) {
      $term = reset($refs);
      if ($term instanceof \Drupal\taxonomy\Entity\Term) {
        $variables['mel_category_label'] = $term->label();
        $variables['mel_category_slug'] = function_exists('_myeventlane_theme_get_category_slug')
          ? _myeventlane_theme_get_category_slug($term)
          : str_replace([' ', '&', '+'], ['-', 'and', ''], strtolower($term->label()));
      }
    }
  }

  // Refund policy label (render-only variable; keep mapping out of Twig).
  $variables['mel_refund_policy_text'] = NULL;
  if ($node->hasField('field_refund_policy') && !$node->get('field_refund_policy')->isEmpty()) {
    $refund_key = (string) $node->get('field_refund_policy')->value;
    $refund_map = [
      'none_specified' => new TranslatableMarkup('No specified policy on refunds'),
      '1_day' => new TranslatableMarkup('Refunds are available up to 1 day prior to the event'),
      '7_days' => new TranslatableMarkup('Refunds are available up to 7 days prior to the event'),
      '14_days' => new TranslatableMarkup('Refunds are available up to 14 days prior to the event'),
      '30_days' => new TranslatableMarkup('Refunds are available up to 30 days prior to the event'),
      'no_refunds' => new TranslatableMarkup('No refunds'),
    ];
    $variables['mel_refund_policy_text'] = $refund_map[$refund_key] ?? NULL;
  }

  // Age policy (render-only variables; keep mapping out of Twig).
  $variables['mel_age_policy_key'] = NULL;
  $variables['mel_age_policy_label'] = NULL;
  $variables['mel_age_policy_note'] = NULL;
  if ($node->hasField('field_age_policy') && !$node->get('field_age_policy')->isEmpty()) {
    $age_key = (string) $node->get('field_age_policy')->value;
    $variables['mel_age_policy_key'] = $age_key;
    $age_map = [
      'all_ages' => new TranslatableMarkup('All ages'),
      '18_plus' => new TranslatableMarkup('18+'),
      '16_plus' => new TranslatableMarkup('16+'),
      'under_18_with_guardian' => new TranslatableMarkup('Under 18 with a guardian'),
      'custom' => new TranslatableMarkup('See details'),
    ];
    $variables['mel_age_policy_label'] = $age_map[$age_key] ?? NULL;

    if ($node->hasField('field_age_policy_note') && !$node->get('field_age_policy_note')->isEmpty()) {
      $note = (string) $node->get('field_age_policy_note')->value;
      $variables['mel_age_policy_note'] = $note !== '' ? $note : NULL;
    }
  }

  // Canonical geo resolution (single point): mel_lat, mel_lng, mel_geo_source.
  /** @var \Drupal\myeventlane_event\Service\EventGeoResolver $geo_resolver */
  $geo_resolver = \Drupal::service('myeventlane_event.geo_resolver');
  $geo = $geo_resolver->resolve($node);

  $variables['mel_lat'] = $geo['lat'] ?? NULL;
  $variables['mel_lng'] = $geo['lng'] ?? NULL;
  $variables['mel_geo_source'] = $geo['source'] ?? 'none';

  // Ensure map JS has canonical coords available via drupalSettings.
  // Provider settings are attached by myeventlane_location; we only ensure event coords are correct.
  $variables['#attached']['drupalSettings']['myeventlaneLocationEvent'] = [
    'latitude' => $variables['mel_lat'],
    'longitude' => $variables['mel_lng'],
    'title' => $node->label(),
  ];

  // Public organiser trust data for Event Full (field_event_vendor → myeventlane_vendor).
  $variables['mel_organiser'] = NULL;
  if ($node->hasField('field_event_vendor') && !$node->get('field_event_vendor')->isEmpty()) {
    $vendor = $node->get('field_event_vendor')->entity;
    if ($vendor && $vendor->getEntityTypeId() === 'myeventlane_vendor') {
      $organiser = [
        'name' => $vendor->label(),
        'url' => NULL,
        'logo_url' => NULL,
        'tagline' => NULL,
      ];
      if ($vendor->hasField('field_tagline') && !$vendor->get('field_tagline')->isEmpty()) {
        $tag = trim((string) $vendor->get('field_tagline')->value);
        $organiser['tagline'] = $tag !== '' ? $tag : NULL;
      }
      elseif ($vendor->hasField('field_summary') && !$vendor->get('field_summary')->isEmpty()) {
        $sum = trim((string) $vendor->get('field_summary')->value);
        $organiser['tagline'] = $sum !== '' ? (string) Unicode::truncate($sum, 140, TRUE, TRUE) : NULL;
      }
      try {
        $vurl = Url::fromRoute('entity.myeventlane_vendor.canonical', ['myeventlane_vendor' => $vendor->id()]);
        if ($vurl->access(\Drupal::currentUser())) {
          $organiser['url'] = $vurl->setAbsolute(FALSE)->toString();
        }
      }
      catch (\Throwable) {
      }
      foreach (['field_vendor_logo', 'field_logo_image'] as $logo_field) {
        if ($vendor->hasField($logo_field) && !$vendor->get($logo_field)->isEmpty()) {
          $files = $vendor->get($logo_field)->referencedEntities();
          $file = !empty($files) ? reset($files) : NULL;
          if ($file instanceof File) {
            $organiser['logo_url'] = $file_url_generator->generateAbsoluteString($file->getFileUri());
            break;
          }
        }
      }
      $variables['mel_organiser'] = $organiser;
    }
  }

  // Event full hero: same data patterns as featured_hero cards (field names from config).
  $variables['category_label'] = NULL;
  $variables['hero_image'] = NULL;
  $variables['hero_datetime'] = NULL;
  $variables['hero_venue'] = NULL;
  $variables['hero_status'] = NULL;
  $variables['hero_status_modifier'] = 'default';
  $view_mode = $variables['view_mode'] ?? 'full';
  if ($view_mode === 'full') {
    $content = $variables['content'] ?? [];
    if ($node->hasField('field_event_image') && !$node->get('field_event_image')->isEmpty()) {
      if (is_array($content) && isset($content['field_event_image']) && is_array($content['field_event_image'])) {
        $variables['hero_image'] = $content['field_event_image'];
      }
      else {
        try {
          $variables['hero_image'] = $node->get('field_event_image')->view('full');
        }
        catch (\Throwable $e) {
          \Drupal::logger('myeventlane_theme')->error(
            'Event full hero: could not build field_event_image render array for node @nid: @message',
            ['@nid' => (string) $node->id(), '@message' => $e->getMessage()]
          );
        }
      }
    }

    $cat = $variables['mel_category_label'] ?? NULL;
    if ($cat !== NULL && $cat !== '') {
      $trimmed = trim((string) $cat);
      $variables['category_label'] = $trimmed !== '' ? $trimmed : NULL;
    }

    // Match listing featured card: "D j M, g:ia" (see card_time_range in preprocess_node).
    if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
      $start_value = $node->get('field_event_start')->value;
      if ($start_value && ($start_ts = strtotime((string) $start_value))) {
        $hero_datetime = date('D j M, g:ia', $start_ts);
        if ($node->hasField('field_event_end') && !$node->get('field_event_end')->isEmpty()) {
          $end_raw = (string) $node->get('field_event_end')->value;
          if ($end_raw !== '' && ($end_ts = strtotime($end_raw))) {
            $hero_datetime .= ' – ' . date('g:ia', $end_ts);
          }
        }
        $variables['hero_datetime'] = $hero_datetime;
      }
    }

    $variables['hero_venue'] = _myeventlane_theme_event_hero_venue_name($node);

    $resolved_state = (string) ($variables['mel_event_state'] ?? '');
    $variables['hero_status'] = _myeventlane_theme_event_hero_status_public($resolved_state);

    $cta_type = (string) ($variables['cta_type'] ?? 'none');
    $badge_for_modifier = _myeventlane_theme_get_event_badge_text($node);
    $card_type = 'none';
    if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
      $et = $node->get('field_event_type')->value;
      if (in_array($et, ['rsvp', 'paid', 'both', 'external'], TRUE)) {
        $card_type = $et;
      }
    }
    $variables['hero_status_modifier'] = match (TRUE) {
      in_array($resolved_state, ['cancelled'], TRUE) => 'cancelled',
      $resolved_state === 'ended' => 'ended',
      $resolved_state === 'sold_out' => 'sold-out',
      $resolved_state === 'scheduled' && $cta_type === EventCtaResolver::CTA_PAID => 'scheduled',
      $card_type === 'external' => 'external',
      $badge_for_modifier === 'FREE' => 'free',
      is_string($badge_for_modifier) && str_starts_with($badge_for_modifier, '$') => 'paid',
      default => 'default',
    };

    // Event full: primary booking label for sidebar title + CTA partial (display-only copy).
    $variables['mel_booking_action_label'] = NULL;
    $event_ui = $variables['event_ui'] ?? [];
    if (is_array($event_ui)
      && empty($event_ui['is_sold_out'])
      && (($event_ui['cta_type'] ?? '') === 'primary')
    ) {
      if ($cta_type === EventCtaResolver::CTA_RSVP) {
        $variables['mel_booking_action_label'] = new TranslatableMarkup('Book free RSVP');
      }
      elseif ($cta_type === EventCtaResolver::CTA_PAID) {
        $variables['mel_booking_action_label'] = new TranslatableMarkup('Get your tickets');
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for commerce_cart_form template.
 *
 * Groups cart items by event for better UX and accessibility.
 * Adds event information to form for template rendering.
 */
function myeventlane_theme_preprocess_commerce_cart_form(array &$variables): void {
  $form = $variables['form'];
  
  // Only process if we have order items.
  if (empty($form['#order_items']) || !is_array($form['#order_items'])) {
    return;
  }
  
  $order_items = $form['#order_items'];
  $grouped_items = [];
  $items_without_event = [];
  $item_event_map = [];
  
  // Group items by event and create mapping.
  foreach ($order_items as $order_item) {
    $item_id = (int) $order_item->id();
    
    if (!$order_item->hasField('field_target_event') || $order_item->get('field_target_event')->isEmpty()) {
      // Items without event go to a separate group.
      $items_without_event[] = $order_item;
      $item_event_map[$item_id] = NULL;
      continue;
    }
    
    $event = $order_item->get('field_target_event')->entity;
    if (!$event) {
      $items_without_event[] = $order_item;
      $item_event_map[$item_id] = NULL;
      continue;
    }
    
    $event_id = (int) $event->id();
    $item_event_map[$item_id] = $event_id;
    
    if (!isset($grouped_items[$event_id])) {
      $grouped_items[$event_id] = [
        'event' => $event,
        'items' => [],
        'item_ids' => [],
      ];
    }
    
    $grouped_items[$event_id]['items'][] = $order_item;
    $grouped_items[$event_id]['item_ids'][] = $item_id;
  }
  
  // Add grouped items to variables for template.
  $variables['grouped_items'] = $grouped_items;
  $variables['items_without_event'] = $items_without_event;
  $variables['item_event_map'] = $item_event_map;
}

/**
 * Implements hook_preprocess_HOOK() for commerce_cart_empty_page.
 *
 * Adds theme directory for empty cart image path.
 */
function myeventlane_theme_preprocess_commerce_cart_empty_page(array &$variables): void {
  $extension_list = \Drupal::service('extension.list.theme');
  $theme_path = $extension_list->getPath('myeventlane_theme');
  $variables['directory'] = $theme_path;
}

/**
 * Implements hook_preprocess_mimemail_message().
 *
 * Injects logo_path for MEL-styled email wrapper (core/contrib emails).
 * Uses theme logo setting or fallback to theme default logo.
 */
function myeventlane_theme_preprocess_mimemail_message(array &$variables): void {
  // Shared resolver skips SVG and builds absolute URLs (see myeventlane_messaging).
  $variables['logo_path'] = function_exists('myeventlane_messaging_email_branding_logo_url')
    ? myeventlane_messaging_email_branding_logo_url()
    : '';
}

/**
 * Implements hook_preprocess_HOOK() for RSVP forms.
 *
 * Attaches accordion JS for Accessibility + Support collapsible sections.
 * The RSVP public form template uses explicit `element.KEY` rendering (see
 * form--myeventlane-rsvp-public-form.html.twig); do not set the root as `form`
 * and render {{ form }} inside the <form> tag.
 */
function myeventlane_theme_preprocess_form__myeventlane_rsvp_public_form(array &$variables): void {
  $variables['#attached']['library'][] = 'myeventlane_theme/rsvp_sidebar';
}

/**
 * Implements hook_preprocess_HOOK() for RSVP booking form.
 *
 * Uses core-provided `element` in form--myeventlane-commerce-rsvp-booking-form
 * (do not alias the root as `form`; render children via element.KEY or children).
 */
function myeventlane_theme_preprocess_form__myeventlane_commerce_rsvp_booking_form(array &$variables): void {
  $variables['#attached']['library'][] = 'myeventlane_theme/rsvp_sidebar';
}

/**
 * Implements hook_preprocess_HOOK() for the event booking page layout.
 *
 * Adds optional field render arrays for richer left-column context. Supplies
 * the same hero tokens as node--event--full (featured-style). Does not change
 * Commerce or ticket validation logic.
 */
function myeventlane_theme_preprocess_myeventlane_event_book(array &$variables): void {
  $variables['event_title'] = $variables['title'] ?? '';
  $variables['event_date'] = $variables['event_date_text'] ?? '';
  $variables['event_location'] = $variables['venue_text'] ?? '';
  $variables['matrix_form'] = $variables['matrix_form'] ?? [];
  $variables['event_image'] = [];
  $variables['event_description'] = [];
  $variables['event_summary_excerpt'] = NULL;
  $variables['mel_booking_host_label'] = NULL;
  $variables['mel_signal_booked_count'] = NULL;
  $variables['mel_signal_remaining_spots'] = NULL;
  $variables['mel_signal_is_community'] = FALSE;
  $variables['mel_signal_trust_label'] = NULL;
  $variables['mel_signal_urgency_label'] = NULL;

  $variables['label'] = $variables['title'] ?? '';
  $variables['hero_image'] = NULL;
  $variables['category_label'] = NULL;
  $variables['mel_category_label'] = NULL;
  $variables['mel_category_slug'] = 'default';
  $variables['hero_datetime'] = NULL;
  $variables['hero_venue'] = NULL;
  $variables['hero_status'] = NULL;
  $variables['hero_status_modifier'] = 'default';

  $event = $variables['event'] ?? NULL;
  if (!$event instanceof NodeInterface) {
    return;
  }

  $variables['label'] = $event->label();

  if ($event->hasField('field_event_image') && !$event->get('field_event_image')->isEmpty()) {
    try {
      $variables['hero_image'] = $event->get('field_event_image')->view('full');
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->error(
        'Event book hero: could not build field_event_image for node @nid: @message',
        ['@nid' => (string) $event->id(), '@message' => $e->getMessage()]
      );
    }
  }
  $variables['event_image'] = !empty($variables['hero_image']) ? $variables['hero_image'] : [];

  $variables['mel_category_label'] = NULL;
  $variables['mel_category_slug'] = 'default';
  if ($event->hasField('field_category') && !$event->get('field_category')->isEmpty()) {
    $refs = $event->get('field_category')->referencedEntities();
    if (!empty($refs)) {
      $term = reset($refs);
      if ($term instanceof TermInterface) {
        $variables['mel_category_label'] = $term->label();
        $variables['mel_category_slug'] = function_exists('_myeventlane_theme_get_category_slug')
          ? _myeventlane_theme_get_category_slug($term)
          : str_replace([' ', '&', '+'], ['-', 'and', ''], strtolower($term->label()));
      }
    }
  }
  $trimmed_cat = $variables['mel_category_label'] ? trim((string) $variables['mel_category_label']) : '';
  $variables['category_label'] = $trimmed_cat !== '' ? $trimmed_cat : NULL;

  $mel_event_state = 'scheduled';
  if (\Drupal::hasService('myeventlane_event_state.resolver')) {
    $mel_event_state = (string) \Drupal::service('myeventlane_event_state.resolver')->resolveState($event);
  }
  $cta_type_book = EventCtaResolver::CTA_NONE;
  if (\Drupal::hasService('myeventlane_event.cta_resolver')) {
    $cta_type_book = \Drupal::service('myeventlane_event.cta_resolver')->getCtaType($event);
  }

  if ($event->hasField('field_event_start') && !$event->get('field_event_start')->isEmpty()) {
    $start_value = $event->get('field_event_start')->value;
    if ($start_value && ($start_ts = strtotime((string) $start_value))) {
      $hero_datetime = date('D j M, g:ia', $start_ts);
      if ($event->hasField('field_event_end') && !$event->get('field_event_end')->isEmpty()) {
        $end_raw = (string) $event->get('field_event_end')->value;
        if ($end_raw !== '' && ($end_ts = strtotime($end_raw))) {
          $hero_datetime .= ' – ' . date('g:ia', $end_ts);
        }
      }
      $variables['hero_datetime'] = $hero_datetime;
    }
  }

  $variables['hero_venue'] = _myeventlane_theme_event_hero_venue_name($event);
  $variables['hero_status'] = _myeventlane_theme_event_hero_status_public($mel_event_state);
  $badge_for_modifier = _myeventlane_theme_get_event_badge_text($event);
  $card_type = 'none';
  if ($event->hasField('field_event_type') && !$event->get('field_event_type')->isEmpty()) {
    $et = $event->get('field_event_type')->value;
    if (in_array($et, ['rsvp', 'paid', 'both', 'external'], TRUE)) {
      $card_type = $et;
    }
  }
  $variables['hero_status_modifier'] = match (TRUE) {
    in_array($mel_event_state, ['cancelled'], TRUE) => 'cancelled',
    $mel_event_state === 'ended' => 'ended',
    $mel_event_state === 'sold_out' => 'sold-out',
    $mel_event_state === 'scheduled' && $cta_type_book === EventCtaResolver::CTA_PAID => 'scheduled',
    $card_type === 'external' => 'external',
    $badge_for_modifier === 'FREE' => 'free',
    is_string($badge_for_modifier) && str_starts_with($badge_for_modifier, '$') => 'paid',
    default => 'default',
  };

  if ($event->hasField('body') && !$event->get('body')->isEmpty()) {
    $body = $event->get('body')->first();
    if ($body) {
      $variables['event_description'] = [
        '#type' => 'processed_text',
        '#text' => $body->value,
        '#format' => $body->format ?: 'basic_html',
      ];
      $plain = trim(PlainTextOutput::renderFromHtml((string) $body->value));
      if ($plain !== '' && strlen($plain) > 260) {
        $variables['event_summary_excerpt'] = Unicode::truncate($plain, 220, TRUE, TRUE);
      }
    }
  }

  if ($event->hasField('field_event_vendor') && !$event->get('field_event_vendor')->isEmpty()) {
    $vendor = $event->get('field_event_vendor')->entity;
    if ($vendor && $vendor->access('view')) {
      $variables['mel_booking_host_label'] = $vendor->label();
      $variables['mel_signal_trust_label'] = t('Hosted by @name', ['@name' => $vendor->label()]);
    }
  }

  if (\Drupal::hasService('myeventlane_capacity.service')) {
    try {
      /** @var \Drupal\myeventlane_capacity\Service\EventCapacityServiceInterface $capacity */
      $capacity = \Drupal::service('myeventlane_capacity.service');
      $soldCount = $capacity->getSoldCount($event);
      $remaining = $capacity->getRemaining($event);

      if ($soldCount > 0) {
        $variables['mel_signal_booked_count'] = $soldCount;
      }
      if ($remaining !== NULL) {
        $variables['mel_signal_remaining_spots'] = $remaining;
        if ($remaining > 10 && $remaining <= 25) {
          $variables['mel_signal_urgency_label'] = t('Popular event - spots are filling');
        }
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->warning('Could not resolve booking signals for event @event_id: @message', [
        '@event_id' => (string) $event->id(),
        '@message' => $e->getMessage(),
      ]);
    }
  }

  $categoryText = '';
  if ($event->hasField('field_category') && !$event->get('field_category')->isEmpty()) {
    $parts = [];
    foreach ($event->get('field_category')->referencedEntities() as $term) {
      $label = trim(mb_strtolower((string) $term->label()));
      if ($label !== '') {
        $parts[] = $label;
      }
    }
    $categoryText = implode(' ', $parts);
  }
  if ($categoryText !== '') {
    $variables['mel_signal_is_community'] = str_contains($categoryText, 'community')
      || str_contains($categoryText, 'lgbtq')
      || str_contains($categoryText, 'grassroots');
  }

}

/**
 * Implements hook_preprocess_HOOK() for paid ticket selection on /event/{node}/book.
 *
 * Exposes the element as "form" for the Twig override and fills row descriptions
 * when the matrix omitted them, using TicketType short_description first, then
 * variation field_description / field_ticket_description (hasField-safe).
 *
 * Adds conversion-layer metadata (data attributes, BEM hooks) for
 * mel_booking_summary.js. Does not change submit handlers or quantities.
 *
 * Restructures rows for premium layout only: title_row + selection badge,
 * purchase_column (.mel-ticket-row__meta) wrapping price + quantity, group_hint
 * moved under the main column.
 *
 * Per-tier scarcity copy is not rendered here: computing “only X left” correctly
 * requires the same waitlist-offer and capacity branches as checkout validation.
 * The .mel-ticket-row__status container is nested under label_cell (left column)
 * and is output empty for future theming/hooks.
 */
function myeventlane_theme_preprocess_form__myeventlane_ticket_selection_form(array &$variables): void {
  $element = &$variables['element'];

  if (!isset($element['tickets']) || !is_array($element['tickets'])) {
    $variables['form'] = $variables['element'];
    return;
  }

  $node = $element['#node'] ?? NULL;
  $tier_by_variation_id = [];
  if ($node instanceof NodeInterface
    && $node->hasField('field_ticket_types')
    && !$node->get('field_ticket_types')->isEmpty()) {
    foreach ($node->get('field_ticket_types')->referencedEntities() as $ticket) {
      if (!$ticket instanceof TicketTypeInterface || $ticket->get('commerce_variation')->isEmpty()) {
        continue;
      }
      $tier_by_variation_id[(int) $ticket->get('commerce_variation')->target_id] = $ticket;
    }
  }

  $variation_storage = \Drupal::entityTypeManager()->getStorage('commerce_product_variation');

  $label_cell = NULL;
  foreach (Element::children($element['tickets']) as $key) {
    if (!is_numeric($key)) {
      continue;
    }
    $vid = (int) $key;
    if (!isset($element['tickets'][$key]['label_cell']) || !is_array($element['tickets'][$key]['label_cell'])) {
      continue;
    }
    $label_cell = &$element['tickets'][$key]['label_cell'];
    // Skip only when the form already output visible description markup (TicketSelectionForm).
    if (isset($label_cell['description']['#markup'])) {
      $visible = trim(strip_tags((string) $label_cell['description']['#markup']));
      if ($visible !== '') {
        $markup = (string) $label_cell['description']['#markup'];
        if (str_contains($markup, 'mel-ticket-description') && !str_contains($markup, 'mel-ticket-row__description')) {
          $label_cell['description']['#markup'] = str_replace(
            'class="mel-ticket-description',
            'class="mel-ticket-description mel-ticket-row__description',
            $markup
          );
        }
        continue;
      }
    }

    $text = '';
    $tier = $tier_by_variation_id[$vid] ?? NULL;
    if ($tier instanceof TicketTypeInterface
      && $tier->hasField('short_description')
      && !$tier->get('short_description')->isEmpty()) {
      $short_item = $tier->get('short_description')->first();
      $text = $short_item ? trim($short_item->getString()) : '';
    }

    if ($text === '') {
      $variation = $variation_storage->load($vid);
      if ($variation instanceof ProductVariationInterface) {
        foreach (['field_description', 'field_ticket_description'] as $field_name) {
          if (!$variation->hasField($field_name) || $variation->get($field_name)->isEmpty()) {
            continue;
          }
          $field_item = $variation->get($field_name)->first();
          $candidate = $field_item ? trim($field_item->getString()) : '';
          if ($candidate !== '') {
            $text = $candidate;
            break;
          }
        }
      }
    }

    if ($text === '') {
      continue;
    }

    $label_cell['description'] = [
      '#markup' => '<div class="mel-ticket-description mel-ticket-row__description mel-text--muted">' . nl2br(Html::escape($text), FALSE) . '</div>',
    ];
  }
  unset($label_cell);

  // Ticket matrix conversion metadata + row structure for JS/CSS.
  foreach (Element::children($element['tickets']) as $key) {
    if (!is_numeric($key)) {
      continue;
    }
    $vid = (int) $key;
    $row = &$element['tickets'][$key];
    if (!is_array($row) || ($row['#type'] ?? '') !== 'container') {
      continue;
    }

    $variation = $variation_storage->load($vid);
    $price_number = '';
    if ($variation instanceof ProductVariationInterface && $variation->getPrice()) {
      $price_number = (string) $variation->getPrice()->getNumber();
    }

    $title_plain = '';
    if (isset($row['label_cell']['label']['#value'])) {
      $title_plain = trim((string) $row['label_cell']['label']['#value']);
    }

    $row['#attributes']['data-ticket-row'] = '1';
    $row['#attributes']['data-ticket-id'] = (string) $vid;
    if ($title_plain !== '') {
      $row['#attributes']['data-ticket-title'] = $title_plain;
    }
    if ($price_number !== '') {
      $row['#attributes']['data-ticket-price-number'] = $price_number;
    }

    // Group sale / bundle hints: keep in the main column under the description.
    if (isset($row['group_hint']) && is_array($row['group_hint']) && ($row['group_hint']['#access'] ?? TRUE) !== FALSE) {
      $gh = $row['group_hint'];
      unset($row['group_hint']);
      $row['label_cell']['group_hint'] = $gh;
      if (!isset($row['label_cell']['group_hint']['#attributes']['class']) || !is_array($row['label_cell']['group_hint']['#attributes']['class'])) {
        $row['label_cell']['group_hint']['#attributes']['class'] = [];
      }
      $row['label_cell']['group_hint']['#attributes']['class'][] = 'mel-ticket-row__helper';
      $row['label_cell']['group_hint']['#weight'] = 16;
    }

    // Title row + “Selected” badge (visibility toggled in mel_booking_summary.js).
    if (isset($row['label_cell']['label']) && is_array($row['label_cell']['label'])) {
      $label_el = $row['label_cell']['label'];
      unset($row['label_cell']['label']);
      if (!isset($label_el['#attributes']['class']) || !is_array($label_el['#attributes']['class'])) {
        $label_el['#attributes']['class'] = [];
      }
      if (!in_array('mel-ticket-row__title', $label_el['#attributes']['class'], TRUE)) {
        $label_el['#attributes']['class'][] = 'mel-ticket-row__title';
      }
      $label_el['#weight'] = 1;
      $row['label_cell']['title_row'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['mel-ticket-row__title-row']],
        '#weight' => 2,
        'label' => $label_el,
        'selection_badge' => [
          '#type' => 'html_tag',
          '#tag' => 'span',
          '#value' => (string) t('Selected'),
          '#attributes' => [
            'class' => ['mel-ticket-row__selection-badge'],
            'data-mel-ticket-selection-badge' => '1',
            'hidden' => 'hidden',
          ],
          '#weight' => 2,
        ],
      ];
    }

    if (isset($row['label_cell']['description']) && is_array($row['label_cell']['description'])) {
      $row['label_cell']['description']['#weight'] = 8;
    }

    $has_desc = isset($row['label_cell']['description']) && is_array($row['label_cell']['description'])
      && isset($row['label_cell']['description']['#markup'])
      && trim(strip_tags((string) $row['label_cell']['description']['#markup'])) !== '';
    if ($has_desc) {
      $row['#attributes']['class'][] = 'mel-ticket-row--has-description';
    }

    if (isset($row['label_cell']) && is_array($row['label_cell'])) {
      if (!isset($row['label_cell']['#attributes']['class']) || !is_array($row['label_cell']['#attributes']['class'])) {
        $row['label_cell']['#attributes']['class'] = [];
      }
      $row['label_cell']['#attributes']['class'][] = 'mel-ticket-row__main';
      $row['label_cell']['#weight'] = 10;
    }

    if (isset($row['price']) && is_array($row['price'])) {
      if (isset($row['price']['#attributes']['class']) && is_array($row['price']['#attributes']['class'])) {
        $row['price']['#attributes']['class'][] = 'mel-ticket-row__price';
      }
    }

    if (isset($row['price']) && isset($row['quantity'])) {
      $price_el = $row['price'];
      $qty_el = $row['quantity'];
      unset($row['price'], $row['quantity']);
      $price_el['#weight'] = 1;
      if (!isset($qty_el['#attributes']['class']) || !is_array($qty_el['#attributes']['class'])) {
        $qty_el['#attributes']['class'] = [];
      }
      if (!in_array('mel-ticket-row__qty', $qty_el['#attributes']['class'], TRUE)) {
        $qty_el['#attributes']['class'][] = 'mel-ticket-row__qty';
      }
      $qty_el['#weight'] = 2;
      $row['purchase_column'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['mel-ticket-row__meta']],
        '#weight' => 22,
        'price' => $price_el,
        'quantity' => $qty_el,
      ];
    }

    if (isset($row['label_cell']) && is_array($row['label_cell']) && !isset($row['label_cell']['row_status'])) {
      $row['label_cell']['row_status'] = [
        '#type' => 'container',
        '#attributes' => [
          'class' => ['mel-ticket-row__status'],
        ],
        '#weight' => 18,
      ];
    }
  }

  $variables['form'] = $variables['element'];
}

/**
 * Implements hook_preprocess_HOOK() for status_messages.
 *
 * Adds is_commerce_route for toast vs banner display.
 */
function myeventlane_theme_preprocess_status_messages(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName() ?? '';
  $path = \Drupal::request()->getPathInfo() ?? '';

  $variables['is_commerce_route'] =
    str_starts_with((string) $route, 'commerce_') ||
    str_starts_with($path, '/cart') ||
    str_starts_with($path, '/checkout');
}