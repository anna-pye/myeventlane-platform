/**
 * Implements hook_preprocess_site_header().
 *
 * Populates site header variables: branding, primary_menu, organiser_context,
 * cart, user_menu, mobile_drawer, is_checkout.
 */
function myeventlane_theme_preprocess_site_header(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $variables['is_checkout'] = strpos((string) $route, 'commerce_checkout') === 0;
  // Render arrays cannot pass scalar theme variables as sibling keys; resolve here.
  $variables['is_auth_minimal'] = FALSE;
  if (\Drupal::moduleHandler()->moduleExists('myeventlane_surface')) {
    $surface = \Drupal::service('myeventlane_surface.resolver')->resolve();
    $variables['is_auth_minimal'] = $surface === \Drupal\myeventlane_core\MelSurfaceId::Auth;
  }

  $extension_list = \Drupal::service('extension.list.theme');
  $theme_path = $extension_list->getPath('myeventlane_theme');
  $base_path = base_path();

  // Branding: logo link.
  $logo_path = $base_path . $theme_path . '/images/logo.svg';
  $variables['branding'] = [
    '#type' => 'link',
    '#title' => [
      '#type' => 'html_tag',
      '#tag' => 'img',
      '#attributes' => [
        'src' => $logo_path,
        'alt' => t('Home'),
        'width' => 32,
        'height' => 32,
        'class' => ['site-header__logo'],
      ],
    ],
    '#url' => Url::fromRoute('<front>'),
    '#attributes' => ['class' => ['site-header__brand-link']],
  ];

  // Primary menu.
  $block_manager = \Drupal::service('plugin.manager.block');
  try {
    $main_menu = $block_manager->createInstance('system_menu_block:main', []);
    if ($main_menu->access(\Drupal::currentUser())) {
      $build = $main_menu->build();
      $variables['primary_menu'] = !empty($build) ? $build : [];
    }
    else {
      $variables['primary_menu'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['primary_menu'] = [];
  }

  // Organiser context block: hide inline strip when trusted console users already
  // have organiser tools in the account menu / dropdown (avoid duplicate CTAs).
  try {
    $organiser_block = $block_manager->createInstance('myeventlane_organiser_context', []);
    if ($organiser_block->access(\Drupal::currentUser())) {
      $build = $organiser_block->build();
      $account = \Drupal::currentUser()->getAccount();
      $trust_hide_strip = $account->hasPermission('administer nodes')
        || VendorConsoleTrust::accountIsTrustedForVendorConsole($account);
      if ($trust_hide_strip && !empty($build)) {
        $variables['organiser_context'] = [];
      }
      else {
        $variables['organiser_context'] = !empty($build) ? $build : [];
      }
    }
    else {
      $variables['organiser_context'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['organiser_context'] = [];
  }

  // Cart block.
  try {
    $cart_block = $block_manager->createInstance('commerce_cart', []);
    if ($cart_block->access(\Drupal::currentUser())) {
      $build = $cart_block->build();
      $variables['cart'] = !empty($build) ? $build : [];
    }
    else {
      $variables['cart'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['cart'] = [];
  }

  // Notification bell: built by myeventlane_notifications_preprocess_site_header().

  // User menu.
  try {
    $account_menu = $block_manager->createInstance('system_menu_block:account', []);
    if ($account_menu->access(\Drupal::currentUser())) {
      $build = $account_menu->build();
      $variables['user_menu'] = !empty($build) ? $build : [];
    }
    else {
      $variables['user_menu'] = [];
    }
  }
  catch (\Exception $e) {
    $variables['user_menu'] = [];
  }

  // Create Event CTA URL: gateway handles anonymous → login and vendor onboarding.
  $variables['create_event_url'] = _myeventlane_theme_public_create_event_url();

  // Strip commerce/marketing chrome on auth + checkout shells (surface-driven).
  $minimal_shell = $variables['is_checkout'] || $variables['is_auth_minimal'];
  if ($minimal_shell) {
    $variables['primary_menu'] = [];
    $variables['organiser_context'] = [];
    $variables['mobile_drawer'] = [];
    if ($variables['is_auth_minimal']) {
      $variables['cart'] = [];
      $variables['user_menu'] = [];
    }
  }
  elseif (!$variables['is_checkout']) {
    $variables['mobile_drawer'] = [
      '#theme' => 'mobile_drawer',
      '#drawer_menu' => $variables['primary_menu'],
      '#drawer_organiser' => $variables['organiser_context'],
      '#cache' => [
        'contexts' => ['cart'],
      ],
    ];
  }
  else {
    $variables['mobile_drawer'] = [];
  }
}

/**
 * Implements hook_preprocess_menu__account().
 */
function myeventlane_theme_preprocess_menu__account(array &$variables): void {
}

/**
 * Implements hook_preprocess_menu__main().
 *
 * Transforms the "Vendors" menu item into a dropdown with child links.
 * Shows organiser dashboard entry for trusted organisers and discovery entry for others.
 */
function myeventlane_theme_preprocess_menu__main(array &$variables): void {
  if (empty($variables['items'])) {
    return;
  }

  $current_user = \Drupal::currentUser();
  $account = $current_user->getAccount();
  $access_manager = \Drupal::accessManager();
  $dashboard_access = FALSE;
  $events_access = FALSE;
  try {
    $dashboard_access = $access_manager->checkNamedRoute('myeventlane_vendor.console.dashboard', [], $account, TRUE)->isAllowed();
  }
  catch (\Throwable) {
  }
  try {
    $events_access = $access_manager->checkNamedRoute('myeventlane_vendor.console.events', [], $account, TRUE)->isAllowed();
  }
  catch (\Throwable) {
  }
  $trusted_console = VendorConsoleTrust::accountIsTrustedForVendorConsole($account)
    || $account->hasPermission('administer nodes');

  // Find and transform the Vendors menu item.
  foreach ($variables['items'] as $key => &$item) {
    $title = (string) ($item['title'] ?? '');
      if (strtolower($title) === 'vendors' || strtolower($title) === 'organisers') {
      // Create child items for the dropdown.
      $item['below'] = [
        'browse_organisers' => [
          'title' => t('Browse organisers'),
          'url' => Url::fromRoute('myeventlane_vendor.public_list'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ],
      ];

      if ($dashboard_access) {
        $item['below']['organiser_dashboard'] = [
          'title' => t('Organiser dashboard'),
          'url' => Url::fromRoute('myeventlane_vendor.console.dashboard'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ];
      }
      elseif ($events_access && $trusted_console) {
        $item['below']['my_events'] = [
          'title' => t('My events'),
          'url' => Url::fromRoute('myeventlane_vendor.console.events'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ];
      }

      if (!$trusted_console) {
        $item['below']['become_organiser'] = [
          'title' => t('Become an organiser'),
          'url' => Url::fromRoute('myeventlane_vendor.onboard'),
          'attributes' => new Attribute(['class' => ['mel-nav-dropdown-link']]),
          'below' => [],
          'in_active_trail' => FALSE,
          'is_expanded' => FALSE,
          'is_collapsed' => FALSE,
        ];
      }

      // Mark as expanded so the template knows it has children.
      $item['is_expanded'] = TRUE;
      $item['is_collapsed'] = FALSE;

      // Make the parent link just a label (no navigation).
      $item['url'] = Url::fromRoute('<none>');
      break;
    }
  }
}

/**
 * Implements hook_preprocess_mobile_drawer().
 *
 * Ensures drawer_menu and drawer_organiser are render arrays.
 */
function myeventlane_theme_preprocess_mobile_drawer(array &$variables): void {
  $variables['drawer_menu'] = $variables['drawer_menu'] ?? [];
  $variables['drawer_organiser'] = $variables['drawer_organiser'] ?? [];
  $variables['create_event_url'] = _myeventlane_theme_public_create_event_url();

  $variables['mel_cart_url'] = '/cart';
  $variables['mel_cart_item_count'] = 0;
  $variables['mel_cart_count_text'] = (string) \Drupal::translation()->formatPlural(0, '@count item', '@count items', ['@count' => 0]);
  $variables['mel_checkout_url'] = '';

  try {
    $variables['mel_cart_url'] = Url::fromRoute('commerce_cart.page')->toString();
  }
  catch (\Throwable) {
    // Route missing in non-Commerce environments.
  }

  if (\Drupal::moduleHandler()->moduleExists('commerce_cart')) {
    try {
      $cart_qty = 0;
      foreach (\Drupal::service('commerce_cart.cart_provider')->getCarts() as $cart) {
        foreach ($cart->getItems() as $item) {
          $cart_qty += (int) $item->getQuantity();
        }
      }
      $variables['mel_cart_item_count'] = $cart_qty;
      $variables['mel_cart_count_text'] = (string) \Drupal::translation()->formatPlural(
        $cart_qty,
        '@count item',
        '@count items',
        ['@count' => $cart_qty]
      );
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->error('Mobile drawer cart count failed: @message', ['@message' => $e->getMessage()]);
    }
  }

  if (\Drupal::moduleHandler()->moduleExists('commerce_checkout')) {
    try {
      $checkout_url = Url::fromRoute('commerce_checkout.checkout');
      if ($checkout_url->access(\Drupal::currentUser())) {
        $variables['mel_checkout_url'] = $checkout_url->toString();
      }
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_theme')->warning('Mobile drawer checkout URL: @message', ['@message' => $e->getMessage()]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for commerce_cart_block.
 */
function myeventlane_theme_preprocess_commerce_cart_block(array &$variables): void {
  $variables['mel_checkout_url'] = '';
  if (!\Drupal::moduleHandler()->moduleExists('commerce_checkout')) {
    return;
  }
  try {
    $checkout_url = Url::fromRoute('commerce_checkout.checkout');
    if ($checkout_url->access(\Drupal::currentUser())) {
      $variables['mel_checkout_url'] = $checkout_url->toString();
    }
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->warning('Cart block checkout URL: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Implements hook_preprocess_HOOK() for commerce_checkout_pane.
 *
 * Adds a single shell class for governed checkout SCSS (no markup fork).
 */
function myeventlane_theme_preprocess_commerce_checkout_pane(array &$variables): void {
  if (!isset($variables['elements']) || !is_array($variables['elements'])) {
    return;
  }
  if (!isset($variables['elements']['#attributes']['class'])) {
    $variables['elements']['#attributes']['class'] = [];
  }
  elseif (!is_array($variables['elements']['#attributes']['class'])) {
    $variables['elements']['#attributes']['class'] = [$variables['elements']['#attributes']['class']];
  }
  $variables['elements']['#attributes']['class'][] = 'mel-checkout-pane-shell';
}

/**
 * Implements hook_preprocess_region__header().
 *
 * Passes vendor status to the header region template.
 */
function myeventlane_theme_preprocess_region__header(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $variables['is_vendor'] = $current_user->hasPermission('access vendor dashboard');
}

/**
 * Implements hook_theme_suggestions_form_alter().
 *
 * Adds form__{form_id} suggestion so form--{form-id}.html.twig templates
 * (e.g. form--myeventlane-rsvp-public-form.html.twig) are used.
 */
function myeventlane_theme_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'] ?? [];
  $form_id = $element['#form_id'] ?? NULL;
  if (is_string($form_id) && $form_id !== '') {
    $suggestions[] = 'form__' . $form_id;
  }
  if ($form_id === 'user_form') {
    $token = \Drupal::request()->query->get('pass-reset-token');
    if (is_string($token) && $token !== '') {
      $suggestions[] = 'form__user_profile_form';
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK() for commerce_checkout_form.
 */
function myeventlane_theme_theme_suggestions_commerce_checkout_form(array $variables): array {
  $suggestions = [];
  $form = $variables['form'] ?? [];
  $step_id = $form['#step_id'] ?? NULL;
  if ($step_id === 'complete') {
    // Complete + visible sidebar: use commerce_checkout_form__with_sidebar only (Commerce + below).
    // Avoid competing __complete vs __with_sidebar suggestions on the same step.
    if (!isset($form['sidebar']) || !Element::isVisibleElement($form['sidebar'])) {
      $suggestions[] = 'commerce_checkout_form__complete';
    }
    return $suggestions;
  }
  if ($step_id !== NULL
    && isset($form['sidebar'])
    && Element::isVisibleElement($form['sidebar'])) {
    $suggestions[] = 'commerce_checkout_form__with_sidebar';
  }
  return $suggestions;
}

/**
 * Loads the commerce order from the current route (checkout pages).
 */
function _myeventlane_theme_commerce_order_from_route(): ?OrderInterface {
  $order_param = \Drupal::routeMatch()->getParameter('commerce_order');
  if ($order_param !== NULL && is_scalar($order_param) && is_numeric((string) $order_param)) {
    $loaded = \Drupal::entityTypeManager()
      ->getStorage('commerce_order')
      ->load((string) $order_param);
    return $loaded instanceof OrderInterface ? $loaded : NULL;
  }
  return $order_param instanceof OrderInterface ? $order_param : NULL;
}

/**
 * Adds tax invoice Twig variables from Commerce order + store ABN.
 */
function _myeventlane_theme_attach_tax_invoice_variables(OrderInterface $order, array &$variables): void {
  if (!\Drupal::hasService('myeventlane_checkout_flow.tax_invoice_presentation')) {
    return;
  }
  /** @var \Drupal\myeventlane_checkout_flow\Service\TaxInvoicePresentationBuilder $builder */
  $builder = \Drupal::service('myeventlane_checkout_flow.tax_invoice_presentation');
  $data = $builder->build($order);
  $variables['vendor_name'] = $data['vendor_name'];
  $variables['vendor_abn'] = $data['vendor_abn'];
  $variables['order_total_gst'] = $data['order_total_gst'];
  $variables['order_total'] = $data['order_total'];
  $variables['mel_invoice_lines'] = $data['invoice_lines'];
  $variables['invoice_date_display'] = $data['invoice_date_display'];
  $variables['mel_invoice_fee_lines'] = $data['fee_lines'];
  $variables['mel_invoice_tax_lines'] = $data['tax_lines'];
  $variables['invoice_lines_include_gst_column'] = $data['invoice_lines_include_gst_column'] ?? FALSE;
}

/**
 * Implements hook_preprocess_commerce_checkout_order_summary().
 *
 * Reuses MelCheckoutSummaryPresenter so core summary theme matches grouped parity.
 */
function myeventlane_theme_preprocess_commerce_checkout_order_summary(array &$variables): void {
  $order = $variables['order_entity'] ?? NULL;
  if (!$order instanceof OrderInterface) {
    $variables['mel_checkout_order_summary_build'] = [];
    $variables['mel_operational_checkout'] = NULL;
    return;
  }
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_checkout_flow')) {
    $variables['mel_checkout_order_summary_build'] = [];
    $variables['order_entity'] = $order;
    _myeventlane_theme_attach_mel_operational_checkout($variables);
    return;
  }
  /** @var \Drupal\myeventlane_checkout_flow\Service\MelCheckoutSummaryPresenter $presenter */
  $presenter = \Drupal::service('myeventlane_checkout_flow.checkout_summary_presenter');
  $step = \Drupal::routeMatch()->getParameter('step');
  $surface = $step === 'complete' ? 'complete' : 'checkout';
  $variables['mel_checkout_order_summary_build'] = $presenter->buildGroupedSummaryRenderArray($order, ['surface' => $surface]);
  $variables['order_entity'] = $order;
  _myeventlane_theme_attach_mel_operational_checkout($variables);
}

/**
 * Implements hook_preprocess_commerce_order().
 */
function myeventlane_theme_preprocess_commerce_order(array &$variables): void {
  $order = $variables['order_entity'] ?? NULL;
  if (!$order instanceof OrderInterface) {
    return;
  }
  _myeventlane_theme_attach_tax_invoice_variables($order, $variables);
  $store = $order->getStore();
  if ($store) {
    $variables['#cache']['tags'][] = 'commerce_store:' . $store->id();
  }
  _myeventlane_theme_attach_mel_customer_operational_experience($variables);
  _myeventlane_theme_attach_mel_operational_fulfillment_execution_customer($variables);
  _myeventlane_theme_attach_mel_operational_purchase_composition($variables);
  _myeventlane_theme_attach_mel_operational_checkout($variables);
  _myeventlane_theme_attach_operational_addon_guidance($variables);
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_my_tickets.
 */
function myeventlane_theme_preprocess_myeventlane_my_tickets(array &$variables): void {
  foreach (['upcoming_orders', 'past_orders'] as $orders_key) {
    if (empty($variables[$orders_key]) || !is_array($variables[$orders_key])) {
      continue;
    }
    foreach ($variables[$orders_key] as $idx => $order_data) {
      if (!is_array($order_data)) {
        continue;
      }
      $order = $order_data['order'] ?? NULL;
      if (!$order instanceof OrderInterface) {
        continue;
      }
      $variables[$orders_key][$idx]['mel_operational_fulfillment_execution_customer'] = _myeventlane_theme_mel_operational_fulfillment_execution_customer_for_order($order);
      $variables[$orders_key][$idx]['mel_operational_purchase_composition'] = _myeventlane_theme_mel_operational_purchase_composition_for_order($order);
      $variables[$orders_key][$idx]['mel_operational_checkout'] = _myeventlane_theme_mel_operational_checkout_for_order($order);
      $variables[$orders_key][$idx]['operational_addon_guidance'] = _myeventlane_theme_mel_operational_addon_guidance_for_order($order);
    }
  }

  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_event_studio')
    || !\Drupal::hasService('myeventlane_event_studio.customer_operational_commerce_experience_builder')) {
    return;
  }
  /** @var \Drupal\myeventlane_event_studio\Service\CustomerOperationalCommerceExperienceBuilder $mce */
  $mce = \Drupal::service('myeventlane_event_studio.customer_operational_commerce_experience_builder');
  foreach (['upcoming_orders', 'past_orders'] as $orders_key) {
    if (empty($variables[$orders_key]) || !is_array($variables[$orders_key])) {
      continue;
    }
    foreach ($variables[$orders_key] as $idx => $order_data) {
      if (!is_array($order_data)) {
        continue;
      }
      $order = $order_data['order'] ?? NULL;
      if (!$order instanceof OrderInterface) {
        continue;
      }
      try {
        $doc = $mce->buildCustomerOperationalExperienceForOrder($order);
        $variables[$orders_key][$idx]['mel_customer_operational_experience'] = _myeventlane_theme_mel_customer_operational_render_from_doc($doc, $order);
      }
      catch (\Throwable $e) {
        \Drupal::logger('myeventlane_theme')->notice('MEL My Tickets operational strip skipped for order @oid: @message', [
          '@oid' => (string) $order->id(),
          '@message' => $e->getMessage(),
        ]);
        $variables[$orders_key][$idx]['mel_customer_operational_experience'] = NULL;
      }
    }
  }
}

/**
 * @return array<string, mixed>|null
 */
function _myeventlane_theme_mel_operational_fulfillment_execution_customer_for_order(OrderInterface $order): ?array {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_tickets')
    || !\Drupal::hasService('myeventlane_tickets.operational_fulfillment_execution_projection_builder')) {
    return NULL;
  }
  try {
    /** @var \Drupal\myeventlane_tickets\Service\OperationalFulfillmentExecutionProjectionBuilder $builder */
    $builder = \Drupal::service('myeventlane_tickets.operational_fulfillment_execution_projection_builder');
    return $builder->buildCustomerRenderArray($order);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->notice('MEL fulfillment execution (My Tickets) skipped for order @oid: @message', [
      '@oid' => (string) $order->id(),
      '@message' => $e->getMessage(),
    ]);
    return NULL;
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_order_detail.
 */
function myeventlane_theme_preprocess_myeventlane_order_detail(array &$variables): void {
  $order_data = $variables['order'] ?? NULL;
  if (!is_array($order_data)) {
    return;
  }
  $order = $order_data['order'] ?? NULL;
  if (!$order instanceof OrderInterface) {
    return;
  }
  $variables['order_entity'] = $order;
  _myeventlane_theme_attach_mel_operational_fulfillment_execution_customer($variables);
  _myeventlane_theme_attach_mel_operational_purchase_composition($variables);
  _myeventlane_theme_attach_mel_operational_checkout($variables);
  _myeventlane_theme_attach_operational_addon_guidance($variables);

  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_event_studio')
    || !\Drupal::hasService('myeventlane_event_studio.customer_operational_commerce_experience_builder')) {
    return;
  }
  try {
    /** @var \Drupal\myeventlane_event_studio\Service\CustomerOperationalCommerceExperienceBuilder $mce */
    $mce = \Drupal::service('myeventlane_event_studio.customer_operational_commerce_experience_builder');
    $doc = $mce->buildCustomerOperationalExperienceForOrder($order);
    $variables['mel_customer_operational_experience'] = _myeventlane_theme_mel_customer_operational_render_from_doc($doc, $order);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->notice('MEL order detail operational strip skipped for order @oid: @message', [
      '@oid' => (string) $order->id(),
      '@message' => $e->getMessage(),
    ]);
    $variables['mel_customer_operational_experience'] = NULL;
  }
}

/**
 * Builds a render array for the customer operational experience theme hook.
 *
 * @param array<string, mixed> $doc
 *   Sanitised experience document.
 * @param \Drupal\commerce_order\Entity\OrderInterface|null $order
 *   Order for cache tags when known.
 *
 * @return array<string, mixed>|null
 *   Render array or NULL when empty.
 */
function _myeventlane_theme_mel_customer_operational_render_from_doc(array $doc, ?OrderInterface $order = NULL): ?array {
  if (!empty($doc['empty'])) {
    return NULL;
  }
  $tags = [];
  if ($order instanceof OrderInterface) {
    $tags[] = 'commerce_order:' . $order->id();
    $event = _myeventlane_theme_get_first_event_from_order($order);
    if ($event instanceof NodeInterface) {
      $tags[] = 'node:' . $event->id();
    }
  }
  return [
    '#theme' => 'mel_customer_operational_experience',
    '#experience' => $doc,
    '#cache' => [
      'tags' => $tags,
      'contexts' => ['languages:language_interface'],
    ],
  ];
}

/**
 * Whether the order is a natural free-RSVP checkout (list-price $0 tickets only).
 *
 * Distinguishes true RSVP products from orders that reach $0 via promotions
 * (e.g. 100% off a paid variation), where "Confirm RSVP" would mislead.
 */
function _myeventlane_theme_order_is_natural_zero_price_rsvp(OrderInterface $order): bool {
  $has_ticket_variation = FALSE;
  foreach ($order->getItems() as $item) {
    if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
      continue;
    }
    $purchased = $item->getPurchasedEntity();
    if (!$purchased instanceof ProductVariationInterface) {
      continue;
    }
    $has_ticket_variation = TRUE;
    $list_price = $purchased->getPrice();
    if ($list_price === NULL || !$list_price->isZero()) {
      return FALSE;
    }
  }
  return $has_ticket_variation;
}

/**
 * Implements hook_preprocess_HOOK() for commerce_checkout_form.
 */
function myeventlane_theme_preprocess_commerce_checkout_form(array &$variables): void {
  $step_id = $variables['form']['#step_id'] ?? NULL;

  if (($step_id ?? '') !== 'complete') {
    $order_param = _myeventlane_theme_commerce_order_from_route();
    if ($order_param instanceof OrderInterface) {
      $event = _myeventlane_theme_get_first_event_from_order($order_param);
      $variables['mel_checkout_refunds_available'] = _myeventlane_theme_event_has_refunds_available($event);
      if ($event instanceof NodeInterface) {
        $variables['#cache']['tags'][] = 'node:' . $event->id();
      }

      // Governed checkout copy + attendee schema signal (resolver is Commerce-data only).
      if (\Drupal::moduleHandler()->moduleExists('myeventlane_checkout_flow')) {
        /** @var \Drupal\myeventlane_checkout_flow\Service\MelCheckoutAttendeeRequirementResolver $mel_checkout_resolver */
        $mel_checkout_resolver = \Drupal::service('myeventlane_checkout_flow.checkout_attendee_requirement_resolver');
        $requires_attendee_questions_schema = $mel_checkout_resolver->resolve($order_param)['requires_attendee_details'];
        $variables['mel_requires_attendee_questions_schema'] = $requires_attendee_questions_schema;
        /** @var \Drupal\myeventlane_core\MelReadinessHelper $mel_checkout_ready */
        $mel_checkout_ready = \Drupal::service('myeventlane_surface.state_readiness_helper');
        $mel_refunds_chip = !empty($variables['mel_checkout_refunds_available']);
        $variables['mel_checkout_presentation'] = [
          'hero' => $mel_checkout_ready->customerCheckoutStructuredHero($mel_refunds_chip, $requires_attendee_questions_schema),
          'trust_chips' => $mel_checkout_ready->customerCheckoutTrustChipsBuilt($mel_refunds_chip),
          'trust_chip_region_label' => $mel_checkout_ready->customerCheckoutTrustChipsRegionLabel(),
          'payment_region_label' => $mel_checkout_ready->customerCheckoutPaymentReassuranceRegionLabel(),
          'payment_trust_lines' => $mel_checkout_ready->customerCheckoutPaymentTrustLines(),
          'cta_secure_note' => $mel_checkout_ready->customerCheckoutCtaSecurePaymentNote(),
          'summary_aria' => $mel_checkout_ready->customerCheckoutOrderSummaryAriaLabel(),
          'summary_titles' => $mel_checkout_ready->customerCheckoutGroupedSummaryTitles(),
          'sticky_support_nav' => $mel_checkout_ready->customerCheckoutStickySupportNav(),
          'sticky_region' => $mel_checkout_ready->customerCheckoutStickyCtaAriaLabel(),
          'step_buyer' => $mel_checkout_ready->customerCheckoutStepBuyer(),
          'step_attendees' => $mel_checkout_ready->customerCheckoutStepAttendees(),
          'step_payment' => $mel_checkout_ready->customerCheckoutStepPayment(),
          'optional_chip' => $mel_checkout_ready->customerCheckoutOptionalDonationChip(),
          'optional_donation_heading' => $mel_checkout_ready->customerCheckoutOptionalDonationHeading(),
          'booking_summary_heading' => $mel_checkout_ready->customerCheckoutBookingSummaryHeading(),
          'sidebar_help_aria' => $mel_checkout_ready->customerCheckoutSidebarHelpAriaLabel(),
        ];
      }

      $total_price = $order_param->getTotalPrice();
      // Primary CTA from order total + variation list prices (avoids stale labels when
      // payment pane is AJAX-hidden; RSVP label only for inherently free tickets).
      $form = &$variables['form'];
      if (isset($form['actions']['next']) && $total_price !== NULL) {
        if ($total_price->isZero()) {
          if (_myeventlane_theme_order_is_natural_zero_price_rsvp($order_param)) {
            $form['actions']['next']['#value'] = t('Reserve your spot');
          }
          else {
            $form['actions']['next']['#value'] = t('Complete booking');
          }
        }
        else {
          $form['actions']['next']['#value'] = t('Complete booking');
        }
      }
    }
  }

  if ($step_id === 'complete') {
    $form = &$variables['form'];
    // Resolve order: route param, sidebar pane, or view arguments.
    $order = \Drupal::routeMatch()->getParameter('commerce_order')
      ?? $form['#order_entity']
      ?? ($form['sidebar']['order_summary']['#order_entity'] ?? NULL);
    // order_summary pane uses a view when configured; order ID is in #arguments.
    if (!$order && isset($form['sidebar']['order_summary']['summary']['#arguments'][0])) {
      $order = $form['sidebar']['order_summary']['summary']['#arguments'][0];
    }
    if ($order && is_numeric($order)) {
      $order = \Drupal::entityTypeManager()
        ->getStorage('commerce_order')
        ->load($order);
    }
    if ($order && $order instanceof \Drupal\commerce_order\Entity\OrderInterface) {
      $variables['order_entity'] = $order;
      $variables['order_totals'] = \Drupal::service('commerce_order.order_total_summary')
        ->buildTotals($order);
      // Build attendee names per order item (avoids referencedEntities() in Twig sandbox).
      $order_items_attendees = [];
      foreach ($order->getItems() as $item) {
        if (!$item->hasField('field_ticket_holder') || $item->get('field_ticket_holder')->isEmpty()) {
          continue;
        }
        $attendees = [];
        foreach ($item->get('field_ticket_holder')->referencedEntities() as $holder) {
          $first = $holder->hasField('field_first_name') && !$holder->get('field_first_name')->isEmpty()
            ? trim((string) $holder->get('field_first_name')->value) : '';
          $last = $holder->hasField('field_last_name') && !$holder->get('field_last_name')->isEmpty()
            ? trim((string) $holder->get('field_last_name')->value) : '';
          $email = $holder->hasField('field_email') && !$holder->get('field_email')->isEmpty()
            ? trim((string) $holder->get('field_email')->value) : '';
          $attendees[] = [
            'first_name' => $first,
            'last_name' => $last,
            'email' => $email,
          ];
        }
        if (!empty($attendees)) {
          $order_items_attendees[(int) $item->id()] = $attendees;
        }
      }
      $variables['order_items_attendees'] = $order_items_attendees;

      // Event image URLs for confirmation cards (avoids Twig sandbox restriction on first()).
      $file_url_generator = \Drupal::service('file_url_generator');
      $mel_event_image_urls = [];
      foreach ($order->getItems() as $item) {
        if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
          continue;
        }
        $event = NULL;
        if ($item->hasField('field_target_event') && !$item->get('field_target_event')->isEmpty()) {
          $event = $item->get('field_target_event')->entity;
        }
        if (!$event) {
          $pe = $item->getPurchasedEntity();
          if ($pe && $pe->hasField('field_event') && !$pe->get('field_event')->isEmpty()) {
            $event = $pe->get('field_event')->entity;
          }
        }
        if (!$event && $item->getPurchasedEntity()) {
          $product = $item->getPurchasedEntity()->getProduct();
          if ($product && $product->hasField('field_event') && !$product->get('field_event')->isEmpty()) {
            $event = $product->get('field_event')->entity;
          }
        }
        if ($event && $event->hasField('field_event_image') && !$event->get('field_event_image')->isEmpty()) {
          $event_id = (int) $event->id();
          if (!isset($mel_event_image_urls[$event_id])) {
            $files = $event->get('field_event_image')->referencedEntities();
            $file = !empty($files) ? reset($files) : NULL;
            if ($file) {
              $mel_event_image_urls[$event_id] = $file_url_generator->generateAbsoluteString($file->getFileUri());
            }
          }
        }
      }
      $variables['mel_event_image_urls'] = $mel_event_image_urls;

      /** @var \Drupal\myeventlane_core\MelReadinessHelper $mel_completion_ready */
      $mel_completion_ready = \Drupal::service('myeventlane_surface.state_readiness_helper');
      $summary_labels = $mel_completion_ready->customerCheckoutOrderSummarySurfaceLabels();
      $variables['mel_checkout_presentation'] = [
        'booking_summary_heading' => $mel_completion_ready->customerCheckoutBookingSummaryHeading(),
        'completion_hero' => $mel_completion_ready->customerCheckoutCompletionHero(),
        'help_region_short' => $summary_labels['help_region_short'],
      ];

      // Help centre URL for confirmation support block (canonical hub only).
      try {
        $variables['mel_help_centre_url'] = Url::fromRoute('myeventlane_help_centre.home')->toString();
      }
      catch (RouteNotFoundException $e) {
        $variables['mel_help_centre_url'] = '/help';
      }

      // Calendar links, event URL, logged-in for Level 2 confirmation UX.
      $first_event = _myeventlane_theme_get_first_event_from_order($order);
      $variables['mel_calendar_links'] = $first_event ? _myeventlane_theme_build_calendar_links($first_event) : [];
      $variables['mel_event_url'] = $first_event
        ? $first_event->toUrl('canonical', ['absolute' => TRUE])->toString()
        : '';
      $variables['mel_logged_in'] = \Drupal::currentUser()->isAuthenticated();

      // Paid vs free/zero-total: honest labels on confirmation (Twig-safe booleans/strings).
      $total_price = $order->getTotalPrice();
      $variables['mel_confirm_paid'] = $total_price instanceof Price && !$total_price->isZero();

      $ticket_like_count = 0;
      foreach ($order->getItems() as $item) {
        if (!in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
          $ticket_like_count++;
        }
      }
      $variables['mel_confirmation_has_tickets'] = $ticket_like_count > 0;

      $donation_sum = NULL;
      foreach ($order->getItems() as $item) {
        if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation'], TRUE)) {
          $tp = $item->getTotalPrice();
          if ($tp instanceof Price && !$tp->isZero()) {
            $donation_sum = $donation_sum === NULL ? $tp : $donation_sum->add($tp);
          }
        }
      }
      foreach ($order->getAdjustments() as $adjustment) {
        if ((string) $adjustment->getLabel() !== 'Contribution') {
          continue;
        }
        $amount = $adjustment->getAmount();
        if ($amount instanceof Price && !$amount->isZero()) {
          $donation_sum = $donation_sum === NULL ? $amount : $donation_sum->add($amount);
        }
      }
      $variables['mel_donation_total_formatted'] = NULL;
      if ($donation_sum instanceof Price && !$donation_sum->isZero()) {
        /** @var \Drupal\commerce_price\CurrencyFormatter $currency_formatter */
        $currency_formatter = \Drupal::service('commerce_price.currency_formatter');
        $variables['mel_donation_total_formatted'] = $currency_formatter->format(
          $donation_sum->getNumber(),
          $donation_sum->getCurrencyCode()
        );
      }

      $variables['mel_order_pricing_breakdown'] = NULL;
      if (\Drupal::hasService('myeventlane_checkout_flow.order_pricing_breakdown')) {
        /** @var \Drupal\myeventlane_checkout_flow\Service\OrderPricingBreakdownBuilder $mel_breakdown */
        $mel_breakdown = \Drupal::service('myeventlane_checkout_flow.order_pricing_breakdown');
        $variables['mel_order_pricing_breakdown'] = $mel_breakdown->build($order);
      }

      $customer_id = $order->getCustomerId();
      $customer_id = $customer_id !== NULL && $customer_id !== '' ? (int) $customer_id : NULL;
      /** @var \Drupal\myeventlane_surface\MelCustomerContinuityPresenter $mel_continuity */
      $mel_continuity = \Drupal::service('myeventlane_surface.customer_continuity_presenter');
      $variables['mel_checkout_completion'] = $mel_continuity->buildCheckoutCompletionPresentation(
        (string) ($order->getEmail() ?? ''),
        (string) $order->getOrderNumber(),
        $customer_id,
        (int) $order->id(),
        (bool) ($variables['mel_confirmation_has_tickets'] ?? FALSE),
        $variables['mel_donation_total_formatted'] ?? NULL,
        (array) ($variables['mel_calendar_links'] ?? []),
        (string) ($variables['mel_event_url'] ?? ''),
      );

      // Attach copy-link JS when share block is present.
      if ($variables['mel_event_url']) {
        $variables['#attached']['library'][] = 'myeventlane_theme/mel_confirmation';
      }

      _myeventlane_theme_attach_tax_invoice_variables($order, $variables);
      $store = $order->getStore();
      if ($store) {
        $variables['#cache']['tags'][] = 'commerce_store:' . $store->id();
      }
    }
  }

  _myeventlane_theme_attach_mel_customer_operational_experience($variables);
  _myeventlane_theme_attach_mel_operational_fulfillment_execution_customer($variables);
  _myeventlane_theme_attach_mel_operational_purchase_composition($variables);
  _myeventlane_theme_attach_mel_operational_checkout($variables);
  _myeventlane_theme_attach_operational_addon_guidance($variables);

  if (($variables['form']['#step_id'] ?? '') === 'complete') {
    $variables['mel_operational_checkout'] = NULL;
    $variables['mel_operational_purchase_composition'] = NULL;
    $variables['mel_operational_fulfillment_execution_customer'] = NULL;
    $variables['mel_customer_operational_experience'] = NULL;
    if (isset($variables['order_entity']) && $variables['order_entity'] instanceof OrderInterface) {
      $variables['mel_confirmation_line_labels'] = _myeventlane_theme_build_confirmation_order_line_labels($variables['order_entity']);
    }
  }
}

/**
 * Builds customer-safe order line labels for checkout completion cards.
 *
 * @return array<int, string>
 *   Labels keyed by order item ID.
 */
function _myeventlane_theme_build_confirmation_order_line_labels(OrderInterface $order): array {
  $labels = [];
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_commerce')) {
    return $labels;
  }

  /** @var \Drupal\myeventlane_commerce\Service\OperationalOrderItemDisplayBuilder|null $display_builder */
  $display_builder = \Drupal::hasService('myeventlane_commerce.operational_order_item_display_builder')
    ? \Drupal::service('myeventlane_commerce.operational_order_item_display_builder')
    : NULL;
  /** @var \Drupal\myeventlane_commerce\Service\TicketBackedOrderItemClassifier|null $classifier */
  $classifier = \Drupal::hasService('myeventlane_commerce.ticket_backed_order_item_classifier')
    ? \Drupal::service('myeventlane_commerce.ticket_backed_order_item_classifier')
    : NULL;
  /** @var \Drupal\myeventlane_core\Service\TicketLabelResolver|null $ticket_labels */
  $ticket_labels = \Drupal::hasService('myeventlane_core.ticket_label_resolver')
    ? \Drupal::service('myeventlane_core.ticket_label_resolver')
    : NULL;

  foreach ($order->getItems() as $item) {
    if (!$item instanceof \Drupal\commerce_order\Entity\OrderItemInterface) {
      continue;
    }
    if (in_array($item->bundle(), ['checkout_donation', 'platform_donation', 'rsvp_donation', 'boost'], TRUE)) {
      continue;
    }
    $item_id = (int) $item->id();
    $display = $display_builder?->buildForOrderItem($item);
    if (is_array($display) && ($display['title'] ?? '') !== '') {
      $labels[$item_id] = (string) $display['title'];
      continue;
    }
    $tier_label = $classifier?->resolveTicketTierLabel($item);
    if (is_string($tier_label) && $tier_label !== '') {
      $labels[$item_id] = $tier_label;
      continue;
    }
    $labels[$item_id] = $ticket_labels ? $ticket_labels->getTicketLabel($item) : (string) $item->label();
  }

  return $labels;
}

/**
 * Attaches read-only operational expectation copy for checkout (Event Studio enabled).
 */
function _myeventlane_theme_attach_mel_customer_operational_experience(array &$variables): void {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_event_studio')
    || !\Drupal::hasService('myeventlane_event_studio.customer_operational_commerce_experience_builder')) {
    return;
  }
  $order = $variables['order_entity'] ?? NULL;
  if (!$order instanceof OrderInterface) {
    $order = _myeventlane_theme_commerce_order_from_route();
  }
  if (!$order instanceof OrderInterface) {
    return;
  }
  try {
    /** @var \Drupal\myeventlane_event_studio\Service\CustomerOperationalCommerceExperienceBuilder $mce */
    $mce = \Drupal::service('myeventlane_event_studio.customer_operational_commerce_experience_builder');
    $doc = $mce->buildCustomerOperationalExperienceForOrder($order);
    _myeventlane_theme_set_mel_customer_operational_block($variables, $doc, ['commerce_order:' . $order->id()], $order);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->notice('MEL customer operational experience attach skipped: @message', ['@message' => $e->getMessage()]);
    $variables['mel_customer_operational_experience'] = NULL;
  }
}

/**
 * Sets a themed render array for customer-safe operational expectations.
 *
 * @param array<string, mixed> $variables
 *   Preprocess variables (by reference).
 * @param array<string, mixed> $doc
 *   Builder document (already sanitised server-side).
 * @param list<string> $cache_tags
 *   Base cache tags for the block.
 * @param \Drupal\commerce_order\Entity\OrderInterface|null $order
 *   Optional order for additional node tag from line items.
 */
function _myeventlane_theme_set_mel_customer_operational_block(array &$variables, array $doc, array $cache_tags, ?OrderInterface $order): void {
  $render = _myeventlane_theme_mel_customer_operational_render_from_doc($doc, $order);
  if ($render === NULL) {
    $variables['mel_customer_operational_experience'] = NULL;
    return;
  }
  $render['#cache']['tags'] = array_values(array_unique(array_merge($cache_tags, $render['#cache']['tags'] ?? [])));
  $variables['mel_customer_operational_experience'] = $render;
}

/**
 * Composition document per order, static-cached for the current request.
 *
 * @return array<string, mixed>
 */
function _myeventlane_theme_mel_operational_composition_document(OrderInterface $order): array {
  static $by_order = [];
  $oid = (int) $order->id();
  if (array_key_exists($oid, $by_order)) {
    return $by_order[$oid];
  }
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_commerce')
    || !\Drupal::hasService('myeventlane_commerce.operational_purchase_composition_manager')) {
    $by_order[$oid] = _myeventlane_theme_mel_operational_composition_empty_groups();
    return $by_order[$oid];
  }
  try {
    /** @var \Drupal\myeventlane_commerce\Service\OperationalPurchaseCompositionManager $pcm */
    $pcm = \Drupal::service('myeventlane_commerce.operational_purchase_composition_manager');
    $by_order[$oid] = $pcm->composeForOrder($order);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->notice('MEL operational composition document skipped for order @oid: @message', [
      '@oid' => (string) $order->id(),
      '@message' => $e->getMessage(),
    ]);
    $by_order[$oid] = _myeventlane_theme_mel_operational_composition_empty_groups();
  }
  return $by_order[$oid];
}

/**
 * @return array<string, mixed>
 */
function _myeventlane_theme_mel_operational_composition_empty_groups(): array {
  return [
    'groups' => [
      'merchandise' => [],
      'hospitality' => [],
      'timed_collection' => [],
      'bundles' => [],
      'parking' => [],
    ],
  ];
}

/**
 * Cached checkout render array for an order (single orchestration finalize per request).
 *
 * @return array<string, mixed>|null
 */
function _myeventlane_theme_mel_operational_checkout_render_for_order(OrderInterface $order): ?array {
  static $cache = [];
  $oid = (int) $order->id();
  if (array_key_exists($oid, $cache)) {
    return $cache[$oid];
  }
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_commerce')
    || !\Drupal::hasService('myeventlane_commerce.operational_checkout_orchestration_manager')) {
    $cache[$oid] = NULL;
    return NULL;
  }
  try {
    $composition = _myeventlane_theme_mel_operational_composition_document($order);
    /** @var \Drupal\myeventlane_commerce\Service\OperationalCheckoutOrchestrationManager $oco */
    $oco = \Drupal::service('myeventlane_commerce.operational_checkout_orchestration_manager');
    $cache[$oid] = $oco->buildOrderRenderArrayFromComposition($order, $composition);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->notice('MEL operational checkout orchestration skipped for order @oid: @message', [
      '@oid' => (string) $order->id(),
      '@message' => $e->getMessage(),
    ]);
    $cache[$oid] = NULL;
  }
  return $cache[$oid];
}

/**
 * Attaches customer-safe fulfillment execution hints (myeventlane_tickets).
 */
function _myeventlane_theme_attach_mel_operational_fulfillment_execution_customer(array &$variables): void {
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_tickets')
    || !\Drupal::hasService('myeventlane_tickets.operational_fulfillment_execution_projection_builder')) {
    $variables['mel_operational_fulfillment_execution_customer'] = NULL;
    return;
  }
  $order = $variables['order_entity'] ?? NULL;
  if (!$order instanceof OrderInterface && isset($variables['form']['#order'])) {
    $candidate = $variables['form']['#order'];
    $order = $candidate instanceof OrderInterface ? $candidate : NULL;
  }
  if (!$order instanceof OrderInterface) {
    $variables['mel_operational_fulfillment_execution_customer'] = NULL;
    return;
  }
  try {
    /** @var \Drupal\myeventlane_tickets\Service\OperationalFulfillmentExecutionProjectionBuilder $builder */
    $builder = \Drupal::service('myeventlane_tickets.operational_fulfillment_execution_projection_builder');
    $variables['mel_operational_fulfillment_execution_customer'] = $builder->buildCustomerRenderArray($order);
  }
  catch (\Throwable $e) {
    \Drupal::logger('myeventlane_theme')->notice('MEL fulfillment execution customer strip skipped: @message', ['@message' => $e->getMessage()]);
    $variables['mel_operational_fulfillment_execution_customer'] = NULL;
  }
}

