{#
/**
 * @file
 * Base page template for MyEventLane Theme.
 *
 * IMPORTANT:
 * - This template defines blocks for page variants (front, search, event, etc).
 * - Do not inline script/style tags. Attach assets via libraries only.
 *
 * Regions are rendered structurally; blocks/layout builder control the content.
 */
#}

{% set page_wrapper_attributes = create_attribute().addClass('mel-page') %}

<div{{ page_wrapper_attributes }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {# Site header: compact global header (desktop + mobile) #}
  {{ site_header }}

  {# Optional hero region used by some pages. #}
  {% block hero %}
    {% if page.hero %}
      <div class="mel-region-hero">
        {{ page.hero }}
      </div>
    {% endif %}
  {% endblock %}

  {# Optional pre-content region. #}
  {% if page.pre_content %}
    <div class="mel-region-pre-content">
      <div class="mel-container">
        {{ page.pre_content }}
      </div>
    </div>
  {% endif %}

  <main id="main-content" class="mel-main" role="main">
    {# Optional: login page create-event intro (page--user-login). #}
    {% block mel_pre_highlighted %}{% endblock %}
    {# Status messages: Highlighted region, or preprocess fallback if no block placed. #}
    {% if page.highlighted %}
      <div class="mel-region-highlighted" role="region" aria-label="{{ 'Status messages'|t }}">
        <div class="mel-container">
          {{ page.highlighted }}
        </div>
      </div>
    {% elseif mel_fallback_messages is defined %}
      <div class="mel-region-highlighted mel-region-highlighted--fallback" role="region" aria-label="{{ 'Status messages'|t }}">
        <div class="mel-container">
          {{ mel_fallback_messages }}
        </div>
      </div>
    {% endif %}
    {# Intelligence panel is omitted on this theme (buyer marketplace); governance stack lives on vendor/staff UIs. #}
    {% if mel_observability_panel is defined and mel_observability_panel %}
      <div class="mel-region-observability mel-guidance-stack">
        <div class="mel-container">
          {{ mel_observability_panel }}
        </div>
      </div>
    {% endif %}
    {% block content %}
      {{ page.content }}
    {% endblock %}
  </main>

  {# Optional below-content region. #}
  {% if page.below_content %}
    <div class="mel-region-below-content">
      <div class="mel-container">
        {{ page.below_content }}
      </div>
    </div>
  {% endif %}

  {% include '@myeventlane_theme/includes/footer.html.twig' %}
</div>
