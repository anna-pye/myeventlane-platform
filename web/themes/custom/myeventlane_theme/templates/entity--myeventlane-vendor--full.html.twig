{#
/**
 * @file
 * Public vendor profile page.
 *
 * Data is prepared by VendorDetailController; this template only renders the
 * public layout and shared components.
 */
#}
{% set contact_labels = {
  'field_email': 'Email'|t,
  'field_phone': 'Phone'|t,
  'field_address': 'Location'|t,
  'field_website': 'Website'|t,
  'field_social_links': 'Social links'|t,
} %}
{% set contact_icons = {
  'field_email': '@',
  'field_phone': '☎',
  'field_address': '⌖',
  'field_website': '↗',
  'field_social_links': '#',
} %}
{% if accent_color %}
  {% set attributes = attributes.setAttribute('style', '--mel-vendor-accent: ' ~ accent_color) %}
{% endif %}

<article{{ attributes }}>
  <div class="mel-vendor__hero{% if not banner %} mel-vendor__hero--placeholder{% endif %}" aria-hidden="true">
    {% if banner %}
      {{ banner }}
    {% endif %}
  </div>

  <header class="mel-vendor__header">
    <div class="mel-vendor__logo">
      <span class="mel-vendor__logo-fallback" aria-hidden="true">{{ label|first|upper }}</span>
      {% if logo %}
        {{ logo }}
      {% endif %}
    </div>

    <div class="mel-vendor__title">
      <p class="mel-vendor__eyebrow">{{ 'Organiser'|t }}</p>
      <h1{{ title_attributes.addClass('mel-vendor__name') }}>{{ label }}</h1>
      {% if tagline %}
        <p class="mel-subtle mel-vendor__tagline">{{ tagline }}</p>
      {% endif %}
      <p class="mel-vendor__followers" data-mel-follower-count>
        {{ follower_count }} {{ follower_count == 1 ? 'follower'|t : 'followers'|t }}
      </p>
    </div>

    {% if follow_url and is_authenticated %}
      {% if is_following %}
        <button class="mel-follow-button is-following" data-vendor-id="{{ vendor_id }}" data-follow-url="{{ follow_url }}" aria-pressed="true">
          {{ 'Following ✓'|t }}
        </button>
      {% else %}
        <button class="mel-follow-button" data-vendor-id="{{ vendor_id }}" data-follow-url="{{ follow_url }}" aria-pressed="false">
          {{ 'Follow organiser'|t }}
        </button>
      {% endif %}
    {% elseif follow_url %}
      <a class="mel-follow-button" href="{{ follow_url }}">{{ 'Log in to follow'|t }}</a>
    {% endif %}
  </header>

  {% if description or contact %}
    <div class="mel-vendor__profile-grid">
      {% if description %}
        <section class="mel-vendor__about" aria-labelledby="vendor-about-heading">
          <p class="mel-vendor__section-kicker">{{ 'Meet the organiser'|t }}</p>
          <h2 id="vendor-about-heading">{{ 'About @organiser'|t({'@organiser': label}) }}</h2>
          <div class="mel-vendor__bio">
            {{ description }}
          </div>
        </section>
      {% endif %}

      {% if contact %}
        <section class="mel-vendor__contact" aria-labelledby="vendor-contact-heading">
          <p class="mel-vendor__section-kicker">{{ 'Get in touch'|t }}</p>
          <h2 id="vendor-contact-heading">{{ 'Contact information'|t }}</h2>
          <div class="mel-vendor__contact-grid">
            {% for key, item in contact %}
              <div class="mel-vendor__contact-item">
                <span class="mel-vendor__contact-icon" aria-hidden="true">{{ contact_icons[key]|default('•') }}</span>
                <div class="mel-vendor__contact-copy">
                  <span class="mel-vendor__contact-label">{{ contact_labels[key]|default('Contact'|t) }}</span>
                  <div class="mel-vendor__contact-value">{{ item }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>
  {% endif %}

  <section class="mel-vendor__events" aria-labelledby="vendor-events-heading">
    <header class="mel-vendor__events-header">
      <div>
        <p class="mel-vendor__section-kicker">{{ 'Find your next experience'|t }}</p>
        <h2 id="vendor-events-heading">{{ 'Upcoming events'|t }}</h2>
        <p>{{ 'See what @organiser has coming up.'|t({'@organiser': label}) }}</p>
      </div>
      {% if events %}
        <span class="mel-vendor__event-count">{{ events|length }} {{ events|length == 1 ? 'event'|t : 'events'|t }}</span>
      {% endif %}
    </header>

    {% if events %}
      <div class="mel-vendor__event-grid mel-event-grid mel-grid mel-grid--events">
        {% for event in events %}
          {{ event }}
        {% endfor %}
      </div>
    {% else %}
      <div class="mel-vendor__empty-events">
        <strong>{{ 'Nothing announced yet'|t }}</strong>
        <p>{{ 'Check back soon for new events from this organiser.'|t }}</p>
      </div>
    {% endif %}
  </section>
</article>
