{#
/**
 * @file
 * Checkout shell for Commerce when no sidebar is present on the step.
 *
 * Governed wrapper: .mel-checkout-shell scopes layout, messages adjacency, and panes.
 */
#}
<div class="mel-checkout-shell">
  {# mel-checkout--compact-flow: QA-visible hook + SCSS anchor for compact density (any Commerce flow). #}
  <div class="mel-checkout mel-checkout--compact-flow">

    {% if title %}
      <h1 class="mel-checkout__title">{{ title }}</h1>
    {% endif %}

    <p class="mel-checkout-mode-hint">{{ 'Review your details and complete your booking. Card payment only runs when your order includes a priced ticket.'|t }}</p>

    {% if form.progress %}
      <div class="mel-checkout__progress">
        {{ form.progress }}
      </div>
    {% endif %}

    <div class="mel-checkout__grid mel-checkout__grid--sidebar-flow">
      <div class="mel-checkout__main">
        <p class="mel-checkout-helper">{{ "Just a few details and you're done."|t }}</p>

        {% if mel_contextual_help_checkout is defined and mel_contextual_help_checkout %}
          {% if form.sidebar is not defined %}
            <div class="mel-contextual-help mel-contextual-help--checkout mel-contextual-help--checkout-card">
              {{ mel_contextual_help_checkout }}
            </div>
          {% endif %}
        {% elseif mel_help_checkout_refund is defined and mel_help_checkout_refund %}
          <div class="mel-contextual-help mel-contextual-help--checkout">
            {{ mel_help_checkout_refund }}
          </div>
        {% endif %}
        {% if not (mel_contextual_help_checkout is defined and mel_contextual_help_checkout) %}
          {% if mel_help_checkout_guide is defined and mel_help_checkout_guide %}
            <div class="mel-contextual-help mel-contextual-help--checkout mel-contextual-help--checkout-guide">
              {{ mel_help_checkout_guide }}
            </div>
          {% endif %}
        {% endif %}
        {% if mel_help_checkout_assistant is defined and mel_help_checkout_assistant %}
          <div class="mel-checkout-help-assistant">
            {{ mel_help_checkout_assistant }}
          </div>
        {% endif %}

        {{ form|without('progress', 'sidebar', 'actions') }}

        {% if form.actions %}
          <div class="mel-checkout-section mel-checkout-section--cta">
            <div class="mel-checkout-cta">
              {{ form.actions }}
              <div class="mel-checkout-cta__note">
                {% if form.payment_information is defined %}
                  {{ 'Payment is processed securely when you continue.'|t }}
                {% else %}
                  {{ 'No card payment is required for this order.'|t }}
                {% endif %}
              </div>
              <p class="mel-checkout-cta__recovery">
                <a class="mel-checkout-cta__recovery-link mel-util-link" href="{{ path('myeventlane_support.page') }}">{{ 'Something wrong? Contact support'|t }}</a>
              </p>
              <nav class="mel-checkout-support-foot" aria-label="{{ 'Help and support'|t }}">
                <a class="mel-util-link mel-util-link--support" href="{{ path('myeventlane_help_centre.home') }}">{{ 'Help Centre'|t }}</a>
                <span class="mel-checkout-support-foot__sep" aria-hidden="true">·</span>
                <a class="mel-util-link mel-util-link--support" href="{{ path('myeventlane_support.page') }}">{{ 'Support'|t }}</a>
              </nav>
            </div>
          </div>
        {% endif %}
      </div>

      {% if form.sidebar is defined %}
        {% set sidebar_content = form.sidebar|render %}
        {% if (mel_contextual_help_checkout is defined and mel_contextual_help_checkout) or (sidebar_content|striptags|trim is not empty) %}
          <aside class="mel-checkout__aside mel-checkout__summary" aria-label="{{ 'Order summary and help'|t }}">
            <div class="mel-checkout__summary-inner">
              {% if mel_contextual_help_checkout is defined and mel_contextual_help_checkout %}
                <div class="mel-contextual-help mel-contextual-help--checkout mel-contextual-help--checkout-card mel-checkout__summary-region">
                  {{ mel_contextual_help_checkout }}
                </div>
              {% endif %}
              <div class="mel-checkout__summary-region mel-checkout__summary-region--order">
                {{ sidebar_content }}
              </div>
            </div>
          </aside>
        {% endif %}
      {% endif %}
    </div>

  </div>
</div>
