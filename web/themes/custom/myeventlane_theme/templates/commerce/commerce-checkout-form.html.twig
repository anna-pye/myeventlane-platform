{#
/**
 * @file
 * Checkout Shell layout for Commerce checkout form.
 *
 * BEM: .mel-checkout, .mel-checkout__grid, .mel-checkout__main,
 * .mel-checkout__aside, .mel-checkout__actions
 *
 * - Two-column layout: main left, aside right (desktop)
 * - Actions directly beneath main column
 * - No empty sidebar container when sidebar has no children
 */
#}

<div class="mel-checkout">

  {% if title %}
    <h1 class="mel-checkout__title">{{ title }}</h1>
  {% endif %}

  {% if form.progress %}
    <div class="mel-checkout__progress">
      {{ form.progress }}
    </div>
  {% endif %}

  <div class="mel-checkout__grid">
    <div class="mel-checkout__main">
      {% if mel_help_checkout_refund %}
        <div class="mel-contextual-help mel-contextual-help--checkout">
          {{ mel_help_checkout_refund }}
        </div>
      {% endif %}
      {{ form|without('progress', 'sidebar', 'actions') }}
      {% if form.actions %}
        <div class="mel-checkout__actions">
          {{ form.actions }}
        </div>
        <p class="mel-checkout-security">{{ 'You\'ll have a chance to review everything before completing your order.'|t }}</p>
      {% endif %}
    </div>

    {% if form.sidebar is defined %}
      {% set sidebar_content = form.sidebar|render %}
      {% if sidebar_content|striptags|trim is not empty %}
        <aside class="mel-checkout__aside">
          {{ sidebar_content }}
        </aside>
      {% endif %}
    {% endif %}
  </div>

</div>
