{#
/**
 * @file
 * Checkout order summary — canonical build from MelCheckoutSummaryPresenter (PHP).
 *
 * @see myeventlane_theme_preprocess_commerce_checkout_order_summary()
 */
#}
{% if mel_checkout_order_summary_build is not empty or mel_operational_checkout %}
<div{{ attributes.addClass('checkout-order-summary', 'mel-checkout-order-summary', 'mel-checkout-order-summary--presented') }}>
  {% if mel_checkout_order_summary_build is not empty %}
    {{ mel_checkout_order_summary_build }}
  {% endif %}
  {% if mel_operational_checkout %}
    <div class="mel-checkout-order-summary__operational-checkout mel-mt-3" role="region" aria-label="{{ 'Operational checkout plan'|t }}">
      {{ mel_operational_checkout }}
    </div>
  {% endif %}
</div>
{% endif %}
