{#
/**
 * @file
 * Event booking page — V2: event-first → context → purchase.
 *
 * Access code, ticket matrix, and Add to cart render inside {{ matrix_form }}
 * (TicketSelectionForm). Do not split into Twig-only access_code_form / add_to_cart.
 *
 * Variables: event_title, event_date, event_location, hero_url, event_image,
 * event_description, event_summary_excerpt, mel_booking_host_label,
 * matrix_form, rsvp_form, event_mode, etc.
 */
#}
<div class="mel-booking-v2 mel-booking mel-event-book" data-event-mode="{{ event_mode }}">
  <div class="mel-container">
    {# HERO — event promise #}
    <div class="mel-booking-hero{% if (event_image is not defined or event_image is empty) and not hero_url %} mel-booking-hero--no-media{% endif %}">
      <div class="mel-booking-hero__media">
        {% if event_image is defined and event_image is not empty %}
          <div class="mel-booking-hero__image">
            {{ event_image }}
          </div>
        {% elseif hero_url %}
          <div class="mel-booking-hero__image">
            <img class="mel-booking-hero__img-fallback" src="{{ hero_url }}" alt="{{ event_title }}" width="1200" height="600" loading="eager" />
          </div>
        {% endif %}
      </div>

      <div class="mel-booking-hero__overlay">
        <div class="mel-booking-hero__badge">
          {% if event_mode == 'rsvp' %}
            {% include '@myeventlane_theme/components/event-type-pill.html.twig' with { type: 'rsvp', label: 'RSVP'|t, size: 'md' } only %}
          {% elseif event_mode == 'paid' %}
            {% include '@myeventlane_theme/components/event-type-pill.html.twig' with { type: 'paid', label: 'Tickets'|t, size: 'md' } only %}
          {% elseif event_mode == 'external' %}
            {% include '@myeventlane_theme/components/event-type-pill.html.twig' with { type: 'external', label: 'External'|t, size: 'md' } only %}
          {% endif %}
        </div>

        <div class="mel-booking-hero__content">
          <p class="mel-booking-hero__eyebrow">
            {% if event_mode == 'rsvp' %}
              {{ 'Reserve your spot'|t }}
            {% elseif event_mode == 'paid' %}
              {{ 'Buy tickets'|t }}
            {% elseif event_mode == 'external' %}
              {{ 'View details'|t }}
            {% else %}
              {{ 'View details'|t }}
            {% endif %}
          </p>
          <h1 class="mel-booking-hero__title">{{ event_title }}</h1>

          <div class="mel-booking-hero__meta mel-event-meta" role="group" aria-label="{{ 'When and where'|t }}">
            {% if event_date %}
              <span class="mel-booking-hero__meta-block">
                <span class="mel-booking-hero__meta-label">{{ 'When'|t }}</span>
                <span class="mel-booking-hero__meta-value">{{ event_date }}</span>
              </span>
            {% endif %}
            {% if event_location %}
              <span class="mel-booking-hero__meta-block">
                <span class="mel-booking-hero__meta-label">{{ 'Where'|t }}</span>
                <span class="mel-booking-hero__meta-value">{{ event_location }}</span>
              </span>
            {% endif %}
          </div>

          {% if mel_booking_host_label %}
            <p class="mel-booking-hero__host">
              {{ 'Hosted by @name'|t({'@name': mel_booking_host_label}) }}
            </p>
          {% endif %}

          {% if event_summary_excerpt %}
            <p class="mel-booking-hero__summary">{{ event_summary_excerpt }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="mel-booking-trust-strip" role="presentation">
      <ul class="mel-booking-trust-strip__list">
        {% if event_mode == 'paid' %}
          <li class="mel-booking-trust-strip__item">{{ 'Secure checkout'|t }}</li>
          <li class="mel-booking-trust-strip__item">{{ 'Review before payment'|t }}</li>
          <li class="mel-booking-trust-strip__item">{{ 'Hosted on MyEventLane'|t }}</li>
        {% elseif event_mode == 'rsvp' %}
          <li class="mel-booking-trust-strip__item">{{ 'RSVP free — no payment on this step'|t }}</li>
          <li class="mel-booking-trust-strip__item">{{ 'Review your details before you confirm'|t }}</li>
          <li class="mel-booking-trust-strip__item">{{ 'Hosted on MyEventLane'|t }}</li>
        {% else %}
          <li class="mel-booking-trust-strip__item">{{ 'Hosted on MyEventLane'|t }}</li>
        {% endif %}
        <li class="mel-booking-trust-strip__item mel-booking-trust-strip__item--help">
          <a class="mel-booking-trust-strip__link" href="{{ path('myeventlane_help_centre.home') }}">{{ 'Help Centre'|t }}</a>
          <span class="mel-booking-trust-strip__sep" aria-hidden="true">·</span>
          <a class="mel-booking-trust-strip__link" href="{{ path('myeventlane_support.page') }}">{{ 'Support'|t }}</a>
        </li>
      </ul>
    </div>

    {% set mel_has_booking_signals =
      mel_signal_is_community
      or mel_signal_booked_count is not null
      or mel_signal_remaining_spots is not null
      or mel_signal_urgency_label
      or mel_signal_trust_label
    %}
    {% if mel_has_booking_signals %}
      <section class="mel-booking-signals" aria-label="{{ 'Booking signals'|t }}">
        <div class="mel-booking-signals__list">
          {% if mel_signal_is_community %}
            <span class="mel-booking-signals__pill mel-booking-signals__pill--community">{{ '✨ Community-powered event'|t }}</span>
          {% endif %}
          {% if mel_signal_remaining_spots is not null and mel_signal_remaining_spots <= 10 %}
            <span class="mel-booking-signals__pill mel-booking-signals__pill--urgency">{{ '🔥 Only @count spots left'|t({'@count': mel_signal_remaining_spots}) }}</span>
          {% elseif mel_signal_urgency_label %}
            <span class="mel-booking-signals__pill mel-booking-signals__pill--urgency">{{ mel_signal_urgency_label }}</span>
          {% endif %}
          {% if mel_signal_booked_count is not null and mel_signal_booked_count > 0 %}
            <span class="mel-booking-signals__pill mel-booking-signals__pill--booked">{{ '🎟️ @count people already booked'|t({'@count': mel_signal_booked_count}) }}</span>
          {% endif %}
          {% if mel_signal_trust_label %}
            <span class="mel-booking-signals__pill mel-booking-signals__pill--trust">{{ mel_signal_trust_label }}</span>
          {% endif %}
        </div>
      </section>
    {% endif %}

    {# CONTENT — context + decision #}
    <div class="mel-booking-container">
      {% if event_description is defined and event_description is not empty %}
        <div class="mel-event-description-card">
          <h3 class="mel-event-description-card__title" id="mel-event-book-about">{{ 'About this event'|t }}</h3>
          <div class="mel-event-description-card__body" aria-labelledby="mel-event-book-about">
            {{ event_description }}
          </div>
        </div>
      {% endif %}

      <div class="mel-booking-layout{% if event_mode != 'paid' %} mel-booking-layout--single{% endif %}">
        <div class="mel-booking-layout__main">
          <div class="mel-ticket-panel mel-event-book__form" aria-labelledby="mel-ticket-panel-title">
            <h2 class="mel-ticket-panel__title" id="mel-ticket-panel-title">
              {% if event_mode == 'paid' %}
                {{ 'Choose your tickets'|t }}
              {% elseif event_mode == 'rsvp' %}
                {{ 'RSVP free'|t }}
              {% elseif event_mode == 'external' %}
                {{ 'View details'|t }}
              {% else %}
                {{ 'View details'|t }}
              {% endif %}
            </h2>

            {% if event_mode == 'paid' %}
              <p class="mel-ticket-panel__lead">{{ 'You can review everything before you continue to checkout.'|t }}</p>
            {% endif %}

            <div class="mel-ticket-panel__body mel-event-book__form-body">
              {% if matrix_form is not empty %}
                {{ matrix_form }}
              {% elseif rsvp_form is not empty %}
                {{ rsvp_form }}
              {% else %}
                <div class="mel-alert mel-alert--info" role="status">
                  {% if event_mode == 'none' %}
                    {{ 'Registration opens soon.'|t }}
                  {% else %}
                    {{ "We couldn't load the booking form. Please refresh the page."|t }}
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>

        {% if event_mode == 'paid' %}
          <aside class="mel-booking-layout__aside" aria-label="{{ 'Order summary'|t }}">
            <div class="mel-booking-summary" data-mel-booking-summary>
              <header class="mel-booking-summary__header">
                <h3 class="mel-booking-summary__title">{{ 'Your selection'|t }}</h3>
                <p class="mel-booking-summary__kicker mel-text--muted">{{ 'Clear pricing before you pay.'|t }}</p>
              </header>
              <div class="mel-booking-summary__body">
                <div class="mel-booking-summary__empty" data-mel-summary-empty>
                  <p class="mel-booking-summary__empty-line">{{ 'Choose your tickets to see your total.'|t }}</p>
                  <p class="mel-booking-summary__empty-line mel-booking-summary__empty-line--soft">{{ 'You can review everything before checkout.'|t }}</p>
                </div>
                <div class="mel-booking-summary__items" data-mel-summary-items aria-live="polite" aria-atomic="true"></div>
                <div class="mel-booking-summary__subtotal" data-mel-summary-subtotal hidden>
                  <span class="mel-booking-summary__subtotal-label">{{ 'Subtotal'|t }}</span>
                  <span class="mel-booking-summary__subtotal-value" data-mel-summary-subtotal-value></span>
                </div>
              </div>
              <footer class="mel-booking-summary__footer">
                <p class="mel-booking-summary__cta-note">{{ 'Tickets go to your cart first — continue to checkout when you are ready.'|t }}</p>
              </footer>
            </div>
          </aside>
        {% endif %}
      </div>
    </div>

  </div>
</div>
