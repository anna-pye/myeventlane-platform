{#
/**
 * @file
 * Theme override for checkout completion step (no Commerce sidebar on this step).
 *
 * Wraps confirmation in mel-checkout-shell for consistent width and message adjacency.
 */
#}
<div class="mel-checkout-shell mel-checkout-shell--complete">
{% if order_entity %}
  {% include '@myeventlane_theme/commerce/commerce-checkout-completion.html.twig' with {
    order_entity: order_entity,
    order_totals: order_totals|default(null),
    order_items_attendees: order_items_attendees|default({}),
    mel_event_image_urls: mel_event_image_urls|default({}),
    mel_help_centre_url: mel_help_centre_url|default(null),
    mel_calendar_links: mel_calendar_links|default({}),
    mel_event_url: mel_event_url|default(''),
    mel_logged_in: mel_logged_in|default(false),
    mel_contextual_help_checkout_confirmation: mel_contextual_help_checkout_confirmation|default(null),
    mel_confirm_paid: mel_confirm_paid|default(false),
    mel_confirmation_has_tickets: mel_confirmation_has_tickets|default(false),
    mel_donation_total_formatted: mel_donation_total_formatted|default(null),
    mel_order_pricing_breakdown: mel_order_pricing_breakdown|default(null),
    mel_checkout_completion: mel_checkout_completion|default(null),
  } %}
{% else %}
  <div class="mel-checkout mel-checkout--complete">
    {{ form }}
  </div>
{% endif %}
</div>
