{#
/**
 * @file
 * Theme override for checkout completion page.
 *
 * MEL success layout: clear, honest paid vs free vs donation-only copy.
 * Preserves order/ticket/calendar logic; presentation + totals labelling only.
 *
 * Available variables:
 * - order_entity: The order entity.
 * - order_totals: Order totals from OrderTotalSummary (optional).
 * - order_items_attendees: Map of order item ID => attendee rows.
 * - mel_event_image_urls: Map of event node ID => image URL.
 * - mel_calendar_links: apple/google/outlook URLs.
 * - mel_event_url: Canonical URL to first event.
 * - mel_logged_in: Current user authenticated.
 * - mel_confirm_paid: TRUE when order total is non-zero (from preprocess).
 * - mel_confirmation_has_tickets: TRUE when order has non-donation line items.
 * - mel_donation_total_formatted: Donation sum formatted for display, or NULL.
 * - mel_order_pricing_breakdown: GST-aware subtotal/tax/fees from Commerce adjustments (or NULL).
 */
#}
{% set mel_confirm_paid = mel_confirm_paid|default(false) %}
{% set mel_confirmation_has_tickets = mel_confirmation_has_tickets|default(false) %}

{# Build events and ticket_items from order #}
{% set events = [] %}
{% set ticket_items = [] %}

{% for item in order_entity.getItems() %}
  {% if item.bundle() == 'checkout_donation' or item.bundle() == 'platform_donation' or item.bundle() == 'rsvp_donation' %}
  {% elseif item.bundle() == 'boost' %}
  {% else %}
    {% set ticket_items = ticket_items|merge([item]) %}
    {% set event = null %}
    {% if item.hasField('field_target_event') and not item.get('field_target_event').isEmpty() %}
      {% set event = item.get('field_target_event').entity %}
    {% endif %}
    {% if not event %}
      {% set pe = item.getPurchasedEntity() %}
      {% if pe and pe.hasField('field_event') and not pe.get('field_event').isEmpty() %}
        {% set event = pe.get('field_event').entity %}
      {% endif %}
    {% endif %}
    {% if not event %}
      {% set pe = item.getPurchasedEntity() %}
      {% if pe and pe.getProduct() %}
        {% set product = pe.getProduct() %}
        {% if product.hasField('field_event') and not product.get('field_event').isEmpty() %}
          {% set event = product.get('field_event').entity %}
        {% endif %}
      {% endif %}
    {% endif %}
    {% if event and event not in events %}
      {% set events = events|merge([event]) %}
    {% endif %}
  {% endif %}
{% endfor %}

<div class="mel-confirmation mel-confirmation--frictionless">
  <header class="mel-confirmation__hero">
    <div class="mel-confirmation__hero-icon" aria-hidden="true">✓</div>
    <div class="mel-confirmation__hero-content">
      {% if mel_donation_total_formatted and not mel_confirmation_has_tickets %}
        <h1 class="mel-confirmation__title">{{ 'Thank you'|t }}</h1>
      {% elseif mel_confirmation_has_tickets %}
        <h1 class="mel-confirmation__title">{{ "You're in"|t }}</h1>
      {% else %}
        <h1 class="mel-confirmation__title">{{ 'Done'|t }}</h1>
      {% endif %}
      <p class="mel-confirmation__subtitle">
        {{ 'Confirmation sent to <strong>@email</strong>.'|t({'@email': order_entity.getEmail()})|raw }}
      </p>
      <p class="mel-confirmation__reference">
        {{ 'Order'|t }} <strong>#{{ order_entity.getOrderNumber() }}</strong>
      </p>
    </div>
  </header>

  <div class="mel-confirmation__main">
    {% if events|length > 0 %}
      {% for event in events %}
        <section class="mel-confirmation-card mel-confirmation-card--event-summary mel-confirmation__summary" aria-labelledby="mel-confirmation-event-summary-{{ event.id() }}">
          {% set event_image_url = mel_event_image_urls[event.id()] ?? null %}
          {% if event_image_url %}
            <div class="mel-confirmation-card__media">
              <img src="{{ event_image_url }}" alt="" class="mel-confirmation-card__image" loading="lazy" />
            </div>
          {% endif %}
          <div class="mel-confirmation-card__body">
            <p class="mel-confirmation-card__eyebrow">{{ 'Event summary'|t }}</p>
            <h2 id="mel-confirmation-event-summary-{{ event.id() }}" class="mel-confirmation-card__title">{{ event.label() }}</h2>
            <div class="mel-confirmation-card__meta">
              {% if event.hasField('field_event_start') and not event.get('field_event_start').isEmpty() %}
                <span class="mel-confirmation-card__date">{{ event.get('field_event_start').value|date('l, F j, Y') }}</span>
                <span class="mel-confirmation-card__time">
                  {{ event.get('field_event_start').value|date('g:i A') }}
                  {% if event.hasField('field_event_end') and not event.get('field_event_end').isEmpty() %}
                    - {{ event.get('field_event_end').value|date('g:i A') }}
                  {% endif %}
                </span>
              {% endif %}
              {% if event.hasField('field_location') and not event.get('field_location').isEmpty() %}
                {% set loc = event.get('field_location')[0] %}
                {% if loc %}
                  {% set loc_parts = [] %}
                  {% if loc.address_line1 %}{% set loc_parts = loc_parts|merge([loc.address_line1]) %}{% endif %}
                  {% if loc.locality %}{% set loc_parts = loc_parts|merge([loc.locality]) %}{% endif %}
                  {% if loc.administrative_area %}{% set loc_parts = loc_parts|merge([loc.administrative_area]) %}{% endif %}
                  {% if loc.postal_code %}{% set loc_parts = loc_parts|merge([loc.postal_code]) %}{% endif %}
                  <span class="mel-confirmation-card__location">{{ loc_parts|join(', ') }}</span>
                {% endif %}
              {% endif %}
            </div>

            <div class="mel-confirmation-card__tickets">
              {% for item in ticket_items %}
                {% set item_event = null %}
                {% if item.hasField('field_target_event') and not item.get('field_target_event').isEmpty() %}
                  {% set item_event = item.get('field_target_event').entity %}
                {% endif %}
                {% if not item_event %}
                  {% set pe = item.getPurchasedEntity() %}
                  {% if pe and pe.hasField('field_event') and not pe.get('field_event').isEmpty() %}
                    {% set item_event = pe.get('field_event').entity %}
                  {% endif %}
                {% endif %}
                {% if not item_event and item.getPurchasedEntity() and item.getPurchasedEntity().getProduct() %}
                  {% set prod = item.getPurchasedEntity().getProduct() %}
                  {% if prod.hasField('field_event') and not prod.get('field_event').isEmpty() %}
                    {% set item_event = prod.get('field_event').entity %}
                  {% endif %}
                {% endif %}
                {% if item_event and item_event.id() == event.id() %}
                  <div class="mel-confirmation-card__ticket-row">
                    <span class="mel-confirmation-card__ticket-name">
                      {% set pe = item.getPurchasedEntity() %}
                      {{ pe ? pe.label() : item.getTitle() }}
                    </span>
                    <span class="mel-confirmation-card__ticket-qty">x {{ item.getQuantity()|number_format(0) }}</span>
                    <span class="mel-confirmation-card__ticket-price">{{ item.getTotalPrice()|commerce_price_format }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </section>
      {% endfor %}
    {% elseif ticket_items|length > 0 %}
      <section class="mel-confirmation-card mel-confirmation__summary">
        <div class="mel-confirmation-card__body">
          <p class="mel-confirmation-card__eyebrow">{{ 'Event summary'|t }}</p>
          <h2 class="mel-confirmation-card__title">{{ 'Your tickets'|t }}</h2>
          <div class="mel-confirmation-card__tickets">
            {% for item in ticket_items %}
              <div class="mel-confirmation-card__ticket-row">
                <span class="mel-confirmation-card__ticket-name">
                  {% set pe = item.getPurchasedEntity() %}
                  {{ pe ? pe.label() : item.getTitle() }}
                </span>
                <span class="mel-confirmation-card__ticket-qty">x {{ item.getQuantity()|number_format(0) }}</span>
                <span class="mel-confirmation-card__ticket-price">{{ item.getTotalPrice()|commerce_price_format }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {% if mel_donation_total_formatted %}
      <div class="mel-confirmation-card mel-confirmation-card--donation">
        <div class="mel-confirmation-card__body">
          <h2 class="mel-confirmation-card__title">{{ 'Donation confirmed'|t }}</h2>
          <p class="mel-confirmation-card__donation-amount">{{ mel_donation_total_formatted|raw }}</p>
        </div>
      </div>
    {% endif %}

    <div class="mel-confirmation-actions mel-confirmation-actions--frictionless">
      {% if mel_confirmation_has_tickets and order_entity.getCustomerId() %}
        <a href="{{ url('entity.commerce_order.user_view', {'user': order_entity.getCustomerId(), 'commerce_order': order_entity.id()}) }}"
           class="mel-confirmation-button mel-confirmation-button--primary">
          {{ 'View ticket'|t }}
        </a>
      {% elseif order_entity.getCustomerId() %}
        <a href="{{ url('entity.commerce_order.user_view', {'user': order_entity.getCustomerId(), 'commerce_order': order_entity.id()}) }}"
           class="mel-confirmation-button mel-confirmation-button--primary">
          {{ 'View order'|t }}
        </a>
      {% else %}
        <div class="mel-confirmation-actions__guest-note">
          <p>{{ 'Your ticket link and order details have been sent to your email.'|t }}</p>
          <p>{{ 'Order number: <strong>@order_number</strong>'|t({'@order_number': order_entity.getOrderNumber()})|raw }}</p>
        </div>
      {% endif %}

      {% if mel_calendar_links|length > 0 %}
        <div class="mel-calendar-actions mel-calendar-actions--frictionless">
          {% if mel_calendar_links.apple is defined and mel_calendar_links.apple %}
            <a href="{{ mel_calendar_links.apple }}" class="mel-calendar-btn mel-calendar-btn--primary" target="_blank" rel="noopener noreferrer">{{ 'Add to calendar'|t }}</a>
          {% endif %}
          {% if mel_calendar_links.google is defined and mel_calendar_links.google %}
            <a href="{{ mel_calendar_links.google }}" class="mel-calendar-btn" target="_blank" rel="noopener noreferrer">{{ 'Google Calendar'|t }}</a>
          {% endif %}
          {% if mel_calendar_links.outlook is defined and mel_calendar_links.outlook %}
            <a href="{{ mel_calendar_links.outlook }}" class="mel-calendar-btn" target="_blank" rel="noopener noreferrer">{{ 'Outlook'|t }}</a>
          {% endif %}
        </div>
      {% endif %}

      {% if mel_event_url and events|length > 0 %}
        <a href="{{ mel_event_url }}" class="mel-confirmation-button mel-confirmation-button--secondary">
          {{ 'View event'|t }}
        </a>
      {% endif %}
    </div>
  </div>
</div>
