{#
/**
 * @file
 * Theme override for the cart form.
 *
 * Copy and empty states are supplied from PHP (MelReadinessHelper,
 * GovernedOperationalTemplates). Twig is presentation-only.
 *
 * Available variables:
 * - form: The cart form with all its elements.
 * - mel_cart_shell_labels: label map (when myeventlane_surface is enabled).
 * - mel_cart_empty_state: mel_empty_state render array when the cart has no line items.
 * - grouped_items, items_without_event, item_event_map: from preprocess.
 * - mel_cart_order_summary_build: grouped order summary from MelCheckoutSummaryPresenter (cart surface).
 */
#}
{% set L = mel_cart_shell_labels|default({}) %}

<div class="mel-cart">
  <div class="mel-cart-items">
    <div class="mel-cart-header">
      <h1 class="mel-cart-title">
        {{ L.page_title|default('') }}
        {% if form['#order_items']|length > 0 %}
          <span class="mel-cart-count">({{ form['#order_items']|length }} {{ form['#order_items']|length == 1 ? L.item_singular|default('') : L.items_plural|default('') }})</span>
        {% endif %}
      </h1>
    </div>

    {% if form['#order_items']|length > 0 %}
      {% if grouped_items is defined and grouped_items|length > 0 %}
        <div class="mel-cart-event-overview" role="region" aria-label="{{ L.events_region|default('') }}">
          {% for event_id, group in grouped_items %}
            <article class="mel-cart-event-chip" data-event-id="{{ event_id }}">
              <h2 class="mel-cart-event-chip__title">{{ group.event.label() }}</h2>
              {% if group.event.hasField('field_event_start') and not group.event.get('field_event_start').isEmpty() %}
                <div class="mel-cart-event-chip__meta">
                  <span class="mel-cart-event-chip__date">{{ group.event.get('field_event_start').value|date('F j, Y') }}</span>
                  {% if group.event.hasField('field_location') and not group.event.get('field_location').isEmpty() %}
                    {% set loc = group.event.get('field_location')[0] %}
                    {% if loc %}
                      {% set loc_parts = [] %}
                      {% if loc.address_line1 %}{% set loc_parts = loc_parts|merge([loc.address_line1]) %}{% endif %}
                      {% if loc.locality %}{% set loc_parts = loc_parts|merge([loc.locality]) %}{% endif %}
                      {% if loc.administrative_area %}{% set loc_parts = loc_parts|merge([loc.administrative_area]) %}{% endif %}
                      {% if loc_parts|length > 0 %}
                        <span class="mel-cart-event-chip__location">{{ loc_parts|join(', ') }}</span>
                      {% endif %}
                    {% endif %}
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
        {% if items_without_event is defined and items_without_event|length > 0 %}
          <p class="mel-cart-event-overview__note">{{ L.misc_items_note|default('') }}</p>
        {% endif %}
      {% endif %}

      <div class="mel-cart__intro">
        <h2>{{ L.review_heading|default('') }}</h2>
        <p>{{ L.review_intro|default('') }}</p>
      </div>

      <div class="mel-cart-items-table"{% if item_event_map is defined %} data-item-event-map="{{ item_event_map|json_encode }}"{% endif %}>
        {{ form.header }}
        {{ form.output }}
      </div>

    {% else %}
      <div class="mel-cart-empty mel-cart-empty--inline mel-cart-empty--governed">
        {% if mel_cart_empty_state is defined %}
          {{ mel_cart_empty_state }}
        {% endif %}
        <nav class="mel-checkout-trust-nav mel-cart-trust-nav mel-cart-empty__support" aria-label="{{ L.help_region_short|default('') }}">
          <a class="mel-checkout-trust-nav__link" href="{{ path('myeventlane_help_centre.home') }}">{{ L.help_centre|default('') }}</a>
          <span class="mel-checkout-trust-nav__sep" aria-hidden="true">·</span>
          <a class="mel-checkout-trust-nav__link" href="{{ path('myeventlane_support.page') }}">{{ L.support|default('') }}</a>
        </nav>
      </div>
    {% endif %}
  </div>

  {% if form['#order_items']|length > 0 %}
    <aside class="mel-cart-summary">
      <h2 class="mel-cart-summary-title">{{ L.order_summary_title|default('') }}</h2>

      <div class="mel-cart-summary-presented mel-cart-summary-presented--governed">
        {% if mel_cart_order_summary_build is defined %}
          {{ mel_cart_order_summary_build }}
        {% elseif form.totals is defined %}
          {{ form.totals }}
        {% endif %}
      </div>

      {% if mel_operational_fulfillment_execution_customer %}
        <div class="mel-cart-fulfillment-execution mel-mt-3" role="region" aria-label="{{ 'On-site fulfillment'|t }}">
          {{ mel_operational_fulfillment_execution_customer }}
        </div>
      {% endif %}

      <div class="mel-cart-actions">
        {{ form.actions }}
      </div>

      <nav class="mel-checkout-trust-nav mel-cart-trust-nav mel-cart-summary__support" aria-label="{{ L.help_region_short|default('') }}">
        <a class="mel-checkout-trust-nav__link" href="{{ path('myeventlane_help_centre.home') }}">{{ L.help_centre|default('') }}</a>
        <span class="mel-checkout-trust-nav__sep" aria-hidden="true">·</span>
        <a class="mel-checkout-trust-nav__link" href="{{ path('myeventlane_support.page') }}">{{ L.support|default('') }}</a>
      </nav>
    </aside>
  {% endif %}
</div>
