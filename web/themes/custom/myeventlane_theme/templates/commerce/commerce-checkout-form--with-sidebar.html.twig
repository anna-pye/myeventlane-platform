{#
/**
 * @file
 * Theme override for checkout form with sidebar (MEL governed shell).
 *
 * Complete step: layout regions for confirmation + summary + actions.
 * Other steps: trust nav, grid, pane sections, summary aside.
 */
#}
<div class="mel-checkout-shell">
{% if form['#step_id'] is defined and form['#step_id'] == 'complete' and order_entity %}
  <div class="layout-checkout-form clearfix mel-checkout mel-checkout--complete mel-checkout-complete-layout">
    <div class="layout-region layout-region-checkout-main mel-checkout-complete-layout__main">
      {% include '@myeventlane_theme/commerce/commerce-checkout-completion.html.twig' with {
        order_entity: order_entity,
        order_totals: order_totals|default(null),
        order_items_attendees: order_items_attendees|default({}),
        mel_event_image_urls: mel_event_image_urls|default({}),
        mel_help_centre_url: mel_help_centre_url|default(null),
        mel_calendar_links: mel_calendar_links|default({}),
        mel_event_url: mel_event_url|default(''),
        mel_logged_in: mel_logged_in|default(false),
        mel_contextual_help_checkout_confirmation: mel_contextual_help_checkout_confirmation|default(null),
        mel_confirm_paid: mel_confirm_paid|default(false),
        mel_confirmation_has_tickets: mel_confirmation_has_tickets|default(false),
        mel_donation_total_formatted: mel_donation_total_formatted|default(null),
        mel_order_pricing_breakdown: mel_order_pricing_breakdown|default(null),
      } %}
    </div>
    <div class="layout-region layout-region-checkout-secondary mel-checkout-complete-layout__secondary">
      <h3 class="mel-checkout-summary-heading">{% trans %}Booking summary{% endtrans %}</h3>
      {{ form.sidebar }}
      {% if mel_support_panel is defined and mel_support_panel %}
        <div class="mel-checkout__summary-region mel-checkout__summary-region--help" role="region" aria-label="{{ 'Help'|t }}">
          {{ mel_support_panel }}
        </div>
      {% endif %}
    </div>
    <div class="layout-region layout-region-checkout-footer mel-checkout-complete-layout__footer">
      {{ form.actions }}
    </div>
  </div>
  {% if form.mel_checkout_confidence is defined %}
    <div class="visually-hidden">{{ form.mel_checkout_confidence }}</div>
  {% endif %}
{% else %}
  {# mel-checkout--compact-flow: QA hook + SCSS anchor for compact density (any Commerce flow). #}
  <div class="mel-checkout mel-checkout--compact-flow">
    {% if title %}
      <h1 class="mel-checkout__title">{{ title }}</h1>
    {% endif %}

    {% if form.progress %}
      <div class="mel-checkout__progress">
        {{ form.progress }}
      </div>
    {% endif %}

    <div class="mel-checkout__intro">
      <h2>{{ 'Secure checkout'|t }}</h2>
      <p>{{ "You're almost done — review your details and complete your booking."|t }}</p>
    </div>

    <div class="mel-checkout-trust">
      <p>{{ '✔ Secure checkout'|t }}</p>
      <p>{{ '✔ Instant confirmation'|t }}</p>
      {% if mel_checkout_refunds_available|default(false) %}
        <p>{{ '✔ Refunds available'|t }}</p>
      {% else %}
        <p>{{ '✔ Easy refunds (if enabled)'|t }}</p>
      {% endif %}
    </div>

    <div class="mel-checkout__helper">
      {{ "We'll only use your details to send your ticket."|t }}
    </div>

    <div class="mel-checkout__layout mel-checkout__grid mel-checkout__grid--sidebar-flow">
      <div class="mel-checkout__main">

        {{ form|without('progress', 'sidebar', 'actions', 'payment_information', 'mel_buyer_details', 'mel_donation', 'mel_legal_consent', 'ticket_holder_paragraph', 'mel_checkout_confidence') }}

        {% if mel_contextual_help_checkout is not defined or not mel_contextual_help_checkout %}
          {% if mel_help_checkout_refund is defined and mel_help_checkout_refund %}
            <div class="mel-contextual-help mel-contextual-help--checkout">
              {{ mel_help_checkout_refund }}
            </div>
          {% endif %}
        {% endif %}
        {% if not (mel_contextual_help_checkout is defined and mel_contextual_help_checkout) %}
          {% if mel_help_checkout_guide is defined and mel_help_checkout_guide %}
            <div class="mel-contextual-help mel-contextual-help--checkout mel-contextual-help--checkout-guide">
              {{ mel_help_checkout_guide }}
            </div>
          {% endif %}
        {% endif %}
        {% if mel_help_checkout_assistant is defined and mel_help_checkout_assistant %}
          <div class="mel-checkout-help-assistant">
            {{ mel_help_checkout_assistant }}
          </div>
        {% endif %}

        {% if form.mel_buyer_details is defined %}
          <div class="mel-checkout-section mel-checkout-section--buyer">
            {{ form.mel_buyer_details }}
          </div>
        {% endif %}

        {% if form.ticket_holder_paragraph is defined and form.ticket_holder_paragraph|render|striptags|trim is not empty %}
          <div class="mel-checkout-section mel-checkout-section--attendees">
            <h3 class="mel-checkout-heading">{{ 'Attendee details'|t }}</h3>
            {{ form.ticket_holder_paragraph }}
          </div>
        {% endif %}

        {% if form.mel_donation is defined %}
          <div class="mel-checkout-section mel-checkout-section--donation">
            {{ form.mel_donation }}
          </div>
        {% endif %}

        {% if form.mel_legal_consent is defined %}
          <div class="mel-checkout-section mel-checkout-section--legal">
            {{ form.mel_legal_consent }}
          </div>
        {% endif %}

        {% if form.payment_information is defined %}
          <div class="mel-checkout-section mel-checkout-section--payment">
            <h3 class="mel-checkout-heading">{{ 'Payment'|t }}</h3>
            {{ form.payment_information }}
          </div>
        {% endif %}

        {% if form.actions %}
          <div class="mel-checkout-section mel-checkout-section--cta">
            <div class="mel-checkout-cta">
              {# Total is form.actions.mel_cta_total (form_alter) so it rebuilds with AJAX next to submit. #}
              {{ form.actions }}
              {% if form.payment_information is defined %}
                <p class="mel-checkout__cta-note">{{ 'Your payment will be processed securely.'|t }}</p>
              {% endif %}
              <p class="mel-checkout-cta__recovery">
                <a class="mel-checkout-cta__recovery-link mel-util-link" href="{{ path('myeventlane_support.page') }}">{{ 'Something wrong? Contact support'|t }}</a>
              </p>
              <nav class="mel-checkout-support-foot" aria-label="{{ 'Help and support'|t }}">
                <a class="mel-util-link mel-util-link--support" href="{{ path('myeventlane_help_centre.home') }}">{{ 'Help Centre'|t }}</a>
                <span class="mel-checkout-support-foot__sep" aria-hidden="true">·</span>
                <a class="mel-util-link mel-util-link--support" href="{{ path('myeventlane_support.page') }}">{{ 'Support'|t }}</a>
              </nav>
            </div>
          </div>
        {% endif %}
      </div>

      {% if form.sidebar is defined %}
        {% set sidebar_content = form.sidebar|render %}
        {% if (mel_contextual_help_checkout is defined and mel_contextual_help_checkout) or (sidebar_content|striptags|trim is not empty) or (mel_support_panel is defined and mel_support_panel) %}
          <aside class="mel-checkout__summary" aria-label="{{ 'Order summary'|t }}">
            <div class="mel-checkout__summary-inner">
              <h2 id="mel-checkout-summary-heading" class="mel-checkout__summary-title">{{ 'Your order'|t }}</h2>
              {% if mel_contextual_help_checkout is defined and mel_contextual_help_checkout %}
                <div class="mel-contextual-help mel-contextual-help--checkout mel-contextual-help--checkout-card mel-checkout__summary-region">
                  {{ mel_contextual_help_checkout }}
                </div>
              {% endif %}
              <div class="mel-checkout__summary-region mel-checkout__summary-region--order">
                {{ sidebar_content }}
              </div>
              {% if mel_support_panel is defined and mel_support_panel %}
                <div class="mel-checkout__summary-region mel-checkout__summary-region--help" role="region" aria-label="{{ 'Help'|t }}">
                  {{ mel_support_panel }}
                </div>
              {% endif %}
            </div>
          </aside>
        {% endif %}
      {% endif %}
    </div>
  </div>
  {% if form.mel_checkout_confidence is defined %}
    <div class="visually-hidden">{{ form.mel_checkout_confidence }}</div>
  {% endif %}
{% endif %}
</div>
