{#
/**
 * @file
 * Theme override for RSVP booking form (event book page, $0 product).
 *
 * Use `element` (the form root render array from core). Do not expose the root
 * as `form` and render `{{ form }}` inside <form> — that can re-invoke the form
 * theme and nest <form> tags. Access children as element.KEY (same pattern as
 * core’s available `element` in form preprocess).
 *
 * IMPORTANT: Legal consent is rendered BEFORE the optional donation section so
 * POST field order matches a sane DOM order. When donation is enabled, many
 * inputs (toggle, radios, amount) precede legal in the tree; if legal were
 * rendered after donation, PHP max_input_vars could truncate later fields and
 * drop legal_consent[] from $_POST while the user still saw checked boxes.
 *
 * Alter-added elements (help link, donation_unavailable) are printed explicitly
 * or via |without() so they stay inside this single <form>.
 */
#}
<form{{ attributes }}>
  {% if element is defined and element is iterable %}
    {{ element.form_build_id }}
    {{ element.form_token }}
    {{ element.form_id }}
    {{ element.event_id }}
    {{ element.product_id }}
    {{ element.variation_id }}

    <div class="mel-rsvp-sidebar">
      <div class="mel-rsvp-card">
        {% if element.intro %}
          <div class="mel-rsvp-intro">
            {{ element.intro }}
          </div>
        {% endif %}
        <div class="mel-rsvp-section mel-rsvp-core">
          {% if element.attendee_details is defined %}
            {{ element.attendee_details }}
          {% else %}
            {% if element.first_name is defined %}{{ element.first_name }}{% endif %}
            {% if element.last_name is defined %}{{ element.last_name }}{% endif %}
            {% if element.name is defined %}{{ element.name }}{% endif %}
            {% if element.email is defined %}{{ element.email }}{% endif %}
            {% if element.phone is defined %}{{ element.phone }}{% endif %}
            {% if element.guests is defined %}{{ element.guests }}{% endif %}
          {% endif %}
        </div>
        {% if element.optional_details is defined %}
          <div class="mel-rsvp-section">
            {{ element.optional_details }}
          </div>
        {% endif %}
        {% if element.accessibility_needs %}
          <div class="mel-rsvp-section mel-rsvp-section--collapsed">
            <button type="button" class="mel-rsvp-toggle" data-target="accessibility" aria-expanded="false" aria-controls="mel-rsvp-accessibility">
              {{ 'Accessibility needs (optional)'|t }}
              <span class="mel-chevron" aria-hidden="true">+</span>
            </button>
            <div class="mel-rsvp-collapsible" id="mel-rsvp-accessibility">
              {{ element.accessibility_needs }}
            </div>
          </div>
        {% endif %}
        <hr class="mel-divider">
        <div class="mel-rsvp-legal">
          <p class="mel-legal-text">
            {{ 'We collect your name and email to process your RSVP. Read our Privacy Policy for details.'|t }}
          </p>
          {% if element.legal_consent %}
            {{ element.legal_consent }}
          {% endif %}
        </div>
        {# Optional attendee → vendor donation: after legal so POST includes consent fields before many donation inputs. #}
        {% if element.donation_section %}
          <div class="mel-rsvp-section mel-rsvp-section--collapsed">
            <button type="button" class="mel-rsvp-toggle" data-target="support" aria-expanded="true" aria-controls="mel-rsvp-support">
              {{ 'Support this event (optional)'|t }}
              <span class="mel-chevron" aria-hidden="true">–</span>
            </button>
            <div class="mel-rsvp-collapsible is-open" id="mel-rsvp-support">
              {{ element.donation_section }}
            </div>
          </div>
        {% endif %}
        {% if element.donation_unavailable is defined %}
          {{ element.donation_unavailable }}
        {% endif %}
        {% if element.donation_amount is defined %}
          {{ element.donation_amount }}
        {% endif %}
        <div class="mel-rsvp-trust mel-rsvp-trust--compact" role="region" aria-label="{{ 'RSVP confirmation'|t }}">
          <ul class="mel-rsvp-trust__list">
            <li>{{ 'No payment required'|t }}</li>
            <li>{{ 'Your RSVP will be confirmed by email'|t }}</li>
          </ul>
        </div>
        <div class="mel-rsvp-submit">
          {{ element.actions }}
        </div>
        {# Any other alter-added elements; keeps them inside the single form. #}
        {{ element|without(
          'form_build_id', 'form_token', 'form_id', 'event_id', 'product_id', 'variation_id',
          'mel_help_rsvp_after',
          'intro', 'first_name', 'last_name', 'name', 'email', 'phone', 'guests',
          'attendee_details', 'optional_details', 'accessibility_needs',
          'legal_consent', 'donation_section', 'donation_unavailable', 'donation_amount', 'actions'
        ) }}
      </div>
    </div>
  {% else %}
    {{ children }}
  {% endif %}
</form>
