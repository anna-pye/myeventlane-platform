{#
/**
 * @file
 * Ticket selection form on the event book page: access code, ticket list, sticky CTA.
 *
 * Render only known children explicitly. Do not use a trailing form|without() catch-all:
 * it can re-output actions (duplicate "Add to cart") and other elements already printed.
 */
#}
<form{{ attributes.addClass('mel-booking-form').setAttribute('data-mel-booking-form', '1') }}>
  {{ form.form_build_id }}
  {{ form.form_token }}
  {{ form.form_id }}

  <div class="mel-booking-form__stack">
    {{ form.waitlist_offer_banner }}
    {{ form.sold_out }}

    <div class="mel-booking__intro">
      <h2>{{ 'Choose your tickets'|t }}</h2>
      <p>{{ "Select how many tickets you'd like. You can review everything before checkout."|t }}</p>
    </div>

    <div class="mel-ticket-list">
      {{ form.tickets }}
    </div>

    {% if form.donation_support is defined %}
      {{ form.donation_support }}
    {% endif %}

    <div class="mel-booking__reassurance">
      <span>{{ '✔ Clear pricing'|t }}</span>
      <span>{{ '✔ No hidden fees'|t }}</span>
      <span>{{ '✔ Instant confirmation'|t }}</span>
    </div>

    {% if form.booking_access is defined %}
      <div class="mel-access-code mel-access-code--after-tickets">
        {{ form.booking_access }}
      </div>
    {% endif %}

    {{ form.tier_waitlist }}
    {{ form.empty }}
  </div>

  {# Checkout CTA renders on the book page after the operational add-on form (sibling forms). #}
</form>
