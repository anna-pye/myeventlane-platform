{#
/**
 * @file
 * RSVP public form wrapper.
 *
 * IMPORTANT:
 * - Render the form exactly once to avoid duplicate buttons.
 * - Styling and sticky CTA are handled via CSS/JS by targeting .form-actions.
 *
 * Available variables:
 * - form: The form render array.
 * - attributes: Form attributes.
 */
#}

<form{{ attributes }}>
  <div class="mel-rsvp">
    <div class="mel-rsvp__shell">
      <header class="mel-rsvp__header" role="banner">
        <div class="mel-rsvp__title">{{ 'RSVP for this event'|t }}</div>
        <div class="mel-rsvp__subtitle">{{ 'Please complete your details below.'|t }}</div>
      </header>

      <div class="mel-rsvp__card">
        <div class="mel-rsvp__content">
          {{ form }}
        </div>
      </div>

      <div class="mel-rsvp__fineprint" aria-hidden="true">
        {{ 'We respect your privacy. Your details are used only for event administration.'|t }}
      </div>
    </div>
  </div>
</form>
