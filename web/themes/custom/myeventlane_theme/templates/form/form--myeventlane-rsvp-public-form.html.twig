{#
/**
 * @file
 * RSVP public form wrapper (event book page when no $0 Commerce product).
 *
 * IMPORTANT:
 * - Use {{ children }} for the form subtree. Do not render the full element as
 *   "form" — that re-invokes the form theme and nests <form> tags, which breaks
 *   browser submission and legal consent POST data.
 * - Styling and sticky CTA use CSS/JS targeting .form-actions.
 *
 * Available variables (see system form.html.twig / FormPreprocess::preprocessForm):
 * - attributes: Form element attributes.
 * - children: Pre-rendered child elements of the form.
 */
#}
<form{{ attributes }}>
  <div class="mel-rsvp">
    <div class="mel-rsvp__shell">
      <header class="mel-rsvp__header" role="banner">
        <div class="mel-rsvp__title">{{ 'RSVP for this event'|t }}</div>
        <div class="mel-rsvp__subtitle">{{ 'Please complete your details below.'|t }}</div>
      </header>

      <div class="mel-rsvp__card">
        <div class="mel-rsvp__content">
          {{ children }}
        </div>
      </div>

      <div class="mel-rsvp__fineprint" aria-hidden="true">
        {{ 'We respect your privacy. Your details are used only for event administration.'|t }}
      </div>
    </div>
  </div>
</form>
