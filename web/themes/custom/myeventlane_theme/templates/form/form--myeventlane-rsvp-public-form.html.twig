{#
/**
 * @file
 * Public RSVP form — structured conversion path (event book / RSVP block).
 *
 * Use `element` (the form root render array). Do not render the root as `form`
 * inside <form> — that can re-invoke the form theme and nest <form> tags.
 *
 * Order: (1) You’re going → (2) Who is coming → (3) Guest details → (4) Confirm.
 * Alter-added elements (e.g. mel_help_rsvp_after) are printed explicitly.
 * Do not add a trailing element|without() catch-all — it can re-render leftover
 * keys and duplicate fields (breaks POST / submit).
 */
#}
<form{{ attributes }}>
  {% if element is defined and element is iterable %}
    {{ element.form_build_id }}
    {{ element.form_token }}
    {{ element.form_id }}
    {{ element.event_id }}

    <div class="mel-rsvp">
      <div class="mel-rsvp__shell">
        <div class="mel-rsvp__card">
          <div class="mel-rsvp__content">
            {% if element.mel_help_rsvp_after is defined %}
              <div class="mel-rsvp__help mel-rsvp__help--top" role="note">
                {{ element.mel_help_rsvp_after }}
              </div>
            {% endif %}

            <section class="mel-rsvp__step mel-rsvp__step--intent">
              {{ element.intent }}
            </section>

            <section class="mel-rsvp__step mel-rsvp__step--who">
              {{ element.people }}
            </section>

            <section class="mel-rsvp__step mel-rsvp__step--details">
              {{ element.details }}
            </section>

            {% if element.donation is defined %}
              <section class="mel-rsvp__step mel-rsvp__step--donation">
                {{ element.donation }}
              </section>
            {% endif %}

            {{ element.optional }}

            {% if element.accessibility is defined %}
              {{ element.accessibility }}
            {% endif %}

            <section class="mel-rsvp__step mel-rsvp__step--confirm">
              {{ element.legal }}
            </section>

            <div class="mel-rsvp__cta">
              {{ element.actions }}
            </div>
          </div>
        </div>

        <div class="mel-rsvp__fineprint" aria-hidden="true">
          {{ 'We respect your privacy. Your details are used only for event administration.'|t }}
        </div>
      </div>
    </div>
  {% else %}
    {{ children }}
  {% endif %}
</form>
