{#
/**
 * @file
 * User login: same contract as core form.html.twig — one form element via
 * attributes, rendered field tree via children. MEL layout wraps children only.
 *
 * Do not pass children through #inline_template (breaks render pipeline).
 * Do not render form.name / form.pass manually.
 */
#}
<form{{ attributes }}>
  <div class="mel-auth-page">
    <div class="mel-auth-container">
      <div class="mel-auth-card">

        <div class="mel-auth-header">
          <h2>{{ 'Welcome back'|t }}</h2>
        </div>

        <div class="mel-auth-form mel-auth-form-wrapper">
          {{ children }}
        </div>

        <div class="mel-auth-footer">
          <a href="{{ path('user.pass') }}">{{ 'Forgot password?'|t }}</a>
          <br>
          <a href="{{ path('user.register') }}">{{ 'Create an account'|t }}</a>
        </div>

      </div>
    </div>
  </div>
</form>
