{#
/**
 * @file
 * Theme override for Event node add/edit form.
 *
 * Simple template that lets the wizard control the structure.
 */
#}

<form{{ attributes }}>
  {# Required hidden form elements #}
  {{ form.form_build_id }}
  {{ form.form_token }}
  {{ form.form_id }}

  {# Canonical wizard rendering (vendor workflow routes). #}
  {% if form.mel_wizard %}
    {{ form.mel_wizard }}
    {% if form.wizard_current_step %}
      {{ form.wizard_current_step }}
    {% endif %}
    {% if form.wizard_target_step %}
      {{ form.wizard_target_step }}
    {% endif %}
    {% if form.field_event_vendor %}
      {{ form.field_event_vendor }}
    {% endif %}
    {% if form.field_event_store %}
      {{ form.field_event_store }}
    {% endif %}
    {% if form.actions %}
      {{ form.actions }}
    {% endif %}
  {% else %}
    {# Raw node form fallback (admin advanced edit / non-wizard contexts). #}
    {{ form|without('form_build_id', 'form_token', 'form_id') }}
  {% endif %}
</form>
