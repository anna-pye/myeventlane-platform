{#
/**
 * @file
 * MyEventLane override for the search results list.
 *
 * Uses the canonical event grid wrapper.
 */
#}

{% if items or empty %}
  {% if title is not empty %}
    <h3>{{ title }}</h3>
  {% endif %}

  {% if items %}
    {% include '@myeventlane_theme/includes/mel-event-skeleton-block.html.twig' %}
    <div class="mel-event-grid mel-grid mel-grid--events" data-loaded="false">
      {% for item in items %}
        {{ item.value }}
      {% endfor %}
    </div>
  {% else %}
    {{ empty }}
  {% endif %}
{% endif %}
