{#
/**
 * @file
 * Search results list — compact_commerce event grid.
 */
#}

{% if items or empty %}
  {% if title is not empty %}
    <h3>{{ title }}</h3>
  {% endif %}

  {% if items %}
    <div class="mel-event-grid mel-grid mel-grid--events">
      {% for item in items %}
        {{ item.value }}
      {% endfor %}
    </div>
  {% else %}
    {{ empty }}
  {% endif %}
{% endif %}
