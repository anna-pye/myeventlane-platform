{#
/**
 * @file
 * Theme override for /vendor/help — same chrome as public Help Centre pages.
 */
#}
<div class="mel-help-page">
  {% if page.breadcrumb %}
    <div class="mel-help-page__breadcrumb">
      {{ page.breadcrumb }}
    </div>
  {% endif %}

  {% if page.highlighted %}
    <div class="mel-help-page__highlighted">
      {{ page.highlighted }}
    </div>
  {% endif %}

  <main class="mel-help-page__content" role="main">
    <a id="main-content" tabindex="-1"></a>
    {{ page.content }}
  </main>
</div>
