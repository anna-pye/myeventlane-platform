{#
/**
 * @file
 * Template for Saved events (mel_saved_events, page) — grid of event cards.
 * View title is output by views-view.html.twig (view wrapper).
 */
#}
{% if rows %}
  <div class="mel-event-grid mel-grid mel-grid--events">
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  </div>
{% endif %}
