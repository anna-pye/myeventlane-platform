{#
/**
 * @file
 * Free & RSVP rail — MEL empty state when no rows.
 */
#}
{% if rows %}
  {{ rows }}
{% elseif empty %}
  <div class="view-empty mel-empty-state mel-empty-state--governed" role="status">
    {{ empty }}
  </div>
{% else %}
  {% include '@myeventlane_theme/includes/mel-view-empty-events.html.twig' with {
    title: 'No free gatherings right now'|t,
    text: 'Browse all events or check community spotlight on the homepage.'|t,
    cta_primary_url: '/events',
    cta_primary_label: 'Explore events'|t,
  } %}
{% endif %}
