{#
/**
 * @file
 * mel_home_events — default unformatted (tonight, under_20, etc.).
 *
 * Wraps rows in `.mel-grid.mel-grid--events` (MEL v2 single grid system).
 */
#}
{% if rows %}
  {% include '@myeventlane_theme/includes/mel-event-skeleton-block.html.twig' %}
  <div class="mel-event-grid mel-grid mel-grid--events" data-loaded="false">
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  </div>
{% endif %}
