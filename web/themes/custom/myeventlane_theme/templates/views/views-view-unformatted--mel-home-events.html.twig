{#
/**
 * @file
 * mel_home_events — default unformatted (tonight, under_20, etc.).
 *
 * Wraps rows in `.mel-grid.mel-grid--events` (MEL v2 single grid system).
 */
#}
{% if rows %}
  <div class="mel-event-grid mel-grid mel-grid--events">
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  </div>
{% else %}
  {% include '@myeventlane_theme/includes/mel-view-empty-events.html.twig' %}
{% endif %}
