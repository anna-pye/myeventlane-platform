{#
/**
 * @file
 * Template override for Taxonomy Term view (event listings).
 *
 * Canonical event grid wrapper - no additional markup.
 */
#}
{% if rows %}
  {% include '@myeventlane_theme/includes/mel-event-skeleton-block.html.twig' %}
  <div class="mel-event-grid mel-grid mel-grid--events" data-loaded="false">
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  </div>
{% endif %}
