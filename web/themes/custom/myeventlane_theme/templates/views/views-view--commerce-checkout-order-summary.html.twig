{#
/**
 * @file
 * Theme override for View commerce_checkout_order_summary (embed in checkout pane).
 *
 * Mirrors commerce-checkout-order-summary.html.twig structure:
 * - Root: .checkout-order-summary .mel-checkout-order-summary .mel-checkout-order-summary--view
 * - Line items: .mel-checkout-order-summary__items
 * - Totals footer: .mel-checkout-order-summary__totals (Commerce order total summary)
 *
 * @see views-view.html.twig
 * @see templates/commerce/commerce-checkout-order-summary.html.twig
 */
#}
{%
  set classes = [
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'checkout-order-summary',
    'mel-checkout-order-summary',
    'mel-checkout-order-summary--view',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    <div class="mel-checkout-order-summary__embed-title">
      {{ title }}
    </div>
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <header class="mel-checkout-order-summary__header">
      {{ header }}
    </header>
  {% endif %}

  {{ exposed }}
  {{ attachment_before }}

  {% if rows %}
    <div class="mel-checkout-order-summary__items">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="mel-checkout-order-summary__empty view-empty">
      {{ empty }}
    </div>
  {% endif %}
  {{ pager }}

  {{ attachment_after }}
  {{ more }}

  {% if footer %}
    <div class="mel-checkout-order-summary__totals">
      {{ footer }}
    </div>
  {% endif %}

  {{ feed_icons }}
</div>
