{#
/**
 * @file
 * Default unformatted rows — event grid or core fallback.
 */
#}
{% if mel_is_event_view|default(false) %}
  {% if title %}
    <h3>{{ title }}</h3>
  {% endif %}
  {% include '@myeventlane_theme/includes/mel-event-rows-wrapper.html.twig' %}
{% else %}
  {% if title %}
    <h3>{{ title }}</h3>
  {% endif %}

  {% for row in rows %}
    {%
      set row_classes = [
        default_row_class ? 'views-row',
      ]
    %}
    <div{{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
{% endif %}
