{#
/**
 * @file
 * Homepage tonight events grid.
 */
#}
{% if rows %}
  {% include '@myeventlane_theme/includes/mel-event-skeleton-block.html.twig' %}
  <div class="mel-event-grid mel-grid mel-grid--events mel-home-event-grid mel-home-event-grid--tonight" data-loaded="false">
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  </div>
{% else %}
  {% include '@myeventlane_theme/includes/mel-view-empty-events.html.twig' with {
    title: 'Nothing listed for tonight yet'|t,
    text: 'Explore what’s on this weekend or browse all upcoming events.'|t,
    cta_primary_url: path('view.upcoming_events.page_events'),
    cta_primary_label: 'Explore events'|t,
    cta_secondary_url: path('view.upcoming_events.page_this_weekend'),
    cta_secondary_label: 'Browse this weekend'|t,
  } %}
{% endif %}
