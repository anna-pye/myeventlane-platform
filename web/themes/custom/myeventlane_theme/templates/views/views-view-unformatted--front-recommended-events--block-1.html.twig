{#
/**
 * @file
 * Recommended events unformatted template (block_1).
 * Renders event cards in the canonical 4-across grid.
 *
 * IMPORTANT:
 * - This display is intended to be embedded in the homepage region output.
 * - Use `.mel-grid.mel-grid--events` (layout/_grid.scss).
 * - Do not output section headers or wrapper shells here (homepage template owns layout).
 * - When there are 0 rows, output nothing so the homepage section can collapse.
 */
#}

{% if rows %}
  {% include '@myeventlane_theme/includes/mel-event-skeleton-block.html.twig' %}
  <div class="mel-event-grid mel-grid mel-grid--events" data-loaded="false" aria-label="{{ 'Events worth exploring'|t }}">
    {% for row in rows %}
      {{- row.content -}}
    {% endfor %}
  </div>
{% endif %}
