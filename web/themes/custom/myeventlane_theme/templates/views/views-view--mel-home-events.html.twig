{#
/**
 * @file
 * Template for mel_home_events View wrapper.
 *
 * Mirrors core views-view.html.twig row/empty handling. Outputting only {{ rows }}
 * hides the empty state and can look like “nothing renders” when the query
 * returns no rows or the view is building an empty result set.
 */
#}
{% if rows -%}
  {{ rows }}
{% elseif empty -%}
  {{ empty }}
{% endif -%}
