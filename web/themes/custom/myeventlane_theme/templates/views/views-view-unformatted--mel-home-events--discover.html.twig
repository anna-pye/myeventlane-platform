{#
/**
 * @file
 * mel_home_events — discover display: stable auto-fill grid.
 */
#}
{% if rows %}
  <div class="mel-event-grid mel-grid mel-grid--events" role="list" aria-label="{{ 'Discover events'|t }}">
    {% for row in rows %}
      <div role="listitem">{{ row.content }}</div>
    {% endfor %}
  </div>
{% endif %}
