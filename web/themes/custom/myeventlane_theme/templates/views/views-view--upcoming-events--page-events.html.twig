{#
/**
 * @file
 * upcoming_events — page_events: browse layout, filters aside, results grid.
 */
#}
{{ attach_library('myeventlane_theme/mel-events-discovery') }}

<div class="mel-browse__layout">
  <aside id="mel-browse-filters" class="mel-browse__filters" aria-label="{{ 'Filters'|t }}">
    {% include '@myeventlane_theme/components/browse/mel-browse-filters.twig' with {
      display_id: view.current_display,
      mel_browse_active_filters: mel_browse_active_filters|default(false),
    } %}
    <div class="mel-filter-panel">
      <h3 class="mel-filter-panel__title">{{ 'Filter events'|t }}</h3>
      {{ exposed }}
    </div>
  </aside>

  <main class="mel-browse__results">
    <a href="#mel-browse-filters" class="mel-filter-button mel-btn mel-btn-secondary">{{ 'Filter'|t }}</a>

    {% if mel_browse_result_count is defined %}
      <p class="mel-browse-results-count" role="status">
        {{ '@count events'|t({'@count': mel_browse_result_count}) }}
      </p>
    {% endif %}

    {% if mel_browse_active_filters|default(false) %}
      <div class="mel-active-filters" role="status">
        {{ 'Filters applied — showing matching results.'|t }}
      </div>
    {% endif %}

    {% if view.result %}
      {{ rows }}
    {% else %}
      <div class="mel-empty mel-empty--browse" role="status">
        <h3 class="mel-empty__title">{{ 'No events found'|t }}</h3>
        <p class="mel-empty__text">{{ 'Try adjusting your filters or browse a different category.'|t }}</p>
      </div>
    {% endif %}

    {{ pager }}
  </main>
</div>
