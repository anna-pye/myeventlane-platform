{#
/**
 * @file
 * Community spotlight + Worth checking out carousel.
 *
 * Editorial groups rotate via mel-spotlight-rotator (one group visible at a time).
 * Lower rail reuses mel-card-carousel (Swiper) for overflow boosted events.
 */
#}
{% if rows %}
  {{ attach_library('myeventlane_theme/global-styling') }}
  {% set row_count = rows|length %}

  {% if row_count >= 1 %}
    {% if row_count == 1 %}
      <div class="mel-spotlight-editorial">
        <div class="mel-spotlight-editorial__feature">
          <div class="mel-spotlight-editorial__story mel-spotlight-editorial__story--lead">
            {{ rows[0].content }}
          </div>
        </div>
      </div>
    {% else %}
      <section
        class="mel-spotlight-rotator"
        data-mel-spotlight-rotator
        aria-roledescription="{{ 'carousel'|t }}"
        aria-label="{{ 'Community spotlight'|t }}"
        tabindex="0"
      >
        <div class="mel-spotlight-rotator__track">
          {% for i in 0..(row_count - 1) %}
            {% set support_1_index = (i + 1) % row_count %}
            {% set support_2_index = (i + 2) % row_count %}
            <div class="mel-spotlight-rotator__slide{% if loop.first %} is-active{% endif %}" aria-hidden="{{ loop.first ? 'false' : 'true' }}">
              <div class="mel-spotlight-editorial">
                <div class="mel-spotlight-editorial__feature">
                  <div class="mel-spotlight-editorial__story mel-spotlight-editorial__story--lead">
                    {{ rows[i].content }}
                  </div>
                </div>
                {% if row_count >= 2 %}
                  <div class="mel-spotlight-editorial__supporting">
                    <div class="mel-spotlight-editorial__story mel-spotlight-editorial__story--support">
                      {{ rows[support_1_index].content }}
                    </div>
                    {% if row_count >= 3 %}
                      <div class="mel-spotlight-editorial__story mel-spotlight-editorial__story--support">
                        {{ rows[support_2_index].content }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        {% include '@myeventlane_theme/components/card-carousel/carousel-nav.twig' only %}
      </section>
    {% endif %}
  {% endif %}

  {% set carousel_rows = row_count >= 3 ? rows|slice(3) : [] %}
  {% if carousel_rows %}
    {% set carousel_items = [] %}
    {% for row in carousel_rows %}
      {% set carousel_items = carousel_items|merge([row.content]) %}
    {% endfor %}
    {% if row_count >= 3 %}
      <div class="mel-spotlight-carousel__header mel-section__header">
        <div class="mel-section__intro">
          <h2 class="mel-section__title">{{ 'Worth checking out'|t }}</h2>
          <p class="mel-section__subtitle">{{ 'Hidden gems the community is loving'|t }}</p>
        </div>
      </div>
    {% endif %}
    <div class="mel-spotlight-carousel">
      {% include '@myeventlane_theme/components/card-carousel/card-carousel.twig' with {
        items: carousel_items,
        carousel_id: 'mel-spotlight-carousel',
        carousel_modifier: 'mel-card-carousel--spotlight',
        nav_below: true,
      } only %}
    </div>
  {% endif %}
{% endif %}
