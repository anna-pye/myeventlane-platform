{#
/**
 * @file
 * Main site footer.
 * Condensed 3-column layout (Find events, Host events, About) + compact legal row.
 */
#}

{% block footer %}
<footer class="mel-footer" role="contentinfo">

  <div class="mel-footer__container">

    <div class="mel-footer__nav">

      <div class="mel-footer__col">
        <h4>{{ 'Find events'|t }}</h4>
        {{ drupal_menu('footer-find') }}
        {% if mel_footer_categories %}
          <ul class="mel-footer__dynamic">
            {% for item in mel_footer_categories %}
              <li><a href="{{ item.url }}">{{ item.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="mel-footer__col">
        <h4>{{ 'Host events'|t }}</h4>
        {{ drupal_menu('footer-host') }}
        {% if mel_is_organiser %}
          <ul class="mel-footer__dynamic">
            <li><a href="{{ path('myeventlane_vendor.console.dashboard') }}">{{ 'Vendor dashboard'|t }}</a></li>
            <li><a href="{{ path('myeventlane_vendor.console.settings') }}">{{ 'Vendor settings'|t }}</a></li>
          </ul>
        {% endif %}
      </div>

      <div class="mel-footer__col mel-footer__col--wide">
        <h4>{{ 'About MyEventLane'|t }}</h4>
        {{ drupal_menu('footer-about') }}
        <div class="mel-footer__trust">
          <span>{{ 'Community-first platform'|t }}</span>
          <span>{{ 'Secure payments via Stripe'|t }}</span>
          <span>{{ 'Australian-owned'|t }}</span>
        </div>
      </div>

    </div>

  </div>

  {# Dark Footer Base Section #}
  <div class="mel-footer__base">
    <div class="mel-footer__base-inner">

      <div class="mel-footer__brand">
        <img src="{{ base_path }}{{ directory }}/images/logo.svg" alt="MyEventLane">
      </div>

      <div class="mel-footer__meta">
        <span>© {{ "now"|date("Y") }} MyEventLane</span>
        <a href="/privacy">{{ 'Privacy'|t }}</a>
        <a href="/terms">{{ 'Terms'|t }}</a>
        <a href="{{ path('myeventlane_legal.cookies') }}">{{ 'Cookies'|t }}</a>
      </div>

      <div class="mel-footer__action">
        <a href="{{ path('myeventlane_event_studio.create') }}" class="mel-footer__create-link">
          {{ 'Create event'|t }}
        </a>
      </div>

    </div>
  </div>

</footer>
{% endblock %}
