{#
/**
 * @file
 * Launch-ready marketplace footer: CTA band, trust strip, four columns, legal bar.
 */
#}

{% block footer %}
<footer class="mel-footer" role="contentinfo">

  <div class="mel-footer__container">

    {% if mel_footer_show_cta_band|default(false) %}
      {% include '@myeventlane_theme/includes/mel-footer-cta-band.html.twig' %}
    {% endif %}

    {% if mel_footer_trust_items %}
      <div class="mel-footer__trust-strip" role="list" aria-label="{{ 'Platform trust signals'|t }}">
        {% for item in mel_footer_trust_items %}
          <span class="mel-footer__trust-item mel-trust-badge" role="listitem">
            <span class="mel-trust-badge__icon" aria-hidden="true">✓</span>
            <span>{{ item.label }}</span>
          </span>
        {% endfor %}
      </div>
    {% endif %}

    {% include '@myeventlane_theme/includes/mel-footer-brand-block.html.twig' %}

    <nav class="mel-footer__nav" aria-label="{{ 'Footer navigation'|t }}">
      {% for section in mel_footer_sections|default([]) %}
        <div class="mel-footer__col mel-footer__accordion" id="mel-footer-section-{{ section.id }}">
          <button
            type="button"
            class="mel-footer__accordion-toggle"
            aria-expanded="false"
            aria-controls="mel-footer-panel-{{ section.id }}"
          >
            {{ section.title }}
          </button>
          <h2 class="mel-footer__col-heading">{{ section.title }}</h2>
          <div class="mel-footer__accordion-panel" id="mel-footer-panel-{{ section.id }}">
            <ul class="menu mel-footer__links">
              {% for link in section.links %}
                <li>
                  <a
                    href="{{ link.url }}"
                    {% if link.external|default(false) %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endfor %}
    </nav>

  </div>

  <div class="mel-footer__base">
    <div class="mel-footer__base-inner">

      <nav class="mel-footer__meta" aria-label="{{ 'Legal links'|t }}">
        <span>© {{ "now"|date("Y") }} MyEventLane</span>
        <a href="/privacy">{{ 'Privacy'|t }}</a>
        <a href="/terms">{{ 'Terms'|t }}</a>
        <a href="{{ path('myeventlane_legal.cookies') }}">{{ 'Cookies'|t }}</a>
        <a href="#klaro" class="mel-footer__cookie-settings open-consent-manager">{{ 'Privacy &amp; Cookie Settings'|t }}</a>
        <a href="{{ path('myeventlane_front.sitemap') }}">{{ 'Sitemap'|t }}</a>
      </nav>

    </div>
  </div>

</footer>
{% endblock %}
