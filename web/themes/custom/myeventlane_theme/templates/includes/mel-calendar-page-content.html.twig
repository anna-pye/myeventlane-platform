{#
/**
 * @file
 * Calendar page body — below unified discovery hero and context filters.
 *
 * FullCalendar output is always rendered via page.content (events_calendar view).
 * Do not gate on parallel preprocess queries — see Phase 3E ownership audit.
 */
#}
<div class="mel-calendar-page mel-event-planner" data-mel-event-planner>
  <nav class="mel-event-planner__tabs" role="tablist" aria-label="{{ 'Event planning sections'|t }}">
    <button id="mel-event-planner-tab-discover" class="mel-event-planner__tab is-active" type="button" role="tab" aria-controls="mel-event-planner-panel-discover" aria-selected="true" data-mel-event-planner-tab="discover">
      <span class="mel-event-planner__tab-icon" aria-hidden="true">⌕</span>
      <span><strong>{{ 'Discover'|t }}</strong><small>{{ 'Find something good'|t }}</small></span>
    </button>
    <button id="mel-event-planner-tab-planner" class="mel-event-planner__tab" type="button" role="tab" aria-controls="mel-event-planner-panel-planner" aria-selected="false" data-mel-event-planner-tab="planner" tabindex="-1">
      <span class="mel-event-planner__tab-icon" aria-hidden="true">♡</span>
      <span><strong>{{ 'My planner'|t }}</strong><small>{{ 'Saved for later'|t }}</small></span>
    </button>
    <button id="mel-event-planner-tab-bookings" class="mel-event-planner__tab" type="button" role="tab" aria-controls="mel-event-planner-panel-bookings" aria-selected="false" data-mel-event-planner-tab="bookings" tabindex="-1">
      <span class="mel-event-planner__tab-icon" aria-hidden="true">◎</span>
      <span><strong>{{ 'My bookings'|t }}</strong><small>{{ 'You’re going'|t }}</small></span>
    </button>
  </nav>

  <section id="mel-event-planner-panel-discover" class="mel-event-planner__panel is-active" role="tabpanel" aria-labelledby="mel-event-planner-tab-discover" data-mel-event-planner-panel="discover" tabindex="0">
    <div class="mel-event-planner__quick-links" aria-label="{{ 'Quick event searches'|t }}">
      <span>{{ 'Explore'|t }}</span>
      <a href="{{ path('view.upcoming_events.page_today') }}">{{ 'Today'|t }}</a>
      <a href="{{ path('view.upcoming_events.page_this_weekend') }}">{{ 'This weekend'|t }}</a>
      <a href="{{ path('view.upcoming_events.page_free') }}">{{ 'Free'|t }}</a>
      <a href="{{ path('view.upcoming_events.page_events') }}">{{ 'All events'|t }}</a>
    </div>

    {% if mel_calendar_this_week_rail|default([]) is not empty %}
      <section class="mel-event-planner__coming-up" aria-labelledby="mel-event-planner-coming-up-title">
        <header class="mel-event-planner__section-heading">
          <div>
            <span class="mel-event-planner__eyebrow">{{ 'Next three events'|t }}</span>
            <h2 id="mel-event-planner-coming-up-title">{{ 'Coming up next'|t }}</h2>
            <p>{{ 'The next events in date order, ready to explore.'|t }}</p>
          </div>
          <a href="{{ path('view.upcoming_events.page_events') }}">{{ 'See all events'|t }}</a>
        </header>
        <div class="mel-calendar-rail__grid">{{ mel_calendar_this_week_rail }}</div>
      </section>
    {% endif %}

    <section class="mel-event-planner__month" aria-labelledby="mel-event-planner-month-title">
      <header class="mel-event-planner__section-heading">
        <div>
          <span class="mel-event-planner__eyebrow">{{ 'Pick a date'|t }}</span>
          <h2 id="mel-event-planner-month-title">{{ 'Browse by date'|t }}</h2>
          <p>{{ 'Switch between month, week, day and list views.'|t }}</p>
        </div>
      </header>
      <div class="mel-calendar-card">
        <div class="mel-content mel-content--calendar">
          {{ page.content }}
        </div>
      </div>
    </section>
  </section>

  {{ mel_calendar_personalisation }}
</div>
