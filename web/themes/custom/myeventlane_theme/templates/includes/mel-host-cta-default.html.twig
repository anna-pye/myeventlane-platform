{#
/**
 * @file
 * Default host band when the host_cta region has no blocks (homepage).
 */
#}
<section class="mel-section mel-section--host mel-section--full" aria-labelledby="mel-host-cta-title">
  <div class="mel-container mel-container--wide">
    <div class="mel-host-cta">
      <div class="mel-host-cta__copy">
        <h2 id="mel-host-cta-title" class="mel-host-cta__title">{{ 'Empowering event creators everywhere.'|t }}</h2>
        <p class="mel-host-cta__text">
          {{ 'Create a free RSVP or ticketed event, reach your audience, and manage it all in one place.'|t }}
        </p>
      </div>
      <div class="mel-host-cta__actions">
        <a class="mel-btn mel-btn--cta" href="{{ path('entity.node.add_form', {'node_type': 'event'}) }}">{{ 'Create event'|t }}</a>
        <a class="mel-btn mel-btn-secondary" href="{{ path('myeventlane_vendor.create_event_gateway') }}">{{ 'How hosting works'|t }}</a>
      </div>
    </div>
  </div>
</section>
