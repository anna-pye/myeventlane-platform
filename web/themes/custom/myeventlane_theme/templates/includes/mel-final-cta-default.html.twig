{#
/**
 * @file
 * Default final CTA when the bottom_cta region has no blocks (homepage).
 */
#}
<section class="mel-section mel-section--final-cta mel-section--full" aria-labelledby="mel-final-cta-title">
  <div class="mel-container mel-container--wide">
    <div class="mel-final-cta">
      <h2 id="mel-final-cta-title" class="mel-final-cta__title">{{ 'Ready to host your next event?'|t }}</h2>
      <p class="mel-final-cta__text">{{ 'List for free, sell tickets with transparent fees, and grow your community on MyEventLane.'|t }}</p>
      <a class="mel-btn mel-btn--cta mel-final-cta__btn" href="{{ path('myeventlane_vendor.create_event_gateway') }}">{{ 'Start hosting'|t }}</a>
    </div>
  </div>
</section>
