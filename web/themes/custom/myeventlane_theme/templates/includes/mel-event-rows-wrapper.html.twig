{#
/**
 * @file
 * Wraps View event rows in the canonical event grid (homepage-style cards).
 *
 * Variables:
 * - rows: View rows.
 * - mel_is_event_view: TRUE for event Views using compact_commerce or list_card.
 * - wrapper_aria_label: Optional aria-label for the grid.
 */
#}
{% if rows %}
  {% if mel_is_event_view|default(false) %}
    <div class="mel-event-grid mel-grid mel-grid--events"{% if wrapper_aria_label|default('') %} aria-label="{{ wrapper_aria_label }}"{% endif %}>
      {% for row in rows %}
        {{- row.content -}}
      {% endfor %}
    </div>
  {% else %}
    {% for row in rows %}
      {%
        set row_classes = [
          default_row_class|default(true) ? 'views-row',
        ]
      %}
      <div{{ row.attributes.addClass(row_classes) }}>
        {{- row.content -}}
      </div>
    {% endfor %}
  {% endif %}
{% endif %}
