{#
/**
 * @file
 * Calm, branded 404 recovery content.
 */
#}
{{ attach_library('myeventlane_theme/mel-error-pages') }}

<main class="mel-err mel-err--404 mel-err--in-page" data-mel-error-inline>
  <div class="mel-err__decoration" aria-hidden="true"></div>
  <section class="mel-err__panel" aria-labelledby="mel-404-title">
    <p class="mel-err__code" aria-hidden="true">404</p>
    <p class="mel-err__eyebrow">{{ 'MyEventLane'|t }}</p>
    <h1 id="mel-404-title" class="mel-err__title">{{ "We couldn't find that page"|t }}</h1>
    <p class="mel-err__lede">
      {{ 'The link may be old, or the page may have moved. You can keep exploring from here.'|t }}
    </p>
    <div class="mel-err__actions">
      <a class="mel-err__btn mel-err__btn--primary" href="{{ path('view.upcoming_events.page_events') }}">{{ 'Browse events'|t }}</a>
      <a class="mel-err__btn mel-err__btn--secondary" href="{{ path('<front>') }}">{{ 'Go to homepage'|t }}</a>
    </div>
    <p class="mel-err__support">
      {{ 'Think something is broken?'|t }}
      <a href="{{ path('myeventlane_support.page') }}">{{ 'Open Help Centre'|t }}</a>
    </p>
  </section>
</main>
