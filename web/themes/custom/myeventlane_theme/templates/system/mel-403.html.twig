{#
/**
 * @file
 * Calm, branded 403 recovery content.
 */
#}
{{ attach_library('myeventlane_theme/mel-error-pages') }}

<main class="mel-err mel-err--403 mel-err--in-page" data-mel-error-inline>
  <div class="mel-err__decoration" aria-hidden="true"></div>
  <section class="mel-err__panel" aria-labelledby="mel-403-title">
    <p class="mel-err__code" aria-hidden="true">403</p>
    <p class="mel-err__eyebrow">{{ 'MyEventLane'|t }}</p>
    <h1 id="mel-403-title" class="mel-err__title">{{ "You can't access this page"|t }}</h1>
    <p class="mel-err__lede">
      {{ 'You may need to sign in with the account that owns this booking or organiser workspace.'|t }}
    </p>
    <div class="mel-err__actions">
      <a class="mel-err__btn mel-err__btn--primary" href="{{ path('user.login') }}">{{ 'Sign in'|t }}</a>
      <a class="mel-err__btn mel-err__btn--secondary" href="{{ path('<front>') }}">{{ 'Go to homepage'|t }}</a>
    </div>
    <p class="mel-err__support">
      {{ 'Still stuck?'|t }}
      <a href="{{ path('myeventlane_support.page') }}">{{ 'Contact support'|t }}</a>
    </p>
  </section>
</main>
