{#
  Keep this minimal and do not break admin.
#}
{% if mel_attach_commerce_styling|default(false) %}
  {{ attach_library('myeventlane_theme/commerce-styling') }}
{% endif %}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token|raw }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token|raw }}">
    <js-placeholder token="{{ placeholder_token|raw }}">
  </head>
  <body{{ attributes }}>
    {% include '@myeventlane_theme/includes/mel-liquid-glass-svg.html.twig' %}
    <a href="#main-content" class="visually-hidden focusable">Skip to main content</a>
    <noscript>
      <style>
        .mel-event-skeleton[data-skeleton] { display: none !important; }
        .mel-event-grid[data-loaded="false"] { display: grid !important; opacity: 1 !important; }
      </style>
    </noscript>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token|raw }}">
  </body>
</html>
