{#
/**
 * @file
 * Canonical MEL public event card — variants: standard, featured, compact, featured_hero.
 *
 * All variants share one `.mel-event-card` DOM. `featured_hero` normalizes to
 * `--featured` + `--hero` (legacy variant name retained for Views/templates).
 *
 * Node listings: preprocess supplies card_* (myeventlane_theme_preprocess_node).
 * Views field rows: pass title, url, image, date_full, location, category, ticket_type, etc.
 * Image pill badges use `event_ui` (see myeventlane_event_finalize_event_ui in myeventlane_event).
 * @see myeventlane_event.module — myeventlane_event_preprocess_node() (event_ui for all view modes).
 */
#}
{% set _variant_raw = variant|default(mel_event_card_variant|default('standard')) %}
{% set _layout = layout|default(mel_event_card_layout|default('')) %}
{% set _is_hero = _variant_raw in ['featured_hero', 'editorial'] or (_variant_raw == 'featured' and _layout == 'hero') %}
{% set _variant = _variant_raw in ['featured_hero', 'editorial'] ? 'featured' : (_variant_raw == 'list' ? 'standard' : _variant_raw) %}
{% set _css_modifier = _variant_raw in ['featured_hero', 'editorial'] ? 'editorial' : (_variant_raw in ['compact', 'list'] ? _variant_raw : _variant) %}

{% set _title = card_title|default(title|default('')) %}
{% set _url = card_url|default(url|default('#')) %}
{% set _img = card_image_url|default(image|default('')) %}
{% set _img_render = card_image_render|default(image_render|default(null)) %}
{% set _img_alt = card_image_alt|default(_title) %}
{% set _time = card_time_range|default(date_full|default('')) %}
{% set _loc = card_location|default(location|default('')) %}
{% set _type = card_type|default(ticket_type|default('paid')) %}

{% set _status_primary = card_status_primary|default('') %}
{% set _status_secondary = card_status_secondary|default('') %}
{% set _status_mod = card_status_modifier|default('default') %}
{# Sold-out is communicated by top badge + CTA; avoid duplicate "Sold out" in body. #}
{% if event_ui is defined and (event_ui.is_sold_out|default(false) == true) and (_status_mod|default('') == 'sold-out') %}
  {% set _status_primary = '' %}
  {% set _status_secondary = '' %}
{% endif %}

{% if event_ui is defined and (event_ui.show_cta|default(true)) is same as(false) %}
  {% set _cta = '' %}
  {% set _mel_cta_semantic = 'hidden' %}
{% else %}
  {% set _mel_cta_semantic = event_ui is defined ? event_ui.cta_type|default('primary') : 'primary' %}
  {% set _cta = card_cta_label|default('') %}
  {% if _cta == '' and event_ui is defined and (event_ui.cta_label|default(''))|trim|length > 0 %}
    {% set _cta = event_ui.cta_label %}
  {% endif %}
  {% if _cta == '' %}
    {% if _type == 'rsvp' %}
      {% set _cta = 'RSVP free'|t %}
    {% elseif _type == 'external' %}
      {% set _cta = 'View details'|t %}
    {% elseif _is_hero %}
      {% set _cta = 'Get tickets'|t %}
    {% else %}
      {% set _cta = 'Get your tickets'|t %}
    {% endif %}
  {% endif %}
{% endif %}

{% set is_promoted = is_promoted|default(false) %}
{% set is_past = is_past|default(false) %}
{% set _low_stock = card_is_low_stock|default(false) %}
{% set _attendance = card_attendance|default(null) %}

{% set _category = card_category|default(null) %}
{% if not _category and category is defined and category %}
  {% set _category = { 'label': category, 'url': null } %}
{% endif %}

{% set _state_badge_type = 'highlight' %}
{# Image pill: event_ui only — is_sold_out > image_badge (boost/Featured from myeventlane_event_finalize_event_ui) > category. #}
{% set _image_badge_label = null %}
{% if _is_hero and is_promoted %}
  {% set _image_badge_label = 'Featured'|t %}
  {% set _state_badge_type = 'apricot' %}
{% elseif event_ui is defined and (event_ui.is_sold_out|default(false) == true) %}
  {% set _image_badge_label = 'Sold out'|t %}
  {% set _state_badge_type = 'warning' %}
{% elseif event_ui is defined and event_ui.image_badge_label|default('')|trim|length > 0 %}
  {% set _image_badge_label = event_ui.image_badge_label %}
  {% set _st = event_ui.image_badge_type|default('apricot') %}
  {% set _state_badge_type = _st == 'highlight' ? 'apricot' : _st %}
{% elseif _category and _category.label %}
  {% set _image_badge_label = _category.label %}
  {% set _state_badge_type = 'category' %}
{% endif %}

{% set card_classes = ['mel-event-card', 'mel-event-card--' ~ _css_modifier] %}
{% if _layout %}
  {% set card_classes = card_classes|merge(['mel-event-card--' ~ _layout]) %}
{% endif %}
{% if _is_hero %}
  {% set card_classes = card_classes|merge(['mel-event-card--featured', 'mel-event-card--hero']) %}
{% endif %}
{% if is_promoted %}
  {% set card_classes = card_classes|merge(['mel-event-card--promoted', 'mel-event-card--boosted']) %}
{% endif %}
{% if is_past and _variant == 'compact' %}
  {% set card_classes = card_classes|merge(['mel-event-card--past']) %}
{% endif %}

{% if attributes is defined and attributes %}
<article{{ attributes.addClass(card_classes) }}>
{% else %}
<article class="{{ card_classes|join(' ') }}">
{% endif %}
  {% if event_flag_event_save and node is defined and node.id %}
    <div class="mel-event-card__save">
      {{ event_flag_event_save }}
    </div>
  {% endif %}
  <a href="{{ _url }}" class="mel-event-card__link" aria-label="{{ _title ~ ' — ' ~ _cta }}"{% if event_id is defined and event_id %} data-mel-track-event-click data-event-id="{{ event_id }}"{% endif %}>
    <div class="mel-event-card__image mel-event-card__media">
      {% if _img_render %}
        {{ _img_render }}
      {% elseif _img %}
        <img
          src="{{ _img }}"
          alt="{{ _img_alt }}"
          loading="{{ _is_hero ? 'eager' : 'lazy' }}"
          decoding="async"
          class="mel-event-card__image-element"
        />
      {% else %}
        <div class="mel-event-card__placeholder" aria-hidden="true"></div>
      {% endif %}

      {% if _variant not in ['compact', 'list'] %}
        <div class="mel-event-card__overlay{% if _is_hero %} mel-event-card__overlay--hero{% elseif _variant == 'featured' %} mel-event-card__overlay--featured{% else %} mel-event-card__overlay--standard{% endif %}" aria-hidden="true"></div>
      {% endif %}

      {% if _image_badge_label %}
        <span class="{% if _state_badge_type == 'category' %}mel-event__category {% endif %}mel-event-card__image-badge mel-event-card__badge mel-pill mel-pill--on-image mel-event-card__state-pill mel-event-card__state-pill--{{ _state_badge_type|e('html_attr') }}" aria-hidden="true">
          <span class="mel-pill__label">{{ _image_badge_label }}</span>
        </span>
      {% endif %}
      {% if mel_signal and not _is_hero %}
        <div class="mel-event-card__signal">{{ mel_signal }}</div>
      {% endif %}
    </div>

    <div class="mel-event-card__body mel-event-card__content">
      {% if _variant not in ['compact', 'list'] and not _is_hero %}<div class="mel-event-hero__glass">{% endif %}
      {% if not _is_hero and recommendation_context is defined and recommendation_context.label|default('')|trim|length > 0 %}
        <div class="mel-card-reason mel-card-reason--{{ recommendation_context.type|default('')|e('html_attr') }}">
          {{ recommendation_context.label }}
        </div>
      {% endif %}
      {% if not _is_hero and mel_tonight_urgency_label|default('')|trim|length > 0 %}
        <p class="mel-card-reason mel-card-reason--tonight" role="status">{{ mel_tonight_urgency_label }}</p>
      {% endif %}

      {% if _is_hero %}
        {% if _mel_cta_semantic == 'primary' and _type not in ['rsvp', 'external'] %}
          {% set _cta = 'Get tickets'|t %}
        {% endif %}
        <h2 class="mel-event-card__title">{{ _title }}</h2>
        <div class="mel-event-card__meta">
          {% if _time %}
            <p class="mel-event-card__when mel-event-card__date">
              <span class="mel-event-card__meta-icon mel-event-card__meta-icon--calendar" aria-hidden="true"></span>
              <span class="mel-event-card__meta-text">{{ _time }}</span>
            </p>
          {% endif %}
          {% if _loc %}
            <p class="mel-event-card__location">
              <span class="mel-event-card__meta-icon mel-event-card__meta-icon--pin" aria-hidden="true"></span>
              <span class="mel-event-card__meta-text">{{ _loc }}</span>
            </p>
          {% endif %}
        </div>
        {% if _status_primary %}
          <p class="mel-event-card__price mel-event-card__status mel-event-card__status--{{ _status_mod }}">{{ _status_primary }}</p>
        {% endif %}
        {% if mel_categories is defined and mel_categories|length > 0 %}
          <div class="mel-event-card__category-chips mel-event-card__chips" aria-hidden="true">
            {% for cat in mel_categories|slice(0, 3) %}
              <span class="mel-event-card__category-chip mel-event-card__chip mel-event-card__category-chip--{{ loop.index }}">{{ cat.name }}</span>
            {% endfor %}
          </div>
        {% elseif _category and _category.label %}
          <div class="mel-event-card__category-chips mel-event-card__chips" aria-hidden="true">
            <span class="mel-event-card__category-chip mel-event-card__chip mel-event-card__category-chip--1">{{ _category.label }}</span>
          </div>
        {% endif %}
        {% if _mel_cta_semantic|default('primary') != 'hidden' %}
          <div class="mel-event-card__cta-row mel-event-card__actions">
            <span class="mel-event-card__cta-chip mel-event-card__cta{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
          </div>
        {% endif %}
      {% else %}
        <h3 class="mel-event-card__title">{{ _title }}</h3>

        {% if _time %}
          <p class="mel-event-card__when mel-event-card__date">
            <span class="mel-event-card__meta-text">{{ _time }}</span>
          </p>
        {% endif %}

        <div class="mel-event-card__location-slot"{% if not _loc %} aria-hidden="true"{% endif %}>
          {% if _loc %}
            <p class="mel-event-card__location">
              <span class="mel-event-card__meta-text">{{ _loc }}</span>
            </p>
          {% else %}
            <p class="mel-event-card__location mel-event-card__location--empty">&nbsp;</p>
          {% endif %}
        </div>

        {% if _status_primary or _status_secondary %}
          <div class="mel-event-card__status-row mel-event-card__meta">
            {% if _status_primary %}
              <p class="mel-event-card__status mel-event-card__status--{{ _status_mod }}">{{ _status_primary }}</p>
            {% endif %}
            {% if _status_secondary %}
              <p class="mel-event-card__status-secondary">{{ _status_secondary }}</p>
            {% endif %}
          </div>
        {% endif %}
        {% if _category and _category.label %}
          <div class="mel-event-card__category-chips" aria-hidden="true">
            <span class="mel-event-card__category-chip">{{ _category.label }}</span>
          </div>
        {% endif %}

        {% if _mel_cta_semantic|default('primary') != 'hidden' %}
          <div class="mel-event-card__cta-row mel-event-card__actions">
            <span class="mel-event-card__cta-chip{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
          </div>
        {% endif %}

        {% if (event_ui is defined and (event_ui.capacity_hint|default('')|striptags|length > 0)) or _low_stock or _attendance %}
          <div class="mel-event-card__tertiary mel-event-card__tertiary--context">
            {% if event_ui is defined and (event_ui.capacity_hint|default('')|striptags|length > 0) %}
              <p class="mel-event-card__capacity-hint" role="status">{{ event_ui.capacity_hint }}</p>
            {% endif %}
            {% if _low_stock %}
              <p class="mel-event-card__urgency" role="status">{{ 'Selling fast'|t }}</p>
            {% endif %}
            {% if _attendance %}
              <span class="mel-event-card__social mel-event-card__going">{{ '@count going'|t({'@count': _attendance}) }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
      {% if _variant not in ['compact', 'list'] and not _is_hero %}</div>{% endif %}
    </div>
  </a>
</article>
