{#
/**
 * @file
 * Canonical MEL public event card — variants: standard, featured, compact, editorial hero.
 *
 * Presentation modes (layout param via EventCardViewModel):
 * - hero: editorial homepage carousel
 * - spotlight: featured community rail
 * - poster: discovery marketplace grids
 *
 * @see myeventlane_event.module — myeventlane_event_preprocess_node() (event_ui for all view modes).
 */
#}
{% set _variant_raw = variant|default(mel_event_card_variant|default('standard')) %}
{% set _layout = layout|default(mel_event_card_layout|default('')) %}
{% set _is_poster = _layout == 'poster' %}
{% set _is_spotlight = _layout == 'spotlight' %}
{% set _discovery_mode = _is_poster or _is_spotlight %}
{% set _is_hero = _variant_raw in ['featured_hero', 'editorial'] or (_variant_raw == 'featured' and _layout == 'hero') %}
{% set _variant = _variant_raw in ['featured_hero', 'editorial'] ? 'featured' : _variant_raw %}
{% set _css_modifier = _variant_raw in ['featured_hero', 'editorial'] ? 'editorial' : (_variant_raw in ['compact', 'list'] ? _variant_raw : _variant) %}

{% set _title = card_title|default(title|default('')) %}
{% set _url = card_url|default(url|default('#')) %}
{% set _img = card_image_url|default(image|default('')) %}
{% set _img_render = card_image_render|default(image_render|default(null)) %}
{% set _img_alt = card_image_alt|default(_title) %}
{% set _time = card_time_range|default(date_full|default('')) %}
{% set _loc = card_location|default(location|default('')) %}
{% set _type = card_type|default(ticket_type|default('paid')) %}

{% set _status_primary = card_status_primary|default('') %}
{% set _status_secondary = card_status_secondary|default('') %}
{% set _status_mod = card_status_modifier|default('default') %}
{# Sold-out is communicated by top badge + CTA; avoid duplicate "Sold out" in body. #}
{% if event_ui is defined and (event_ui.is_sold_out|default(false) == true) and (_status_mod|default('') == 'sold-out') %}
  {% set _status_primary = '' %}
  {% set _status_secondary = '' %}
{% endif %}

{% if event_ui is defined and (event_ui.show_cta|default(true)) is same as(false) %}
  {% set _cta = '' %}
  {% set _mel_cta_semantic = 'hidden' %}
{% else %}
  {% set _mel_cta_semantic = event_ui is defined ? event_ui.cta_type|default('primary') : 'primary' %}
  {% set _cta = card_cta_label|default('') %}
  {% if _cta == '' and event_ui is defined and (event_ui.cta_label|default(''))|trim|length > 0 %}
    {% set _cta = event_ui.cta_label %}
  {% endif %}
{% endif %}

{% set is_promoted = is_promoted|default(false) %}
{% set is_past = is_past|default(false) %}
{% set _low_stock = card_is_low_stock|default(false) %}
{% set _attendance = card_attendance|default(null) %}
{% set _merch = card_merchandising|default({}) %}

{% set _category = card_category|default(null) %}
{% if not _category and category is defined and category %}
  {% set _category = { 'label': category, 'url': null } %}
{% endif %}

{% set _date_day = card_day|default(date_day|default(''))|striptags|trim %}
{% set _date_month = card_month|default(date_month|default(''))|striptags|trim %}
{% set _has_date_badge = _date_day != '' and _date_month != '' %}

{% set _price_label = card_price_label|default('')|striptags|trim %}
{% if _price_label == '' %}
  {% set _price_label = _status_primary|default('')|striptags|trim %}
{% endif %}

{# Single canonical body signal — EventMerchandisingPresenter only. #}
{% set _display_signal = '' %}
{% set _display_signal_mod = 'default' %}
{% if _is_hero %}
  {% if _merch.hero_proof|default(null) %}
    {% set _display_signal = _merch.hero_proof.label %}
    {% set _display_signal_mod = _merch.hero_proof.modifier|default('community') %}
  {% elseif _merch.primary|default(null) %}
    {% set _display_signal = _merch.primary.label %}
    {% set _display_signal_mod = _merch.primary.modifier|default('default') %}
  {% endif %}
{% elseif _merch.primary|default(null) %}
  {% set _display_signal = _merch.primary.label %}
  {% set _display_signal_mod = _merch.primary.modifier|default('default') %}
{% endif %}

{% set _ticket_pill_type = _merch.ticket_pill_type|default(_type) %}
{% set _ticket_pill_label = _merch.ticket_pill_label|default(null) %}
{% set _show_ticket_type_pill = _merch.show_ticket_type_pill|default(false) and _discovery_mode and not (event_ui is defined and event_ui.is_sold_out|default(false)) %}

{# Rail-attributed discovery reason — presentation only (mel_source / merchandising). #}
{% set _mel_src = mel_source|default(mel_event_card_source|default('')) %}
{% set _discovery_reason = '' %}
{% set _discovery_reason_type = '' %}
{% if _discovery_mode and _mel_src %}
  {% if _mel_src == 'homepage_featured' %}
    {% set _discovery_reason = 'Community favourite'|t %}
    {% set _discovery_reason_type = 'spotlight' %}
  {% elseif _mel_src == 'homepage_upcoming' %}
    {% set _discovery_reason = 'Recently added'|t %}
    {% set _discovery_reason_type = 'recent' %}
  {% elseif _mel_src in ['homepage_recommended', 'homepage_discover'] %}
    {% set _discovery_reason = 'Worth checking out'|t %}
    {% set _discovery_reason_type = 'discover' %}
  {% elseif _mel_src == 'homepage_free' %}
    {% set _discovery_reason = 'Free to attend'|t %}
    {% set _discovery_reason_type = 'free' %}
  {% elseif _mel_src == 'homepage_tonight' %}
    {% if mel_tonight_urgency_label|default('')|trim|length > 0 %}
      {% set _discovery_reason = mel_tonight_urgency_label %}
    {% else %}
      {% set _discovery_reason = 'Starts soon'|t %}
    {% endif %}
    {% set _discovery_reason_type = 'tonight' %}
  {% elseif _mel_src in ['homepage_hidden_gems', 'browse_hidden_gems'] %}
    {% set _discovery_reason = 'Worth discovering'|t %}
    {% set _discovery_reason_type = 'hidden-gem' %}
  {% elseif _mel_src in ['homepage_community_favourites', 'browse_community_favourites'] %}
    {% set _discovery_reason = 'Popular with the community'|t %}
    {% set _discovery_reason_type = 'community-favourite' %}
  {% elseif _mel_src == 'related_events' and recommendation_context is defined and recommendation_context.label|default('')|trim|length > 0 %}
    {% set _discovery_reason = recommendation_context.label %}
    {% set _discovery_reason_type = recommendation_context.type|default('discover') %}
  {% endif %}
{% elseif _discovery_mode and _type in ['rsvp'] and (_price_label in ['Free', 'Free RSVP'] or _status_mod == 'free') %}
  {% set _discovery_reason = 'Free to attend'|t %}
  {% set _discovery_reason_type = 'free' %}
{% endif %}

{% set _state_badge_type = 'highlight' %}
{% set _image_badge_label = null %}
{% if _merch.image_badge_label|default('')|trim|length > 0 %}
  {% set _image_badge_label = _merch.image_badge_label %}
  {% set _state_badge_type = _merch.image_badge_modifier|default('apricot') %}
{% elseif event_ui is defined and (event_ui.is_sold_out|default(false) == true) %}
  {% set _image_badge_label = 'Sold out'|t %}
  {% set _state_badge_type = 'warning' %}
{% elseif _category and _category.label and not _discovery_mode %}
  {% set _image_badge_label = _category.label %}
  {% set _state_badge_type = 'category' %}
{% endif %}

{# Sold out: image badge + CTA only — no duplicate body chip. #}
{% if _image_badge_label and event_ui is defined and event_ui.is_sold_out|default(false) %}
  {% set _display_signal = '' %}
{% endif %}

{% if _discovery_mode or _is_hero %}
  {% set _link_aria = _title %}
  {% if _display_signal != '' %}
    {% set _link_aria = _link_aria ~ ' — ' ~ _display_signal %}
  {% endif %}
  {% if _cta|default('')|trim != '' %}
    {% set _link_aria = _link_aria ~ ' — ' ~ _cta %}
  {% endif %}
{% else %}
  {% set _link_aria = _title ~ ' — ' ~ _cta %}
{% endif %}

{% set card_classes = ['mel-event-card', 'mel-event-card--' ~ _css_modifier] %}
{% if _layout %}
  {% set card_classes = card_classes|merge(['mel-event-card--' ~ _layout]) %}
{% endif %}
{% if _is_hero %}
  {% set card_classes = card_classes|merge(['mel-event-card--featured', 'mel-event-card--hero']) %}
{% endif %}
{% if is_promoted %}
  {% set card_classes = card_classes|merge(['mel-event-card--promoted', 'mel-event-card--boosted']) %}
{% endif %}
{% if is_past and _variant == 'compact' %}
  {% set card_classes = card_classes|merge(['mel-event-card--past']) %}
{% endif %}

{% set _snapshot = '' %}
{% if _has_date_badge and _time %}
  {% set _snapshot = _date_day ~ ' ' ~ _date_month ~ ' • ' ~ _time %}
{% elseif _time %}
  {% set _snapshot = _time %}
{% elseif _has_date_badge %}
  {% set _snapshot = _date_day ~ ' ' ~ _date_month %}
{% endif %}

{% if attributes is defined and attributes %}
<article{{ attributes.addClass(card_classes) }}>
{% else %}
<article class="{{ card_classes|join(' ') }}">
{% endif %}
  {% if event_flag_event_save and node is defined and node.id %}
    <div class="mel-event-card__save">
      {{ event_flag_event_save }}
    </div>
  {% endif %}
  <a href="{{ _url }}" class="mel-event-card__link" aria-label="{{ _link_aria }}"{% if event_id is defined and event_id %} data-mel-track-event-click data-event-id="{{ event_id }}"{% if mel_source|default('') %} data-mel-source="{{ mel_source|e('html_attr') }}"{% endif %}{% endif %}>
    <div class="mel-event-card__image mel-event-card__media">
      {% if _img_render %}
        {{ _img_render }}
      {% elseif _img %}
        <img
          src="{{ _img }}"
          alt="{{ _img_alt }}"
          loading="{{ _is_hero ? 'eager' : 'lazy' }}"
          decoding="async"
          class="mel-event-card__image-element"
        />
      {% else %}
        <div class="mel-event-card__placeholder" aria-hidden="true"></div>
      {% endif %}

      {% if _has_date_badge %}
        <div class="mel-event-card__date-pill" aria-hidden="true">
          <span class="mel-event-card__date-pill-day">{{ _date_day }}</span>
          <span class="mel-event-card__date-pill-month">{{ _date_month }}</span>
        </div>
      {% endif %}

      {% if _variant not in ['compact', 'list'] %}
        <div class="mel-event-card__overlay{% if _is_hero %} mel-event-card__overlay--hero{% elseif _variant == 'featured' %} mel-event-card__overlay--featured{% else %} mel-event-card__overlay--standard{% endif %}" aria-hidden="true"></div>
      {% endif %}

      {% if _image_badge_label %}
        <span class="{% if _state_badge_type == 'category' %}mel-event__category {% endif %}mel-event-card__image-badge mel-event-card__badge mel-pill mel-pill--on-image mel-event-card__state-pill mel-event-card__state-pill--{{ _state_badge_type|e('html_attr') }}" aria-hidden="true">
          <span class="mel-pill__label">{{ _image_badge_label }}</span>
        </span>
      {% endif %}
    </div>

    <div class="mel-event-card__body mel-event-card__content">
      {% if _variant not in ['compact', 'list'] and not _is_hero %}<div class="mel-event-hero__glass">{% endif %}
      {% if not _is_hero and not _discovery_mode and recommendation_context is defined and recommendation_context.label|default('')|trim|length > 0 %}
        <div class="mel-card-reason mel-card-reason--{{ recommendation_context.type|default('')|e('html_attr') }}">
          {{ recommendation_context.label }}
        </div>
      {% endif %}
      {% if mel_source|default('') == 'homepage_tonight' and mel_tonight_urgency_label|default('')|trim|length > 0 and not _discovery_mode %}
        <p class="mel-card-reason mel-card-reason--tonight" role="status">{{ mel_tonight_urgency_label }}</p>
      {% endif %}

      {% if _is_hero %}
        <h2 class="mel-event-card__title">{{ _title }}</h2>
        <div class="mel-event-card__meta">
          {% if _time %}
            <p class="mel-event-card__when mel-event-card__date">
              <span class="mel-event-card__meta-icon mel-event-card__meta-icon--calendar" aria-hidden="true"></span>
              {% if card_datetime_iso|default('') %}
                <time class="mel-event-card__meta-text" datetime="{{ card_datetime_iso }}">{{ _time }}</time>
              {% else %}
                <span class="mel-event-card__meta-text">{{ _time }}</span>
              {% endif %}
            </p>
          {% endif %}
          {% if _loc %}
            <p class="mel-event-card__location">
              <span class="mel-event-card__meta-icon mel-event-card__meta-icon--pin" aria-hidden="true"></span>
              <span class="mel-event-card__meta-text">{{ _loc }}</span>
            </p>
          {% endif %}
        </div>
        {% if _display_signal %}
          <p class="mel-event-card__social mel-event-card__going mel-event-card__hero-proof mel-event-card__hero-proof--{{ _display_signal_mod|e('html_attr') }}" role="status">
            {% if _attendance %}<span class="mel-event-card__going-icon" aria-hidden="true">👥</span>{% endif %}
            <span class="mel-event-card__going-text">{{ _display_signal }}</span>
          </p>
        {% endif %}
        {% if _mel_cta_semantic|default('primary') != 'hidden' %}
          <div class="mel-event-card__cta-row mel-event-card__actions">
            <span class="mel-event-card__cta-chip mel-event-card__cta{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
          </div>
        {% endif %}
      {% elseif _is_spotlight %}
        {# Community spotlight — featured rail: glass panel, title, when, going, state chip. #}
        {% if _discovery_reason %}
          <p class="mel-card-reason mel-card-reason--{{ _discovery_reason_type|e('html_attr') }}" role="status">{{ _discovery_reason }}</p>
        {% endif %}
        <h3 class="mel-event-card__title">{{ _title }}</h3>
        {% if _snapshot %}
          <p class="mel-event-card__when mel-event-card__snapshot mel-event-card__date">
            {% if card_datetime_iso|default('') %}
              <time class="mel-event-card__meta-text" datetime="{{ card_datetime_iso }}">{{ _snapshot }}</time>
            {% else %}
              <span class="mel-event-card__meta-text">{{ _snapshot }}</span>
            {% endif %}
          </p>
        {% endif %}
        {% if _display_signal %}
          <div class="mel-event-card__signal-row">
            <span class="mel-event-card__state-chip mel-event-card__state-chip--{{ _display_signal_mod|e('html_attr') }}" role="status">{{ _display_signal }}</span>
          </div>
        {% endif %}
        {% if _mel_cta_semantic|default('primary') != 'hidden' and _cta|default('')|trim != '' %}
          <div class="mel-event-card__cta-row mel-event-card__actions">
            <span class="mel-event-card__cta-chip mel-event-card__cta{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
          </div>
        {% endif %}
        {% if _show_ticket_type_pill %}
          <div class="mel-event-card__ticket-type-row">
            {% include '@myeventlane_theme/components/event-type-pill.html.twig' with {
              type: _ticket_pill_type,
              label: _ticket_pill_label,
              size: 'sm',
              icon: '',
              class: 'mel-event-card__ticket-type-pill',
            } only %}
          </div>
        {% endif %}
      {% elseif _variant == 'compact' %}
        {# Poster discovery — image-first; resolver-backed CTA chip after attendance. #}
        <h3 class="mel-event-card__title">{{ _title }}</h3>

        {% if _snapshot %}
          <p class="mel-event-card__when mel-event-card__snapshot mel-event-card__date">
            {% if card_datetime_iso|default('') %}
              <time class="mel-event-card__meta-text" datetime="{{ card_datetime_iso }}">{{ _snapshot }}</time>
            {% else %}
              <span class="mel-event-card__meta-text">{{ _snapshot }}</span>
            {% endif %}
          </p>
        {% endif %}

        {% if _is_poster %}
          {% if _discovery_reason %}
            <p class="mel-card-reason mel-card-reason--{{ _discovery_reason_type|e('html_attr') }}" role="status">{{ _discovery_reason }}</p>
          {% endif %}
          {% if mel_source|default('') == 'homepage_free' and _loc %}
            <p class="mel-event-card__location mel-event-card__location--poster">
              <span class="mel-event-card__meta-text">{{ _loc }}</span>
            </p>
          {% endif %}
          {% if _display_signal %}
            <div class="mel-event-card__signal-row">
              <span class="mel-event-card__state-chip mel-event-card__state-chip--{{ _display_signal_mod|e('html_attr') }}" role="status">{{ _display_signal }}</span>
            </div>
          {% endif %}
          {% if _mel_cta_semantic|default('primary') != 'hidden' and _cta|default('')|trim != '' %}
            <div class="mel-event-card__cta-row mel-event-card__actions">
              <span class="mel-event-card__cta-chip mel-event-card__cta{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
            </div>
          {% endif %}
          {% if _show_ticket_type_pill %}
            <div class="mel-event-card__ticket-type-row">
              {% include '@myeventlane_theme/components/event-type-pill.html.twig' with {
                type: _ticket_pill_type,
                label: _ticket_pill_label,
                size: 'sm',
                icon: '',
                class: 'mel-event-card__ticket-type-pill',
              } only %}
            </div>
          {% endif %}
        {% else %}
          <div class="mel-event-card__location-slot"{% if not _loc %} aria-hidden="true"{% endif %}>
            {% if _loc %}
              <p class="mel-event-card__location">
                <span class="mel-event-card__meta-text">{{ _loc }}</span>
              </p>
            {% else %}
              <p class="mel-event-card__location mel-event-card__location--empty">&nbsp;</p>
            {% endif %}
          </div>

          {% if _status_secondary %}
            <div class="mel-event-card__status-row mel-event-card__meta">
              <p class="mel-event-card__status-secondary">{{ _status_secondary }}</p>
            </div>
          {% endif %}

          {% if (event_ui is defined and (event_ui.capacity_hint|default('')|striptags|length > 0)) or _low_stock or _attendance %}
            <div class="mel-event-card__tertiary mel-event-card__tertiary--context">
              {% if event_ui is defined and (event_ui.capacity_hint|default('')|striptags|length > 0) %}
                <p class="mel-event-card__capacity-hint" role="status">{{ event_ui.capacity_hint }}</p>
              {% endif %}
              {% if _low_stock %}
                <p class="mel-event-card__urgency" role="status">{{ 'Selling fast'|t }}</p>
              {% endif %}
              {% if _attendance %}
                <span class="mel-event-card__social mel-event-card__going">{{ '@count going'|t({'@count': _attendance}) }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if _category and _category.label %}
            <div class="mel-event-card__category-chips" aria-hidden="true">
              <span class="mel-event-card__category-chip">{{ _category.label }}</span>
            </div>
          {% endif %}

          {% if _price_label or _mel_cta_semantic|default('primary') != 'hidden' %}
            <div class="mel-event-card__footer">
              {% if _price_label %}
                <p class="mel-event-card__price mel-event-card__price-slot mel-event-card__status mel-event-card__status--{{ _status_mod }}">{{ _price_label }}</p>
              {% endif %}
              {% if _mel_cta_semantic|default('primary') != 'hidden' %}
                <div class="mel-event-card__cta-row mel-event-card__actions">
                  <span class="mel-event-card__cta-chip{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
      {% else %}
        <h3 class="mel-event-card__title">{{ _title }}</h3>

        {% if _price_label %}
          <p class="mel-event-card__price mel-event-card__price-slot mel-event-card__status mel-event-card__status--{{ _status_mod }}">{{ _price_label }}</p>
        {% endif %}

        {% if _time %}
          <p class="mel-event-card__when mel-event-card__date">
            {% if card_datetime_iso|default('') %}
              <time class="mel-event-card__meta-text" datetime="{{ card_datetime_iso }}">{{ _time }}</time>
            {% else %}
              <span class="mel-event-card__meta-text">{{ _time }}</span>
            {% endif %}
          </p>
        {% endif %}

        <div class="mel-event-card__location-slot"{% if not _loc %} aria-hidden="true"{% endif %}>
          {% if _loc %}
            <p class="mel-event-card__location">
              <span class="mel-event-card__meta-text">{{ _loc }}</span>
            </p>
          {% else %}
            <p class="mel-event-card__location mel-event-card__location--empty">&nbsp;</p>
          {% endif %}
        </div>

        {% if _status_secondary %}
          <div class="mel-event-card__status-row mel-event-card__meta">
            <p class="mel-event-card__status-secondary">{{ _status_secondary }}</p>
          </div>
        {% endif %}
        {% if _category and _category.label %}
          <div class="mel-event-card__category-chips" aria-hidden="true">
            <span class="mel-event-card__category-chip">{{ _category.label }}</span>
          </div>
        {% endif %}

        {% if _mel_cta_semantic|default('primary') != 'hidden' %}
          <div class="mel-event-card__cta-row mel-event-card__actions">
            <span class="mel-event-card__cta-chip{% if _mel_cta_semantic == 'primary' %} mel-event-card__cta-chip--coral{% elseif _mel_cta_semantic == 'disabled' %} mel-event-card__cta-chip--disabled{% else %} mel-event-card__cta-chip--lavender{% endif %}" aria-hidden="true">{{ _cta }}</span>
          </div>
        {% endif %}

        {% if (event_ui is defined and (event_ui.capacity_hint|default('')|striptags|length > 0)) or _low_stock or _attendance %}
          <div class="mel-event-card__tertiary mel-event-card__tertiary--context">
            {% if event_ui is defined and (event_ui.capacity_hint|default('')|striptags|length > 0) %}
              <p class="mel-event-card__capacity-hint" role="status">{{ event_ui.capacity_hint }}</p>
            {% endif %}
            {% if _low_stock %}
              <p class="mel-event-card__urgency" role="status">{{ 'Selling fast'|t }}</p>
            {% endif %}
            {% if _attendance %}
              <span class="mel-event-card__social mel-event-card__going">{{ '@count going'|t({'@count': _attendance}) }}</span>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
      {% if _variant not in ['compact', 'list'] and not _is_hero %}</div>{% endif %}
    </div>
  </a>
</article>
