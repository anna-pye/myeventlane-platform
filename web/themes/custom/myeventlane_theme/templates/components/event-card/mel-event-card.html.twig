{#
/**
 * @file
 * Canonical MEL public event card — variants: standard, featured, compact, featured_hero.
 *
 * Node listings: preprocess supplies card_* (myeventlane_theme_preprocess_node).
 * Views field rows: pass title, url, image, date_full, location, category, ticket_type, etc.
 */
#}
{% set variant = variant|default('standard') %}
{% set _title = card_title|default(title|default('')) %}
{% set _url = card_url|default(url|default('#')) %}
{% set _img = card_image_url|default(image|default('')) %}
{% set _img_alt = card_image_alt|default(_title) %}
{% set _time = card_time_range|default(date_full|default('')) %}
{% set _loc = card_location|default(location|default('')) %}
{% set _type = card_type|default(ticket_type|default('paid')) %}

{% set _status_primary = card_status_primary|default('') %}
{% set _status_secondary = card_status_secondary|default('') %}
{% set _status_mod = card_status_modifier|default('default') %}

{% set _cta = card_cta_label|default('') %}
{% if _cta == '' %}
  {% if _type == 'rsvp' %}
    {% set _cta = 'RSVP free'|t %}
  {% elseif _type == 'external' %}
    {% set _cta = 'External tickets'|t %}
  {% else %}
    {% set _cta = 'Buy tickets'|t %}
  {% endif %}
{% endif %}

{% set is_promoted = is_promoted|default(false) %}
{% set is_past = is_past|default(false) %}
{% set _low_stock = card_is_low_stock|default(false) %}
{% set _attendance = card_attendance|default(null) %}

{% set _category = card_category|default(null) %}
{% if not _category and category is defined and category %}
  {% set _category = { 'label': category, 'url': null } %}
{% endif %}
{% set category_class = category_slug is defined and category_slug ? ('mel-pill--cat-' ~ category_slug) : '' %}

{# One image-area badge: category first, else Featured when promoted. #}
{% set _image_badge_label = null %}
{% if _category and _category.label %}
  {% set _image_badge_label = _category.label %}
{% elseif is_promoted %}
  {% set _image_badge_label = 'Featured'|t %}
{% endif %}

{% if variant == 'featured_hero' %}
  {% if attributes is defined and attributes %}
  <article{{ attributes.addClass('mel-event-hero-card-article') }}>
  {% else %}
  <article class="mel-event-hero-card-article">
  {% endif %}
    <a href="{{ _url }}" class="mel-event-hero-card" aria-label="{{ _title ~ ' — ' ~ _cta }}">
      <div class="mel-event-hero-card__image">
        {% if _img %}
          <img src="{{ _img }}" alt="{{ _img_alt }}" loading="eager" decoding="async" />
        {% else %}
          <div class="mel-event-hero-card__placeholder" aria-hidden="true"></div>
        {% endif %}
        <div class="mel-event-hero-card__overlay" aria-hidden="true"></div>
        {% if _image_badge_label %}
          <span class="mel-event-hero-card__badge mel-pill mel-pill--category mel-pill--on-image {{ category_class }}" aria-hidden="true">
            <span class="mel-pill__label">{{ _image_badge_label }}</span>
          </span>
        {% endif %}
      </div>

      <div class="mel-event-hero-card__content">
        <h2 class="mel-event-hero-card__title">{{ _title }}</h2>

        {% if _time %}
          <p class="mel-event-hero-card__when">{{ _time }}</p>
        {% endif %}
        {% if _loc %}
          <p class="mel-event-hero-card__where">{{ _loc }}</p>
        {% endif %}

        {% if _status_primary %}
          <p class="mel-event-hero-card__status mel-event-card__status mel-event-card__status--{{ _status_mod }}">{{ _status_primary }}</p>
        {% endif %}
        {% if _status_secondary %}
          <p class="mel-event-hero-card__status-note">{{ _status_secondary }}</p>
        {% endif %}

        <span class="mel-btn mel-btn--cta mel-event-hero-card__cta-chip" aria-hidden="true">{{ _cta }}</span>
      </div>
    </a>
  </article>
{% else %}

{% set card_classes = ['mel-event-card', 'mel-event-card--' ~ variant] %}
{% if is_promoted %}
  {% set card_classes = card_classes|merge(['mel-event-card--promoted']) %}
{% endif %}
{% if is_past and variant == 'compact' %}
  {% set card_classes = card_classes|merge(['mel-event-card--past']) %}
{% endif %}

{% if attributes is defined and attributes %}
<article{{ attributes.addClass(card_classes) }}>
{% else %}
<article class="{{ card_classes|join(' ') }}">
{% endif %}
  <a href="{{ _url }}" class="mel-event-card__link" aria-label="{{ _title ~ ' — ' ~ _cta }}">
    <div class="mel-event-card__image">
      {% if _img %}
        <img
          src="{{ _img }}"
          alt="{{ _img_alt }}"
          loading="lazy"
          decoding="async"
          class="mel-event-card__image-element"
        />
      {% else %}
        <div class="mel-event-card__placeholder" aria-hidden="true"></div>
      {% endif %}

      {% if variant == 'featured' %}
        <div class="mel-event-card__overlay mel-event-card__overlay--featured" aria-hidden="true"></div>
      {% endif %}

      {% if _image_badge_label %}
        <span class="mel-event-card__image-badge mel-pill mel-pill--category mel-pill--on-image {{ category_class }}" aria-hidden="true">
          <span class="mel-pill__label">{{ _image_badge_label }}</span>
        </span>
      {% endif %}
    </div>

    <div class="mel-event-card__body mel-event-card__content">
      <h3 class="mel-event-card__title">{{ _title }}</h3>

      {% if _time %}
        <p class="mel-event-card__when">{{ _time }}</p>
      {% endif %}

      <div class="mel-event-card__location-slot"{% if not _loc %} aria-hidden="true"{% endif %}>
        {% if _loc %}
          <p class="mel-event-card__location">{{ _loc }}</p>
        {% else %}
          <p class="mel-event-card__location mel-event-card__location--empty">&nbsp;</p>
        {% endif %}
      </div>

      {% if _status_primary or _status_secondary %}
        <div class="mel-event-card__status-row">
          {% if _status_primary %}
            <p class="mel-event-card__status mel-event-card__status--{{ _status_mod }}">{{ _status_primary }}</p>
          {% endif %}
          {% if _status_secondary %}
            <p class="mel-event-card__status-secondary">{{ _status_secondary }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="mel-event-card__cta-row">
        <span class="mel-event-card__cta-chip" aria-hidden="true">{{ _cta }}</span>
      </div>

      {% if _low_stock or _attendance %}
        <div class="mel-event-card__tertiary">
          {% if _low_stock %}
            <span class="mel-event-card__urgency">{{ 'Selling fast'|t }}</span>
          {% endif %}
          {% if _attendance %}
            <span class="mel-event-card__social">{{ '@count going'|t({'@count': _attendance}) }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </a>
</article>
{% endif %}
