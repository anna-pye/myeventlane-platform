{#
/**
 * @file
 * Component: Attendees dashboard event card.
 *
 * Available variables:
 * - mel: {
 *     title: string,
 *     date: string,
 *     tickets: int,
 *     sold: int,
 *     attendees: int,
 *     revenue: string,
 *     sold_percentage: float,
 *     status: string (normal|low|selling-fast),
 *     checkin_url: string,
 *     attendees_url: string,
 *     export_url: string
 *   }
 */
#}
<div class="mel-attendees-event-card">
  <div class="mel-attendees-event-card__header">
    <div>
      <h3 class="mel-attendees-event-card__title">{{ mel.title }}</h3>
      {% if mel.date %}
        <span class="mel-attendees-event-card__date">{{ mel.date }}</span>
      {% endif %}
    </div>
    {% if mel.status == 'selling-fast' %}
      <span class="mel-attendees-event-card__status mel-attendees-event-card__status--selling-fast">{{ 'Selling fast'|t }}</span>
    {% elseif mel.status == 'low' %}
      <span class="mel-attendees-event-card__status mel-attendees-event-card__status--low">{{ 'Low sales'|t }}</span>
    {% endif %}
  </div>

  <div class="mel-attendees-event-card__metrics">
    <div class="mel-attendees-event-card__metric">
      <span class="mel-attendees-event-card__metric-label">{{ 'Tickets'|t }}</span>
      <strong class="mel-attendees-event-card__metric-value">{{ mel.tickets }}</strong>
    </div>
    <div class="mel-attendees-event-card__metric">
      <span class="mel-attendees-event-card__metric-label">{{ 'Sold'|t }}</span>
      <strong class="mel-attendees-event-card__metric-value">{{ mel.sold }}</strong>
    </div>
    <div class="mel-attendees-event-card__metric">
      <span class="mel-attendees-event-card__metric-label">{{ 'Attendees'|t }}</span>
      <strong class="mel-attendees-event-card__metric-value">{{ mel.attendees }}</strong>
    </div>
    <div class="mel-attendees-event-card__metric">
      <span class="mel-attendees-event-card__metric-label">{{ 'Revenue'|t }}</span>
      <strong class="mel-attendees-event-card__metric-value">${{ mel.revenue }}</strong>
    </div>
  </div>

  <div class="mel-attendees-event-card__progress">
    <div class="mel-attendees-event-card__progress-bar" role="progressbar" aria-valuenow="{{ mel.sold_percentage }}" aria-valuemin="0" aria-valuemax="100">
      <div class="mel-attendees-event-card__progress-fill" style="width: {{ mel.sold_percentage }}%"></div>
    </div>
  </div>

  <div class="mel-attendees-event-card__actions">
    <a href="{{ mel.checkin_url }}" class="mel-btn mel-btn-primary">{{ 'Check-in'|t }}</a>
    <a href="{{ mel.attendees_url }}" class="mel-btn mel-btn-secondary">{{ 'View'|t }}</a>
    {% if mel.export_url %}
      <a href="{{ mel.export_url }}" class="mel-btn mel-btn-ghost" target="_blank" rel="noopener">{{ 'Export'|t }}</a>
    {% endif %}
  </div>
</div>
