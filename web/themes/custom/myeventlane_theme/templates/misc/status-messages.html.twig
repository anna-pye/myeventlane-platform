{#
  MyEventLane status messages
  - Commerce/booking: status/info → MEL cart toast (glass panel, Mel illustration)
  - warning/error always inline banners
#}

{% set message_context = mel_message_context|default('default') %}
{% set is_cart_context = message_context == 'cart' %}
{% set toast_types = ['status', 'info'] %}

{% if is_cart_context %}
  <div class="mel-toasts mel-toasts--cart" aria-live="polite" aria-relevant="additions text">
    {% for type, messages in message_list %}
      {% if type in toast_types %}
        {% for message in messages %}
        <div class="mel-toast mel-toast--cart mel-toast--{{ type }}" data-mel-toast role="status">
          <div class="mel-toast__accent" aria-hidden="true"></div>

          <div class="mel-toast__body">
            <span class="mel-toast__badge">
              <span class="mel-toast__badge-icon" aria-hidden="true">✓</span>
              {{ 'Cart updated'|t }}
            </span>
            <p class="mel-toast__title">{{ message }}</p>
            {% if mel_cart_toast_show_cart_action|default(false) %}
            <div class="mel-toast__actions">
              <a class="mel-btn mel-btn--primary mel-btn-sm mel-toast__cart-link" href="{{ path('commerce_cart.page') }}">{{ 'View cart'|t }}</a>
            </div>
            {% endif %}
          </div>

          <button class="mel-toast__close" type="button" aria-label="{{ 'Dismiss'|t }}" data-mel-toast-close>
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>
{% endif %}

<div class="mel-banners">
  {% for type, messages in message_list %}
    {% if is_cart_context and type in toast_types %}
      {# on commerce pages, status/info are handled by toasts above #}
    {% else %}
      <div class="mel-banner mel-banner--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
        <div class="mel-banner__inner">
          <div class="mel-banner__icon" aria-hidden="true">
            {% if type == 'error' %}
              !
            {% elseif type == 'warning' %}
              ⚠
            {% else %}
              ✓
            {% endif %}
          </div>
          <div class="mel-banner__content">
            <h2 class="visually-hidden">
              {% if type == 'error' %}
                {{ 'Error message'|t }}
              {% elseif type == 'warning' %}
                {{ 'Warning message'|t }}
              {% else %}
                {{ 'Status message'|t }}
              {% endif %}
            </h2>
            {% for message in messages %}
              <div class="mel-banner__text">{{ message }}</div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>
