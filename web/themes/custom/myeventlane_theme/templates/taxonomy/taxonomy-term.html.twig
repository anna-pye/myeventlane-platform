{#
/**
 * @file
 * Taxonomy term page template.
 * Simplified to avoid double-page layout - only renders title and content.
 * Event grid is applied by views-view-unformatted.html.twig.
 */
#}
{% include '@myeventlane_theme/components/mel-page-header.html.twig' with {
  title: name,
  show_search: true,
  show_categories: true,
  categories: mel_header_categories|default([]),
  hero_image_url: mel_hero_image_url|default(null),
  hero_image_url_mobile: mel_hero_image_url_mobile|default(null),
  hero_hide_on_mobile: mel_hero_hide_on_mobile|default(false)
} %}

{% if mel_category_follow_flag|default(null) or mel_category_follow_login_url|default(null) %}
  <div class="mel-container mel-category-follow-region">
    {% include '@myeventlane_theme/components/mel-category-follow-cta.html.twig' with {
      mel_category_follow_flag: mel_category_follow_flag|default(null),
      mel_category_follow_login_url: mel_category_follow_login_url|default(null),
      category_display_name: name,
      mel_category_follow_modifier: 'taxonomy'
    } %}
  </div>
{% endif %}

{{ content }}
