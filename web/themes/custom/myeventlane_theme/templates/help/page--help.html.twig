{#
/**
 * @file
 * Theme override for the /help page family.
 *
 * Extends the standard MEL public page shell (header + footer) and wraps
 * Help Centre content in the existing help page styles.
 */
#}
{% extends "page.html.twig" %}

{% block content %}
  <div class="mel-help-page">
    {% if page.breadcrumb %}
      <div class="mel-help-page__breadcrumb">
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    <div class="mel-help-page__content">
      {{ page.content }}
    </div>
  </div>
{% endblock %}
