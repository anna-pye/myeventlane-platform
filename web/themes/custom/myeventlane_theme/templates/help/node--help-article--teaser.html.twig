{#
/**
 * @file
 * Help article teaser — MEL card layout for search and listings.
 */
#}
<article{{ attributes.addClass('mel-help-card', 'node', 'node--type-help-article', 'node--view-mode-teaser') }}>
  <div class="mel-help-card-content">
    {{ title_prefix }}
    <h3>{{ label }}</h3>
    {{ title_suffix }}

    {% if content.field_help_summary|render|trim is not empty %}
      <div class="mel-help-card-summary">{{ content.field_help_summary }}</div>
    {% endif %}

    {% if content.field_help_article_type|render|trim is not empty %}
      <div class="mel-help-meta">
        <span class="mel-tag">{{ content.field_help_article_type }}</span>
      </div>
    {% endif %}
  </div>

  <div class="mel-help-card-actions">
    <a href="{{ url }}" class="mel-link">{{ 'Read article'|t }}<span aria-hidden="true"> →</span><span class="visually-hidden"> — {{ label }}</span></a>
  </div>
</article>
