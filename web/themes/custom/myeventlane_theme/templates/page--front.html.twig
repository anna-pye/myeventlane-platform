{#
/**
 * @file
 * MEL homepage — region-driven discovery.
 */
#}
{% extends "page.html.twig" %}

{% block hero %}
  {% if page.homepage_hero %}
    <div class="mel-region-homepage-hero">
      {{ page.homepage_hero }}
    </div>
  {% elseif page.hero %}
    <div class="mel-region-hero">
      {{ page.hero }}
    </div>
  {% else %}
    {% set popular_tags = popular_tags|default([]) %}
    {% include '@myeventlane_theme/components/hero/hero.twig' with { popular_tags: popular_tags } %}
  {% endif %}
{% endblock %}

{% block content %}
  {{ attach_library('myeventlane_theme/front') }}

  <div class="mel-page mel-page--home">

    {% if mel_home_show_featured|default(false) %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--featured mel-section--community-spotlight mel-section--discover',
        section_width_class: '',
        container_class: 'mel-container',
        header_extra_class: 'mel-section__header--featured mel-section__header--spotlight',
        title: 'Community spotlight'|t,
        subtitle: 'Hand-picked experiences from the MEL community.'|t,
        link_url: path('view.upcoming_events.page_events'),
        link_text: 'Browse marketplace'|t,
        link_class: 'mel-link',
        content_wrapper_class: 'mel-section__discover-view',
        content: page.homepage_featured
      } %}
    {% endif %}

    {% if mel_home_show_discover|default(false) %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--discover mel-section--discover-chips',
        section_width_class: '',
        container_class: 'mel-container',
        header_extra_class: 'mel-section__header--discover',
        title: 'Discover events'|t,
        subtitle: 'Filter by what you feel like tonight'|t,
        link_url: path('view.upcoming_events.page_events'),
        link_text: 'See all events'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.home_discover
      } %}
    {% endif %}

    {% if mel_home_show_tonight|default(false) %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--tonight mel-section--discover',
        section_width_class: '',
        container_class: 'mel-container',
        header_extra_class: 'mel-section__header--tonight',
        title: 'Happening tonight'|t,
        subtitle: 'Don’t miss these events starting soon'|t,
        link_url: path('view.upcoming_events.page_today'),
        link_text: 'See today'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.homepage_tonight
      } %}
    {% endif %}

    {% if mel_home_show_free_rsvp|default(false) %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--free-rsvp mel-section--discover',
        section_width_class: '',
        container_class: 'mel-container',
        header_extra_class: 'mel-section__header--free-rsvp',
        title: 'Easy ways to get involved'|t,
        subtitle: 'Great community events with no ticket fee'|t,
        link_url: path('view.upcoming_events.page_free'),
        link_text: 'See all free events'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.homepage_free
      } %}
    {% endif %}

    {% if page.homepage_latest %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--latest mel-section--discover',
        section_width_class: '',
        container_class: 'mel-container',
        header_extra_class: 'mel-section__header--latest',
        title: 'Freshly added'|t,
        subtitle: 'Recently published on MyEventLane'|t,
        link_url: path('view.upcoming_events.page_events'),
        link_text: 'Browse all events'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.homepage_latest
      } %}
    {% endif %}

    {% if mel_home_show_recommended|default(false) %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--recommended mel-section--discover mel-section--secondary',
        section_width_class: '',
        container_class: 'mel-container',
        header_extra_class: 'mel-section__header--recommended',
        title: 'Recommended for you'|t,
        subtitle: 'Events you may enjoy'|t,
        link_url: path('view.upcoming_events.page_events'),
        link_text: 'Browse marketplace'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.home_recommended
      } %}
    {% endif %}

    {% if page.homepage_nearby %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--nearby',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        title: 'Nearby events'|t,
        subtitle: 'Find experiences close to you.'|t,
        link_url: '/events/nearby',
        link_text: 'Explore nearby'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.homepage_nearby
      } %}
    {% endif %}

    {% if page.homepage_online %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--online',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        title: 'Online events'|t,
        subtitle: 'Join from wherever you are.'|t,
        link_url: '/events/online',
        link_text: 'See online events'|t,
        content_wrapper_class: 'mel-section__discover-view',
        content: page.homepage_online
      } %}
    {% endif %}

    {% if mel_home_show_blog|default(false) %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--blog',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        title: 'Guides for better nights out'|t,
        subtitle: 'Lightweight ideas for discovering, hosting, and growing events.'|t,
        link_url: '/blog',
        link_text: 'Read more'|t,
        content_wrapper_class: 'mel-section__blog-view',
        content: page.homepage_blog
      } %}
    {% endif %}

    {% if page.homepage_host_cta %}
      {{ page.homepage_host_cta }}
    {% else %}
      {% include '@myeventlane_theme/includes/mel-host-cta-default.html.twig' %}
    {% endif %}

    {% if page.homepage_newsletter %}
      {{ page.homepage_newsletter }}
    {% endif %}

  </div>
{% endblock %}
