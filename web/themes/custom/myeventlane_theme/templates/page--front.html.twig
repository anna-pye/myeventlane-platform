{#
/**
 * @file
 * MEL homepage — code-driven discovery (Phase 2 + 2.1 width system).
 */
#}
{% extends "page.html.twig" %}

{% block hero %}
  {% set popular_tags = popular_tags|default([]) %}
  {% include '@myeventlane_theme/components/hero/hero.twig' with { popular_tags: popular_tags } %}
{% endblock %}

{% block content %}
  <!-- MEL DEBUG: FRONT PAGE TEMPLATE ACTIVE (page--front.html.twig) -->
  {{ attach_library('myeventlane_theme/front') }}

  {% set mel_home_featured_markup %}
    {{ drupal_view('front_featured_events', 'block_featured') }}
  {% endset %}

  {% set mel_home_discover_markup %}
    {{ drupal_view('mel_home_events', 'embed_discover') }}
  {% endset %}

  {% set mel_home_free_markup %}
    {{ drupal_view('mel_home_events', 'under_20') }}
  {% endset %}

  {% set mel_home_tonight_markup %}
    {{ drupal_view('mel_home_events', 'tonight') }}
  {% endset %}

  {% set mel_home_categories_markup %}
    {{ drupal_block('myeventlane_category_pills') }}
  {% endset %}

  <div class="mel-home mel-home--phase2">
    {% if mel_home_featured_markup|trim %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--featured',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        header_extra_class: 'mel-section__header--featured',
        title: 'Featured events'|t,
        subtitle: 'Curated picks you won’t want to miss.'|t,
        link_url: path('view.upcoming_events.page_events'),
        link_text: 'See all'|t,
        link_class: 'mel-link',
        content: mel_home_featured_markup,
      } %}
    {% endif %}

    {% if mel_home_discover_markup|trim %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--discover',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        title: 'Discover events'|t,
        subtitle: 'Browse what’s coming up near you.'|t,
        link_url: path('view.upcoming_events.page_events'),
        link_text: 'See all'|t,
        content_wrapper_class: 'mel-home__discover-grid',
        content: mel_home_discover_markup,
      } %}
    {% endif %}

    {% if mel_home_free_markup|trim %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--free',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        title: 'Free & RSVP'|t,
        subtitle: 'Low-friction ways to join in — no ticket checkout required.'|t,
        link_url: path('view.upcoming_events.page_free'),
        link_text: 'See all'|t,
        content_wrapper_class: 'mel-row__scroller',
        content: mel_home_free_markup,
      } %}
    {% endif %}

    {% if mel_home_tonight_markup|trim %}
      {% include '@myeventlane_theme/components/layout/mel-section-shell.html.twig' with {
        section_class: 'mel-section--time',
        section_width_class: 'mel-section--wide',
        container_class: 'mel-container mel-container--wide',
        title: 'On tonight'|t,
        subtitle: 'Happening today — grab a seat while you can.'|t,
        link_url: path('view.upcoming_events.page_today'),
        link_text: 'See all'|t,
        content_wrapper_class: 'mel-row__scroller',
        content: mel_home_tonight_markup,
      } %}
    {% endif %}

    {% if mel_home_categories_markup|trim %}
      <section class="mel-section mel-home-section mel-section--categories" aria-labelledby="mel-home-categories-title">
        <div class="mel-container mel-container--wide">
          <div class="mel-section__header">
            <div class="mel-section__intro">
              <h2 id="mel-home-categories-title" class="mel-section__title">{{ 'Browse by category'|t }}</h2>
              <p class="mel-section__subtitle">{{ 'Pick a lane — we’ll show matching events.'|t }}</p>
            </div>
            <a href="{{ path('view.upcoming_events.page_events') }}" class="mel-section__link">{{ 'All events'|t }}</a>
          </div>
          <div class="mel-section__content">
            <div class="mel-category-list">
              {{ mel_home_categories_markup }}
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <section class="mel-section mel-home-section mel-section--host mel-section--full" aria-labelledby="mel-home-host-title">
      <div class="mel-container mel-container--wide">
        <div class="mel-home-host">
          <div class="mel-home-host__copy">
            <h2 id="mel-home-host-title" class="mel-home-host__title">{{ 'Empowering event creators everywhere.'|t }}</h2>
            <p class="mel-home-host__text">
              {{ 'Create a free RSVP or ticketed event, reach your audience, and manage it all in one place.'|t }}
            </p>
          </div>
          <div class="mel-home-host__actions">
            <a class="mel-btn mel-btn--cta" href="{{ path('entity.node.add_form', {'node_type': 'event'}) }}">{{ 'Create event'|t }}</a>
            <a class="mel-btn mel-btn-secondary" href="{{ path('myeventlane_vendor.create_event_gateway') }}">{{ 'How hosting works'|t }}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mel-section mel-home-section mel-section--final-cta mel-section--full" aria-labelledby="mel-home-final-cta-title">
      <div class="mel-container mel-container--wide">
        <div class="mel-home-final-cta">
          <h2 id="mel-home-final-cta-title" class="mel-home-final-cta__title">{{ 'Ready to host your next event?'|t }}</h2>
          <p class="mel-home-final-cta__text">{{ 'List for free, sell tickets with transparent fees, and grow your community on MyEventLane.'|t }}</p>
          <a class="mel-btn mel-btn--cta mel-home-final-cta__btn" href="{{ path('myeventlane_vendor.create_event_gateway') }}">{{ 'Start hosting'|t }}</a>
        </div>
      </div>
    </section>

  </div>
{% endblock %}
