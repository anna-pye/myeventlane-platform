{#
/**
 * @component Hero (homepage — Probe)
 *
 * Variables:
 * - popular_tags: optional array of { name, url } for category shortcuts
 * - mel_hero_desktop_url, mel_hero_mobile_url: from preprocess_page (journey/home PNGs when present)
 * - mel_hero_hide_on_mobile: hide art on small viewports (Page Visuals)
 * - directory: theme path segment (Drupal page variable)
 *
 * One primary CTA above the fold: marketing discovery button (translated label below). Secondary link is text-style
 * and points to create-event gateway (login + organiser onboarding + event studio) —
 * label matches that action; public CTA uses myeventlane_vendor.create_event_gateway.
 *
 * For organiser help articles only (no duplicate create flow), use Help Centre e.g.
 * myeventlane_help_centre.organisers_index (/help/organisers) from body copy or footer.
 *
 * Hero art: prefers responsive PNG URLs from PHP; falls back to a dedicated
 * text-free abstract SVG (not the event placeholder asset).
 */
#}

{% set hero_desktop = mel_hero_desktop_url|default(null) %}
{% set hero_mobile = mel_hero_mobile_url|default(null) %}
{% set hero_hide_mobile = mel_hero_hide_on_mobile|default(false) %}
{% set hero_fallback_src = base_path ~ directory ~ '/images/mel/hero/mel-hero-home-abstract.svg' %}

<section class="mel-section hero mel-section--hero mel-section--full" aria-labelledby="mel-hero-headline">
  <div class="hero__inner mel-container mel-container--wide">
    <div class="hero__content">
      <div class="hero__text">
        <h1 id="mel-hero-headline" class="hero__headline">{{ 'Find your next favourite experience.'|t }}</h1>
        <p class="hero__supporting">
          {{ 'Discover more of your city. Unexpected experiences. Real community.'|t }}
        </p>
      </div>

      <div class="hero__ctas" role="group" aria-label="{{ 'Get started'|t }}">
        <a class="mel-btn mel-btn--secondary hero__cta hero__cta--primary" href="{{ path('view.upcoming_events.page_events') }}">
          {{ 'Explore events'|t }}
        </a>
        <a class="mel-link hero__cta hero__cta--secondary" href="{{ path('myeventlane_vendor.create_event_gateway') }}">
          {{ 'Create Event'|t }}
        </a>
      </div>

      {% if popular_tags %}
        <div class="hero__tags">
          <span class="hero__tags-label">{{ 'Popular categories'|t }}</span>
          {% for term in popular_tags %}
            <a href="{{ term.url }}" class="hero__tag">{{ term.name }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="hero__visual{% if hero_hide_mobile %} mel-home-hero__art--hide-mobile{% endif %}" aria-hidden="true">
      <div class="hero__visual-inner">
        {% if hero_desktop or hero_mobile %}
          <picture>
            {% if hero_mobile %}
              <source media="(max-width: 767px)" srcset="{{ hero_mobile }}">
            {% endif %}
            <img
              class="hero__visual-img"
              src="{{ hero_desktop ?: hero_mobile }}"
              alt=""
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        {% else %}
          <img
            class="hero__visual-img hero__visual-img--fallback"
            src="{{ hero_fallback_src }}"
            alt=""
            width="960"
            height="540"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        {% endif %}
      </div>
    </div>
  </div>
</section>
