{#
/**
 * @component Hero (homepage — Probe)
 *
 * Variables:
 * - popular_tags: optional array of { name, url } for category shortcuts
 */
#}

<section class="mel-section hero mel-section--hero mel-section--full" aria-labelledby="mel-hero-headline">
  <div class="hero__inner mel-container mel-container--wide">
    <div class="hero__content">
      <div class="hero__text">
        <h1 id="mel-hero-headline" class="hero__headline">{{ 'Your lane to great events.'|t }}</h1>
        <p class="hero__supporting">
          {{ 'Discover local events, workshops, gigs, and community gatherings — or create your own in minutes.'|t }}
        </p>
      </div>

      <div class="hero__ctas" role="group" aria-label="{{ 'Get started'|t }}">
        <a class="mel-btn mel-btn--primary hero__cta hero__cta--primary" href="{{ path('view.upcoming_events.page_events') }}">
          {{ 'Explore events'|t }}
        </a>
        <a class="mel-btn mel-btn-secondary hero__cta hero__cta--secondary" href="{{ path('entity.node.add_form', {'node_type': 'event'}) }}">
          {{ 'Create event'|t }}
        </a>
      </div>

      {% if popular_tags %}
        <div class="hero__tags">
          <span class="hero__tags-label">{{ 'Popular categories'|t }}</span>
          {% for term in popular_tags %}
            <a href="{{ term.url }}" class="hero__tag">{{ term.name }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__visual-inner"></div>
    </div>
  </div>
</section>
