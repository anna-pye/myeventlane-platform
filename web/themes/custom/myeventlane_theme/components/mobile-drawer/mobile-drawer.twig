{#
/**
 * @component Mobile Drawer
 *
 * Navigation-only mobile menu. Commerce, account, and Create Event live in the header.
 *
 * Variables:
 * - drawer_menu (primary navigation links)
 */
#}
<details class="mobile-drawer">
  <summary class="mobile-drawer__toggle" aria-label="{{ 'Open menu'|t }}" aria-expanded="false" aria-controls="mobile-drawer-panel">
    <span class="mobile-drawer__icon" aria-hidden="true">☰</span>
    <span class="mobile-drawer__label">{{ 'Menu'|t }}</span>
  </summary>

  <div id="mobile-drawer-panel" class="mobile-drawer__panel" role="dialog" aria-label="{{ 'Site menu'|t }}">
    <nav class="mobile-drawer__section" aria-label="{{ 'Primary'|t }}">
      {{ drawer_menu }}
    </nav>
  </div>
</details>
