{#
/**
 * @file
 * MEL Card Carousel (Swiper)
 *
 * Variables:
 * - items: Rendered event cards (already themed)
 * - carousel_id: Unique ID string
 * - carousel_modifier: Optional BEM modifier class(es)
 * - nav_below: When true, prev/next sit centred under the track (homepage spotlight).
 */
#}
{% set nav_below = nav_below|default(false) %}

{% if nav_below %}
  <div class="mel-card-carousel-shell mel-card-carousel-shell--nav-below">
{% endif %}

<div class="mel-card-carousel swiper{% if carousel_modifier|default('') %} {{ carousel_modifier }}{% endif %}" id="{{ carousel_id }}">
  <div class="swiper-wrapper">
    {% for item in items %}
      <div class="swiper-slide">
        {{ item }}
      </div>
    {% endfor %}
  </div>

  {% if not nav_below %}
    <button class="swiper-button-prev" aria-label="{{ 'Previous events'|t }}"></button>
    <button class="swiper-button-next" aria-label="{{ 'Next events'|t }}"></button>
  {% endif %}
</div>

{% if nav_below %}
  <div class="mel-card-carousel__nav" aria-hidden="false">
    <button class="swiper-button-prev mel-card-carousel__nav-btn" type="button" aria-label="{{ 'Previous events'|t }}"></button>
    <button class="swiper-button-next mel-card-carousel__nav-btn" type="button" aria-label="{{ 'Next events'|t }}"></button>
  </div>
  </div>
{% endif %}
