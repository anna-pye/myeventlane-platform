{#
/**
 * @file
 * Canonical VendorShell layout for the organiser console.
 *
 * Regions: sidebar (nav), header (title/actions), main (content), optional
 * utility rail (sidebar_help), footer. All vendor page suggestions delegate
 * here via templates/page.html.twig.
 *
 * Inner content shells (not page wrappers):
 * - myeventlane_vendor_console_page → layout/console-page.html.twig
 * - mel_event_workspace → mel-event/mel-event-workspace.html.twig
 * - myeventlane_vendor_dashboard → dashboard/dashboard.html.twig
 *
 * Event Studio (Phase 2B): mel_event_studio_workspace — separate shell, unchanged.
 */
#}
{{ attach_library('myeventlane_vendor_theme/footer-internal') }}

{% set is_dashboard_route = page.active_section|default('') == 'dashboard' %}
{# Hidden overlay must not block clicks. #}
<div class="mel-sidebar-overlay" data-sidebar-overlay style="pointer-events:none;"></div>

<div class="mel-vendor-console mel-vendor-shell{% if page.wizard_sidebar_active %} mel-vendor-shell--wizard-sidebar{% endif %}">
  <aside id="mel-vendor-sidebar" class="mel-vendor-shell__sidebar mel-vendor-sidebar mel-vendor-console__sidebar" role="navigation" aria-label="{{ 'Organiser navigation'|t }}" data-sidebar>
    {% include '@myeventlane_vendor_theme/includes/sidebar.html.twig' with { page: page } %}
  </aside>

  <div class="mel-vendor-shell__main mel-vendor-console__main">
    {% include '@myeventlane_vendor_theme/includes/vendor-shell-header.html.twig' with {
      page: page,
    } only %}

    {% if page.vendor_alert is defined %}
      {% include '@myeventlane_vendor_theme/includes/vendor-alert-strip.html.twig' with {
        vendor_alert: page.vendor_alert
      } only %}
    {% endif %}

    {% if page.mel_pro_grace_banner is defined %}
      {% include '@myeventlane_vendor_theme/includes/mel-pro-grace-banner.html.twig' with {
        mel_pro_grace_banner: page.mel_pro_grace_banner
      } only %}
    {% endif %}

    <main class="mel-vendor-shell__content mel-vendor-main mel-vendor-console__content" role="main">
      {% if page.highlighted %}
        {{ page.highlighted }}
      {% endif %}

      {% if page.sidebar_help %}
        <div class="mel-shell-layout mel-shell-layout--with-utility">
          <div class="mel-shell-layout__main">
            {% include '@myeventlane_vendor_theme/includes/vendor-shell-main-content.html.twig' with {
              page: page,
              is_dashboard_route: is_dashboard_route,
              mel_surface: mel_surface|default(''),
            } only %}
          </div>
          <aside class="mel-shell-layout__utility-rail" data-help-sidebar>
            {{ page.sidebar_help }}
          </aside>
        </div>
      {% else %}
        {% include '@myeventlane_vendor_theme/includes/vendor-shell-main-content.html.twig' with {
          page: page,
          is_dashboard_route: is_dashboard_route,
          mel_surface: mel_surface|default(''),
        } only %}
      {% endif %}
    </main>

    <div data-mel-support-root class="mel-vendor-shell__support-mount" aria-live="polite"></div>

    {% if is_dashboard_route %}
      <div class="mel-vendor-shell__footer mel-vendor-shell__footer--dashboard">
        {% include '@myeventlane_vendor_theme/includes/footer-dashboard-light.html.twig' %}
      </div>
    {% else %}
      <div class="mel-vendor-shell__footer">
        {% include '@myeventlane_vendor_theme/includes/footer-internal.html.twig' %}
      </div>
    {% endif %}
  </div>
</div>
