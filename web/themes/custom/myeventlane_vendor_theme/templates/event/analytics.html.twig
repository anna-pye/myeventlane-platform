{#
/**
 * Event analytics — Vendor Growth Dashboard (vendor console).
 *
 * Story flow: All Sales → Ticket Sales → Merchandise → Boost → Placements → Recommendations → Details
 */
#}
{% if (not studio and (workspace_back_url or edit_event_url)) or export_pdf_url or export_excel_url %}
  <nav class="mel-live-ops__quick-bar" role="region" aria-label="{{ 'Analytics actions'|t }}">
    <div class="mel-live-ops__quick-inner" role="toolbar">
      {% if workspace_back_url and not studio %}
        <a href="{{ workspace_back_url }}" class="mel-live-ops__action mel-live-ops__action--lavender" data-icon="list">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Back to Overview'|t }}</span>
        </a>
      {% endif %}
      {% if edit_event_url and not studio %}
        <a href="{{ edit_event_url }}" class="mel-live-ops__action mel-live-ops__action--muted" data-icon="settings">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Edit event'|t }}</span>
        </a>
      {% endif %}
      {% if export_pdf_url %}
        <a href="{{ export_pdf_url }}" class="mel-live-ops__action mel-live-ops__action--lavender" data-icon="export" target="_blank" rel="noopener noreferrer">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Export PDF'|t }}</span>
        </a>
      {% endif %}
      {% if export_excel_url %}
        <a href="{{ export_excel_url }}" class="mel-live-ops__action mel-live-ops__action--lavender" data-icon="export">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Export Excel'|t }}</span>
        </a>
      {% endif %}
    </div>
  </nav>
{% endif %}

{% set sales = overview.sales|default({}) %}
{% set rsvp_block = overview.rsvps|default({}) %}
{% set attendees = overview.attendees|default({}) %}
{% set boost = overview.boost|default({}) %}
{% set boost_metrics = overview.boost_metrics|default({}) %}
{% set has_sales_chart = charts.sales|default([])|length > 0 %}
{% set has_rsvp_chart = charts.rsvps|default([])|length > 0 %}
{% set has_ticket_mix_chart = has_ticket_mix_chart|default(false) %}
{% set has_ticket_trend_chart = has_ticket_trend_chart|default(false) %}
{% set has_extras_mix_chart = has_extras_mix_chart|default(false) %}
{% set has_revenue_breakdown_chart = has_revenue_breakdown_chart|default(false) %}
{% set has_all_sales_trend_chart = has_all_sales_trend_chart|default(false) %}
{% set has_boost_metrics = has_boost_metrics|default(false) %}
{% set has_boost_trend_chart = has_boost_trend_chart|default(false) %}
{% set has_boost_trend_mini_chart = has_boost_trend_mini_chart|default(false) %}
{% set boost_trend = boost_trend_intelligence|default({}) %}
{% set has_placement_impressions_chart = has_placement_impressions_chart|default(false) %}
{% set show_ticket_analytics = is_tickets_enabled|default(false) %}
{% set show_rsvp_analytics = is_rsvp_enabled|default(false) %}
{% set commerce = commerce_analytics|default({}) %}
{% set show_extras_section = commerce.show_extras_section|default(false) %}
{% set all_sales = all_sales_section|default({}) %}
{% set ticket_sales = ticket_sales_section|default({}) %}
{% set merchandise = merchandise_section|default({}) %}
{% set rsvp_health = rsvp_health_section|default({}) %}
{% set next_steps = recommendations|default([]) %}
{% set ticket_tier_breakdown = ticket_tier_breakdown|default([]) %}
{% set capacity_total = ticket_tier_rollup.total_remaining is not null ? (ticket_tier_rollup.total_sold|default(0) + ticket_tier_rollup.total_remaining) : 0 %}
{% set capacity_pct = capacity_total > 0 ? ((ticket_tier_rollup.total_sold|default(0) / capacity_total) * 100)|round(1) : null %}
{% set att_total = attendees.total|default(0) %}
{% set att_in = attendees.checked_in|default(0) %}
{% set check_pct = att_total > 0 ? ((att_in / att_total) * 100)|round(1) : 0 %}
{% set donations = overview.donations|default({}) %}
{% set donation_total = donations.total|default(0) %}
{% set donation_count = donations.count|default(0) %}
{% set donation_average = donations.average|default(0) %}
{% set has_donation_metrics = donation_total > 0 %}
{% set has_detail_sections = (show_ticket_analytics and ticket_tier_breakdown|length > 0)
  or (show_ticket_analytics and ticket_tier_rollup.tier_row_count|default(0) > 0)
  or (show_ticket_analytics and charts.sales|length > 0)
  or (show_rsvp_analytics and (rsvp_block.confirmed|default(0) > 0 or rsvp_block.pending|default(0) > 0))
  or (show_extras_section and (commerce.extras_items_sold|default(0) > 0 or commerce.orders_with_extras|default(0) > 0))
  or has_boost_trend_chart %}

<div class="mel-workspace-page mel-page mel-analytics mel-analytics--dashboard mel-analytics--growth mel-live-operations mel-vendor-console-stack{% if studio %} mel-studio-analytics mel-studio-analytics--pro{% endif %}">
  {% if studio %}
    <header class="mel-studio-analytics__header">
      <div>
        <p class="mel-studio-analytics__eyebrow">{{ 'MEL Pro analytics'|t }}</p>
        <h2>{{ 'Understand what is working'|t }}</h2>
        <p>{{ 'Use event trends and audience behaviour to choose your next useful action.'|t }}</p>
      </div>
      <span class="mel-studio-analytics__pro-badge">{{ 'Pro'|t }}</span>
    </header>
  {% endif %}

  {# RSVP-only event health (when no paid sales section) #}
  {% if rsvp_health.show|default(false) and rsvp_health.kpis|default([])|length > 0 %}
    {% if studio %}<details class="mel-studio-analytics__group" open><summary>{{ 'Event health'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
    <section class="mel-analytics__business mel-analytics__business--rsvp mel-live-ops__panel" aria-labelledby="mel-analytics-rsvp-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-rsvp-title" class="mel-live-ops__panel-title">{{ 'Event health'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'How your RSVPs and attendance are tracking.'|t }}</p>
      </div>
      {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
        metric_wrap_section: false,
        metric_items: rsvp_health.kpis,
      } only %}
      {% if show_rsvp_analytics and has_rsvp_chart %}
        <div class="mel-analytics__business-charts">
          <div class="mel-analytics__chart-widget mel-chart-card">
            <h3 class="mel-chart-card__title">{{ 'RSVPs over time'|t }}</h3>
            <div class="mel-chart-card__canvas mel-chart-card__canvas--widget" data-chart-id="event-rsvps" role="img" aria-label="{{ 'RSVPs over time chart'|t }}">
              <canvas height="180"></canvas>
            </div>
          </div>
        </div>
      {% endif %}
    </section>
    {% if studio %}</div></details>{% endif %}
  {% endif %}

  {# All Sales — CEO view #}
  {% if all_sales.show|default(false) %}
    {% if studio %}<details class="mel-studio-analytics__group" open><summary>{{ 'All sales'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
    <section class="mel-analytics__business mel-analytics__business--all-sales mel-live-ops__panel" aria-labelledby="mel-analytics-all-sales-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-all-sales-title" class="mel-live-ops__panel-title">{{ 'All sales'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'How is my event performing overall?'|t }}</p>
      </div>
      {% if all_sales.kpis|default([])|length > 0 %}
        {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
          metric_wrap_section: false,
          metric_items: all_sales.kpis,
        } only %}
      {% endif %}
      {% if has_all_sales_trend_chart or has_revenue_breakdown_chart %}
        <div class="mel-analytics__business-charts">
          {% if has_all_sales_trend_chart %}
            <div class="mel-analytics__chart-widget mel-chart-card">
              <h3 class="mel-chart-card__title">{{ 'Revenue over time'|t }}</h3>
              <div class="mel-chart-card__canvas mel-chart-card__canvas--widget" data-chart-id="event-sales" role="img" aria-label="{{ 'Revenue over time chart'|t }}">
                <canvas height="180"></canvas>
              </div>
            </div>
          {% endif %}
          {% if has_revenue_breakdown_chart %}
            <div class="mel-analytics__chart-widget mel-chart-card">
              <h3 class="mel-chart-card__title">{{ 'Revenue sources'|t }}</h3>
              <div class="mel-chart-card__canvas mel-chart-card__canvas--donut mel-chart-card__canvas--widget" data-chart-id="event-revenue-breakdown" role="img" aria-label="{{ 'Revenue sources chart'|t }}">
                <canvas height="180"></canvas>
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </section>
    {% if studio %}</div></details>{% endif %}
  {% endif %}

  {# Ticket Sales — ticket performance only #}
  {% if ticket_sales.show|default(false) %}
    {% if studio %}<details class="mel-studio-analytics__group"><summary>{{ 'Ticket sales'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
    <section class="mel-analytics__business mel-analytics__business--tickets mel-live-ops__panel" aria-labelledby="mel-analytics-ticket-sales-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-ticket-sales-title" class="mel-live-ops__panel-title">{{ 'Ticket sales'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'Which tickets are selling?'|t }}</p>
      </div>
      {% if ticket_sales.kpis|default([])|length > 0 %}
        {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
          metric_wrap_section: false,
          metric_items: ticket_sales.kpis,
        } only %}
      {% endif %}
      {% if has_ticket_trend_chart or has_ticket_mix_chart %}
        <div class="mel-analytics__business-charts">
          {% if has_ticket_trend_chart %}
            <div class="mel-analytics__chart-widget mel-chart-card">
              <h3 class="mel-chart-card__title">{{ 'Ticket sales over time'|t }}</h3>
              <div class="mel-chart-card__canvas mel-chart-card__canvas--widget" data-chart-id="event-ticket-units-trend" role="img" aria-label="{{ 'Ticket sales over time chart'|t }}">
                <canvas height="180"></canvas>
              </div>
            </div>
          {% endif %}
          {% if has_ticket_mix_chart %}
            <div class="mel-analytics__chart-widget mel-chart-card">
              <h3 class="mel-chart-card__title">{{ 'Ticket types'|t }}</h3>
              <div class="mel-chart-card__canvas mel-chart-card__canvas--donut mel-chart-card__canvas--widget" data-chart-id="event-ticket-mix" role="img" aria-label="{{ 'Ticket type mix chart'|t }}">
                <canvas height="180"></canvas>
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </section>
    {% if studio %}</div></details>{% endif %}
  {% endif %}

  {# Merchandise & Add-Ons — ancillary revenue only #}
  {% if merchandise.show|default(false) %}
    {% if studio %}<details class="mel-studio-analytics__group"><summary>{{ 'Merchandise & add-ons'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
    <section class="mel-analytics__business mel-analytics__business--merchandise mel-live-ops__panel" aria-labelledby="mel-analytics-merch-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-merch-title" class="mel-live-ops__panel-title">{{ 'Merchandise & add-ons'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'Are extras worth offering?'|t }}</p>
      </div>
      {% if merchandise.kpis|default([])|length > 0 %}
        {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
          metric_wrap_section: false,
          metric_items: merchandise.kpis,
        } only %}
      {% endif %}
      {% if merchandise.product_rows|default([])|length > 0 %}
        <div class="mel-analytics__product-breakdown">
          <h3 class="mel-analytics__product-breakdown-title">{{ 'Products sold'|t }}</h3>
          <div class="mel-table-responsive">
            <table class="mel-table mel-table--dashboard mel-table--striped">
              <thead>
                <tr>
                  <th scope="col">{{ 'Product'|t }}</th>
                  <th scope="col">{{ 'Type'|t }}</th>
                  <th scope="col">{{ 'Items sold'|t }}</th>
                  <th scope="col">{{ 'Revenue'|t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for product in merchandise.product_rows %}
                  <tr>
                    <td data-label="{{ 'Product'|t }}">{{ product.label }}</td>
                    <td data-label="{{ 'Type'|t }}">{{ product.category }}</td>
                    <td data-label="{{ 'Items sold'|t }}">{{ product.items_sold }}</td>
                    <td data-label="{{ 'Revenue'|t }}">{{ product.revenue }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% endif %}
      {% if has_extras_mix_chart %}
        <div class="mel-analytics__business-charts mel-analytics__business-charts--single">
          <div class="mel-analytics__chart-widget mel-chart-card">
            <h3 class="mel-chart-card__title">{{ 'Merchandise mix'|t }}</h3>
            <div class="mel-chart-card__canvas mel-chart-card__canvas--donut mel-chart-card__canvas--widget" data-chart-id="event-extras-mix" role="img" aria-label="{{ 'Merchandise mix chart'|t }}">
              <canvas height="180"></canvas>
            </div>
          </div>
        </div>
      {% endif %}
    </section>
    {% if studio %}</div></details>{% endif %}
  {% endif %}

  {# Organiser donations — shown only when donation revenue exists #}
  {% if has_donation_metrics %}
    {% if studio %}<details class="mel-studio-analytics__group"><summary>{{ 'Donations'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
    <section class="mel-analytics__business mel-analytics__business--donations mel-live-ops__panel" aria-labelledby="mel-analytics-donations-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-donations-title" class="mel-live-ops__panel-title">{{ 'Donations'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'Optional contributions from attendees for this event.'|t }}</p>
      </div>
      {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
        metric_wrap_section: false,
        metric_items: [
          { label: 'Donation revenue'|t, value: '$' ~ donation_total|number_format(2) },
          { label: 'Donation count'|t, value: donation_count },
          { label: 'Average donation'|t, value: '$' ~ donation_average|number_format(2) },
        ],
      } only %}
    </section>
    {% if studio %}</div></details>{% endif %}
  {% endif %}

  {# Boost — marketing performance (never mixed with revenue) #}
  {% set boost_perf = boost_performance_section|default({}) %}
  {% set boost_level = boost_performance_level|default({}) %}
  {% set boost_actions = boost_action_engine|default({}) %}
  {% if studio %}<details class="mel-studio-analytics__group"><summary>{{ 'Boost performance'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
  <section class="mel-analytics__business mel-analytics__business--boost mel-live-ops__panel mel-analytics__boost-panel" aria-labelledby="mel-analytics-boost-title">
    <div class="mel-live-ops__timeline-head">
      <h2 id="mel-analytics-boost-title" class="mel-live-ops__panel-title">{{ 'Boost performance'|t }}</h2>
      <p class="mel-live-ops__panel-intro">{{ boost_perf.intro|default('Boost puts your event in front of more people.'|t) }}</p>
    </div>
    {% if boost_extension_recommendation %}
      {% include '@myeventlane_vendor_theme/components/mel-boost-extension-card.html.twig' with {
        recommendation: boost_extension_recommendation,
        variant: 'card',
      } only %}
    {% endif %}
    {% include '@myeventlane_vendor_theme/components/mel-boost-performance-level.html.twig' with {
      boost_performance_level: boost_level,
    } only %}
    {% include '@myeventlane_vendor_theme/components/mel-boost-action-engine.html.twig' with {
      boost_action_engine: boost_actions,
    } only %}
    {% if boost_perf.show_metrics|default(false) %}
      <div class="mel-analytics__boost-groups">
        {% if boost_perf.reach.show|default(false) and boost_perf.reach.kpis|default([])|length > 0 %}
          <div class="mel-analytics__boost-group mel-analytics__boost-group--reach">
            <h3 class="mel-analytics__boost-group-title">{{ 'Reach'|t }}</h3>
            {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
              metric_wrap_section: false,
              metric_items: boost_perf.reach.kpis,
            } only %}
          </div>
        {% endif %}
        {% if boost_perf.conversion.show|default(false) %}
          <div class="mel-analytics__boost-group mel-analytics__boost-group--conversion">
            <h3 class="mel-analytics__boost-group-title">{{ 'Conversion'|t }}</h3>
            {% if boost_perf.conversion.paid.show|default(false) and boost_perf.conversion.paid.kpis|default([])|length > 0 %}
              {% if boost_perf.event_type|default('') == 'hybrid' %}
                <h4 class="mel-analytics__boost-subgroup-title">{{ 'Ticket sales'|t }}</h4>
              {% endif %}
              {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
                metric_wrap_section: false,
                metric_items: boost_perf.conversion.paid.kpis,
              } only %}
            {% endif %}
            {% if boost_perf.conversion.rsvp.show|default(false) and boost_perf.conversion.rsvp.kpis|default([])|length > 0 %}
              {% if boost_perf.event_type|default('') == 'hybrid' %}
                <h4 class="mel-analytics__boost-subgroup-title">{{ 'RSVPs & donations'|t }}</h4>
              {% endif %}
              {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
                metric_wrap_section: false,
                metric_items: boost_perf.conversion.rsvp.kpis,
              } only %}
            {% endif %}
          </div>
        {% endif %}
        {% if boost_perf.outcomes.show|default(false) %}
          <div class="mel-analytics__boost-group mel-analytics__boost-group--outcomes">
            <h3 class="mel-analytics__boost-group-title">{{ 'Outcomes'|t }}</h3>
            {% if boost_perf.outcomes.paid.show|default(false) and boost_perf.outcomes.paid.kpis|default([])|length > 0 %}
              {% if boost_perf.event_type|default('') == 'hybrid' %}
                <h4 class="mel-analytics__boost-subgroup-title">{{ 'Ticket sales'|t }}</h4>
              {% endif %}
              {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
                metric_wrap_section: false,
                metric_items: boost_perf.outcomes.paid.kpis,
              } only %}
            {% endif %}
            {% if boost_perf.outcomes.rsvp.show|default(false) and boost_perf.outcomes.rsvp.kpis|default([])|length > 0 %}
              {% if boost_perf.event_type|default('') == 'hybrid' %}
                <h4 class="mel-analytics__boost-subgroup-title">{{ 'RSVPs & donations'|t }}</h4>
              {% endif %}
              {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
                metric_wrap_section: false,
                metric_items: boost_perf.outcomes.rsvp.kpis,
              } only %}
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% if boost_perf.footnote|default('') is not empty %}
        <p class="mel-text--muted mel-analytics__boost-footnote">{{ boost_perf.footnote }}</p>
      {% endif %}
    {% else %}
      <p class="mel-analytics__boost-status">{{ 'Boost status'|t }}: <strong>{{ boost.active|default(false) ? 'Active'|t : 'Not active'|t }}</strong></p>
      {% if boost_page_url %}
        <div class="mel-action-group mel-analytics__boost-cta">
          <a class="mel-btn mel-btn--cta mel-button mel-button--primary" href="{{ boost_page_url }}">{{ 'Boost your event'|t }}</a>
        </div>
      {% endif %}
    {% endif %}
    {% include '@myeventlane_vendor_theme/components/mel-boost-trend-intelligence.html.twig' with {
      boost_trend: boost_trend,
      has_boost_trend_mini_chart: has_boost_trend_mini_chart,
    } only %}
  </section>
  {% if studio %}</div></details>{% endif %}

  {# Placement Performance — where Boost is working best #}
  {% set placement_perf = placement_performance_section|default({}) %}
  {% if placement_perf.show|default(false) and placement_perf.cards|default([])|length > 0 %}
    {% if studio %}<details class="mel-studio-analytics__group"><summary>{{ 'Placement performance'|t }}</summary><div class="mel-studio-analytics__group-body">{% endif %}
    <section class="mel-analytics__business mel-analytics__business--placements mel-live-ops__panel" aria-labelledby="mel-analytics-placements-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-placements-title" class="mel-live-ops__panel-title">{{ 'Placement performance'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'Where is Boost working best?'|t }}</p>
      </div>
      <div class="mel-analytics__placement-grid">
        {% for card in placement_perf.cards %}
          <article class="mel-analytics__placement-card">
            <div class="mel-analytics__placement-card-head">
              <h3 class="mel-analytics__placement-card-title">{{ card.label }}</h3>
              <span class="mel-badge mel-badge--{{ card.performance_badge }}">{{ card.performance_label }}</span>
            </div>
            <dl class="mel-analytics__placement-stats">
              <div class="mel-analytics__placement-stat">
                <dt class="mel-analytics__placement-stat-label">{{ 'Impressions'|t }}</dt>
                <dd class="mel-analytics__placement-stat-value">{{ card.impressions|number_format(0) }}</dd>
              </div>
              <div class="mel-analytics__placement-stat">
                <dt class="mel-analytics__placement-stat-label">{{ 'Clicks'|t }}</dt>
                <dd class="mel-analytics__placement-stat-value">{{ card.clicks|number_format(0) }}</dd>
              </div>
              <div class="mel-analytics__placement-stat">
                <dt class="mel-analytics__placement-stat-label">{{ 'CTR'|t }}</dt>
                <dd class="mel-analytics__placement-stat-value">{{ card.ctr_display }}</dd>
              </div>
            </dl>
          </article>
        {% endfor %}
      </div>
      {% if has_placement_impressions_chart %}
        <div class="mel-analytics__business-charts mel-analytics__business-charts--single">
          <div class="mel-analytics__chart-widget mel-chart-card">
            <h3 class="mel-chart-card__title">{{ 'Impressions by placement'|t }}</h3>
            <div class="mel-chart-card__canvas mel-chart-card__canvas--widget mel-chart-card__canvas--placement-bar" data-chart-id="boost-placement-impressions" role="img" aria-label="{{ 'Impressions by placement chart'|t }}">
              <canvas height="180"></canvas>
            </div>
          </div>
        </div>
      {% endif %}
    </section>
    {% if studio %}</div></details>{% endif %}
  {% endif %}

  {# Recommendations — what to do next (max 3) #}
  {% if next_steps|length > 0 %}
    <section class="mel-analytics__recommendations mel-analytics__recommendations--actions" aria-labelledby="mel-analytics-recs-title">
      <h2 id="mel-analytics-recs-title" class="mel-live-ops__panel-title">{{ 'What to do next'|t }}</h2>
      <ul class="mel-analytics__recommendations-list">
        {% for step in next_steps %}
          <li class="mel-analytics__recommendations-item mel-analytics__action-card">{{ step }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {# Detailed breakdowns — deep investigation (collapsed) #}
  {% if has_detail_sections %}
    <section class="mel-analytics__details-section" aria-labelledby="mel-analytics-details-title">
      <h2 id="mel-analytics-details-title" class="mel-live-ops__panel-title">{{ 'Detailed reporting'|t }}</h2>

      {% if show_ticket_analytics and ticket_tier_breakdown|length > 0 %}
        <div class="mel-card mel-card--collapse">
          <details class="mel-details">
            <summary class="mel-details__summary">{{ 'Ticket breakdown'|t }}</summary>
            <div class="mel-details__body">
              {% for ticket in ticket_tier_breakdown %}
                {% set sold = ticket.sold|default(0) %}
                {% set avail = ticket.available %}
                {% if avail is same as('Unlimited') %}
                  {% set pct = sold > 0 ? 100 : 0 %}
                {% elseif avail is not same as('Unlimited') and avail is not null %}
                  {% set cap = sold + avail %}
                  {% set pct = cap > 0 ? (sold / cap * 100)|round(0) : 0 %}
                {% else %}
                  {% set pct = 0 %}
                {% endif %}
                {% set barw = pct > 100 ? 100 : pct %}
                {% set barw_int = barw < 0 ? 0 : (barw > 100 ? 100 : barw|round(0, 'floor')) %}
                <div class="mel-ticket-breakdown-row">
                  <div class="mel-ticket-breakdown-row__top">
                    <span class="mel-ticket-breakdown-row__name">{{ ticket.label }}</span>
                    <span class="mel-ticket-breakdown-row__nums">{{ sold }} {{ 'sold'|t }}{% if avail is same as('Unlimited') %} · {{ 'Unlimited'|t }}{% elseif avail is not same as('Unlimited') and avail is not null %} · {{ avail }} {{ 'left'|t }}{% endif %} · {{ ticket.revenue|default('—') }}</span>
                  </div>
                  <div class="mel-ticket-breakdown-row__bar" aria-hidden="true">
                    <div class="mel-ticket-breakdown-row__bar-fill mel-ws-pct-{{ barw_int }}"></div>
                  </div>
                </div>
              {% endfor %}
              {% if commerce.booking_activity_note|default('') is not empty %}
                <p class="mel-text--muted mel-analytics__conversion-note">{{ commerce.booking_activity_note }}</p>
              {% endif %}
            </div>
          </details>
        </div>
      {% endif %}

      {% if show_ticket_analytics and ticket_tier_rollup.tier_row_count|default(0) > 0 %}
        <div class="mel-card mel-card--collapse">
          <details class="mel-details">
            <summary class="mel-details__summary">{{ 'Ticket tiers snapshot'|t }}</summary>
            <div class="mel-details__body">
              {% set remaining_display = ticket_tier_rollup.remaining_display|default('0') %}
              {% set rem_val = remaining_display == 'Tickets available'
                ? 'Tickets available'|t
                : (remaining_display == 'No limit'
                  ? 'No limit'|t
                  : (remaining_display == 'Unlimited' ? 'Unlimited'|t : remaining_display)) %}
              {% set gross_val = ticket_tier_rollup.gross_revenue
                ? (ticket_tier_rollup.gross_revenue.currency_code ~ ' ' ~ ticket_tier_rollup.gross_revenue.number)
                : '—' %}
              {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
                metric_wrap_section: false,
                metric_items: [
                  { label: 'Tickets sold (tiers)'|t, value: ticket_tier_rollup.total_sold|default(0) },
                  { label: 'Remaining'|t, value: rem_val },
                  { label: 'Gross revenue (tiers)'|t, value: gross_val },
                  { label: 'Active / sold out'|t, value: (ticket_tier_rollup.active_tier_count|default(0) ~ ' / ' ~ ticket_tier_rollup.sold_out_tier_count|default(0)) },
                ],
              } only %}
              {% if ticket_tier_rollup.conversion_note %}
                <p class="mel-text--muted mel-analytics__conversion-note">{{ ticket_tier_rollup.conversion_note }}</p>
              {% endif %}
              {% if capacity_pct is not null %}
                <div class="mel-analytics__capacity-card" role="group" aria-labelledby="mel-analytics-capacity-title">
                  <h3 id="mel-analytics-capacity-title" class="mel-analytics__capacity-title">{{ 'Capacity sold'|t }}</h3>
                  <p class="mel-analytics__capacity-value">{{ capacity_pct }}%</p>
                  <div class="mel-analytics__capacity-bar" aria-hidden="true">
                    <div class="mel-analytics__capacity-bar-fill" style="width: {{ capacity_pct > 100 ? 100 : capacity_pct }}%;"></div>
                  </div>
                  <p class="mel-analytics__capacity-meta">
                    {{ ticket_tier_rollup.total_sold|default(0) }} {{ 'sold'|t }} · {{ ticket_tier_rollup.total_remaining }} {{ 'remaining'|t }}
                  </p>
                </div>
              {% elseif ticket_tier_rollup.tier_row_count|default(0) > 0 %}
                <div class="mel-analytics__capacity-card mel-analytics__capacity-card--unlimited" role="group" aria-labelledby="mel-analytics-capacity-unlimited-title">
                  <h3 id="mel-analytics-capacity-unlimited-title" class="mel-analytics__capacity-title">{{ 'Capacity sold'|t }}</h3>
                  <p class="mel-analytics__capacity-value">{{ ticket_tier_rollup.total_sold|default(0) }}</p>
                  <p class="mel-analytics__capacity-meta">{{ 'Sold so far — capacity is unlimited or mixed across tiers.'|t }}</p>
                </div>
              {% endif %}
            </div>
          </details>
        </div>
      {% endif %}

      {% if show_ticket_analytics and charts.sales|length > 0 %}
        <div class="mel-card mel-card--collapse">
          <details class="mel-details">
            <summary class="mel-details__summary">{{ 'Daily sales (last 14 days)'|t }}</summary>
            <div class="mel-details__body">
              <div class="mel-table-responsive">
                <table class="mel-table mel-table--dashboard mel-table--striped">
                  <thead>
                    <tr>
                      <th>{{ 'Date'|t }}</th>
                      <th>{{ 'Sales'|t }}</th>
                      <th>{{ 'Tickets'|t }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for day in charts.sales %}
                      <tr>
                        <td>{{ day.date }}</td>
                        <td>${{ day.amount|number_format(2) }}</td>
                        <td>{{ day.tickets }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </details>
        </div>
      {% endif %}

      {% if show_rsvp_analytics and (rsvp_block.confirmed|default(0) > 0 or rsvp_block.pending|default(0) > 0 or rsvp_block.waitlisted|default(0) > 0) %}
        <div class="mel-card mel-card--collapse">
          <details class="mel-details">
            <summary class="mel-details__summary">{{ 'RSVP details'|t }}</summary>
            <div class="mel-details__body">
              <div class="mel-rsvp-summary-grid">
                <div class="mel-rsvp-summary-grid__item">
                  <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.confirmed|default(0) }}</span>
                  <span class="mel-rsvp-summary-grid__label">{{ 'Confirmed'|t }}</span>
                </div>
                <div class="mel-rsvp-summary-grid__item">
                  <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.pending|default(0) }}</span>
                  <span class="mel-rsvp-summary-grid__label">{{ 'Pending'|t }}</span>
                </div>
                <div class="mel-rsvp-summary-grid__item">
                  <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.waitlisted|default(0) }}</span>
                  <span class="mel-rsvp-summary-grid__label">{{ 'Waitlisted'|t }}</span>
                </div>
                <div class="mel-rsvp-summary-grid__item">
                  <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.cancelled|default(0) }}</span>
                  <span class="mel-rsvp-summary-grid__label">{{ 'Cancelled'|t }}</span>
                </div>
                <div class="mel-rsvp-summary-grid__item">
                  <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.checkins|default(0) }}</span>
                  <span class="mel-rsvp-summary-grid__label">{{ 'RSVP check-ins'|t }}</span>
                </div>
              </div>
              {% if att_total > 0 %}
                <p class="mel-analytics__checkin-rate">{{ check_pct }}%</p>
                <p class="mel-analytics__checkin-meta">{{ att_in }} {{ 'of'|t }} {{ att_total }} {{ 'attendees checked in'|t }}</p>
              {% endif %}
            </div>
          </details>
        </div>
      {% endif %}

      {% if merchandise.show|default(false) %}
        <div class="mel-card mel-card--collapse">
          <details class="mel-details">
            <summary class="mel-details__summary">{{ 'Merchandise & add-ons detail'|t }}</summary>
            <div class="mel-details__body">
              {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
                metric_wrap_section: false,
                metric_items: [
                  { label: 'Merch/add-on revenue'|t, value: commerce.extras_revenue|default('—') },
                  { label: 'Items sold'|t, value: commerce.extras_items_sold|default(0) },
                  { label: 'Orders with extras'|t, value: commerce.orders_with_extras|default(0) },
                  { label: 'Top performing extra'|t, value: commerce.top_extras_category|default('—') },
                ],
              } only %}
            </div>
          </details>
        </div>
      {% endif %}

      {% if has_boost_trend_chart %}
        <div class="mel-card mel-card--collapse">
          <details class="mel-details">
            <summary class="mel-details__summary">{{ 'Boost trends'|t }}</summary>
            <div class="mel-details__body">
              <div class="mel-chart-wrap">
                <h4 class="mel-chart-title">{{ 'Impressions vs clicks'|t }}</h4>
                <div class="mel-chart-card__canvas mel-chart-card__canvas--widget" data-chart-id="boost-impressions-clicks" role="img" aria-label="{{ 'Boost impressions vs clicks chart'|t }}">
                  <canvas height="180"></canvas>
                </div>
              </div>
            </div>
          </details>
        </div>
      {% endif %}
    </section>
  {% endif %}

  <div class="mel-support-card mel-analytics__support">
    <h3 class="mel-support-card__title">{{ 'Need a hand?'|t }}</h3>
    <p class="mel-support-card__text">{{ 'Visit the Help Centre for guides on tickets, RSVPs, and Stripe payouts.'|t }}</p>
    <div class="mel-action-group">
      <a class="mel-btn mel-btn--secondary mel-button mel-button--secondary" href="{{ path('myeventlane_help_centre.home') }}">{{ 'Open Help Centre'|t }}</a>
      {% if public_event_url %}
        <a class="mel-btn mel-btn--cta mel-button mel-button--primary" href="{{ public_event_url }}" target="_blank" rel="noopener noreferrer">{{ 'Share your event link'|t }}</a>
      {% endif %}
    </div>
  </div>
</div>
