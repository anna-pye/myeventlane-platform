{#
/**
 * Event analytics — MEL insight dashboard (vendor console).
 *
 * Variables: event, overview, charts, ticket_tier_rollup, boost_page_url, public_event_url,
 * workspace_back_url, edit_event_url, export_pdf_url, export_excel_url
 */
#}
{% if workspace_back_url or edit_event_url or export_pdf_url or export_excel_url %}
  <nav class="mel-live-ops__quick-bar" role="region" aria-label="{{ 'Analytics actions'|t }}">
    <div class="mel-live-ops__quick-inner" role="toolbar">
      {% if workspace_back_url %}
        <a href="{{ workspace_back_url }}" class="mel-live-ops__action mel-live-ops__action--lavender" data-icon="list">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Back to event workspace'|t }}</span>
        </a>
      {% endif %}
      {% if edit_event_url %}
        <a href="{{ edit_event_url }}" class="mel-live-ops__action mel-live-ops__action--muted" data-icon="settings">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Edit event'|t }}</span>
        </a>
      {% endif %}
      {% if export_pdf_url %}
        <a href="{{ export_pdf_url }}" class="mel-live-ops__action mel-live-ops__action--lavender" data-icon="export" target="_blank" rel="noopener noreferrer">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Export PDF'|t }}</span>
        </a>
      {% endif %}
      {% if export_excel_url %}
        <a href="{{ export_excel_url }}" class="mel-live-ops__action mel-live-ops__action--lavender" data-icon="export">
          <span class="mel-live-ops__action-glyph" aria-hidden="true"></span>
          <span class="mel-live-ops__action-label">{{ 'Export Excel'|t }}</span>
        </a>
      {% endif %}
    </div>
  </nav>
{% endif %}

{% set sales = overview.sales|default({}) %}
{% set rsvp_block = overview.rsvps|default({}) %}
{% set attendees = overview.attendees|default({}) %}
{% set boost = overview.boost|default({}) %}
{% set boost_metrics = overview.boost_metrics|default({}) %}
{% set has_sales_chart = charts.sales|default([])|length > 0 %}
{% set has_rsvp_chart = charts.rsvps|default([])|length > 0 %}
{% set att_total = attendees.total|default(0) %}
{% set att_in = attendees.checked_in|default(0) %}
{% set check_pct = att_total > 0 ? ((att_in / att_total) * 100)|round(1) : 0 %}

<div class="mel-workspace-page mel-page mel-analytics mel-live-operations mel-vendor-console-stack">
  <p class="mel-page__next" role="status">
    {% trans %}Next: share your public link and keep an eye on ticket velocity — when you are ready, <strong>Boost</strong> can put your event in front of more people.{% endtrans %}
  </p>

  {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
    metric_title: 'Performance'|t,
    metric_title_id: 'mel-analytics-kpis',
    metric_intro: 'Revenue, tickets, and responses at a glance.'|t,
    metric_items: [
      { label: 'Total revenue'|t, value: sales.gross|default('$0.00') },
      { label: 'Net revenue'|t, value: sales.net|default('$0.00') },
      { label: 'Tickets sold'|t, value: sales.tickets_sold|default(0) },
      { label: 'RSVPs'|t, value: rsvp_block.total_submissions|default(rsvp_block.count|default(0)), note: 'All non-cancelled responses'|t },
    ],
  } only %}

  {% if overview.donations.count|default(0) > 0 %}
    {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
      metric_items: [
        {
          label: 'RSVP donations'|t,
          value: '$' ~ (overview.donations.total|default(0)|number_format(2)),
          note: '@count donation(s)'|t({'@count': overview.donations.count}),
        },
      ],
    } only %}
  {% endif %}

  {% if ticket_tier_rollup.tier_row_count|default(0) > 0 %}
    <section class="mel-live-ops__panel" aria-labelledby="mel-analytics-tier-snapshot-title">
      <div class="mel-live-ops__timeline-head">
        <h2 id="mel-analytics-tier-snapshot-title" class="mel-live-ops__panel-title">{{ 'Ticket tiers snapshot'|t }}</h2>
        <p class="mel-live-ops__panel-intro">{{ 'Based on completed orders — same figures as the ticket workspace.'|t }}</p>
      </div>
        {% set remaining_display = ticket_tier_rollup.remaining_display|default('0') %}
        {% set rem_val = remaining_display == 'Tickets available'
          ? 'Tickets available'|t
          : (remaining_display == 'No limit'
            ? 'No limit'|t
            : (remaining_display == 'Unlimited' ? 'Unlimited'|t : remaining_display)) %}
        {% set gross_val = ticket_tier_rollup.gross_revenue
          ? (ticket_tier_rollup.gross_revenue.currency_code ~ ' ' ~ ticket_tier_rollup.gross_revenue.number)
          : '—' %}
        {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
          metric_wrap_section: false,
          metric_items: [
            { label: 'Tickets sold (tiers)'|t, value: ticket_tier_rollup.total_sold|default(0) },
            { label: 'Remaining'|t, value: rem_val },
            { label: 'Gross revenue (tiers)'|t, value: gross_val },
            { label: 'Active / sold out'|t, value: (ticket_tier_rollup.active_tier_count|default(0) ~ ' / ' ~ ticket_tier_rollup.sold_out_tier_count|default(0)) },
          ],
        } only %}
        {% if ticket_tier_rollup.conversion_note %}
          <p class="mel-text--muted mel-analytics__conversion-note">{{ ticket_tier_rollup.conversion_note }}</p>
        {% endif %}
    </section>
  {% endif %}

  <div class="mel-live-ops__split mel-live-ops__split--analytics-charts">
    <div class="mel-chart-card">
      <h3 class="mel-chart-card__title">{{ 'Sales over time'|t }}</h3>
      {% if has_sales_chart %}
        <div class="mel-chart-card__canvas" data-mel-chart>
          <canvas data-chart-id="event-sales" height="200"></canvas>
        </div>
      {% else %}
        <div class="mel-empty-state mel-empty-state--chart">
          <p class="mel-empty-state__title">{{ 'No data yet'|t }}</p>
          <p class="mel-empty-state__text">{{ 'Once bookings start, your sales will appear here.'|t }}</p>
        </div>
      {% endif %}
    </div>
    <div class="mel-chart-card">
      <h3 class="mel-chart-card__title">{{ 'RSVPs over time'|t }}</h3>
      {% if has_rsvp_chart %}
        <div class="mel-chart-card__canvas" data-mel-chart>
          <canvas data-chart-id="event-rsvps" height="200"></canvas>
        </div>
      {% else %}
        <div class="mel-empty-state mel-empty-state--chart">
          <p class="mel-empty-state__title">{{ 'No trend data yet'|t }}</p>
          <p class="mel-empty-state__text">{{ 'When RSVP activity is recorded day by day, a trend line will show here.'|t }}</p>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="mel-card">
    <div class="mel-card__header">
      <h2 class="mel-card__title">{{ 'Ticket breakdown'|t }}</h2>
      <p class="mel-card__subtitle">{{ 'Sold vs remaining by ticket type'|t }}</p>
    </div>
    <div class="mel-card__body">
      {% if overview.tickets|length > 0 %}
        {% for ticket in overview.tickets %}
          {% set sold = ticket.sold|default(0) %}
          {% set avail = ticket.available %}
          {% if avail is same as('Unlimited') %}
            {% set pct = sold > 0 ? 100 : 0 %}
          {% elseif avail is not same as('Unlimited') and avail is not null %}
            {% set cap = sold + avail %}
            {% set pct = cap > 0 ? (sold / cap * 100)|round(0) : 0 %}
          {% else %}
            {% set pct = 0 %}
          {% endif %}
          {% set barw = pct > 100 ? 100 : pct %}
          {% set barw_int = barw < 0 ? 0 : (barw > 100 ? 100 : barw|round(0, 'floor')) %}
          <div class="mel-ticket-breakdown-row">
            <div class="mel-ticket-breakdown-row__top">
              <span class="mel-ticket-breakdown-row__name">{{ ticket.label }}</span>
              <span class="mel-ticket-breakdown-row__nums">{{ sold }} {{ 'sold'|t }}{% if avail is same as('Unlimited') %} · {{ 'Unlimited'|t }}{% elseif avail is not same as('Unlimited') and avail is not null %} · {{ avail }} {{ 'left'|t }}{% endif %} · {{ ticket.revenue|default('—') }}</span>
            </div>
            <div class="mel-ticket-breakdown-row__bar" aria-hidden="true">
              <div class="mel-ticket-breakdown-row__bar-fill mel-ws-pct-{{ barw_int }}"></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="mel-empty-state mel-empty-state--compact">
          <p class="mel-empty-state__title">{{ 'No tickets sold yet'|t }}</p>
          <p class="mel-empty-state__text">{{ 'Completed ticket orders will be listed here with a quick sold vs remaining view.'|t }}</p>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="mel-live-ops__split mel-live-ops__split--analytics-charts">
    <div class="mel-card">
      <div class="mel-card__header">
        <h2 class="mel-card__title">{{ 'RSVP snapshot'|t }}</h2>
      </div>
      <div class="mel-card__body">
        <div class="mel-rsvp-summary-grid">
          <div class="mel-rsvp-summary-grid__item">
            <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.confirmed|default(0) }}</span>
            <span class="mel-rsvp-summary-grid__label">{{ 'Confirmed'|t }}</span>
          </div>
          <div class="mel-rsvp-summary-grid__item">
            <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.pending|default(0) }}</span>
            <span class="mel-rsvp-summary-grid__label">{{ 'Pending'|t }}</span>
          </div>
          <div class="mel-rsvp-summary-grid__item">
            <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.waitlisted|default(0) }}</span>
            <span class="mel-rsvp-summary-grid__label">{{ 'Waitlisted'|t }}</span>
          </div>
          <div class="mel-rsvp-summary-grid__item">
            <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.cancelled|default(0) }}</span>
            <span class="mel-rsvp-summary-grid__label">{{ 'Cancelled'|t }}</span>
          </div>
          <div class="mel-rsvp-summary-grid__item">
            <span class="mel-rsvp-summary-grid__value">{{ rsvp_block.checkins|default(0) }}</span>
            <span class="mel-rsvp-summary-grid__label">{{ 'RSVP check-ins'|t }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mel-card">
      <div class="mel-card__header">
        <h2 class="mel-card__title">{{ 'Check-in rate'|t }}</h2>
      </div>
      <div class="mel-card__body">
        <p class="mel-analytics__checkin-rate">{{ check_pct }}%</p>
        <p class="mel-analytics__checkin-meta">{{ att_in }} {{ 'of'|t }} {{ att_total }} {{ 'attendees checked in'|t }}</p>
      </div>
    </div>
  </div>

  <div class="mel-card">
    <div class="mel-card__header">
      <h2 class="mel-card__title">{{ 'Boost performance'|t }}</h2>
    </div>
    <div class="mel-card__body">
      {% if boost.active|default(false) %}
        {% set ctr = boost_metrics.ctr|default(0) %}
        {% set ctr_pct = ((ctr * 100)|round(2)) ~ '%' %}
        {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
          metric_wrap_section: false,
          metric_items: [
            { label: 'Spend'|t, value: boost_metrics.spend|default('$0.00') },
            { label: 'Impressions'|t, value: boost_metrics.impressions|default(0) },
            { label: 'Clicks'|t, value: boost_metrics.clicks|default(0) },
            { label: 'CTR'|t, value: ctr_pct },
          ],
        } only %}
        {% if boost.expires %}
          <p class="mel-text--muted mel-analytics__boost-footnote">{{ 'Campaign window data shown above is tied to your Boost purchase.'|t }}</p>
        {% endif %}
      {% else %}
        <div class="mel-empty-state mel-empty-state--compact">
          <p class="mel-empty-state__title">{{ 'No active campaigns'|t }}</p>
          <p class="mel-empty-state__text">{{ 'When you run a Boost, impressions and clicks will show here.'|t }}</p>
          {% if boost_page_url %}
            <div class="mel-action-group mel-analytics__empty-actions">
              <a class="mel-btn mel-btn--cta mel-button mel-button--primary" href="{{ boost_page_url }}">{{ 'Boost your event'|t }}</a>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="mel-card">
    <div class="mel-card__header">
      <h2 class="mel-card__title">{{ 'Daily sales (last 14 days)'|t }}</h2>
    </div>
    <div class="mel-card__body">
      {% if charts.sales|length > 0 %}
        <div class="mel-table-responsive">
          <table class="mel-table mel-table--dashboard mel-table--striped">
            <thead>
              <tr>
                <th>{{ 'Date'|t }}</th>
                <th>{{ 'Sales'|t }}</th>
                <th>{{ 'Tickets'|t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for day in charts.sales %}
                <tr>
                  <td>{{ day.date }}</td>
                  <td>${{ day.amount|number_format(2) }}</td>
                  <td>{{ day.tickets }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="mel-empty-state mel-empty-state--compact">
          <p class="mel-empty-state__text">{{ 'No daily sales rows yet for this window.'|t }}</p>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="mel-support-card">
    <h3 class="mel-support-card__title">{{ 'Need a hand?'|t }}</h3>
    <p class="mel-support-card__text">{{ 'Visit the Help Centre for guides on tickets, RSVPs, and payouts.'|t }}</p>
    <div class="mel-action-group">
      <a class="mel-btn mel-btn--secondary mel-button mel-button--secondary" href="{{ path('myeventlane_help_centre.home') }}">{{ 'Open Help Centre'|t }}</a>
      {% if public_event_url %}
        <a class="mel-btn mel-btn--cta mel-button mel-button--primary" href="{{ public_event_url }}" target="_blank" rel="noopener noreferrer">{{ 'Share your event link'|t }}</a>
      {% endif %}
    </div>
  </div>
</div>
