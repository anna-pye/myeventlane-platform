{#
  Event tickets view.
  Variables: event, sales, tickets.
#}
{% set ta = sales.tickets_available|default(0) %}
{% set rem_tickets = ta == 'Tickets available'
  ? 'Tickets available'|t
  : (ta == 'No limit' ? 'No limit'|t : ta) %}
<div class="mel-workspace-page mel-event-tickets-page mel-live-operations mel-vendor-console-stack">
  <section aria-labelledby="mel-tickets-kpi-heading">
    <div class="mel-live-ops__attendees-head">
      <h2 id="mel-tickets-kpi-heading" class="mel-live-ops__panel-title">{{ 'Sales & shortcuts'|t }}</h2>
      <p class="mel-live-ops__panel-intro">{{ 'A quick read on revenue and links to ticket tools.'|t }}</p>
    </div>
    <div class="mel-live-ops__split">
      <div class="mel-live-ops__stack">
        {% include '@myeventlane_vendor_theme/components/mel-live-ops-metric-board.html.twig' with {
          metric_title: 'Sales summary'|t,
          metric_title_id: 'mel-tickets-sales-summary',
          metric_items: [
            { label: 'Gross'|t, value: sales.gross|default('$0') },
            { label: 'Net'|t, value: sales.net|default('$0') },
            { label: 'Tickets sold'|t, value: sales.tickets_sold|default(0) },
            { label: 'Remaining'|t, value: rem_tickets },
          ],
        } only %}
      </div>
      <div class="mel-live-ops__panel">
        <h3 class="mel-live-ops__panel-title">{{ 'Actions'|t }}</h3>
        <p class="mel-live-ops__panel-intro">{{ 'Configure pricing, checkout, and payouts for this event.'|t }}</p>
        <div class="mel-list mel-list--actions">
          <a class="mel-list__item" href="{{ path('myeventlane_vendor.manage_event.tickets', { event: event_id|default(event.id()) }) }}">
            {{ 'Edit ticket types'|t }}
          </a>
          <a class="mel-list__item" href="{{ path('myeventlane_vendor.manage_event.checkout_questions', { event: event_id|default(event.id()) }) }}">
            {{ 'Checkout questions'|t }}
          </a>
          <a class="mel-list__item" href="{{ path('myeventlane_vendor.manage_event.payments', { event: event_id|default(event.id()) }) }}">
            {{ 'Payment settings'|t }}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="mel-tickets-types-heading">
    <div class="mel-live-ops__attendees-head">
      <h2 id="mel-tickets-types-heading" class="mel-live-ops__panel-title">{{ 'Ticket types'|t }}</h2>
      <p class="mel-live-ops__panel-intro">{{ 'What you are selling and how each tier is tracking.'|t }}</p>
    </div>
    <div class="mel-card mel-card--static">
      <div class="mel-card__header">
        <h3 class="mel-card__title">{{ 'Inventory'|t }}</h3>
        <a class="mel-btn mel-btn--ghost" href="{{ path('myeventlane_vendor.manage_event.tickets', { event: event_id|default(event.id()) }) }}">{{ 'Manage'|t }}</a>
      </div>
      <div class="mel-card__body mel-card__body--flush">
        <div class="mel-table">
        <div class="mel-table__head">
          <div>{{ 'Type'|t }}</div>
          <div>{{ 'Sold'|t }}</div>
          <div>{{ 'Available'|t }}</div>
          <div>{{ 'Revenue'|t }}</div>
        </div>
        <div class="mel-table__body">
          {% for ticket in tickets %}
            <div class="mel-table__row">
              <div>{{ ticket.label }}</div>
              <div>{{ ticket.sold }}</div>
              <div>{{ ticket.available }}</div>
              <div>{{ ticket.revenue }}</div>
            </div>
          {% else %}
            <div class="mel-table__empty">{{ 'No ticket types configured yet.'|t }}</div>
          {% endfor %}
        </div>
        </div>
      </div>
    </div>
  </section>
</div>
