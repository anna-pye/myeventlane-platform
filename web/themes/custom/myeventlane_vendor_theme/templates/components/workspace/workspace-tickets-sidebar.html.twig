{#
/**
 * @file
 * Secondary navigation for ticket tools (sub-routes under /tickets/...).
 *
 * Expects ticket_tabs[] with label, url, active.
 */
#}
{% if ticket_tabs %}
  <nav class="mel-workspace-ticket-tools" aria-label="{{ 'Ticket tools'|t }}">
    <h2 class="mel-workspace-ticket-tools__heading">{{ 'Ticket tools'|t }}</h2>
    <ul class="mel-workspace-ticket-tools__list">
      {% for tab in ticket_tabs %}
        <li class="mel-workspace-ticket-tools__item">
          <a
            href="{{ tab.url }}"
            class="mel-workspace-ticket-tools__link{% if tab.active %} is-active{% endif %}"
            {% if tab.active %}aria-current="page"{% endif %}
          >{{ tab.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}
