{#
/**
 * @file
 * Secondary navigation for ticket tools (sub-routes under /tickets/...).
 *
 * Expects ticket_tabs[] with label, url, active.
 */
#}
{% if ticket_tabs %}
  <div class="mel-workspace-tickets-sidebar">
    <h2 class="mel-workspace-tickets-sidebar__heading">{{ 'Ticket tools'|t }}</h2>
    <ul class="mel-workspace-tickets-sidebar__list">
      {% for tab in ticket_tabs %}
        <li class="mel-workspace-tickets-sidebar__item">
          <a
            href="{{ tab.url }}"
            class="mel-workspace-tickets-sidebar__link{% if tab.active %} is-active{% endif %}"
            {% if tab.active %}aria-current="page"{% endif %}
          >{{ tab.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
