{#
/**
 * @file
 * Vendor sidebar icon set.
 *
 * Variables:
 * - icon: dashboard|events|orders|attendees|audience|payouts|growth|settings|help
 */
#}
{% if icon == 'dashboard' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <rect x="2.5" y="2.5" width="6.5" height="6.5" rx="1.2"></rect>
    <rect x="11" y="2.5" width="6.5" height="4.2" rx="1.2"></rect>
    <rect x="11" y="9.1" width="6.5" height="8.4" rx="1.2"></rect>
    <rect x="2.5" y="11.1" width="6.5" height="6.4" rx="1.2"></rect>
  </svg>
{% elseif icon == 'events' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <rect x="2.5" y="4" width="15" height="13" rx="2"></rect>
    <line x1="2.5" y1="7.2" x2="17.5" y2="7.2"></line>
    <line x1="6.5" y1="2.5" x2="6.5" y2="5.3"></line>
    <line x1="13.5" y1="2.5" x2="13.5" y2="5.3"></line>
  </svg>
{% elseif icon == 'orders' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M3 5h14l-1.3 9.2a2 2 0 0 1-2 1.8H6.3a2 2 0 0 1-2-1.8L3 5Z"></path>
    <path d="M7 5a3 3 0 0 1 6 0"></path>
  </svg>
{% elseif icon == 'attendees' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="7" cy="7" r="2.5"></circle>
    <path d="M2.8 15c.4-2.3 2.4-3.8 4.7-3.8 2.3 0 4.3 1.5 4.7 3.8"></path>
    <circle cx="14" cy="8" r="2"></circle>
    <path d="M11.9 14.8c.3-1.7 1.8-2.9 3.5-2.9.8 0 1.5.2 2.1.6"></path>
  </svg>
{% elseif icon == 'audience' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <path d="M10 2.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15Z"></path>
    <path d="M2.6 10h14.8"></path>
    <path d="M10 2.8c2.1 2 3.2 4.5 3.2 7.2s-1.1 5.2-3.2 7.2c-2.1-2-3.2-4.5-3.2-7.2s1.1-5.2 3.2-7.2Z"></path>
  </svg>
{% elseif icon == 'payouts' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <rect x="2.5" y="4" width="15" height="11.5" rx="2"></rect>
    <line x1="2.8" y1="8" x2="17.2" y2="8"></line>
    <path d="M10 11.2c1.2 0 2.1.6 2.1 1.4S11.2 14 10 14s-2.1-.6-2.1-1.4"></path>
  </svg>
{% elseif icon == 'growth' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <polyline points="3,13 7,9 10,12 16.5,5.5"></polyline>
    <polyline points="12.8,5.5 16.5,5.5 16.5,9.2"></polyline>
  </svg>
{% elseif icon == 'settings' %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="10" cy="10" r="2.4"></circle>
    <path d="M16.8 11.1v-2.2l-1.8-.5a5.4 5.4 0 0 0-.4-1l1-1.6-1.6-1.6-1.6 1a5.4 5.4 0 0 0-1-.4L11.1 3H8.9l-.5 1.8a5.4 5.4 0 0 0-1 .4l-1.6-1-1.6 1.6 1 1.6a5.4 5.4 0 0 0-.4 1L3 8.9v2.2l1.8.5c.1.3.2.7.4 1l-1 1.6 1.6 1.6 1.6-1c.3.2.7.3 1 .4l.5 1.8h2.2l.5-1.8c.3-.1.7-.2 1-.4l1.6 1 1.6-1.6-1-1.6c.2-.3.3-.7.4-1l1.8-.5Z"></path>
  </svg>
{% else %}
  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
    <circle cx="10" cy="10" r="7.2"></circle>
    <line x1="10" y1="7.2" x2="10" y2="10.3"></line>
    <circle cx="10" cy="12.8" r=".1"></circle>
  </svg>
{% endif %}
