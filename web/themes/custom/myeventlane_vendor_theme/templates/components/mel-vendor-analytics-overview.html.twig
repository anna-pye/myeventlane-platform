{#
/**
 * @file
 * Vendor dashboard analytics overview KPI cards (Stage 1).
 */
#}
{% if analytics_cards is defined and analytics_cards is iterable and analytics_cards|length > 0 %}
<section class="mel-vendor-analytics" aria-labelledby="mel-vendor-analytics-title">
  <h2 id="mel-vendor-analytics-title" class="mel-vendor-analytics__title">{{ 'Analytics Overview'|t }}</h2>
  <div class="mel-vendor-analytics__grid" role="list">
    {% for card in analytics_cards %}
      <article
        class="mel-vendor-analytics__card"
        role="listitem"
        aria-label="{{ card.aria_label|default(card.label) }}"
      >
        <span class="mel-vendor-analytics__label">{{ card.label }}</span>
        <span class="mel-vendor-analytics__value">{{ card.value }}</span>
        {% if card.sub is defined and card.sub %}
          <span class="mel-vendor-analytics__sub">{{ card.sub }}</span>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>
{% endif %}
