<div class="mel-studio-layout">
  <div
    class="mel-studio-main"
    data-mel-studio
    data-mel-selected-event-id="{{ active_event.id|default('') }}"
    data-mel-overview-save-token="{{ overview_save_token|default('') }}"
  >
    <section class="mel-event-navigator">

    <h3>Your Events</h3>

    <div class="mel-event-list" data-mel-studio-list>

      {% for event in events %}
        {% include '@myeventlane_vendor_theme/components/vendor-event-card.html.twig' with { event: event } only %}
      {% else %}
        <div class="mel-empty-panel">
          {{ 'No events found yet.'|t }}
        </div>
      {% endfor %}

    </div>

    </section>


    <div class="mel-studio-workspace">
      <main class="mel-studio-editor">

      {% if active_event %}

      <section class="mel-editor-top">
        <div class="mel-editor-heading">
          <p class="mel-editor-kicker">{{ 'MEL Event Editor'|t }}</p>
          <h2 class="mel-editor-title">{{ active_event.title|default('Event editor') }}</h2>
          <span class="mel-status-badge mel-status-badge--{{ active_event.status|default('draft')|clean_class }}">{{ active_event.status|default('draft')|capitalize }}</span>
        </div>

        <div class="mel-command-center mel-live-ops__metric-board" role="list">

          <article class="mel-live-ops__stat-card mel-live-ops__stat-card--total" role="listitem">
            <span class="mel-live-ops__stat-icon" aria-hidden="true"></span>
            <span class="mel-live-ops__stat-label">{{ 'Tickets sold'|t }}</span>
            <strong class="mel-live-ops__stat-value" data-mel-metric-tickets>{{ active_event.tickets_metric|default(0) }}</strong>
          </article>

          <article class="mel-live-ops__stat-card mel-live-ops__stat-card--in" role="listitem">
            <span class="mel-live-ops__stat-icon" aria-hidden="true"></span>
            <span class="mel-live-ops__stat-label">{{ 'RSVPs'|t }}</span>
            <strong class="mel-live-ops__stat-value" data-mel-metric-rsvps>{{ active_event.rsvps_metric|default(0) }}</strong>
          </article>

          <article class="mel-live-ops__stat-card mel-live-ops__stat-card--ready" role="listitem">
            <span class="mel-live-ops__stat-icon" aria-hidden="true"></span>
            <span class="mel-live-ops__stat-label">{{ 'Revenue'|t }}</span>
            <strong class="mel-live-ops__stat-value" data-mel-metric-revenue>${{ active_event.revenue_metric|default('0') }}</strong>
          </article>

          <article class="mel-live-ops__stat-card mel-live-ops__stat-card--capacity" role="listitem">
            <span class="mel-live-ops__stat-icon" aria-hidden="true"></span>
            <span class="mel-live-ops__stat-label">{{ 'Health'|t }}</span>
            <strong class="mel-live-ops__stat-value" data-mel-metric-health>{{ active_event.health_label|default('Draft') }}</strong>
          </article>

        </div>


        <div class="mel-quick-actions">

          <a class="mel-btn" href="{{ active_event.quick_actions.preview_url|default('#') }}" data-mel-action-preview>
            Preview
          </a>

          <a class="mel-btn" href="{{ active_event.quick_actions.view_url|default('#') }}" data-mel-action-view>
            View
          </a>

          <button class="mel-btn mel-btn-primary">
            {{ 'Promote event'|t }}
          </button>

        </div>

        <div class="mel-editor-guidance">
          <h3>{{ 'Guided setup'|t }}</h3>
          <ul class="mel-editor-guidance__list">
            <li><strong>{{ '1. Basics'|t }}</strong> {{ 'Title, category, and core details.'|t }}</li>
            <li><strong>{{ '2. When & Where'|t }}</strong> {{ 'Schedule and venue context.'|t }}</li>
            <li><strong>{{ '3. Tickets & Capacity'|t }}</strong> {{ 'Pricing, RSVP, and limits.'|t }}</li>
            <li><strong>{{ '4. Details & Publish'|t }}</strong> {{ 'Final polish and submission.'|t }}</li>
          </ul>
        </div>

      </section>

      <div class="mel-editor-status" data-mel-status></div>
      <div class="mel-studio-wizard-shell">
        {# Full-page wizard only: embedding the Drupal wizard in an iframe breaks UX, cookies, and scrolling. #}
        <div class="mel-studio-wizard-launch">
          <p class="mel-studio-wizard-launch__lead">
            {{ 'The guided event wizard opens as a full page (not inside this screen).'|t }}
          </p>
          <a
            class="mel-btn mel-btn-primary mel-studio-wizard-open"
            data-mel-wizard-open
            href="{{ active_event.wizard_url|default('#') }}"
          >{{ 'Open event wizard'|t }}</a>
          <p class="mel-text-muted mel-studio-wizard-launch__hint">
            {{ 'Support MyEventLane (optional vendor contribution) is on the Tickets & Capacity step.'|t }}
          </p>
          <p class="mel-text-muted mel-studio-wizard-launch__hint">
            {{ 'Use the browser back button or Vendor → Events to return here after saving a step.'|t }}
          </p>
        </div>
      </div>

      {% else %}

        <div class="mel-empty-state">
          Select an event to start editing
        </div>

      {% endif %}

      </main>
    </div>
  </div>

  <aside class="mel-help-panel mel-studio-sidebar">
    {% if active_event %}
      <section class="mel-studio-inspector">
        <h4 data-mel-editor-title>{{ active_event.title|default('Event Details') }}</h4>
        <p>{{ active_event.date|default('') }}</p>
        <p><strong>{{ 'Status:'|t }}</strong> <span data-mel-inspector-state>{{ active_event.status|default('draft')|capitalize }}</span></p>
        <p><strong>{{ 'Health:'|t }}</strong> <span data-mel-inspector-health>{{ active_event.health_label|default('Draft') }}</span></p>

        {% set checklist = active_event.checklist|default({}) %}
        <ul class="mel-inspector-checklist">
          <li data-mel-check="title" class="{{ checklist.title|default(false) ? 'is-complete' : 'is-missing' }}">{{ 'Title added'|t }}</li>
          <li data-mel-check="date" class="{{ checklist.date|default(false) ? 'is-complete' : 'is-missing' }}">{{ 'Date set'|t }}</li>
          <li data-mel-check="location" class="{{ checklist.location|default(false) ? 'is-complete' : 'is-missing' }}">{{ 'Location set'|t }}</li>
          <li data-mel-check="banner" class="{{ checklist.banner|default(false) ? 'is-complete' : 'is-missing' }}">{{ 'Banner uploaded'|t }}</li>
        </ul>
      </section>
    {% endif %}

    {{ drupal_block('myeventlane_vendor_help_panel') }}
  </aside>

</div>
