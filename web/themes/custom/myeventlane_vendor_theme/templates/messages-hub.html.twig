{#
/**
 * @file
 * Organiser Messages Hub — Communication Centre.
 *
 * Variables:
 *   - hub: view model from VendorMessagesHubBuilder
 */
#}
{% set health = hub.health|default({}) %}
{% set overview = hub.overview|default({}) %}
{% set compose = hub.compose|default({}) %}
{% set scheduled = hub.scheduled|default({}) %}
{% set history = hub.history|default({}) %}
{% set templates = hub.templates|default({}) %}
{% set branding = hub.branding|default({}) %}
{% set support = hub.support|default({}) %}

<div class="mel-messages-hub" data-mel-messages-hub data-mel-analytics-event="messages_hub_opened">

  <nav class="mel-messages-hub__jump" aria-label="{{ 'Messages sections'|t }}">
    <a class="mel-messages-hub__jump-link" href="#compose">{{ 'Send a message'|t }}</a>
    <a class="mel-messages-hub__jump-link" href="#activity">{{ 'Activity'|t }}</a>
    <a class="mel-messages-hub__jump-link" href="#message-tools">{{ 'Message tools'|t }}</a>
    <a class="mel-messages-hub__jump-link" href="#support">{{ 'Help'|t }}</a>
  </nav>

  <section class="mel-messages-hub__health mel-card mel-card--status mel-messages-hub__health--{{ health.tone|default('muted') }}" id="messages-status" aria-labelledby="mel-messages-health-heading">
    <div class="mel-messages-hub__health-header">
      <p class="mel-messages-hub__eyebrow">{{ 'Messages'|t }}</p>
      <h2 id="mel-messages-health-heading" class="mel-messages-hub__health-title">{{ health.headline }}</h2>
      <p class="mel-messages-hub__health-summary">{{ health.summary }}</p>
    </div>
    {% if health.next_step %}
      <p class="mel-messages-hub__muted"><strong>{{ 'Next step'|t }}:</strong> {{ health.next_step }}</p>
    {% endif %}
    <div class="mel-messages-hub__actions">
      {% if health.cta_url %}
        <a class="mel-button mel-button--primary" href="{{ health.cta_url }}" data-mel-analytics-event="message_created">{{ health.cta_label }}</a>
      {% endif %}
    </div>
  </section>

  <section class="mel-messages-hub__overview" id="overview" aria-labelledby="mel-messages-overview-heading">
    <h2 id="mel-messages-overview-heading" class="mel-messages-hub__section-title">{{ 'Overview'|t }}</h2>
    <div class="mel-messages-hub__kpi-row" role="list">
      <div class="mel-messages-hub__kpi" role="listitem">
        <span class="mel-messages-hub__kpi-label">{{ 'Events'|t }}</span>
        <span class="mel-messages-hub__kpi-value" aria-label="{{ 'Events you can message'|t }} {{ overview.events|default(0) }}">{{ overview.events|default(0) }}</span>
      </div>
      <div class="mel-messages-hub__kpi" role="listitem">
        <span class="mel-messages-hub__kpi-label">{{ 'Sent'|t }}</span>
        <span class="mel-messages-hub__kpi-value" aria-label="{{ 'Messages sent'|t }} {{ overview.sent|default(0) }}">{{ overview.sent|default(0) }}</span>
      </div>
      <div class="mel-messages-hub__kpi" role="listitem">
        <span class="mel-messages-hub__kpi-label">{{ 'Sending'|t }}</span>
        <span class="mel-messages-hub__kpi-value" aria-label="{{ 'Messages sending'|t }} {{ overview.sending|default(0) }}">{{ overview.sending|default(0) }}</span>
      </div>
      <div class="mel-messages-hub__kpi" role="listitem">
        <span class="mel-messages-hub__kpi-label">{{ 'Needs attention'|t }}</span>
        <span class="mel-messages-hub__kpi-value" aria-label="{{ 'Failed messages'|t }} {{ overview.failed|default(0) }}">{{ overview.failed|default(0) }}</span>
      </div>
    </div>
  </section>

  <section class="mel-card mel-messages-hub__section" id="compose" aria-labelledby="mel-messages-compose-heading">
    <div class="mel-card__header mel-messages-hub__section-header">
      <h2 id="mel-messages-compose-heading" class="mel-card__title">{{ compose.title }}</h2>
    </div>
    <p class="mel-messages-hub__muted">{{ compose.body }}</p>

    {% if compose.events is empty %}
      <div class="mel-empty-state" role="status">
        <p class="mel-empty-state__title">{{ compose.empty_title }}</p>
        <p class="mel-empty-state__body">{{ compose.empty_body }}</p>
      </div>
    {% else %}
      <div class="mel-messages-hub__event-filter">
        <label for="mel-message-event-search">{{ 'Find an event'|t }}</label>
        <input
          id="mel-message-event-search"
          class="mel-messages-hub__event-search"
          type="search"
          placeholder="{{ 'Search by event name'|t }}"
          autocomplete="off"
          data-mel-message-event-search
        >
        <p class="mel-messages-hub__muted" aria-live="polite" data-mel-message-event-count></p>
      </div>
      <ul class="mel-messages-hub__event-list">
        {% for event in compose.events %}
          <li class="mel-messages-hub__event-item" data-mel-message-event="{{ event.search_text|e('html_attr') }}">
            <div class="mel-messages-hub__event-copy">
              <p class="mel-messages-hub__event-title">{{ event.title }}</p>
              <p class="mel-messages-hub__muted">{{ '@count guest(s) reachable'|t({'@count': event.audience_count|default(0)}) }}</p>
            </div>
            <div class="mel-messages-hub__event-actions">
              {% if event.compose_url %}
                <a class="mel-button mel-button--primary" href="{{ event.compose_url }}" data-mel-analytics-event="message_created">{{ 'New message'|t }}</a>
              {% endif %}
              {% if event.hub_url %}
                <a class="mel-messages-hub__link" href="{{ event.hub_url }}">{{ 'Event Messages'|t }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
      <p class="mel-empty-state mel-messages-hub__search-empty" data-mel-message-event-empty hidden>
        {{ 'No events match that search. Try another event name.'|t }}
      </p>
    {% endif %}

    {% if compose.types %}
      <h3 class="mel-messages-hub__subsection-title">{{ 'What should I send?'|t }}</h3>
      <div class="mel-messages-hub__type-grid" role="list">
        {% for type in compose.types %}
          <article class="mel-messages-hub__type-card" role="listitem">
            <h4 class="mel-messages-hub__type-title">{{ type.label }}</h4>
            <dl class="mel-messages-hub__facts">
              <div class="mel-messages-hub__fact">
                <dt>{{ 'When to use it'|t }}</dt>
                <dd>{{ type.when }}</dd>
              </div>
              <div class="mel-messages-hub__fact">
                <dt>{{ 'Who receives it'|t }}</dt>
                <dd>{{ type.who }}</dd>
              </div>
              <div class="mel-messages-hub__fact">
                <dt>{{ 'Impact'|t }}</dt>
                <dd>{{ type.impact }}</dd>
              </div>
            </dl>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  <div class="mel-messages-hub__activity-grid" id="activity">
  <section class="mel-card mel-messages-hub__section" id="scheduled" aria-labelledby="mel-messages-scheduled-heading">
    <h2 id="mel-messages-scheduled-heading" class="mel-card__title">{{ scheduled.title }}</h2>
    <p class="mel-messages-hub__muted">{{ scheduled.body }}</p>
    {% if scheduled.items is empty %}
      <div class="mel-empty-state" role="status">
        <p class="mel-empty-state__title">{{ scheduled.empty_title }}</p>
        <p class="mel-empty-state__body">{{ scheduled.empty_body }}</p>
      </div>
    {% else %}
      <ol class="mel-messages-hub__timeline">
        {% for item in scheduled.items %}
          <li class="mel-messages-hub__timeline-item">
            <p class="mel-messages-hub__timeline-subject">{{ item.subject }}</p>
            <p class="mel-messages-hub__muted">{{ item.event_title }} · {{ item.status_label }} · {{ item.sent_label }}</p>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </section>

  <section class="mel-card mel-messages-hub__section" id="history" aria-labelledby="mel-messages-history-heading" data-mel-analytics-event="message_sent">
    <h2 id="mel-messages-history-heading" class="mel-card__title">{{ history.title }}</h2>
    {% if history.items is empty %}
      <div class="mel-empty-state" role="status">
        <p class="mel-empty-state__title">{{ history.empty_title }}</p>
        <p class="mel-empty-state__body">{{ history.empty_body }}</p>
      </div>
    {% else %}
      <ol class="mel-messages-hub__timeline" aria-label="{{ 'Message history'|t }}">
        {% for item in history.items %}
          <li class="mel-messages-hub__timeline-item mel-messages-hub__timeline-item--{{ item.status_key|default('sent') }}">
            <div class="mel-messages-hub__timeline-header">
              <p class="mel-messages-hub__timeline-subject">{{ item.subject }}</p>
              <span class="mel-messages-hub__status">{{ item.status_label }}</span>
            </div>
            <p class="mel-messages-hub__muted">{{ item.type_label }} · {{ item.audience_label }} · {{ item.event_title }}</p>
            <p class="mel-messages-hub__muted">{{ item.sent_label }} · {{ item.delivery_summary }}</p>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </section>
  </div>

  <section class="mel-card mel-messages-hub__section" id="message-tools" aria-labelledby="mel-messages-tools-heading">
    <h2 id="mel-messages-tools-heading" class="mel-card__title">{{ 'Message tools'|t }}</h2>
    <p class="mel-messages-hub__section-intro">{{ 'Set up your automatic email wording and the way guest emails look.'|t }}</p>

    <div class="mel-messages-hub__tool-list">
      <details class="mel-messages-hub__tool{% if not templates.is_pro %} mel-messages-hub__tool--locked{% endif %}">
        <summary>{{ templates.title }}{% if not templates.is_pro %} <span class="mel-messages-hub__badge">{{ 'Pro'|t }}</span>{% endif %}</summary>
        <div class="mel-messages-hub__tool-content">
          <p class="mel-messages-hub__muted">{{ templates.body }}</p>
          {% if templates.available and templates.cta_url %}
            <a class="mel-button mel-button--secondary" href="{{ templates.cta_url }}" data-mel-analytics-event="template_used">{{ templates.cta_label }}</a>
          {% elseif not templates.is_pro and templates.upgrade_url %}
            <a class="mel-button mel-button--secondary" href="{{ templates.upgrade_url }}">{{ templates.upgrade_label }}</a>
          {% endif %}
        </div>
      </details>

      <details class="mel-messages-hub__tool{% if not branding.is_pro %} mel-messages-hub__tool--locked{% endif %}">
        <summary>{{ branding.title }}{% if not branding.is_pro %} <span class="mel-messages-hub__badge">{{ 'Pro'|t }}</span>{% endif %}</summary>
        <div class="mel-messages-hub__tool-content">
          <p class="mel-messages-hub__muted">{{ branding.body }}</p>
          {% if branding.is_pro %}
            <p class="mel-messages-hub__muted" role="status">
              {% if branding.ready %}
                {{ 'Brand looks ready for guest emails.'|t }}
              {% else %}
                {{ 'Add a sender name so guests recognise your emails.'|t }}
              {% endif %}
            </p>
          {% endif %}
          {% if branding.available and branding.cta_url %}
            <a class="mel-button mel-button--secondary" href="{{ branding.cta_url }}">{{ branding.cta_label }}</a>
          {% elseif not branding.is_pro and branding.upgrade_url %}
            <a class="mel-button mel-button--secondary" href="{{ branding.upgrade_url }}">{{ branding.upgrade_label }}</a>
          {% endif %}
        </div>
      </details>
    </div>
  </section>

  <section class="mel-card mel-messages-hub__section" id="support" aria-labelledby="mel-messages-support-heading">
    <h2 id="mel-messages-support-heading" class="mel-card__title">{{ support.title }}</h2>
    <p class="mel-messages-hub__muted">{{ support.body }}</p>
    <div class="mel-messages-hub__actions">
      {% if support.cta_url %}
        <a class="mel-button mel-button--secondary" href="{{ support.cta_url }}">{{ support.cta_label }}</a>
      {% endif %}
      {% if support.help_url %}
        <a class="mel-messages-hub__link" href="{{ support.help_url }}">{{ support.help_label }}</a>
      {% endif %}
    </div>
  </section>

</div>
