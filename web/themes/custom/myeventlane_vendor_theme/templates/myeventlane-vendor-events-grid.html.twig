{#
/**
 * @file
 * Vendor console events index (TASK 6). Model-driven only — no entity logic here.
 *
 * Variables:
 * - vendor_event_index_model: TASK 6 shape (optional for backward compatibility).
 * - events: legacy (unused when model present).
 */
#}
{% set model = vendor_event_index_model|default({}) %}
{% set summary = model.summary|default({}) %}
{% set summary_items = model.summary_items|default([]) %}
{% set filters = model.filters|default({'active': 'current', 'items': []}) %}
{% set sort = model.sort|default({'active': 'recommended', 'items': []}) %}
{% set search = model.search|default({'value': '', 'clear_url': null}) %}
{% set events = model.events|default([]) %}
{% set empty_state = model.empty_state|default({}) %}
{% set primary = model.primary_action|default({}) %}
{% set selection = bulk_selection|default(null) %}
{% set actions = bulk_actions|default(null) %}

<div class="mel-vendor-events-v2 mel-organiser-page" data-events-index data-events-index-url="{{ path('myeventlane_vendor.console.events') }}">
  <header class="mel-vendor-events-v2__header mel-organiser-page__intro">
    <div class="mel-vendor-events-v2__header-text mel-organiser-page__intro-copy">
      <span class="mel-organiser-page__eyebrow">{{ 'Your work'|t }}</span>
      <h1 class="mel-vendor-events-v2__title mel-organiser-page__title">{{ model.title|default('Events'|t) }}</h1>
      {% if model.subtitle %}
        <p class="mel-vendor-events-v2__subtitle mel-organiser-page__description">{{ model.subtitle }}</p>
      {% endif %}
    </div>
    {% if events|length > 0 and actions %}
      <button
        type="button"
        class="mel-btn mel-btn--secondary mel-vendor-events-v2__select-toggle"
        data-events-select-toggle
        aria-expanded="false"
      >{{ 'Select events'|t }}</button>
    {% endif %}
  </header>

  {% if summary_items is iterable and summary_items|length > 0 %}
    <section class="mel-vendor-events-v2__summary" aria-label="{{ 'Event focus'|t }}">
      {% for item in summary_items %}
        <a
          class="mel-vendor-events-v2__summary-card{% if item.emphasis %} mel-vendor-events-v2__summary-card--attention{% endif %}"
          href="{{ item.url }}"
        >
          <span class="mel-vendor-events-v2__summary-value">{{ item.value }}</span>
          <span class="mel-vendor-events-v2__summary-label">{{ item.label }}</span>
        </a>
      {% endfor %}
    </section>
  {% endif %}

  {% if filters.items is iterable and filters.items|length > 0 %}
    <nav class="mel-vendor-events-v2__filters" aria-label="{{ 'Filter events'|t }}">
      {% for item in filters.items %}
        {% if item.url is defined and item.url %}
          <a
            class="mel-vendor-events-v2__filter{% if item.active %} is-active{% endif %}"
            href="{{ item.url }}"
            {% if item.active %}aria-current="page"{% endif %}
          >
            {{ item.label }}
            {% if item.count is not null %}
              <span class="mel-vendor-events-v2__filter-count">({{ item.count }})</span>
            {% endif %}
          </a>
        {% else %}
          <span class="mel-vendor-events-v2__filter mel-vendor-events-v2__filter--disabled{% if item.active %} is-active{% endif %}">
            {{ item.label }}
            {% if item.count is not null %}
              <span class="mel-vendor-events-v2__filter-count">({{ item.count }})</span>
            {% endif %}
          </span>
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}

  <div class="mel-vendor-events-v2__controls">
    <div class="mel-vendor-events-v2__search">
      <label for="mel-event-search">{{ 'Search events'|t }}</label>
      <div class="mel-vendor-events-v2__search-row">
        <input
          id="mel-event-search"
          type="search"
          value="{{ search.value|e('html_attr') }}"
          placeholder="{{ 'Event name'|t }}"
          data-events-search
        />
        <button type="button" class="mel-btn mel-btn--secondary" data-events-search-apply>{{ 'Search'|t }}</button>
        {% if search.value and search.clear_url %}
          <a class="mel-vendor-events-v2__clear" href="{{ search.clear_url }}">{{ 'Clear'|t }}</a>
        {% endif %}
      </div>
    </div>
    {% if sort.items is iterable and sort.items|length > 0 %}
      <div class="mel-vendor-events-v2__sort">
        <label for="mel-events-sort">{{ 'Sort by'|t }}</label>
        <select id="mel-events-sort" data-events-sort>
          {% for s in sort.items %}
            {% if s.url is defined and s.url %}
              <option value="{{ s.url }}"{% if s.active %} selected{% endif %}>{{ s.label }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
    {% endif %}
  </div>

  {% if actions %}
    <div class="mel-vendor-events-v2__bulk-region" data-events-bulk-region hidden>
      {{ actions }}
      <button type="button" class="mel-btn mel-btn--secondary" data-events-select-cancel>{{ 'Cancel selection'|t }}</button>
      <p class="mel-vendor-events-v2__bulk-note">{{ 'Archive or delete one event at a time so booking records stay protected.'|t }}</p>
    </div>
  {% endif %}

  <p class="mel-vendor-events-v2__result-count" role="status">
    {{ model.result_label|default('0 events'|t) }}
  </p>

  {% if events is iterable and events|length > 0 %}
    <div class="mel-vendor-events-v2__grid">
      {% if sort.active != 'recommended' %}
        <h2 class="visually-hidden">{{ 'Event results'|t }}</h2>
      {% endif %}
      {% set previous_section = null %}
      {% for ev in events %}
        {% set links = ev.links|default({}) %}
        {% set boost = ev.boost|default({}) %}
        {% set boost_extension_recommendation = ev.boost_extension_recommendation|default(null) %}
        {% set sev = ev.status_severity|default('neutral') %}
        {% if sort.active == 'recommended' and ev.section_key|default('') != previous_section %}
          <h2 class="mel-vendor-events-v2__section-title">{{ ev.section_label }}</h2>
          {% set previous_section = ev.section_key|default('') %}
        {% endif %}
        <article class="mel-vendor-events-v2__card{% if ev.section_key|default('') == 'past' %} mel-vendor-events-v2__card--quiet{% endif %}{% if boost.active %} mel-vendor-events-v2__card--boosted{% endif %}" data-event-card>
          {% if selection %}
            {{ attribute(selection, ev.nid) }}
          {% endif %}
          <div class="mel-vendor-events-v2__card-top">
            {% set img = ev.image|default({}) %}
            {% set img_url = img.url|default('') %}
            {% set img_alt = img.alt|default('') %}
            {% set img_ph = img.is_placeholder|default(false) %}
            {% if img_url %}
              <div class="mel-event-card-thumb{% if img_ph %} mel-event-card-thumb--placeholder{% endif %}"{% if not img_ph %} aria-hidden="true"{% endif %}>
                <img class="mel-event-card-thumb__img" src="{{ img_url }}" alt="{{ img_alt|e('html_attr') }}" loading="lazy" width="56" height="56"/>
              </div>
            {% else %}
              <div class="mel-event-card-thumb mel-event-card-thumb--fallback">
                <span class="mel-event-card-thumb__fallback-label" role="img" aria-label="{{ 'Event image'|t }}">{{ 'MEL'|t }}</span>
              </div>
            {% endif %}
            <div class="mel-vendor-events-v2__card-body">
              <div class="mel-vendor-events-v2__card-header">
                <span class="mel-vendor-events-v2__status mel-vendor-events-v2__status--{{ sev|e('html_attr') }}">{{ ev.status_label|default('') }}</span>
                {% if boost.active %}
                  <span class="mel-vendor-events-v2__boost-badge">{{ '🚀 Boosted'|t }}</span>
                {% endif %}
                {% if ev.needs_attention and ev.attention_label %}
                  <span class="mel-vendor-events-v2__attention">{{ ev.attention_label }}</span>
                {% endif %}
              </div>
              {% set issues = ev.presentation_issues|default([]) %}
              {% if issues is iterable and issues|length > 0 %}
                <div class="mel-vendor-events-v2__issues" role="group" aria-label="{{ 'Setup issues'|t }}">
                  {% for issue in issues %}
                    {% set isev = issue.severity|default('warning') %}
                    <span class="mel-vendor-events-v2__issue-chip mel-vendor-events-v2__issue-chip--{{ isev|e('html_attr') }}">
                      <span class="mel-vendor-events-v2__issue-dot" aria-hidden="true"></span>
                      {{ issue.label|default('') }}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}
              <h3 class="mel-vendor-events-v2__card-title">{{ ev.title|default('') }}</h3>
              {% if boost.active %}
                <p class="mel-vendor-events-v2__boost-meta">
                  {% if boost.expires %}
                    {{ 'Featured until @date'|t({'@date': boost.expires}) }}
                  {% elseif boost.days_remaining is not null %}
                    {% if boost.days_remaining == 1 %}
                      {{ '1 day remaining'|t }}
                    {% else %}
                      {{ '@count days remaining'|t({'@count': boost.days_remaining}) }}
                    {% endif %}
                  {% endif %}
                </p>
              {% endif %}
              {% if boost_extension_recommendation %}
                {% include '@myeventlane_vendor_theme/components/mel-boost-extension-card.html.twig' with {
                  recommendation: boost_extension_recommendation,
                  variant: 'compact',
                  boost: boost,
                } only %}
              {% endif %}
              <div class="mel-vendor-events-v2__meta">
                {% if ev.date_label %}
                  <span class="mel-vendor-events-v2__meta-line">{{ ev.date_label }}</span>
                {% endif %}
                {% if ev.event_type_label %}
                  <span class="mel-vendor-events-v2__meta-line">{{ ev.event_type_label }}</span>
                {% endif %}
              </div>
              <div class="mel-vendor-events-v2__metrics">
                {% if ev.metric_label %}
                  <span class="mel-vendor-events-v2__metric">{{ ev.metric_label }}</span>
                {% endif %}
                {% if ev.revenue_label %}
                  <span class="mel-vendor-events-v2__metric mel-vendor-events-v2__metric--revenue">{{ ev.revenue_label }}</span>
                {% endif %}
                {% if ev.capacity_label %}
                  <span class="mel-vendor-events-v2__metric">{{ ev.capacity_label }}</span>
                {% endif %}
              </div>
              {% if boost.active and links.analytics is defined and links.analytics %}
                <a class="mel-vendor-events-v2__boost-performance" href="{{ links.analytics }}">{{ 'View Boost Performance →'|t }}</a>
              {% endif %}
            </div>
          </div>
          <div class="mel-vendor-events-v2__card-actions">
            {% if links.manage is defined and links.manage %}
              <a class="mel-btn mel-btn--primary mel-vendor-events-v2__action-primary" href="{{ links.manage }}">
                {{ 'Open workspace'|t }}
                <span class="visually-hidden">: {{ ev.title|default('Untitled event'|t) }}</span>
              </a>
            {% endif %}
            <details class="mel-vendor-events-v2__more-actions">
              <summary>{{ 'More actions'|t }}</summary>
              <div class="mel-vendor-events-v2__more-actions-panel">
                <div class="mel-vendor-events-v2__optional-links">
                  {% if links.edit is defined and links.edit %}
                    <a class="mel-vendor-events-v2__link" href="{{ links.edit }}">{{ 'Edit event'|t }}</a>
                  {% endif %}
                  {% if links.tickets is defined and links.tickets %}
                    <a class="mel-vendor-events-v2__link" href="{{ links.tickets }}">{{ 'Tickets'|t }}</a>
                  {% endif %}
                  {% if links.rsvps is defined and links.rsvps %}
                    <a class="mel-vendor-events-v2__link" href="{{ links.rsvps }}">{{ 'RSVPs'|t }}</a>
                  {% endif %}
                  {% if links.orders is defined and links.orders %}
                    <a class="mel-vendor-events-v2__link" href="{{ links.orders }}">{{ 'Orders'|t }}</a>
                  {% endif %}
                  {% if links.attendees is defined and links.attendees %}
                    <a class="mel-vendor-events-v2__link" href="{{ links.attendees }}">{{ 'Attendees'|t }}</a>
                  {% endif %}
                  {% if links.analytics is defined and links.analytics %}
                    <a class="mel-vendor-events-v2__link" href="{{ links.analytics }}">{{ 'Analytics'|t }}</a>
                  {% endif %}
                </div>
                {% set removal = ev.removal|default(null) %}
                {% if removal %}
                  <div class="mel-vendor-events-v2__removal">
                    <button type="button" class="mel-btn mel-event-card-remove-open mel-vendor-events-v2__action-secondary" data-mel-open-dialog="{{ removal.dialog_id|e('html_attr') }}" aria-haspopup="dialog">
                      {{ removal.danger_label|default('Archive'|t) }}
                    </button>
                    {% include '@myeventlane_vendor_theme/components/mel-event-card-removal-dialog.html.twig' with { removal: removal } only %}
                  </div>
                {% endif %}
              </div>
            </details>
          </div>
        </article>
      {% endfor %}
    </div>
  {% elseif empty_state.title %}
    <div class="mel-vendor-events-v2__empty mel-vendor-events-v2__surface">
      <h2 class="mel-vendor-events-v2__empty-title">{{ empty_state.title }}</h2>
      {% if empty_state.message %}
        <p class="mel-vendor-events-v2__empty-message">{{ empty_state.message }}</p>
      {% endif %}
      {% if empty_state.url and empty_state.action_label %}
        <a class="mel-btn mel-btn--primary" href="{{ empty_state.url }}">{{ empty_state.action_label }}</a>
      {% endif %}
    </div>
  {% endif %}
</div>
