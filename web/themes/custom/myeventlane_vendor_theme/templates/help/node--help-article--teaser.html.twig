{#
/**
 * @file
 * Compact teaser for help articles (vendor + shared listings).
 */
#}
<article{{ attributes.addClass('node', 'node--type-help-article', 'node--view-mode-teaser', 'mel-help-teaser') }}>
  {{ title_prefix }}
  <h3 class="mel-help-teaser__title">
    <a href="{{ url }}" rel="bookmark">{{ label }}</a>
  </h3>
  {{ title_suffix }}

  {% if content.field_help_summary %}
    <div class="mel-help-teaser__summary">
      {{ content.field_help_summary }}
    </div>
  {% endif %}

  <div class="mel-help-teaser__body">
    {{ content|without('links', 'field_help_summary') }}
  </div>

  <p class="mel-help-teaser__actions">
    <a href="{{ url }}" class="mel-help-teaser__more">{{ 'Read more'|t }}<span class="visually-hidden"> — {{ label }}</span></a>
  </p>
</article>
