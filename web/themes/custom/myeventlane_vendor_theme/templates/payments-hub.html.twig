{#
/**
 * @file
 * Organiser Payments Hub — Trust Centre.
 *
 * Variables:
 *   - hub: view model from VendorPaymentsHubBuilder
 */
#}
{% set health = hub.health|default({}) %}
{% set earnings = hub.earnings|default({}) %}
{% set payouts = hub.payouts|default({}) %}
{% set refunds = hub.refunds|default({}) %}
{% set tax = hub.tax|default({}) %}
{% set billing = hub.billing|default({}) %}
{% set support = hub.support|default({}) %}

<div class="mel-payments-hub" data-mel-payments-hub data-mel-analytics-event="payments_hub_opened" data-mel-payment-health="{{ health.state|default('unknown') }}">

  {# ── Payment health (trust card) ── #}
  <section class="mel-payments-hub__health mel-card mel-card--status mel-payments-hub__health--{{ health.tone|default('muted') }}" id="payment-health" aria-labelledby="mel-payments-health-heading">
    <div class="mel-payments-hub__health-header">
      <p class="mel-payments-hub__eyebrow">{{ 'Payment health'|t }}</p>
      <h2 id="mel-payments-health-heading" class="mel-payments-hub__health-title">{{ health.headline }}</h2>
      <p class="mel-payments-hub__health-summary">{{ health.summary }}</p>
    </div>
    <dl class="mel-payments-hub__facts">
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Status'|t }}</dt>
        <dd>{{ health.verification_status }}</dd>
      </div>
      {% if health.needs_attention %}
        <div class="mel-payments-hub__fact">
          <dt>{{ 'What’s happening'|t }}</dt>
          <dd>{{ health.why }}</dd>
        </div>
        <div class="mel-payments-hub__fact">
          <dt>{{ 'Impact'|t }}</dt>
          <dd>{{ health.impact }}</dd>
        </div>
        <div class="mel-payments-hub__fact">
          <dt>{{ 'Next step'|t }}</dt>
          <dd>{{ health.next_step }}</dd>
        </div>
      {% endif %}
    </dl>
    <div class="mel-payments-hub__actions">
      {% if health.cta_url %}
        <a class="mel-button mel-button--primary" href="{{ health.cta_url }}" {% if health.needs_attention %}data-mel-analytics-event="stripe_attention_viewed"{% endif %}>{{ health.cta_label }}</a>
      {% endif %}
      {% if health.secondary_cta_url %}
        <a class="mel-button mel-button--secondary" href="{{ health.secondary_cta_url }}" rel="noopener noreferrer" target="_blank">{{ health.secondary_cta_label }}</a>
      {% endif %}
    </div>
  </section>

  {# ── Overview earnings ── #}
  <section class="mel-payments-hub__overview" id="overview" aria-labelledby="mel-payments-overview-heading">
    <h2 id="mel-payments-overview-heading" class="mel-payments-hub__section-title">{{ 'Overview'|t }}</h2>
    <div class="mel-payments-hub__kpi-row" role="list">
      <div class="mel-payments-hub__kpi" role="listitem">
        <span class="mel-payments-hub__kpi-label">{{ 'Available'|t }}</span>
        <span class="mel-payments-hub__kpi-value" aria-label="{{ 'Available balance'|t }} {{ earnings.available }}">{{ earnings.available }}</span>
      </div>
      <div class="mel-payments-hub__kpi" role="listitem">
        <span class="mel-payments-hub__kpi-label">{{ 'Pending'|t }}</span>
        <span class="mel-payments-hub__kpi-value" aria-label="{{ 'Pending balance'|t }} {{ earnings.pending }}">{{ earnings.pending }}</span>
      </div>
      <div class="mel-payments-hub__kpi" role="listitem">
        <span class="mel-payments-hub__kpi-label">{{ 'Net earnings'|t }}</span>
        <span class="mel-payments-hub__kpi-value" aria-label="{{ 'Net earnings'|t }} {{ earnings.net }}">{{ earnings.net }}</span>
      </div>
    </div>
  </section>

  {# ── Stripe connection ── #}
  <section class="mel-card mel-payments-hub__section" id="stripe-connection" aria-labelledby="mel-payments-stripe-heading">
    <h2 id="mel-payments-stripe-heading" class="mel-card__title">{{ 'Stripe connection'|t }}</h2>
    <dl class="mel-payments-hub__facts mel-payments-hub__facts--grid">
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Connection'|t }}</dt>
        <dd>{{ health.connected ? 'Connected'|t : 'Not connected'|t }}</dd>
      </div>
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Last updated'|t }}</dt>
        <dd>{{ health.last_verified_label|default('—'|t) }}</dd>
      </div>
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Account'|t }}</dt>
        <dd>{{ health.account_label|default('—'|t) }}</dd>
      </div>
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Charges'|t }}</dt>
        <dd>{{ health.charges_enabled ? 'Enabled'|t : 'Not enabled'|t }}</dd>
      </div>
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Payouts'|t }}</dt>
        <dd>{{ health.payouts_enabled ? 'Enabled'|t : 'Not enabled'|t }}</dd>
      </div>
      <div class="mel-payments-hub__fact">
        <dt>{{ 'Verification'|t }}</dt>
        <dd>{{ health.verification_status }}</dd>
      </div>
    </dl>
    {% if health.needs_attention %}
      <div class="mel-payments-hub__callout" role="status">
        <p><strong>{{ 'Why'|t }}:</strong> {{ health.why }}</p>
        <p><strong>{{ 'Impact'|t }}:</strong> {{ health.impact }}</p>
        <p><strong>{{ 'Next step'|t }}:</strong> {{ health.next_step }}</p>
        {% if health.cta_url %}
          <a class="mel-button mel-button--primary" href="{{ health.cta_url }}">{{ health.cta_label }}</a>
        {% endif %}
      </div>
    {% endif %}
  </section>

  {# ── Payouts ── #}
  <section class="mel-card mel-payments-hub__section" id="payouts" aria-labelledby="mel-payments-payouts-heading" data-mel-analytics-event="payout_viewed">
    <div class="mel-card__header mel-payments-hub__section-header">
      <h2 id="mel-payments-payouts-heading" class="mel-card__title">{{ 'Payouts'|t }}</h2>
      {% if payouts.history_url %}
        <a class="mel-payments-hub__link" href="{{ payouts.history_url }}">{{ 'View history'|t }}</a>
      {% endif %}
    </div>
    {% if payouts.empty %}
      <div class="mel-empty-state" role="status">
        <p class="mel-empty-state__title">{{ payouts.empty_title }}</p>
        <p class="mel-empty-state__body">{{ payouts.empty_body }}</p>
      </div>
    {% else %}
      <dl class="mel-payments-hub__facts mel-payments-hub__facts--grid">
        <div class="mel-payments-hub__fact">
          <dt>{{ 'Available balance'|t }}</dt>
          <dd>{{ payouts.available }}</dd>
        </div>
        <div class="mel-payments-hub__fact">
          <dt>{{ 'Pending balance'|t }}</dt>
          <dd>{{ payouts.pending }}</dd>
        </div>
        <div class="mel-payments-hub__fact">
          <dt>{{ 'Last payout'|t }}</dt>
          <dd>
            {% if payouts.last %}
              {{ payouts.last.amount }} · {{ payouts.last.date_label }} · {{ payouts.last.status }}
            {% else %}
              {{ '—'|t }}
            {% endif %}
          </dd>
        </div>
        <div class="mel-payments-hub__fact">
          <dt>{{ 'Next expected payout'|t }}</dt>
          <dd>{{ payouts.next_expected }}</dd>
        </div>
      </dl>
    {% endif %}
  </section>

  {# ── Refunds ── #}
  <section class="mel-card mel-payments-hub__section" id="refunds" aria-labelledby="mel-payments-refunds-heading">
    <div class="mel-card__header mel-payments-hub__section-header">
      <h2 id="mel-payments-refunds-heading" class="mel-card__title">{{ 'Refunds'|t }}</h2>
      {% if refunds.hub_url %}
        <a class="mel-payments-hub__link" href="{{ refunds.hub_url }}">{{ refunds.cta_label }}</a>
      {% endif %}
    </div>
    {% if refunds.empty %}
      <p class="mel-payments-hub__muted" role="status">{{ refunds.empty_body }}</p>
    {% else %}
      <div class="mel-payments-hub__kpi-row mel-payments-hub__kpi-row--compact" role="list">
        <div class="mel-payments-hub__kpi" role="listitem">
          <span class="mel-payments-hub__kpi-label">{{ 'Pending'|t }}</span>
          <span class="mel-payments-hub__kpi-value">{{ refunds.pending }}</span>
        </div>
        <div class="mel-payments-hub__kpi" role="listitem">
          <span class="mel-payments-hub__kpi-label">{{ 'Completed'|t }}</span>
          <span class="mel-payments-hub__kpi-value">{{ refunds.completed }}</span>
        </div>
        <div class="mel-payments-hub__kpi" role="listitem">
          <span class="mel-payments-hub__kpi-label">{{ 'Declined'|t }}</span>
          <span class="mel-payments-hub__kpi-value">{{ refunds.declined }}</span>
        </div>
      </div>
    {% endif %}
  </section>

  {# ── Tax ── #}
  {% if tax.available %}
    <section class="mel-card mel-payments-hub__section" id="tax" aria-labelledby="mel-payments-tax-heading">
      <h2 id="mel-payments-tax-heading" class="mel-card__title">{{ tax.title }}</h2>
      <p class="mel-payments-hub__muted">{{ tax.body }}</p>
      {% if tax.cta_url %}
        <a class="mel-button mel-button--secondary" href="{{ tax.cta_url }}">{{ tax.cta_label }}</a>
      {% endif %}
    </section>
  {% endif %}

  {# ── Billing ── #}
  {% if billing.available %}
    <section class="mel-card mel-payments-hub__section" id="billing" aria-labelledby="mel-payments-billing-heading">
      <h2 id="mel-payments-billing-heading" class="mel-card__title">{{ billing.title }}</h2>
      <p class="mel-payments-hub__muted">{{ billing.body }}</p>
      {% if billing.cta_url %}
        <a class="mel-button mel-button--secondary" href="{{ billing.cta_url }}">{{ billing.cta_label }}</a>
      {% endif %}
    </section>
  {% endif %}

  {# ── Support ── #}
  <section class="mel-card mel-payments-hub__section" id="support" aria-labelledby="mel-payments-support-heading">
    <h2 id="mel-payments-support-heading" class="mel-card__title">{{ support.title }}</h2>
    <p class="mel-payments-hub__muted">{{ support.body }}</p>
    <div class="mel-payments-hub__actions">
      {% if support.cta_url %}
        <a class="mel-button mel-button--secondary" href="{{ support.cta_url }}">{{ support.cta_label }}</a>
      {% endif %}
      {% if support.help_url %}
        <a class="mel-payments-hub__link" href="{{ support.help_url }}">{{ support.help_label }}</a>
      {% endif %}
    </div>
  </section>

</div>
