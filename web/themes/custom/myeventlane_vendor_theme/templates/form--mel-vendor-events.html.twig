{#
/**
 * @file
 * Single organiser event index with optional bulk publication controls.
 */
#}
<form{{ attributes.addClass('mel-vendor-events-form') }}>
  {{ element.form_build_id }}
  {{ element.form_token }}
  {{ element.form_id }}
  {% include '@myeventlane_vendor_theme/myeventlane-vendor-events-grid.html.twig' with {
    vendor_event_index_model: vendor_event_index_model,
    bulk_selection: element.events,
    bulk_actions: element.bulk_actions|default(null),
  } only %}
</form>
