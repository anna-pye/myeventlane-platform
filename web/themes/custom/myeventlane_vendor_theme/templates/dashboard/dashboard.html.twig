{% set create_event_url = path('myeventlane_event.wizard.create') %}
{% if quick_actions is iterable and quick_actions|length > 0 and quick_actions.0.url is defined %}
  {% set create_event_url = quick_actions.0.url %}
{% endif %}

<section class="mel-dashboard-page">
  {% if onboarding_panel is defined and onboarding_panel %}
    <div class="mel-dashboard-page__onboarding">{{ onboarding_panel }}</div>
  {% endif %}

  <header class="mel-dashboard-hero">
    <div class="mel-dashboard-hero__copy">
      <h2 class="mel-dashboard-hero__title">
        {{ 'Welcome back'|t }}{% if account.display_name is defined and account.display_name %}, {{ account.display_name }}{% endif %}
      </h2>
      <p class="mel-dashboard-hero__subtitle">{{ 'Track what matters today and take your next best action in one place.'|t }}</p>
      {% if launch_pro_status is defined and launch_pro_status %}
        {{ launch_pro_status }}
      {% elseif is_pro %}
        <div class="mel-pro-badge active">
          PRO PLAN ✓ Active
          <a href="{{ path('myeventlane_pro.manage') }}">{{ 'Manage'|t }}</a>
        </div>
      {% else %}
        <div class="mel-pro-badge upgrade">
          FREE PLAN
          {% if pro_upgrade_url %}
            <a href="{{ pro_upgrade_url }}">{{ 'Upgrade to Pro'|t }}</a>
          {% else %}
            <a href="{{ path('myeventlane_pro.overview') }}">{{ 'Upgrade to Pro'|t }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="mel-dashboard-hero__actions">
      <a class="mel-btn mel-btn--primary" href="{{ create_event_url }}">{{ 'Create Event'|t }}</a>
      {% if is_pro %}
        <a class="mel-btn mel-btn--secondary" href="{{ path('myeventlane_pro.manage') }}">{{ 'Manage Pro Subscription'|t }}</a>
      {% else %}
        {% if pro_upgrade_url %}
          <a class="mel-btn mel-btn--secondary" href="{{ pro_upgrade_url }}">{{ 'Upgrade to Pro'|t }}</a>
        {% else %}
          <a class="mel-btn mel-btn--secondary" href="{{ path('myeventlane_pro.overview') }}">{{ 'Upgrade to Pro'|t }}</a>
        {% endif %}
      {% endif %}
    </div>
  </header>

  {% if show_welcome %}
    {% include '@myeventlane_vendor_theme/components/empty-state.html.twig' with {
      title: 'Create your first event'|t,
      message: 'Once your event is published, tickets, RSVPs, and revenue insights will appear here automatically.'|t,
      cta_label: 'Create your first event'|t,
      cta_url: create_event_url
    } only %}
  {% endif %}

  <div class="mel-dashboard-layout">
    <div class="mel-dashboard-layout__main">
      {% if mel_contribution_billing_strip is defined and mel_contribution_billing_strip %}
        {{ mel_contribution_billing_strip }}
      {% endif %}

      <section class="mel-dashboard-section" aria-labelledby="performance-title">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Performance'|t,
          subtitle: 'A quick snapshot of your current business health.'|t
        } only %}
        <div class="mel-kpi-grid">
          {% for kpi in dashboard_kpis|default([]) %}
            {% include '@myeventlane_vendor_theme/components/kpi-card.html.twig' with {
              label: kpi.label,
              value: kpi.value,
              currency: kpi.currency|default(''),
              icon: kpi.icon|default('dashboard'),
              color: kpi.color|default('blue'),
              delta: null
            } only %}
          {% endfor %}
        </div>
      </section>

      {% if growth_cards is defined and growth_cards|length > 0 %}
        <section class="mel-dashboard-section" aria-labelledby="mel-growth-title">
          {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
            title: 'Growth suggestions'|t,
            subtitle: 'Timely, relevant steps to help you optimise outcomes.'|t
          } only %}
          <div class="mel-growth-stack" role="list">
            {% for card in growth_cards %}
              <article class="mel-growth-card {{ card.card_class|default('') }}" role="listitem" data-insight-key="{{ card.key }}"{% if card.event_id is defined and card.event_id %} data-event-id="{{ card.event_id }}"{% endif %}>
                <div class="mel-growth-card__body">
                  <h3 class="mel-growth-card__title">{{ card.title }}</h3>
                  <p class="mel-growth-card__message">{{ card.message }}</p>
                  <div class="mel-growth-card__actions">
                    {% if card.cta_track_url %}
                      <a href="{{ card.cta_track_url }}" class="mel-btn mel-btn--secondary">{{ 'View'|t }}</a>
                    {% elseif card.cta_route %}
                      <a href="{{ path(card.cta_route, card.cta_params|default({})) }}" class="mel-btn mel-btn--secondary">{{ 'View'|t }}</a>
                    {% endif %}
                  </div>
                </div>
                {% if card.dismissible %}
                  <button type="button" class="mel-growth-card__dismiss" data-mel-growth-dismiss aria-label="{{ 'Dismiss suggestion'|t }}">{{ 'Dismiss'|t }}</button>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <section class="mel-dashboard-section">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Priority actions'|t,
          subtitle: 'Stay on top of setup, growth, and operations.'|t
        } only %}
        <div class="mel-dashboard-action-grid">
          {% for card in dashboard_action_cards|default([]) %}
            {% if card.url %}
              <a href="{{ card.url }}" class="mel-panel-card mel-action-card">
                <h3 class="mel-action-card__title">{{ card.title }}</h3>
                <p class="mel-action-card__description">{{ card.description }}</p>
              </a>
            {% else %}
              <div class="mel-panel-card mel-action-card mel-action-card--disabled" aria-disabled="true">
                <h3 class="mel-action-card__title">{{ card.title }}</h3>
                <p class="mel-action-card__description">{{ card.description }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>

      <section class="mel-dashboard-section">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Recent activity'|t
        } only %}
        <div class="mel-panel-card">
          {% if dashboard_activity_items|default([]) %}
            <ul class="mel-activity-list" role="list">
              {% for item in dashboard_activity_items %}
                <li class="mel-activity-list__item">
                  {% include '@myeventlane_vendor_theme/components/status-badge.html.twig' with {
                    status: item.type|default('info'),
                    label: (item.type|default('info')|capitalize)
                  } only %}
                  <span class="mel-activity-list__text">{{ item.message }}</span>
                  {% if item.url %}
                    <a href="{{ item.url }}" class="mel-link">{{ 'Open'|t }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% else %}
            {% include '@myeventlane_vendor_theme/components/empty-state.html.twig' with {
              title: 'No recent activity yet'|t,
              message: 'New check-ins, updates, and reminders will appear here.'|t
            } only %}
          {% endif %}
        </div>
      </section>

      <section class="mel-dashboard-section" aria-labelledby="your-events-title">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Your events'|t,
          subtitle: 'Event performance and next steps.'|t
        } only %}
        <div class="mel-panel-card">
          {% if dashboard_event_performance|default([]) %}
            <ul class="mel-performance-list" role="list">
              {% for event in dashboard_event_performance %}
                <li class="mel-performance-list__item">
                  {% if event.is_ended and (event.attendees_url or event.duplicate_url) %}
                    <div class="mel-post-event mel-post-event--card">
                      <h3 class="mel-post-event__title">{{ 'Your event has ended'|t }}</h3>
                      <div class="mel-post-event__actions">
                        {% if event.attendees_url %}
                          <a href="{{ event.attendees_url }}" class="mel-link">{{ 'View attendees'|t }}</a>
                        {% endif %}
                        {% if event.duplicate_url %}
                          <a href="{{ event.duplicate_url }}" class="mel-link">{{ 'Run this event again'|t }}</a>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                  <div class="mel-performance-list__meta">
                    <h3 class="mel-performance-list__title">{{ event.title }}</h3>
                    <p class="mel-performance-list__sub">{{ event.date|default('Date not set'|t) }}{% if event.venue %} - {{ event.venue }}{% endif %}</p>
                  </div>
                  <div class="mel-analytics-card">
                    <div class="mel-analytics-stat">
                      <strong>{{ event.tickets_sold|default(0) }}</strong>
                      <span>{{ 'Tickets sold'|t }}</span>
                    </div>
                    {% if event.percent_sold is defined and event.percent_sold is not none %}
                      <div class="mel-analytics-bar">
                        <div class="mel-analytics-bar__fill" style="width: {{ event.percent_sold }}%"></div>
                      </div>
                    {% endif %}
                    {% if event.insights is defined and event.insights|length > 0 %}
                      <div class="mel-insights">
                        {% for insight in event.insights %}
                          <div class="mel-insight mel-insight--{{ insight.type }}">
                            {{ insight.message }}
                            {% if insight.cta is defined and insight.cta %}
                              <a href="{{ insight.cta }}" class="mel-insight-cta">{{ 'Boost event'|t }}</a>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                  <div class="mel-performance-list__metrics">
                    <span>{{ 'Tickets'|t }}: {{ event.tickets_sold|default(0) }}</span>
                    <span>{{ 'RSVPs'|t }}: {{ event.rsvps|default(0) }}</span>
                    <span>{{ 'Revenue'|t }}: {{ event.revenue_formatted|default('$0') }}</span>
                  </div>
                  {% if event.event_health is defined %}
                    <div class="mel-performance-list__metrics">
                      <span>{{ 'Tickets sold progress'|t }}: {{ event.event_health.tickets_progress_pct|default(0)|number_format(1) }}%</span>
                      <span>{{ 'RSVP count'|t }}: {{ event.event_health.rsvp_count|default(0) }}</span>
                      <span>{{ 'Page views'|t }}: {{ event.event_health.page_views|default(0) }}</span>
                      <span>{{ 'Conversion rate'|t }}: {{ event.event_health.conversion_rate_pct|default(0)|number_format(1) }}%</span>
                    </div>
                  {% endif %}
                  <div class="mel-performance-list__actions">
                    {% include '@myeventlane_vendor_theme/components/status-badge.html.twig' with {
                      status: event.status_badge|default('neutral'),
                      label: event.status_badge_label|default('Active'|t)
                    } only %}
                    {% if event.manage_url %}
                      <a href="{{ event.manage_url }}" class="mel-link">{{ 'Open workspace'|t }}</a>
                    {% endif %}
                  </div>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            {% include '@myeventlane_vendor_theme/components/empty-state.html.twig' with {
              title: 'No events yet'|t,
              message: 'Create your first event to start tracking performance and growing your audience.'|t,
              cta_label: 'Create your first event'|t,
              cta_url: create_event_url
            } only %}
          {% endif %}
        </div>
      </section>
    </div>

    <aside class="mel-dashboard-layout__rail">
      <section class="mel-panel-card mel-dashboard-rail-widget">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Alerts and next steps'|t
        } only %}
        {% if dashboard_automations|default([]) %}
          <div class="mel-automation-stack">
            {% for card in dashboard_automations %}
              <div class="mel-automation-card mel-automation-card--{{ card.severity|default('info') }}" role="article">
                <h4 class="mel-automation-card__title">{{ card.title }}</h4>
                <p class="mel-automation-card__meta">{{ card.message }}</p>
                <div class="mel-automation-card__actions">
                  {% if card.cta_url and not card.pro_locked %}
                    <a href="{{ card.cta_url }}" class="mel-link">{{ card.cta_label|default('View'|t) }}</a>
                  {% elseif card.pro_upsell %}
                    <span class="mel-automation-card__pro-upsell">{{ card.pro_upsell }}</span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
        {% if dashboard_alerts|default([]) %}
          <div class="mel-dashboard-alert-stack">
            {% for alert in dashboard_alerts %}
              {% include '@myeventlane_vendor_theme/components/alert-box.html.twig' with {
                type: alert.type|default('info'),
                title: alert.title,
                message: alert.message,
                link_label: alert.link_label|default(''),
                link_url: alert.url|default('')
              } only %}
            {% endfor %}
          </div>
        {% else %}
          {% include '@myeventlane_vendor_theme/components/empty-state.html.twig' with {
            title: 'All caught up'|t,
            message: 'No urgent items right now. Keep building momentum.'|t
          } only %}
        {% endif %}
      </section>

      <section class="mel-panel-card mel-dashboard-rail-widget" aria-labelledby="audience-title">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Audience'|t,
          subtitle: 'Your people across events.'|t
        } only %}
        {% if audience_summary is defined and audience_summary %}
          <div class="mel-audience-summary mel-audience-summary--compact">
            <div class="mel-audience-summary__stat">
              <span class="mel-audience-summary__value">{{ audience_summary.total_attendees|default(0) }}</span>
              <span class="mel-audience-summary__label">{{ 'attendees'|t }}</span>
            </div>
            <div class="mel-audience-summary__stat">
              <span class="mel-audience-summary__value">{{ audience_summary.repeat_attendees|default(0) }}</span>
              <span class="mel-audience-summary__label">{{ 'returning'|t }}</span>
            </div>
          </div>
          <a href="{{ path('myeventlane_vendor.console.audience') }}" class="mel-link mel-link--block">{{ 'View audience'|t }}</a>
        {% else %}
          <p class="mel-text--muted">{{ 'Attendees will appear here after your events.'|t }}</p>
          <a href="{{ path('myeventlane_vendor.console.audience') }}" class="mel-link">{{ 'View audience'|t }}</a>
        {% endif %}
      </section>

      <section class="mel-panel-card mel-dashboard-rail-widget">
        {% include '@myeventlane_vendor_theme/components/section-heading.html.twig' with {
          title: 'Payout status'|t
        } only %}
        {% include '@myeventlane_vendor_theme/components/stripe-panel.html.twig' with {
          stripe: stripe|default({
            connected: false,
            status: 'not_connected',
            status_label: 'Not connected',
            connect_url: '/vendor/stripe/connect'
          })
        } only %}
      </section>
    </aside>
  </div>
</section>
