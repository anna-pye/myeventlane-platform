{#
/**
 * @file
 * Organiser portfolio dashboard.
 *
 * Portfolio hierarchy: Identity → Guidance → Work → Outcome.
 * Event editing remains in each event's dedicated Event Workspace.
 */
#}
{% set model = vendor_dashboard_view_model|default({}) %}
{% set vendor = model.vendor|default({}) %}
{% set account_summary = account|default({}) %}
{% set organiser_display_name = account_summary.display_name|default(vendor.label|default('')) %}
{% set organiser_actions = model.organiser_actions|default([]) %}
{% set priority_action = model.priority_action|default(null) %}
{% set secondary_actions = model.secondary_actions|default([]) %}
{% set events = model.events|default([]) %}
{% set event_portfolio = model.event_portfolio|default({}) %}
{% set portfolio_total = event_portfolio.total|default(events|length) %}
{% set empty_state = model.empty_state|default({}) %}
{% set kpis = model.kpis|default([]) %}
{% set has_outcome = kpis is iterable and kpis|length > 0 %}
{% set pro_membership = pro_status|default({}) %}
{% set create_action = organiser_actions|filter(item => item.key|default('') == 'create')|first|default(null) %}
{% set support_action = organiser_actions|filter(item => item.key|default('') == 'support')|first|default(null) %}
{% set payment_action = quick_actions|default([])|filter(item => item.url|default('') == '/vendor/payments')|first|default(null) %}
{% set create_url = create_action.url|default(empty_state.url|default(null)) %}
{% set events_url = path('myeventlane_vendor.console.events') %}
{% set payments_url = payment_action.url|default(path('myeventlane_vendor.console.payments')) %}
{% set support_url = support_action.url|default(path('myeventlane_help_centre.vendors_index')) %}
{% set stripe_summary = stripe|default({}) %}
{% set overnight_booking_count = dashboard_overnight_booking_count|default(0) %}
{% set upcoming_event_count = upcoming_count|default(0) %}
{% set attention_count = model.action_queue|default([])|length %}
{% set events_empty = portfolio_total == 0 %}
{% set live_events = events|filter(event => event.lifecycle_state|default('') in ['live', 'sold_out']) %}
{% set draft_events = events|filter(event => event.lifecycle_state|default('') == 'draft') %}
{% set dashboard_events = [] %}
{% set dashboard_event_ids = [] %}
{% if live_events|length > 0 %}
  {% set live_event = live_events|first %}
  {% set dashboard_events = dashboard_events|merge([live_event]) %}
  {% set dashboard_event_ids = dashboard_event_ids|merge([live_event.nid|default(0)]) %}
{% endif %}
{% if draft_events|length > 0 %}
  {% set draft_event = draft_events|first %}
  {% if draft_event.nid|default(0) not in dashboard_event_ids %}
    {% set dashboard_events = dashboard_events|merge([draft_event]) %}
    {% set dashboard_event_ids = dashboard_event_ids|merge([draft_event.nid|default(0)]) %}
  {% endif %}
{% endif %}
{% for event in events %}
  {% set event_id = event.nid|default(0) %}
  {% if dashboard_events|length < 2 and event_id and event_id not in dashboard_event_ids %}
    {% set dashboard_events = dashboard_events|merge([event]) %}
    {% set dashboard_event_ids = dashboard_event_ids|merge([event_id]) %}
  {% endif %}
{% endfor %}

<main
  class="mel-vendor-dashboard mel-vendor-portfolio mel-layout--dashboard{% if events_empty %} mel-vendor-portfolio--empty{% endif %}"
  data-mel-vendor-dashboard
  data-mel-dashboard-slice="approved-mockup"
>
  {# Identity — establish whose organiser home this is. #}
  <header class="mel-vendor-portfolio__identity" aria-labelledby="mel-dashboard-title">
    <div class="mel-vendor-portfolio__identity-copy">
      <p class="mel-vendor-portfolio__eyebrow">{{ 'Welcome back'|t }}</p>
      <h1 id="mel-dashboard-title" class="mel-vendor-portfolio__title">
        {% if events_empty %}
          {% if organiser_display_name %}
            {{ 'Welcome, @name'|t({'@name': organiser_display_name}) }}
          {% else %}
            {{ 'Welcome to MyEventLane'|t }}
          {% endif %}
        {% elseif organiser_display_name %}
          {{ "@name's organiser home"|t({'@name': organiser_display_name}) }}
        {% else %}
          {{ 'Your events'|t }}
        {% endif %}
      </h1>
      <p class="mel-vendor-portfolio__intro">
        {% if events_empty %}
          {{ empty_state.message|default('Create your first event and start inviting your community.'|t) }}
        {% else %}
          {{ 'See what needs attention, then choose an event.'|t }}
        {% endif %}
      </p>
      {% if is_pro|default(false) %}
        <div class="mel-vendor-portfolio__pro">
          {% include '@myeventlane_vendor_theme/components/mel-pro-badge.html.twig' with {
            size: 'sm',
            sr_text: 'Your account is a MEL Pro premium organiser account.'|t
          } only %}
          {% if pro_membership.manage_url|default(null) %}
            <div class="mel-vendor-portfolio__pro-summary">
              <span>{{ pro_membership.status_label|default('Active'|t) }}</span>
              {% if pro_membership.renews_label|default(null) %}
                <span>{{ 'Renews @date'|t({'@date': pro_membership.renews_label}) }}</span>
              {% endif %}
              <a href="{{ pro_membership.manage_url }}">{{ 'Manage subscription'|t }}</a>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </header>

  {% if events_empty %}
    {# New organiser — one purposeful next step, without an empty canvas. #}
    <section class="mel-vendor-portfolio__first-event" aria-labelledby="mel-first-event-title">
      <div class="mel-vendor-portfolio__first-event-copy">
        <p class="mel-vendor-portfolio__eyebrow">{{ 'Your next step'|t }}</p>
        <h2 id="mel-first-event-title">{{ empty_state.title|default('Your first event starts here'|t) }}</h2>
        <p>{{ empty_state.message|default('Create your event, add booking details and preview it before publishing.'|t) }}</p>
        <p class="mel-vendor-portfolio__expectation">
          {{ 'Next, MyEventLane will open a dedicated workspace where you can prepare and publish your event.'|t }}
        </p>
      </div>
      {% if create_url %}
        <a class="mel-btn mel-btn--primary" href="{{ create_url }}">
          {{ empty_state.action_label|default('Create event'|t) }}
        </a>
      {% endif %}
    </section>
  {% else %}
    <div class="mel-vendor-portfolio__dashboard-grid">
      <div class="mel-vendor-portfolio__primary">
        {# Guidance — the canonical action queue still owns priority. #}
        <section class="mel-vendor-portfolio__guidance" aria-labelledby="mel-guidance-title">
          {% if priority_action %}
            <article class="mel-vendor-portfolio__priority">
              <div class="mel-vendor-portfolio__priority-copy">
                <p class="mel-vendor-portfolio__eyebrow">{{ 'Next best action'|t }}</p>
                <h2 id="mel-guidance-title">{{ priority_action.title|default('') }}</h2>
                {% if priority_action.message|default('') %}
                  <p>{{ priority_action.message }}</p>
                {% endif %}
              </div>
              {% if priority_action.url and priority_action.action_label|default('') %}
                <a class="mel-btn mel-btn--primary" href="{{ priority_action.url }}">
                  {{ priority_action.action_label }}
                </a>
              {% endif %}
            </article>
          {% else %}
            <div class="mel-vendor-portfolio__all-clear" role="status">
              <p class="mel-vendor-portfolio__eyebrow">{{ 'Next best action'|t }}</p>
              <h2 id="mel-guidance-title">{{ "You're all caught up"|t }}</h2>
              <p>{{ 'Choose an event below when you are ready to continue.'|t }}</p>
            </div>
          {% endif %}

          {% if secondary_actions is iterable and secondary_actions|length > 0 %}
            <details class="mel-vendor-portfolio__secondary-guidance">
              <summary>{{ 'More things to do'|t }}</summary>
              <ul role="list">
                {% for action in secondary_actions %}
                  <li>
                    <div>
                      <strong>{{ action.title|default('') }}</strong>
                      {% if action.message|default('') %}<span>{{ action.message }}</span>{% endif %}
                    </div>
                    {% if action.url and action.action_label|default('') %}
                      <a href="{{ action.url }}">{{ action.action_label }}</a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        </section>

        {# Dashboard summary only; the Events route remains the complete portfolio. #}
        <section class="mel-vendor-portfolio__work" aria-labelledby="mel-portfolio-title">
          <div class="mel-vendor-portfolio__section-heading mel-vendor-portfolio__section-heading--with-link">
            <div>
              <h2 id="mel-portfolio-title">{{ 'Your events'|t }}</h2>
              <p>{{ 'Each event opens in its own workspace.'|t }}</p>
            </div>
            <a href="{{ events_url }}">{{ 'View all events'|t }}</a>
          </div>

          <div class="mel-vendor-portfolio__event-list" role="list">
            {% for event in dashboard_events %}
              {% set links = event.links|default({}) %}
              {% set image = event.image|default({}) %}
              {% set add_on_stock = event.add_on_stock|default(null) %}
              <article class="mel-vendor-portfolio__event-summary" role="listitem">
                <div class="mel-vendor-portfolio__event-identity">
                  {% include '@myeventlane_vendor_theme/components/mel-event-card-thumb.html.twig' with {
                    image: image
                  } only %}
                  <div>
                    <h3>{{ event.title|default('Untitled event'|t) }}</h3>
                    {% if event.date_label|default('') %}
                      <p class="mel-vendor-portfolio__event-date">{{ event.date_label }}</p>
                    {% endif %}
                    <div class="mel-vendor-portfolio__event-signals">
                      {% if event.lifecycle_label|default('') %}
                        <span class="mel-vendor-portfolio__status">{{ event.lifecycle_label }}</span>
                      {% endif %}
                      {% if event.metric_label|default('') %}
                        <span>{{ event.metric_label }}</span>
                      {% elseif event.booking_state_label|default('') %}
                        <span>{{ event.booking_state_label }}</span>
                      {% endif %}
                    </div>
                    {% if add_on_stock and add_on_stock.manage_url|default(null) %}
                      <a
                        class="mel-vendor-portfolio__stock mel-vendor-portfolio__stock--{{ add_on_stock.state|default('healthy') }}"
                        href="{{ add_on_stock.manage_url }}"
                        aria-label="{{ 'Manage add-on stock for @event: @stock'|t({
                          '@event': event.title|default('Untitled event'|t),
                          '@stock': add_on_stock.label|default('')
                        }) }}"
                      >
                        <span class="mel-vendor-portfolio__stock-label">{{ 'Add-on stock'|t }}</span>
                        <strong>{{ add_on_stock.label|default('') }}</strong>
                      </a>
                    {% endif %}
                  </div>
                </div>
                {% if links.manage|default(null) %}
                  <a class="mel-btn mel-btn--secondary mel-vendor-portfolio__open" href="{{ links.manage }}">
                    {{ event.lifecycle_state|default('') == 'draft' ? 'Continue setup'|t : 'Open workspace'|t }}
                    <span class="visually-hidden">: {{ event.title|default('Untitled event'|t) }}</span>
                  </a>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </section>

        {% if has_outcome %}
          <section class="mel-vendor-portfolio__outcome" aria-labelledby="mel-outcome-title">
            <div class="mel-vendor-portfolio__section-heading">
              <div>
                <h2 id="mel-outcome-title">{{ 'Across your events'|t }}</h2>
              </div>
            </div>
            <dl class="mel-vendor-portfolio__metrics">
              {% for kpi in kpis|slice(0, 4) %}
                <div>
                  <dt>{{ kpi.label|default('') }}</dt>
                  <dd>{{ kpi.value|default('0') }}</dd>
                </div>
              {% endfor %}
            </dl>
          </section>
        {% endif %}
      </div>

      <aside class="mel-vendor-portfolio__rail" aria-label="{{ 'Organiser overview'|t }}">
        <section class="mel-vendor-portfolio__rail-card" aria-labelledby="mel-today-title">
          <h2 id="mel-today-title">{{ 'Today'|t }}</h2>
          <dl class="mel-vendor-portfolio__today-list">
            <div><dt>{{ 'Bookings since last night'|t }}</dt><dd>{{ overnight_booking_count }}</dd></div>
            <div><dt>{{ 'Upcoming events'|t }}</dt><dd>{{ upcoming_event_count }}</dd></div>
            <div><dt>{{ 'Items needing attention'|t }}</dt><dd>{{ attention_count }}</dd></div>
          </dl>
        </section>

        <section class="mel-vendor-portfolio__rail-card" aria-labelledby="mel-payments-title">
          <h2 id="mel-payments-title">{{ 'Payments'|t }}</h2>
          <p>{{ stripe_summary.status_message|default('Review payment health, Stripe payouts and refunds.'|t) }}</p>
          <a class="mel-btn mel-btn--secondary" href="{{ payments_url }}">{{ 'Open payments'|t }}</a>
        </section>

        <section class="mel-vendor-portfolio__rail-card" aria-labelledby="mel-support-title">
          <h2 id="mel-support-title">{{ 'Need help?'|t }}</h2>
          <p>{{ 'Get plain-English guidance or contact support.'|t }}</p>
          <a class="mel-btn mel-btn--secondary" href="{{ support_url }}">{{ 'Open support'|t }}</a>
        </section>
      </aside>
    </div>
  {% endif %}
</main>
