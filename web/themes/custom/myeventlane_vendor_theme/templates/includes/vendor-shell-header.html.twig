{#
/**
 * @file
 * VendorShell header region (title, notifications, primary action).
 *
 * Included from layout/page.html.twig — canonical vendor console shell.
 *
 * @var hide_shell_title bool When true (dashboard route), titles are visually
 *   hidden so the dashboard workspace hero owns the page heading.
 */
#}
{% set hide_shell_title = hide_shell_title|default(false) %}
{% set is_dashboard_route = is_dashboard_route|default(false) %}
<header class="mel-shell-header mel-vendor-console__header{% if is_dashboard_route %} mel-shell-header--dashboard{% endif %}" role="banner">
  <div class="mel-shell-header__left">
    <button class="mel-shell-header__menu-btn"
            type="button"
            data-sidebar-toggle
            aria-expanded="false"
            aria-controls="mel-vendor-sidebar"
            aria-label="{{ 'Open navigation menu'|t }}">
      <span aria-hidden="true">☰</span>
    </button>

    {% if page.is_event_studio_workspace|default(false) %}
      <a
        class="mel-shell-header__studio-brand"
        href="{{ page.vendor_shell_brand_url|default(path('myeventlane_vendor.console.dashboard')) }}"
        aria-label="{{ 'Organiser dashboard'|t }}"
      >
        <img
          src="/themes/custom/myeventlane_vendor_theme/images/myeventlane-logo-icon.png"
          alt=""
          width="40"
          height="40"
        >
      </a>
    {% endif %}

    {% if not hide_shell_title %}
      <div class="mel-shell-header__titles">
        <p class="mel-shell-header__title">{{ page.shell_page_title|default('Event Studio'|t) }}</p>
        {% if page.shell_page_subtitle %}
          <p class="mel-shell-header__subtitle">{{ page.shell_page_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="mel-shell-header__actions">
    {% if page.mel_notification_bell %}
      <div class="mel-shell-header__notifications">
        {{ page.mel_notification_bell }}
      </div>
    {% endif %}
    {% if page.shell_primary_action and not hide_shell_title %}
      <a href="{{ page.shell_primary_action.url }}" class="mel-btn mel-btn--primary mel-vendor-console__primary-action">
        {{ page.shell_primary_action.label }}
      </a>
    {% endif %}
  </div>
</header>
