        'event_status_help' => NULL,
        'created_label' => NULL,
        'visibility_label' => NULL,
        'edit_url' => NULL,
        'quick_actions' => [],
        'event_details' => [],
        'is_published' => FALSE,
        'unpublish_link' => NULL,
        'unpublish_action' => NULL,
        'publish_link' => NULL,
        'publish_action' => NULL,
        'delete_link' => NULL,
        'delete_action' => NULL,
        'support_cta' => NULL,
        'show_support_card' => FALSE,
      ],
      'template' => 'event/mel-event-settings-page',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for mel_event_workspace.
 */
function myeventlane_vendor_theme_preprocess_mel_event_workspace(array &$variables): void {
  $event = $variables['event'] ?? NULL;
  if (!$event instanceof NodeInterface) {
    return;
  }

  if (
    ($variables['insights'] ?? NULL) === NULL
    && $event->bundle() === 'event'
    && \Drupal::hasService('myeventlane_event.intelligence')
  ) {
    /** @var \Drupal\myeventlane_event\Service\EventIntelligenceService $intelligence */
    $intelligence = \Drupal::service('myeventlane_event.intelligence');
    $variables['insights'] = $intelligence->getInsights($event);
  }
  elseif (!isset($variables['insights'])) {
    $variables['insights'] = [];
  }

  if (!empty($variables['header_actions']) && empty($variables['actions'])) {
    $variables['actions'] = $variables['header_actions'];
  }

  if (isset($variables['actions']) && is_array($variables['actions'])) {
    foreach ($variables['actions'] as &$action) {
      if (!is_array($action)) {
        continue;
      }
      if (empty($action['class']) && isset($action['style'])) {
        $action['class'] = ($action['style'] === 'primary') ? 'mel-btn--cta' : 'mel-btn--secondary';
      }
    }
    unset($action);
  }

  if (empty($variables['meta'])) {
    $variables['meta'] = _myeventlane_vendor_theme_vendor_console_event_meta_line($event);
  }

  $parts = _myeventlane_vendor_theme_vendor_console_event_meta_parts($event);
  if (empty($variables['event_type_label'])) {
    $variables['event_type_label'] = $parts['type'];
  }
  if (!array_key_exists('event_date_label', $variables)) {
    $variables['event_date_label'] = $parts['date'] !== '' ? $parts['date'] : NULL;
  }

  if (empty($variables['event_status'])) {
    $variables['event_status'] = $event->isPublished() ? t('Published') : t('Draft');
    if ($event->hasField('moderation_state') && !$event->get('moderation_state')->isEmpty()
      && (string) $event->get('moderation_state')->value === 'review') {
      $variables['event_status'] = t('In review');
    }
  }

  if (empty($variables['event_status_badge_modifier'])) {
    $variables['event_status_badge_modifier'] = 'mel-badge--draft';
    if ($event->isPublished()) {
      $variables['event_status_badge_modifier'] = 'mel-badge--live';
    }
    if ($event->hasField('moderation_state') && !$event->get('moderation_state')->isEmpty()
      && (string) $event->get('moderation_state')->value === 'review') {
      $variables['event_status_badge_modifier'] = 'mel-badge--warning';
    }
  }

  // Boost insights payload (optional module): same source as dashboard rows, no vendor→boost hard dependency.
  $variables['workspace_event_boost'] = NULL;
  if ($event->bundle() === 'event' && \Drupal::hasService('myeventlane_boost.performance')) {
    try {
      $boost_performance = \Drupal::service('myeventlane_boost.performance');
      $variables['workspace_event_boost'] = [
        'performance' => $boost_performance->getPerformanceForEvent($event),
      ];
    }
    catch (\Throwable $e) {
      \Drupal::logger('myeventlane_vendor_theme')->warning('Workspace boost performance failed for event @nid: @message', [
        '@nid' => (string) $event->id(),
        '@message' => $e->getMessage(),
      ]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_event_settings_page.
 */
function myeventlane_vendor_theme_preprocess_myeventlane_vendor_event_settings_page(array &$variables): void {
  $event = $variables['event'] ?? NULL;
  if (!$event instanceof NodeInterface) {
    return;
  }

  $eid = (int) $event->id();
  $date_formatter = \Drupal::service('date.formatter');

  $variables['event_title'] = $event->label();
  $variables['edit_url'] = Url::fromRoute('entity.node.edit_form', ['node' => $eid])->toString();
  $variables['public_url'] = Url::fromRoute('entity.node.canonical', ['node' => $eid])->toString();
  $variables['booking_url'] = Url::fromRoute('myeventlane_commerce.event_book', ['node' => $eid])->toString();

  try {
    $variables['boost_url'] = Url::fromRoute('myeventlane_boost.boost_page', ['node' => $eid])->toString();
  }
  catch (\Throwable) {
    $variables['boost_url'] = '/event/' . $eid . '/boost';
  }

  $variables['event_type_label'] = t('RSVP');
  if ($event->hasField('field_event_type') && !$event->get('field_event_type')->isEmpty()) {
    $val = (string) $event->get('field_event_type')->value;
    $variables['event_type_label'] = match ($val) {
      'paid' => t('Ticketed'),
      'both' => t('RSVP + Paid'),
      'external' => t('External'),
      default => t('RSVP'),
    };
  }

  $variables['created_label'] = '';
  if ($event->getCreatedTime()) {
    $variables['created_label'] = $date_formatter->format($event->getCreatedTime(), 'custom', 'j M Y');
  }

  $moderation_state = NULL;
  if ($event->hasField('moderation_state') && !$event->get('moderation_state')->isEmpty()) {
    $moderation_state = (string) $event->get('moderation_state')->value;
  }

  $resolved_state = NULL;
  if (\Drupal::hasService('myeventlane_event_state.resolver')) {
    $resolved_state = \Drupal::service('myeventlane_event_state.resolver')->resolveState($event);
  }

  $is_cancelled = $resolved_state === 'cancelled';
  $variables['is_published'] = $event->isPublished();

  if ($is_cancelled) {
    $variables['event_status_key'] = 'cancelled';
    $variables['event_status_label'] = t('Cancelled');
    $variables['event_status_help'] = t('This event has been cancelled.');
  }
  elseif ($moderation_state === 'archived') {
    $variables['event_status_key'] = 'unpublished';
    $variables['event_status_label'] = t('Unpublished');
    $variables['event_status_help'] = t('This event is hidden from the public right now.');
  }
  elseif ($event->isPublished()) {
    $variables['event_status_key'] = 'published';
    $variables['event_status_label'] = t('Published');
    $variables['event_status_help'] = t('Your event is live and visible to guests.');
  }
  else {
    $variables['event_status_key'] = 'draft';
    $variables['event_status_label'] = t('Draft');
    $variables['event_status_help'] = t('Your event is saved, but guests can\'t see it yet.');
  }

  $variables['visibility_label'] = $event->isPublished()
    ? t('Public page live')
    : t('Not visible to guests');

  $type_segment = (string) $variables['event_type_label'] . ' ' . t('event');
  $header_meta_parts = [
    $type_segment,
    (string) $variables['event_status_label'],
  ];
  if ($variables['created_label'] !== '') {
    $header_meta_parts[] = (string) t('Created @date', ['@date' => $variables['created_label']]);
  }
  $variables['header_meta_line'] = implode(' • ', $header_meta_parts);

  $variables['status_card_header_chips'] = array_values(array_filter([
    (string) $variables['event_type_label'],
    $variables['created_label'] !== ''
      ? (string) t('Created @date', ['@date' => $variables['created_label']])
      : '',
    (string) $variables['visibility_label'],
  ]));

  $variables['quick_actions'] = [
    [
      'title' => t('Edit event details'),
      'description' => t('Update your title, schedule, tickets and content'),
      'url' => $variables['edit_url'],
      'external' => FALSE,
      'icon' => _myeventlane_vendor_theme_event_settings_icon_markup('edit'),
    ],
    [
      'title' => t('View public page'),
      'description' => t('See what guests see before they book'),
      'url' => $variables['public_url'],
      'external' => TRUE,
      'icon' => _myeventlane_vendor_theme_event_settings_icon_markup('eye'),
    ],
    [
      'title' => t('View booking page'),
      'description' => t('Check your RSVP or ticket flow'),
      'url' => $variables['booking_url'],
      'external' => TRUE,
      'icon' => _myeventlane_vendor_theme_event_settings_icon_markup('ticket'),
    ],
    [
      'title' => t('Boost this event'),
      'description' => t('Reach more people and grow attendance'),
      'url' => $variables['boost_url'],
      'external' => FALSE,
      'icon' => _myeventlane_vendor_theme_event_settings_icon_markup('boost'),
    ],
  ];

  $details = [];
  $details[] = [
    'label' => t('Title'),
    'value' => $event->label(),
  ];

  if ($event->hasField('field_event_start') && !$event->get('field_event_start')->isEmpty()) {
    $start_item = $event->get('field_event_start')->first();
    if ($start_item && isset($start_item->date)) {
      $details[] = [
        'label' => t('Date & time'),
        'value' => $date_formatter->format($start_item->date->getTimestamp(), 'custom', 'l, F j, Y \a\t g:ia'),
      ];
    }
  }

  $details[] = [
    'label' => t('Event type'),
    'value' => (string) $variables['event_type_label'],
  ];

  $venue_value = _myeventlane_vendor_theme_event_settings_venue_label($event);
  if ($venue_value !== '') {
    $details[] = [
      'label' => t('Venue / location'),
      'value' => $venue_value,
    ];
  }

  $details[] = [
    'label' => t('Visibility'),
    'value' => (string) $variables['visibility_label'],
  ];

  $variables['event_details'] = $details;

  $unpublish_link = Link::fromTextAndUrl(
    t('Unpublish'),
    Url::fromRoute('myeventlane_vendor.console.event_unpublish', ['event' => $eid])
  )->toRenderable();
  $unpublish_link['#attributes']['class'][] = 'mel-btn';
  $unpublish_link['#attributes']['class'][] = 'mel-btn--sm';
  $unpublish_link['#attributes']['class'][] = 'mel-btn--ghost';
  $unpublish_link['#attributes']['class'][] = 'mel-btn--danger';
  $unpublish_link['#attributes']['class'][] = 'mel-danger-zone__btn';
  $variables['unpublish_link'] = $unpublish_link;
  $variables['unpublish_action'] = $unpublish_link;

  $publish_link = Link::fromTextAndUrl(
    t('Publish'),
    Url::fromRoute('myeventlane_vendor.console.event_publish', ['event' => $eid])
  )->toRenderable();
  $publish_link['#attributes']['class'][] = 'mel-btn';
  $publish_link['#attributes']['class'][] = 'mel-btn--sm';
  $publish_link['#attributes']['class'][] = 'mel-btn--primary';
  $publish_link['#attributes']['class'][] = 'mel-danger-zone__btn';
  $variables['publish_link'] = $publish_link;
  $variables['publish_action'] = $publish_link;

  $delete_link = Link::fromTextAndUrl(
    t('Delete'),
    Url::fromRoute('entity.node.delete_form', ['node' => $eid])
  )->toRenderable();
  $delete_link['#attributes']['class'][] = 'mel-btn';
  $delete_link['#attributes']['class'][] = 'mel-btn--sm';
  $delete_link['#attributes']['class'][] = 'mel-btn--danger';
  $delete_link['#attributes']['class'][] = 'mel-danger-zone__btn';
  $delete_link['#attributes']['class'][] = 'mel-danger-zone__btn--delete';
  $variables['delete_link'] = $delete_link;
  $variables['delete_action'] = $delete_link;

  $support_cta = Link::fromTextAndUrl(
    t('Contribute to MyEventLane'),
    Url::fromRoute('myeventlane_donations.platform')
  )->toRenderable();
  $support_cta['#attributes']['class'][] = 'mel-btn';
  $support_cta['#attributes']['class'][] = 'mel-btn--primary';
  $support_cta['#attributes']['class'][] = 'mel-support-card__cta';
  $variables['support_cta'] = $support_cta;
  $variables['show_support_card'] = TRUE;

  $variables['#cache']['tags'] = $event->getCacheTags();
  $variables['#cache']['contexts'] = $event->getCacheContexts();
}

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_console_page.
 *
 * Adds a consistent meta line (event type • status • date) for event workspace
 * routes when the controller did not pass meta.
 */
function myeventlane_vendor_theme_preprocess_myeventlane_vendor_console_page(array &$variables): void {
  if (!empty($variables['meta'])) {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName();
  $routes_with_meta = [
    'myeventlane_vendor.console.event_overview',
    'myeventlane_vendor.console.event_analytics',
    'myeventlane_vendor.console.event_rsvps',
    'myeventlane_event_attendees.vendor_list',
  ];
  if (!in_array($route_name, $routes_with_meta, TRUE)) {
    return;
  }
  $event = \Drupal::routeMatch()->getParameter('event');
  if (!$event instanceof NodeInterface) {
    $event = \Drupal::routeMatch()->getParameter('node');
  }
  if (!$event instanceof NodeInterface || $event->bundle() !== 'event') {
    return;
  }
  $variables['meta'] = _myeventlane_vendor_theme_vendor_console_event_meta_line($event);
}

/**
 * Returns structured meta parts for vendor event headers (type, status, date, line).
 *
 * @return array{type: string, status: string, date: string, line: string}
 */
function _myeventlane_vendor_theme_vendor_console_event_meta_parts(NodeInterface $event): array {
  $date_formatter = \Drupal::service('date.formatter');

  $type_label = (string) t('RSVP');
  if ($event->hasField('field_event_type') && !$event->get('field_event_type')->isEmpty()) {
    $val = (string) $event->get('field_event_type')->value;
    $type_label = match ($val) {
      'paid' => (string) t('Ticketed'),
      'both' => (string) t('RSVP + Paid'),
      'external' => (string) t('External'),
      default => (string) t('RSVP'),
    };
  }

  $status_label = $event->isPublished() ? (string) t('Published') : (string) t('Draft');
  if ($event->hasField('moderation_state') && !$event->get('moderation_state')->isEmpty()
    && (string) $event->get('moderation_state')->value === 'review') {
    $status_label = (string) t('In review');
  }

  $date_part = '';
  if ($event->hasField('field_event_start') && !$event->get('field_event_start')->isEmpty()) {
    $start_item = $event->get('field_event_start')->first();
    if ($start_item && isset($start_item->date)) {
      $date_part = $date_formatter->format($start_item->date->getTimestamp(), 'custom', 'D, j M Y');
    }
  }
  if ($date_part === '' && $event->getCreatedTime()) {
    $date_part = $date_formatter->format($event->getCreatedTime(), 'custom', 'j M Y');
  }

  $line_parts = [$type_label, $status_label];
  if ($date_part !== '') {
    $line_parts[] = $date_part;
  }

  return [
    'type' => $type_label,
    'status' => $status_label,
    'date' => $date_part,
    'line' => implode(' • ', $line_parts),
  ];
}

/**
 * Builds the console header meta line for an event (type • status • date).
 */
function _myeventlane_vendor_theme_vendor_console_event_meta_line(NodeInterface $event): string {
  return _myeventlane_vendor_theme_vendor_console_event_meta_parts($event)['line'];
}

/**
 * Resolves venue / online label for event settings summary.
 */
function _myeventlane_vendor_theme_event_settings_venue_label(NodeInterface $event): string {
  if ($event->hasField('field_event_venue') && !$event->get('field_event_venue')->isEmpty()) {
    return trim((string) $event->get('field_event_venue')->value);
  }
  if ($event->hasField('field_venue_name') && !$event->get('field_venue_name')->isEmpty()) {
    return trim((string) $event->get('field_venue_name')->value);
  }
  if ($event->hasField('field_venue') && !$event->get('field_venue')->isEmpty()) {
    $venue = $event->get('field_venue')->entity;
    if ($venue && method_exists($venue, 'label')) {
      return $venue->label();
    }
  }
  if ($event->hasField('field_event_type') && !$event->get('field_event_type')->isEmpty()
    && $event->get('field_event_type')->value === 'external') {
    return (string) t('External booking');
  }
  return '';
}

/**
 * Returns inline SVG icon markup for quick actions (no emoji).
 */
function _myeventlane_vendor_theme_event_settings_icon_markup(string $key): string {
  $icons = [
    'edit' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
    'eye' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>',
    'ticket' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7a2 2 0 012-2h12a2 2 0 012 2v2h-2v4h2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2h2v-4H4V7z"/><path d="M9 11h6"/></svg>',
    'boost' => '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"/></svg>',
  ];
  return $icons[$key] ?? $icons['edit'];
}

/**
 * Helper: Get user initials from display name.
 */
function _myeventlane_vendor_theme_get_initials(string $name): string {
  $parts = explode(' ', trim($name));
  $initials = '';
  
  foreach (array_slice($parts, 0, 2) as $part) {
    if (!empty($part)) {
      $initials .= mb_strtoupper(mb_substr($part, 0, 1));
    }
  }
  
  return $initials ?: 'U';
}

/**
 * Helper: Determine active section from route name.
 */
function _myeventlane_vendor_theme_get_active_section(?string $route_name): string {
  if (!$route_name) {
    return 'dashboard';
  }

  // Map route names to sidebar active sections.
  // Routes use myeventlane_vendor.console.* pattern.
  $mapping = [
    // Console routes.
    'myeventlane_vendor.console.dashboard' => 'dashboard',
    'myeventlane_vendor.console.events' => 'events',
    'myeventlane_vendor.console.events_add' => 'events',
    'myeventlane_vendor.console.event_workspace' => 'events',
    'myeventlane_vendor.console.event_overview' => 'events',
    'myeventlane_vendor.console.event_tickets' => 'events',
    'myeventlane_vendor.console.event_publish' => 'events',
    'myeventlane_vendor.console.event_orders' => 'orders',
    'myeventlane_vendor.console.event_order_view' => 'orders',
    'myeventlane_refunds.vendor_refund_requests' => 'refund_requests',
    'myeventlane_refunds.vendor_refund_request_approve' => 'refund_requests',
    'myeventlane_refunds.vendor_refund_request_reject' => 'refund_requests',
    'myeventlane_checkout_flow.vendor_attendees' => 'attendees',
    'myeventlane_event_attendees.vendor_list' => 'attendees',
    'myeventlane_vendor.console.event_rsvps' => 'attendees',
    'myeventlane_vendor.console.payouts' => 'payouts',
    'myeventlane_vendor.console.boost' => 'growth',
    'myeventlane_vendor.console.audience' => 'audience',
    'myeventlane_vendor.console.settings' => 'settings',
    'myeventlane_vendor.console.messaging_brand' => 'settings',
    'myeventlane_notifications.inbox' => 'notifications',
    'myeventlane_notifications.preferences' => 'notifications',
    'myeventlane_help_centre.vendor_help' => 'help',
    'myeventlane_help_centre.home' => 'help',
    'myeventlane_event_studio.create' => 'events',
    'myeventlane_event_studio.edit' => 'events',
    'myeventlane_event.wizard.basics' => 'events',
    'myeventlane_event.wizard.when_where' => 'events',
    'myeventlane_event.wizard.tickets' => 'events',
    'myeventlane_event.wizard.details' => 'events',
    'myeventlane_event.wizard.review' => 'events',
    'myeventlane_event.wizard.publish' => 'events',
    'myeventlane_event.wizard.success' => 'events',
    // Legacy/alternate routes.
    'myeventlane_vendor.dashboard' => 'dashboard',
    'myeventlane_vendor.console.dashboard' => 'dashboard',
  ];

  return $mapping[$route_name] ?? 'dashboard';
}

/**
 * Onboarding-safe shell nav: core destinations only; each requires route access.
 *
 * @return array<int, array<string, mixed>>
 *   Sidebar items for vendor shell.
 */
function _myeventlane_vendor_theme_build_onboarding_shell_nav_items(string $active_section, ?string $route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match): array {
  $wizard_children = _myeventlane_vendor_theme_build_event_wizard_submenu($route_name, $route_match);
  $candidates = [
    [
      'key' => 'dashboard',
      'label' => t('Dashboard'),
      'icon' => 'dashboard',
      'route' => 'myeventlane_vendor.console.dashboard',
    ],
    [
      'key' => 'events',
      'label' => t('Events'),
      'icon' => 'events',
      'route' => 'myeventlane_vendor.console.events',
      'children' => $wizard_children,
    ],
    [
      'key' => 'payouts',
      'label' => t('Payouts'),
      'icon' => 'payouts',
      'route' => 'myeventlane_vendor.console.payouts',
    ],
    [
      'key' => 'settings',
      'label' => t('Settings'),
      'icon' => 'settings',
      'route' => 'myeventlane_vendor.console.settings',
    ],
    [
      'key' => 'help',
      'label' => t('Help'),
      'icon' => 'help',
      'route' => 'myeventlane_help_centre.home',
      'path_fallback' => '/help',
    ],
  ];
  $built = [];
  foreach ($candidates as $item) {
    $route = (string) $item['route'];
    if (!_myeventlane_vendor_theme_named_route_accessible($route, [])) {
      continue;
    }
    $url = _myeventlane_vendor_theme_safe_route_url($route);
    if ($url === NULL && !empty($item['path_fallback'])) {
      $url = (string) $item['path_fallback'];
    }
    if ($url === NULL) {
      continue;
    }
    $item['url'] = $url;
    $item['is_disabled'] = FALSE;
    $item['is_active'] = ($active_section === $item['key']);
    $built[] = $item;
  }
  return $built;
}

/**
 * Full vendor console shell nav; omits items the account cannot access.
 *
 * @return array<int, array<string, mixed>>
 *   Sidebar items for vendor shell.
 */
function _myeventlane_vendor_theme_build_full_vendor_shell_nav_items(string $active_section, ?string $route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match): array {
  $wizard_children = _myeventlane_vendor_theme_build_event_wizard_submenu($route_name, $route_match);
  $items = [
    [
      'key' => 'dashboard',
      'label' => t('Dashboard'),
      'icon' => 'dashboard',
      'route' => 'myeventlane_vendor.console.dashboard',
    ],
    [
      'key' => 'notifications',
      'label' => t('Notifications'),
      'icon' => 'notifications',
      'route' => 'myeventlane_notifications.inbox',
    ],
    [
      'key' => 'events',
      'label' => t('Events'),
      'icon' => 'events',
      'route' => 'myeventlane_vendor.console.events',
      'children' => $wizard_children,
    ],
    [
      'key' => 'orders',
      'label' => t('Orders'),
      'icon' => 'orders',
      'route' => NULL,
    ],
    [
      'key' => 'refund_requests',
      'label' => t('Refund requests'),
      'icon' => 'refunds',
      'route' => NULL,
    ],
    [
      'key' => 'attendees',
      'label' => t('Attendees'),
      'icon' => 'attendees',
      'route' => 'myeventlane_checkout_flow.vendor_attendees',
    ],
    [
      'key' => 'audience',
      'label' => t('Audience'),
      'icon' => 'audience',
      'route' => 'myeventlane_vendor.console.audience',
    ],
    [
      'key' => 'payouts',
      'label' => t('Payouts'),
      'icon' => 'payouts',
      'route' => 'myeventlane_vendor.console.payouts',
    ],
    [
      'key' => 'growth',
      'label' => t('Growth'),
      'icon' => 'growth',
      'route' => 'myeventlane_vendor.console.boost',
    ],
    [
      'key' => 'settings',
      'label' => t('Settings'),
      'icon' => 'settings',
      'route' => 'myeventlane_vendor.console.settings',
    ],
    [
      'key' => 'help',
      'label' => t('Help'),
      'icon' => 'help',
      'route' => 'myeventlane_help_centre.home',
      'path_fallback' => '/help',
    ],
  ];

  $built = [];
  foreach ($items as $item) {
    if ($item['key'] === 'refund_requests') {
      if (!\Drupal::moduleHandler()->moduleExists('myeventlane_refunds')) {
        continue;
      }
      if (!\Drupal::currentUser()->hasPermission('manage_refunds')) {
        continue;
      }
      $event_id = _myeventlane_vendor_theme_resolve_event_id($route_match);
      if ($event_id === NULL) {
        continue;
      }
      if (!_myeventlane_vendor_theme_named_route_accessible('myeventlane_refunds.vendor_refund_requests', ['node' => $event_id])) {
        continue;
      }
      $url = _myeventlane_vendor_theme_safe_route_url('myeventlane_refunds.vendor_refund_requests', ['node' => $event_id]);
      if ($url === NULL) {
        continue;
      }
      $item['url'] = $url;
      $item['is_disabled'] = FALSE;
      $item['is_active'] = ($active_section === $item['key']);
      $built[] = $item;
      continue;
    }

    if ($item['key'] === 'orders') {
      $item['url'] = NULL;
      $item['is_disabled'] = TRUE;
      $item['is_active'] = ($active_section === $item['key']);
      $built[] = $item;
      continue;
    }

    if (!empty($item['route'])) {
      if (!_myeventlane_vendor_theme_named_route_accessible((string) $item['route'], [])) {
        continue;
      }
      $url = _myeventlane_vendor_theme_safe_route_url((string) $item['route']);
      if ($url === NULL && !empty($item['path_fallback'])) {
        $url = (string) $item['path_fallback'];
      }
      $is_disabled = $url === NULL;
    }
    else {
      continue;
    }
    $item['url'] = $url;
    $item['is_disabled'] = $is_disabled;
    $item['is_active'] = ($active_section === $item['key']);
    $built[] = $item;
  }

  return $built;
}

/**
 * Builds sidebar navigation with Dashboard wizard submenu links.
 *
 * @param string $active_section
 *   The active top-level section key.
 * @param string|null $route_name
 *   The current route name.
 * @param \Drupal\Core\Routing\RouteMatchInterface $route_match
 *   The current route match.
 *
 * @return array<int, array<string, mixed>>
 *   Sidebar items for vendor shell.
 */
function _myeventlane_vendor_theme_build_vendor_shell_nav_items(string $active_section, ?string $route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match): array {
  if (_myeventlane_vendor_theme_is_vendor_onboard_route($route_name)) {
    return _myeventlane_vendor_theme_build_onboarding_shell_nav_items($active_section, $route_name, $route_match);
  }
  return _myeventlane_vendor_theme_build_full_vendor_shell_nav_items($active_section, $route_name, $route_match);
}

/**
 * Builds Events submenu links for canonical event wizard pages.
 *
 * @param string|null $route_name
 *   The current route name.
 * @param \Drupal\Core\Routing\RouteMatchInterface $route_match
 *   The current route match.
 *
 * @return array<int, array<string, mixed>>
 *   Dashboard child menu links.
 */
function _myeventlane_vendor_theme_build_event_wizard_submenu(?string $route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match): array {
  $event_id = _myeventlane_vendor_theme_resolve_event_id($route_match);
  if ($event_id === NULL) {
    return [];
  }

  if (!_myeventlane_vendor_theme_named_route_accessible('myeventlane_event_studio.edit', ['node' => $event_id])) {
    return [];
  }

  $url = _myeventlane_vendor_theme_safe_route_url('myeventlane_event_studio.edit', ['node' => $event_id]);
  $studio_routes = _myeventlane_vendor_theme_event_studio_routes();

  return [
    [
      'label' => t('Event builder'),
      'url' => $url,
      'is_disabled' => $url === NULL,
      'is_active' => in_array($route_name, $studio_routes, TRUE),
    ],
  ];
}

/**
 * Resolves current event id from route parameters.
 *
 * @param \Drupal\Core\Routing\RouteMatchInterface $route_match
 *   The current route match.
 *
 * @return int|null
 *   Event node id if available.
 */
function _myeventlane_vendor_theme_resolve_event_id(\Drupal\Core\Routing\RouteMatchInterface $route_match): ?int {
  $node = $route_match->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'event') {
    return (int) $node->id();
  }
  if (is_numeric($node) && (int) $node > 0) {
    return (int) $node;
  }

  $event = $route_match->getParameter('event');
  if ($event instanceof \Drupal\node\NodeInterface && $event->bundle() === 'event') {
    return (int) $event->id();
  }
  if (is_numeric($event) && (int) $event > 0) {
    return (int) $event;
  }

  return NULL;
}

/**
 * Safely builds a route URL string.
 *
 * @param string $route_name
 *   Route machine name.
 * @param array<string, mixed> $parameters
 *   Route parameters.
 *
 * @return string|null
 *   URL string when route exists, otherwise NULL.
 */
function _myeventlane_vendor_theme_safe_route_url(string $route_name, array $parameters = []): ?string {
  try {
    return \Drupal\Core\Url::fromRoute($route_name, $parameters)->toString();
  }
  catch (\Exception $e) {
    return NULL;
  }
}

/**
 * Get the commerce store for the current user (vendor resolution).
 *
 * Uses myeventlane_checkout_flow.vendor_ownership_resolver if available,
 * otherwise resolves via myeventlane_vendor (uid or field_vendor_users) and
 * field_vendor_store, or commerce_store by uid.
 *
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The user account.
 *
 * @return \Drupal\commerce_store\Entity\StoreInterface|null
 *   The store, or NULL if not found.
 */
function _myeventlane_vendor_theme_get_store_for_account(\Drupal\Core\Session\AccountInterface $account): ?\Drupal\commerce_store\Entity\StoreInterface {
  if (\Drupal::hasService('myeventlane_checkout_flow.vendor_ownership_resolver')) {
    $resolver = \Drupal::service('myeventlane_checkout_flow.vendor_ownership_resolver');
    $store = $resolver->getStoreForUser($account);
    if ($store instanceof \Drupal\commerce_store\Entity\StoreInterface) {
      return $store;
    }
  }

  try {
    $uid = (int) $account->id();
    $etm = \Drupal::entityTypeManager();

    if ($etm->getDefinition('myeventlane_vendor', FALSE)) {
      $vendor_storage = $etm->getStorage('myeventlane_vendor');
      $ids = $vendor_storage->getQuery()
        ->accessCheck(FALSE)
        ->condition('uid', $uid)
        ->range(0, 1)
        ->execute();
      if (empty($ids)) {
        $ids = $vendor_storage->getQuery()
          ->accessCheck(FALSE)
          ->condition('field_vendor_users', $uid)
          ->range(0, 1)
          ->execute();
      }
      if (!empty($ids)) {
        $vendor = $vendor_storage->load(reset($ids));
        if ($vendor && $vendor->hasField('field_vendor_store') && !$vendor->get('field_vendor_store')->isEmpty()) {
          $store = $vendor->get('field_vendor_store')->entity;
          if ($store instanceof \Drupal\commerce_store\Entity\StoreInterface) {
            return $store;
          }
        }
      }
    }

    $stores = $etm->getStorage('commerce_store')->loadByProperties(['uid' => $uid]);
    return !empty($stores) ? reset($stores) : NULL;
  }
  catch (\Exception $e) {
    return NULL;
  }
}

/**
 * Alert: Event sold out (any published event at capacity).
 *
 * @param int $uid
 *   Vendor user ID.
 *
 * @return array{type: string, message: string, cta: array{label: string, url: string}}|null
 */
function _myeventlane_vendor_theme_alert_event_sold_out(int $uid): ?array {
  if ($uid <= 0 || !\Drupal::hasService('myeventlane_capacity.service')) {
    return NULL;
  }
  try {
    $etm = \Drupal::entityTypeManager();
    $ids = $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'event')
      ->condition('uid', $uid)
      ->condition('status', 1)
      ->range(0, 50)
      ->execute();
    if (empty($ids)) {
      return NULL;
    }
    /** @var \Drupal\myeventlane_core\Service\EntityIdNormalizer $normalizer */
    $normalizer = \Drupal::service('myeventlane_core.entity_id_normalizer');
    $nids = $normalizer->normalizeNodeIds(array_values($ids));
    if ($nids === []) {
      return NULL;
    }
    $capacity = \Drupal::service('myeventlane_capacity.service');
    foreach (array_slice($nids, 0, 20) as $nid) {
      $node = $etm->getStorage('node')->load($nid);
      if ($node && $capacity->isSoldOut($node)) {
        return [
          'type' => 'info',
          'message' => t('One of your events is now sold out.'),
          'cta' => ['label' => t('View events'), 'url' => '/vendor/events'],
        ];
      }
    }
  }
  catch (\Exception $e) {
    // Silently skip.
  }
  return NULL;
}

/**
 * Alert: Boost expiring in ≤ 7 days.
 *
 * @param int $uid
 *   Vendor user ID.
 *
 * @return array{type: string, message: string, cta: array{label: string, url: string}}|null
 */
function _myeventlane_vendor_theme_alert_boost_expiring(int $uid): ?array {
  if ($uid <= 0) {
    return NULL;
  }
  if (!\Drupal::moduleHandler()->moduleExists('myeventlane_boost')) {
    return NULL;
  }
  try {
    $now = \Drupal::time()->getRequestTime();
    $cutoff = $now + (7 * 86400);
    $now_str = date('Y-m-d\TH:i:s', $now);
    $cutoff_str = date('Y-m-d\TH:i:s', $cutoff);
    $etm = \Drupal::entityTypeManager();
    $ids = $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'event')
      ->condition('uid', $uid)
      ->condition('field_promoted', 1)
      ->condition('field_promo_expires', $now_str, '>=')
      ->condition('field_promo_expires', $cutoff_str, '<=')
      ->range(0, 1)
      ->execute();
    if (!empty($ids)) {
      return [
        'type' => 'warning',
        'message' => t('Your event promotion expires soon.'),
        'cta' => ['label' => t('Manage promotion'), 'url' => '/vendor/boost'],
      ];
    }
  }
  catch (\Exception $e) {
    // Silently skip (e.g. fields missing).
  }
  return NULL;
}

/**
 * Alert: New order received (session-only; no persistence).
 *
 * @param int $uid
 *   Vendor user ID.
 *
 * @return array{type: string, message: string, cta: array{label: string, url: string}}|null
 */
function _myeventlane_vendor_theme_alert_new_order(int $uid): ?array {
  if ($uid <= 0) {
    return NULL;
  }
  try {
    $request = \Drupal::requestStack()->getCurrentRequest();
    $session = $request ? $request->getSession() : NULL;
    if (!$session) {
      return NULL;
    }
    $max = _myeventlane_vendor_theme_get_max_completed_order_id_for_user($uid);
    $last = $session->get('mel_vendor_alert_last_seen_order_id');
    if ($last === NULL) {
      $session->set('mel_vendor_alert_last_seen_order_id', $max);
      return NULL;
    }
    if ($max > (int) $last) {
      $session->set('mel_vendor_alert_last_seen_order_id', $max);
      return [
        'type' => 'info',
        'message' => t('You\'ve received a new ticket order.'),
        'cta' => ['label' => t('View orders'), 'url' => '/vendor/orders'],
      ];
    }
  }
  catch (\Exception $e) {
    // Silently skip.
  }
  return NULL;
}

/**
 * Get max completed order ID for orders containing items for the user's events.
 */
function _myeventlane_vendor_theme_get_max_completed_order_id_for_user(int $uid): int {
  try {
    $etm = \Drupal::entityTypeManager();
    $eids_raw = $etm->getStorage('node')->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', 'event')
      ->condition('uid', $uid)
      ->range(0, 100)
      ->execute();
    /** @var \Drupal\myeventlane_core\Service\EntityIdNormalizer $normalizer */
    $normalizer = \Drupal::service('myeventlane_core.entity_id_normalizer');
    // Before: raw query map; mixed scalars. After: int nids.
    $eids = $normalizer->normalizeNodeIds(array_values($eids_raw));
    if ($eids === []) {
      return 0;
    }
    $oi_ids_raw = $etm->getStorage('commerce_order_item')->getQuery()
      ->accessCheck(FALSE)
      ->condition('field_target_event', $eids, 'IN')
      ->range(0, 500)
      ->execute();
    $oi_ids = $normalizer->normalizeEntityIds(array_values($oi_ids_raw));
    if ($oi_ids === []) {
      return 0;
    }
    $items = $etm->getStorage('commerce_order_item')->loadMultiple($oi_ids);
    $order_ids = [];
    foreach ($items as $it) {
      if (!$it->get('order_id')->isEmpty()) {
        $order_ids[] = $it->get('order_id')->target_id;
      }
    }
    $order_ids = $normalizer->normalizeOrderIds(array_values($order_ids));
    if ($order_ids === []) {
      return 0;
    }
    $completed = $etm->getStorage('commerce_order')->getQuery()
      ->accessCheck(FALSE)
      ->condition('id', $order_ids, 'IN')
      ->condition('state', 'completed')
      ->sort('id', 'DESC')
      ->range(0, 1)
      ->execute();
    return !empty($completed) ? (int) reset($completed) : 0;
  }
  catch (\Exception $e) {
    return 0;
  }
}

/**
 * Build vendor_alert array for the Vendor Alert Strip.
 *
 * Priority (locked): (1) payouts disabled; (2) account missing; (3) recent
 * payout; (4) boost expiring; (5) event sold out; (6) new order; (7) else info.
 *
 * @param \Drupal\Core\Session\AccountInterface $current_user
 *   The current user.
 *
 * @return array{type: string, message: string, cta: array{label: string, url: string}|null}|null
 *   The alert array, or NULL when not authenticated (no alert).
 */
function _myeventlane_vendor_theme_get_vendor_alert(\Drupal\Core\Session\AccountInterface $current_user): ?array {
  if (!$current_user->isAuthenticated()) {
    return NULL;
  }

  $store = _myeventlane_vendor_theme_get_store_for_account($current_user);
  $uid = (int) $current_user->id();

  // 1) Stripe payouts disabled (account exists but onboarding incomplete) → action CTA
  $payouts_enabled = TRUE;
  if ($store && $store->hasField('field_stripe_payouts_enabled') && !$store->get('field_stripe_payouts_enabled')->isEmpty()) {
    $payouts_enabled = (bool) $store->get('field_stripe_payouts_enabled')->value;
  }
  $account_id = '';
  if ($store && $store->hasField('field_stripe_account_id') && !$store->get('field_stripe_account_id')->isEmpty()) {
    $account_id = trim((string) $store->get('field_stripe_account_id')->value);
  }
  if ($account_id !== '' && !$payouts_enabled) {
    return [
      'type' => 'warning',
      'message' => t('Finish setting up Stripe so payouts can reach your bank.'),
      'cta' => ['label' => t('Resume Stripe setup'), 'url' => '/stripe/connect'],
    ];
  }

  // 2) No Stripe account ID → connect
  if ($account_id === '') {
    return [
      'type' => 'warning',
      'message' => t('Connect Stripe to receive payments.'),
      'cta' => ['label' => t('Connect Stripe'), 'url' => '/stripe/connect'],
    ];
  }

  // 3) Payout recently completed → success (Stripe-backed via service)
  if ($store && \Drupal::hasService('myeventlane_stripe.vendor_stripe')) {
    $vendor_stripe = \Drupal::service('myeventlane_stripe.vendor_stripe');
    $payout = $vendor_stripe->hasRecentPayout($store, 3);
    if ($payout !== NULL) {
      $amount = $payout['currency'] === 'AUD' ? '$' . $payout['amount'] : $payout['amount'] . ' ' . $payout['currency'];
      return [
        'type' => 'success',
        'message' => t('Your payout of @amount was sent on @date.', [
          '@amount' => $amount,
          '@date' => $payout['date']->format('M j, Y'),
        ]),
        'cta' => NULL,
      ];
    }
  }

  // 4) Boost expiring (≤ 7 days)
  $alert = _myeventlane_vendor_theme_alert_boost_expiring($uid);
  if ($alert !== NULL) {
    return $alert;
  }

  // 5) Event sold out
  $alert = _myeventlane_vendor_theme_alert_event_sold_out($uid);
  if ($alert !== NULL) {
    return $alert;
  }

  // 6) New order received (session-only)
  $alert = _myeventlane_vendor_theme_alert_new_order($uid);
  if ($alert !== NULL) {
    return $alert;
  }

  // 7) Else → info (next payout)
  return [
    'type' => 'info',
    'message' => t('View your payout schedule and balance in Payouts.'),
    'cta' => ['label' => t('View Payouts'), 'url' => '/vendor/payouts'],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for form__mel_vendor_events.
 */
function myeventlane_vendor_theme_preprocess_form__mel_vendor_events(array &$variables): void {
  $element = $variables['element'] ?? [];
  $variables['create_event_url'] = $element['#create_event_url'] ?? '';
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Adds structured date parts for vendor_card view mode (date pill).
 */
function myeventlane_vendor_theme_preprocess_node(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'vendor_card') {
    return;
  }
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $variables['mel_event_start_parts'] = NULL;
  $variables['mel_event_capacity'] = NULL;
  if (!$node->hasField('field_event_start') || $node->get('field_event_start')->isEmpty()) {
    // Still try capacity.
  }
  else {
    $start = $node->get('field_event_start');
    if (isset($start->date) && $start->date) {
      $variables['mel_event_start_parts'] = [
        'day' => $start->date->format('d'),
        'month' => $start->date->format('M'),
        'time' => $start->date->format('g:i A'),
      ];
    }
  }
  if ($node->hasField('field_event_capacity_total') && !$node->get('field_event_capacity_total')->isEmpty()) {
    $cap = (int) $node->get('field_event_capacity_total')->value;
    if ($cap > 0) {
      $variables['mel_event_capacity'] = $cap;
    }
  }
  if ($node->hasField('field_event_state') && !$node->get('field_event_state')->isEmpty()) {
    $state = $node->get('field_event_state')->value;
    $variables['mel_event_state_key'] = $state ? str_replace('_', '-', $state) : NULL;
  }
  else {
    $variables['mel_event_state_key'] = NULL;
  }
}

