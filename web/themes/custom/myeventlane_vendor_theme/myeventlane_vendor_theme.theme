<?php

/**
 * @file
 * Theme functions for MyEventLane Vendor Theme.
 *
 * MEL LANGUAGE STANDARD:
 * - Australian English
 * - "Attendee" not "Customer"
 * - "Organiser" not "Vendor"
 * - Friendly, non-corporate tone
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\myeventlane_core\Entity\OnboardingStateInterface;
use Drupal\myeventlane_vendor\Service\VendorNavBuilder;
use Drupal\node\NodeInterface;

/**
 * Whether the current route is organiser onboarding (restricted shell nav).
 */
function _myeventlane_vendor_theme_is_vendor_onboard_route(?string $route_name): bool {
  return is_string($route_name) && str_starts_with($route_name, 'myeventlane_vendor.onboard');
}

/**
 * Whether the current user may access a named route (Drupal access manager).
 */
function _myeventlane_vendor_theme_named_route_accessible(string $route_name, array $parameters = []): bool {
  try {
    return \Drupal::accessManager()
      ->checkNamedRoute($route_name, $parameters, \Drupal::currentUser(), TRUE)
      ->isAllowed();
  }
  catch (\Exception $e) {
    return FALSE;
  }
}

/**
 * Home URL for sidebar brand (dashboard if allowed, else onboarding profile, else front).
 */
function _myeventlane_vendor_theme_vendor_brand_home_url(): string {
  if (_myeventlane_vendor_theme_named_route_accessible('myeventlane_vendor.console.dashboard', [])) {
    try {
      return Url::fromRoute('myeventlane_vendor.console.dashboard')->toString();
    }
    catch (\Exception $e) {
    }
  }
  if (_myeventlane_vendor_theme_named_route_accessible('myeventlane_vendor.onboard.profile', [])) {
    try {
      return Url::fromRoute('myeventlane_vendor.onboard.profile')->toString();
    }
    catch (\Exception $e) {
    }
  }
  try {
    return Url::fromRoute('<front>')->toString();
  }
  catch (\Exception $e) {
    return '/';
  }
}

/**
 * Vendor-console internal footer links with route access applied in PHP.
 *
 * @return array<string, string|null>
 *   Keys: dashboard, events, analytics, payouts, create_event, settings, support.
 */
function _myeventlane_vendor_theme_vendor_console_footer_urls(): array {
  $routes = [
    'dashboard' => 'myeventlane_vendor.console.dashboard',
    'events' => 'myeventlane_vendor.console.events',
    'analytics' => 'myeventlane_analytics.dashboard',
    'payouts' => 'myeventlane_vendor.console.payouts',
    'create_event' => 'myeventlane_vendor.create_event_gateway',
    'settings' => 'myeventlane_vendor.console.settings',
    'support' => 'myeventlane_escalations_portal.vendor_list',
  ];
  $out = [];
  foreach ($routes as $key => $route_name) {
    $out[$key] = NULL;
    if (!_myeventlane_vendor_theme_named_route_accessible($route_name, [])) {
      continue;
    }
    $url = _myeventlane_vendor_theme_safe_route_url($route_name);
    if ($url !== NULL) {
      $out[$key] = $url;
    }
  }
  return $out;
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Themes do not implement hook_page_attachments(); this alter strips accidental
 * public-theme libraries on vendor paths only, when the vendor theme is active.
 *
 * @see https://api.drupal.org/api/drupal/core!lib!Drupal!Core!Render!theme.api.php/function/hook_page_attachments_alter
 */
function myeventlane_vendor_theme_page_attachments_alter(array &$attachments): void {
  $request = \Drupal::request();
  $path = $request->getPathInfo();

  if (!_myeventlane_vendor_theme_is_vendor_scoped_path($path)) {
    return;
  }

  $active_theme = \Drupal::theme()->getActiveTheme()->getName();
  if ($active_theme !== 'myeventlane_vendor_theme') {
    return;
  }

  /** @var list<string> Future: myeventlane_theme/* library IDs to allow through (not enabled until populated). */
  $allowed = [];

  if (!isset($attachments['#attached']['library']) || !is_array($attachments['#attached']['library'])) {
    $attachments['#attached']['library'] = [];
  }

  $attachments['#attached']['library'] = array_values(array_filter(
    $attachments['#attached']['library'],
    static function ($library) use ($allowed): bool {
      if (!is_string($library)) {
        return TRUE;
      }
      if (!str_starts_with($library, 'myeventlane_theme/')) {
        return TRUE;
      }
      return in_array($library, $allowed, TRUE);
    }
  ));

  $global_library = 'myeventlane_vendor_theme/global';
  if (!in_array($global_library, $attachments['#attached']['library'], TRUE)) {
    $attachments['#attached']['library'][] = $global_library;
  }
}

/**
 * Paths where vendor theme should strip conflicting public-theme assets.
 *
 * Includes /vendor/* and core user auth paths served on the vendor host.
 */
function _myeventlane_vendor_theme_is_vendor_scoped_path(string $path): bool {
  // Match /vendor and /vendor/* only — not the public directory /vendors.
  if (preg_match('#^/vendor(/|$)#', $path)) {
    return TRUE;
  }
  $auth = ['/user/login', '/user/register', '/user/password'];
  foreach ($auth as $prefix) {
    if ($path === $prefix || str_starts_with($path, $prefix . '/')) {
      return TRUE;
    }
  }
  if (str_starts_with($path, '/user/reset')) {
    return TRUE;
  }
  return FALSE;
}

/**
 * Implements hook_preprocess().
 *
 * Applies MEL language standardisation to vendor-facing display text.
 */
function myeventlane_vendor_theme_preprocess(array &$variables, string $hook): void {
  if (!\Drupal::hasService('myeventlane_core.language_style')) {
    return;
  }
  // Email wrappers carry rendered HTML with canonical hrefs — do not rewrite.
  if (in_array($hook, ['myeventlane_email', 'mel_email_base', 'myeventlane_messaging_inline'], TRUE)) {
    return;
  }
  /** @var \Drupal\myeventlane_core\Service\LanguageStyleService $service */
  $service = \Drupal::service('myeventlane_core.language_style');
  _myeventlane_vendor_theme_apply_language_style($variables, $service);
}

/**
 * Recursively applies language style; skips URLs and technical keys.
 *
 * Skips render array properties (keys starting with #) to avoid corrupting
 * #cache, #attached, etc. e.g. "user.permissions" must not become
 * "member.permissions" in cache contexts.
 */
function _myeventlane_vendor_theme_apply_language_style(array &$items, $service): void {
  foreach ($items as $key => &$value) {
    if (is_string($key) && str_starts_with($key, '#')) {
      continue;
    }
    if (is_array($value)) {
      _myeventlane_vendor_theme_apply_language_style($value, $service);
    }
    elseif (
      is_string($value)
      && !$service->shouldSkipKey($key)
      && !$service->looksLikeUrl($value)
      && !$service->looksLikeHtml($value)
    ) {
      $value = $service->replace($value);
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function myeventlane_vendor_theme_preprocess_page(array &$variables): void {
  $request = \Drupal::request();

  if ($request->isXmlHttpRequest()) {
    return;
  }

  // Footer context for internal footer (vendor dashboard).
  try {
    $variables['footer_context'] = \Drupal::service('myeventlane_vendor.footer_context')->getContext();
  }
  catch (\Exception $e) {
    $variables['footer_context'] = [
      'store_name' => NULL,
      'payout_balance' => '$0.00',
      'environment' => getenv('SITE_ENV') ?: 'Production',
      'open_tickets' => 0,
      'is_vendor' => FALSE,
      'is_admin' => FALSE,
    ];
  }
  if (!empty($variables['footer_context']['is_vendor'])) {
    $variables['footer_context']['vendor_console_urls'] = _myeventlane_vendor_theme_vendor_console_footer_urls();
  }

  // Event node add form: staff/support only. Vendors use Event Studio (myeventlane_event_studio.create).
  try {
    if (\Drupal::routeMatch()->getRouteName() === 'entity.node.add_form') {
      $account = \Drupal::currentUser();
      $is_staff_node_form = $account->hasPermission('administer nodes') || (int) $account->id() === 1;
      $node_type = \Drupal::routeMatch()->getParameter('node_type');
      if ($is_staff_node_form && $node_type) {
        $bundle = is_object($node_type) ? $node_type->id() : (string) $node_type;
        if ($bundle === 'event') {
          $variables['#attached']['library'][] = 'myeventlane_vendor_theme/vendor_event_form_page';
        }
      }
    }
  }
  catch (\Exception $e) {
    // Route parameters unavailable; skip optional bridge script.
  }

  // Get current user info.
  $current_user = \Drupal::currentUser();
  $account = $current_user->getAccount();

  // Set user info for sidebar/header.
  if ($current_user->isAuthenticated()) {
    $variables['page']['user_name'] = $account->getDisplayName();
    $variables['page']['user_initials'] = _myeventlane_vendor_theme_get_initials($account->getDisplayName());
    
    // Check for vendor role.
    $roles = $current_user->getRoles();
    if (in_array('vendor', $roles)) {
      $variables['page']['user_role'] = t('Organiser');
    }
    elseif (in_array('administrator', $roles)) {
      $variables['page']['user_role'] = t('Administrator');
    }
    else {
      $variables['page']['user_role'] = t('User');
    }
  }

  // Get workspace/vendor name from current user's vendor entity if available.
  // This is a placeholder - implement based on your vendor resolution logic.
  $variables['page']['workspace_name'] = NULL;
  
  // Try to get vendor name from node context if viewing an event.
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');
  if (!$node) {
    $node = $route_match->getParameter('event');
  }
  if ($node && $node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'event') {
    if ($node->hasField('field_event_vendor') && !$node->get('field_event_vendor')->isEmpty()) {
      $vendor = $node->get('field_event_vendor')->entity;
      if ($vendor) {
        $variables['page']['workspace_name'] = $vendor->label();
      }
    }
  }

  // Set main site URL - build URL pointing to public domain.
  try {
    if (\Drupal::hasService('myeventlane_core.domain_detector')) {
      $domain_detector = \Drupal::service('myeventlane_core.domain_detector');
      $variables['page']['main_site_url'] = $domain_detector->buildDomainUrl('/', 'public');
    }
    else {
      // Fallback: use current request to build public URL.
      $request = \Drupal::requestStack()->getCurrentRequest();
      if ($request) {
        $scheme = $request->getScheme();
        $host = $request->getHost();
        // Remove vendor. or admin. prefix to get main domain.
        $host = preg_replace('/^(vendor|admin)\./', '', $host);
        $variables['page']['main_site_url'] = $scheme . '://' . $host . '/';
      }
      else {
        $variables['page']['main_site_url'] = '/';
      }
    }
  }
  catch (\Exception $e) {
    // Fallback to relative URL if service unavailable.
    $variables['page']['main_site_url'] = '/';
  }

  // Set admin portal URL for administrators.
  $variables['page']['is_admin'] = FALSE;
  $variables['page']['admin_portal_url'] = NULL;
  if ($current_user->isAuthenticated()) {
    $roles = $current_user->getRoles();
    if (in_array('administrator', $roles) || $current_user->id() === 1) {
      $variables['page']['is_admin'] = TRUE;
      
      // Build admin portal URL using Drupal's URL generator to ensure proper route.
      try {
        $admin_url = \Drupal\Core\Url::fromRoute('myeventlane_admin_dashboard.overview', [], ['absolute' => TRUE]);
        $variables['page']['admin_portal_url'] = $admin_url->toString(TRUE)->getGeneratedUrl();
      }
      catch (\Exception $e) {
        // If route doesn't exist or URL generation fails, try DomainDetector.
        try {
          if (\Drupal::hasService('myeventlane_core.domain_detector')) {
            $domain_detector = \Drupal::service('myeventlane_core.domain_detector');
            $variables['page']['admin_portal_url'] = $domain_detector->buildDomainUrl('/admin/myeventlane', 'admin');
          }
        }
        catch (\Exception $e2) {
          // Service not available, use fallback.
        }
        
        // Fallback: use current request to build admin URL.
        if (empty($variables['page']['admin_portal_url'])) {
          $request = \Drupal::requestStack()->getCurrentRequest();
          if ($request) {
            $scheme = $request->getScheme();
            $host = $request->getHost();
            // Replace 'vendor.' with 'admin.' in hostname.
            $host = preg_replace('/^vendor\./', 'admin.', $host);
            if (!str_starts_with($host, 'admin.')) {
              $host = 'admin.' . preg_replace('/^(admin|vendor)\./', '', $host);
            }
            $variables['page']['admin_portal_url'] = $scheme . '://' . $host . '/admin/myeventlane';
          }
          else {
            // Final fallback: relative URL.
            $variables['page']['admin_portal_url'] = '/admin/myeventlane';
          }
        }
      }
    }
  }

  // Route-safe Pro link: avoid hard failures when pro module/routes are absent.
  $variables['page']['pro_overview_url'] = NULL;
  try {
    $variables['page']['pro_overview_url'] = \Drupal\Core\Url::fromRoute('myeventlane_pro.overview')->toString();
  }
  catch (\Exception $e) {
    \Drupal::logger('myeventlane_vendor_theme')->warning('Pro overview route is unavailable: @message', [
      '@message' => $e->getMessage(),
    ]);
  }

  // Safe inbox URL for sidebar fallbacks (omit when user cannot access the route).
  $variables['page']['vendor_notification_inbox_url'] = NULL;
  if (\Drupal::moduleHandler()->moduleExists('myeventlane_notifications')
    && _myeventlane_vendor_theme_named_route_accessible('myeventlane_notifications.inbox', [])) {
    try {
      $variables['page']['vendor_notification_inbox_url'] = \Drupal\Core\Url::fromRoute('myeventlane_notifications.inbox')->toString();
    }
    catch (\Throwable) {
    }
  }

  // Shell sidebar IA: VendorNavBuilder (myeventlane_vendor.nav_builder).
  $route_name = $route_match->getRouteName();
  $is_vendor_onboard = is_string($route_name) && str_starts_with($route_name, 'myeventlane_vendor.onboard');
  /** @var \Drupal\myeventlane_vendor\Service\VendorNavBuilder $nav_builder */
  $nav_builder = \Drupal::service('myeventlane_vendor.nav_builder');
  $variables['page']['active_section'] = $nav_builder->resolveActiveSection(
    is_string($route_name) ? $route_name : NULL,
  );
  $variables['page']['vendor_shell_nav_items'] = $nav_builder->buildShellNavItems(
    $variables['page']['active_section'],
  );
  $variables['#cache']['contexts'] = Cache::mergeContexts(
    $variables['#cache']['contexts'] ?? [],
    VendorNavBuilder::SHELL_NAV_CACHE_CONTEXTS,
  );
  $variables['page']['vendor_shell_brand_url'] = _myeventlane_vendor_theme_vendor_brand_home_url();

  // Settings route (Profile): subsection tabs + shell title — was VendorSettingsController theme wrapper.
  $variables['page']['mel_vendor_route_tabs'] = NULL;
  if ($route_name === 'myeventlane_vendor.console.settings') {
    try {
      $variables['page']['mel_vendor_route_tabs'] = [
        [
          'label' => t('Profile'),
          'url' => Url::fromRoute('myeventlane_vendor.console.settings')->toString(),
          'active' => TRUE,
        ],
        [
          'label' => t('Messaging Brand'),
          'url' => Url::fromRoute('myeventlane_vendor.console.messaging_brand')->toString(),
          'active' => FALSE,
        ],
      ];
      $variables['page']['shell_page_title'] = t('Settings');
    }
    catch (\Throwable) {
    }
  }
  elseif ($route_name === 'myeventlane_vendor.console.messaging_brand') {
    try {
      $variables['page']['mel_vendor_route_tabs'] = [
        [
          'label' => t('Profile'),
          'url' => Url::fromRoute('myeventlane_vendor.console.settings')->toString(),
          'active' => FALSE,
        ],
        [
          'label' => t('Messaging Brand'),
          'url' => Url::fromRoute('myeventlane_vendor.console.messaging_brand')->toString(),
          'active' => TRUE,
        ],
      ];
      $variables['page']['shell_page_title'] = t('Settings');
    }
    catch (\Throwable) {
    }
  }

  // Create Event always goes through the gateway so draft-choice can run.
  $variables['page']['shell_primary_action'] = NULL;
  if ($current_user->isAuthenticated()
    && _myeventlane_vendor_theme_named_route_accessible('myeventlane_vendor.create_event_gateway', [])) {
    $create_url = _myeventlane_vendor_theme_safe_route_url('myeventlane_vendor.create_event_gateway');
    if ($create_url !== NULL) {
      $variables['page']['shell_primary_action'] = [
        'label' => t('Create event'),
        'url' => $create_url,
      ];
    }
  }

  // Event Studio shell CSS (mel-es-workspace) for organiser onboarding — reuse module CSS, no wizard JS.
  if ($is_vendor_onboard) {
    $variables['#attached']['library'][] = 'myeventlane_event_studio/mel_event_studio_shell_only';
  }

  // Legacy step-wizard sidebar: staff/support only (vendors are redirected to Event Studio).
  $variables['page']['wizard_steps'] = [];
  $account = $current_user;
  if (in_array($route_name, _myeventlane_vendor_theme_event_wizard_step_routes(), TRUE)
    && ($account->hasPermission('administer nodes') || (int) $account->id() === 1)) {
    $event = $route_match->getParameter('event') ?? $route_match->getParameter('node');
    if ($event && $event instanceof \Drupal\node\NodeInterface && $event->bundle() === 'event') {
      $variables['page']['wizard_steps'] = _myeventlane_vendor_theme_build_wizard_steps($event, $route_name);
      $variables['page']['wizard_sidebar_active'] = TRUE;
    }
  }

  // Log out only when signed in (avoid anonymous login page showing Log out).
  $variables['page']['logout_link'] = NULL;
  if ($current_user->isAuthenticated()) {
    $variables['page']['logout_link'] = [
      '#type' => 'link',
      '#title' => t('Log out'),
      '#url' => \Drupal\Core\Url::fromRoute('user.logout'),
    ];
  }

  // Build user menu for header.
  if ($current_user->isAuthenticated()) {
    // Vendor console links (mirror account menu YAML; visibility = route access).
    $vendor_console_links = [
      ['title' => t('Dashboard'), 'route' => 'myeventlane_vendor.console.dashboard'],
      ['title' => t('Events'), 'route' => 'myeventlane_vendor.console.events'],
      ['title' => t('Create event'), 'route' => 'myeventlane_vendor.create_event_gateway'],
      ['title' => t('Settings'), 'route' => 'myeventlane_vendor.console.settings'],
    ];
    $user_menu_items = [];
    foreach ($vendor_console_links as $link_def) {
      try {
        $vurl = \Drupal\Core\Url::fromRoute($link_def['route']);
        if ($vurl->access()) {
          $user_menu_items[] = [
            '#type' => 'link',
            '#title' => $link_def['title'],
            '#url' => $vurl,
            '#attributes' => ['class' => ['user-menu__item', 'user-menu__item--vendor-console']],
          ];
        }
      }
      catch (\Throwable) {
      }
    }

    // User profile link.
    $user_menu_items[] = [
      '#type' => 'link',
      '#title' => t('Profile'),
      '#url' => \Drupal\Core\Url::fromRoute('entity.user.canonical', ['user' => $current_user->id()]),
      '#attributes' => ['class' => ['user-menu__item']],
    ];

    if ($current_user->hasPermission('access myeventlane notifications')) {
      try {
        $notif_url = \Drupal\Core\Url::fromRoute('myeventlane_notifications.inbox');
        if ($notif_url->access()) {
          $user_menu_items[] = [
            '#type' => 'link',
            '#title' => t('Notifications'),
            '#url' => $notif_url,
            '#attributes' => ['class' => ['user-menu__item']],
          ];
        }
      }
      catch (\Throwable) {
      }
    }

    // Logout link.
    $user_menu_items[] = [
      '#type' => 'link',
      '#title' => t('Log out'),
      '#url' => \Drupal\Core\Url::fromRoute('user.logout'),
      '#attributes' => ['class' => ['user-menu__item']],
    ];
    
    $variables['page']['user_menu'] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['user-menu']],
      'user_info' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['user-menu__info']],
        'initials' => [
          '#markup' => '<span class="user-menu__initials">' . ($variables['page']['user_initials'] ?? 'U') . '</span>',
        ],
        'name' => [
          '#markup' => '<span class="user-menu__name">' . ($variables['page']['user_name'] ?? 'User') . '</span>',
        ],
      ],
      'dropdown' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['user-menu__dropdown']],
        'items' => $user_menu_items,
      ],
    ];
  }
  else {
    $variables['page']['user_menu'] = [];
  }

  // Build quick actions for header (Admin Portal for admins; Create Event when route allows).
  $variables['page']['quick_actions'] = [];
  
  // Admin Portal button (for administrators).
  if ($variables['page']['is_admin'] && $variables['page']['admin_portal_url']) {
    $variables['page']['quick_actions'][] = [
      '#type' => 'link',
      '#title' => t('Admin Portal'),
      '#url' => \Drupal\Core\Url::fromUri($variables['page']['admin_portal_url']),
      '#attributes' => [
        'class' => ['mel-btn', 'mel-btn--secondary', 'mel-header__action-btn'],
      ],
    ];
  }
  
  // Create Event is rendered once via shell_primary_action in layout/page.html.twig.
  // Do not duplicate in quick_actions (legacy header strip).

  // --- Vendor Alert Strip (STAGE A: data model, stub logic) ---
  // Exposes $page['vendor_alert'] when an alert applies. Only ONE alert at a time.
  // If no alert applies, vendor_alert is not set.
  // Suppress on vendor onboarding routes: Stripe CTAs live in the guided flow (no duplicate banner).
  $vendor_alert = _myeventlane_vendor_theme_get_vendor_alert($current_user);
  if ($vendor_alert !== NULL && !$is_vendor_onboard) {
    $variables['page']['vendor_alert'] = $vendor_alert;
  }

  // MEL notification bell: built by myeventlane_notifications_preprocess_page().

  // MEL Pro grace-period banner (failed payment recovery).
  if (\Drupal::hasService('myeventlane_pro.subscription_status') && $current_user->isAuthenticated() && in_array('vendor', $current_user->getRoles(), TRUE)) {
    $user_storage = \Drupal::entityTypeManager()->getStorage('user');
    $account = $user_storage->load((int) $current_user->id());
    if ($account instanceof \Drupal\user\UserInterface) {
      /** @var \Drupal\myeventlane_pro\Service\ProSubscriptionStatusService $pro_status */
      $pro_status = \Drupal::service('myeventlane_pro.subscription_status');
      $status = $pro_status->getStatusForUser($account);
      if (!empty($status['is_in_grace'])) {
        $variables['page']['mel_pro_grace_banner'] = [
          'message' => (string) t('Your MEL Pro access is in a grace period'),
          'manage_url' => \Drupal\Core\Url::fromRoute('myeventlane_pro.manage')->toString(),
        ];
      }
    }
  }
}

/**
 * Implements hook_preprocess_html().
 */
function myeventlane_vendor_theme_preprocess_html(array &$variables): void {
  $variables['#attached']['library'][] = 'myeventlane_vendor_theme/form-protection';

  // Vendor UI scope: matches SCSS (.mel-vendor) and legacy token hook (.mel-vendor-theme).
  $variables['attributes']['class'][] = 'mel-vendor';
  $variables['attributes']['class'][] = 'mel-vendor-theme';

  // Event step wizard pages: body class for layout (e.g. full-width content).
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, _myeventlane_vendor_theme_event_builder_layout_routes(), TRUE)) {
    $variables['attributes']['class'][] = 'mel-page--event-wizard';
  }

  if (is_string($route_name) && str_starts_with($route_name, 'myeventlane_vendor.onboard')) {
    $variables['attributes']['class'][] = 'mel-page--vendor-onboard';
  }
}

/**
 * Implements hook_form_alter().
 */
function myeventlane_vendor_theme_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Gin Login / core user login: leave the form array untouched.
  if ($form_id === 'user_login_form') {
    return;
  }
  // Event Studio: taxonomy select list instead of entity autocomplete (presentation).
  if ($form_id === 'mel_event_studio_form') {
    _myeventlane_vendor_theme_mel_event_studio_category_select($form);
  }

  // Style node event forms.
  if (str_starts_with($form_id, 'node_event_')) {
    $form['#attributes']['class'][] = 'mel-event-form';
    $form['#attributes']['data-event-form'] = TRUE;
    
    // Attach event form library.
    $form['#attached']['library'][] = 'myeventlane_vendor_theme/event-form';
    
    // CRITICAL: Attach required libraries for conditional fields and #states to work.
    // These must be loaded for field visibility toggling based on event type.
    $form['#attached']['library'][] = 'core/drupal.form';
    $form['#attached']['library'][] = 'core/drupal.states';
    
    // Attach conditional_fields library if module is enabled.
    if (\Drupal::moduleHandler()->moduleExists('conditional_fields')) {
      $form['#attached']['library'][] = 'conditional_fields/conditional_fields';
    }
  }
  
  // Step wizard forms (Basics, When & Where, Tickets, Details, Review, Publish).
  if (str_starts_with($form_id, 'event_wizard_')) {
    $form['#attributes']['class'][] = 'mel-event-wizard-page';
    $form['#attributes']['class'][] = 'mel-wizard-form';
    $form['#attached']['library'][] = 'myeventlane_vendor_theme/event-form';
    $form['#attached']['library'][] = 'core/drupal.form';
    $form['#attached']['library'][] = 'core/drupal.states';
    $form['#attached']['library'][] = 'core/drupal.ajax';
  }
}

/**
 * Replaces Event Studio category autocomplete with a multi-select (taxonomy terms).
 *
 * Submits mel[field_category] as an array of term IDs, which matches
 * EventStudioForm::extractMultipleEntityIds() for array input.
 */
function _myeventlane_vendor_theme_mel_event_studio_category_select(array &$form): void {
  if (!isset($form['mel']['field_category']) || !is_array($form['mel']['field_category'])) {
    return;
  }
  $original = $form['mel']['field_category'];
  if (($original['#type'] ?? '') !== 'entity_autocomplete') {
    return;
  }

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $term_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('vid', 'categories')
    ->sort('name')
    ->execute();

  if ($tids === []) {
    return;
  }

  $terms = $term_storage->loadMultiple($tids);
  $options = [];
  foreach ($terms as $term) {
    $options[$term->id()] = $term->label();
  }

  $default_tids = [];
  $dv = $original['#default_value'] ?? [];
  if (is_array($dv)) {
    foreach ($dv as $entity) {
      if (is_object($entity) && method_exists($entity, 'id')) {
        $default_tids[] = $entity->id();
      }
    }
  }

  $classes = ['mel-input', 'mel-select--category'];
  if (!empty($original['#attributes']['class']) && is_array($original['#attributes']['class'])) {
    $classes = array_merge($classes, $original['#attributes']['class']);
  }

  $form['mel']['field_category'] = [
    '#type' => 'select',
    '#title' => $original['#title'] ?? t('Categories'),
    '#options' => $options,
    '#multiple' => TRUE,
    '#default_value' => $default_tids,
    '#description' => $original['#description'] ?? NULL,
    '#attributes' => [
      'class' => array_values(array_unique($classes)),
      'size' => (string) min(12, max(4, count($options))),
    ],
    '#weight' => $original['#weight'] ?? 0,
  ];
}

/**
 * Event Studio routes (vendor create/edit).
 */
function _myeventlane_vendor_theme_event_studio_routes(): array {
  return [
    'myeventlane_event_studio.create',
