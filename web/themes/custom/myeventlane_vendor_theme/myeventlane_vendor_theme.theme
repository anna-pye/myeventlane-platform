/**
 * Whether the account is staff/support for legacy vendor workspace chrome.
 *
 * Mirrors VendorLegacyWizardRedirectSubscriber staff bypass: vendors are
 * redirected to Event Studio; staff may still use workspace tabs.
 */
function _myeventlane_vendor_theme_is_vendor_workspace_staff(\Drupal\Core\Session\AccountInterface $account): bool {
  if (!$account->isAuthenticated()) {
    return FALSE;
  }
  return $account->hasPermission('administer nodes') || (int) $account->id() === 1;
}

/**
 * Legacy multi-step wizard routes (Basics → … → Publish), for admin/support.
 */
function _myeventlane_vendor_theme_event_wizard_step_routes(): array {
  return [
    'myeventlane_event.wizard.basics',
    'myeventlane_event.wizard.when_where',
    'myeventlane_event.wizard.tickets',
    'myeventlane_event.wizard.details',
    'myeventlane_event.wizard.review',
    'myeventlane_event.wizard.publish',
    'myeventlane_event.wizard.success',
  ];
}

/**
 * Vendor event-builder layout: Event Studio always; legacy wizard only for staff.
 */
function _myeventlane_vendor_theme_event_builder_layout_routes(): array {
  $routes = _myeventlane_vendor_theme_event_studio_routes();
  $account = \Drupal::currentUser();
  if ($account->hasPermission('administer nodes') || (int) $account->id() === 1) {
    $routes = array_merge($routes, _myeventlane_vendor_theme_event_wizard_step_routes());
  }
  return $routes;
}

/**
 * Builds wizard step items for the sidebar (Basics, When & Where, … Publish).
 *
 * @param \Drupal\node\NodeInterface $event
 *   The event node.
 * @param string $current_route
 *   The current route name.
 *
 * @return array<int, array{id: string, label: string, url: string, is_active: bool}>
 *   Wizard steps for sidebar rendering.
 */
function _myeventlane_vendor_theme_build_wizard_steps(\Drupal\node\NodeInterface $event, string $current_route): array {
  $steps = [
    ['id' => 'basics', 'label' => t('Basics'), 'route' => 'myeventlane_event.wizard.basics'],
    ['id' => 'when_where', 'label' => t('When & Where'), 'route' => 'myeventlane_event.wizard.when_where'],
    ['id' => 'tickets', 'label' => t('Tickets'), 'route' => 'myeventlane_event.wizard.tickets'],
    ['id' => 'details', 'label' => t('Details'), 'route' => 'myeventlane_event.wizard.details'],
    ['id' => 'review', 'label' => t('Review'), 'route' => 'myeventlane_event.wizard.review'],
    ['id' => 'publish', 'label' => t('Publish'), 'route' => 'myeventlane_event.wizard.publish'],
  ];
  $event_id = (int) $event->id();
  $out = [];
  foreach ($steps as $step) {
    $out[] = [
      'id' => $step['id'],
      'label' => $step['label'],
      'url' => \Drupal\Core\Url::fromRoute($step['route'], ['event' => $event_id])->toString(),
      'is_active' => ($step['route'] === $current_route),
    ];
  }
  return $out;
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page.
 */
function myeventlane_vendor_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  // Add page suggestions based on route.
  $route_name = \Drupal::routeMatch()->getRouteName();

  // Public marketplace vendor routes use the default MEL shell, not console chrome.
  $public_marketplace_routes = [
    'myeventlane_vendor.public_list',
    'myeventlane_vendor.organisers',
    'entity.myeventlane_vendor.canonical',
  ];
  if (is_string($route_name) && in_array($route_name, $public_marketplace_routes, TRUE)) {
    return;
  }

  if (is_string($route_name) && (str_starts_with($route_name, 'myeventlane_vendor') || str_starts_with($route_name, 'myeventlane_event_studio.'))) {
    $suggestions[] = 'page__vendor';
  }

  if (in_array($route_name, _myeventlane_vendor_theme_event_builder_layout_routes(), TRUE)) {
    $suggestions[] = 'page__vendor__event_wizard';
  }
  elseif ($route_name === 'myeventlane_vendor.console.dashboard') {
    $suggestions[] = 'page__vendor__dashboard';
  }
  elseif (str_starts_with($route_name ?? '', 'myeventlane_vendor.')) {
    $route_parts = explode('.', $route_name);
    if (count($route_parts) >= 2) {
      $suggestions[] = 'page__vendor__' . str_replace('.', '_', $route_parts[1]);
    }
  }
}

/**
 * Implements hook_theme_suggestions_form_alter().
 *
 * Force a vendor-specific form template for the event node form so the
 * console domain picks up the same layout (with Visibility & Promotion).
 */
function myeventlane_vendor_theme_theme_suggestions_form_alter(array &$suggestions, array $variables, string $hook): void {
  $form_id = $variables['element']['#form_id'] ?? '';
  if (in_array($form_id, ['node_event_form', 'node_event_edit_form'], TRUE)) {
    $suggestions[] = 'form__node_event_form__vendor';
  }

  if ($form_id === 'organiser_onboard_profile_form') {
    $suggestions[] = 'form__organiser_onboard_profile_form';
  }

  if ($form_id === 'myeventlane_vendor_events_bulk_actions_form') {
    $suggestions[] = 'form__mel_vendor_events';
  }

  if ($form_id === 'mel_organiser_settings_form') {
    $suggestions[] = 'form__mel_organiser_settings_form';
  }
}

/**
 * Implements hook_preprocess_HOOK() for form__organiser_onboard_profile_form.
 *
 * Passes step metadata from the form element for the onboarding layout.
 */
function myeventlane_vendor_theme_preprocess_form__organiser_onboard_profile_form(array &$variables): void {
  $element = $variables['element'];
  $variables['step_number'] = $element['#step_number'] ?? 2;
  $variables['total_steps'] = $element['#total_steps'] ?? 7;
  $variables['step_title'] = $element['#step_title'] ?? '';
  $variables['step_description'] = $element['#step_description'] ?? NULL;
  $step_number = $variables['step_number'];
  $variables['back_route'] = match ($step_number) {
    2 => 'myeventlane_vendor.onboard.account',
    3 => 'myeventlane_vendor.onboard.profile',
    4 => 'myeventlane_vendor.onboard.stripe',
    5 => 'myeventlane_vendor.onboard.first_event',
    6 => 'myeventlane_vendor.onboard.boost',
    default => NULL,
  };
  $variables['onboarding_stages'] = _myeventlane_vendor_theme_build_onboarding_stages('myeventlane_vendor.onboard.profile');
  $journey = _myeventlane_vendor_theme_onboarding_journey_meta('myeventlane_vendor.onboard.profile');
  $variables['journey_steps'] = $journey['journey_steps'];
  $variables['onboarding_progress_label'] = $journey['progress_label'];
  $variables['onboarding_stage'] = $journey['onboarding_stage'];
  $variables['completed_step_keys'] = $journey['completed_step_keys'];
}

/**
 * Implements hook_preprocess_HOOK() for vendor_onboard_step.
 *
 * Builds onboarding stages for the progress indicator.
 */
function myeventlane_vendor_theme_preprocess_vendor_onboard_step(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  // Branding route treats current stage as listen.
  $effective_route = ($route === 'myeventlane_vendor.onboard.branding')
    ? 'myeventlane_vendor.onboard.stripe'
    : $route;
  $variables['onboarding_stages'] = _myeventlane_vendor_theme_build_onboarding_stages($effective_route);
  $journey = _myeventlane_vendor_theme_onboarding_journey_meta(is_string($effective_route) ? $effective_route : NULL);
  $variables['journey_steps'] = $journey['journey_steps'];
  $variables['onboarding_progress_label'] = $journey['progress_label'];
  $variables['onboarding_stage'] = $journey['onboarding_stage'];
  $variables['completed_step_keys'] = $journey['completed_step_keys'];

  $element = $variables['form'] ?? [];
  $variables['stripe_state'] = is_array($element) ? ($element['#stripe_state'] ?? NULL) : NULL;
  $variables['onboard_footer'] = is_array($element) ? ($element['#onboard_footer'] ?? NULL) : NULL;
}

/**
 * Builds onboarding stages array for progress indicator.
 *
 * Uses STAGE_ORDER, OnboardingManager, LegalGatekeeper. Applies Stripe + Terms
 * locking for steps after listen.
 *
 * @param string|\Drupal\myeventlane_core\Entity\OnboardingStateInterface $route_or_state
 *   Effective onboarding route, or a vendor onboarding state (e.g. Event Studio preprocess).
 *
 * @return array<int, array{key: string, label: string, url: string, is_complete: bool, is_current: bool, is_locked: bool}>
 *   Stages for the progress component.
 */
function _myeventlane_vendor_theme_build_onboarding_stages(string|OnboardingStateInterface $route_or_state): array {
  $stage_order = OnboardingStateInterface::STAGE_ORDER;
  // Event-first checklist: Profile → Create event → Payments → Publish.
  $display_order = ['present', 'ask', 'listen', 'complete'];
  $route_to_stage = [
    'myeventlane_legal.vendor_terms' => 'probe',
    'myeventlane_vendor.onboard.account' => 'probe',
    'myeventlane_vendor.onboard.profile' => 'present',
    'myeventlane_vendor.onboard.stripe' => 'listen',
    'myeventlane_vendor.onboard.first_event' => 'ask',
    'myeventlane_event_studio.create' => 'ask',
    'myeventlane_event_studio.edit' => 'ask',
    'myeventlane_vendor.onboard.boost' => 'invite',
    'myeventlane_vendor.onboard.complete' => 'complete',
  ];
  $stage_labels = [
    'present' => t('Profile'),
    'ask' => t('Create event'),
    'listen' => t('Payments'),
    'complete' => t('Publish'),
  ];
  $stage_routes = [
    'present' => 'myeventlane_vendor.onboard.profile',
    'ask' => 'myeventlane_event_studio.create',
    'listen' => 'myeventlane_vendor.onboard.stripe',
    'complete' => 'myeventlane_vendor.onboard.complete',
  ];

  $canonical_stage = 'probe';
  $state = NULL;

  if ($route_or_state instanceof OnboardingStateInterface) {
    $state = $route_or_state;
    $canonical_stage = $state->getStage();
  }
  else {
    $current_route = $route_or_state;
    $canonical_stage = $route_to_stage[$current_route] ?? 'probe';

    $current_user = \Drupal::currentUser();
    if ($current_user->isAuthenticated()) {
      $onboarding_manager = \Drupal::service('myeventlane_onboarding.manager');
      $uid = (int) $current_user->id();
      $state = $onboarding_manager->loadVendorStateByUid($uid);
      $etm = \Drupal::entityTypeManager();
      if ($etm->hasDefinition('myeventlane_vendor')) {
        $vendor_storage = $etm->getStorage('myeventlane_vendor');
        $vendor = NULL;
        $owner_ids = $vendor_storage->getQuery()->accessCheck(FALSE)->condition('uid', $uid)->range(0, 1)->execute();
        if (!empty($owner_ids)) {
          $vendor = $vendor_storage->load(reset($owner_ids));
        }
        if (!$vendor) {
          $user_ids = $vendor_storage->getQuery()->accessCheck(FALSE)->condition('field_vendor_users', $uid)->range(0, 1)->execute();
          if (!empty($user_ids)) {
            $vendor = $vendor_storage->load(reset($user_ids));
          }
        }
        if ($state && $vendor instanceof \Drupal\myeventlane_vendor\Entity\Vendor) {
          $user = $etm->getStorage('user')->load($uid);
          if ($user instanceof \Drupal\user\UserInterface) {
            $state = $onboarding_manager->loadOrCreateVendor($user, $vendor);
            $onboarding_manager->refreshFlags($state);
          }
        }
      }
    }
  }

  $present_index = array_search('present', $stage_order, TRUE);
  $present_index = $present_index !== FALSE ? $present_index : 1;

  $terms_accepted = FALSE;
  if (\Drupal::currentUser()->isAuthenticated() && \Drupal::hasService('myeventlane_legal.gatekeeper')) {
    $terms_accepted = \Drupal::service('myeventlane_legal.gatekeeper')->hasVendorAcceptedTerms();
  }

  $flags = $state ? $state->getFlags() : [];

  $checklist_current = match ($canonical_stage) {
    'probe' => 'present',
    'present' => 'present',
    'listen' => 'listen',
    'ask' => 'ask',
    'invite' => 'complete',
    'complete' => 'complete',
    default => 'present',
  };

  $state_idx = ($state !== NULL) ? array_search($state->getStage(), $stage_order, TRUE) : FALSE;
  $idx_present = array_search('present', $stage_order, TRUE);
  $idx_ask = array_search('ask', $stage_order, TRUE);
  $idx_listen = array_search('listen', $stage_order, TRUE);
  $idx_complete = array_search('complete', $stage_order, TRUE);

  $stages = [];
  foreach ($display_order as $key) {
    $stage_complete = FALSE;
    if ($state) {
      if ($state->isCompleted()) {
        $stage_complete = TRUE;
      }
      elseif ($state_idx !== FALSE) {
        if ($key === 'listen') {
          $stage_complete = !empty($flags['stripe_connected']);
        }
        elseif ($key === 'present') {
          $stage_complete = $idx_present !== FALSE && $state_idx > $idx_present;
        }
        elseif ($key === 'ask') {
          $stage_complete = $idx_ask !== FALSE && $state_idx > $idx_ask;
        }
        elseif ($key === 'complete') {
          $stage_complete = $idx_complete !== FALSE && $state_idx >= $idx_complete;
        }
      }
    }

    $stripe_locked = FALSE;
    $row_stage = match ($key) {
      'present' => 'present',
      'ask' => 'ask',
      'listen' => 'listen',
      'complete' => 'complete',
      default => 'present',
    };
    $row_idx = array_search($row_stage, $stage_order, TRUE);
    $terms_locked = ($row_idx !== FALSE && $row_idx > $present_index) && !$terms_accepted;
    $is_locked = $stripe_locked || $terms_locked;

    $url = '';
    if (isset($stage_routes[$key])) {
      try {
        $url = \Drupal\Core\Url::fromRoute($stage_routes[$key])->toString();
      }
      catch (\Exception $e) {
        $url = '';
      }
    }

    $stages[] = [
      'key' => $key,
      'label' => $stage_labels[$key] ?? $key,
      'url' => $url,
      'is_complete' => $stage_complete,
      'is_current' => ($key === $checklist_current),
      'is_locked' => $is_locked,
    ];
  }

  return $stages;
}

/**
 * Builds journey metadata for guided onboarding UX (matches STAGE_ORDER).
 *
 * @return array
 *   Journey variables for Twig (steps, progress label, stage, completed keys).
 */
function _myeventlane_vendor_theme_onboarding_journey_meta(?string $effective_route = NULL): array {
  $route = $effective_route ?? (string) (\Drupal::routeMatch()->getRouteName() ?? '');
  if ($route === 'myeventlane_vendor.onboard.branding') {
    $route = 'myeventlane_vendor.onboard.stripe';
  }

  $route_to_stage = [
    'myeventlane_legal.vendor_terms' => 'probe',
    'myeventlane_vendor.onboard' => 'probe',
    'myeventlane_vendor.onboard.account' => 'probe',
    'myeventlane_vendor.onboard.profile' => 'present',
    'myeventlane_vendor.onboard.stripe' => 'listen',
    'myeventlane_vendor.onboard.first_event' => 'ask',
    'myeventlane_event_studio.create' => 'ask',
    'myeventlane_event_studio.edit' => 'ask',
    'myeventlane_vendor.onboard.boost' => 'invite',
    'myeventlane_vendor.onboard.complete' => 'complete',
  ];
  $stage = $route_to_stage[$route] ?? 'probe';
  $stage_order = \Drupal\myeventlane_core\Entity\OnboardingStateInterface::STAGE_ORDER;
  $display_order = ['present', 'ask', 'listen', 'complete'];
  $current_index = array_search(
    match ($stage) {
      'probe' => 'present',
      'present' => 'present',
      'listen' => 'listen',
      'ask' => 'ask',
      'invite' => 'complete',
      'complete' => 'complete',
      default => 'present',
    },
    $display_order,
    TRUE
  );
  $current_index = $current_index !== FALSE ? (int) $current_index : 0;

  $journey_ids = $display_order;
  $uid = (int) \Drupal::currentUser()->id();
  $state = NULL;
  if ($uid > 0 && \Drupal::hasService('myeventlane_onboarding.manager')) {
    /** @var \Drupal\myeventlane_core\Service\OnboardingManager $manager */
    $manager = \Drupal::service('myeventlane_onboarding.manager');
    $state = $manager->loadVendorStateByUid($uid);
  }

  $state_idx = NULL;
  if ($state !== NULL) {
    $state_idx = array_search($state->getStage(), $stage_order, TRUE);
    $state_idx = $state_idx !== FALSE ? (int) $state_idx : 0;
  }

  $journey_flags = ($state !== NULL) ? $state->getFlags() : [];

  $steps = [];
  $completed_keys = [];
  foreach ($journey_ids as $i => $id) {
    $is_current = ($i === $current_index);
    $key_stage_index = array_search($id, $stage_order, TRUE);
    $is_complete = FALSE;
    if ($state !== NULL && $state->isCompleted()) {
      $is_complete = TRUE;
    }
    elseif ($state_idx !== NULL && $key_stage_index !== FALSE) {
      // Match _myeventlane_vendor_theme_build_onboarding_stages(): listen is optional; ask vs listen order in UI.
      if ($id === 'listen') {
        $is_complete = !empty($journey_flags['stripe_connected']);
      }
      elseif ($id === 'ask') {
        $ask_index = array_search('ask', $stage_order, TRUE);
        $is_complete = ($ask_index !== FALSE && $state_idx > $ask_index);
      }
      elseif ($id === 'complete') {
        $complete_index = array_search('complete', $stage_order, TRUE);
        $is_complete = $complete_index !== FALSE && $state_idx >= $complete_index;
      }
      else {
        $is_complete = $state_idx > $key_stage_index;
      }
    }
    else {
      $is_complete = $i < $current_index;
    }
    $label = match ($id) {
      'present' => t('Profile'),
      'listen' => t('Payments'),
      'ask' => t('Create event'),
      'complete' => t('Publish'),
      default => $id,
    };
    if ($is_complete) {
      $completed_keys[] = $id;
    }
    $steps[] = [
      'id' => $id,
      'label' => $label,
      'is_current' => $is_current,
      'is_complete' => $is_complete,
    ];
  }

  $total_steps = count($display_order);
  $progress_label = t('Step @current of @total', [
    '@current' => (string) ($current_index + 1),
    '@total' => (string) $total_steps,
  ]);

  return [
    'journey_steps' => $steps,
    'progress_label' => $progress_label,
    'onboarding_stage' => $state?->getStage(),
    'completed_step_keys' => $completed_keys,
  ];
}

/**
 * Implements hook_theme().
 */
function myeventlane_vendor_theme_theme($existing, $type, $theme, $path): array {
  return [
    'vendor_sidebar' => [
      'template' => 'includes/sidebar',
      'variables' => [
        'page' => [],
      ],
    ],
    'myeventlane_vendor_console_page' => [
      'variables' => [
        'title' => NULL,
        'tabs' => [],
        'header_actions' => [],
        'body' => NULL,
        'content' => NULL,
        'meta' => [],
      ],
      'template' => 'layout/console-page',
    ],
    'mel_event_workspace' => [
      'variables' => [
        'event' => NULL,
        'content' => NULL,
        'tabs' => [],
        'sidebar' => NULL,
        'actions' => [],
        'meta' => NULL,
        'event_type_label' => NULL,
        'event_date_label' => NULL,
        'event_status' => NULL,
        'event_status_badge_modifier' => NULL,
        'header_actions' => [],
        'insights' => NULL,
