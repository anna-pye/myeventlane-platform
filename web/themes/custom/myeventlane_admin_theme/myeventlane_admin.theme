<?php

/**
 * @file
 * Theme functions for MyEventLane Admin theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Ensures #attributes['class'] is a list suitable for appending classes.
 *
 * @param array<string, mixed> $element
 *   A form sub-array or the root form array.
 */
function _myeventlane_admin_normalize_class_attribute(array &$element): void {
  $element += ['#attributes' => []];
  if (!isset($element['#attributes']['class'])) {
    $element['#attributes']['class'] = [];
    return;
  }
  if (is_array($element['#attributes']['class'])) {
    return;
  }
  $element['#attributes']['class'] = array_values(array_filter(explode(' ', (string) $element['#attributes']['class'])));
}

/**
 * Implements hook_form_alter().
 */
function myeventlane_admin_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  // Gin Login / core user login: leave the form array untouched.
  if ($form_id === 'user_login_form') {
    return;
  }
  _myeventlane_admin_normalize_class_attribute($form);
  $form['#attributes']['class'][] = 'mel-admin-form';

  if (isset($form['actions']) && is_array($form['actions'])) {
    _myeventlane_admin_normalize_class_attribute($form['actions']);
    $form['actions']['#attributes']['class'][] = 'mel-form-actions';
  }
}
