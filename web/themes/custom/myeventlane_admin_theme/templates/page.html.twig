{#
/**
 * @file
 * Page template for MyEventLane Admin theme.
 *
 * Keeps markup minimal and Claro-compatible.
 */
#}

<div class="mel-admin-layout">
  {% if pcc_utility_links is defined and pcc_utility_links %}
  <div class="mel-pcc-utility-bar" role="navigation" aria-label="{{ 'Quick links'|t }}">
    <a href="{{ pcc_utility_links.main_site_url }}" class="mel-pcc-utility-bar__link">{{ 'Main Site'|t }}</a>
    <span class="mel-pcc-utility-bar__sep" aria-hidden="true">|</span>
    <a href="{{ pcc_utility_links.vendor_dashboard_url }}" class="mel-pcc-utility-bar__link">{{ 'Vendor Dashboard'|t }}</a>
    <span class="mel-pcc-utility-bar__sep" aria-hidden="true">|</span>
    <a href="{{ pcc_utility_links.platform_control_url }}" class="mel-pcc-utility-bar__link">{{ 'Platform Control Centre'|t }}</a>
  </div>
  {% endif %}
  {% if page.header %}
    <header class="mel-admin-header" role="banner">
      {{ page.header }}
    </header>
  {% endif %}

  <main id="main-content" class="mel-admin-content" role="main">
    <div class="mel-admin-layout__grid">
      {% if page.sidebar_first %}
        <aside class="mel-admin-sidebar" role="complementary">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      <div class="mel-admin-main">
        {{ page.content }}
      </div>
    </div>
  </main>

  {% if page.footer %}
    <footer class="mel-admin-footer" role="contentinfo">
      {{ page.footer }}
    </footer>
  {% endif %}
</div>

